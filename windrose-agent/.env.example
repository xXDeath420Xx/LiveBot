# Shared secret the dashboard presents on every :4091 call. Generate with:
#   openssl rand -hex 32
WINDROSE_AGENT_SECRET=

# Windrose+ dashboard. Loopback only — see spec §3 for why this is never public.
WINDROSE_PLUS_URL=http://127.0.0.1:8780
# Must match rcon.password in /srv/windrose/server-files/windrose_plus.json.
WINDROSE_PLUS_RCON_PASSWORD=

# Host paths. server-files is the container's bind mount.
WINDROSE_SERVER_FILES=/srv/windrose/server-files
WINDROSE_BACKUP_DIR=/srv/windrose/backups
WINDROSE_COMPOSE_DIR=/srv/windrose

# What the join page tells friends to type. Changing transport (hostname:port
# vs invite code) is this value plus the container env — no code change.
WINDROSE_CONNECT_ADDRESS=windrose.certifriedmultitool.com:7777

# Agent control API bind. Loopback only, like stream-relay's :4090.
WINDROSE_AGENT_PORT=4091
