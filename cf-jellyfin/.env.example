# --- CertiFried Jellyfin federation ----------------------------------------
# Must match an entry in the auth-app's bots.json registry.
CF_BOT_NAME=certifried-default

# Long random hex; SAME value goes in auth-app/bots.json shared_token field.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CF_FED_TOKEN=replace-with-long-random-hex

# Where the auth-app lives (no trailing slash).
CF_AUTH_APP_URL=https://jellyfin.certifriedmultitool.net

# Port for this bot's HTTP federation server.
# The auth-app's bots.json api_base for this bot must reach this port (likely
# via reverse proxy: e.g. https://server.certifriedmultitool.com/bot -> :8080).
FEDERATION_PORT=8080

# Per-guild Jellyfin opt-in + channel-mapping DB (created if missing)
CF_GUILD_CONFIG_DB=./guild-config.db

# Shared secret for the Jellyfin Webhook plugin → bot ingest endpoint.
# Configure Jellyfin's Webhook plugin to send header `X-Webhook-Secret: <this value>`.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CF_WEBHOOK_SECRET=

# Public Jellyfin URL — used to build poster image URLs in webhook embeds
CF_JELLYFIN_URL=https://jellyfin.certifriedmultitool.net

# Set to "1" to log every incoming webhook event type (useful for first-time setup)
CF_WEBHOOK_DEBUG=0

# --- Existing bot config ---------------------------------------------------
DISCORD_BOT_TOKEN=
