
# Fourthwall integration
FOURTHWALL_WEBHOOK_BASE_URL=https://your-dashboard.example.com
FOURTHWALL_API_BASE_URL=https://api.fourthwall.com
FOURTHWALL_STOREFRONT_BASE_URL=https://storefront-api.fourthwall.com

# --- Reddit ---
# Reddit now returns HTTP 403 for unauthenticated .json requests, so feeds fall back to
# the public Atom feed. That feed has no NSFW flag and no score, which means the
# auto-meme and poker-meme features stay disabled until these are set.
# Create a free "script" app at https://www.reddit.com/prefs/apps to get them.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- CertiFried Cinema (Jellyfin Go Live) ---
# Main bot needs Jellyfin creds for /movie autocomplete + track pickers:
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Cinema loopback API (must match cinema/.env):
CINEMA_PORT=8099
CINEMA_API_SECRET=

# --- Vault (private file transfer, /vault) ---
# Access is the vault_members table, seeded by migration 226. Nothing here grants access.
# Storage lives outside the web root and is never served statically. Defaults shown.
#VAULT_STORAGE_DIR=/home/death/CertiFriedUtility/uploads/vault
#VAULT_MAX_FILE_BYTES=5368709120       # 5 GB per file
#VAULT_MAX_TOTAL_BYTES=32212254720     # 30 GB across the whole vault
#VAULT_RETENTION_MINUTES=43200         # default auto-delete window (43200 = 30 days)
#VAULT_RETENTION_DAYS=30               # coarse fallback if MINUTES is unset
#VAULT_MAX_SHARE_DAYS=30               # ceiling on how long a share link may live
#VAULT_MIN_FREE_DISK_BYTES=5368709120  # refuse uploads that would leave less than this free
#VAULT_STALE_UPLOAD_HOURS=24           # abandoned partial uploads are reaped after this
# Upload slice size. Cloudflare refuses request bodies over 100 MB on Free/Pro, so this must
# stay well under that; the browser halves it automatically if a proxy rejects a slice.
#VAULT_CHUNK_BYTES=16777216            # 16 MB

# Greenhouse Tycoon cutover (docs/greenhouse-cutover.md). Leave unset until the cutover day. 1 = the new game is
# live: the bot stops starting the old game server (port 4020) and its jobs, /game and /cfx redirect to /greenhouse,
# /arcade cfx answers with the new link. Anything else changes nothing.
#GREENHOUSE_LIVE=1

# Steam Web API key (https://steamcommunity.com/dev/apikey) — Steam library tally + watchers
STEAM_API_KEY=
