<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0b0f11;
            --bg-secondary: #0f1316;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.5);
            --accent-purple: #a78bfa;
            --accent-blue: #60a5fa;
            --accent-cyan: #22d3ee;
            --accent-green: #23f56b;
            --accent-red: #f87171;
            --accent-yellow: #fbbf24;
            --accent-orange: #fb923c;
        }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; line-height: 1.6; }
        .bg-effects { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: hidden; }
        .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.3; animation: float 20s ease-in-out infinite; }
        .orb-1 { width: clamp(300px, 40vw, 500px); height: clamp(300px, 40vw, 500px); background: var(--cf-accent); top: -10%; left: -10%; }
        .orb-2 { width: clamp(250px, 35vw, 450px); height: clamp(250px, 35vw, 450px); background: var(--cf-accent); bottom: 10%; right: -10%; animation-delay: -10s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(20px, 20px) scale(1.02); } }
        .container { width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
        /* Navbar */
        /* Main */
        main { position: relative; z-index: 1; padding: 2rem 0 4rem; }
        /* Page Header */
        .page-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 2rem; }
        .page-header h1 { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 800; background: linear-gradient(135deg, var(--text-primary), var(--accent-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .page-header p { color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.25rem; }
        .invite-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; background: var(--cf-accent); color: var(--cf-on-accent); text-decoration: none; border-radius: 12px; font-weight: 600; font-size: 0.9rem; transition: all 0.2s; }
        .invite-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px color-mix(in srgb, var(--accent-purple) 40%, transparent); }
        .invite-btn svg { width: 18px; height: 18px; }
        /* Animations */
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes statusPulse { 0%, 100% { transform: scale(1); opacity: 0.5; } 50% { transform: scale(1.4); opacity: 0; } }
        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card { background: var(--bg-card); border: 1px solid var(--border-color); border-left: 3px solid var(--stat-color, var(--accent-purple)); border-radius: 4px 14px 14px 4px; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1); position: relative; overflow: hidden; animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
        .stat-card:nth-child(1) { animation-delay: 0.05s; }
        .stat-card:nth-child(2) { animation-delay: 0.1s; }
        .stat-card:nth-child(3) { animation-delay: 0.15s; }
        .stat-card:nth-child(4) { animation-delay: 0.2s; }
        .stat-card:nth-child(5) { animation-delay: 0.25s; }
        .stat-card:nth-child(6) { animation-delay: 0.3s; }
        .stat-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(ellipse at left, color-mix(in srgb, var(--stat-color, var(--accent-purple)) 5%, transparent), transparent 60%); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; }
        .stat-card:hover { border-color: var(--border-color); transform: translateY(-2px); box-shadow: 0 8px 20px color-mix(in srgb, var(--stat-color, var(--accent-purple)) 8%, rgba(0,0,0,0.2)); }
        .stat-card:hover::after { opacity: 1; }
        .stat-card:hover .stat-icon { transform: scale(1.08); }
        .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); box-shadow: 0 4px 12px color-mix(in srgb, var(--stat-color, var(--accent-purple)) 20%, transparent); }
        .stat-icon svg { width: 22px; height: 22px; }
        .stat-value { font-size: 1.35rem; font-weight: 700; color: var(--text-primary); }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
        .stat-purple { --stat-color: var(--accent-purple); }
        .stat-purple .stat-icon { background: var(--bg-card-hover); color: var(--accent-purple); }
        .stat-cyan { --stat-color: var(--accent-cyan); }
        .stat-cyan .stat-icon { background: color-mix(in srgb, var(--cf-info) 15%, transparent); color: var(--accent-cyan); }
        .stat-gray { --stat-color: color-mix(in srgb, var(--cf-text) 30%, transparent); }
        .stat-gray .stat-icon { background: var(--bg-card-hover); color: var(--text-muted); }
        .stat-red { --stat-color: var(--accent-red); }
        .stat-red .stat-icon { background: color-mix(in srgb, var(--cf-danger) 15%, transparent); color: var(--accent-red); }
        .stat-amber { --stat-color: var(--accent-yellow); }
        .stat-amber .stat-icon { background: color-mix(in srgb, var(--cf-warning) 15%, transparent); color: var(--accent-yellow); }
        .stat-green { --stat-color: var(--accent-green); }
        .stat-green .stat-icon { background: color-mix(in srgb, var(--cf-success) 15%, transparent); color: var(--accent-green); }
        /* Search */
        .search-bar { display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; }
        .search-wrapper { position: relative; flex: 1; min-width: 200px; }
        .search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; color: var(--text-muted); }
        .search-input { width: 100%; padding: 0.875rem 1rem 0.875rem 3rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; color: var(--text-primary); font-size: 0.95rem; font-family: inherit; transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
        .search-input::placeholder { color: var(--text-muted); }
        .search-input:focus { outline: none; border-color: var(--accent-purple); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-purple) 12%, transparent), 0 4px 16px color-mix(in srgb, var(--accent-purple) 8%, transparent); background: var(--bg-card); }
        .search-count { display: flex; align-items: center; gap: 0.5rem; padding: 0 1.25rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; font-size: 0.9rem; color: var(--text-secondary); white-space: nowrap; }
        /* Server Grid */
        .server-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 1.25rem; }
        .server-card {
            display: block; text-decoration: none;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-left: 3px solid var(--accent-purple);
            border-radius: 4px 16px 16px 4px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        .server-card:nth-child(1) { animation-delay: 0.04s; }
        .server-card:nth-child(2) { animation-delay: 0.08s; }
        .server-card:nth-child(3) { animation-delay: 0.12s; }
        .server-card:nth-child(4) { animation-delay: 0.16s; }
        .server-card:nth-child(5) { animation-delay: 0.20s; }
        .server-card:nth-child(6) { animation-delay: 0.24s; }
        .server-card:nth-child(7) { animation-delay: 0.28s; }
        .server-card:nth-child(8) { animation-delay: 0.32s; }
        .server-card:nth-child(9) { animation-delay: 0.36s; }
        .server-card:nth-child(10) { animation-delay: 0.40s; }
        .server-card:nth-child(11) { animation-delay: 0.44s; }
        .server-card:nth-child(12) { animation-delay: 0.48s; }
        .server-card::after {
            content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at top left, var(--bg-card-hover), transparent 60%);
            opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
        }
        .server-card:hover {
            border-color: color-mix(in srgb, var(--accent-purple) 35%, transparent);
            transform: translateY(-3px);
            box-shadow: 0 12px 32px color-mix(in srgb, var(--accent-purple) 8%, transparent), 0 0 0 0 transparent;
        }
        .server-card:hover::after { opacity: 1; }
        .server-card:hover .server-icon img, .server-card:hover .server-icon .initials {
            border-color: color-mix(in srgb, var(--accent-purple) 50%, transparent);
            box-shadow: 0 4px 12px color-mix(in srgb, var(--accent-purple) 20%, transparent);
        }
        .server-card-header { padding: 1.5rem; display: flex; align-items: flex-start; gap: 1rem; }
        .server-icon { position: relative; flex-shrink: 0; }
        .server-icon img, .server-icon .initials { width: 60px; height: 60px; border-radius: 14px; object-fit: cover; border: 2px solid var(--border-color); transition: border-color 0.3s; }
        .server-card:hover .server-icon img, .server-card:hover .server-icon .initials { border-color: color-mix(in srgb, var(--accent-purple) 50%, transparent); }
        .server-icon .initials { display: flex; align-items: center; justify-content: center; font-size: 1.25rem; font-weight: 700; color: var(--text-primary); }
        .server-icon .status { position: absolute; bottom: -2px; right: -2px; width: 18px; height: 18px; background: var(--accent-green); border-radius: 50%; border: 3px solid var(--bg-primary); }
        .server-info { flex: 1; min-width: 0; }
        .server-name { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .server-id { font-size: 0.75rem; color: var(--text-muted); font-family: 'SF Mono', monospace; }
        .server-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
        .server-meta span { font-size: 0.7rem; color: var(--text-muted); display: inline-flex; align-items: center; white-space: nowrap; }
        .server-stats { padding: 0 1.5rem 1.25rem; display: flex; flex-wrap: wrap; gap: 1rem; }
        .server-stat { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--text-secondary); }
        .server-stat svg { width: 16px; height: 16px; }
        .server-stat.live { color: var(--accent-red); font-weight: 600; }
        .server-stat.live .pulse { width: 8px; height: 8px; background: var(--accent-red); border-radius: 50%; animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .server-card-footer { padding: 0.875rem 1.5rem; background: var(--cf-inset); border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; }
        .server-badge { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; display: inline-flex; align-items: center; }
        .server-badge.security-on { color: var(--accent-green); }
        .server-badge.security-off { color: var(--accent-red); }
        .server-arrow { width: 18px; height: 18px; color: var(--text-muted); transition: all 0.3s; }
        .server-card:hover .server-arrow { color: var(--accent-purple); transform: translateX(4px); }
        /* Empty State */
        .empty-state { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 20px; padding: 4rem 2rem; text-align: center; }
        .empty-icon { width: 80px; height: 80px; margin: 0 auto 1.5rem; background: var(--bg-card-hover); border: 1px solid var(--border-color); border-radius: 20px; display: flex; align-items: center; justify-content: center; }
        .empty-icon svg { width: 40px; height: 40px; color: var(--accent-purple); }
        .empty-state h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem; }
        .empty-state p { color: var(--text-secondary); max-width: 400px; margin: 0 auto 2rem; }
        .empty-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.875rem 1.5rem; border-radius: 12px; font-size: 0.9rem; font-weight: 600; text-decoration: none; transition: all 0.2s; }
        .btn svg { width: 18px; height: 18px; }
        .btn-primary { background: var(--cf-accent); color: var(--cf-on-accent); }
        .invite-alt { font-size: 0.8rem; opacity: 0.75; text-decoration: none; }
        :root:is([data-theme="light"], [data-theme="sand"]) .invite-alt { opacity: 1; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 25px color-mix(in srgb, var(--accent-purple) 40%, transparent); }
        .btn-secondary { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); }
        .btn-secondary:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        /* No Results */
        .no-results { display: none; text-align: center; padding: 4rem 2rem; }
        .no-results.visible { display: block; }
        .no-results svg { width: 64px; height: 64px; color: var(--text-muted); margin: 0 auto 1rem; }
        .no-results h3 { font-size: 1.25rem; margin-bottom: 0.5rem; color: var(--text-secondary); }
        .no-results p { color: var(--text-muted); }
        /* Footer */
        /* Mobile Menu */
        /* Responsive */
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .search-bar { flex-direction: column; }
            .search-count { justify-content: center; padding: 0.875rem 1rem; }
        }
        .hidden { display: none !important; }

        /* ---- cf-ui (wave 12): quieter server list. Later rules in this block win. ---- */
        .page-header { margin-bottom: 24px !important; align-items: flex-end !important; }
        .page-header h1 { font-size: 1.5rem !important; font-weight: 600 !important; letter-spacing: -0.02em; background: none !important; -webkit-text-fill-color: currentColor !important; color: var(--text-primary) !important; }
        .page-header p { font-size: 0.875rem !important; color: var(--text-muted) !important; }
        .invite-btn { height: 32px; padding: 0 12px !important; border-radius: 6px !important; font-size: 0.8125rem !important; font-weight: 600 !important; box-shadow: none !important; transform: none !important; }
        .invite-btn:hover { background: var(--cf-accent-hover) !important; }
        .invite-btn svg { width: 14px !important; height: 14px !important; }
        .stats-grid { gap: 0 !important; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)) !important; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); overflow: hidden; margin-bottom: 24px !important; }
        .stat-card { background: transparent !important; border: 0 !important; border-left: 1px solid var(--border-color) !important; border-radius: 0 !important; padding: 12px 16px !important; animation: none !important; box-shadow: none !important; transform: none !important; }
        .stat-card:first-child { border-left: 0 !important; }
        .stat-card::after, .stat-icon { display: none !important; }
        .stat-card > div { display: flex; flex-direction: column-reverse; }
        .stat-value { font-size: 1.25rem !important; font-weight: 600 !important; font-variant-numeric: tabular-nums; }
        .stat-label { font-size: 0.75rem !important; text-transform: none !important; letter-spacing: 0 !important; font-weight: 500 !important; color: var(--text-muted) !important; }
        .search-bar { margin-bottom: 16px !important; gap: 8px !important; }
        .search-input { height: 36px; padding: 0 12px 0 34px !important; border-radius: 6px !important; background: var(--cf-inset) !important; border: 1px solid var(--border-strong) !important; font-size: 0.875rem !important; }
        .search-icon { left: 11px !important; width: 15px !important; height: 15px !important; }
        .search-count { border-radius: 6px !important; padding: 0 12px !important; font-size: 0.8125rem; color: var(--text-muted); background: transparent !important; border: 0 !important; font-variant-numeric: tabular-nums; }
        .server-grid { gap: 12px !important; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)) !important; }
        .server-card { border: 1px solid var(--border-color) !important; border-radius: 8px !important; background: var(--bg-secondary) !important; animation: none !important; transition: border-color .15s !important; }
        .server-card::after { display: none !important; }
        .server-card:hover { border-color: var(--border-strong) !important; transform: none !important; box-shadow: none !important; background: var(--bg-secondary) !important; }
        .server-card-header { padding: 16px 16px 8px !important; gap: 12px !important; align-items: center !important; }
        .server-icon img, .server-icon .initials { width: 40px !important; height: 40px !important; border-radius: 8px !important; border: 1px solid var(--border-color) !important; transform: none !important; box-shadow: none !important; }
        .server-icon .initials { background: var(--bg-card-hover) !important; color: var(--text-secondary) !important; font-size: 0.875rem !important; font-weight: 600 !important; }
        .server-icon .status { width: 10px !important; height: 10px !important; border-width: 2px !important; }
        .server-name { font-size: 0.9375rem !important; font-weight: 600 !important; }
        .server-stats { padding: 0 16px 12px !important; gap: 16px !important; }
        .server-stat { font-size: 0.8125rem !important; font-variant-numeric: tabular-nums; color: var(--text-muted) !important; }
        .server-stat svg { width: 14px !important; height: 14px !important; }
        .server-stat.live { color: var(--accent-red) !important; }
        .server-card-footer { padding: 10px 16px !important; background: transparent !important; }
        .server-badge { font-size: 0.75rem !important; text-transform: none !important; letter-spacing: 0 !important; font-weight: 500 !important; }
        .server-badge.security-off { color: var(--text-muted) !important; }
        .server-arrow { width: 14px !important; height: 14px !important; }
        .server-card:hover .server-arrow { transform: none !important; color: var(--text-primary) !important; }
        .empty-state { border-radius: 8px !important; }
    </style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Dashboard - CertiFried MultiTool', description: 'Select a server to manage with CertiFried MultiTool. Configure stream notifications, moderation, and more.' }) %>
</head>
<body>
    <div class="bg-effects"><div class="orb orb-1"></div><div class="orb orb-2"></div></div>

    <%- include('partials/site-header', { user: locals.user || null, navActive: 'dashboard' }) %>

    <main id="main-content" tabindex="-1">
        <div class="container">
            <%
            const serverList = typeof guilds !== 'undefined' ? guilds : (typeof manageableGuilds !== 'undefined' ? manageableGuilds : []);
            const humanMembers = typeof totalHumanMembers !== 'undefined' ? totalHumanMembers : (typeof totalMembers !== 'undefined' ? totalMembers : 0);
            const botCount = typeof totalBots !== 'undefined' ? totalBots : 0;
            const liveStreams = typeof totalLiveStreams !== 'undefined' ? totalLiveStreams : 0;
            const streamersTracked = typeof totalStreamersTracked !== 'undefined' ? totalStreamersTracked : 0;
            %>

            <!-- Page Header -->
            <div class="page-header">
                <div>
                    <h1>Your servers</h1>
                    <p>Servers you can manage with CertiFried Utility.</p>
                </div>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.25rem;">
                    <a href="https://discord.com/api/oauth2/authorize?client_id=<%= locals.clientId || '#' %>&permissions=1643797540086&scope=bot+applications.commands" target="_blank" class="invite-btn" title="Asks only for the permissions the current features use, the same as /invite.">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                        Add to a server
                    </a>
                    <a href="https://discord.com/api/oauth2/authorize?client_id=<%= locals.clientId || '#' %>&permissions=8&scope=bot+applications.commands" target="_blank" class="invite-alt" title="Administrator covers every permission, including ones added later. Pick this only if you would rather not manage permissions.">
                        or add with Administrator
                    </a>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card stat-purple">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg></div>
                    <div><div class="stat-value"><%= serverList.length %></div><div class="stat-label">Servers</div></div>
                </div>
                <div class="stat-card stat-cyan">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
                    <div><div class="stat-value"><%= humanMembers.toLocaleString() %></div><div class="stat-label">Members</div></div>
                </div>
                <div class="stat-card stat-gray">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
                    <div><div class="stat-value"><%= botCount.toLocaleString() %></div><div class="stat-label">Bots</div></div>
                </div>
                <div class="stat-card stat-red">
                    <div class="stat-icon"><svg fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"/></svg></div>
                    <div><div class="stat-value" style="display:flex;align-items:center;gap:0.5rem;"><%= liveStreams %><% if (liveStreams > 0) { %><span style="width:8px;height:8px;background:var(--accent-red);border-radius:50%;animation:pulse 2s infinite;"></span><% } %></div><div class="stat-label">Live now</div></div>
                </div>
                <div class="stat-card stat-amber">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg></div>
                    <div><div class="stat-value"><%= streamersTracked %></div><div class="stat-label">Streamers tracked</div></div>
                </div>
            </div>

            <% if (serverList.length > 0) { %>
            <!-- Search Bar -->
            <div class="search-bar">
                <div class="search-wrapper">
                    <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    <input type="text" id="serverSearch" class="search-input" placeholder="Search servers" aria-label="Search servers">
                </div>
                <div class="search-count">
                    <span id="serverCount"><%= serverList.length %></span>
                    <span>servers</span>
                </div>
            </div>

            <!-- Server Grid -->
            <div class="server-grid" id="serverGrid">
                <% serverList.forEach(guild => { %>
                <a href="/manage/<%= guild.id %>" class="server-card" data-server-name="<%= guild.name.toLowerCase() %>">
                    <div class="server-card-header">
                        <div class="server-icon">
                            <% if (guild.icon) { %>
                            <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.webp?size=128" alt="<%= guild.name %>">
                            <% } else { %>
                            <%
                            const initials = guild.name.split(/\s+/).filter(w => w.length > 0).map(w => w[0]).slice(0, 2).join('').toUpperCase();
                            %>
                            <div class="initials" aria-hidden="true"><%= initials %></div>
                            <% } %>
                            <div class="status"></div>
                        </div>
                        <div class="server-info">
                            <div class="server-name"><%= guild.name %></div>
                            <div class="server-meta">
                                <% if (guild.ownerName) { %>
                                <span title="Server Owner"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:11px;height:11px;vertical-align:-1px;margin-right:2px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197"/></svg><%= guild.ownerName %></span>
                                <% } %>
                                <% if (guild.botJoinedAt) { %>
                                <span title="Bot joined"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:11px;height:11px;vertical-align:-1px;margin-right:2px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg><%= new Date(guild.botJoinedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="server-stats">
                        <div class="server-stat">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <%= (guild.memberCount || 0).toLocaleString() %>
                        </div>
                        <div class="server-stat" style="color:var(--text-muted)">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <%= (guild.botCount || 0).toLocaleString() %>
                        </div>
                        <% if (guild.liveCount > 0) { %>
                        <div class="server-stat live">
                            <span class="pulse"></span>
                            <%= guild.liveCount %> live
                        </div>
                        <% } %>
                    </div>
                    <div class="server-card-footer">
                        <% if (guild.hasAnySecurity) { %>
                        <span class="server-badge security-on" title="<%= guild.securityFeatures.join(', ') %>">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:12px;height:12px;margin-right:3px;vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            Protected
                        </span>
                        <% } else { %>
                        <span class="server-badge security-off" title="No security features enabled">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:12px;height:12px;margin-right:3px;vertical-align:-1px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            No protection on
                        </span>
                        <% } %>
                        <svg class="server-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </div>
                </a>
                <% }); %>
            </div>

            <!-- No Results -->
            <div class="no-results" id="noResults">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <h3>No servers found</h3>
                <p>Try adjusting your search</p>
            </div>

            <% } else { %>
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
                </div>
                <% if (locals.loadError) { %>
                <h2>Couldn't load your servers</h2>
                <p><%= loadError %></p>
                <% } else { %>
                <h2>No Servers Found</h2>
                <p>You don't have any servers where you can manage CertiFried MultiTool. Make sure you have the "Manage Server" permission.</p>
                <% } %>
                <div class="empty-actions">
                    <a href="https://discord.com/api/oauth2/authorize?client_id=<%= locals.clientId || '#' %>&permissions=1643797540086&scope=bot+applications.commands" target="_blank" class="btn btn-primary" title="Asks only for the permissions the current features use, the same as /invite.">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                        Add to a server
                    </a>
                    <a href="https://discord.com/api/oauth2/authorize?client_id=<%= locals.clientId || '#' %>&permissions=8&scope=bot+applications.commands" target="_blank" class="btn btn-secondary" title="Administrator covers every permission, including ones added later.">
                        Add with Administrator
                    </a>
                    <a href="/" class="btn btn-secondary">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                        Back to Home
                    </a>
                </div>
            </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/site-footer') %>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('serverSearch');
        const serverGrid = document.getElementById('serverGrid');
        const serverCards = document.querySelectorAll('.server-card');
        const serverCount = document.getElementById('serverCount');
        const noResults = document.getElementById('noResults');

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                let visibleCount = 0;

                serverCards.forEach(card => {
                    const serverName = card.getAttribute('data-server-name');
                    const isVisible = serverName.includes(searchTerm);
                    card.style.display = isVisible ? '' : 'none';
                    if (isVisible) visibleCount++;
                });

                if (serverCount) serverCount.textContent = visibleCount;
                if (noResults) noResults.classList.toggle('visible', visibleCount === 0);
                if (serverGrid) serverGrid.classList.toggle('hidden', visibleCount === 0);
            });
        }
    });

    </script>
</body>
</html>
