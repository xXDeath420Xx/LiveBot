<!DOCTYPE html>
<html lang="en"<% if (theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Who owns what in <%= guildName %> · CertiFried</title>
    <meta name="darkreader-lock">
    <%# Embeddable list (server websites, OBS, Notion): self-contained on purpose, with the
        dashboard's colour tokens copied in so it matches the site without loading cf-ui.css. %>
    <style>
        /* Dark by default, like the site; ?theme=light is for embedding on a light page. */
        :root { --bg:#0e0f11; --card:#151619; --line:#25272c; --text:#ececef; --muted:#8a8c95; --accent:#b4e04f; --bar:rgba(180,224,79,.10); color-scheme: dark; }
        :root[data-theme="light"] { --bg:#f6f7f8; --card:#ffffff; --line:#e1e3e7; --text:#16181c; --muted:#5f646e; --accent:#3f6a0c; --bar:rgba(74,122,16,.10); color-scheme: light; }
        * { box-sizing:border-box; }
        body { margin:0; background:var(--bg); color:var(--text); font:15px/1.45 'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; -webkit-font-smoothing:antialiased; }
        .wrap { max-width:860px; margin:0 auto; padding:24px 16px 40px; }
        header { display:flex; align-items:center; gap:12px; margin-bottom:6px; }
        header img { width:40px; height:40px; border-radius:50%; }
        h1 { font-size:1.3rem; font-weight:600; letter-spacing:-.01em; margin:0; }
        .sub { color:var(--muted); font-size:.85rem; margin:0 0 18px; }
        .tools { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:12px; }
        .tools input, .tools select { font:inherit; color:var(--text); background:var(--card); border:1px solid var(--line); border-radius:6px; padding:7px 10px; }
        .tools input:focus-visible, .tools select:focus-visible, .name a:focus-visible { outline:2px solid var(--accent); outline-offset:1px; }
        .tools input { flex:1 1 220px; min-width:0; }
        ol { list-style:none; margin:0; padding:0; border:1px solid var(--line); border-radius:8px; overflow:hidden; background:var(--card); }
        li { position:relative; padding:9px 14px; border-top:1px solid var(--line); display:grid; grid-template-columns:3ch 1fr auto; gap:10px; align-items:baseline; }
        li:first-child { border-top:0; }
        li .bar { position:absolute; inset:0 auto 0 0; background:var(--bar); pointer-events:none; }
        li > * { position:relative; }
        .rank { color:var(--muted); font-variant-numeric:tabular-nums; text-align:right; font-size:.8rem; }
        .name a { color:inherit; text-decoration:none; font-weight:600; overflow-wrap:anywhere; }
        .name a:hover { color:var(--accent); text-decoration:underline; }
        .who { display:block; color:var(--muted); font-size:.8rem; margin-top:2px; overflow-wrap:anywhere; }
        .n { font-variant-numeric:tabular-nums; font-weight:600; white-space:nowrap; }
        .empty { padding:28px; text-align:center; color:var(--muted); }
        footer { margin-top:14px; color:var(--muted); font-size:.78rem; }
        .compact .wrap { padding:10px; } .compact header, .compact .sub, .compact footer { display:none; }
    </style>
</head>
<body class="<%= compact ? 'compact' : '' %>">
<div class="wrap">
    <header>
        <% if (guildIcon) { %><img src="<%= guildIcon %>" alt=""><% } %>
        <h1>Who owns what in <%= guildName %></h1>
    </header>
    <p class="sub"><%= stats.members %> members linked their Steam · <%= stats.games %> different games</p>
    <div class="tools">
        <input id="q" type="search" placeholder="Find a game…" aria-label="Find a game">
        <select id="min" aria-label="Minimum owners">
            <% [1,2,3,4,5].forEach(function (n) { %><option value="<%= n %>"<%= n === minDefault ? ' selected' : '' %>><%= n === 1 ? 'Everything' : n + '+ owners' %></option><% }) %>
        </select>
    </div>
    <ol id="list"></ol>
    <footer>Only games owned are shared. No Steam profiles, playtime or friend lists. Updated every few minutes.</footer>
</div>
<script>
(function () {
    var games = <%- JSON.stringify(games).replace(/</g, '\\u003c') %>;
    var showNames = <%- showNames ? 'true' : 'false' %>;
    var max = games.length ? games[0].owners : 1;
    var list = document.getElementById('list'), q = document.getElementById('q'), min = document.getElementById('min');
    function render() {
        var term = q.value.trim().toLowerCase(), m = Number(min.value) || 1, rank = 0;
        // Built with createElement/textContent: game and member names are user data.
        function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
        var rows = games.filter(function (g) { return g.owners >= m && (!term || g.name.toLowerCase().indexOf(term) !== -1); })
            .slice(0, 300).map(function (g) {
                rank++;
                var li = el('li');
                var bar = el('span', 'bar'); bar.style.width = Math.max(2, Math.round(g.owners / max * 100)) + '%';
                var name = el('span', 'name');
                var a = el('a', null, g.name); a.href = g.url; a.target = '_blank'; a.rel = 'noopener';
                name.appendChild(a);
                if (showNames && g.ownerNames) name.appendChild(el('span', 'who', g.ownerNames.join(', ')));
                li.append(bar, el('span', 'rank', String(rank)), name, el('span', 'n', String(g.owners)));
                return li;
            });
        if (!rows.length) { var none = el('li', 'empty', 'No games match.'); none.style.display = 'block'; rows = [none]; }
        list.replaceChildren.apply(list, rows);
    }
    q.addEventListener('input', render); min.addEventListener('change', render);
    render();
})();
</script>
</body>
</html>
