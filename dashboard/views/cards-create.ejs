<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%- include('partials/cards-page-css') %>
    <style>
        input[type="date"] { color-scheme: dark; }
        :root[data-theme="light"] input[type="date"], :root[data-theme="sand"] input[type="date"] { color-scheme: light; }
        .wrap { max-width: 680px; margin: 0 auto; padding: 24px 20px 80px; }
        .form-card { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 20px; }
        .form-group { margin-bottom: 18px; }
        .form-group > label, .group-label { display: block; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text); margin-bottom: 6px; }
        .group-label .opt, .form-group > label .opt { color: var(--cf-text-3); font-weight: 400; }
        .form-hint { font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-top: 4px; }
        .form-group input, .form-group select, .form-group textarea { width: 100%; }

        .choice-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; margin-bottom: 20px; }
        .choice { background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); padding: 10px 6px; text-align: center; cursor: pointer; color: var(--cf-text-2); font: inherit; transition: border-color .15s, background .15s; min-width: 0; }
        .choice:hover { border-color: var(--cf-border-strong); }
        .choice.selected { border-color: var(--cf-accent); background: var(--cf-accent-soft); color: var(--cf-text); }
        .choice i { display: block; font-size: 1.05rem; margin-bottom: 4px; color: var(--cf-text-3); }
        .choice.selected i { color: var(--cf-accent-fg); }
        .choice .occ-name { font-size: var(--cf-text-xs); font-weight: 500; overflow-wrap: anywhere; }
        .type-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 20px; }
        .type-grid .choice { text-align: left; padding: 12px; display: flex; flex-direction: column; justify-content: flex-start; }
        .type-grid .occ-name { font-size: var(--cf-text-sm); }
        .type-grid .type-desc { font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-top: 4px; line-height: 1.4; }
        .type-grid .choice.selected .type-desc { color: var(--cf-text-2); }
        @media (max-width: 560px) { .choice-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .type-grid { grid-template-columns: 1fr; } }

        #bg-library { display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); gap: 8px; margin-bottom: 8px; }
        #bg-library > div { width: 100% !important; }
        #bg-categories { display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap; }

        .panel { border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 14px; margin-bottom: 18px; background: var(--cf-surface-2); }
        .panel-title { font-size: var(--cf-text-sm); font-weight: 600; margin-bottom: 8px; }
        .inline-row { display: flex; gap: 8px; }
        .inline-row input { flex: 1; min-width: 0; }
        @media (max-width: 480px) { .inline-row { flex-direction: column; } }
        #ai-status { font-size: var(--cf-text-xs); color: var(--cf-text-3); display: none; margin-top: 6px; }
        #ai-status.ok { color: var(--cf-success); } #ai-status.err { color: var(--cf-danger); }
        #ai-preview { display: none; margin-top: 10px; }
        #ai-preview img { max-width: 100%; max-height: 200px; border-radius: var(--cf-radius); border: 1px solid var(--cf-border-strong); display: block; margin-bottom: 6px; }

        details.advanced { margin-bottom: 18px; border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 10px 14px; }
        details.advanced summary { cursor: pointer; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-2); }
        details.advanced[open] summary { margin-bottom: 12px; }
        .note { border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 10px 12px; margin-bottom: 16px; font-size: var(--cf-text-sm); color: var(--cf-text-3); line-height: 1.5; }
        .error-msg { display: none; margin-bottom: 14px; padding: 10px 12px; border-radius: var(--cf-radius); border: 1px solid color-mix(in srgb, var(--cf-danger) 45%, transparent); background: color-mix(in srgb, var(--cf-danger) 10%, transparent); color: var(--cf-text); font-size: var(--cf-text-sm); }
        #create-btn { width: 100%; }
    </style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Create a Card | CertiFried' }) %>
</head>
<body>
    <%- include('partials/site-header', { user, active: 'cards', returnTo: '/cards/create' }) %>
    <%- include('partials/section-tabs', { label: 'Group cards', active: 'create', tabs: [['cards', '/cards', 'Overview'], ['create', '/cards/create', 'Create a card'], ['mine', '/cards/my-cards', 'My cards']] }) %>

    <main class="wrap" id="main-content">
        <div class="page-head">
            <h1>Create a card</h1>
            <p>Pick an occasion, say who it's for, then share the link so people can sign.</p>
        </div>

        <div class="form-card">
            <div id="create-error" class="error-msg" role="alert"></div>

            <span class="group-label" id="occ-label">Occasion</span>
            <div class="choice-grid" id="occasion-grid" role="radiogroup" aria-labelledby="occ-label">
                <%
                const occs = [
                    { id: 'birthday', icon: 'fa-cake-candles', name: 'Birthday' },
                    { id: 'farewell', icon: 'fa-hand', name: 'Farewell' },
                    { id: 'thank-you', icon: 'fa-heart', name: 'Thank you' },
                    { id: 'congratulations', icon: 'fa-champagne-glasses', name: 'Congrats' },
                    { id: 'retirement', icon: 'fa-umbrella-beach', name: 'Retirement' },
                    { id: 'welcome', icon: 'fa-handshake', name: 'Welcome' },
                    { id: 'anniversary', icon: 'fa-ring', name: 'Anniversary' },
                    { id: 'baby', icon: 'fa-baby', name: 'Baby' },
                    { id: 'get-well', icon: 'fa-kit-medical', name: 'Get well' },
                    { id: 'holidays', icon: 'fa-snowflake', name: 'Holidays' },
                    { id: 'graduation', icon: 'fa-graduation-cap', name: 'Graduation' },
                    { id: 'promotion', icon: 'fa-arrow-trend-up', name: 'Promotion' },
                    { id: 'miss-you', icon: 'fa-envelope-open-text', name: 'Miss you' },
                    { id: 'condolence', icon: 'fa-dove', name: 'Sympathy' },
                    { id: 'custom', icon: 'fa-pen', name: 'Other' },
                ];
                const occIds = occs.map(o => o.id);
                const selectedOccasion = (typeof occasion !== 'undefined' && occIds.includes(occasion)) ? occasion : 'birthday';
                %>
                <% occs.forEach(o => { %>
                <button type="button" class="choice occasion-opt <%= o.id === selectedOccasion ? 'selected' : '' %>" role="radio" aria-checked="<%= o.id === selectedOccasion %>" data-occasion="<%= o.id %>" onclick="selectOccasion(this)">
                    <i class="fas <%= o.icon %>" aria-hidden="true"></i>
                    <span class="occ-name"><%= o.name %></span>
                </button>
                <% }); %>
            </div>

            <form id="create-form" novalidate>
                <input type="hidden" id="occasion" name="occasion" value="<%= selectedOccasion %>">
                <input type="hidden" id="card_type" name="card_type" value="board">

                <span class="group-label" id="type-label">Card type</span>
                <div class="type-grid" id="type-grid" role="radiogroup" aria-labelledby="type-label">
                    <button type="button" class="choice selected" role="radio" aria-checked="true" data-type="board" onclick="selectCardType(this)">
                        <span class="occ-name">Group board</span>
                        <span class="type-desc" style="display:block">Everyone posts messages and photos on one shared board.</span>
                    </button>
                    <button type="button" class="choice" role="radio" aria-checked="false" data-type="greeting_card" onclick="selectCardType(this)">
                        <span class="occ-name">Greeting card</span>
                        <span class="type-desc" style="display:block">Opens like a paper card, with messages inside.</span>
                    </button>
                    <button type="button" class="choice" role="radio" aria-checked="false" data-type="one_person" onclick="selectCardType(this)">
                        <span class="occ-name">One-person card</span>
                        <span class="type-desc" style="display:block">A private card from you to one person.</span>
                    </button>
                </div>

                <div class="form-group">
                    <label for="recipient_name">Who it's for</label>
                    <input type="text" class="form-control" id="recipient_name" placeholder="e.g. Matt, the team, Mum" required maxlength="200" autofocus>
                </div>

                <div class="form-group">
                    <label for="card_name">Card title <span class="opt">(optional)</span></label>
                    <input type="text" class="form-control" id="card_name" placeholder="Happy Birthday, Matt!" maxlength="200">
                    <div class="form-hint">Filled in from the occasion and name until you type your own.</div>
                </div>

                <div class="form-group">
                    <label for="creator_name">Your name</label>
                    <input type="text" class="form-control" id="creator_name" value="<%= user ? user.username : '' %>" placeholder="Shown as the card's creator" maxlength="100">
                </div>

                <div class="form-group">
                    <span class="group-label">Board background</span>
                    <div id="bg-categories"></div>
                    <div id="bg-library"></div>
                    <input type="hidden" id="board_bg_image_url" value="">
                    <input type="hidden" id="board_bg_color" value="">
                </div>

                <div class="panel">
                    <div class="panel-title">Generate a cover image</div>
                    <div class="inline-row">
                        <input type="text" class="form-control" id="ai_prompt" aria-label="Describe the cover" placeholder="A birthday cake with neon candles floating in space">
                        <button type="button" class="btn btn-secondary" id="ai-generate-btn" onclick="generateAICover()"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> Generate</button>
                    </div>
                    <div id="ai-status" role="status"></div>
                    <div id="ai-preview">
                        <img alt="Generated cover" id="ai-preview-img">
                        <button type="button" class="btn btn-danger btn-sm" onclick="clearAICover()">Remove</button>
                    </div>
                    <input type="hidden" id="ai_cover_url" value="">
                    <div class="form-hint">Describe the look you want. Takes 10 to 20 seconds.</div>
                </div>

                <div class="form-group">
                    <label for="background_url">Cover image link <span class="opt">(instead of generating one)</span></label>
                    <input type="url" class="form-control" id="background_url" placeholder="https://…/image.jpg">
                </div>

                <details class="advanced">
                    <summary>More options</summary>
                    <div class="form-group">
                        <label for="password">Password <span class="opt">(optional)</span></label>
                        <input type="text" class="form-control" id="password" placeholder="Leave empty for no password" autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label for="music_url">Background music link</label>
                        <input type="url" class="form-control" id="music_url" placeholder="YouTube, SoundCloud or an audio file link">
                    </div>
                    <div class="form-group">
                        <label for="wishlist_url">Wishlist or gift link</label>
                        <input type="url" class="form-control" id="wishlist_url" placeholder="https://">
                    </div>
                    <div class="form-group" style="margin-bottom: 4px;">
                        <label for="deliver_at">Delivery date</label>
                        <input type="date" class="form-control" id="deliver_at" aria-describedby="deliver_at-hint">
                        <div class="form-hint" id="deliver_at-hint">On this day (UTC) the bot posts the card in the Discord channel you connect it to. If you don't connect it, you get the link in a Discord DM, as long as you were logged in when you made the card.</div>
                    </div>
                </details>

                <p class="note"><i class="fab fa-discord" aria-hidden="true"></i> After making the card you can connect it to a Discord server to post the signing link there. People who already signed stay on the card.</p>
                <button type="submit" id="create-btn" class="btn btn-primary btn-lg"><i class="fas fa-plus" aria-hidden="true"></i> Create card</button>
            </form>
        </div>
    </main>
    <%- include('partials/site-footer') %>

    <script>
    function selectOccasion(el) {
        // Only the occasion tiles: this used to clear the Card type selection too.
        document.querySelectorAll('#occasion-grid .occasion-opt').forEach(function(o) { o.classList.remove('selected'); o.setAttribute('aria-checked', 'false'); });
        el.classList.add('selected');
        el.setAttribute('aria-checked', 'true');
        document.getElementById('occasion').value = el.dataset.occasion;

        // Auto-fill title based on occasion + name
        var name = document.getElementById('recipient_name').value.trim();
        var titleInput = document.getElementById('card_name');
        if (name && !titleInput.dataset.userEdited) {
            var titles = {
                'birthday': 'Happy Birthday, ' + name + '!',
                'farewell': 'Farewell, ' + name + '!',
                'thank-you': 'Thank You, ' + name + '!',
                'congratulations': 'Congratulations, ' + name + '!',
                'retirement': 'Happy Retirement, ' + name + '!',
                'welcome': 'Welcome, ' + name + '!',
                'anniversary': 'Happy Anniversary, ' + name + '!',
                'baby': 'Welcome Baby, ' + name + '!',
                'get-well': 'Get Well Soon, ' + name + '!',
                'holidays': 'Happy Holidays, ' + name + '!',
                'graduation': 'Congrats on Graduating, ' + name + '!',
                'promotion': 'Congrats on the Promotion, ' + name + '!',
                'miss-you': 'We Miss You, ' + name + '!',
                'condolence': 'In Memory of ' + name,
                'custom': 'For ' + name,
            };
            titleInput.value = titles[el.dataset.occasion] || 'For ' + name;
        }
    }

    // Background Library
    (function() {
        fetch('/backgrounds/library.json')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var catContainer = document.getElementById('bg-categories');
            var libContainer = document.getElementById('bg-library');
            var selectedBg = null;

            function renderCategory(cat) {
                libContainer.textContent = '';
                // Add "None" option
                var none = document.createElement('button');
                none.type = 'button';
                none.setAttribute('aria-pressed', String(!selectedBg));
                none.style.cssText = 'height: 50px; border-radius: 8px; cursor: pointer; border: 2px solid ' + (!selectedBg ? 'var(--cf-accent)' : 'var(--cf-border)') + '; background: var(--cf-inset); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: var(--cf-text-3); font-family: inherit;';
                none.textContent = 'None';
                none.onclick = function() {
                    selectedBg = null;
                    document.getElementById('board_bg_image_url').value = '';
                    document.getElementById('board_bg_color').value = '';
                    renderCategory(cat);
                };
                libContainer.appendChild(none);

                cat.backgrounds.forEach(function(bg) {
                    var el = document.createElement('button');
                    el.type = 'button';
                    var isSelected = selectedBg === bg.id;
                    el.setAttribute('aria-pressed', String(isSelected));
                    el.setAttribute('aria-label', bg.label);
                    el.style.cssText = 'height: 50px; padding: 0; border-radius: 8px; cursor: pointer; border: 2px solid ' + (isSelected ? 'var(--cf-accent)' : 'var(--cf-border)') + '; overflow: hidden; position: relative; background: var(--cf-inset);';
                    if (bg.url) {
                        el.style.backgroundImage = 'url(' + bg.thumb + ')';
                        el.style.backgroundSize = 'cover';
                        el.style.backgroundPosition = 'center';
                    } else if (bg.color) {
                        el.style.backgroundColor = bg.color;
                    }
                    var label = document.createElement('div');
                    label.style.cssText = 'position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.6); font-size: 0.65rem; color: white; padding: 2px 4px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;';
                    label.textContent = bg.label;
                    el.appendChild(label);
                    el.onclick = function() {
                        selectedBg = bg.id;
                        document.getElementById('board_bg_image_url').value = bg.url || '';
                        document.getElementById('board_bg_color').value = bg.color || '';
                        renderCategory(cat);
                    };
                    libContainer.appendChild(el);
                });
            }

            data.categories.forEach(function(cat, i) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = cat.name;
                btn.className = 'btn btn-secondary btn-sm';
                btn.onclick = function() {
                    catContainer.querySelectorAll('button').forEach(function(b) { b.setAttribute('aria-pressed', 'false'); b.style.borderColor = ''; });
                    btn.setAttribute('aria-pressed', 'true');
                    btn.style.borderColor = 'var(--cf-accent)';
                    renderCategory(cat);
                };
                catContainer.appendChild(btn);
                if (i === 0) { btn.click(); }
            });
        })
        .catch(function() {
            document.getElementById('bg-library').textContent = 'Backgrounds could not be loaded. You can still add a cover image below.';
        });
    })();

    function selectCardType(el) {
        el.parentElement.querySelectorAll('.choice').forEach(function(o) { o.classList.remove('selected'); o.setAttribute('aria-checked', 'false'); });
        el.classList.add('selected');
        el.setAttribute('aria-checked', 'true');
        document.getElementById('card_type').value = el.dataset.type;
    }

    // Track if user manually edited the title
    document.getElementById('card_name').addEventListener('input', function() { this.dataset.userEdited = '1'; });

    // Auto-fill title when name changes
    document.getElementById('recipient_name').addEventListener('input', function() {
        var selected = document.querySelector('#occasion-grid .occasion-opt.selected');
        if (selected && !document.getElementById('card_name').dataset.userEdited) {
            selectOccasion(selected);
        }
    });

    document.getElementById('create-form').addEventListener('submit', function(e) {
        e.preventDefault();
        var errorDiv = document.getElementById('create-error');
        var btn = document.getElementById('create-btn');
        var recipientName = document.getElementById('recipient_name').value.trim();

        if (!recipientName) {
            errorDiv.textContent = 'Enter who the card is for.';
            errorDiv.style.display = 'block';
            document.getElementById('recipient_name').focus();
            return;
        }

        errorDiv.style.display = 'none';
        btn.disabled = true;
        var icon = btn.querySelector('i');
        if (icon) icon.className = 'fas fa-spinner fa-spin';

        var aiCover = document.getElementById('ai_cover_url').value.trim();
        var bgUrl = document.getElementById('background_url').value.trim();
        var body = {
            recipient_name: recipientName,
            card_name: document.getElementById('card_name').value.trim() || null,
            occasion: document.getElementById('occasion').value,
            creator_name: document.getElementById('creator_name').value.trim() || null,
            password: document.getElementById('password').value.trim() || null,
            background_music_url: document.getElementById('music_url').value.trim() || null,
            wishlist_url: document.getElementById('wishlist_url').value.trim() || null,
            deliver_at: document.getElementById('deliver_at').value || null,
            card_type: document.getElementById('card_type').value || 'board',
            board_bg_image_url: document.getElementById('board_bg_image_url').value || null,
            board_bg_color: document.getElementById('board_bg_color').value || null,
            card_background_url: aiCover || bgUrl || null,
            ai_cover_url: aiCover || null,
            ai_prompt: aiCover ? document.getElementById('ai_prompt').value.trim() : null,
        };

        fetch('/cards/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.url) {
                window.location.href = data.url;
            } else {
                errorDiv.textContent = data.error || 'Could not create the card.';
                errorDiv.style.display = 'block';
                btn.disabled = false;
                if (icon) icon.className = 'fas fa-plus';
            }
        })
        .catch(function() {
            errorDiv.textContent = 'Could not reach the server. Try again.';
            errorDiv.style.display = 'block';
            btn.disabled = false;
            if (icon) icon.className = 'fas fa-plus';
        });
    });

    // AI Cover Generator
    function generateAICover() {
        var prompt = document.getElementById('ai_prompt').value.trim();
        if (!prompt) { document.getElementById('ai_prompt').focus(); return; }

        var status = document.getElementById('ai-status');
        var btn = document.getElementById('ai-generate-btn');
        var icon = btn.querySelector('i');
        status.style.display = 'block';
        status.textContent = 'Making your cover…';
        status.className = '';
        btn.disabled = true;
        if (icon) icon.className = 'fas fa-spinner fa-spin';

        fetch('/cards/generate-cover', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: prompt })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            btn.disabled = false;
            if (icon) icon.className = 'fas fa-wand-magic-sparkles';
            if (data.url) {
                document.getElementById('ai_cover_url').value = data.url;
                document.getElementById('ai-preview-img').src = data.url;
                document.getElementById('ai-preview').style.display = 'block';
                status.textContent = 'Cover ready. It will be used on your card.';
                status.className = 'ok';
                // Clear the manual background URL since AI takes priority
                document.getElementById('background_url').value = '';
            } else {
                status.textContent = data.error || 'Could not make a cover. Try describing it differently.';
                status.className = 'err';
            }
        })
        .catch(function() {
            btn.disabled = false;
            if (icon) icon.className = 'fas fa-wand-magic-sparkles';
            status.textContent = 'Could not reach the server. Try again.';
            status.className = 'err';
        });
    }

    function clearAICover() {
        document.getElementById('ai_cover_url').value = '';
        document.getElementById('ai-preview').style.display = 'none';
        document.getElementById('ai-status').style.display = 'none';
    }
    </script>
</body>
</html>
