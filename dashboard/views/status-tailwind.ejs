<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Status - CertiFried MultiTool</title>
    <meta name="description" content="Check the live status of CertiFried MultiTool Discord bot. View uptime, active streams, and server statistics.">
    <meta name="theme-color" content="#a78bfa">
    <meta property="og:title" content="Status - CertiFried MultiTool">
    <meta property="og:description" content="Check the live status of CertiFried MultiTool Discord bot.">
    <meta property="og:image" content="/images/CertiFried.png">
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0b0f11;
            --bg-secondary: #0f1416;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.15);
            --text-primary: #e9edf0;
            --text-secondary: #a9b4b9;
            --text-muted: #6b7280;
            --accent-purple: #a78bfa;
            --accent-purple-dim: rgba(167, 139, 250, 0.15);
            --accent-green: #23f56b;
            --accent-green-dim: rgba(35, 245, 107, 0.15);
            --accent-red: #ef4444;
            --accent-blue: #60a5fa;
            --accent-yellow: #fbbf24;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(11, 15, 17, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-color);
        }

        .navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 70px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .navbar-logo {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }

        .navbar-links {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .navbar-link {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

        .navbar-link:hover { color: var(--text-primary); }
        .navbar-link.active { color: var(--text-primary); }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.65rem 1.25rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--accent-purple);
            color: white;
        }

        .btn-primary:hover {
            background: #9171f0;
            transform: translateY(-1px);
        }

        /* Main Content */
        main {
            padding-top: 70px;
            min-height: 100vh;
        }

        /* Hero Section */
        .status-hero {
            text-align: center;
            padding: 4rem 0 3rem;
            background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(35, 245, 107, 0.08), transparent 50%);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: var(--accent-green-dim);
            border: 1px solid rgba(35, 245, 107, 0.3);
            border-radius: 100px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--accent-green);
            margin-bottom: 1.5rem;
        }

        .status-badge-dot {
            width: 8px;
            height: 8px;
            background: var(--accent-green);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .status-title {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.75rem;
        }

        .status-subtitle {
            color: var(--text-secondary);
            font-size: 1.1rem;
        }

        /* Stats Hero Grid */
        .stats-hero {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            padding: 2rem 0 3rem;
        }

        .stat-hero-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.2s;
        }

        .stat-hero-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-2px);
        }

        .stat-hero-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .stat-hero-icon svg { width: 24px; height: 24px; }
        .stat-hero-icon.purple { background: var(--accent-purple-dim); color: var(--accent-purple); }
        .stat-hero-icon.green { background: var(--accent-green-dim); color: var(--accent-green); }
        .stat-hero-icon.blue { background: rgba(96, 165, 250, 0.15); color: var(--accent-blue); }
        .stat-hero-icon.red { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }

        .stat-hero-value {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 0.25rem;
        }

        .stat-hero-label {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* Section */
        .section {
            padding: 2rem 0;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .section-title {
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .live-dot {
            width: 10px;
            height: 10px;
            background: var(--accent-red);
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        /* Service Status Grid */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .service-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.2s;
        }

        .service-card:hover {
            border-color: var(--accent-green);
        }

        .service-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .service-icon svg { width: 22px; height: 22px; }

        .service-info { flex: 1; min-width: 0; }
        .service-name { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.125rem; }
        .service-detail { color: var(--text-muted); font-size: 0.8rem; }

        .service-status {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.25rem 0.625rem;
            background: var(--accent-green-dim);
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--accent-green);
        }

        .service-status-dot {
            width: 6px;
            height: 6px;
            background: var(--accent-green);
            border-radius: 50%;
        }

        /* Platform Grid */
        .platforms-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.75rem;
        }

        .platform-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
            transition: all 0.2s;
        }

        .platform-card:hover {
            border-color: var(--border-hover);
            transform: translateY(-2px);
        }

        .platform-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.625rem;
        }

        .platform-icon svg, .platform-icon img { width: 20px; height: 20px; }
        .platform-icon.twitch { background: rgba(145, 70, 255, 0.2); color: #a78bfa; }
        .platform-icon.kick { background: rgba(83, 252, 24, 0.2); }
        .platform-icon.youtube { background: rgba(255, 0, 0, 0.2); color: #f87171; }
        .platform-icon.tiktok { background: rgba(255, 255, 255, 0.1); color: #fff; }
        .platform-icon.trovo { background: rgba(25, 215, 96, 0.2); }
        .platform-icon.facebook { background: rgba(24, 119, 242, 0.2); color: #60a5fa; }
        .platform-icon.instagram { background: rgba(225, 48, 108, 0.2); color: #f472b6; }

        .platform-name { font-weight: 600; font-size: 0.8rem; margin-bottom: 0.125rem; }
        .platform-status { font-size: 0.7rem; color: var(--accent-green); }

        /* Streamers Grid */
        .streamers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1rem;
        }

        .streamer-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: 0.875rem;
            transition: all 0.2s;
        }

        .streamer-card:hover {
            border-color: var(--accent-purple);
        }

        .streamer-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--bg-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
            border: 2px solid var(--border-color);
        }

        .streamer-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .streamer-avatar svg { width: 20px; height: 20px; color: var(--text-muted); }

        .streamer-info { flex: 1; min-width: 0; }

        .streamer-name {
            font-weight: 600;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 0.25rem;
        }

        .streamer-platform {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
        }

        .streamer-platform svg { width: 12px; height: 12px; }
        .streamer-platform.twitch { background: rgba(145, 70, 255, 0.2); color: #a78bfa; }
        .streamer-platform.kick { background: rgba(83, 252, 24, 0.2); color: #53FC18; }
        .streamer-platform.youtube { background: rgba(255, 0, 0, 0.2); color: #f87171; }
        .streamer-platform.tiktok { background: rgba(255, 255, 255, 0.1); color: #fff; }
        .streamer-platform.trovo { background: rgba(25, 215, 96, 0.2); color: #34d399; }
        .streamer-platform.facebook { background: rgba(24, 119, 242, 0.2); color: #60a5fa; }
        .streamer-platform.instagram { background: rgba(225, 48, 108, 0.2); color: #f472b6; }

        .streamer-platform:hover { filter: brightness(1.2); }

        .streamer-link {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            text-decoration: none;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .streamer-link:hover {
            background: var(--accent-purple);
            border-color: var(--accent-purple);
            color: white;
        }

        .streamer-link svg { width: 14px; height: 14px; }

        .more-streamers {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            padding-top: 1rem;
        }

        /* Footer */
        .footer {
            padding: 2.5rem 0;
            border-top: 1px solid var(--border-color);
            margin-top: 3rem;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
        .footer-link { color: var(--text-secondary); text-decoration: none; font-size: 0.875rem; transition: color 0.2s; }
        .footer-link:hover { color: var(--accent-purple); }
        .footer-copyright { color: var(--text-muted); font-size: 0.8rem; }

        /* API Latency Grid */
        .api-latency-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .api-latency-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
            transition: all 0.2s;
        }

        .api-latency-card:hover {
            border-color: var(--border-hover);
        }

        .api-latency-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.5rem;
        }

        .api-latency-icon svg, .api-latency-icon img { width: 16px; height: 16px; }

        .api-latency-name { font-weight: 600; font-size: 0.8rem; margin-bottom: 0.25rem; }

        .api-latency-value {
            font-size: 1.1rem;
            font-weight: 700;
        }

        .api-latency-value.good { color: var(--accent-green); }
        .api-latency-value.medium { color: var(--accent-yellow); }
        .api-latency-value.slow { color: var(--accent-red); }

        .api-latency-status {
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        /* Gateway Card */
        .gateway-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .gateway-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .gateway-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(88, 101, 242, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .gateway-icon svg { width: 24px; height: 24px; color: #5865F2; }

        .gateway-title { font-weight: 600; font-size: 1rem; margin-bottom: 0.125rem; }
        .gateway-status { font-size: 0.8rem; color: var(--text-muted); }
        .gateway-status.online { color: var(--accent-green); }

        .gateway-metrics {
            display: flex;
            gap: 2rem;
        }

        .gateway-metric { text-align: center; }
        .gateway-metric-value { font-size: 1.5rem; font-weight: 700; color: var(--accent-purple); }
        .gateway-metric-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; }

        /* Quick Stats Row */
        .quick-stats {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .quick-stat {
            flex: 1;
            min-width: 120px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
        }

        .quick-stat-value { font-size: 1.25rem; font-weight: 700; color: var(--accent-purple); }
        .quick-stat-label { font-size: 0.7rem; color: var(--text-muted); margin-top: 0.25rem; }

        /* Loading spinner */
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .loading-spinner {
            width: 16px;
            height: 16px;
            border: 2px solid var(--border-color);
            border-top-color: var(--accent-purple);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: inline-block;
        }

        /* Mobile Menu */
        .mobile-menu-btn { display: none; background: none; border: none; color: var(--text-primary); font-size: 1.5rem; cursor: pointer; padding: 0.5rem; }
        .mobile-menu { display: none; position: fixed; inset: 0; background: rgba(11, 15, 17, 0.98); backdrop-filter: blur(20px); z-index: 999; padding: 100px 2rem; }
        .mobile-menu.active { display: block; }
        .mobile-menu-links { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
        .mobile-menu-link { color: var(--text-primary); text-decoration: none; font-size: 1.25rem; font-weight: 600; }

        /* Responsive */
        @media (max-width: 1024px) {
            .platforms-grid { grid-template-columns: repeat(4, 1fr); }
        }

        @media (max-width: 768px) {
            .navbar-links, .navbar-actions { display: none; }
            .mobile-menu-btn { display: block; }
            .stats-hero { grid-template-columns: repeat(2, 1fr); }
            .platforms-grid { grid-template-columns: repeat(3, 1fr); }
            .streamers-grid { grid-template-columns: 1fr; }
            .footer-content { flex-direction: column; text-align: center; }
            .footer-links { justify-content: center; }
        }

        @media (max-width: 480px) {
            .platforms-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-inner">
                <a href="/" class="navbar-brand">
                    <img src="/images/CertiFried.png" alt="CertiFried" class="navbar-logo">
                    <span>CertiFried</span>
                </a>
                <div class="navbar-links">
                    <a href="/" class="navbar-link">Home</a>
                    <a href="/commands" class="navbar-link">Commands</a>
                    <a href="/status" class="navbar-link active">Status</a>
                    <a href="/docs" class="navbar-link">Docs</a>
                </div>
                <div class="navbar-actions">
                    <% if (user) { %>
                        <a href="/servers" class="btn btn-primary">Dashboard</a>
                    <% } else { %>
                        <a href="/auth/discord" class="btn btn-primary">Login</a>
                    <% } %>
                </div>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-links">
            <a href="/" class="mobile-menu-link">Home</a>
            <a href="/commands" class="mobile-menu-link">Commands</a>
            <a href="/status" class="mobile-menu-link">Status</a>
            <a href="/docs" class="mobile-menu-link">Docs</a>
            <% if (user) { %>
                <a href="/servers" class="btn btn-primary">Dashboard</a>
            <% } else { %>
                <a href="/auth/discord" class="btn btn-primary">Login</a>
            <% } %>
        </div>
    </div>

    <main>
        <!-- Status Hero -->
        <section class="status-hero">
            <div class="container">
                <div class="status-badge">
                    <span class="status-badge-dot"></span>
                    All Systems Operational
                </div>
                <h1 class="status-title">System Status</h1>
                <p class="status-subtitle">Real-time monitoring of CertiFried MultiTool services</p>
            </div>
        </section>

        <!-- Stats Hero -->
        <div class="container">
            <div class="stats-hero">
                <div class="stat-hero-card">
                    <div class="stat-hero-icon red">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
                    </div>
                    <div class="stat-hero-value"><%= typeof liveStreamers !== 'undefined' ? liveStreamers.length : 0 %></div>
                    <div class="stat-hero-label">Currently Live</div>
                </div>
                <div class="stat-hero-card">
                    <div class="stat-hero-icon purple">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
                    </div>
                    <div class="stat-hero-value"><%= stats.guilds || 0 %></div>
                    <div class="stat-hero-label">Servers</div>
                </div>
                <div class="stat-hero-card">
                    <div class="stat-hero-icon green">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </div>
                    <div class="stat-hero-value"><%= stats.members ? stats.members.toLocaleString() : 0 %></div>
                    <div class="stat-hero-label">Members</div>
                </div>
                <div class="stat-hero-card">
                    <div class="stat-hero-icon blue">
