<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>">
<head>
<%- include('partials/site-head', { title: 'Status · CertiFried', description: 'Whether the CertiFried Discord bot, the dashboard and the platforms it relies on are working right now, and who is live.', path: '/status' }) %>
    <style>
        .st-banner { display: flex; align-items: center; gap: var(--cf-3); padding: var(--cf-4) var(--cf-5); margin-bottom: var(--cf-8); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .st-banner .cfs-dot { width: 10px; height: 10px; }
        .st-banner strong { font-size: var(--cf-text-lg); font-weight: 600; }
        .st-banner span.st-checked { margin-left: auto; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .st-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--cf-6); }
        @media (max-width: 860px) { .st-grid { grid-template-columns: minmax(0, 1fr); } }
        .st-h { margin: 0 0 var(--cf-3); font-size: var(--cf-text-md); font-weight: 600; color: var(--cf-text); }
        .st-state { display: inline-flex; align-items: center; gap: 6px; }
        .st-live { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: var(--cf-2); }
        .st-streamer { display: flex; align-items: center; gap: var(--cf-3); padding: var(--cf-2) var(--cf-3); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); color: var(--cf-text); text-decoration: none; min-width: 0; }
        a.st-streamer:hover { border-color: var(--cf-border-strong); color: var(--cf-text); }
        .st-streamer img, .st-streamer .st-ph { width: 36px; height: 36px; border-radius: 50%; flex: none; object-fit: cover; background: var(--cf-surface-2); }
        .st-streamer .cfs-row-title { display: block; font-size: var(--cf-text-sm); }
        .st-streamer .cfs-row-sub { display: block; }
        .st-more { margin: var(--cf-3) 0 0; font-size: var(--cf-text-sm); color: var(--cf-text-3); }
        .st-foot { margin-top: var(--cf-8); font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .st-foot a { color: var(--cf-text-2); }
        /* Super-admin incident panel (partials/status-incidents.ejs) */
        #incidents-section { margin-top: var(--cf-10); }
        :root:is([data-theme="light"], [data-theme="sand"]) { --si-major: #c2410c; }
        #incidents-section .section-title { margin: 0 0 var(--cf-3); font-size: var(--cf-text-md); font-weight: 600; }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: 'status', user: locals.user || null, returnTo: '/status' }) %>
<%
    const _stats = (typeof stats !== 'undefined' && stats) ? stats : {};
    const _live = (typeof liveStreamers !== 'undefined' && Array.isArray(liveStreamers)) ? liveStreamers : [];
    const _upSec = Number(_stats.uptime) || 0;
    const _fmtUp = (s) => { const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60); return d > 0 ? d + 'd ' + h + 'h' : (h > 0 ? h + 'h ' + m + 'm' : m + 'm'); };
    const _platformUrl = (p, u) => {
        const n = encodeURIComponent(String(u || ''));
        switch (String(p || '').toLowerCase()) {
            case 'twitch': return 'https://twitch.tv/' + n;
            case 'kick': return 'https://kick.com/' + n;
            case 'youtube': return 'https://youtube.com/@' + n;
            case 'tiktok': return 'https://tiktok.com/@' + n + '/live';
            case 'rumble': return 'https://rumble.com/user/' + n;
            default: return null;
        }
    };
    const _platformName = (p) => ({ twitch: 'Twitch', kick: 'Kick', youtube: 'YouTube', tiktok: 'TikTok', rumble: 'Rumble' })[String(p || '').toLowerCase()] || String(p || '');
%>
    <main id="main-content" tabindex="-1" class="cfs-main">
        <div class="cfs-pagehead">
            <h1>Status</h1>
            <p class="cfs-lede">Whether the bot, the dashboard and the platforms it relies on are working right now.</p>
        </div>

        <div class="st-banner" id="st-banner" role="status" aria-live="polite">
            <span class="cfs-dot" id="st-banner-dot"></span>
            <strong id="st-banner-text">Checking…</strong>
            <span class="st-checked" id="st-checked"></span>
        </div>

        <div class="st-grid">
            <section aria-labelledby="st-services-h">
                <h2 class="st-h" id="st-services-h">CertiFried</h2>
                <div class="cfs-rows">
                    <div class="cfs-row">
                        <div class="cfs-row-main"><div class="cfs-row-title">Discord bot</div><div class="cfs-row-sub" id="st-bot-sub">Up <%= _fmtUp(_upSec) %> &middot; gateway <%= Number(_stats.ping) >= 0 ? Number(_stats.ping) + ' ms' : 'not connected' %></div></div>
                        <div class="cfs-row-end st-state" id="st-bot"><span class="cfs-dot"></span><span>Checking</span></div>
                    </div>
                    <div class="cfs-row">
                        <div class="cfs-row-main"><div class="cfs-row-title">Dashboard and website</div><div class="cfs-row-sub">This page loaded from it</div></div>
                        <div class="cfs-row-end st-state"><span class="cfs-dot cfs-dot--ok"></span><span>Working</span></div>
                    </div>
                </div>
            </section>
            <section aria-labelledby="st-platforms-h">
                <h2 class="st-h" id="st-platforms-h">Platforms the bot relies on</h2>
                <div class="cfs-rows" id="st-platforms">
                    <div class="cfs-row"><div class="cfs-row-main"><div class="cfs-row-title">Discord API</div></div><div class="cfs-row-end st-state" data-api="discord"><span class="cfs-dot"></span><span>Checking</span></div></div>
                    <div class="cfs-row"><div class="cfs-row-main"><div class="cfs-row-title">Twitch API</div></div><div class="cfs-row-end st-state" data-api="twitch"><span class="cfs-dot"></span><span>Checking</span></div></div>
                    <div class="cfs-row"><div class="cfs-row-main"><div class="cfs-row-title">Kick</div></div><div class="cfs-row-end st-state" data-api="kick"><span class="cfs-dot"></span><span>Checking</span></div></div>
                </div>
            </section>
        </div>

        <section class="cfs-section" aria-labelledby="st-numbers-h">
            <h2 id="st-numbers-h">In numbers</h2>
            <div class="cfs-stats">
                <div class="cfs-stat"><b><%= Number(_stats.guilds || 0).toLocaleString('en-US') %></b><span>Discord servers</span></div>
                <div class="cfs-stat"><b><%= Number(_stats.members || 0).toLocaleString('en-US') %></b><span>Members in those servers</span></div>
                <div class="cfs-stat"><b><%= _live.length.toLocaleString('en-US') %></b><span>Tracked streamers live now</span></div>
                <div class="cfs-stat"><b id="st-scam">&ndash;</b><span>Scam domains blocked</span></div>
            </div>
        </section>

        <%- include('partials/status-incidents', { user: locals.user || null }) %>

        <section class="cfs-section" aria-labelledby="st-live-h">
            <h2 id="st-live-h">Live now<% if (_live.length) { %> <span class="cfs-badge"><%= _live.length %></span><% } %></h2>
            <% if (!_live.length) { %>
                <div class="cfs-rows"><div class="cfs-empty"><p>None of the streamers the bot tracks are live right now.</p></div></div>
            <% } else { %>
                <div class="st-live">
                    <% _live.slice(0, 24).forEach(function (s) {
                        const url = _platformUrl(s.platform, s.username);
                        const plats = (Array.isArray(s.allPlatforms) && s.allPlatforms.length ? s.allPlatforms : [s.platform]).map(_platformName).join(', ');
                    %>
                    <<%= url ? 'a' : 'div' %> class="st-streamer"<% if (url) { %> href="<%= url %>" target="_blank" rel="noopener"<% } %>>
                        <% if (s.profile_image_url && /^https:\/\//.test(s.profile_image_url)) { %><img src="<%= s.profile_image_url %>" alt="" width="36" height="36" loading="lazy" referrerpolicy="no-referrer"><% } else { %><span class="st-ph" aria-hidden="true"></span><% } %>
                        <span class="cfs-row-main"><span class="cfs-row-title"><%= s.display_name || s.username %></span><span class="cfs-row-sub"><%= plats %></span></span>
                    </<%= url ? 'a' : 'div' %>>
                    <% }); %>
                </div>
                <% if (_live.length > 24) { %><p class="st-more"><%= _live.length - 24 %> more streamers are live.</p><% } %>
            <% } %>
        </section>

        <p class="st-foot">Checked again every 30 seconds while this page is open. Machine-readable: <a href="/api/status/public/overview">/api/status/public/overview</a>.</p>
    </main>
<%- include('partials/site-footer') %>
<script>
(function () {
    function setState(el, state, label) {
        if (!el) return;
        var dot = el.querySelector('.cfs-dot');
        var txt = el.querySelector('span:last-child');
        dot.className = 'cfs-dot' + (state === 'ok' ? ' cfs-dot--ok' : state === 'warn' ? ' cfs-dot--warn' : state === 'bad' ? ' cfs-dot--bad' : '');
        txt.textContent = label;
    }
    function fmtUp(s) {
        s = Number(s) || 0;
        var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
        return d > 0 ? d + 'd ' + h + 'h' : (h > 0 ? h + 'h ' + m + 'm' : m + 'm');
    }
    function apiState(a) {
        if (!a) return ['', 'Unknown'];
        if (a.status !== 'online') return ['bad', 'Not responding'];
        if (a.latency_ms != null && a.latency_ms > 2000) return ['warn', 'Slow (' + a.latency_ms + ' ms)'];
        return ['ok', a.latency_ms != null ? a.latency_ms + ' ms' : 'Working'];
    }
    function render(d) {
        var problems = 0, slow = 0;
        var botOk = d.bot && d.bot.status === 'online';
        setState(document.getElementById('st-bot'), botOk ? 'ok' : 'bad', botOk ? 'Working' : 'Offline');
        if (!botOk) problems++;
        if (d.bot) {
            var sub = document.getElementById('st-bot-sub');
            sub.textContent = 'Up ' + fmtUp(d.bot.uptime_seconds) + ' · gateway ' + (d.bot.gateway_ping_ms != null && d.bot.gateway_ping_ms >= 0 ? d.bot.gateway_ping_ms + ' ms' : 'not connected');
        }
        var apis = d.external_apis || {};
        document.querySelectorAll('[data-api]').forEach(function (el) {
            var st = apiState(apis[el.getAttribute('data-api')]);
            setState(el, st[0], st[1]);
            if (st[0] === 'bad') problems++; else if (st[0] === 'warn') slow++;
        });
        if (d.metrics && d.metrics.scam_domains_blocked != null) {
            document.getElementById('st-scam').textContent = Number(d.metrics.scam_domains_blocked).toLocaleString('en-US');
        }
        var dot = document.getElementById('st-banner-dot'), text = document.getElementById('st-banner-text');
        if (!botOk) { dot.className = 'cfs-dot cfs-dot--bad'; text.textContent = 'The Discord bot is offline'; }
        else if (problems) { dot.className = 'cfs-dot cfs-dot--warn'; text.textContent = 'A platform the bot relies on is not responding'; }
        else if (slow) { dot.className = 'cfs-dot cfs-dot--warn'; text.textContent = 'Everything is working, some platforms are slow'; }
        else { dot.className = 'cfs-dot cfs-dot--ok'; text.textContent = 'Everything is working'; }
        var at = d.checked_at ? new Date(d.checked_at) : new Date();
        document.getElementById('st-checked').textContent = 'Checked ' + at.toLocaleTimeString();
    }
    function load() {
        fetch('/api/status/public/overview', { cache: 'no-store' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(render)
            .catch(function () {
                document.getElementById('st-banner-dot').className = 'cfs-dot cfs-dot--warn';
                document.getElementById('st-banner-text').textContent = 'Could not check the status just now';
                document.getElementById('st-checked').textContent = 'Retrying in 30 s';
                document.querySelectorAll('[data-api], #st-bot').forEach(function (el) { setState(el, '', 'Unknown'); });
            });
    }
    load();
    setInterval(function () { if (!document.hidden) load(); }, 30000);
})();
</script>
</body>
</html>
