                    <h2 class="section-title">
                        <span class="live-dot"></span>
                        Currently Live (<%= liveStreamers.length %>)
                    </h2>
                </div>
                <div class="streamers-grid">
                    <% liveStreamers.slice(0, 12).forEach(streamer => {
                        let platformUrl = '#';
                        let platformClass = streamer.platform.toLowerCase();

                        if (streamer.url) {
                            platformUrl = streamer.url;
                        } else {
                            switch(platformClass) {
                                case 'twitch': platformUrl = 'https://twitch.tv/' + streamer.username; break;
                                case 'kick': platformUrl = 'https://kick.com/' + streamer.username; break;
                                case 'youtube': platformUrl = 'https://youtube.com/@' + streamer.username; break;
                                case 'tiktok': platformUrl = 'https://tiktok.com/@' + streamer.username; break;
                                case 'trovo': platformUrl = 'https://trovo.live/' + streamer.username; break;
                                case 'facebook': platformUrl = 'https://facebook.com/' + streamer.username; break;
                                case 'instagram': platformUrl = 'https://instagram.com/' + streamer.username; break;
                            }
                        }
                    %>
                    <div class="streamer-card">
                        <div class="streamer-avatar">
                            <% if (streamer.profile_image_url) { %>
                                <img src="<%= streamer.profile_image_url %>" alt="<%= streamer.username %>">
                            <% } else { %>
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <% } %>
                        </div>
                        <div class="streamer-info">
                            <div class="streamer-name"><%= streamer.username %></div>
                            <a href="<%= platformUrl %>" target="_blank" class="streamer-platform <%= platformClass %>">
                                <% if (platformClass === 'twitch') { %>
                                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/></svg>
                                <% } else if (platformClass === 'youtube') { %>
                                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                <% } else if (platformClass === 'tiktok') { %>
                                    <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                                <% } else { %>
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
                                <% } %>
                                <%= streamer.platform %>
                            </a>
                        </div>
                        <a href="<%= platformUrl %>" target="_blank" class="streamer-link" title="Watch Stream">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                        </a>
                    </div>
                    <% }); %>
                </div>
                <% if (liveStreamers.length > 12) { %>
                <p class="more-streamers">And <%= liveStreamers.length - 12 %> more streamers are live...</p>
                <% } %>
            </section>
            <% } %>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-links">
                    <a href="/commands" class="footer-link">Commands</a>
                    <a href="/status" class="footer-link">Status</a>
                    <a href="/docs" class="footer-link">Documentation</a>
                    <a href="https://discord.com/invite/mJfbDgWA7z" target="_blank" class="footer-link">Support</a>
                    <a href="https://fivem.certifriedmultitool.com" target="_blank" class="footer-link">FiveM Server</a>
                    <a href="/terms" class="footer-link">Terms</a>
                    <a href="/privacy" class="footer-link">Privacy</a>
                </div>
                <p class="footer-copyright">&copy; <%= new Date().getFullYear() %> CertiFried MultiTool</p>
            </div>
        </div>
    </footer>

    <script>
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        if (mobileMenuBtn && mobileMenu) {
            mobileMenuBtn.addEventListener('click', () => {
                const isOpen = mobileMenu.classList.toggle('active');
                mobileMenuBtn.innerHTML = isOpen
                    ? '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
                    : '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
            });
        }

        // Format uptime
        function formatUptime(seconds) {
            const days = Math.floor(seconds / 86400);
            const hours = Math.floor((seconds % 86400) / 3600);
            const mins = Math.floor((seconds % 3600) / 60);
            if (days > 0) return `${days}d ${hours}h`;
            if (hours > 0) return `${hours}h ${mins}m`;
            return `${mins}m`;
        }

        // Fetch Gateway status
        async function fetchGatewayStatus() {
            try {
                const response = await fetch('/api/status/gateway');
                const data = await response.json();

                if (data.success && data.gateway) {
                    const gw = data.gateway;

                    // Update status
                    const statusText = document.getElementById('gateway-status-text');
                    if (gw.status === 'connected') {
                        statusText.textContent = 'Connected';
                        statusText.classList.add('online');
                    } else {
                        statusText.textContent = 'Disconnected';
                        statusText.classList.remove('online');
                    }

                    // Update ping
                    const pingEl = document.getElementById('gateway-ping');
                    pingEl.textContent = gw.pingText || '--';
                    pingEl.style.color = gw.ping < 100 ? 'var(--accent-green)' :
                                         gw.ping < 200 ? 'var(--accent-yellow)' : 'var(--accent-red)';

                    // Update uptime
                    if (gw.uptime) {
                        document.getElementById('gateway-uptime').textContent = formatUptime(gw.uptime / 1000);
                    }
                }
            } catch (error) {
                console.error('Failed to fetch gateway status:', error);
            }
        }

        // Fetch API health
        async function fetchApiHealth() {
            try {
                const response = await fetch('/api/status/api-health');
                const data = await response.json();

                if (data.success && data.apis) {
                    data.apis.forEach(api => {
                        const name = api.name.toLowerCase();
                        const latencyEl = document.getElementById(`latency-${name}`);
                        const statusEl = document.getElementById(`status-${name}`);

                        if (latencyEl && statusEl) {
                            if (api.status === 'online') {
                                const latency = api.latency;
                                latencyEl.textContent = `${latency}ms`;
                                latencyEl.className = 'api-latency-value ' +
                                    (latency < 200 ? 'good' : latency < 500 ? 'medium' : 'slow');
                                statusEl.textContent = 'Online';
                            } else if (api.status === 'timeout') {
                                latencyEl.textContent = 'Timeout';
                                latencyEl.className = 'api-latency-value slow';
                                statusEl.textContent = 'Slow';
                            } else {
                                latencyEl.textContent = 'Offline';
                                latencyEl.className = 'api-latency-value slow';
                                statusEl.textContent = 'Down';
                            }
                        }
                    });
                }
            } catch (error) {
                console.error('Failed to fetch API health:', error);
                // Show error state
                ['discord', 'twitch', 'kick', 'youtube', 'tiktok', 'trovo'].forEach(name => {
                    const latencyEl = document.getElementById(`latency-${name}`);
                    const statusEl = document.getElementById(`status-${name}`);
                    if (latencyEl) latencyEl.textContent = '--';
                    if (statusEl) statusEl.textContent = 'Error';
                });
            }
        }

        // Fetch FiveM server status
        async function fetchFiveMStatus() {
            try {
                const response = await fetch('/api/status/fivem');
                const data = await response.json();

                const statusText = document.getElementById('fivem-status-text');
                const statusLabel = document.getElementById('fivem-status-label');
                const statusBadge = document.getElementById('fivem-status-badge');
                const statusDot = statusBadge?.querySelector('.service-status-dot');

                if (data.online) {
                    statusText.textContent = `${data.players?.current || 0}/${data.players?.max || 64} Players`;
                    statusLabel.textContent = 'Online';
                    statusBadge.style.background = 'var(--accent-green-dim)';
                    statusBadge.style.color = 'var(--accent-green)';
                    if (statusDot) statusDot.style.background = 'var(--accent-green)';
                } else {
                    statusText.textContent = 'Blunt Trauma RP';
                    statusLabel.textContent = 'Offline';
                    statusBadge.style.background = 'rgba(239, 68, 68, 0.15)';
                    statusBadge.style.color = 'var(--accent-red)';
                    if (statusDot) statusDot.style.background = 'var(--accent-red)';
                }
            } catch (error) {
                const statusLabel = document.getElementById('fivem-status-label');
                if (statusLabel) statusLabel.textContent = 'Unknown';
            }
        }

        // Initial load
        document.addEventListener('DOMContentLoaded', () => {
            fetchGatewayStatus();
            fetchApiHealth();
            fetchFiveMStatus();

            // Refresh gateway every 10 seconds
            setInterval(fetchGatewayStatus, 10000);

            // Refresh API health every 60 seconds
            setInterval(fetchApiHealth, 60000);

            // Refresh FiveM status every 30 seconds
            setInterval(fetchFiveMStatus, 30000);
        });
    </script>
</body>
</html>
