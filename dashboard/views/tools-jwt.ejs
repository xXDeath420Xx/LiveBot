<%- include('partials/modern-header', {
    pageTitle: 'JWT Secret Key Generator',
    additionalCSS: []
}) %>

<style>
.tools-container {
    max-width: 1400px;
    margin: var(--spacing-8) auto;
    padding: var(--spacing-6);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--spacing-8);
}

.tools-sidebar {
    position: sticky;
    top: calc(var(--spacing-8));
    height: fit-content;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    box-shadow: var(--shadow-base);
    transition: all var(--transition-base);
}

.tools-sidebar h3 {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
}

.tools-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
}

.tools-nav-section {
    margin-bottom: var(--spacing-4);
}

.tools-nav-heading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-2);
}

.tools-nav-link {
    display: block;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: all var(--transition-base);
}

.tools-nav-link:hover {
    background: var(--color-dark-600);
    color: var(--color-text-primary);
}

.tools-nav-link.active {
    background: var(--gradient-primary);
    color: white;
}

.tools-content {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-xl);
    padding: var(--spacing-8);
    box-shadow: var(--shadow-base);
    transition: all var(--transition-base);
}

.tools-header {
    margin-bottom: var(--spacing-8);
    padding-bottom: var(--spacing-6);
    border-bottom: 2px solid var(--color-border-primary);
}

.tools-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-3);
}

.tools-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
}

.tool-section {
    margin-bottom: var(--spacing-10);
}

.tool-section h2 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
}

.tool-section h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-top: var(--spacing-6);
    margin-bottom: var(--spacing-3);
}

.tool-section p {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-4);
}

.generator-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    margin-bottom: var(--spacing-6);
}

.generator-options {
    display: flex;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-4);
    flex-wrap: wrap;
}

.option-btn {
    padding: var(--spacing-3) var(--spacing-5);
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-border-primary);
    background: var(--color-bg-primary);
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
}

.option-btn:hover {
    border-color: var(--color-primary-500);
    color: var(--color-text-primary);
}

.option-btn.active {
    background: var(--gradient-primary);
    border-color: transparent;
    color: white;
}

.secret-output {
    position: relative;
    margin-bottom: var(--spacing-4);
}

.secret-display {
    width: 100%;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-4);
    color: var(--color-success-400);
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: var(--font-size-sm);
    word-break: break-all;
    min-height: 60px;
    resize: none;
}

.action-buttons {
    display: flex;
    gap: var(--spacing-3);
    flex-wrap: wrap;
}

.btn-generate {
    background: var(--gradient-primary);
    color: white;
    border: none;
    padding: var(--spacing-3) var(--spacing-6);
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
}

.btn-generate:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.btn-copy {
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-primary);
    padding: var(--spacing-3) var(--spacing-6);
    border-radius: var(--radius-lg);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition: all var(--transition-base);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
}

.btn-copy:hover {
    background: var(--color-dark-600);
}

.btn-copy.copied {
    background: var(--color-success-600);
    border-color: var(--color-success-500);
    color: white;
}

.jwt-encoder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-6);
}

.jwt-panel {
    display: flex;
    flex-direction: column;
}

.jwt-panel label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.jwt-textarea {
    width: 100%;
    min-height: 150px;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-4);
    color: var(--color-text-primary);
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: var(--font-size-sm);
    resize: vertical;
}

.jwt-textarea:focus {
    outline: none;
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

.jwt-token-display {
    color: var(--color-text-primary);
    word-break: break-all;
}

.jwt-token-display .header {
    color: #ff6b6b;
}

.jwt-token-display .payload {
    color: #d946ef;
}

.jwt-token-display .signature {
    color: #22d3ee;
}

.info-box {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.15) 100%);
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-left: 4px solid var(--color-primary-500);
    padding: var(--spacing-4);
    border-radius: var(--radius-lg);
    margin: var(--spacing-4) 0;
}

.warning-box {
    background: linear-gradient(135deg, rgba(250, 166, 26, 0.15) 0%, rgba(250, 166, 26, 0.1) 100%);
    border: 1px solid rgba(250, 166, 26, 0.3);
    border-left: 4px solid var(--color-warning-500);
    padding: var(--spacing-4);
    border-radius: var(--radius-lg);
    margin: var(--spacing-4) 0;
}

.jwt-structure {
    display: grid;
    gap: var(--spacing-4);
    margin: var(--spacing-6) 0;
}

.structure-part {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-4);
}

.structure-part h4 {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-2);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
}

.structure-part.header-part h4 {
    color: #ff6b6b;
}

.structure-part.payload-part h4 {
    color: #d946ef;
}

.structure-part.signature-part h4 {
    color: #22d3ee;
}

.code-block {
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-primary);
    border-radius: var(--radius-md);
    padding: var(--spacing-3);
    font-family: 'Monaco', 'Courier New', monospace;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    overflow-x: auto;
    margin-top: var(--spacing-3);
}

.algorithm-table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--spacing-4) 0;
}

.algorithm-table th,
.algorithm-table td {
    padding: var(--spacing-3) var(--spacing-4);
    text-align: left;
    border-bottom: 1px solid var(--color-border-primary);
}

.algorithm-table th {
    background: var(--color-bg-secondary);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
}

.algorithm-table td {
    color: var(--color-text-secondary);
}

.algorithm-table tr:hover td {
    background: var(--color-bg-secondary);
}

@media (max-width: 992px) {
    .tools-container {
        grid-template-columns: 1fr;
    }

    .tools-sidebar {
        position: static;
    }

    .jwt-encoder {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="breadcrumb-modern" style="margin-bottom: var(--spacing-6); max-width: 1400px; margin-left: auto; margin-right: auto; padding: var(--spacing-3) var(--spacing-4);">
    <a href="/"><i class="fas fa-home"></i> Home</a>
    <span class="breadcrumb-modern-separator"><i class="fas fa-chevron-right"></i></span>
    <a href="/docs">Documentation</a>
    <span class="breadcrumb-modern-separator"><i class="fas fa-chevron-right"></i></span>
    <span style="color: var(--color-text-primary);">JWT Tools</span>
</div>

<div class="tools-container">
    <aside class="tools-sidebar">
        <div style="background: var(--color-bg-secondary); padding: var(--spacing-4); border-radius: var(--radius-lg); margin-bottom: var(--spacing-6);">
            <h3 style="margin: 0;"><i class="fas fa-tools" style="color: var(--color-primary-500);"></i> Tools</h3>
        </div>
        <nav class="tools-nav">
            <div class="tools-nav-section">
                <div class="tools-nav-heading">JWT Tools</div>
                <a href="#generator" class="tools-nav-link active">Secret Key Generator</a>
                <a href="#encoder" class="tools-nav-link">JWT Encoder</a>
                <a href="#decoder" class="tools-nav-link">JWT Decoder</a>
            </div>
            <div class="tools-nav-section">
                <div class="tools-nav-heading">Learn</div>
                <a href="#what-is-jwt" class="tools-nav-link">What is JWT?</a>
                <a href="#structure" class="tools-nav-link">JWT Structure</a>
                <a href="#algorithms" class="tools-nav-link">Algorithms</a>
            </div>
            <div class="tools-nav-section">
                <div class="tools-nav-heading">Resources</div>
                <a href="/docs" class="tools-nav-link">Documentation</a>
                <a href="https://jwt.io" target="_blank" class="tools-nav-link">jwt.io <i class="fas fa-external-link-alt" style="font-size: 0.7em;"></i></a>
            </div>
        </nav>
    </aside>

    <main class="tools-content">
        <div class="tools-header">
            <h1 class="tools-title"><i class="fas fa-key" style="color: var(--color-warning-400);"></i> JWT Secret Key Generator</h1>
            <p class="tools-subtitle">Generate cryptographically secure secret keys for JWT signing and explore JWT encoding/decoding</p>
        </div>

        <!-- Secret Key Generator -->
        <div class="tool-section" id="generator">
            <h2><i class="fas fa-dice" style="color: var(--color-primary-400);"></i> Secret Key Generator</h2>
            <p>Generate a cryptographically secure random secret key for signing JWTs. Choose the appropriate key size based on your HMAC algorithm:</p>

            <div class="generator-card">
                <div class="generator-options">
                    <button class="option-btn active" data-bits="256" data-alg="HS256">
                        <strong>256-bit</strong> (HS256)
                    </button>
                    <button class="option-btn" data-bits="384" data-alg="HS384">
                        <strong>384-bit</strong> (HS384)
                    </button>
                    <button class="option-btn" data-bits="512" data-alg="HS512">
                        <strong>512-bit</strong> (HS512)
                    </button>
                </div>

                <div class="secret-output">
                    <label style="font-size: var(--font-size-sm); color: var(--color-text-muted); margin-bottom: var(--spacing-2); display: block;">
                        Generated Secret Key (Base64 Encoded)
                    </label>
                    <textarea id="secretKey" class="secret-display" readonly placeholder="Click 'Generate' to create a new secret key..."></textarea>
                </div>

                <div class="action-buttons">
                    <button id="generateBtn" class="btn-generate">
                        <i class="fas fa-sync-alt"></i> Generate Secret
                    </button>
                    <button id="copySecretBtn" class="btn-copy">
                        <i class="fas fa-copy"></i> Copy to Clipboard
                    </button>
                </div>

                <div class="info-box" style="margin-top: var(--spacing-4);">
                    <strong><i class="fas fa-info-circle"></i> Key Size Recommendations</strong>
                    <ul style="margin: var(--spacing-2) 0 0 var(--spacing-6); color: var(--color-text-secondary);">
                        <li><strong>HS256</strong>: 256-bit (32 bytes) - Most common, suitable for most applications</li>
                        <li><strong>HS384</strong>: 384-bit (48 bytes) - Higher security for sensitive data</li>
                        <li><strong>HS512</strong>: 512-bit (64 bytes) - Maximum security for critical systems</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- JWT Encoder -->
        <div class="tool-section" id="encoder">
            <h2><i class="fas fa-lock" style="color: var(--color-success-400);"></i> JWT Encoder</h2>
            <p>Create a signed JWT token from your payload data using your secret key.</p>

            <div class="generator-card">
                <div class="jwt-encoder">
                    <div class="jwt-panel">
                        <label>Header (Auto-generated)</label>
                        <textarea id="jwtHeader" class="jwt-textarea" style="min-height: 100px;">{"alg": "HS256", "typ": "JWT"}</textarea>
                    </div>
                    <div class="jwt-panel">
                        <label>Payload (Claims)</label>
                        <textarea id="jwtPayload" class="jwt-textarea" placeholder='{"sub": "1234567890", "name": "John Doe", "iat": 1516239022}'></textarea>
                    </div>
                </div>

                <div class="jwt-panel" style="margin-top: var(--spacing-4);">
                    <label>Secret Key</label>
                    <input type="text" id="encodeSecret" class="jwt-textarea" style="min-height: auto; padding: var(--spacing-3);" placeholder="Enter your secret key or use the generated one above">
                </div>

                <div class="action-buttons" style="margin-top: var(--spacing-4);">
                    <button id="encodeBtn" class="btn-generate">
                        <i class="fas fa-lock"></i> Encode JWT
                    </button>
                    <button id="useGeneratedKey" class="btn-copy">
                        <i class="fas fa-arrow-up"></i> Use Generated Key
                    </button>
                </div>

                <div class="jwt-panel" style="margin-top: var(--spacing-4);">
                    <label>Encoded JWT Token</label>
                    <div id="encodedToken" class="secret-display jwt-token-display" style="min-height: 80px; cursor: pointer;" title="Click to copy">
                        <span class="placeholder" style="color: var(--color-text-muted);">Your encoded JWT will appear here...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- JWT Decoder -->
        <div class="tool-section" id="decoder">
            <h2><i class="fas fa-unlock" style="color: var(--color-warning-400);"></i> JWT Decoder</h2>
            <p>Decode and inspect the contents of a JWT token. This does not verify the signature.</p>

            <div class="generator-card">
                <div class="jwt-panel">
                    <label>Paste JWT Token</label>
                    <textarea id="tokenToDecode" class="jwt-textarea" placeholder="Paste your JWT token here (e.g., eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)"></textarea>
                </div>

                <div class="action-buttons" style="margin-top: var(--spacing-4);">
                    <button id="decodeBtn" class="btn-generate">
                        <i class="fas fa-unlock"></i> Decode JWT
                    </button>
                    <button id="clearDecodeBtn" class="btn-copy">
                        <i class="fas fa-trash"></i> Clear
                    </button>
                </div>

                <div class="jwt-encoder" style="margin-top: var(--spacing-4);">
                    <div class="jwt-panel">
                        <label>Decoded Header</label>
                        <pre id="decodedHeader" class="secret-display" style="color: #ff6b6b; white-space: pre-wrap;">-</pre>
                    </div>
                    <div class="jwt-panel">
                        <label>Decoded Payload</label>
                        <pre id="decodedPayload" class="secret-display" style="color: #d946ef; white-space: pre-wrap;">-</pre>
                    </div>
                </div>

                <div class="warning-box" style="margin-top: var(--spacing-4);">
                    <strong><i class="fas fa-exclamation-triangle"></i> Security Warning</strong>
                    <p style="margin: var(--spacing-2) 0 0 0; color: var(--color-text-secondary);">
                        This decoder only shows the token contents without verifying the signature.
                        Never trust decoded data without proper server-side signature verification.
                    </p>
                </div>
            </div>
        </div>

        <!-- What is JWT -->
        <div class="tool-section" id="what-is-jwt">
            <h2><i class="fas fa-question-circle" style="color: var(--color-info-400);"></i> What is JWT?</h2>
            <p>
                JSON Web Token (JWT) is an open standard (RFC 7519) that defines a compact and self-contained way for
                securely transmitting information between parties as a JSON object. This information can be verified
                and trusted because it is digitally signed.
            </p>

            <h3>When to Use JWTs</h3>
            <ul style="color: var(--color-text-secondary); margin-left: var(--spacing-6);">
                <li><strong>Authorization</strong>: The most common scenario. After login, each subsequent request includes the JWT,
                    allowing access to routes, services, and resources permitted with that token.</li>
                <li><strong>Information Exchange</strong>: JWTs are a good way of securely transmitting information between parties.
                    Because JWTs can be signed, you can verify the sender and ensure content hasn't been tampered with.</li>
            </ul>

            <div class="info-box">
                <strong><i class="fas fa-lightbulb"></i> Key Benefits</strong>
                <ul style="margin: var(--spacing-2) 0 0 var(--spacing-6); color: var(--color-text-secondary);">
                    <li><strong>Compact</strong>: Small size makes them efficient to transmit via URL, POST parameter, or HTTP header</li>
                    <li><strong>Self-contained</strong>: The payload contains all required user information, avoiding multiple database queries</li>
                    <li><strong>Stateless</strong>: No need to store session information server-side</li>
                </ul>
            </div>
        </div>

        <!-- JWT Structure -->
        <div class="tool-section" id="structure">
            <h2><i class="fas fa-puzzle-piece" style="color: var(--color-purple-400);"></i> JWT Structure</h2>
            <p>A JWT consists of three parts separated by dots (.), which are:</p>

            <div class="jwt-structure">
                <div class="structure-part header-part">
                    <h4><i class="fas fa-tag"></i> Header</h4>
                    <p style="color: var(--color-text-secondary); margin: 0;">
                        The header typically consists of two parts: the type of token (JWT) and the signing algorithm being used (e.g., HMAC SHA256 or RSA).
                    </p>
                    <div class="code-block">
{
  "alg": "HS256",
  "typ": "JWT"
}
                    </div>
                </div>

                <div class="structure-part payload-part">
                    <h4><i class="fas fa-database"></i> Payload</h4>
                    <p style="color: var(--color-text-secondary); margin: 0;">
                        Contains the claims - statements about an entity (typically the user) and additional data.
                    </p>
                    <div class="code-block">
{
  "sub": "1234567890",
  "name": "John Doe",
  "admin": true,
  "iat": 1516239022
}
                    </div>
                </div>

                <div class="structure-part signature-part">
                    <h4><i class="fas fa-signature"></i> Signature</h4>
                    <p style="color: var(--color-text-secondary); margin: 0;">
                        Created by taking the encoded header, encoded payload, a secret, and the algorithm specified in the header, then signing them.
                    </p>
                    <div class="code-block">
HMACSHA256(
  base64UrlEncode(header) + "." +
  base64UrlEncode(payload),
  secret
)
                    </div>
                </div>
            </div>

            <p style="margin-top: var(--spacing-4);">The output is three Base64-URL strings separated by dots:</p>
            <div class="code-block" style="color: var(--color-text-primary);">
                <span style="color: #ff6b6b;">xxxxx</span>.<span style="color: #d946ef;">yyyyy</span>.<span style="color: #22d3ee;">zzzzz</span>
            </div>
        </div>

        <!-- Algorithms -->
        <div class="tool-section" id="algorithms">
            <h2><i class="fas fa-cog" style="color: var(--color-success-400);"></i> Signing Algorithms</h2>
            <p>JWTs support various signing algorithms. Here are the most commonly used:</p>

            <table class="algorithm-table">
                <thead>
                    <tr>
                        <th>Algorithm</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Key Size</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>HS256</strong></td>
                        <td>Symmetric</td>
                        <td>HMAC using SHA-256</td>
                        <td>256 bits (32 bytes)</td>
                    </tr>
                    <tr>
                        <td><strong>HS384</strong></td>
                        <td>Symmetric</td>
                        <td>HMAC using SHA-384</td>
                        <td>384 bits (48 bytes)</td>
                    </tr>
                    <tr>
                        <td><strong>HS512</strong></td>
                        <td>Symmetric</td>
                        <td>HMAC using SHA-512</td>
                        <td>512 bits (64 bytes)</td>
                    </tr>
                    <tr>
                        <td><strong>RS256</strong></td>
                        <td>Asymmetric</td>
                        <td>RSA Signature with SHA-256</td>
                        <td>2048+ bits</td>
                    </tr>
                    <tr>
                        <td><strong>RS384</strong></td>
                        <td>Asymmetric</td>
                        <td>RSA Signature with SHA-384</td>
                        <td>2048+ bits</td>
                    </tr>
                    <tr>
                        <td><strong>RS512</strong></td>
                        <td>Asymmetric</td>
                        <td>RSA Signature with SHA-512</td>
                        <td>2048+ bits</td>
                    </tr>
                    <tr>
                        <td><strong>ES256</strong></td>
                        <td>Asymmetric</td>
                        <td>ECDSA using P-256 and SHA-256</td>
                        <td>256 bits</td>
                    </tr>
                </tbody>
            </table>

            <div class="info-box">
                <strong><i class="fas fa-shield-alt"></i> Security Best Practices</strong>
                <ul style="margin: var(--spacing-2) 0 0 var(--spacing-6); color: var(--color-text-secondary);">
                    <li>Use a strong, randomly generated secret key (this tool generates cryptographically secure keys)</li>
                    <li>Set appropriate token expiration times (exp claim)</li>
                    <li>Use HTTPS to transmit tokens</li>
                    <li>Store tokens securely (httpOnly cookies for web apps)</li>
                    <li>Validate all claims on the server side</li>
                    <li>Consider using asymmetric algorithms (RS256, ES256) for distributed systems</li>
                </ul>
            </div>
        </div>
    </main>
</div>

<script>
// Secret Key Generator
let selectedBits = 256;

document.querySelectorAll('.option-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.option-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedBits = parseInt(btn.dataset.bits);

        // Update header algorithm
        const alg = btn.dataset.alg;
        document.getElementById('jwtHeader').value = JSON.stringify({ alg: alg, typ: "JWT" }, null, 2);
    });
});

function generateSecretKey(bits) {
    const bytes = bits / 8;
    const array = new Uint8Array(bytes);
    crypto.getRandomValues(array);

    // Convert to base64
    let binary = '';
    for (let i = 0; i < array.length; i++) {
        binary += String.fromCharCode(array[i]);
    }
    return btoa(binary);
}

document.getElementById('generateBtn').addEventListener('click', () => {
    const secret = generateSecretKey(selectedBits);
    document.getElementById('secretKey').value = secret;

    // Animation
    const btn = document.getElementById('generateBtn');
    btn.innerHTML = '<i class="fas fa-check"></i> Generated!';
    setTimeout(() => {
        btn.innerHTML = '<i class="fas fa-sync-alt"></i> Generate Secret';
    }, 1500);
});

document.getElementById('copySecretBtn').addEventListener('click', async () => {
    const secret = document.getElementById('secretKey').value;
    if (!secret) {
        alert('Generate a secret key first!');
        return;
    }

    await navigator.clipboard.writeText(secret);
    const btn = document.getElementById('copySecretBtn');
    btn.classList.add('copied');
    btn.innerHTML = '<i class="fas fa-check"></i> Copied!';
    setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '<i class="fas fa-copy"></i> Copy to Clipboard';
    }, 2000);
});

// Use generated key in encoder
document.getElementById('useGeneratedKey').addEventListener('click', () => {
    const secret = document.getElementById('secretKey').value;
    if (!secret) {
        alert('Generate a secret key first!');
        return;
    }
    document.getElementById('encodeSecret').value = secret;
});

// JWT Encoder (simple HMAC-SHA256 implementation using Web Crypto API)
function base64UrlEncode(str) {
    return btoa(str)
        .replace(/\+/g, '-')
        .replace(/\//g, '_')
        .replace(/=+$/, '');
}

function base64UrlDecode(str) {
    str = str.replace(/-/g, '+').replace(/_/g, '/');
    while (str.length % 4) str += '=';
    return atob(str);
}

async function signHS256(data, secret) {
    const encoder = new TextEncoder();
    const key = await crypto.subtle.importKey(
        'raw',
        encoder.encode(secret),
        { name: 'HMAC', hash: 'SHA-256' },
        false,
        ['sign']
    );

    const signature = await crypto.subtle.sign('HMAC', key, encoder.encode(data));
    const signatureArray = new Uint8Array(signature);

    let binary = '';
    for (let i = 0; i < signatureArray.length; i++) {
        binary += String.fromCharCode(signatureArray[i]);
    }
    return base64UrlEncode(binary);
}

document.getElementById('encodeBtn').addEventListener('click', async () => {
    try {
        const header = document.getElementById('jwtHeader').value;
        const payload = document.getElementById('jwtPayload').value;
        const secret = document.getElementById('encodeSecret').value;

        if (!payload) {
            alert('Please enter a payload!');
            return;
        }
        if (!secret) {
            alert('Please enter a secret key!');
            return;
        }

        // Validate JSON
        JSON.parse(header);
        JSON.parse(payload);

        const encodedHeader = base64UrlEncode(header);
        const encodedPayload = base64UrlEncode(payload);
        const dataToSign = encodedHeader + '.' + encodedPayload;
        const signature = await signHS256(dataToSign, secret);

        const token = dataToSign + '.' + signature;

        document.getElementById('encodedToken').innerHTML =
            '<span class="header">' + encodedHeader + '</span>.' +
            '<span class="payload">' + encodedPayload + '</span>.' +
            '<span class="signature">' + signature + '</span>';

    } catch (e) {
        alert('Error: ' + e.message);
    }
});

// Click to copy encoded token
document.getElementById('encodedToken').addEventListener('click', async () => {
    const token = document.getElementById('encodedToken').textContent;
    if (token && !token.includes('will appear here')) {
        await navigator.clipboard.writeText(token);
        const el = document.getElementById('encodedToken');
        const originalContent = el.innerHTML;
        el.innerHTML = '<span style="color: var(--color-success-400);"><i class="fas fa-check"></i> Copied to clipboard!</span>';
        setTimeout(() => {
            el.innerHTML = originalContent;
        }, 1500);
    }
});

// JWT Decoder
document.getElementById('decodeBtn').addEventListener('click', () => {
    const token = document.getElementById('tokenToDecode').value.trim();
    if (!token) {
        alert('Please paste a JWT token!');
        return;
    }

    const parts = token.split('.');
    if (parts.length !== 3) {
        alert('Invalid JWT format! JWT should have 3 parts separated by dots.');
        return;
    }

    try {
        const header = JSON.parse(base64UrlDecode(parts[0]));
        const payload = JSON.parse(base64UrlDecode(parts[1]));

        document.getElementById('decodedHeader').textContent = JSON.stringify(header, null, 2);
        document.getElementById('decodedPayload').textContent = JSON.stringify(payload, null, 2);
    } catch (e) {
        alert('Error decoding token: ' + e.message);
    }
});

document.getElementById('clearDecodeBtn').addEventListener('click', () => {
    document.getElementById('tokenToDecode').value = '';
    document.getElementById('decodedHeader').textContent = '-';
    document.getElementById('decodedPayload').textContent = '-';
});

// Navigation highlighting
const sections = document.querySelectorAll('.tool-section');
const navLinks = document.querySelectorAll('.tools-nav-link');

function highlightNav() {
    let current = '';

    sections.forEach(section => {
        const sectionTop = section.offsetTop;
        if (scrollY >= sectionTop - 200) {
            current = section.getAttribute('id');
        }
    });

    navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + current) {
            link.classList.add('active');
        }
    });
}

window.addEventListener('scroll', highlightNav);
highlightNav();

// Generate initial secret on page load
document.getElementById('generateBtn').click();
</script>

