<%#
  /tools/jwt — public JWT helper (dashboard/server.js, no login). Everything runs in the browser with
  Web Crypto; nothing typed here is sent to the server.
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: ('JWT tools') + ' · CertiFried', description: 'Generate JWT signing secrets, sign and decode JSON Web Tokens in your browser.' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
</head>
<body class="cfs-body cf-site">
<%- include('partials/site-header', { user: locals.user || null }) %>
<main id="main-content" class="cf-main" tabindex="-1">
<div class="cf-page">
    <div class="cf-page-head">
        <div class="cf-page-icon"><i class="fas fa-key" aria-hidden="true"></i></div>
        <div>
            <h1 class="cf-page-title">JWT tools</h1>
            <p class="cf-page-sub">Make a signing secret, sign a token or read one. It all runs in your browser; nothing you type is sent to us.</p>
        </div>
    </div>

    <nav class="cf-tabs jwt-tabs" aria-label="On this page">
        <a class="cf-tab" href="#generator">Secret</a>
        <a class="cf-tab" href="#encoder">Sign</a>
        <a class="cf-tab" href="#decoder">Decode</a>
        <a class="cf-tab" href="#reference">Reference</a>
    </nav>

    <section class="cf-section" id="generator" aria-labelledby="jwt-gen-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="jwt-gen-title">Signing secret</h2>
                <p class="cf-section-desc">A random key from your browser's secure random generator, Base64 encoded. Use at least as many bits as the algorithm's hash.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text"><span class="cf-row-label" id="jwt-size-label">Key size</span></div>
                <div class="cf-row-control">
                    <div class="cf-segmented" role="group" aria-labelledby="jwt-size-label" id="jwt-size">
                        <button type="button" class="option-btn" data-bits="256" data-alg="HS256" aria-pressed="true">256-bit · HS256</button>
                        <button type="button" class="option-btn" data-bits="384" data-alg="HS384" aria-pressed="false">384-bit · HS384</button>
                        <button type="button" class="option-btn" data-bits="512" data-alg="HS512" aria-pressed="false">512-bit · HS512</button>
                    </div>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><label class="cf-row-label" for="secretKey">Secret</label></div>
                <div class="cf-row-control"><textarea id="secretKey" class="jwt-mono" rows="3" readonly></textarea></div>
            </div>
            <div class="cf-section-foot jwt-foot">
                <span class="cf-status-line" id="genStatus" aria-live="polite"></span>
                <button type="button" id="copySecretBtn" class="btn btn-secondary btn-sm"><i class="fas fa-copy" aria-hidden="true"></i> Copy</button>
                <button type="button" id="generateBtn" class="btn btn-primary btn-sm"><i class="fas fa-rotate" aria-hidden="true"></i> New secret</button>
            </div>
        </div>
    </section>

    <section class="cf-section" id="encoder" aria-labelledby="jwt-enc-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="jwt-enc-title">Sign a token</h2>
                <p class="cf-section-desc">HMAC tokens (HS256, HS384, HS512). The header's "alg" decides the hash.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><label class="cf-row-label" for="jwtHeader">Header</label></div>
                <div class="cf-row-control"><textarea id="jwtHeader" class="jwt-mono" rows="3">{"alg": "HS256", "typ": "JWT"}</textarea></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><label class="cf-row-label" for="jwtPayload">Payload</label><p class="cf-row-desc">Your claims as JSON, for example sub, name, iat and exp.</p></div>
                <div class="cf-row-control"><textarea id="jwtPayload" class="jwt-mono" rows="5" placeholder='{"sub": "1234567890", "name": "Jane", "iat": 1516239022}'></textarea></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><label class="cf-row-label" for="encodeSecret">Secret</label></div>
                <div class="cf-row-control">
                    <div class="cf-input-group">
                        <input type="text" id="encodeSecret" class="jwt-mono" autocomplete="off" spellcheck="false" placeholder="Your secret">
                        <button type="button" id="useGeneratedKey" class="btn btn-secondary btn-sm">Use the secret above</button>
                    </div>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><span class="cf-row-label">Token</span><p class="cf-row-desc">Header, payload and signature, separated by dots.</p></div>
                <div class="cf-row-control"><div id="encodedToken" class="jwt-out jwt-mono" aria-live="polite"><span class="cf-muted">Sign to see the token.</span></div></div>
            </div>
            <div class="cf-section-foot jwt-foot">
                <span class="cf-status-line" id="encStatus" aria-live="polite"></span>
                <button type="button" id="copyTokenBtn" class="btn btn-secondary btn-sm" disabled><i class="fas fa-copy" aria-hidden="true"></i> Copy token</button>
                <button type="button" id="encodeBtn" class="btn btn-primary btn-sm"><i class="fas fa-lock" aria-hidden="true"></i> Sign</button>
            </div>
        </div>
    </section>

    <section class="cf-section" id="decoder" aria-labelledby="jwt-dec-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="jwt-dec-title">Decode a token</h2>
                <p class="cf-section-desc">Shows what is inside a token. It does not check the signature, so never trust the contents on this alone.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><label class="cf-row-label" for="tokenToDecode">Token</label></div>
                <div class="cf-row-control"><textarea id="tokenToDecode" class="jwt-mono" rows="3" spellcheck="false" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."></textarea></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><span class="cf-row-label">Header</span></div>
                <div class="cf-row-control"><pre id="decodedHeader" class="jwt-out jwt-mono">-</pre></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><span class="cf-row-label">Payload</span><p class="cf-row-desc" id="decodedTimes"></p></div>
                <div class="cf-row-control"><pre id="decodedPayload" class="jwt-out jwt-mono">-</pre></div>
            </div>
            <div class="cf-section-foot jwt-foot">
                <span class="cf-status-line" id="decStatus" aria-live="polite"></span>
                <button type="button" id="clearDecodeBtn" class="btn btn-secondary btn-sm">Clear</button>
                <button type="button" id="decodeBtn" class="btn btn-primary btn-sm"><i class="fas fa-unlock" aria-hidden="true"></i> Decode</button>
            </div>
        </div>
    </section>

    <section class="cf-section" id="reference" aria-labelledby="jwt-ref-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="jwt-ref-title">Reference</h2>
                <p class="cf-section-desc">A JSON Web Token (RFC 7519) is three Base64URL parts joined by dots: header, payload and signature.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><span class="cf-row-label">How it is built</span></div>
                <div class="cf-row-control"><pre class="jwt-out jwt-mono">base64url(header) + "." + base64url(payload) + "." +
base64url(HMAC-SHA256(base64url(header) + "." + base64url(payload), secret))</pre></div>
            </div>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead><tr><th>Algorithm</th><th>Type</th><th>Signature</th><th>Key</th></tr></thead>
                    <tbody>
                        <tr><td><strong>HS256</strong></td><td>Shared secret</td><td>HMAC with SHA-256</td><td>256 bits or more</td></tr>
                        <tr><td><strong>HS384</strong></td><td>Shared secret</td><td>HMAC with SHA-384</td><td>384 bits or more</td></tr>
                        <tr><td><strong>HS512</strong></td><td>Shared secret</td><td>HMAC with SHA-512</td><td>512 bits or more</td></tr>
                        <tr><td><strong>RS256</strong></td><td>Key pair</td><td>RSA with SHA-256</td><td>2048-bit RSA or more</td></tr>
                        <tr><td><strong>ES256</strong></td><td>Key pair</td><td>ECDSA, P-256 with SHA-256</td><td>P-256 curve</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text"><span class="cf-row-label">Good practice</span></div>
                <div class="cf-row-control">
                    <ul class="jwt-list">
                        <li>Use a random secret at least as long as the hash, and keep it on the server.</li>
                        <li>Set an expiry (exp) and check it, along with the signature, on every request.</li>
                        <li>Send tokens only over HTTPS; in browsers prefer httpOnly cookies.</li>
                        <li>Use a key pair (RS256, ES256) when other services must verify tokens without being able to issue them.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</div>
</main>
<style>
    .jwt-tabs { position: sticky; top: calc(var(--cf-header-h) + 8px); z-index: 5; }
    .cf-site .cf-section { scroll-margin-top: calc(var(--cf-header-h) + 64px); }
    .jwt-mono { font-family: var(--cf-mono) !important; font-size: var(--cf-text-sm) !important; }
    .jwt-out { margin: 0; min-height: 44px; padding: 10px 12px; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all;
        color: var(--cf-text); background: var(--cf-inset); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); }
    .jwt-out .jwt-h { color: var(--cf-danger); }
    .jwt-out .jwt-p { color: var(--cf-info); }
    .jwt-out .jwt-s { color: var(--cf-success); }
    .cf-rows .jwt-foot { display: flex; align-items: center; justify-content: flex-end; gap: var(--cf-2); flex-wrap: wrap; }
    .cf-rows .jwt-foot .cf-status-line { margin-right: auto; }
    .jwt-list { margin: 0; padding-left: 1.2em; color: var(--cf-text-2); line-height: 1.7; }
</style>
<script>
(function () {
    'use strict';
    var $ = function (id) { return document.getElementById(id); };
    var HASH = { HS256: 'SHA-256', HS384: 'SHA-384', HS512: 'SHA-512' };
    var bits = 256;

    function status(id, text, tone) { var el = $(id); el.className = 'cf-status-line' + (tone ? ' is-' + tone : ''); el.textContent = text || ''; }

    // UTF-8 safe Base64URL (btoa alone throws on any character outside Latin-1).
    function b64urlFromBytes(bytes) {
        var bin = '';
        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }
    function b64urlEncode(str) { return b64urlFromBytes(new TextEncoder().encode(str)); }
    function b64urlDecode(str) {
        str = str.replace(/-/g, '+').replace(/_/g, '/');
        while (str.length % 4) str += '=';
        var bin = atob(str), bytes = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        return new TextDecoder().decode(bytes);
    }

    // Secret generator
    function generate() {
        var arr = new Uint8Array(bits / 8);
        crypto.getRandomValues(arr);
        var bin = '';
        for (var i = 0; i < arr.length; i++) bin += String.fromCharCode(arr[i]);
        $('secretKey').value = btoa(bin);
        status('genStatus', bits + '-bit secret ready.', 'ok');
    }
    $('jwt-size').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-bits]');
        if (!b) return;
        bits = Number(b.dataset.bits);
        this.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        try {
            var h = JSON.parse($('jwtHeader').value);
            h.alg = b.dataset.alg;
            $('jwtHeader').value = JSON.stringify(h);
        } catch (err) { $('jwtHeader').value = JSON.stringify({ alg: b.dataset.alg, typ: 'JWT' }); }
        generate();
    });
    $('generateBtn').addEventListener('click', generate);

    async function copy(text, statusId) {
        try { await navigator.clipboard.writeText(text); status(statusId, 'Copied.', 'ok'); }
        catch (e) { status(statusId, 'Your browser blocked the clipboard; select the text and copy it.', 'bad'); }
    }
    $('copySecretBtn').addEventListener('click', function () { if ($('secretKey').value) copy($('secretKey').value, 'genStatus'); });
    $('useGeneratedKey').addEventListener('click', function () {
        if (!$('secretKey').value) generate();
        $('encodeSecret').value = $('secretKey').value;
        status('encStatus', 'Using the secret above.', 'ok');
    });

    // Sign. The old version always signed with SHA-256, so HS384 / HS512 tokens did not verify.
    var lastToken = '';
    $('encodeBtn').addEventListener('click', async function () {
        var header, payload;
        try { header = JSON.parse($('jwtHeader').value); } catch (e) { return status('encStatus', 'The header is not valid JSON.', 'bad'); }
        try { payload = JSON.parse($('jwtPayload').value || ''); } catch (e) { return status('encStatus', 'The payload is not valid JSON.', 'bad'); }
        var secret = $('encodeSecret').value;
        if (!secret) return status('encStatus', 'Enter a secret.', 'bad');
        var hash = HASH[header.alg];
        if (!hash) return status('encStatus', 'This tool signs HS256, HS384 and HS512 only; the header says ' + String(header.alg) + '.', 'bad');
        try {
            var h = b64urlEncode(JSON.stringify(header)), p = b64urlEncode(JSON.stringify(payload));
            var enc = new TextEncoder();
            var key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: hash }, false, ['sign']);
            var sig = b64urlFromBytes(new Uint8Array(await crypto.subtle.sign('HMAC', key, enc.encode(h + '.' + p))));
            lastToken = h + '.' + p + '.' + sig;
            var out = $('encodedToken');
            var part = function (cls, t) { var s = document.createElement('span'); s.className = cls; s.textContent = t; return s; };
            out.replaceChildren(part('jwt-h', h), '.', part('jwt-p', p), '.', part('jwt-s', sig));
            $('copyTokenBtn').disabled = false;
            status('encStatus', 'Signed with ' + header.alg + '.', 'ok');
        } catch (e) { status('encStatus', 'Could not sign: ' + e.message, 'bad'); }
    });
    $('copyTokenBtn').addEventListener('click', function () { if (lastToken) copy(lastToken, 'encStatus'); });

    // Decode
    function when(sec) { try { return new Date(sec * 1000).toLocaleString(); } catch (e) { return String(sec); } }
    $('decodeBtn').addEventListener('click', function () {
        var token = $('tokenToDecode').value.trim().replace(/^Bearer\s+/i, '');
        if (!token) return status('decStatus', 'Paste a token first.', 'bad');
        var parts = token.split('.');
        if (parts.length !== 3) return status('decStatus', 'A JWT has three parts separated by dots; this has ' + parts.length + '.', 'bad');
        try {
            var header = JSON.parse(b64urlDecode(parts[0]));
            var payload = JSON.parse(b64urlDecode(parts[1]));
            $('decodedHeader').textContent = JSON.stringify(header, null, 2);
            $('decodedPayload').textContent = JSON.stringify(payload, null, 2);
            var t = [];
            if (typeof payload.iat === 'number') t.push('Issued ' + when(payload.iat));
            if (typeof payload.exp === 'number') t.push((payload.exp * 1000 < Date.now() ? 'Expired ' : 'Expires ') + when(payload.exp));
            $('decodedTimes').textContent = t.join(' · ');
            status('decStatus', 'Decoded. The signature was not checked.', 'warn');
        } catch (e) { status('decStatus', 'Could not decode: ' + e.message, 'bad'); }
    });
    $('clearDecodeBtn').addEventListener('click', function () {
        $('tokenToDecode').value = '';
        $('decodedHeader').textContent = '-';
        $('decodedPayload').textContent = '-';
        $('decodedTimes').textContent = '';
        status('decStatus', '');
    });

    // Tab bar follows the section in view.
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.jwt-tabs .cf-tab'));
    function mark() {
        var current = tabs[0];
        tabs.forEach(function (a) { var s = document.querySelector(a.getAttribute('href')); if (s && s.getBoundingClientRect().top < 160) current = a; });
        tabs.forEach(function (a) { a.classList.toggle('is-active', a === current); if (a === current) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
    }
    window.addEventListener('scroll', mark, { passive: true });
    mark();
    generate();
})();
</script>
<%- include('partials/site-footer') %>
<script src="/js/csrf.js"></script>
</body>
</html>
