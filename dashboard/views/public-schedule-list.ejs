<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%#
  Public event calendar (GET /schedule, routes/public-schedule.js). Locals: events, monthEvents,
  calendar (weeks of { day, date, events }), year, month, monthName, twitchUser, error.
  Dates are printed in UTC by the server and rewritten in the visitor's time zone by the script.
%>
<%
    const _twitch = (typeof twitchUser !== 'undefined' && twitchUser) ? twitchUser : null;
    const _monthEvents = (typeof monthEvents !== 'undefined' && Array.isArray(monthEvents)) ? monthEvents : [];
    const _calendar = (typeof calendar !== 'undefined' && Array.isArray(calendar)) ? calendar : [];
    const _error = (typeof error !== 'undefined' && error) ? error : null;
    const _label = monthName + ' ' + year;
    const _months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const _prevMonth = month === 1 ? 12 : month - 1;
    const _prevYear = month === 1 ? year - 1 : year;
    const _nextMonth = month === 12 ? 1 : month + 1;
    const _nextYear = month === 12 ? year + 1 : year;
    const _iso = (d) => { const t = d ? new Date(d) : null; return t && !isNaN(t) ? t.toISOString() : ''; };
    const _utcDay = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
%>
<%- include('partials/site-head', { title: 'Event calendar, ' + _label + ' · CertiFried', description: 'Speedrun marathons and other events that publish their run schedule on CertiFried, by month.', path: '/schedule' }) %>
    <style>
        /* Tap targets: at least 40px tall on every screen size. */
        main .btn { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; }
        .sc-account { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2) var(--cf-3); margin-top: var(--cf-4); font-size: var(--cf-text-sm); color: var(--cf-text-2); }
        .sc-account img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
        .sc-nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-3); margin-bottom: var(--cf-4); }
        .sc-nav h2 { margin: 0; min-width: 11ch; font-size: var(--cf-text-xl); font-weight: 600; letter-spacing: -0.015em; }
        .sc-step { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; min-height: 40px; padding: 0 12px; border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface); color: var(--cf-text); text-decoration: none; font-size: var(--cf-text-sm); }
        .sc-step:hover { background: var(--cf-surface-2); border-color: var(--cf-border-strong); color: var(--cf-text); }
        .sc-jump { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2); margin-left: auto; }
        .sc-jump select { min-height: 40px; padding: 6px 30px 6px 10px; font: inherit; font-size: var(--cf-text-sm); color: var(--cf-text); background-color: var(--cf-inset); background-image: var(--cf-select-arrow); background-repeat: no-repeat; background-position: right 8px center; background-size: 14px 14px; border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius); -webkit-appearance: none; appearance: none; }
        .sc-jump select:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 1px; }
        .sc-jump .btn { min-height: 40px; }

        .sc-cal { width: 100%; table-layout: fixed; border-collapse: collapse; }
        .sc-cal th { padding: 8px 4px; font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); text-align: center; border-bottom: 1px solid var(--cf-border); }
        .sc-cal abbr { text-decoration: none; border: 0; cursor: default; }
        .sc-cal td { height: 96px; padding: 4px; vertical-align: top; border-right: 1px solid var(--cf-border); border-bottom: 1px solid var(--cf-border); }
        .sc-cal td:last-child { border-right: 0; }
        .sc-cal tr:last-child td { border-bottom: 0; }
        .sc-cal td.is-blank { background: var(--cf-inset); }
        .sc-day { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; height: 24px; padding: 0 4px; border-radius: 999px; font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-2); font-variant-numeric: tabular-nums; }
        .sc-cal td.is-today { background: var(--cf-accent-soft); }
        .sc-cal td.is-today .sc-day { background: var(--cf-accent); color: var(--cf-on-accent); }
        .sc-chip { display: block; margin-top: 3px; padding: 3px 6px; border-left: 2px solid var(--cf-accent); border-radius: var(--cf-radius-sm); background: var(--cf-surface-2); color: var(--cf-text); font-size: var(--cf-text-xs); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sc-chip:hover { background: var(--cf-surface-3); color: var(--cf-text); }
        .sc-chip:focus-visible, .sc-ev:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 1px; }
        .sc-mark { display: none; }
        @media (max-width: 600px) {
            .sc-cal td { height: 48px; padding: 2px; text-align: center; }
            .sc-chip { display: none; }
            .sc-mark { display: block; width: 6px; height: 6px; margin: 2px auto 0; border-radius: 50%; background: var(--cf-accent); }
            .sc-jump { margin-left: 0; width: 100%; }
        }

        .sc-events { width: 100%; min-width: 560px; border-collapse: collapse; font-size: var(--cf-text-sm); }
        .sc-events th, .sc-events td { padding: 10px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--cf-border); }
        .sc-events th { font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); white-space: nowrap; }
        .sc-events tr:last-child td { border-bottom: 0; }
        .sc-events td.num { font-variant-numeric: tabular-nums; }
        .sc-ev { display: inline-flex; align-items: center; min-height: 40px; padding: 0; font-weight: 500; color: var(--cf-accent-fg); text-decoration: underline; text-decoration-color: var(--cf-accent-line); text-underline-offset: 2px; }
        .sc-ev:hover { text-decoration-color: currentColor; }
        .sc-desc { margin: 2px 0 0; color: var(--cf-text-3); font-size: var(--cf-text-xs); }
        .sc-muted { color: var(--cf-text-3); }
        .sc-nowrap { white-space: nowrap; }
        .sc-ext { display: inline-flex; align-items: center; min-height: 40px; color: var(--cf-text-2); }
        .sc-ext:hover { color: var(--cf-text); }
        .sc-tz { margin: var(--cf-3) 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', returnTo: '/schedule' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main">
        <div class="cfs-pagehead">
            <h1>Event calendar</h1>
            <p class="cfs-lede">Speedrun marathons and other events that publish their run schedule here. Open an event to see its run order and start times.</p>
            <div class="sc-account">
                <% if (_twitch) { %>
                    <% if (_twitch.avatar && /^https:\/\//.test(_twitch.avatar)) { %><img src="<%= _twitch.avatar %>" alt="" width="28" height="28" referrerpolicy="no-referrer"><% } %>
                    <span>Signed in to Twitch as <strong><%= _twitch.display_name || _twitch.login || 'you' %></strong></span>
                    <a href="/my-schedules" class="btn btn-primary btn-sm">My schedules</a>
                    <a href="/auth/twitch/logout" class="btn btn-secondary btn-sm">Log out of Twitch</a>
                <% } else { %>
                    <span>Running an event?</span>
                    <a href="/auth/twitch?returnTo=/schedule" class="btn btn-secondary btn-sm">Log in with Twitch to publish a schedule</a>
                <% } %>
            </div>
        </div>

        <% if (_error) { %>
            <p class="cfs-note cfs-note--warn" role="alert">The calendar could not be loaded just now. Try again in a minute.</p>
        <% } %>

        <section aria-labelledby="sc-month">
            <div class="sc-nav">
                <a class="sc-step" href="/schedule?year=<%= _prevYear %>&amp;month=<%= _prevMonth %>" aria-label="Previous month, <%= _months[_prevMonth - 1] %> <%= _prevYear %>"><span aria-hidden="true">&larr;</span></a>
                <h2 id="sc-month"><%= _label %></h2>
                <a class="sc-step" href="/schedule?year=<%= _nextYear %>&amp;month=<%= _nextMonth %>" aria-label="Next month, <%= _months[_nextMonth - 1] %> <%= _nextYear %>"><span aria-hidden="true">&rarr;</span></a>
                <form class="sc-jump" method="get" action="/schedule" id="sc-jump">
                    <label class="visually-hidden" for="sc-jump-month">Month</label>
                    <select id="sc-jump-month" name="month">
                        <% _months.forEach(function (m, i) { %><option value="<%= i + 1 %>"<%= (i + 1) === month ? ' selected' : '' %>><%= m %></option><% }); %>
                    </select>
                    <label class="visually-hidden" for="sc-jump-year">Year</label>
                    <select id="sc-jump-year" name="year">
                        <% for (let y = year - 2; y <= year + 2; y++) { %><option value="<%= y %>"<%= y === year ? ' selected' : '' %>><%= y %></option><% } %>
                    </select>
                    <button type="submit" class="btn btn-secondary btn-sm">Show</button>
                </form>
            </div>

            <div class="cfs-table-wrap">
                <table class="sc-cal">
                    <caption class="visually-hidden">Events in <%= _label %>, by day. Weeks start on Monday.</caption>
                    <thead>
                        <tr>
                            <% [['Mon', 'Monday'], ['Tue', 'Tuesday'], ['Wed', 'Wednesday'], ['Thu', 'Thursday'], ['Fri', 'Friday'], ['Sat', 'Saturday'], ['Sun', 'Sunday']].forEach(function (d) { %><th scope="col"><abbr title="<%= d[1] %>"><%= d[0] %></abbr></th><% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% _calendar.forEach(function (week) { %>
                        <tr>
                            <% week.forEach(function (cell) { %>
                                <% if (!cell.day) { %>
                                <td class="is-blank"></td>
                                <% } else { %>
                                <td data-day="<%= cell.day %>">
                                    <span class="sc-day"><%= cell.day %></span>
                                    <% (cell.events || []).forEach(function (ev) { %>
                                    <a class="sc-chip" href="/schedule/<%= encodeURIComponent(ev.slug) %>" title="<%= ev.name %>"><%= ev.name %></a>
                                    <% }); %>
                                    <% if ((cell.events || []).length) { %><span class="sc-mark" aria-hidden="true"></span><% } %>
                                </td>
                                <% } %>
                            <% }); %>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="cfs-section" aria-labelledby="sc-list-h">
            <h2 id="sc-list-h">Events starting in <%= _label %></h2>
            <% if (!_monthEvents.length) { %>
                <div class="cfs-rows"><div class="cfs-empty"><p>No events start in <%= _label %>. Use the arrows to look at other months.</p></div></div>
            <% } else { %>
                <div class="cfs-table-wrap">
                    <table class="sc-events">
                        <thead>
                            <tr><th scope="col">Event</th><th scope="col">Dates</th><th scope="col">Schedules</th><th scope="col">Runs</th><th scope="col">Stream</th></tr>
                        </thead>
                        <tbody>
                            <% _monthEvents.forEach(function (ev) {
                                const desc = ev.description ? String(ev.description) : '';
                                const startIso = _iso(ev.start_date), endIso = _iso(ev.end_date);
                            %>
                            <tr>
                                <td>
                                    <a class="sc-ev" href="/schedule/<%= encodeURIComponent(ev.slug) %>"><%= ev.name %></a>
                                    <% if (desc) { %><p class="sc-desc"><%= desc.length > 80 ? desc.slice(0, 80).replace(/\s+\S*$/, '') + '…' : desc %></p><% } %>
                                </td>
                                <td class="sc-nowrap">
                                    <% if (startIso) { %>
                                        <time datetime="<%= startIso %>" data-local="day"><%= _utcDay(ev.start_date) %></time><% if (endIso && endIso !== startIso) { %> to <time datetime="<%= endIso %>" data-local="day"><%= _utcDay(ev.end_date) %></time><% } %>
                                    <% } else { %>
                                        <span class="sc-muted">Not set yet</span>
                                    <% } %>
                                </td>
                                <td class="num"><%= Number(ev.schedule_count || 0) %></td>
                                <td class="num"><%= Number(ev.run_count || 0) %></td>
                                <td>
                                    <% if (ev.twitch_channel) { %>
                                        <a class="sc-ext" href="https://twitch.tv/<%= encodeURIComponent(ev.twitch_channel) %>" target="_blank" rel="noopener">twitch.tv/<%= ev.twitch_channel %></a>
                                    <% } else { %>
                                        <span class="sc-muted">None</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <p class="sc-tz" id="sc-tz">Dates are in UTC.</p>
            <% } %>
        </section>
    </main>
<%- include('partials/site-footer') %>
<script>
(function () {
    // Pick a month or year and go there straight away; the Show button covers no-script visitors.
    var form = document.getElementById('sc-jump');
    if (form) form.querySelectorAll('select').forEach(function (s) { s.addEventListener('change', function () { form.submit(); }); });

    // Today, in the visitor's own time zone.
    var now = new Date();
    if (now.getFullYear() === <%= Number(year) %> && now.getMonth() + 1 === <%= Number(month) %>) {
        var cell = document.querySelector('.sc-cal td[data-day="' + now.getDate() + '"]');
        if (cell) { cell.classList.add('is-today'); cell.querySelector('.sc-day').setAttribute('aria-label', 'Today, ' + now.getDate()); }
    }

    // Server dates are UTC; show them in the visitor's time zone.
    var times = document.querySelectorAll('time[data-local="day"]');
    times.forEach(function (t) {
        var d = new Date(t.getAttribute('datetime'));
        if (!isNaN(d)) t.textContent = d.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
    });
    var tz = document.getElementById('sc-tz');
    if (tz && times.length) {
        try { tz.textContent = 'Dates are in your time zone (' + Intl.DateTimeFormat().resolvedOptions().timeZone + ').'; } catch (e) { tz.textContent = 'Dates are in your time zone.'; }
    }
})();
</script>
</body>
</html>
