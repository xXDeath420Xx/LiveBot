<%#
  /link/twitch — a member links their Twitch account (dashboard/routes/link-twitch.js). Locals: user,
  already (true after a successful link), error (OAuth error code), guildCount.
%>
<%
const _errors = {
    state_mismatch: 'The sign-in took too long or was opened twice. Start again.',
    no_code: 'Twitch did not send the sign-in back. Start again.',
    access_denied: 'You cancelled on Twitch.',
};
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: ('Link your Twitch account') + ' · CertiFried', noindex: true }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
</head>
<body class="cfs-body cf-site">
<%- include('partials/site-header', { user }) %>
<main id="main-content" class="cf-main" tabindex="-1">
<div class="cf-page is-narrow">
    <div class="cf-page-head">
        <div class="cf-page-icon"><i class="fab fa-twitch" aria-hidden="true"></i></div>
        <div>
            <h1 class="cf-page-title">Link your Twitch account</h1>
            <p class="cf-page-sub">Link once and servers you share with our bots can give you the Discord roles for being a Mod or VIP on their Twitch channel.</p>
        </div>
    </div>

    <% if (already) { %>
    <div class="cf-notice is-ok"><i class="fas fa-circle-check" aria-hidden="true"></i><div class="cf-notice-body">
        <% if (typeof guildCount === 'number' && guildCount > 0) { %>
        Linked in <strong><%= guildCount %></strong> shared server<%= guildCount === 1 ? '' : 's' %>. Roles update within 15 minutes.
        <% } else { %>
        Linked, but you do not share a server with our bots yet. Roles are given once you do.
        <% } %>
    </div></div>
    <% } %>
    <% if (error) { %>
    <div class="cf-notice is-bad"><i class="fas fa-circle-exclamation" aria-hidden="true"></i><div class="cf-notice-body">
        Linking failed. <%= _errors[error] || 'Twitch said: ' + error + '.' %>
    </div></div>
    <% } %>

    <section class="cf-section" aria-label="Link">
        <div class="cf-rows">
            <% if (user) { %>
            <div class="cf-list-item">
                <div class="cf-list-main lt-me">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" data-cf-fallback="https://cdn.discordapp.com/embed/avatars/0.png">
                    <span><span class="cf-em"><%= user.global_name || user.username %></span><span class="cf-muted"> · signed in with Discord</span></span>
                </div>
            </div>
            <% } %>
            <div class="cf-list-item"><div class="cf-list-main">We only read your Twitch login name and user ID. No chat or stream access.</div></div>
            <div class="cf-list-item"><div class="cf-list-main">One link covers every server you share with our bots.</div></div>
            <div class="cf-list-item"><div class="cf-list-main">Linking again lets you switch to a different Twitch account.</div></div>
            <div class="cf-section-foot lt-foot">
                <a class="btn btn-secondary btn-sm" href="/dashboard">Your servers</a>
                <a class="btn btn-primary btn-sm" href="/link/twitch/start"><i class="fab fa-twitch" aria-hidden="true"></i> <%= already ? 'Link a different account' : 'Continue with Twitch' %></a>
            </div>
        </div>
    </section>
</div>
</main>
<style>
    .lt-me { display: flex; align-items: center; gap: var(--cf-3); }
    .lt-me img { width: 32px; height: 32px; border-radius: 50%; }
    .cf-rows .lt-foot { display: flex; justify-content: flex-end; gap: var(--cf-2); flex-wrap: wrap; }
</style>
<%- include('partials/site-footer') %>
<script src="/js/csrf.js"></script>
</body>
</html>
