<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>4:20 Clock for OBS — CertiFried Utility</title>
  <meta name="description" content="Free 4:20 world clock overlay for Twitch, Kick and YouTube streams. Customise it, copy the link, paste it into an OBS browser source." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--bg:#0a0911;--ink:#f1f0f6;--muted:#a19cb8;--line:rgba(255,255,255,.09);--green:#7dfc4f;--violet:#7c84ff}
    body{background:var(--bg);color:var(--ink);font-family:'Inter',system-ui,sans-serif;line-height:1.5;min-height:100vh}
    a{color:var(--violet)}
    .wrap{max-width:68rem;margin:0 auto;padding:2.5rem 16px 3rem}
    .back{display:inline-block;color:var(--muted);text-decoration:none;font-size:.85rem;margin-bottom:1.5rem}
    .back:hover{color:var(--ink)}
    h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(1.8rem,4.5vw,2.6rem);line-height:1.15;margin-bottom:.6rem}
    h1 .g{color:var(--green)}
    .lede{color:var(--muted);max-width:42rem;margin-bottom:2rem}
    .grid{display:grid;grid-template-columns:minmax(0,20rem) minmax(0,1fr);gap:1.5rem;align-items:start}
    @media(max-width:820px){.grid{grid-template-columns:minmax(0,1fr)}}
    .panel{border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.025);padding:1.3rem}
    .panel h2{font-family:'Space Grotesk',sans-serif;font-size:1rem;margin-bottom:1rem}
    .field{margin-bottom:1.05rem}
    [hidden]{display:none!important}
    .field > label:not(.check),.field > .lbl{display:block;font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.4rem}
    .seg{display:flex;gap:.35rem;flex-wrap:wrap}
    .seg input{position:absolute;opacity:0;pointer-events:none}
    .seg label{flex:1 1 auto;text-align:center;font-size:.85rem;padding:.45rem .6rem;border:1px solid var(--line);border-radius:10px;cursor:pointer;color:var(--muted)}
    .seg input:checked + label{border-color:var(--green);color:var(--ink);background:rgba(125,252,79,.08)}
    .seg input:focus-visible + label{outline:2px solid var(--violet);outline-offset:2px}
    .row{display:flex;align-items:center;gap:.6rem}
    input[type=color]{width:2.6rem;height:2rem;border:1px solid var(--line);border-radius:8px;background:none;cursor:pointer;padding:2px}
    input[type=range]{flex:1;accent-color:var(--green)}
    .layouts{display:grid;gap:.35rem}
    .layouts input{position:absolute;opacity:0;pointer-events:none}
    .layouts label{display:block;padding:.5rem .75rem;border:1px solid var(--line);border-radius:10px;cursor:pointer}
    .layouts label b{display:block;font-size:.9rem;font-weight:600;color:var(--ink)}
    .layouts label span{font-size:.76rem;color:var(--muted)}
    .layouts input:checked + label{border-color:var(--green);background:rgba(125,252,79,.08)}
    .layouts input:focus-visible + label{outline:2px solid var(--violet);outline-offset:2px}
    .check{display:flex;align-items:center;gap:.55rem;font-size:.9rem;cursor:pointer;margin-bottom:.5rem}
    .check input{accent-color:var(--green);width:1rem;height:1rem}
    .hint{font-size:.78rem;color:var(--muted)}
    .reset{background:none;border:none;color:var(--muted);font-size:.8rem;text-decoration:underline;cursor:pointer;font-family:inherit}
    .stage{position:relative;border-radius:14px;overflow:hidden;border:1px solid var(--line);aspect-ratio:16/9;
      background-color:#1d1b29;background-image:linear-gradient(45deg,#26243a 25%,transparent 25%),linear-gradient(-45deg,#26243a 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#26243a 75%),linear-gradient(-45deg,transparent 75%,#26243a 75%);
      background-size:24px 24px;background-position:0 0,0 12px,12px -12px,-12px 0}
    .stage.scene{background:linear-gradient(135deg,#3a2a5c,#0f3b3a 55%,#1b1f3a)}
    .stage iframe{position:absolute;left:50%;top:50%;border:0;transform-origin:center center;background:transparent}
    .stage-bar{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.6rem;flex-wrap:wrap}
    .stage-bar .hint{margin:0}
    .url{display:flex;gap:.5rem;margin-top:1rem}
    .url input{flex:1;min-width:0;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82rem;color:var(--ink);background:#14121f;border:1px solid var(--line);border-radius:10px;padding:.6rem .75rem}
    .btn{font-family:inherit;font-weight:600;font-size:.88rem;border:none;border-radius:10px;padding:.6rem 1rem;cursor:pointer;background:var(--green);color:#0a0911;white-space:nowrap;text-decoration:none;display:inline-block}
    .btn.alt{background:rgba(255,255,255,.08);color:var(--ink)}
    .size{margin-top:.6rem;font-size:.85rem;color:var(--muted)}
    .size b{color:var(--ink);font-family:'Space Grotesk',sans-serif}
    .steps{margin-top:1.5rem}
    .steps ol{padding-left:1.2rem;color:var(--muted);font-size:.92rem}
    .steps li{margin-bottom:.45rem}
    .steps li b{color:var(--ink)}
    .steps code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82rem;background:rgba(255,255,255,.06);padding:.05rem .35rem;border-radius:5px;color:var(--ink)}
    footer{text-align:center;color:var(--muted);font-size:.8rem;padding:1rem 16px 2rem}
    footer a{color:var(--muted)}
  </style>
</head>
<body>
  <main class="wrap">
    <a class="back" href="/">&larr; CertiFried Utility</a>
    <h1>Put the <span class="g">4:20</span> world clock on your stream</h1>
    <p class="lede">A free overlay that counts down to the next 4:20 somewhere on Earth and lights up when it hits. Pick a style, copy the link, and paste it into an OBS (or Streamlabs) browser source. No account needed.</p>

    <div class="grid">
      <form class="panel" id="opts" autocomplete="off" onsubmit="return false">
        <h2>Customise</h2>

        <div class="field">
          <span class="lbl" id="lbl-layout">Layout</span>
          <div class="layouts" role="radiogroup" aria-labelledby="lbl-layout">
            <input type="radio" name="layout" id="ly-minimal" value="minimal"><label for="ly-minimal"><b>Minimal</b><span>Just the countdown</span></label>
            <input type="radio" name="layout" id="ly-compact" value="compact"><label for="ly-compact"><b>Compact</b><span>Countdown + next city</span></label>
            <input type="radio" name="layout" id="ly-default" value="default" checked><label for="ly-default"><b>Default</b><span>Status, countdown, upcoming chips</span></label>
            <input type="radio" name="layout" id="ly-extended" value="extended"><label for="ly-extended"><b>Extended</b><span>Next 8 cities, last 4:20, your local 4:20</span></label>
            <input type="radio" name="layout" id="ly-bar" value="bar"><label for="ly-bar"><b>Bar</b><span>One-line lower third</span></label>
          </div>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-bg">Background</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-bg">
            <input type="radio" name="bg" id="bg-t" value="" checked><label for="bg-t">Transparent</label>
            <input type="radio" name="bg" id="bg-d" value="dark"><label for="bg-d">Dark panel</label>
            <input type="radio" name="bg" id="bg-c" value="custom"><label for="bg-c">Custom</label>
          </div>
          <div class="row" id="bg-custom-row" style="margin-top:.5rem" hidden>
            <input type="color" id="bgcolor" value="#14121f" aria-label="Panel colour">
            <span class="hint">Panel colour</span>
          </div>
        </div>

        <div class="field">
          <span class="lbl">Clock colours</span>
          <div class="row">
            <input type="color" id="accent" value="#7dfc4f" aria-label="Gradient start colour">
            <input type="color" id="accent2" value="#7c84ff" aria-label="Gradient end colour">
            <button type="button" class="reset" id="reset-colors">Reset</button>
          </div>
        </div>

        <div class="field">
          <label for="scale">Size <span id="scale-val">1.0×</span></label>
          <input type="range" id="scale" min="0.6" max="2" step="0.1" value="1">
        </div>

        <div class="field" id="ticker-field">
          <label class="check"><input type="checkbox" id="ticker" checked> Show upcoming cities</label>
        </div>
      </form>

      <section>
        <div class="panel">
          <div class="stage-bar">
            <h2 style="margin:0">Live preview</h2>
            <div class="seg" style="flex:0 0 auto">
              <input type="radio" name="stage" id="st-check" value="check" checked><label for="st-check">Checkerboard</label>
              <input type="radio" name="stage" id="st-scene" value="scene"><label for="st-scene">Sample scene</label>
            </div>
          </div>
          <div class="stage" id="stage"><iframe id="preview" title="4:20 clock overlay preview" src="/420"></iframe></div>

          <div class="url">
            <input id="url" readonly aria-label="Browser source URL">
            <button type="button" class="btn" id="copy">Copy link</button>
          </div>
          <p class="size">Set the browser source to <b id="size-w">700</b> × <b id="size-h">400</b> px. <a href="/420" id="open" target="_blank" rel="noopener">Open in a new tab</a></p>
        </div>

        <div class="panel steps">
          <h2>Adding it in OBS</h2>
          <ol>
            <li>In your scene, click <b>+</b> under <b>Sources</b> and choose <b>Browser</b>.</li>
            <li>Paste the link above into <b>URL</b>.</li>
            <li>Set <b>Width</b> and <b>Height</b> to the size shown above.</li>
            <li>Leave <b>Custom CSS</b> as it is. The overlay is transparent unless you picked a panel.</li>
            <li>Click <b>OK</b>, then drag it where you want it. Hold <code>Alt</code> while dragging an edge to crop.</li>
          </ol>
          <p class="hint" style="margin-top:.8rem">Streamlabs: add a <b>Browser Source</b> widget and paste the same link. The countdown runs off your streaming PC's clock, so once it has loaded it keeps ticking even if our site goes down.</p>
        </div>
      </section>
    </div>
  </main>
  <footer><a href="/">certifriedmultitool.com</a></footer>

  <script>
  (function () {
    var BASE = location.origin + '/420';
    var DEF = { accent: '#7dfc4f', accent2: '#7c84ff' };
    // Unscaled browser-source size each layout needs (widget + margins).
    var SIZES = {
      minimal:  { w: 500, h: 160 },
      compact:  { w: 700, h: 200 },
      default:  { w: 700, h: 400 },
      extended: { w: 780, h: 620 },
      bar:      { w: 1280, h: 90 }
    };
    var HAS_TICKER = { default: true, bar: true };
    function layout() { return form.querySelector('input[name=layout]:checked').value; }

    var $ = function (id) { return document.getElementById(id); };
    var form = $('opts'), iframe = $('preview'), stage = $('stage');

    function params() {
      var p = new URLSearchParams();
      var bg = form.querySelector('input[name=bg]:checked').value;
      if (bg === 'dark') p.set('bg', 'dark');
      else if (bg === 'custom') p.set('bg', $('bgcolor').value.slice(1));
      if ($('accent').value !== DEF.accent) p.set('accent', $('accent').value.slice(1));
      if ($('accent2').value !== DEF.accent2) p.set('accent2', $('accent2').value.slice(1));
      var ly = layout();
      if (ly !== 'default') p.set('layout', ly);
      if (HAS_TICKER[ly] && !$('ticker').checked) p.set('ticker', '0');
      var s = parseFloat($('scale').value);
      if (s !== 1) p.set('scale', s.toFixed(1));
      return p;
    }

    function frameSize() {
      var base = SIZES[layout()];
      var s = parseFloat($('scale').value);
      return { w: Math.round(base.w * s / 10) * 10, h: Math.round(base.h * s / 10) * 10 };
    }

    // Render the iframe at its real OBS size, then shrink it to fit the stage,
    // so the preview matches what lands in the scene.
    function fit() {
      var sz = frameSize();
      iframe.style.width = sz.w + 'px';
      iframe.style.height = sz.h + 'px';
      var k = Math.min(1, (stage.clientWidth - 16) / sz.w, (stage.clientHeight - 16) / sz.h);
      iframe.style.transform = 'translate(-50%,-50%) scale(' + k + ')';
    }

    var lastSrc = iframe.getAttribute('src'), reloadTimer = null;
    function update() {
      var qs = params().toString();
      var url = BASE + (qs ? '?' + qs : '');
      $('url').value = url;
      $('open').href = url;
      var src = '/420' + (qs ? '?' + qs : '');
      // Debounced: sliders and colour pickers fire many input events per second,
      // and each reload is a page request against the site's per-IP rate limit.
      clearTimeout(reloadTimer);
      if (src !== lastSrc) reloadTimer = setTimeout(function () { iframe.src = src; lastSrc = src; }, 450);
      $('bg-custom-row').hidden = form.querySelector('input[name=bg]:checked').value !== 'custom';
      $('ticker-field').hidden = !HAS_TICKER[layout()];
      $('scale-val').textContent = parseFloat($('scale').value).toFixed(1) + '×';
      var sz = frameSize();
      $('size-w').textContent = sz.w;
      $('size-h').textContent = sz.h;
      fit();
    }

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    $('reset-colors').addEventListener('click', function () {
      $('accent').value = DEF.accent; $('accent2').value = DEF.accent2; update();
    });
    document.querySelectorAll('input[name=stage]').forEach(function (r) {
      r.addEventListener('change', function () { stage.classList.toggle('scene', r.value === 'scene' && r.checked); });
    });
    $('copy').addEventListener('click', function () {
      var btn = this, done = function () {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = 'Copy link'; }, 1500);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText($('url').value).then(done, function () { $('url').select(); });
      } else {
        $('url').select();
        try { document.execCommand('copy'); done(); } catch (e) { /* user can copy the selected text */ }
      }
    });
    $('url').addEventListener('focus', function () { this.select(); });
    window.addEventListener('resize', fit);
    update();
  })();
  </script>
</body>
</html>
