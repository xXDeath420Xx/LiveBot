<%#
  GET /420/obs (dashboard/server.js): the builder for the 4:20 world clock OBS overlay (/420, views/fourtwenty-overlay.ejs,
  which keeps its own fixed look). The page is on the site frame and follows the site theme; only the preview stage
  (a stand-in for the OBS canvas) and the overlay inside it keep fixed colours.
%>
<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>">
<head>
<%- include('partials/site-head', { title: '4:20 clock for OBS · CertiFried', description: 'Free 4:20 world clock overlay for Twitch, Kick and YouTube streams. Customise it, copy the link, paste it into an OBS browser source.', path: '/420/obs' }) %>
  <style>
    [hidden]{display:none!important}
    .ob-title .g{color:var(--cf-accent-fg)}
    .ob-grid{display:grid;grid-template-columns:minmax(0,20rem) minmax(0,1fr);gap:var(--cf-6);align-items:start}
    @media(max-width:820px){.ob-grid{grid-template-columns:minmax(0,1fr)}}
    .panel{border:1px solid var(--cf-border);border-radius:var(--cf-radius-lg);background:var(--cf-surface);padding:var(--cf-5);min-width:0}
    .panel h2{font-size:var(--cf-text-md);font-weight:600;color:var(--cf-text);margin:0 0 var(--cf-4)}
    .field{margin-bottom:var(--cf-4)}
    .field > label:not(.check),.field > .lbl{display:block;font-size:var(--cf-text-xs);font-weight:500;color:var(--cf-text-2);margin-bottom:6px}
    .seg{display:flex;gap:6px;flex-wrap:wrap}
    .seg input{position:absolute;opacity:0;pointer-events:none}
    .seg label{flex:1 1 auto;text-align:center;font-size:var(--cf-text-sm);padding:6px 10px;border:1px solid var(--cf-border-strong);border-radius:var(--cf-radius);cursor:pointer;color:var(--cf-text-2);background:var(--cf-surface)}
    .seg label:hover{color:var(--cf-text)}
    .seg input:checked + label{border-color:var(--cf-accent);color:var(--cf-text);background:var(--cf-accent-soft)}
    .seg input:focus-visible + label{outline:2px solid var(--cf-accent);outline-offset:2px}
    .row{display:flex;align-items:center;gap:10px}
    input[type=color]{width:2.6rem;height:2rem;cursor:pointer}
    input[type=range]{flex:1;width:100%;accent-color:var(--cf-accent)}
    .layouts{display:grid;gap:6px}
    .layouts input{position:absolute;opacity:0;pointer-events:none}
    .layouts label{display:block;padding:8px 12px;border:1px solid var(--cf-border-strong);border-radius:var(--cf-radius);cursor:pointer;background:var(--cf-surface)}
    .layouts label b{display:block;font-size:var(--cf-text-sm);font-weight:600;color:var(--cf-text)}
    .layouts label span{font-size:var(--cf-text-xs);color:var(--cf-text-3)}
    .layouts input:checked + label{border-color:var(--cf-accent);background:var(--cf-accent-soft)}
    .layouts input:checked + label span{color:var(--cf-text-2)}
    .layouts input:focus-visible + label{outline:2px solid var(--cf-accent);outline-offset:2px}
    .check{display:flex;align-items:center;gap:8px;font-size:var(--cf-text-sm);cursor:pointer;margin-bottom:var(--cf-2);color:var(--cf-text)}
    .check input{accent-color:var(--cf-accent);width:1rem;height:1rem}
    .hint{font-size:var(--cf-text-xs);color:var(--cf-text-3)}
    .reset{background:none;border:none;color:var(--cf-text-2);font-size:var(--cf-text-sm);text-decoration:underline;cursor:pointer;font-family:inherit;padding:0}
    .reset:hover{color:var(--cf-text)}
    /* The preview stage stands in for the OBS canvas: a checkerboard for "transparent", or a plain sample scene.
       Fixed colours on purpose: the overlay inside is made for a stream, not for the site theme. */
    .stage{position:relative;border-radius:var(--cf-radius-lg);overflow:hidden;border:1px solid var(--cf-border);aspect-ratio:16/9;
      background-color:#1d1b29;background-image:linear-gradient(45deg,#26243a 25%,transparent 25%),linear-gradient(-45deg,#26243a 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#26243a 75%),linear-gradient(-45deg,transparent 75%,#26243a 75%);
      background-size:24px 24px;background-position:0 0,0 12px,12px -12px,-12px 0; /* theme: fixed (OBS canvas stand-in) */}
    .stage.scene{background:#22303a; /* theme: fixed (sample scene) */}
    .stage iframe{position:absolute;left:50%;top:50%;border:0;transform-origin:center center;background:transparent}
    .stage-bar{display:flex;justify-content:space-between;align-items:center;gap:var(--cf-2);margin-bottom:var(--cf-3);flex-wrap:wrap}
    .stage-bar h2{margin:0}
    .url{display:flex;gap:var(--cf-2);margin-top:var(--cf-4)}
    .url input{flex:1;min-width:0;font-family:var(--cf-mono);font-size:var(--cf-text-sm)}
    .size{margin:var(--cf-3) 0 0;font-size:var(--cf-text-sm);color:var(--cf-text-2)}
    .size b{color:var(--cf-text);font-variant-numeric:tabular-nums}
    .steps{margin-top:var(--cf-5)}
    .steps ol{margin:0;padding-left:1.2rem;color:var(--cf-text-2);font-size:var(--cf-text-sm);line-height:1.6}
    .steps li{margin-bottom:6px}
    .steps li b{color:var(--cf-text)}
    .steps code{font-family:var(--cf-mono);font-size:var(--cf-text-xs);background:var(--cf-surface-2);padding:1px 6px;border-radius:var(--cf-radius-sm);color:var(--cf-text)}
    .steps .hint{margin:var(--cf-3) 0 0}
    @media(max-width:600px){.url{flex-direction:column}}
  </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', returnTo: '/420/obs' }) %>
  <main id="main-content" class="cfs-main cfs-main--wide page-content" tabindex="-1">
    <div class="cfs-pagehead">
      <h1 class="ob-title">Put the <span class="g">4:20</span> world clock on your stream</h1>
      <p class="cfs-lede">A free overlay that counts down to the next 4:20 somewhere on Earth and lights up when it hits. Pick a style, copy the link, and paste it into an OBS (or Streamlabs) browser source. No account needed.</p>
    </div>

    <div class="ob-grid">
      <form class="panel" id="opts" autocomplete="off" onsubmit="return false">
        <h2>Customise</h2>

        <div class="field">
          <span class="lbl" id="lbl-layout">Layout</span>
          <div class="layouts" role="radiogroup" aria-labelledby="lbl-layout">
            <input type="radio" name="layout" id="ly-minimal" value="minimal"><label for="ly-minimal"><b>Minimal</b><span>Just the countdown</span></label>
            <input type="radio" name="layout" id="ly-compact" value="compact"><label for="ly-compact"><b>Compact</b><span>Countdown + next city</span></label>
            <input type="radio" name="layout" id="ly-default" value="default" checked><label for="ly-default"><b>Default</b><span>Status, countdown, upcoming chips</span></label>
            <input type="radio" name="layout" id="ly-extended" value="extended"><label for="ly-extended"><b>Extended</b><span>Next 8 cities, last 4:20, your local 4:20</span></label>
            <input type="radio" name="layout" id="ly-bar" value="bar"><label for="ly-bar"><b>Bar</b><span>One-line lower third</span></label>
          </div>
        </div>

        <div class="field">
          <span class="lbl" id="lbl-bg">Background</span>
          <div class="seg" role="radiogroup" aria-labelledby="lbl-bg">
            <input type="radio" name="bg" id="bg-t" value="" checked><label for="bg-t">Transparent</label>
            <input type="radio" name="bg" id="bg-d" value="dark"><label for="bg-d">Dark panel</label>
            <input type="radio" name="bg" id="bg-c" value="custom"><label for="bg-c">Custom</label>
          </div>
          <div class="row" id="bg-custom-row" style="margin-top:var(--cf-2)" hidden>
            <input type="color" id="bgcolor" value="#14121f" aria-label="Panel colour">
            <span class="hint">Panel colour</span>
          </div>
        </div>

        <div class="field">
          <span class="lbl">Clock colours</span>
          <div class="row">
            <input type="color" id="accent" value="#7dfc4f" aria-label="Gradient start colour">
            <input type="color" id="accent2" value="#7c84ff" aria-label="Gradient end colour">
            <button type="button" class="reset" id="reset-colors">Reset</button>
          </div>
        </div>

        <div class="field">
          <label for="scale">Size <span id="scale-val">1.0×</span></label>
          <input type="range" id="scale" min="0.6" max="2" step="0.1" value="1">
        </div>

        <div class="field" id="ticker-field">
          <label class="check"><input type="checkbox" id="ticker" checked> Show upcoming cities</label>
        </div>
      </form>

      <section>
        <div class="panel">
          <div class="stage-bar">
            <h2>Live preview</h2>
            <div class="seg" style="flex:0 0 auto">
              <input type="radio" name="stage" id="st-check" value="check" checked><label for="st-check">Checkerboard</label>
              <input type="radio" name="stage" id="st-scene" value="scene"><label for="st-scene">Sample scene</label>
            </div>
          </div>
          <div class="stage cf-keep-dark" id="stage"><iframe id="preview" title="4:20 clock overlay preview" src="/420"></iframe></div>

          <div class="url">
            <input id="url" readonly aria-label="Browser source URL">
            <button type="button" class="btn btn-primary" id="copy">Copy link</button>
          </div>
          <p class="size">Set the browser source to <b id="size-w">700</b> × <b id="size-h">400</b> px. <a href="/420" id="open" target="_blank" rel="noopener">Open in a new tab</a></p>
        </div>

        <div class="panel steps">
          <h2>Adding it in OBS</h2>
          <ol>
            <li>In your scene, click <b>+</b> under <b>Sources</b> and choose <b>Browser</b>.</li>
            <li>Paste the link above into <b>URL</b>.</li>
            <li>Set <b>Width</b> and <b>Height</b> to the size shown above.</li>
            <li>Leave <b>Custom CSS</b> as it is. The overlay is transparent unless you picked a panel.</li>
            <li>Click <b>OK</b>, then drag it where you want it. Hold <code>Alt</code> while dragging an edge to crop.</li>
          </ol>
          <p class="hint">Streamlabs: add a <b>Browser Source</b> widget and paste the same link. The countdown runs off your streaming PC's clock, so once it has loaded it keeps ticking even if our site goes down.</p>
        </div>
      </section>
    </div>
  </main>
<%- include('partials/site-footer') %>

  <script>
  (function () {
    var BASE = location.origin + '/420';
    var DEF = { accent: '#7dfc4f', accent2: '#7c84ff' };
    // Unscaled browser-source size each layout needs (widget + margins).
    var SIZES = {
      minimal:  { w: 500, h: 160 },
      compact:  { w: 700, h: 200 },
      default:  { w: 700, h: 400 },
      extended: { w: 780, h: 620 },
      bar:      { w: 1280, h: 90 }
    };
    var HAS_TICKER = { default: true, bar: true };
    function layout() { return form.querySelector('input[name=layout]:checked').value; }

    var $ = function (id) { return document.getElementById(id); };
    var form = $('opts'), iframe = $('preview'), stage = $('stage');

    function params() {
      var p = new URLSearchParams();
      var bg = form.querySelector('input[name=bg]:checked').value;
      if (bg === 'dark') p.set('bg', 'dark');
      else if (bg === 'custom') p.set('bg', $('bgcolor').value.slice(1));
      if ($('accent').value !== DEF.accent) p.set('accent', $('accent').value.slice(1));
      if ($('accent2').value !== DEF.accent2) p.set('accent2', $('accent2').value.slice(1));
      var ly = layout();
      if (ly !== 'default') p.set('layout', ly);
      if (HAS_TICKER[ly] && !$('ticker').checked) p.set('ticker', '0');
      var s = parseFloat($('scale').value);
      if (s !== 1) p.set('scale', s.toFixed(1));
      return p;
    }

    function frameSize() {
      var base = SIZES[layout()];
      var s = parseFloat($('scale').value);
      return { w: Math.round(base.w * s / 10) * 10, h: Math.round(base.h * s / 10) * 10 };
    }

    // Render the iframe at its real OBS size, then shrink it to fit the stage,
    // so the preview matches what lands in the scene.
    function fit() {
      var sz = frameSize();
      iframe.style.width = sz.w + 'px';
      iframe.style.height = sz.h + 'px';
      var k = Math.min(1, (stage.clientWidth - 16) / sz.w, (stage.clientHeight - 16) / sz.h);
      iframe.style.transform = 'translate(-50%,-50%) scale(' + k + ')';
    }

    var lastSrc = iframe.getAttribute('src'), reloadTimer = null;
    function update() {
      var qs = params().toString();
      var url = BASE + (qs ? '?' + qs : '');
      $('url').value = url;
      $('open').href = url;
      var src = '/420' + (qs ? '?' + qs : '');
      // Debounced: sliders and colour pickers fire many input events per second,
      // and each reload is a page request against the site's per-IP rate limit.
      clearTimeout(reloadTimer);
      if (src !== lastSrc) reloadTimer = setTimeout(function () { iframe.src = src; lastSrc = src; }, 450);
      $('bg-custom-row').hidden = form.querySelector('input[name=bg]:checked').value !== 'custom';
      $('ticker-field').hidden = !HAS_TICKER[layout()];
      $('scale-val').textContent = parseFloat($('scale').value).toFixed(1) + '×';
      var sz = frameSize();
      $('size-w').textContent = sz.w;
      $('size-h').textContent = sz.h;
      fit();
    }

    form.addEventListener('input', update);
    form.addEventListener('change', update);
    $('reset-colors').addEventListener('click', function () {
      $('accent').value = DEF.accent; $('accent2').value = DEF.accent2; update();
    });
    document.querySelectorAll('input[name=stage]').forEach(function (r) {
      r.addEventListener('change', function () { stage.classList.toggle('scene', r.value === 'scene' && r.checked); });
    });
    $('copy').addEventListener('click', function () {
      var btn = this, done = function () {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = 'Copy link'; }, 1500);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText($('url').value).then(done, function () { $('url').select(); });
      } else {
        $('url').select();
        try { document.execCommand('copy'); done(); } catch (e) { /* user can copy the selected text */ }
      }
    });
    $('url').addEventListener('focus', function () { this.select(); });
    window.addEventListener('resize', fit);
    update();
  })();
  </script>
</body>
</html>
