<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<style>
    .hero { padding: 24px 0 16px; }
    .hero h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; }
    .hero p { color: var(--cf-text-3); margin-top: 4px; font-size: var(--cf-text-md); max-width: 640px; }

    .deck-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px; padding-bottom: 72px; }
    .deck-tile { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 16px; display: flex; flex-direction: column; gap: 8px; transition: border-color 0.15s; min-width: 0; }
    .deck-tile:hover { border-color: var(--cf-border-strong); }
    .deck-tile .name { font-weight: 600; font-size: var(--cf-text-md); overflow-wrap: anywhere; }
    .deck-tile .desc { color: var(--cf-text-3); font-size: var(--cf-text-sm); min-height: 2.4em; overflow-wrap: anywhere; }
    .deck-tile .stats { display: flex; gap: 6px; flex-wrap: wrap; }
    .deck-tile .actions { display: flex; gap: 6px; margin-top: auto; padding-top: 8px; flex-wrap: wrap; }
    .deck-tile .actions .push { margin-left: auto; }
    .deck-tile .code { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .deck-tile .code code { font-family: var(--cf-mono); color: var(--cf-text); background: var(--cf-surface-2); padding: 1px 5px; border-radius: var(--cf-radius-sm); }

    .new-deck { background: var(--cf-surface); border: 1px dashed var(--cf-border-strong); border-radius: var(--cf-radius-lg); padding: 16px; display: flex; flex-direction: column; gap: 10px; }
    .new-deck h2 { font-size: var(--cf-text-md); font-weight: 600; }
    .new-deck .form-check span { font-size: var(--cf-text-sm); }
    .empty-state { padding: 32px 20px; text-align: center; color: var(--cf-text-3); background: var(--cf-surface); border: 1px dashed var(--cf-border); border-radius: var(--cf-radius-lg); display: flex; align-items: center; justify-content: center; font-size: var(--cf-text-sm); }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'My Decks — CertiFried CAH', description: 'Cards Against Humanity on CertiFried MultiTool: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'my-decks' }) %>
<%- include('components/cah-breadcrumbs', { crumbs: [{ href: '/cah', label: 'CAH' }, { label: 'My decks' }] }) %>

<main class="container" id="main-content">
    <section class="hero">
        <h1>My decks<% if (decks && decks.length) { %> <span style="color: var(--cf-text-3); font-weight: 500;"><%= decks.length %></span><% } %></h1>
        <p>Write your own cards. Public decks are listed for everyone when they host a game. Private decks are only listed for you, and friends can add them with the share code.</p>
    </section>

    <div class="deck-grid">
        <section class="new-deck" aria-labelledby="new-deck-title">
            <h2 id="new-deck-title">New deck</h2>
            <div>
                <label class="form-label" for="new-name">Name</label>
                <input class="form-input" id="new-name" placeholder="Deck name" maxlength="60">
            </div>
            <div>
                <label class="form-label" for="new-desc">Description <span style="color: var(--cf-text-3); font-weight: 400;">(optional)</span></label>
                <input class="form-input" id="new-desc" placeholder="A short line about the deck" maxlength="120">
            </div>
            <label class="form-check">
                <input type="checkbox" id="new-public" checked>
                <span>Public: anyone can use it</span>
            </label>
            <label class="form-check">
                <input type="checkbox" id="new-nsfw">
                <span>NSFW</span>
            </label>
            <button type="button" class="btn btn-primary" onclick="createDeck()">Create deck</button>
            <div id="new-error" class="toast err" role="alert" style="display:none;"></div>
        </section>

        <% if (!decks || decks.length === 0) { %>
            <div class="empty-state">You haven't made a deck yet. Name one and select Create deck.</div>
        <% } else { %>
            <% decks.forEach(d => { %>
                <article class="deck-tile">
                    <h2 class="name"><%= d.name %></h2>
                    <div class="desc"><%= d.description || 'No description.' %></div>
                    <div class="stats">
                        <span class="pill"><%= d.white_count %> white</span>
                        <span class="pill"><%= d.black_count %> black</span>
                        <% if (d.is_public) { %><span class="pill pill-green">Public</span><% } else { %><span class="pill">Private</span><% } %>
                        <% if (d.nsfw) { %><span class="pill pill-red">NSFW</span><% } %>
                    </div>
                    <div class="code">Share code <code><%= d.share_code %></code></div>
                    <div class="actions">
                        <a class="btn btn-outline btn-sm" href="/cah/my-decks/<%= d.id %>/edit">Edit cards</a>
                        <button type="button" class="btn btn-ghost btn-sm" onclick="copyCode('<%= d.share_code %>', this)">Copy code</button>
                        <button type="button" class="btn btn-danger btn-sm push" onclick="deleteDeck(<%= d.id %>, this)">Delete</button>
                    </div>
                </article>
            <% }); %>
        <% } %>
    </div>
</main>

<script>
    async function createDeck() {
        const err = document.getElementById('new-error');
        err.style.display = 'none';
        const body = {
            name: document.getElementById('new-name').value.trim(),
            description: document.getElementById('new-desc').value.trim(),
            isPublic: document.getElementById('new-public').checked,
            nsfw: document.getElementById('new-nsfw').checked
        };
        if (!body.name) { err.textContent = 'Name is required.'; err.style.display = 'block'; return; }
        const res = await cfetch('/cah/my-decks/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const data = await res.json();
        if (!data.ok) { err.textContent = 'Could not create the deck (' + (data.reason || 'error') + ').'; err.style.display = 'block'; return; }
        location.href = '/cah/my-decks/' + data.deckId + '/edit';
    }

    async function deleteDeck(id, btn) {
        if (!confirm('Permanently delete this pack? Any games currently using it will lose access to its cards.')) return;
        btn.disabled = true;
        const res = await cfetch('/cah/my-decks/' + id, { method: 'DELETE' });
        const data = await res.json();
        if (data.ok) location.reload();
        else { btn.disabled = false; alert('Could not delete the deck (' + (data.reason || 'error') + ').'); }
    }

    function copyCode(code, btn) {
        navigator.clipboard?.writeText(code).then(() => {
            const orig = btn.textContent;
            btn.textContent = 'Copied';
            setTimeout(() => btn.textContent = orig, 1500);
        });
    }
</script>
<%- include('partials/site-footer') %>
</body>
</html>
