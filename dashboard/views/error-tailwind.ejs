<%#
  The site's error page. Rendered as 'error-tailwind' and, through views/error.ejs, as 'error'.
  Locals: error (the message shown), statusCode (optional), user (optional).
%>
<%
const _msg = locals.error || locals.message || 'Something on our side failed while loading this page. Try again in a moment.';
const _code = Number(locals.statusCode) || 0;
const _title = _code === 404 ? 'Page not found' : _code === 403 ? 'You can\'t open this page' : 'This page could not be shown';
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: (_code === 404 ? 'Not found' : 'Error') + ' · CertiFried', noindex: true }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
</head>
<body class="cfs-body cf-site">
<%- include('partials/site-header', { user: locals.user || null }) %>
<main id="main-content" class="cf-main cf-error" tabindex="-1">
<div class="cf-page is-narrow">
    <div class="cf-error-card" role="alert">
        <div class="cf-error-icon" aria-hidden="true"><i class="fas fa-triangle-exclamation"></i></div>
        <% if (_code) { %><p class="cf-error-code">Error <%= _code %></p><% } %>
        <h1 class="cf-error-title"><%= _title %></h1>
        <p class="cf-error-msg"><%= _msg %></p>
        <div class="cf-error-actions">
            <% if (locals.user) { %>
            <a href="/dashboard" class="btn btn-primary btn-sm">Your servers</a>
            <% } else { %>
            <a href="/" class="btn btn-primary btn-sm">Home</a>
            <% } %>
            <a href="/" class="btn btn-secondary btn-sm" data-cf-back>Go back</a>
        </div>
    </div>
</div>
</main>
<style>
    .cf-error { display: flex; align-items: center; }
    .cf-error-card { max-width: 32rem; margin: 0 auto; padding: var(--cf-8) var(--cf-6); text-align: center;
        background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
    .cf-error-icon { width: 40px; height: 40px; margin: 0 auto var(--cf-4); display: flex; align-items: center; justify-content: center;
        border-radius: 50%; border: 1px solid var(--cf-border-strong); color: var(--cf-warning); }
    .cf-error-code { margin: 0 0 6px; font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .cf-error-title { margin: 0 0 var(--cf-2); font-size: var(--cf-text-xl); font-weight: 600; letter-spacing: -0.01em; }
    .cf-error-msg { margin: 0 0 var(--cf-6); color: var(--cf-text-2); line-height: 1.6; overflow-wrap: anywhere; }
    .cf-error-actions { display: flex; gap: var(--cf-2); justify-content: center; flex-wrap: wrap; }
</style>
<script>
(function () {
    var back = document.querySelector('[data-cf-back]');
    if (back && history.length > 1) back.addEventListener('click', function (e) { e.preventDefault(); history.back(); });
})();
</script>
<%- include('partials/site-footer') %>
<script src="/js/csrf.js"></script>
</body>
</html>
