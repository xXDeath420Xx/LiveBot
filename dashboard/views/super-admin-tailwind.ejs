                    cBadge.className = 'badge badge-bot-yes';
                    var cIcon = document.createElement('i');
                    cIcon.className = 'fas fa-robot';
                    cBadge.appendChild(cIcon);
                    cBadge.append(' ' + g.customBot.bot_name);
                    tdBot.appendChild(cBadge);
