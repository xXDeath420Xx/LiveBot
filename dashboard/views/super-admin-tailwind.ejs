                    roleBadge.style.cssText = 'background:color-mix(in srgb, var(--cf-info) 15%, transparent);color:var(--cf-info-ink);';
                    roleIcon.className = 'fas fa-gavel';
                    roleBadge.appendChild(roleIcon);
                    roleBadge.append(' Moderator');
                } else if (g.isMember) {
                    roleBadge.style.cssText = 'background:color-mix(in srgb, var(--cf-success) 15%, transparent);color:var(--cf-success-ink);';
                    roleIcon.className = 'fas fa-user-check';
                    roleBadge.appendChild(roleIcon);
                    roleBadge.append(' Member');
                } else {
                    roleBadge.style.cssText = 'background:color-mix(in srgb, var(--cf-danger) 15%, transparent);color:var(--cf-danger-ink);';
                    roleIcon.className = 'fas fa-user-slash';
                    roleBadge.appendChild(roleIcon);
                    roleBadge.append(' Not a Member');
                }
                tdRole.appendChild(roleBadge);
                if (g.guildOwner) {
                    var ownerBadge = document.createElement('div');
                    ownerBadge.style.cssText = 'margin-top:4px;';
                    var ownerInner = document.createElement('span');
                    ownerInner.className = 'badge';
                    ownerInner.style.cssText = 'background:color-mix(in srgb, #ed8936 15%, transparent);color:var(--sa-owner);font-size:0.7rem;padding:2px 6px;';
                    var ownerIcon = document.createElement('i');
                    ownerIcon.className = 'fas fa-user';
                    ownerInner.appendChild(ownerIcon);
