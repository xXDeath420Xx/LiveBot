    async function loadStats() {
        try {
            const r = await fetch('/api/admin/stats');
            const d = await r.json();
            if (d.success) {
                document.getElementById('total-guilds').textContent = d.stats.totalGuilds.toLocaleString();
                document.getElementById('total-users').textContent = d.stats.totalUsers.toLocaleString();
                document.getElementById('live-streamers').textContent = d.stats.liveStreamers.toLocaleString();
                const days = Math.floor(d.stats.uptime / 86400), h = Math.floor((d.stats.uptime % 86400) / 3600), m = Math.floor((d.stats.uptime % 3600) / 60);
                document.getElementById('bot-uptime').textContent = days ? days + 'd ' + h + 'h' : h + 'h ' + m + 'm';
                document.getElementById('memory-usage').textContent = (d.stats.memoryUsage || 0) + ' MB';
                document.getElementById('custom-bots-sub').textContent = (d.stats.customBotsOnline || 0) + ' online';
            }
            const r2 = await fetch('/api/super-admin/stats');
            const d2 = await r2.json();
            if (d2.bots && d2.creators) {
                document.getElementById('custom-bots').textContent = Number(d2.bots.total_bots || 0).toLocaleString();
                document.getElementById('bot-creators').textContent = Number(d2.creators.total_creators || 0).toLocaleString();
            }
        } catch(e) { console.warn('[owner console] stats', e); }
    }

    // ========== Section Navigation ==========
    let currentSection = 'guilds';
    const sectionNames = ['guilds', 'globalbans', 'greenhouse', 'tools'];
    // Old bookmarks: #system / #users became Tools, #stats the KPI strip, #bots /bot-management.
    const sectionAliases = { system: 'tools', users: 'tools', stats: 'guilds', overview: 'guilds' };

    function switchSection(name) {
        if (!sectionNames.includes(name)) name = 'guilds';
        currentSection = name;
        sectionNames.forEach(s => {
            const el = document.getElementById('section-' + s);
            if (el) el.classList.toggle('active', s === name);
        });
        document.querySelectorAll('.cf-owner-nav-item[data-sa-section]').forEach(a => {
            const on = a.dataset.saSection === name;
            a.classList.toggle('is-active', on);
            if (on) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
        });
        history.replaceState(null, '', '#' + name);
        if (name === 'globalbans') { loadGBStats(); loadGBEntries(); }
    }

    document.querySelectorAll('.cf-owner-nav-item[data-sa-section]').forEach(a => {
        a.addEventListener('click', e => { e.preventDefault(); switchSection(a.dataset.saSection); });
    });

    // Runs after the whole script: the global-ban state (let gbEntriesPage…) is declared further
    // down, and opening /super-admin#globalbans used to throw on it and stop the rest of the script.
    document.addEventListener('DOMContentLoaded', function () {
        let hash = window.location.hash.replace('#', '');
        if (hash === 'bots') { window.location.replace('/bot-management?scope=all'); return; }
        hash = sectionAliases[hash] || hash;
        switchSection(sectionNames.includes(hash) ? hash : 'guilds');
    });
    // A link to another section of this page (e.g. from a notice) only changes the hash.
    window.addEventListener('hashchange', function () {
        const h = window.location.hash.replace('#', '');
        if (h === 'bots') { window.location.replace('/bot-management?scope=all'); return; }
        const name = sectionAliases[h] || h;
        if (sectionNames.includes(name) && name !== currentSection) switchSection(name);
    });

    // ========== Global Ban Management ==========
    let gbEntriesPage = 1;
    let gbEntriesLimit = 20;
    let gbSortCol = 'created_at';
    let gbSortDir = 'desc';

    function toggleGBSort(col) {
        if (gbSortCol === col) {
            gbSortDir = gbSortDir === 'desc' ? 'asc' : 'desc';
        } else {
            gbSortCol = col;
            gbSortDir = 'asc';
        }
        // Update sort icons
        document.querySelectorAll('.gb-sort-icon').forEach(icon => {
            icon.className = 'fas fa-sort gb-sort-icon';
        });
        const activeIcon = document.getElementById('gb-sort-' + col);
        if (activeIcon) {
            activeIcon.className = 'fas fa-sort-' + (gbSortDir === 'asc' ? 'up' : 'down') + ' gb-sort-icon gb-sort-active';
        }
        gbEntriesPage = 1;
        loadGBEntries();
    }
    let gbReportsPage = 1;
    let gbAppealsPage = 1;
    let gbActionLogPage = 1;

    function switchGBTab(tab, btn) {
        ['entries', 'reports', 'appeals', 'action-log'].forEach(t => {
            document.getElementById('gb-tab-' + t).style.display = t === tab ? 'block' : 'none';
        });
        btn.parentElement.querySelectorAll('.cf-tab').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        document.getElementById('gb-add-entry-btn').style.display = tab === 'entries' ? '' : 'none';
        document.getElementById('gb-import-csv-btn').style.display = tab === 'entries' ? '' : 'none';
        if (tab === 'entries') loadGBEntries();
        else if (tab === 'reports') loadGBReports();
        else if (tab === 'appeals') loadGBAppeals();
        else if (tab === 'action-log') loadGBActionLog();
    }

    const severityColors = { critical: 'var(--accent-red)', high: 'var(--sa-high)', medium: 'var(--accent-yellow)', low: 'var(--accent-green)' };
    const severityBg = { critical: 'color-mix(in srgb, var(--cf-danger) 15%, transparent)', high: 'color-mix(in srgb, #f97316 15%, transparent)', medium: 'color-mix(in srgb, var(--cf-warning) 15%, transparent)', low: 'color-mix(in srgb, var(--cf-success) 15%, transparent)' };

    function severityBadge(s) {
        return `<span class="cf-pill sa-sev sa-sev-${escapeHtml(s || 'unknown')}">${escapeHtml(s || 'unknown')}</span>`;
    }

    function timeAgo(dateStr) {
        if (!dateStr) return '-';
        const d = new Date(dateStr);
        const now = new Date();
        const diff = Math.floor((now - d) / 1000);
        if (diff < 60) return 'just now';
        if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
        return Math.floor(diff / 86400) + 'd ago';
    }

    // Returns HTML-escaped text: every caller inserts it into markup.
    function truncate(str, len) {
        if (!str) return '-';
        str = String(str);
        return escapeHtml(str.length > len ? str.substring(0, len) + '...' : str);
    }

    function escapeHtml(str) {
        if (str == null || str === '') return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function toggleGBDetail(id, row) {
        const detail = document.getElementById('gb-detail-' + id);
        const chevron = document.getElementById('gb-chev-' + id);
        if (!detail) return;
        const isOpen = detail.style.display !== 'none';
        detail.style.display = isOpen ? 'none' : 'table-row';
        if (chevron) chevron.classList.toggle('open', !isOpen);
    }

    async function loadGBStats() {
        try {
            const r = await fetch('/api/super-admin/global-ban/stats');
            const d = await r.json();
            if (d.success) {
                document.getElementById('gb-stat-entries').textContent = d.stats.activeEntries || 0;
                document.getElementById('gb-stat-reports').textContent = d.stats.pendingReports || 0;
                document.getElementById('gb-stat-appeals').textContent = d.stats.pendingAppeals || 0;
                document.getElementById('gb-stat-guilds').textContent = d.stats.enabledGuilds || 0;
                // Update nav badge with pending items count
                const pending = (d.stats.pendingReports || 0) + (d.stats.pendingAppeals || 0);
                const badge = document.getElementById('gb-nav-badge');
                if (badge) {
                    badge.textContent = pending;
                    badge.hidden = !(pending > 0);
                }

                const breakdown = (el, rows, key) => {
                    if (!rows || !rows.length) { el.replaceChildren(saEl('p', { class: 'cf-muted', text: 'None' })); return; }
                    el.replaceChildren(...rows.map(x => saEl('div', { class: 'sa-breakdown-row' }, [
                        key === 'severity' ? saEl('span', { class: 'cf-pill sa-sev sa-sev-' + x.severity, text: x.severity }) : saEl('span', { text: x.category }),
                        saEl('span', { class: 'cf-em', text: Number(x.count).toLocaleString() }),
                    ])));
                };
                breakdown(document.getElementById('gb-breakdown-category'), d.stats.byCategory, 'category');
                breakdown(document.getElementById('gb-breakdown-severity'), d.stats.bySeverity, 'severity');
            }

            // Report watcher (the audit bot, events/globalBanReportWatcher.js)
            try {
                const wr = await fetch('/api/super-admin/global-ban/watcher-status');
                const wd = await wr.json();
                if (wd.success) {
                    const el = document.getElementById('gb-stat-watcher');
                    const st = wd.status || {};
                    el.replaceChildren(saEl('span', { class: 'cf-pill ' + (st.connected ? 'is-ok' : 'is-bad'), text: st.connected ? 'Online' : 'Offline' }));
                    if (st.connected && st.processedCount > 0) el.append(saEl('span', { class: 'cf-kpi-sub', text: st.processedCount + ' handled since start' }));
                }
            } catch(e) { console.error('Failed to load watcher status:', e); }
        } catch (e) { console.error('Failed to load GB stats:', e); }
    }

    async function loadGBEntries() {
        const search = document.getElementById('gb-entries-search').value.trim();
        const severity = document.getElementById('gb-entries-severity').value;
        const category = document.getElementById('gb-entries-category').value;
        const params = new URLSearchParams({ page: gbEntriesPage, limit: gbEntriesLimit, active: '1', sort: gbSortCol, order: gbSortDir });
        if (search) params.set('search', search);
        if (severity) params.set('severity', severity);
        if (category) params.set('category', category);

        try {
            const r = await fetch('/api/super-admin/global-ban/entries?' + params);
            const d = await r.json();
            const tbody = document.getElementById('gb-entries-body');
            if (!d.success || !d.entries || d.entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="empty-state">No entries found</td></tr>';
                document.getElementById('gb-entries-pagination').innerHTML = '';
                return;
            }
            // NOTE: All data in this table is admin-controlled (super-admin imports only).
            // All user-facing text is sanitized via escapeHtml() before rendering.
            tbody.innerHTML = d.entries.map(e => {
                // Parse evidence
                let evidenceCount = 0;
                let evidenceLinks = [];
                let evidenceText = '';
                let discordLinks = [];
                try {
                    const evidenceArr = e.evidence ? JSON.parse(e.evidence) : [];
                    if (evidenceArr.length > 0) {
                        const allUrls = evidenceArr.flatMap(ev => ev.split(' | '));
                        evidenceLinks = allUrls.filter(u => u.startsWith('https://certifriedmultitool.com/'));
                        discordLinks = allUrls.filter(u => u.startsWith('https://discord.com/channels/'));
                        evidenceCount = evidenceLinks.length;
                        if (evidenceCount === 0 && discordLinks.length === 0 && evidenceArr[0]) {
                            evidenceText = escapeHtml(evidenceArr[0]);
                        }
                    }
                } catch(ex) {}

                // Evidence badge for summary row
                const imageBadge = evidenceCount > 0
                    ? '<span class="badge" style="background:color-mix(in srgb, var(--cf-success) 15%, transparent);color:var(--cf-success-ink)"><i class="fas fa-image" style="margin-right:3px"></i>' + evidenceCount + '</span>'
                    : '';
                const linkBadge = discordLinks.length > 0
                    ? '<span class="badge" style="background:color-mix(in srgb, #7289da 15%, transparent);color:var(--sa-discord-legacy)"><i class="fab fa-discord" style="margin-right:3px"></i>' + discordLinks.length + '</span>'
                    : '';
                const evidenceBadge = (imageBadge || linkBadge)
                    ? '<div style="display:flex;gap:4px;flex-wrap:wrap">' + imageBadge + linkBadge + '</div>'
                    : evidenceText
                        ? '<span style="font-size:0.7rem;color:var(--text-muted)"><i class="fas fa-comment-alt" style="margin-right:3px"></i>Text</span>'
                        : '<span style="color:var(--text-muted)">-</span>';

                // Evidence gallery for expanded panel
                // Discord message links section
                const discordLinksHtml = discordLinks.length > 0
                    ? '<div style="margin-bottom:0.5rem;">' + discordLinks.map((url, i) =>
                        '<a href="' + encodeURI(url) + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:var(--sa-discord-legacy);text-decoration:none;margin-right:0.75rem;margin-bottom:0.25rem;" title="View original report"><i class="fab fa-discord"></i>Source message ' + (i+1) + '</a>'
                    ).join('') + '</div>'
                    : '';
                // Image evidence gallery
                const imageGalleryHtml = evidenceLinks.length > 0
                    ? '<div class="gb-evidence-gallery">' + evidenceLinks.map((url, i) =>
                        '<a href="' + encodeURI(url) + '" target="_blank" rel="noopener" title="Evidence ' + (i+1) + '"><img src="' + encodeURI(url) + '" loading="lazy" alt="Evidence ' + (i+1) + '"></a>'
                    ).join('') + '</div>'
                    : '';
                const evidenceGallery = (discordLinksHtml || imageGalleryHtml)
                    ? discordLinksHtml + imageGalleryHtml
                    : evidenceText
                        ? '<div class="gb-detail-value" style="font-size:0.8rem;color:var(--text-secondary);font-style:italic;">' + evidenceText + '</div>'
                        : '<span style="color:var(--text-muted)">No evidence attached</span>';

                // Reporter info — prefer stored reporter_name, fall back to parsing from reason
                const reporterName = e.reporter_name ? escapeHtml(e.reporter_name) : (() => {
                    const m = (e.reason || '').match(/reported by (.+)$/);
                    return m ? escapeHtml(m[1]) : '-';
                })();
                const reporterId = e.reporter_id || '';

                // Safe reason (full, for expanded view)
                const safeReason = escapeHtml(e.reason || '-');
                const safeUsername = e.username ? escapeHtml(e.username) : '';

                // Summary row (clickable to expand)
                // Date cell: show created, and updated on a second line if different
                const createdAgo = timeAgo(e.created_at);
                const updatedAgo = e.updated_at && e.updated_at !== e.created_at ? timeAgo(e.updated_at) : '';
                const dateCell = '<div style="white-space:nowrap;">' + createdAgo + '</div>'
                    + (updatedAgo ? '<div style="white-space:nowrap;font-size:0.65rem;color:var(--text-muted);margin-top:1px;" title="Last updated"><i class="fas fa-pen" style="font-size:0.5rem;margin-right:2px;"></i>' + updatedAgo + '</div>' : '');

                const summaryRow = '<tr class="gb-row-clickable" onclick="toggleGBDetail(' + e.id + ', this)">'
                + '<td style="width:1.5rem;text-align:center;"><i class="fas fa-chevron-right gb-chevron" id="gb-chev-' + e.id + '"></i></td>'
                + '<td>'
                +   '<div style="font-size:0.8rem;font-weight:500;color:var(--text-primary);white-space:nowrap;">' + (safeUsername || '<span style="color:var(--text-muted)">Unknown</span>') + '</div>'
                +   '<div class="cf-mono cf-muted sa-uid">' + escapeHtml(e.user_id) + '</div>'
                + '</td>'
                + '<td>' + severityBadge(e.severity) + '</td>'
                + '<td><span class="badge" style="background:color-mix(in srgb, var(--cf-text) 5%, transparent);color:var(--text-secondary);font-size:0.7rem;">' + escapeHtml(e.category) + '</span></td>'
                + '<td style="max-width:200px;"><div style="font-size:0.75rem;color:var(--text-secondary);line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">' + safeReason + '</div></td>'
                + '<td><div style="font-size:0.75rem;color:var(--text-primary);font-weight:500;white-space:nowrap;">' + reporterName + '</div></td>'
                + '<td>' + evidenceBadge + '</td>'
                + '<td style="font-size:0.7rem;color:var(--text-muted);">' + dateCell + '</td>'
                + '<td style="text-align:right;white-space:nowrap;" onclick="event.stopPropagation()">'
                +   '<button class="btn btn-ghost btn-sm" style="width:auto;padding:0.25rem 0.4rem;" onclick="editGBEntry(' + e.id + ')" title="Edit"><i class="fas fa-edit"></i></button>'
                +   '<button class="btn btn-ghost btn-sm" style="width:auto;padding:0.25rem 0.4rem;color:var(--accent-red);" onclick="deleteGBEntry(' + e.id + ')" title="Delete"><i class="fas fa-trash"></i></button>'
                + '</td>'
                + '</tr>';

                // Expandable detail row (hidden by default)
                const detailRow = '<tr class="gb-expand-row" id="gb-detail-' + e.id + '" style="display:none;">'
                + '<td colspan="9">'
                +   '<div class="gb-detail-panel">'
                +     '<div class="gb-detail-grid">'
                +       '<div>'
                +         '<div class="gb-detail-label">Full Reason</div>'
                +         '<div class="gb-detail-value">' + safeReason + '</div>'
                +       '</div>'
                +       '<div>'
                +         '<div class="gb-detail-label">Evidence</div>'
                +         evidenceGallery
                +       '</div>'
                +       '<div>'
                +         '<div class="gb-detail-label">Reported By</div>'
                +         '<div class="gb-detail-value">' + reporterName + (reporterId ? '<br><span style="font-family:monospace;font-size:0.75rem;color:var(--text-muted)">' + reporterId + '</span>' : '') + '</div>'
                +       '</div>'
                +       '<div>'
                +         '<div class="gb-detail-label">Source</div>'
                +         '<div class="gb-detail-value"><span class="badge" style="background:var(--cf-accent-soft);color:var(--cf-accent-ink)">' + escapeHtml(e.source) + '</span></div>'
                +         '<div class="gb-detail-label" style="margin-top:0.75rem;">Created</div>'
                +         '<div class="gb-detail-value" style="font-size:0.8rem;">' + new Date(e.created_at).toLocaleString() + '</div>'
                +       '</div>'
                +     '</div>'
                +   '</div>'
                + '</td>'
                + '</tr>';

                return summaryRow + detailRow;
            }).join('');
            renderPagination('gb-entries-pagination', d.pagination, (p) => { gbEntriesPage = p; loadGBEntries(); });
        } catch (e) {
            document.getElementById('gb-entries-body').innerHTML = '<tr><td colspan="9" class="empty-state" style="color:var(--accent-red)">Error loading entries</td></tr>';
        }
    }

