    <script>
    // Mobile Menu
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');

    if (mobileMenuBtn && mobileMenu && mobileMenuClose) {
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.add('open');
            document.body.style.overflow = 'hidden';
        });

        mobileMenuClose.addEventListener('click', () => {
            mobileMenu.classList.remove('open');
            document.body.style.overflow = '';
        });

        mobileMenu.addEventListener('click', (e) => {
            if (e.target === mobileMenu) {
                mobileMenu.classList.remove('open');
                document.body.style.overflow = '';
            }
        });
    }

    // Guild list state
    let allGuilds = [];
    let currentFilter = 'all';
    let botClientId = '';

    // Deploy modal state
    let deployGuildId = '';
    let deployGuildName = '';

    document.addEventListener('DOMContentLoaded', () => {
        loadStats();
        loadBotManagers();
        loadAllBots();
        loadMyGuilds();
        loadGBStats();
        loadGBEntries();
        setInterval(loadStats, 30000);
        setInterval(refreshAndLoadGuilds, 60000);
        setInterval(loadGBStats, 60000);

        // Guild search handler
        document.getElementById('guild-search').addEventListener('input', renderGuilds);

        // Refresh guilds button
        document.getElementById('refresh-guilds-btn').addEventListener('click', function() {
            refreshAndLoadGuilds(this);
        });

        // Reinitialize Bot
        document.getElementById('reinitialize-bot-btn').addEventListener('click', async function() {
            if (!confirm('Re-initialize the entire bot? This will restart the bot process.')) return;
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Re-initializing...';
            try {
                const r = await fetch('/api/admin/reinit-bot', { method: 'POST', headers: { 'Content-Type': 'application/json' }});
                const d = await r.json();
                alert(d.success ? (d.message || 'Bot re-initialized') : `Error: ${d.error}`);
            } catch(e) { alert('Error re-initializing bot'); }
            finally { this.disabled = false; this.innerHTML = '<i class="fas fa-sync-alt"></i> Re-initialize Bot (Global)'; }
        });

        // Reinitialize Guild
        document.getElementById('reinitialize-guild-btn').addEventListener('click', async function() {
            const guildId = document.getElementById('guild-id-input').value.trim();
            if (!guildId) return alert('Please enter a Guild ID');
            if (!confirm(`Re-initialize guild ${guildId}?`)) return;
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            try {
                const r = await fetch('/api/admin/reinit-guild', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ guildId })});
                const d = await r.json();
                if (d.success) { alert(d.message || 'Guild re-initialized'); document.getElementById('guild-id-input').value = ''; }
                else alert(`Error: ${d.error}`);
            } catch(e) { alert('Error re-initializing guild'); }
            finally { this.disabled = false; this.innerHTML = '<i class="fas fa-sync"></i> Re-init'; }
        });

        // Leave Guild
        document.getElementById('leave-guild-btn').addEventListener('click', async function() {
            const guildId = document.getElementById('leave-guild-id-input').value.trim();
            if (!guildId) return alert('Please enter a Guild ID');
            if (!confirm(`Force bot to leave guild ${guildId}?`)) return;
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            try {
                const r = await fetch('/api/admin/leave-guild', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ guildId })});
                const d = await r.json();
                if (d.success) { alert(d.message || 'Left guild'); document.getElementById('leave-guild-id-input').value = ''; }
                else alert(`Error: ${d.error}`);
            } catch(e) { alert('Error leaving guild'); }
            finally { this.disabled = false; this.innerHTML = '<i class="fas fa-sign-out-alt"></i> Leave'; }
        });

        // Reset Database
        document.getElementById('reset-database-btn').addEventListener('click', async function() {
            if (!confirm('WARNING: Reset the entire database? This is irreversible!')) return;
            const confirmText = prompt('Type "RESET DATABASE" to confirm:');
            if (confirmText !== 'RESET DATABASE') return alert('Cancelled.');
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Resetting...';
            try {
                const r = await fetch('/api/admin/reset-database', { method: 'POST', headers: { 'Content-Type': 'application/json' }});
                const d = await r.json();
                alert(d.success ? (d.message || 'Database reset') : `Error: ${d.error}`);
            } catch(e) { alert('Error resetting database'); }
            finally { this.disabled = false; this.innerHTML = '<i class="fas fa-trash"></i> Reset Database'; }
        });

        // Audit Users
        document.getElementById('audit-users-btn').addEventListener('click', function() {
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Running Audit...';
            document.getElementById('audit-progress').classList.remove('hidden');
            document.getElementById('audit-results').classList.add('hidden');
            document.getElementById('audit-messages').innerHTML = '';
            const es = new EventSource('/api/admin/audit-users');
            let totalGuilds = 0;
            es.onmessage = (e) => {
                try {
                    const data = JSON.parse(e.data);
                    if (data.totalGuilds) totalGuilds = data.totalGuilds;
                    if (data.currentGuild) {
                        const pct = Math.round((data.currentGuild / totalGuilds) * 100);
                        document.getElementById('audit-progress-bar').style.width = `${pct}%`;
                        document.getElementById('audit-percentage').textContent = `${pct}%`;
                    }
                    if (data.message) {
                        document.getElementById('audit-status').textContent = data.message;
                        const div = document.createElement('div');
                        div.style.padding = '4px 0';
                        div.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
                        let color = 'var(--text-muted)';
                        if (data.type === 'error') color = 'var(--accent-red)';
                        if (data.type === 'match') color = 'var(--accent-green)';
                        if (data.type === 'info') color = 'var(--accent-purple)';
                        div.innerHTML = `<span style="color:${color}">${data.message}</span>`;
                        document.getElementById('audit-messages').appendChild(div);
                        document.getElementById('audit-messages').scrollTop = document.getElementById('audit-messages').scrollHeight;
                    }
                    if (data.type === 'complete' && data.results) {
                        es.close();
                        document.getElementById('audit-progress-bar').style.width = '100%';
                        document.getElementById('audit-percentage').textContent = '100%';
                        document.getElementById('audit-status').textContent = 'Audit completed!';
                        setTimeout(() => {
                            document.getElementById('audit-results').classList.remove('hidden');
                            document.getElementById('audit-guilds').textContent = data.results.totalGuilds;
                            document.getElementById('audit-members').textContent = data.results.totalMembers;
                            document.getElementById('audit-exact').textContent = data.results.exactMatches;
                            document.getElementById('audit-fuzzy').textContent = data.results.fuzzyMatches;
                            document.getElementById('audit-new-links').textContent = data.results.newLinks;
                            document.getElementById('audit-existing').textContent = data.results.existingLinks;
                        }, 500);
                        document.getElementById('audit-users-btn').disabled = false;
                        document.getElementById('audit-users-btn').innerHTML = '<i class="fas fa-search"></i> Run Full Audit';
                    }
                } catch(err) {}
            };
            es.onerror = () => {
                es.close();
                document.getElementById('audit-status').textContent = 'Error occurred';
                document.getElementById('audit-users-btn').disabled = false;
                document.getElementById('audit-users-btn').innerHTML = '<i class="fas fa-search"></i> Run Full Audit';
            };
        });

        // Search Streamer
        document.getElementById('search-streamer-btn').addEventListener('click', async function() {
            const username = document.getElementById('search-streamer-input').value.trim();
            const platform = document.getElementById('search-platform-select').value;
            if (!username) return alert('Enter a streamer username');
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
            try {
                const r = await fetch('/api/admin/search-streamer', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, platform })});
                const d = await r.json();
                if (d.success) {
                    document.getElementById('search-results').classList.remove('hidden');
                    document.getElementById('search-results-content').innerHTML = d.matches.length > 0 ?
                        d.matches.map(m => `<div class="result-card"><div class="result-card-title">${m.streamerUsername} <span style="color:var(--text-muted)">(${m.platform})</span></div><div class="result-card-meta">Discord: ${m.discordUsername} (${m.discordUserId})<br>Guild: ${m.guildName}</div></div>`).join('') :
                        '<div class="empty-state"><p>No matches found</p></div>';
                } else alert(`Error: ${d.error}`);
            } catch(e) { alert('Error searching'); }
            finally { this.disabled = false; this.innerHTML = '<i class="fas fa-search"></i> Search'; }
        });

        // View Links
        document.getElementById('view-links-btn').addEventListener('click', async function() {
            const userId = document.getElementById('user-id-input').value.trim();
            if (!userId) return alert('Enter a Discord User ID');
            this.disabled = true;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';
            try {
                const r = await fetch('/api/admin/view-links', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId })});
                const d = await r.json();
                if (d.success) {
                    document.getElementById('links-results').classList.remove('hidden');
                    document.getElementById('links-results-content').innerHTML = d.links.length > 0 ?
                        d.links.map(l => `<div class="result-card"><div class="result-card-title">${l.streamer_username} <span style="color:var(--text-muted)">(${l.platform})</span> ${l.verified ? '<span style="color:var(--accent-green);font-size:0.7rem">Verified</span>' : '<span style="color:var(--accent-yellow);font-size:0.7rem">Pending</span>'}</div><div class="result-card-meta">Linked: ${new Date(l.linked_at).toLocaleDateString()}</div></div>`).join('') :
                        '<div class="empty-state"><p>No links found</p></div>';
                } else alert(`Error: ${d.error}`);
            } catch(e) { alert('Error viewing links'); }
            finally { this.disabled = false; this.innerHTML = '<i class="fas fa-link"></i> View Links'; }
        });
    });

    // ─── Deploy Bot Modal Functions ─────────────────────────────

    function openDeployModal(guildId, guildName) {
        deployGuildId = guildId;
        deployGuildName = guildName;
        document.getElementById('deploy-guild-name').textContent = guildName;
        document.getElementById('deploy-status').style.display = 'none';
        document.getElementById('deploy-new-name').value = '';
        document.getElementById('deploy-new-token').value = '';
        switchDeployTab('existing');
        loadAvailableBots();
        document.getElementById('deploy-bot-modal').classList.add('show');
    }

    function closeDeployModal() {
        document.getElementById('deploy-bot-modal').classList.remove('show');
        deployGuildId = '';
        deployGuildName = '';
    }

    // Close modal on backdrop click
    document.getElementById('deploy-bot-modal').addEventListener('click', function(e) {
        if (e.target === this) closeDeployModal();
    });

    function switchDeployTab(tab) {
        document.getElementById('deploy-existing-tab').style.display = tab === 'existing' ? 'block' : 'none';
        document.getElementById('deploy-new-tab').style.display = tab === 'new' ? 'block' : 'none';
        document.getElementById('tab-existing').classList.toggle('active', tab === 'existing');
        document.getElementById('tab-new').classList.toggle('active', tab === 'new');
    }

    async function loadAvailableBots() {
        const select = document.getElementById('deploy-bot-select');
        select.replaceChildren();
        const loadingOpt = document.createElement('option');
        loadingOpt.value = '';
        loadingOpt.textContent = 'Loading...';
        select.appendChild(loadingOpt);

        try {
            const r = await fetch('/api/super-admin/all-bots');
            const d = await r.json();
            select.replaceChildren();

            if (d.success && d.bots && d.bots.length > 0) {
                const approvedBots = d.bots.filter(b => b.approved !== 0 && b.enabled !== 0);
                if (approvedBots.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = 'No approved bots available';
                    select.appendChild(opt);
                    return;
                }
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '-- Select a bot --';
                select.appendChild(placeholder);
                approvedBots.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.bot_id;
                    opt.textContent = (b.username || b.bot_name || 'Unknown') + ' (' + (b.status || 'unknown') + ')';
                    select.appendChild(opt);
                });
            } else {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = 'No custom bots registered';
                select.appendChild(opt);
            }
        } catch (e) {
            select.replaceChildren();
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = 'Error loading bots';
            select.appendChild(opt);
        }
    }

    async function deployExistingBot() {
        const botId = document.getElementById('deploy-bot-select').value;
        if (!botId) return showDeployStatus('Please select a bot', 'error');
        if (!deployGuildId) return showDeployStatus('No guild selected', 'error');

        const btn = document.getElementById('deploy-existing-btn');
        btn.disabled = true;
        btn.textContent = 'Deploying...';
        showDeployStatus('Assigning bot to guild...', 'info');

        try {
            const r = await fetch('/api/super-admin/deploy-existing-bot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botId, guildId: deployGuildId })
            });
            const d = await r.json();
            if (d.success) {
                showDeployStatus('Bot assigned! Opening invite link...', 'success');
                window.open(d.inviteUrl, '_blank');
                setTimeout(function() {
                    closeDeployModal();
                    loadMyGuilds();
                }, 1500);
            } else {
                showDeployStatus(d.error || 'Failed to deploy bot', 'error');
            }
        } catch (e) {
            showDeployStatus('Network error. Please try again.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '';
            const icon = document.createElement('i');
            icon.className = 'fas fa-rocket';
            btn.appendChild(icon);
            btn.append(' Deploy & Invite');
        }
    }

    async function deployNewBot() {
        const botName = document.getElementById('deploy-new-name').value.trim();
        const botToken = document.getElementById('deploy-new-token').value.trim();
        if (!botName) return showDeployStatus('Please enter a bot name', 'error');
        if (!botToken) return showDeployStatus('Please enter a bot token', 'error');
        if (!deployGuildId) return showDeployStatus('No guild selected', 'error');

        const btn = document.getElementById('deploy-new-btn');
        btn.disabled = true;
        btn.textContent = 'Validating & Registering...';
        showDeployStatus('Validating bot token... this may take up to 30 seconds.', 'info');

        try {
            const r = await fetch('/api/super-admin/deploy-new-bot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botName, botToken, guildId: deployGuildId })
            });
            const d = await r.json();
            if (d.success) {
                showDeployStatus('Bot registered and assigned! Opening invite link...', 'success');
                window.open(d.inviteUrl, '_blank');
                setTimeout(function() {
                    closeDeployModal();
                    loadMyGuilds();
                    loadAllBots();
                }, 1500);
            } else {
                showDeployStatus(d.error || 'Failed to register bot', 'error');
            }
        } catch (e) {
            showDeployStatus('Network error. Please try again.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '';
            const icon = document.createElement('i');
            icon.className = 'fas fa-plus';
            btn.appendChild(icon);
            btn.append(' Register & Deploy');
        }
    }

    function showDeployStatus(message, type) {
        const el = document.getElementById('deploy-status');
        el.style.display = 'block';
        var colors = { error: 'var(--accent-red)', success: 'var(--accent-green)', info: 'var(--accent-blue)' };
        var icons = { error: 'fa-exclamation-circle', success: 'fa-check-circle', info: 'fa-info-circle' };
        el.replaceChildren();
        var wrapper = document.createElement('div');
        wrapper.style.cssText = 'padding:0.625rem;border-radius:8px;font-size:0.8rem;background:rgba(255,255,255,0.03);border:1px solid ' + colors[type] + '30;color:' + colors[type];
        var icon = document.createElement('i');
        icon.className = 'fas ' + icons[type];
        wrapper.appendChild(icon);
        wrapper.append(' ' + message);
        el.appendChild(wrapper);
    }

    // ─── Guild List Functions ────────────────────────────────────

    async function refreshAndLoadGuilds(btn) {
        if (btn && btn instanceof HTMLElement) {
            const icon = btn.querySelector('i');
            if (icon) icon.classList.add('fa-spin');
        }
        try {
            await fetch('/api/super-admin/refresh-guilds', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        } catch (e) { /* silent — will fall back to cached session data */ }
        await loadMyGuilds();
        if (btn && btn instanceof HTMLElement) {
            const icon = btn.querySelector('i');
            if (icon) icon.classList.remove('fa-spin');
        }
    }

    async function loadMyGuilds() {
        try {
            const r = await fetch('/api/super-admin/my-guilds');
            const d = await r.json();
            if (d.success) {
                allGuilds = d.guilds;
                botClientId = d.botClientId;
                renderGuilds();
            } else {
                const errTd = document.createElement('td');
                errTd.colSpan = 5;
                errTd.textContent = 'Error loading guilds';
                errTd.style.cssText = 'text-align:center;padding:2rem;color:var(--accent-red)';
                const errTr = document.createElement('tr');
                errTr.appendChild(errTd);
                const tbody = document.getElementById('guild-table-body');
                tbody.replaceChildren(errTr);
            }
        } catch(e) {
            const errTd = document.createElement('td');
            errTd.colSpan = 5;
            errTd.textContent = 'Error loading guilds';
            errTd.style.cssText = 'text-align:center;padding:2rem;color:var(--accent-red)';
            const errTr = document.createElement('tr');
            errTr.appendChild(errTd);
            const tbody = document.getElementById('guild-table-body');
            tbody.replaceChildren(errTr);
        }
    }

    function filterGuilds(filter, btn) {
        currentFilter = filter;
        document.querySelectorAll('.guild-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderGuilds();
    }

    const roleCategoryMeta = {
        'Owner':         { badge: 'badge-owner', icon: 'fa-crown',      color: 'var(--accent-yellow)', label: 'Owner' },
        'Administrator': { badge: 'badge-admin', icon: 'fa-shield-alt', color: 'var(--accent-purple)', label: 'Administrator' }
    };

    function renderGuilds() {
        const search = (document.getElementById('guild-search').value || '').toLowerCase().trim();
        let filtered = allGuilds;

        if (currentFilter === 'with-bot') filtered = filtered.filter(g => g.botPresent);
        else if (currentFilter === 'without-bot') filtered = filtered.filter(g => !g.botPresent);
        else if (currentFilter === 'owner') filtered = filtered.filter(g => g.roleCategory === 'Owner');
        else if (currentFilter === 'admin') filtered = filtered.filter(g => g.roleCategory === 'Administrator');

        if (search) filtered = filtered.filter(g => g.name.toLowerCase().includes(search) || g.id.includes(search));

        document.getElementById('guild-count').textContent = filtered.length + ' of ' + allGuilds.length + ' guilds';

        const tbody = document.getElementById('guild-table-body');
        tbody.replaceChildren();

        if (filtered.length === 0) {
            const td = document.createElement('td');
            td.colSpan = 5;
            td.textContent = 'No guilds found';
            td.style.cssText = 'text-align:center;padding:2rem;color:var(--text-muted)';
            const tr = document.createElement('tr');
            tr.appendChild(td);
            tbody.appendChild(tr);
            return;
        }

        // Group by role category (Owner / Administrator) with section headers
        let lastCategory = null;
        filtered.forEach(g => {
            if (g.roleCategory !== lastCategory) {
                lastCategory = g.roleCategory;
                const meta = roleCategoryMeta[g.roleCategory];
                const categoryCount = filtered.filter(x => x.roleCategory === g.roleCategory).length;
                const headerTr = document.createElement('tr');
                headerTr.className = 'role-section-header';
                const headerTd = document.createElement('td');
                headerTd.colSpan = 5;
                const label = document.createElement('span');
                label.className = 'section-label';
                label.style.color = meta.color;
                const icon = document.createElement('i');
                icon.className = 'fas ' + meta.icon;
                label.appendChild(icon);
                label.append(' ' + meta.label + ' (' + categoryCount + ')');
                headerTd.appendChild(label);
                headerTr.appendChild(headerTd);
                tbody.appendChild(headerTr);
            }

            const tr = document.createElement('tr');

            // Server cell
            const tdServer = document.createElement('td');
            const guildInfo = document.createElement('div');
            guildInfo.className = 'guild-info';
            if (g.iconUrl) {
                const img = document.createElement('img');
                img.src = g.iconUrl;
                img.alt = '';
                img.className = 'guild-icon';
                img.onerror = function() {
                    const placeholder = document.createElement('div');
                    placeholder.className = 'guild-icon-placeholder';
                    placeholder.textContent = g.name.charAt(0).toUpperCase();
                    this.replaceWith(placeholder);
                };
                guildInfo.appendChild(img);
            } else {
                const placeholder = document.createElement('div');
                placeholder.className = 'guild-icon-placeholder';
                placeholder.textContent = g.name.charAt(0).toUpperCase();
                guildInfo.appendChild(placeholder);
            }
            const nameWrap = document.createElement('div');
            const nameEl = document.createElement('div');
            nameEl.className = 'guild-name';
            nameEl.textContent = g.name;
            const idEl = document.createElement('div');
            idEl.className = 'guild-id';
            idEl.textContent = g.id;
            nameWrap.appendChild(nameEl);
            nameWrap.appendChild(idEl);
            guildInfo.appendChild(nameWrap);
            tdServer.appendChild(guildInfo);

            // Role cell
            const tdRole = document.createElement('td');
            const meta = roleCategoryMeta[g.roleCategory];
            const roleBadge = document.createElement('span');
            roleBadge.className = 'badge ' + meta.badge;
            const roleIcon = document.createElement('i');
            roleIcon.className = 'fas ' + meta.icon;
            roleBadge.appendChild(roleIcon);
            roleBadge.append(' ' + meta.label);
            tdRole.appendChild(roleBadge);

            // Members cell
            const tdMembers = document.createElement('td');
            tdMembers.textContent = g.memberCount ? g.memberCount.toLocaleString() : '--';
            if (!g.memberCount) tdMembers.style.color = 'var(--text-muted)';

            // Bot status cell
            const tdBot = document.createElement('td');
            const botBadge = document.createElement('span');
            botBadge.className = 'badge ' + (g.botPresent ? 'badge-bot-yes' : 'badge-bot-no');
            const botIcon = document.createElement('i');
            botIcon.className = 'fas ' + (g.botPresent ? 'fa-check-circle' : 'fa-minus-circle');
            botBadge.appendChild(botIcon);
            botBadge.append(g.botPresent ? ' In Server' : ' Not In Server');
            tdBot.appendChild(botBadge);

            // Action cell
            const tdAction = document.createElement('td');
            tdAction.style.textAlign = 'right';
            tdAction.style.whiteSpace = 'nowrap';

            // Deploy Bot button (always shown)
            const deployBtn = document.createElement('button');
            deployBtn.className = 'btn-invite';
            deployBtn.style.marginRight = '0.5rem';
            deployBtn.style.background = 'linear-gradient(135deg, var(--accent-purple), var(--accent-blue))';
            const deployIcon = document.createElement('i');
            deployIcon.className = 'fas fa-rocket';
            deployBtn.appendChild(deployIcon);
            deployBtn.append(' Deploy Bot');
            (function(gId, gName) {
                deployBtn.onclick = function() { openDeployModal(gId, gName); };
            })(g.id, g.name);
            tdAction.appendChild(deployBtn);

            // Invite or Manage button
            const actionBtn = document.createElement('a');
            if (g.botPresent) {
                actionBtn.href = '/manage/' + g.id;
                actionBtn.className = 'btn-manage';
                const manageIcon = document.createElement('i');
                manageIcon.className = 'fas fa-cog';
                actionBtn.appendChild(manageIcon);
                actionBtn.append(' Manage');
            } else {
                actionBtn.href = 'https://discord.com/oauth2/authorize?client_id=' + encodeURIComponent(botClientId) + '&permissions=8&scope=bot+applications.commands&guild_id=' + encodeURIComponent(g.id) + '&disable_guild_select=true';
                actionBtn.target = '_blank';
                actionBtn.className = 'btn-invite';
                const inviteIcon = document.createElement('i');
                inviteIcon.className = 'fab fa-discord';
                actionBtn.appendChild(inviteIcon);
                actionBtn.append(' Invite');
            }
            tdAction.appendChild(actionBtn);

            tr.appendChild(tdServer);
            tr.appendChild(tdRole);
            tr.appendChild(tdMembers);
            tr.appendChild(tdBot);
            tr.appendChild(tdAction);
            tbody.appendChild(tr);
        });
    }

    async function loadStats() {
        try {
            const r = await fetch('/api/admin/stats');
            const d = await r.json();
            if (d.success) {
                document.getElementById('total-guilds').textContent = d.stats.totalGuilds.toLocaleString();
                document.getElementById('total-users').textContent = d.stats.totalUsers.toLocaleString();
                document.getElementById('live-streamers').textContent = d.stats.liveStreamers.toLocaleString();
                const h = Math.floor(d.stats.uptime / 3600), m = Math.floor((d.stats.uptime % 3600) / 60);
                const uptime = `${h}h ${m}m`;
                document.getElementById('bot-uptime').textContent = uptime;
                document.getElementById('memory-usage').textContent = `${d.stats.memoryUsage || 0} MB`;
                document.getElementById('total-guilds-detail').textContent = d.stats.totalGuilds.toLocaleString();
                document.getElementById('total-users-detail').textContent = d.stats.totalUsers.toLocaleString();
                document.getElementById('live-streamers-detail').textContent = d.stats.liveStreamers.toLocaleString();
                document.getElementById('bot-uptime-detail').textContent = uptime;
                document.getElementById('memory-usage-detail').textContent = `${d.stats.memoryUsage || 0} MB`;
            }
            const r2 = await fetch('/api/super-admin/stats');
            const d2 = await r2.json();
            if (d2.bots && d2.creators) {
                document.getElementById('custom-bots').textContent = d2.bots.total_bots.toLocaleString();
                document.getElementById('bot-creators').textContent = d2.creators.total_creators.toLocaleString();
            }
        } catch(e) {}
    }

    async function loadBotManagers() {
        try {
            const r = await fetch('/api/super-admin/bot-managers');
            const d = await r.json();
            const c = document.getElementById('bot-managers-list');
            if (!d.success || !d.managers || d.managers.length === 0) {
                c.innerHTML = '<div class="empty-state"><p>No bot managers yet. Add one to get started!</p></div>';
                return;
            }
            c.innerHTML = d.managers.map(m => `<div class="list-item"><div class="list-item-info"><i class="fas fa-user-shield" style="color:var(--accent-purple);font-size:1.25rem"></i><div><div class="list-item-name">${m.username || 'Unknown User'}</div><div class="list-item-id">ID: ${m.user_id}</div></div></div><button class="btn btn-danger btn-sm" style="width:auto" onclick="removeBotManager('${m.user_id}')"><i class="fas fa-trash"></i></button></div>`).join('');
        } catch(e) { document.getElementById('bot-managers-list').innerHTML = '<div class="empty-state" style="color:var(--accent-red)"><p>Error loading managers</p></div>'; }
    }

    async function addBotManager() {
        const userId = document.getElementById('manager-user-id').value.trim();
        if (!userId) return alert('Enter a user ID');
        try {
            const r = await fetch('/api/super-admin/bot-managers', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId })});
            const d = await r.json();
            if (d.success) { document.getElementById('add-manager-modal').classList.remove('show'); document.getElementById('manager-user-id').value = ''; loadBotManagers(); }
            else alert(d.error || 'Failed to add manager');
        } catch(e) { alert('An error occurred'); }
    }

    async function removeBotManager(userId) {
        if (!confirm('Remove this bot manager?')) return;
        try {
            const r = await fetch(`/api/super-admin/bot-managers/${userId}`, { method: 'DELETE' });
            const d = await r.json();
            if (d.success) loadBotManagers();
            else alert(d.error || 'Failed to remove manager');
        } catch(e) { alert('An error occurred'); }
    }

    async function loadAllBots() {
        try {
            const r = await fetch('/api/super-admin/all-bots');
            const d = await r.json();
            const c = document.getElementById('all-bots-list');
            if (!d.success || !d.bots || d.bots.length === 0) {
