    // ========== Section Navigation ==========
    let currentSection = 'guilds';
    const sectionNames = ['guilds', 'system', 'users', 'bots', 'globalbans', 'stats'];

    function switchSection(name, btn) {
        if (currentSection === name) return;
        currentSection = name;

        // Hide all sections, show the selected one
        sectionNames.forEach(s => {
            const el = document.getElementById('section-' + s);
            if (el) el.classList.toggle('active', s === name);
        });

        // Update nav buttons
        document.querySelectorAll('.section-nav-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');

        // Update URL hash
        history.replaceState(null, '', '#' + name);

        // Scroll to top of content
        window.scrollTo({ top: 0, behavior: 'instant' });

        // Lazy-load section data
        if (name === 'globalbans') {
            loadGBStats();
            loadGBEntries();
        }
    }

    // Handle hash on page load
    (function() {
        const hash = window.location.hash.replace('#', '');
        if (hash && sectionNames.includes(hash)) {
            const btn = document.querySelector(`.section-nav-btn[data-section="${hash}"]`);
            switchSection(hash, btn);
        }
    })();

    // ========== Global Ban Management ==========
    let gbEntriesPage = 1;
    let gbEntriesLimit = 20;
    let gbSortCol = 'created_at';
    let gbSortDir = 'desc';

    function toggleGBSort(col) {
        if (gbSortCol === col) {
            gbSortDir = gbSortDir === 'desc' ? 'asc' : 'desc';
        } else {
            gbSortCol = col;
            gbSortDir = 'asc';
        }
        // Update sort icons
        document.querySelectorAll('.gb-sort-icon').forEach(icon => {
            icon.className = 'fas fa-sort gb-sort-icon';
        });
        const activeIcon = document.getElementById('gb-sort-' + col);
        if (activeIcon) {
            activeIcon.className = 'fas fa-sort-' + (gbSortDir === 'asc' ? 'up' : 'down') + ' gb-sort-icon gb-sort-active';
        }
        gbEntriesPage = 1;
        loadGBEntries();
    }
    let gbReportsPage = 1;
    let gbAppealsPage = 1;
    let gbActionLogPage = 1;

    function switchGBTab(tab, btn) {
        ['entries', 'reports', 'appeals', 'action-log'].forEach(t => {
            document.getElementById('gb-tab-' + t).style.display = t === tab ? 'block' : 'none';
        });
        btn.parentElement.querySelectorAll('.guild-filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('gb-add-entry-btn').style.display = tab === 'entries' ? '' : 'none';
        document.getElementById('gb-import-csv-btn').style.display = tab === 'entries' ? '' : 'none';
        if (tab === 'entries') loadGBEntries();
        else if (tab === 'reports') loadGBReports();
        else if (tab === 'appeals') loadGBAppeals();
        else if (tab === 'action-log') loadGBActionLog();
    }

    const severityColors = { critical: 'var(--accent-red)', high: '#f97316', medium: 'var(--accent-yellow)', low: 'var(--accent-green)' };
    const severityBg = { critical: 'rgba(248,113,113,0.15)', high: 'rgba(249,115,22,0.15)', medium: 'rgba(251,191,36,0.15)', low: 'rgba(52,211,153,0.15)' };

    function severityBadge(s) {
        return `<span class="badge" style="background:${severityBg[s] || 'rgba(255,255,255,0.05)'};color:${severityColors[s] || 'var(--text-muted)'}">${s || 'unknown'}</span>`;
    }

    function timeAgo(dateStr) {
        if (!dateStr) return '-';
        const d = new Date(dateStr);
        const now = new Date();
        const diff = Math.floor((now - d) / 1000);
        if (diff < 60) return 'just now';
        if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
        return Math.floor(diff / 86400) + 'd ago';
    }

    function truncate(str, len) {
        if (!str) return '-';
        return str.length > len ? str.substring(0, len) + '...' : str;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function toggleGBDetail(id, row) {
        const detail = document.getElementById('gb-detail-' + id);
        const chevron = document.getElementById('gb-chev-' + id);
        if (!detail) return;
        const isOpen = detail.style.display !== 'none';
        detail.style.display = isOpen ? 'none' : 'table-row';
        if (chevron) chevron.classList.toggle('open', !isOpen);
    }

    async function loadGBStats() {
        try {
            const r = await fetch('/api/super-admin/global-ban/stats');
            const d = await r.json();
            if (d.success) {
                document.getElementById('gb-stat-entries').textContent = d.stats.activeEntries || 0;
                document.getElementById('gb-stat-reports').textContent = d.stats.pendingReports || 0;
                document.getElementById('gb-stat-appeals').textContent = d.stats.pendingAppeals || 0;
                document.getElementById('gb-stat-guilds').textContent = d.stats.enabledGuilds || 0;
                // Update nav badge with pending items count
                const pending = (d.stats.pendingReports || 0) + (d.stats.pendingAppeals || 0);
                const badge = document.getElementById('gb-nav-badge');
                if (pending > 0) {
                    badge.textContent = pending;
                    badge.style.display = '';
                } else {
                    badge.style.display = 'none';
                }
            }
        } catch (e) { console.error('Failed to load GB stats:', e); }
    }

    async function loadGBEntries() {
        const search = document.getElementById('gb-entries-search').value.trim();
        const severity = document.getElementById('gb-entries-severity').value;
        const category = document.getElementById('gb-entries-category').value;
        const params = new URLSearchParams({ page: gbEntriesPage, limit: gbEntriesLimit, active: '1', sort: gbSortCol, order: gbSortDir });
        if (search) params.set('search', search);
        if (severity) params.set('severity', severity);
        if (category) params.set('category', category);

        try {
            const r = await fetch('/api/super-admin/global-ban/entries?' + params);
            const d = await r.json();
            const tbody = document.getElementById('gb-entries-body');
            if (!d.success || !d.entries || d.entries.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="empty-state">No entries found</td></tr>';
                document.getElementById('gb-entries-pagination').innerHTML = '';
                return;
            }
            // NOTE: All data in this table is admin-controlled (super-admin imports only).
            // All user-facing text is sanitized via escapeHtml() before rendering.
            tbody.innerHTML = d.entries.map(e => {
                // Parse evidence
                let evidenceCount = 0;
                let evidenceLinks = [];
                let evidenceText = '';
                let discordLinks = [];
                try {
                    const evidenceArr = e.evidence ? JSON.parse(e.evidence) : [];
                    if (evidenceArr.length > 0) {
                        const allUrls = evidenceArr.flatMap(ev => ev.split(' | '));
                        evidenceLinks = allUrls.filter(u => u.startsWith('https://certifriedmultitool.com/'));
                        discordLinks = allUrls.filter(u => u.startsWith('https://discord.com/channels/'));
                        evidenceCount = evidenceLinks.length;
                        if (evidenceCount === 0 && discordLinks.length === 0 && evidenceArr[0]) {
                            evidenceText = escapeHtml(evidenceArr[0]);
                        }
                    }
                } catch(ex) {}

                // Evidence badge for summary row
                const imageBadge = evidenceCount > 0
                    ? '<span class="badge" style="background:rgba(52,211,153,0.15);color:var(--accent-green)"><i class="fas fa-image" style="margin-right:3px"></i>' + evidenceCount + '</span>'
                    : '';
                const linkBadge = discordLinks.length > 0
                    ? '<span class="badge" style="background:rgba(114,137,218,0.15);color:#7289da"><i class="fab fa-discord" style="margin-right:3px"></i>' + discordLinks.length + '</span>'
                    : '';
                const evidenceBadge = (imageBadge || linkBadge)
                    ? '<div style="display:flex;gap:4px;flex-wrap:wrap">' + imageBadge + linkBadge + '</div>'
                    : evidenceText
                        ? '<span style="font-size:0.7rem;color:var(--text-muted)"><i class="fas fa-comment-alt" style="margin-right:3px"></i>Text</span>'
                        : '<span style="color:var(--text-muted)">-</span>';

                // Evidence gallery for expanded panel
                // Discord message links section
                const discordLinksHtml = discordLinks.length > 0
                    ? '<div style="margin-bottom:0.5rem;">' + discordLinks.map((url, i) =>
                        '<a href="' + encodeURI(url) + '" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:4px;font-size:0.8rem;color:#7289da;text-decoration:none;margin-right:0.75rem;margin-bottom:0.25rem;" title="View original report"><i class="fab fa-discord"></i>Source message ' + (i+1) + '</a>'
                    ).join('') + '</div>'
                    : '';
                // Image evidence gallery
                const imageGalleryHtml = evidenceLinks.length > 0
                    ? '<div class="gb-evidence-gallery">' + evidenceLinks.map((url, i) =>
                        '<a href="' + encodeURI(url) + '" target="_blank" rel="noopener" title="Evidence ' + (i+1) + '"><img src="' + encodeURI(url) + '" loading="lazy" alt="Evidence ' + (i+1) + '"></a>'
                    ).join('') + '</div>'
                    : '';
                const evidenceGallery = (discordLinksHtml || imageGalleryHtml)
                    ? discordLinksHtml + imageGalleryHtml
                    : evidenceText
                        ? '<div class="gb-detail-value" style="font-size:0.8rem;color:var(--text-secondary);font-style:italic;">' + evidenceText + '</div>'
                        : '<span style="color:var(--text-muted)">No evidence attached</span>';

                // Reporter info — prefer stored reporter_name, fall back to parsing from reason
                const reporterName = e.reporter_name ? escapeHtml(e.reporter_name) : (() => {
                    const m = (e.reason || '').match(/reported by (.+)$/);
                    return m ? escapeHtml(m[1]) : '-';
                })();
                const reporterId = e.reporter_id || '';

                // Safe reason (full, for expanded view)
                const safeReason = escapeHtml(e.reason || '-');
                const safeUsername = e.username ? escapeHtml(e.username) : '';

                // Summary row (clickable to expand)
                const summaryRow = '<tr class="gb-row-clickable" onclick="toggleGBDetail(' + e.id + ', this)">'
                + '<td style="width:2rem;text-align:center;"><i class="fas fa-chevron-right gb-chevron" id="gb-chev-' + e.id + '"></i></td>'
                + '<td>'
                +   '<div style="font-size:0.85rem;font-weight:500;color:var(--text-primary);">' + (safeUsername || '<span style="color:var(--text-muted)">Unknown</span>') + '</div>'
                +   '<div style="font-family:monospace;font-size:0.7rem;color:var(--text-muted);margin-top:1px;">' + e.user_id + '</div>'
                + '</td>'
                + '<td>' + severityBadge(e.severity) + '</td>'
                + '<td><span class="badge" style="background:rgba(255,255,255,0.05);color:var(--text-secondary)">' + escapeHtml(e.category) + '</span></td>'
                + '<td style="max-width:300px;"><div style="font-size:0.8rem;color:var(--text-secondary);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">' + safeReason + '</div></td>'
                + '<td><div style="font-size:0.8rem;color:var(--text-primary);font-weight:500;">' + reporterName + '</div>' + (reporterId ? '<div style="font-family:monospace;font-size:0.65rem;color:var(--text-muted);margin-top:1px;">' + reporterId + '</div>' : '') + '</td>'
                + '<td>' + evidenceBadge + '</td>'
                + '<td style="font-size:0.75rem;color:var(--text-muted);white-space:nowrap;">' + timeAgo(e.created_at) + '</td>'
                + '<td style="text-align:right;" onclick="event.stopPropagation()">'
                +   '<button class="btn btn-ghost btn-sm" style="width:auto;padding:0.35rem 0.5rem;" onclick="editGBEntry(' + e.id + ')" title="Edit"><i class="fas fa-edit"></i></button>'
                +   '<button class="btn btn-ghost btn-sm" style="width:auto;padding:0.35rem 0.5rem;color:var(--accent-red);" onclick="deleteGBEntry(' + e.id + ')" title="Delete"><i class="fas fa-trash"></i></button>'
                + '</td>'
                + '</tr>';

                // Expandable detail row (hidden by default)
                const detailRow = '<tr class="gb-expand-row" id="gb-detail-' + e.id + '" style="display:none;">'
                + '<td colspan="9">'
                +   '<div class="gb-detail-panel">'
                +     '<div class="gb-detail-grid">'
                +       '<div>'
                +         '<div class="gb-detail-label">Full Reason</div>'
                +         '<div class="gb-detail-value">' + safeReason + '</div>'
                +       '</div>'
                +       '<div>'
                +         '<div class="gb-detail-label">Evidence</div>'
                +         evidenceGallery
                +       '</div>'
                +       '<div>'
                +         '<div class="gb-detail-label">Reported By</div>'
                +         '<div class="gb-detail-value">' + reporterName + (reporterId ? '<br><span style="font-family:monospace;font-size:0.75rem;color:var(--text-muted)">' + reporterId + '</span>' : '') + '</div>'
                +       '</div>'
                +       '<div>'
                +         '<div class="gb-detail-label">Source</div>'
                +         '<div class="gb-detail-value"><span class="badge" style="background:rgba(167,139,250,0.15);color:var(--accent-purple)">' + escapeHtml(e.source) + '</span></div>'
                +         '<div class="gb-detail-label" style="margin-top:0.75rem;">Created</div>'
                +         '<div class="gb-detail-value" style="font-size:0.8rem;">' + new Date(e.created_at).toLocaleString() + '</div>'
                +       '</div>'
                +     '</div>'
                +   '</div>'
                + '</td>'
                + '</tr>';

                return summaryRow + detailRow;
            }).join('');
            renderPagination('gb-entries-pagination', d.pagination, (p) => { gbEntriesPage = p; loadGBEntries(); });
        } catch (e) {
            document.getElementById('gb-entries-body').innerHTML = '<tr><td colspan="9" class="empty-state" style="color:var(--accent-red)">Error loading entries</td></tr>';
        }
    }

    async function loadGBReports() {
