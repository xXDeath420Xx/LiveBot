<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta name="description" content="Super Admin panel for CertiFried MultiTool">
    <meta name="robots" content="noindex">
    <title>Super Admin - CertiFried MultiTool</title>
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0b0f11;
            --bg-secondary: #0f1316;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.5);
            --accent-purple: #a78bfa;
            --accent-blue: #60a5fa;
            --accent-green: #34d399;
            --accent-cyan: #22d3ee;
            --accent-yellow: #fbbf24;
            --accent-red: #f87171;
            --accent-orange: #fb923c;
        }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; overflow-x: hidden; }

        /* Background Effects */
        .bg-effects { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: hidden; }
        .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.15; animation: float 25s ease-in-out infinite; }
        .orb-1 { width: 500px; height: 500px; background: linear-gradient(135deg, #7c3aed, #a78bfa); top: -15%; right: -10%; }
        .orb-2 { width: 400px; height: 400px; background: linear-gradient(135deg, #3b82f6, #60a5fa); bottom: -15%; left: -10%; animation-delay: -12s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, 30px) scale(1.05); } }

        /* Navbar */
        .navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 1rem 0; background: rgba(11, 15, 17, 0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-color); }
        .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
        .navbar-container { max-width: 1200px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .navbar-brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-primary); font-weight: 700; }
        .navbar-logo { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-purple); }
        .navbar-links { display: flex; align-items: center; gap: 1.5rem; }
        .navbar-links a { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
        .navbar-links a:hover { color: var(--text-primary); }
        .user-menu-container { position: relative; }
        .user-menu { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 50px; cursor: pointer; transition: all 0.2s; }
        .user-menu:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .user-avatar { width: 28px; height: 28px; border-radius: 50%; }
        .user-name { color: var(--text-primary); font-size: 0.875rem; font-weight: 500; }
        .user-menu-chevron { font-size: 0.7rem; color: var(--text-muted); transition: transform 0.2s; }
        .user-menu-container.open .user-menu-chevron { transform: rotate(180deg); }
        .user-dropdown { position: absolute; top: calc(100% + 8px); right: 0; min-width: 220px; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: all 0.2s ease; z-index: 1001; overflow: hidden; }
        .user-menu-container.open .user-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-header { padding: 1rem; border-bottom: 1px solid var(--border-color); }
        .dropdown-user-info { font-size: 0.8rem; color: var(--text-muted); }
        .dropdown-divider { height: 1px; background: var(--border-color); margin: 0.5rem 0; }
        .dropdown-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: all 0.15s; }
        .dropdown-item:hover { background: var(--bg-card-hover); color: var(--text-primary); }
        .dropdown-item i { width: 18px; text-align: center; }
        .dropdown-item.text-warning { color: var(--accent-yellow); }
        .dropdown-item.text-warning:hover { background: rgba(251, 191, 36, 0.1); }
        .dropdown-item.text-danger { color: var(--accent-red); }
        .dropdown-item.text-danger:hover { background: rgba(248, 113, 113, 0.1); }

        /* Mobile Menu */
        .mobile-menu-btn { display: none; background: none; border: none; color: var(--text-secondary); padding: 0.5rem; cursor: pointer; }
        @media (max-width: 768px) {
            .navbar-links { display: none; }
            .mobile-menu-btn { display: block; }
        }

        /* Main Content */
        main { position: relative; z-index: 1; padding: 100px 0 4rem; min-height: 100vh; }

        /* Page Header */
        .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
        .page-header-content { display: flex; align-items: center; gap: 1rem; }
        .page-icon { width: 56px; height: 56px; background: linear-gradient(135deg, rgba(167, 139, 250, 0.2), rgba(124, 58, 237, 0.2)); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 16px; display: flex; align-items: center; justify-content: center; }
        .page-icon i { font-size: 1.5rem; color: var(--accent-purple); }
        .page-title { font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800; background: linear-gradient(135deg, var(--text-primary), var(--accent-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .page-subtitle { color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.25rem; }
        .admin-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: rgba(167, 139, 250, 0.1); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 50px; font-size: 0.75rem; font-weight: 600; color: var(--accent-purple); }

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.25rem; text-align: center; transition: all 0.2s; backdrop-filter: blur(10px); }
        .stat-card:hover { border-color: var(--accent-purple); transform: translateY(-2px); }
        .stat-icon { margin-bottom: 0.75rem; }
        .stat-icon i { font-size: 1.5rem; }
        .stat-value { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.25rem; background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }

        /* Cards */
        .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; overflow: hidden; backdrop-filter: blur(10px); transition: all 0.2s; }
        .card:hover { border-color: rgba(167, 139, 250, 0.3); }
        .card-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-color); }
        .card-title { display: flex; align-items: center; gap: 0.75rem; font-weight: 600; font-size: 0.95rem; }
        .card-title-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
        .card-title-icon i { font-size: 1rem; }
        .card-body { padding: 1.25rem; }

        /* Section Title */
        .section-title { display: flex; align-items: center; gap: 0.75rem; font-size: 1.25rem; font-weight: 700; margin-bottom: 1.25rem; }
        .section-title i { color: var(--accent-purple); }

        /* Grid Layouts */
        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
        @media (max-width: 1024px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }

        /* Buttons */
        .btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.625rem 1rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; font-family: inherit; width: 100%; }
        .btn-primary { background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue)); color: white; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 15px rgba(167, 139, 250, 0.3); }
        .btn-warning { background: rgba(251, 191, 36, 0.15); border: 1px solid rgba(251, 191, 36, 0.3); color: var(--accent-yellow); }
        .btn-warning:hover { background: rgba(251, 191, 36, 0.25); }
        .btn-danger { background: rgba(248, 113, 113, 0.15); border: 1px solid rgba(248, 113, 113, 0.3); color: var(--accent-red); }
        .btn-danger:hover { background: rgba(248, 113, 113, 0.25); }
        .btn-ghost { background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-color); color: var(--text-primary); }
        .btn-ghost:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .btn-sm { padding: 0.5rem 0.875rem; font-size: 0.8rem; width: auto; }

        /* Inputs */
        .input { width: 100%; padding: 0.625rem 0.875rem; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-color); border-radius: 10px; color: var(--text-primary); font-size: 0.875rem; font-family: inherit; transition: all 0.2s; }
        .input:focus { outline: none; border-color: var(--accent-purple); background: rgba(255, 255, 255, 0.08); }
        .input::placeholder { color: var(--text-muted); }
        .input-group { display: flex; gap: 0.75rem; margin-bottom: 0.75rem; }
        .input-group .input { flex: 1; }
        .input-group .btn { width: auto; flex-shrink: 0; }
        select.input { cursor: pointer; }
        select.input option { background: var(--bg-primary); color: var(--text-primary); }

        /* Progress */
        .progress-container { padding: 1rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; margin-top: 1rem; }
        .progress-header { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.8rem; }
        .progress-bar { height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 6px; overflow: hidden; margin-bottom: 0.75rem; }
        .progress-fill { height: 100%; background: linear-gradient(90deg, var(--accent-purple), var(--accent-blue)); transition: width 0.3s ease; }
        .progress-messages { max-height: 120px; overflow-y: auto; font-size: 0.75rem; color: var(--text-muted); }
        .progress-messages::-webkit-scrollbar { width: 4px; }
        .progress-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

        /* Results */
        .results-container { padding: 1rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; margin-top: 1rem; max-height: 280px; overflow-y: auto; }
        .results-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; font-size: 0.8rem; }
        .result-item { display: flex; justify-content: space-between; }
        .result-label { color: var(--text-muted); }
        .result-value { font-weight: 600; }
        .result-card { padding: 0.875rem; background: rgba(255, 255, 255, 0.02); border-left: 3px solid var(--accent-purple); border-radius: 8px; margin-bottom: 0.5rem; }
        .result-card-title { font-weight: 600; margin-bottom: 0.25rem; }
        .result-card-meta { font-size: 0.75rem; color: var(--text-muted); }

        /* Manager/Bot List Items */
        .list-item { display: flex; align-items: center; justify-content: space-between; padding: 0.875rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 0.75rem; transition: all 0.2s; }
        .list-item:hover { background: var(--bg-card-hover); }
        .list-item-info { display: flex; align-items: center; gap: 0.75rem; }
        .list-item-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
        .list-item-name { font-weight: 600; font-size: 0.9rem; }
        .list-item-id { font-size: 0.75rem; color: var(--text-muted); }

        /* Bot Card */
        .bot-card { padding: 1rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-left: 4px solid var(--text-muted); border-radius: 12px; margin-bottom: 0.75rem; }
        .bot-card.online { border-left-color: var(--accent-green); }
        .bot-card.ready { border-left-color: var(--accent-yellow); }
        .bot-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
        .bot-avatar { width: 44px; height: 44px; border-radius: 50%; }
        .bot-name { font-weight: 600; }
        .bot-id { font-size: 0.75rem; color: var(--text-muted); }
        .bot-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; font-size: 0.8rem; }
        .bot-stat-label { color: var(--text-muted); }
        .bot-stat-value { font-weight: 500; }

        /* Stats Detail Row */
        .stat-row { display: flex; align-items: center; justify-content: space-between; padding: 1rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 12px; margin-bottom: 0.5rem; transition: all 0.2s; }
        .stat-row:hover { background: var(--bg-card-hover); transform: translateX(4px); }
        .stat-row-label { display: flex; align-items: center; gap: 0.625rem; font-size: 0.875rem; color: var(--text-secondary); }
        .stat-row-label i { color: var(--accent-purple); }
        .stat-row-value { font-weight: 700; font-size: 1rem; }
        .stat-badge { padding: 0.375rem 0.75rem; border-radius: 50px; font-size: 0.75rem; font-weight: 600; }
        .stat-badge.green { background: rgba(52, 211, 153, 0.15); color: var(--accent-green); }
        .stat-badge.purple { background: rgba(167, 139, 250, 0.15); color: var(--accent-purple); }
        .stat-badge.yellow { background: rgba(251, 191, 36, 0.15); color: var(--accent-yellow); }

        /* Modal */
        .modal { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.8); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem; }
        .modal.show { display: flex; }
        .modal-content { background: #0f1316; border: 1px solid var(--border-color); border-radius: 16px; padding: 1.5rem; max-width: 400px; width: 100%; }
        .modal-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 1rem; }
        .modal-label { font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); margin-bottom: 0.5rem; display: block; }
        .modal-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; }
        .modal-actions .btn { flex: 1; }

        /* Guild Table */
        .guild-table-wrapper { overflow-x: auto; }
        .guild-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .guild-table th { text-align: left; padding: 0.75rem 1rem; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color); white-space: nowrap; }
        .guild-table td { padding: 0.75rem 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.04); vertical-align: middle; }
        .guild-table tr:hover td { background: var(--bg-card-hover); }
        .guild-table tr:last-child td { border-bottom: none; }

        /* Global Ban expanded row styling */
        .gb-expand-row td { padding: 0 !important; border-bottom: 1px solid rgba(255,255,255,0.08) !important; }
        .gb-expand-row:hover td { background: transparent !important; }
        .gb-detail-panel { padding: 1rem 1.5rem 1.25rem; background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.06); }
        .gb-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .gb-detail-label { font-size: 0.7rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
        .gb-detail-value { font-size: 0.85rem; color: var(--text-primary); line-height: 1.5; word-break: break-word; }
        .gb-detail-value.mono { font-family: monospace; font-size: 0.8rem; }
        .gb-evidence-gallery { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
        .gb-evidence-gallery a { display: block; border-radius: 6px; overflow: hidden; border: 1px solid var(--border-color); transition: border-color 0.2s, transform 0.15s; }
        .gb-evidence-gallery a:hover { border-color: var(--accent-blue); transform: scale(1.05); }
        .gb-evidence-gallery img { width: 80px; height: 80px; object-fit: cover; display: block; }
        .gb-row-clickable { cursor: pointer; }
        .gb-row-clickable td:last-child { cursor: default; }
        .gb-sortable { cursor: pointer; user-select: none; white-space: nowrap; }
        .gb-sortable:hover { color: var(--accent-purple); }
        .gb-sort-icon { font-size: 0.65rem; margin-left: 3px; opacity: 0.3; transition: all 0.15s; }
        .gb-sort-icon.gb-sort-active { opacity: 1; color: var(--accent-purple); }
        .gb-chevron { transition: transform 0.2s; display: inline-block; color: var(--text-muted); font-size: 0.7rem; margin-right: 0.5rem; }
        .gb-chevron.open { transform: rotate(90deg); }
        .guild-info { display: flex; align-items: center; gap: 0.75rem; }
        .guild-icon { width: 36px; height: 36px; border-radius: 10px; object-fit: cover; background: rgba(255, 255, 255, 0.05); flex-shrink: 0; }
        .guild-icon-placeholder { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg, rgba(167, 139, 250, 0.2), rgba(96, 165, 250, 0.2)); display: flex; align-items: center; justify-content: center; font-size: 0.875rem; font-weight: 700; color: var(--accent-purple); flex-shrink: 0; }
        .guild-name { font-weight: 600; font-size: 0.9rem; white-space: nowrap; }
        .guild-id { font-size: 0.7rem; color: var(--text-muted); }
        .badge { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.625rem; border-radius: 50px; font-size: 0.7rem; font-weight: 600; white-space: nowrap; }
        .badge-owner { background: rgba(251, 191, 36, 0.15); color: var(--accent-yellow); }
        .badge-admin { background: rgba(167, 139, 250, 0.15); color: var(--accent-purple); }
        .badge-bot-yes { background: rgba(52, 211, 153, 0.15); color: var(--accent-green); }
        .badge-bot-no { background: rgba(255, 255, 255, 0.05); color: var(--text-muted); }
        .role-section-header td { padding: 0.75rem 1rem !important; background: var(--bg-card) !important; border-bottom: 1px solid var(--border-color) !important; }
        .role-section-header .section-label { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
        .btn-invite { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.875rem; border-radius: 8px; font-size: 0.8rem; font-weight: 600; text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; font-family: inherit; background: linear-gradient(135deg, #5865F2, #7289da); color: white; }
        .btn-invite:hover { transform: translateY(-1px); box-shadow: 0 4px 15px rgba(88, 101, 242, 0.3); }
        .btn-manage { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.875rem; border-radius: 8px; font-size: 0.8rem; font-weight: 600; text-decoration: none; transition: all 0.2s; cursor: pointer; border: 1px solid rgba(52, 211, 153, 0.3); font-family: inherit; background: rgba(52, 211, 153, 0.1); color: var(--accent-green); }
        .btn-manage:hover { background: rgba(52, 211, 153, 0.2); transform: translateY(-1px); }
        .guild-filter-bar { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
        .guild-filter-btn { padding: 0.4rem 0.875rem; border-radius: 50px; font-size: 0.75rem; font-weight: 600; cursor: pointer; border: 1px solid var(--border-color); background: transparent; color: var(--text-muted); transition: all 0.2s; font-family: inherit; }
        .guild-filter-btn.active { background: rgba(167, 139, 250, 0.15); border-color: rgba(167, 139, 250, 0.3); color: var(--accent-purple); }
        .guild-filter-btn:hover { border-color: var(--accent-purple); color: var(--text-secondary); }
        .guild-search { padding: 0.4rem 0.75rem; border-radius: 50px; font-size: 0.8rem; background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-color); color: var(--text-primary); font-family: inherit; width: 200px; transition: all 0.2s; }
        .guild-search:focus { outline: none; border-color: var(--accent-purple); }
        .guild-search::placeholder { color: var(--text-muted); }
        .guild-count { font-size: 0.75rem; color: var(--text-muted); margin-left: auto; }

        /* Empty State */
        .empty-state { text-align: center; padding: 2rem; color: var(--text-muted); }
        .empty-state i { font-size: 2rem; margin-bottom: 0.75rem; opacity: 0.4; }
        .hidden { display: none !important; }

        /* Footer */
        .footer { padding: clamp(2rem, 5vh, 3.5rem) 0; background: var(--bg-primary); border-top: 1px solid var(--border-color); text-align: center; margin-top: 3rem; }
        .footer .container { max-width: 1400px; margin: 0 auto; padding: 0 1.5rem; }
        .footer-links { display: flex; gap: clamp(1.25rem, 2.5vw, 2.5rem); justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
        .footer-link { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.3s ease; }
        .footer-link:hover { color: var(--accent-purple); }
        .footer-copyright { color: var(--text-muted); font-size: 0.85rem; }

        /* Mobile Menu */
        .mobile-menu-btn { display: none; background: none; border: none; color: var(--text-primary); font-size: 1.5rem; cursor: pointer; padding: 0.5rem; }
        .mobile-menu { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(11, 15, 17, 0.98); z-index: 9999; flex-direction: column; padding: 1.5rem; }
        .mobile-menu.open { display: flex; }
        .mobile-menu-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
        .mobile-menu-close { background: none; border: none; color: var(--text-primary); font-size: 1.5rem; cursor: pointer; padding: 0.5rem; }
        .mobile-menu-links { display: flex; flex-direction: column; gap: 0.5rem; }
        .mobile-menu-links a { color: var(--text-secondary); text-decoration: none; font-size: 1.1rem; font-weight: 500; padding: 1rem; border-radius: 10px; transition: all 0.2s; }
        .mobile-menu-links a:hover { background: var(--bg-card); color: var(--text-primary); }

        /* Section Nav */
        .section-nav { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 0.5rem; margin-bottom: 1.5rem; }
        .section-nav-inner { display: flex; gap: 0.25rem; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; }
        .section-nav-inner::-webkit-scrollbar { display: none; }
        .section-nav-btn { flex: 1; padding: 0.625rem 0.75rem; border-radius: 10px; font-size: 0.8rem; font-weight: 600; cursor: pointer; border: none; background: transparent; color: var(--text-muted); transition: all 0.2s; font-family: inherit; white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
        .section-nav-btn:hover { color: var(--text-secondary); background: rgba(255, 255, 255, 0.04); }
        .section-nav-btn.active { color: var(--text-primary); background: rgba(167, 139, 250, 0.15); border: 1px solid rgba(167, 139, 250, 0.25); box-shadow: 0 2px 8px rgba(167, 139, 250, 0.1); }
        .section-nav-btn .nav-badge { background: rgba(248, 113, 113, 0.2); color: var(--accent-red); font-size: 0.65rem; padding: 0.1rem 0.4rem; border-radius: 50px; font-weight: 700; min-width: 18px; text-align: center; }
        .section-nav-btn i { font-size: 0.8rem; }
        .admin-section { display: none; animation: fadeInSection 0.2s ease; }
        .admin-section.active { display: block; }
        @keyframes fadeInSection { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

        @media (max-width: 768px) {
            .navbar-links { display: none; }
            .mobile-menu-btn { display: block; }
            main { padding: 90px 1rem 3rem; }
            .page-header { flex-direction: column; align-items: flex-start; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .input-group { flex-direction: column; }
            .input-group .btn { width: 100%; }
            .footer-links { flex-direction: column; gap: 0.75rem; }
            .section-nav-btn { padding: 0.5rem 0.5rem; font-size: 0.7rem; gap: 0.35rem; }
            .section-nav-btn .nav-label { display: none; }
            .section-nav-btn i { font-size: 0.9rem; }
            #gb-stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
        }
    </style>
</head>
<body>
    <div class="bg-effects"><div class="orb orb-1"></div><div class="orb orb-2"></div></div>

    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-brand">
                <img src="/images/CertiFried.png" alt="CertiFried" class="navbar-logo">
                <span>CertiFried</span>
            </a>
            <div class="navbar-links">
                <a href="/">Home</a>
                <a href="/servers">Servers</a>
                <a href="/commands">Commands</a>
                <a href="/status">Status</a>
            </div>
            <% if (user) { %>
                <div class="user-menu-container" id="userMenuContainer">
                    <div class="user-menu" id="userMenuBtn">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="Avatar" class="user-avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                        <span class="user-name"><%= user.username %></span>
                        <i class="fas fa-chevron-down user-menu-chevron"></i>
                    </div>
                    <div class="user-dropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-user-info">Signed in as <strong><%= user.username %></strong></div>
                        </div>
                        <a href="/profile" class="dropdown-item">
                            <i class="fas fa-user"></i>
                            <span>Profile</span>
                        </a>
                        <a href="/servers" class="dropdown-item">
                            <i class="fas fa-server"></i>
                            <span>My Servers</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="/bot-management" class="dropdown-item text-warning">
                            <i class="fas fa-robot"></i>
                            <span>Bot Management</span>
                        </a>
                        <a href="/super-admin" class="dropdown-item text-warning">
                            <i class="fas fa-shield-alt"></i>
                            <span>Super Admin</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Log Out</span>
                        </a>
                    </div>
                </div>
            <% } %>
            <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <div class="mobile-menu" id="mobile-menu">
        <div class="mobile-menu-header">
            <a href="/" class="navbar-brand">
                <img src="/images/CertiFried.png" alt="CertiFried" class="navbar-logo">
                <span>CertiFried</span>
            </a>
            <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="mobile-menu-links">
            <a href="/">Home</a>
            <a href="/servers">Servers</a>
            <a href="/commands">Commands</a>
            <a href="/status">Status</a>
            <% if (user) { %>
                <a href="/profile">Profile</a>
            <% } %>
        </div>
    </div>

    <main>
    <div class="container">
        <div class="page-header">
            <div class="page-header-content">
                <div class="page-icon"><i class="fas fa-user-shield"></i></div>
                <div>
                    <h1 class="page-title">Super Admin Panel</h1>
                    <p class="page-subtitle">Global system management and control center</p>
                </div>
            </div>
            <span class="admin-badge"><i class="fas fa-shield-alt"></i> Admin Access</span>
        </div>

        <!-- Stats Grid -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-server" style="color: var(--accent-purple)"></i></div>
                <div class="stat-value" id="total-guilds">...</div>
                <div class="stat-label">Total Guilds</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-robot" style="color: #a78bfa"></i></div>
                <div class="stat-value" id="custom-bots">...</div>
                <div class="stat-label">Custom Bots</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users-cog" style="color: var(--accent-green)"></i></div>
                <div class="stat-value" id="bot-creators">...</div>
                <div class="stat-label">Bot Creators</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-users" style="color: var(--accent-blue)"></i></div>
                <div class="stat-value" id="total-users">...</div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-video" style="color: var(--accent-red)"></i></div>
                <div class="stat-value" id="live-streamers">...</div>
                <div class="stat-label">Live Streamers</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-clock" style="color: var(--accent-green)"></i></div>
                <div class="stat-value" id="bot-uptime">...</div>
                <div class="stat-label">Bot Uptime</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-memory" style="color: var(--accent-yellow)"></i></div>
                <div class="stat-value" id="memory-usage">...</div>
                <div class="stat-label">Memory Usage</div>
            </div>
        </div>

        <!-- Section Navigation -->
        <div class="section-nav">
            <div class="section-nav-inner">
                <button class="section-nav-btn active" data-section="guilds" onclick="switchSection('guilds', this)"><i class="fas fa-server"></i> <span class="nav-label">Guilds</span></button>
                <button class="section-nav-btn" data-section="system" onclick="switchSection('system', this)"><i class="fas fa-cogs"></i> <span class="nav-label">System</span></button>
                <button class="section-nav-btn" data-section="users" onclick="switchSection('users', this)"><i class="fas fa-users-cog"></i> <span class="nav-label">Users</span></button>
                <button class="section-nav-btn" data-section="bots" onclick="switchSection('bots', this)"><i class="fas fa-robot"></i> <span class="nav-label">Bots</span></button>
                <button class="section-nav-btn" data-section="globalbans" onclick="switchSection('globalbans', this)"><i class="fas fa-globe"></i> <span class="nav-label">Global Bans</span> <span class="nav-badge" id="gb-nav-badge" style="display:none;">0</span></button>
                <button class="section-nav-btn" data-section="stats" onclick="switchSection('stats', this)"><i class="fas fa-chart-bar"></i> <span class="nav-label">Stats</span></button>
            </div>
        </div>

        <!-- Guilds Section -->
        <div id="section-guilds" class="admin-section active">
        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <div class="card-title">
                    <div class="card-title-icon" style="background: rgba(88, 101, 242, 0.15);"><i class="fas fa-server" style="color: #5865F2"></i></div>
                    <span>My Guilds</span>
                </div>
                <div class="guild-filter-bar">
                    <input type="text" class="guild-search" id="guild-search" placeholder="Search guilds...">
                    <button class="guild-filter-btn active" data-filter="all" onclick="filterGuilds('all', this)">All</button>
                    <button class="guild-filter-btn" data-filter="owner" onclick="filterGuilds('owner', this)">Owner</button>
                    <button class="guild-filter-btn" data-filter="admin" onclick="filterGuilds('admin', this)">Admin</button>
                    <button class="guild-filter-btn" data-filter="with-bot" onclick="filterGuilds('with-bot', this)">With Bot</button>
                    <button class="guild-filter-btn" data-filter="without-bot" onclick="filterGuilds('without-bot', this)">Without Bot</button>
                    <button class="btn-ghost btn-sm" id="refresh-guilds-btn" style="padding:0.4rem 0.75rem;border-radius:50px;font-size:0.75rem;font-weight:600;cursor:pointer;border:1px solid var(--border-color);background:transparent;color:var(--text-muted);transition:all 0.2s;font-family:inherit;" title="Refresh guild list from Discord"><i class="fas fa-sync-alt"></i></button>
                    <span class="guild-count" id="guild-count"></span>
                </div>
            </div>
            <div class="card-body" style="padding: 0;">
                <div class="guild-table-wrapper">
                    <table class="guild-table">
                        <thead>
                            <tr>
                                <th>Server</th>
                                <th>Role</th>
                                <th>Members</th>
                                <th>Bot Status</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="guild-table-body">
                            <tr><td colspan="5"><div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading guilds...</p></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        </div><!-- /#section-guilds -->

        <!-- System Section -->
        <div id="section-system" class="admin-section">
        <h2 class="section-title"><i class="fas fa-cogs" style="color: var(--accent-yellow)"></i> System Actions</h2>
        <div class="grid-2">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <div class="card-title-icon" style="background: rgba(251, 191, 36, 0.15);"><i class="fas fa-cogs" style="color: var(--accent-yellow)"></i></div>
                        <span>System Actions</span>
                    </div>
                </div>
                <div class="card-body">
                    <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">Perform global operations on the bot system. Use with caution.</p>
                    <button class="btn btn-warning" style="margin-bottom: 0.75rem;" id="reinitialize-bot-btn">
                        <i class="fas fa-sync-alt"></i> Re-initialize Bot (Global)
                    </button>
                    <button class="btn btn-danger" id="reset-database-btn">
                        <i class="fas fa-trash"></i> Reset Database
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <div class="card-title-icon" style="background: rgba(167, 139, 250, 0.15);"><i class="fas fa-server" style="color: var(--accent-purple)"></i></div>
                        <span>Guild-Specific Actions</span>
                    </div>
                </div>
                <div class="card-body">
                    <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">Perform operations on a specific guild using its ID.</p>
                    <div class="input-group">
                        <input type="text" class="input" id="guild-id-input" placeholder="Enter Guild ID...">
                        <button class="btn btn-primary btn-sm" id="reinitialize-guild-btn"><i class="fas fa-sync"></i> Re-init</button>
                    </div>
                    <div class="input-group">
                        <input type="text" class="input" id="leave-guild-id-input" placeholder="Enter Guild ID...">
                        <button class="btn btn-danger btn-sm" id="leave-guild-btn"><i class="fas fa-sign-out-alt"></i> Leave</button>
                    </div>
                </div>
            </div>
        </div>

        </div><!-- /#section-system -->

        <!-- Users Section -->
        <div id="section-users" class="admin-section">
        <h2 class="section-title"><i class="fas fa-users-cog"></i> Smart User Management</h2>
        <div class="grid-3">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <div class="card-title-icon" style="background: rgba(167, 139, 250, 0.15);"><i class="fas fa-search" style="color: var(--accent-purple)"></i></div>
                        <span>Audit Users</span>
                    </div>
                </div>
                <div class="card-body">
                    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 1rem;">Scan all guilds to find and link Discord users to their streamer profiles.</p>
                    <button class="btn btn-primary" id="audit-users-btn"><i class="fas fa-search"></i> Run Full Audit</button>
                    <div id="audit-progress" class="progress-container hidden">
                        <div class="progress-header">
                            <span id="audit-status">Initializing...</span>
                            <span id="audit-percentage">0%</span>
                        </div>
                        <div class="progress-bar"><div class="progress-fill" id="audit-progress-bar" style="width: 0%"></div></div>
                        <div class="progress-messages" id="audit-messages"></div>
                    </div>
                    <div id="audit-results" class="results-container hidden">
                        <div class="results-grid">
                            <div class="result-item"><span class="result-label">Guilds:</span><span class="result-value" id="audit-guilds">-</span></div>
                            <div class="result-item"><span class="result-label">Members:</span><span class="result-value" id="audit-members">-</span></div>
                            <div class="result-item"><span class="result-label">Exact:</span><span class="result-value" id="audit-exact">-</span></div>
                            <div class="result-item"><span class="result-label">Fuzzy:</span><span class="result-value" id="audit-fuzzy">-</span></div>
                            <div class="result-item"><span class="result-label">New Links:</span><span class="result-value" id="audit-new-links">-</span></div>
                            <div class="result-item"><span class="result-label">Existing:</span><span class="result-value" id="audit-existing">-</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <div class="card-title-icon" style="background: rgba(167, 139, 250, 0.15);"><i class="fas fa-user-search" style="color: var(--accent-purple)"></i></div>
                        <span>Search Streamer</span>
                    </div>
                </div>
                <div class="card-body">
                    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 1rem;">Find all platforms and Discord users linked to a specific streamer.</p>
                    <input type="text" class="input" style="margin-bottom: 0.75rem;" id="search-streamer-input" placeholder="Enter streamer username...">
                    <select class="input" style="margin-bottom: 0.75rem;" id="search-platform-select">
                        <option value="">All Platforms</option>
                        <option value="twitch">Twitch</option>
                        <option value="kick">Kick</option>
                        <option value="youtube">YouTube</option>
                        <option value="tiktok">TikTok</option>
                        <option value="trovo">Trovo</option>
                        <option value="facebook">Facebook</option>
                        <option value="instagram">Instagram</option>
                    </select>
                    <button class="btn btn-primary" id="search-streamer-btn"><i class="fas fa-search"></i> Search</button>
                    <div id="search-results" class="results-container hidden"><div id="search-results-content"></div></div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="card-title">
                        <div class="card-title-icon" style="background: rgba(167, 139, 250, 0.15);"><i class="fas fa-link" style="color: var(--accent-purple)"></i></div>
                        <span>View User Links</span>
                    </div>
                </div>
                <div class="card-body">
                    <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 1rem;">Display all streamers linked to a specific Discord user.</p>
                    <input type="text" class="input" style="margin-bottom: 0.75rem;" id="user-id-input" placeholder="Enter Discord User ID...">
                    <button class="btn btn-primary" id="view-links-btn"><i class="fas fa-link"></i> View Links</button>
                    <div id="links-results" class="results-container hidden"><div id="links-results-content"></div></div>
                </div>
            </div>
        </div>

        </div><!-- /#section-users -->

        <!-- Bots Section -->
        <div id="section-bots" class="admin-section">
        <h2 class="section-title"><i class="fas fa-robot" style="color: #a78bfa"></i> Bot Management</h2>

        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-user-shield" style="color: var(--accent-purple)"></i> Bot Managers</div>
                <button class="btn btn-primary btn-sm" onclick="document.getElementById('add-manager-modal').classList.add('show')"><i class="fas fa-plus"></i> Add Manager</button>
            </div>
            <div class="card-body" id="bot-managers-list">
                <div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading managers...</p></div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 2rem;">
            <div class="card-header">
                <div class="card-title"><i class="fas fa-robot" style="color: var(--accent-purple)"></i> All Custom Bots</div>
                <button class="btn btn-ghost btn-sm" onclick="loadAllBots()"><i class="fas fa-refresh"></i> Refresh</button>
            </div>
            <div class="card-body" id="all-bots-list">
                <div class="empty-state"><i class="fas fa-spinner fa-spin"></i><p>Loading bots...</p></div>
            </div>
        </div>

        </div><!-- /#section-bots -->

        <!-- Global Bans Section -->
        <div id="section-globalbans" class="admin-section">
        <h2 class="section-title"><i class="fas fa-globe" style="color: var(--accent-red)"></i> Global Ban Management</h2>

        <!-- Global Ban Stats -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem;" id="gb-stats-grid">
            <div class="card" style="margin-bottom: 0;">
                <div class="card-body" style="text-align: center; padding: 1rem;">
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-red);" id="gb-stat-entries">0</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Active Entries</div>
                </div>
            </div>
            <div class="card" style="margin-bottom: 0;">
                <div class="card-body" style="text-align: center; padding: 1rem;">
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-yellow);" id="gb-stat-reports">0</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Pending Reports</div>
                </div>
            </div>
            <div class="card" style="margin-bottom: 0;">
                <div class="card-body" style="text-align: center; padding: 1rem;">
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-blue);" id="gb-stat-appeals">0</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Pending Appeals</div>
                </div>
            </div>
            <div class="card" style="margin-bottom: 0;">
                <div class="card-body" style="text-align: center; padding: 1rem;">
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--accent-green);" id="gb-stat-guilds">0</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">Enabled Guilds</div>
                </div>
            </div>
        </div>

        <!-- Global Ban Tabs -->
        <div class="card" style="margin-bottom: 1.5rem;">
            <div class="card-header">
                <div style="display: flex; gap: 0.5rem;">
                    <button class="guild-filter-btn active" onclick="switchGBTab('entries', this)">Ban Entries</button>
                    <button class="guild-filter-btn" onclick="switchGBTab('reports', this)">Reports</button>
                    <button class="guild-filter-btn" onclick="switchGBTab('appeals', this)">Appeals</button>
                    <button class="guild-filter-btn" onclick="switchGBTab('action-log', this)">Action Log</button>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button class="btn btn-primary btn-sm" id="gb-add-entry-btn" onclick="document.getElementById('gb-entry-modal').classList.add('show')"><i class="fas fa-plus"></i> Add Entry</button>
                    <button class="btn btn-ghost btn-sm" id="gb-import-csv-btn" onclick="document.getElementById('gb-csv-modal').classList.add('show')"><i class="fas fa-file-csv"></i> Import CSV</button>
                </div>
            </div>
            <div class="card-body">
                <!-- Entries Tab -->
                <div id="gb-tab-entries">
