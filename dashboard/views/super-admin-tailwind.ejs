    <script>
    // Guild list state
    let allGuilds = [];
    let currentFilter = 'all';
    let botClientId = '';

    // Deploy modal state
    let deployGuildId = '';
    let deployGuildName = '';

    document.addEventListener('DOMContentLoaded', () => {
        loadStats();
        loadMyGuilds(); // Use passport login data directly — no refresh overwrite
        loadGBStats();
        loadGBEntries();
        setInterval(loadStats, 30000);
        // setInterval(refreshAndLoadGuilds, 60000); // disabled to preserve login permissions
        setInterval(loadGBStats, 60000);

        // Guild search handler
        document.getElementById('guild-search').addEventListener('input', renderGuilds);

        // Refresh guilds button
        document.getElementById('refresh-guilds-btn').addEventListener('click', function() {
            refreshAndLoadGuilds(this);
        });

        // Owner tools (dashboard/routes/super-admin.js). These three called routes that did not
        // exist until 2026-11-18; Re-initialize bot, Reset database, Re-init guild and Run full
        // audit had no route at all and were removed.
        document.getElementById('sa-leave-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const input = document.getElementById('leave-guild-id-input');
            const guildId = input.value.trim();
            if (!/^\d{17,20}$/.test(guildId)) return saToast('Enter a server ID (17-20 digits).', 'bad');
            const known = allGuilds.concat(allBotOnlyGuilds).find(g => g.id === guildId);
            if (!confirm('Make every CertiFried bot leave ' + (known ? known.name : 'server ' + guildId) + '? Inviting it back is the only undo.')) return;
            const btn = document.getElementById('leave-guild-btn');
            btn.disabled = true;
            try {
                const d = await saApi('/api/admin/leave-guild', { method: 'POST', body: JSON.stringify({ guildId }) });
                saToast(d.message || 'Left the server.', 'ok');
                input.value = '';
                loadMyGuilds();
            } catch (err) { saToast(err.message, 'bad'); }
            finally { btn.disabled = false; }
        });

        document.getElementById('sa-streamer-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const username = document.getElementById('search-streamer-input').value.trim();
            const platform = document.getElementById('search-platform-select').value;
            const out = document.getElementById('search-results-content');
            const btn = document.getElementById('search-streamer-btn');
            btn.disabled = true;
            try {
                const d = await saApi('/api/admin/search-streamer', { method: 'POST', body: JSON.stringify({ username, platform }) });
                if (!d.matches.length) { out.replaceChildren(saEl('div', { class: 'cf-state cf-state--compact' }, [saEl('p', { class: 'cf-state-title', text: 'No tracked streamer matches.' })])); return; }
                out.replaceChildren(...d.matches.map(m => saEl('div', { class: 'cf-list-item cf-list-item--multi' }, [
                    saEl('div', { class: 'cf-list-main' }, [
                        saEl('p', { class: 'cf-list-title' }, [saEl('span', { text: m.streamerUsername }), saEl('span', { class: 'cf-pill', text: m.platform })]),
                        saEl('p', { class: 'cf-list-meta' }, [
                            saEl('span', { text: m.discordUserId ? 'Discord: ' + (m.discordUsername || 'unknown') + ' (' + m.discordUserId + ')' : 'Not linked to a Discord account' }),
                            saEl('span', { text: m.guilds.length + (m.guilds.length === 1 ? ' server follows' : ' servers follow') }),
                        ]),
                        m.guilds.length ? saEl('div', { class: 'cf-chips' }, m.guilds.slice(0, 12).map(g => saEl('span', { class: 'cf-chip', title: g.id, text: g.name || g.id }))) : null,
                    ]),
                ])));
            } catch (err) { saToast(err.message, 'bad'); }
            finally { btn.disabled = false; }
        });

        document.getElementById('sa-links-form').addEventListener('submit', async function (e) {
            e.preventDefault();
            const userId = document.getElementById('user-id-input').value.trim();
            const out = document.getElementById('links-results-content');
            const btn = document.getElementById('view-links-btn');
            btn.disabled = true;
            try {
                const d = await saApi('/api/admin/view-links', { method: 'POST', body: JSON.stringify({ userId }) });
                if (!d.links.length) { out.replaceChildren(saEl('div', { class: 'cf-state cf-state--compact' }, [saEl('p', { class: 'cf-state-title', text: 'Nothing is linked to that account.' })])); return; }
                out.replaceChildren(...d.links.map(l => saEl('div', { class: 'cf-list-item' }, [
                    saEl('div', { class: 'cf-list-main' }, [
                        saEl('span', { class: 'cf-em', text: l.streamer_username }), ' ',
                        saEl('span', { class: 'cf-pill', text: l.platform }), ' ',
                        saEl('span', { class: 'cf-muted', text: l.kind === 'profile'
                            ? 'Streamer profile · ' + l.servers + (l.servers === 1 ? ' server' : ' servers')
                            : 'Member link in ' + (l.guild_name || l.guild_id) + (l.source ? ' · ' + l.source : '') }),
                    ]),
                ])));
            } catch (err) { saToast(err.message, 'bad'); }
            finally { btn.disabled = false; }
        });
    });

    // Small helpers for the owner tools.
    function saEl(tag, attrs, kids) {
        const el = document.createElement(tag);
        Object.entries(attrs || {}).forEach(([k, v]) => { if (v == null) return; if (k === 'class') el.className = v; else if (k === 'text') el.textContent = v; else el.setAttribute(k, v); });
        (kids || []).forEach(c => { if (c != null) el.append(c); });
        return el;
    }
    function saToast(text, tone) { if (window.cfSite) window.cfSite.toast(text, tone); else alert(text); }
    async function saApi(url, opts) {
        const r = await fetch(url, Object.assign({ headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' } }, opts || {}));
        let d = {};
        try { d = await r.json(); } catch (e) { throw new Error(r.status === 401 ? 'Your session expired. Reload the page.' : 'Unexpected response (' + r.status + ').'); }
        if (!r.ok || d.success === false) throw new Error(d.error || ('Request failed (' + r.status + ')'));
        return d;
    }

    // ─── Deploy Bot Modal Functions ─────────────────────────────

    function openDeployModal(guildId, guildName) {
        deployGuildId = guildId;
        deployGuildName = guildName;
        document.getElementById('deploy-guild-name').textContent = guildName;
        document.getElementById('deploy-status').style.display = 'none';
        document.getElementById('deploy-new-name').value = '';
        document.getElementById('deploy-new-token').value = '';
        switchDeployTab('existing');
        loadAvailableBots();
        document.getElementById('deploy-bot-modal').classList.add('show');
    }

    function closeDeployModal() {
        document.getElementById('deploy-bot-modal').classList.remove('show');
        deployGuildId = '';
        deployGuildName = '';
    }

    // Close modal on backdrop click
    document.getElementById('deploy-bot-modal').addEventListener('click', function(e) {
        if (e.target === this) closeDeployModal();
    });

    function switchDeployTab(tab) {
        document.getElementById('deploy-existing-tab').style.display = tab === 'existing' ? 'block' : 'none';
        document.getElementById('deploy-new-tab').style.display = tab === 'new' ? 'block' : 'none';
        document.getElementById('tab-existing').classList.toggle('active', tab === 'existing');
        document.getElementById('tab-new').classList.toggle('active', tab === 'new');
    }

    async function loadAvailableBots() {
        const select = document.getElementById('deploy-bot-select');
        select.replaceChildren();
        const loadingOpt = document.createElement('option');
        loadingOpt.value = '';
        loadingOpt.textContent = 'Loading...';
        select.appendChild(loadingOpt);

        try {
            const r = await fetch('/api/super-admin/all-bots');
            const d = await r.json();
            select.replaceChildren();

            if (d.success && d.bots && d.bots.length > 0) {
                const approvedBots = d.bots.filter(b => b.approved !== 0 && b.enabled !== 0);
                if (approvedBots.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = 'No approved bots available';
                    select.appendChild(opt);
                    return;
                }
                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '-- Select a bot --';
                select.appendChild(placeholder);
                approvedBots.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.bot_id;
                    opt.textContent = (b.username || b.bot_name || 'Unknown') + ' (' + (b.status || 'unknown') + ')';
                    select.appendChild(opt);
                });
            } else {
                const opt = document.createElement('option');
                opt.value = '';
                opt.textContent = 'No custom bots registered';
                select.appendChild(opt);
            }
        } catch (e) {
            select.replaceChildren();
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = 'Error loading bots';
            select.appendChild(opt);
        }
    }

    async function deployExistingBot() {
        const botId = document.getElementById('deploy-bot-select').value;
        if (!botId) return showDeployStatus('Please select a bot', 'error');
        if (!deployGuildId) return showDeployStatus('No guild selected', 'error');

        const btn = document.getElementById('deploy-existing-btn');
        btn.disabled = true;
        btn.textContent = 'Deploying...';
        showDeployStatus('Assigning bot to guild...', 'info');

        try {
            const r = await fetch('/api/super-admin/deploy-existing-bot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botId, guildId: deployGuildId })
            });
            const d = await r.json();
            if (d.success) {
                showDeployStatus('Bot assigned! Opening invite link...', 'success');
                window.open(d.inviteUrl, '_blank');
                setTimeout(function() {
                    closeDeployModal();
                    loadMyGuilds();
                }, 1500);
            } else {
                showDeployStatus(d.error || 'Failed to deploy bot', 'error');
            }
        } catch (e) {
            showDeployStatus('Network error. Please try again.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '';
            const icon = document.createElement('i');
            icon.className = 'fas fa-rocket';
            btn.appendChild(icon);
            btn.append(' Deploy & Invite');
        }
    }

    async function deployNewBot() {
        const botName = document.getElementById('deploy-new-name').value.trim();
        const botToken = document.getElementById('deploy-new-token').value.trim();
        if (!botName) return showDeployStatus('Please enter a bot name', 'error');
        if (!botToken) return showDeployStatus('Please enter a bot token', 'error');
        if (!deployGuildId) return showDeployStatus('No guild selected', 'error');

        const btn = document.getElementById('deploy-new-btn');
        btn.disabled = true;
        btn.textContent = 'Validating & Registering...';
        showDeployStatus('Validating bot token... this may take up to 30 seconds.', 'info');

        try {
            const r = await fetch('/api/super-admin/deploy-new-bot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ botName, botToken, guildId: deployGuildId })
            });
            const d = await r.json();
            if (d.success) {
                showDeployStatus('Bot registered and assigned! Opening invite link...', 'success');
                window.open(d.inviteUrl, '_blank');
                setTimeout(function() {
                    closeDeployModal();
                    loadMyGuilds();
                    loadStats();
                }, 1500);
            } else {
                showDeployStatus(d.error || 'Failed to register bot', 'error');
            }
        } catch (e) {
            showDeployStatus('Network error. Please try again.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = '';
            const icon = document.createElement('i');
            icon.className = 'fas fa-plus';
            btn.appendChild(icon);
            btn.append(' Register & Deploy');
        }
    }

    function showDeployStatus(message, type) {
        const el = document.getElementById('deploy-status');
        el.style.display = 'block';
        var colors = { error: 'var(--accent-red)', success: 'var(--accent-green)', info: 'var(--accent-blue)' };
        var icons = { error: 'fa-exclamation-circle', success: 'fa-check-circle', info: 'fa-info-circle' };
        el.replaceChildren();
        var wrapper = document.createElement('div');
        wrapper.style.cssText = 'padding:0.625rem;border-radius:8px;font-size:0.8rem;background:color-mix(in srgb, var(--cf-text) 3%, transparent);border:1px solid color-mix(in srgb, ' + colors[type] + ' 19%, transparent);color:' + colors[type];
        var icon = document.createElement('i');
        icon.className = 'fas ' + icons[type];
        wrapper.appendChild(icon);
        wrapper.append(' ' + message);
        el.appendChild(wrapper);
    }

    // ─── Guild List Functions ────────────────────────────────────

    async function refreshAndLoadGuilds(btn) {
        if (btn && btn instanceof HTMLElement) {
            const icon = btn.querySelector('i');
            if (icon) icon.classList.add('fa-spin');
        }
        try {
            const resp = await fetch('/api/super-admin/refresh-guilds', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            if (resp.status === 401) {
                showTokenExpiredBanner();
            } else if (resp.ok) {
                hideTokenExpiredBanner();
            }
        } catch (e) { /* network error — fall back to cached session data */ }
        await loadMyGuilds();
        if (btn && btn instanceof HTMLElement) {
            const icon = btn.querySelector('i');
            if (icon) icon.classList.remove('fa-spin');
        }
    }

    function showTokenExpiredBanner() {
        if (document.getElementById('token-expired-banner')) return;
        const banner = document.createElement('div');
        banner.id = 'token-expired-banner';
        banner.style.cssText = 'background:color-mix(in srgb, var(--cf-warning) 15%, transparent);border:1px solid color-mix(in srgb, var(--cf-warning) 40%, transparent);border-radius:12px;padding:1rem 1.5rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem;color:var(--cf-warning-ink);font-size:0.9rem;';
        const icon = document.createElement('i');
        icon.className = 'fas fa-exclamation-triangle';
        const span = document.createElement('span');
        span.textContent = 'Your Discord session has expired. Guild list may be incomplete. ';
        const link = document.createElement('a');
        link.href = '/auth/discord';
        link.style.cssText = 'color:var(--cf-warning-ink);text-decoration:underline;font-weight:600;';
        link.textContent = 'Re-login to refresh';
        span.appendChild(link);
        banner.appendChild(icon);
        banner.appendChild(span);
        const guildSection = document.getElementById('guild-table-body')?.closest('.card');
        if (guildSection) guildSection.parentNode.insertBefore(banner, guildSection);
    }

    function hideTokenExpiredBanner() {
        const banner = document.getElementById('token-expired-banner');
        if (banner) banner.remove();
    }

    let allBotOnlyGuilds = [];

    async function loadMyGuilds() {
        try {
            // Primary guild list — must succeed
            const r = await fetch('/api/super-admin/my-guilds');
            const d = await r.json();
            if (d.success) {
                allGuilds = d.guilds;
                botClientId = d.botClientId;
                console.log('[Guild Debug] Loaded', allGuilds.length, 'guilds. withBot:', d.withBot, 'withoutBot:', d.withoutBot);
                if (allGuilds.length > 0) console.log('[Guild Debug] Sample guild:', JSON.stringify(allGuilds[0]));
            } else {
                console.error('[Guild Debug] my-guilds failed:', JSON.stringify(d));
            }

            // Bot-only guilds — non-blocking; failure shouldn't break the main list
            try {
                const r2 = await fetch('/api/super-admin/bot-only-guilds');
                const d2 = await r2.json();
                if (d2.success) {
                    allBotOnlyGuilds = d2.guilds;
                    // Merge guilds that OAuth missed but bot confirms admin/owner
                    if (d2.missingFromMyGuilds && d2.missingFromMyGuilds.length > 0) {
                        allGuilds = allGuilds.concat(d2.missingFromMyGuilds);
                        // Re-sort: Owner first, then Admin; within each, bot present first, then alphabetically
                        allGuilds.sort(function(a, b) {
                            if (a.rolePriority !== b.rolePriority) return a.rolePriority - b.rolePriority;
                            if (a.botPresent !== b.botPresent) return a.botPresent ? -1 : 1;
                            return a.name.localeCompare(b.name);
                        });
                    }
                }
            } catch (e2) {
                console.warn('bot-only-guilds fetch failed, showing main list only:', e2);
                allBotOnlyGuilds = [];
            }

            renderGuilds();
        } catch(e) {
            const errTd = document.createElement('td');
            errTd.colSpan = 5;
            errTd.textContent = 'Error loading guilds';
            errTd.style.cssText = 'text-align:center;padding:2rem;color:var(--accent-red)';
            const errTr = document.createElement('tr');
            errTr.appendChild(errTd);
            const tbody = document.getElementById('guild-table-body');
            tbody.replaceChildren(errTr);
        }
    }

    function filterGuilds(filter, btn) {
        currentFilter = filter;
        document.querySelectorAll('#guild-filters .guild-filter-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        renderGuilds();
    }

