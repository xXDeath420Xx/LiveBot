                } else if (g.roleCategory === 'Administrator') {
                    roleBadge.className = 'badge badge-admin';
                    roleIcon.className = 'fas fa-shield-alt';
                    roleBadge.appendChild(roleIcon);
                    roleBadge.append(' Administrator');
