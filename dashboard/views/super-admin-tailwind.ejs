<%#
  /super-admin — the owner console (super-admin only; dashboard/server.js checks isSuperAdmin).
  Sections switched in place: Servers (#guilds), Global bans (#globalbans), Greenhouse game (#greenhouse), Tools (#tools).
  The other console pages share partials/site/_owner-nav.ejs. APIs: dashboard/routes/super-admin.js.
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: ('Owner console') + ' · CertiFried', noindex: true }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
    <link rel="stylesheet" href="/css/super-admin-console.css">
</head>
<body class="cfs-body cf-site">
<%- include('partials/site-header', { user }) %>
<main id="main-content" class="cf-main sa" tabindex="-1">
<div class="cf-page is-wide">
    <%- include('partials/site/_owner-nav', { ownerActive: 'overview' }) %>

    <div class="cf-page-head">
        <div class="cf-page-icon"><i class="fas fa-shield-halved" aria-hidden="true"></i></div>
        <div>
            <h1 class="cf-page-title">Owner console</h1>
            <p class="cf-page-sub">The whole network: servers, custom bots, global bans and owner tools.</p>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="Network at a glance">
        <div class="cf-kpi"><dt>Servers</dt><dd class="cf-kpi-value" id="total-guilds">–</dd></div>
        <div class="cf-kpi"><dt>Members</dt><dd class="cf-kpi-value" id="total-users">–</dd></div>
        <div class="cf-kpi"><dt>Custom bots</dt><dd class="cf-kpi-value" id="custom-bots">–</dd><dd class="cf-kpi-sub" id="custom-bots-sub"></dd></div>
        <div class="cf-kpi"><dt>Bot creators</dt><dd class="cf-kpi-value" id="bot-creators">–</dd></div>
        <div class="cf-kpi"><dt>Live now</dt><dd class="cf-kpi-value" id="live-streamers">–</dd></div>
        <div class="cf-kpi"><dt>Uptime</dt><dd class="cf-kpi-value" id="bot-uptime">–</dd></div>
        <div class="cf-kpi"><dt>Memory</dt><dd class="cf-kpi-value" id="memory-usage">–</dd></div>
    </dl>

        <!-- Guilds Section -->
        <div id="section-guilds" class="admin-section active">
        <section class="cf-section" aria-labelledby="sa-servers-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sa-servers-title">Servers</h2>
                    <p class="cf-section-desc">Servers you are in, your role there and whether a bot serves them. "Bot only" lists servers a bot is in that you are not.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-secondary btn-sm" id="refresh-guilds-btn" title="Fetch your server list from Discord again"><i class="fas fa-rotate" aria-hidden="true"></i> Refresh</button>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-toolbar guild-filter-bar">
                    <label class="cf-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="guild-search" placeholder="Search by name or ID" aria-label="Search servers"></label>
                    <div class="cf-segmented" role="group" aria-label="Filter servers" id="guild-filters">
                        <button type="button" class="guild-filter-btn active" aria-pressed="true" data-filter="all" onclick="filterGuilds('all', this)">All</button>
                        <button type="button" class="guild-filter-btn" aria-pressed="false" data-filter="owner" onclick="filterGuilds('owner', this)">Owner</button>
                        <button type="button" class="guild-filter-btn" aria-pressed="false" data-filter="admin" onclick="filterGuilds('admin', this)">Admin</button>
                        <button type="button" class="guild-filter-btn" aria-pressed="false" data-filter="with-bot" onclick="filterGuilds('with-bot', this)">With a bot</button>
                        <button type="button" class="guild-filter-btn" aria-pressed="false" data-filter="without-bot" onclick="filterGuilds('without-bot', this)">Without</button>
                        <button type="button" class="guild-filter-btn" aria-pressed="false" data-filter="bot-only" onclick="filterGuilds('bot-only', this)">Bot only</button>
                    </div>
                    <span class="cf-toolbar-end guild-count" id="guild-count"></span>
                </div>
                <div class="cf-table-wrap sa-table-wrap">
                    <table class="cf-table guild-table">
                        <thead>
                            <tr>
                                <th>Server</th>
                                <th>Your role</th>
                                <th>Members</th>
                                <th>Bot</th>
                                <th class="cf-cell-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="guild-table-body">
                            <tr><td colspan="5"><div class="empty-state"><span class="cf-spinner" aria-hidden="true"></span><p>Loading servers</p></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
        </div><!-- /#section-guilds -->

        <!-- Tools Section -->
        <div id="section-tools" class="admin-section">
        <section class="cf-section" aria-labelledby="sa-leave-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sa-leave-title">Remove the bots from a server</h2>
                    <p class="cf-section-desc">Every one of our bots in that server leaves it. Its settings stay in the database.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form class="cf-row" id="sa-leave-form">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="leave-guild-id-input">Server ID</label>
                        <p class="cf-row-desc">Right-click the server in Discord, Copy Server ID.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-group">
                            <input type="text" id="leave-guild-id-input" inputmode="numeric" pattern="\d{17,20}" maxlength="20" placeholder="123456789012345678" autocomplete="off" required>
                            <button type="submit" class="btn btn-danger btn-sm" id="leave-guild-btn">Leave</button>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="sa-streamer-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sa-streamer-title">Find a streamer</h2>
                    <p class="cf-section-desc">Tracked streamer profiles matching a name, the Discord account each is linked to, and the servers that follow them.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form class="cf-row" id="sa-streamer-form">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="search-streamer-input">Streamer name</label>
                        <p class="cf-row-desc">Part of the name is enough.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-group">
                            <input type="text" id="search-streamer-input" minlength="2" maxlength="64" placeholder="Name" autocomplete="off" required>
                            <select id="search-platform-select" aria-label="Platform">
                                <option value="">All platforms</option>
                                <option value="twitch">Twitch</option>
                                <option value="kick">Kick</option>
                                <option value="youtube">YouTube</option>
                                <option value="tiktok">TikTok</option>
                                <option value="rumble">Rumble</option>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm" id="search-streamer-btn">Search</button>
                        </div>
                    </div>
                </form>
                <div class="cf-list" id="search-results-content"></div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="sa-links-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sa-links-title">Look up a member's links</h2>
                    <p class="cf-section-desc">Streamer profiles linked to a Discord account, and the Twitch accounts it linked for Mod and VIP roles.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form class="cf-row" id="sa-links-form">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="user-id-input">Discord user ID</label>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-group">
                            <input type="text" id="user-id-input" inputmode="numeric" pattern="\d{17,20}" maxlength="20" placeholder="123456789012345678" autocomplete="off" required>
                            <button type="submit" class="btn btn-primary btn-sm" id="view-links-btn">Look up</button>
                        </div>
                    </div>
                </form>
                <div class="cf-list" id="links-results-content"></div>
            </div>
        </section>
        </div><!-- /#section-tools -->

        <!-- Global Bans Section -->
        <div id="section-globalbans" class="admin-section">
        <dl class="cf-kpis" id="gb-stats-grid" aria-label="Global bans at a glance">
            <div class="cf-kpi"><dt>Active bans</dt><dd class="cf-kpi-value" id="gb-stat-entries">–</dd></div>
            <div class="cf-kpi"><dt>Reports waiting</dt><dd class="cf-kpi-value" id="gb-stat-reports">–</dd></div>
            <div class="cf-kpi"><dt>Appeals waiting</dt><dd class="cf-kpi-value" id="gb-stat-appeals">–</dd></div>
            <div class="cf-kpi"><dt>Servers enforcing</dt><dd class="cf-kpi-value" id="gb-stat-guilds">–</dd></div>
            <div class="cf-kpi"><dt>Report watcher</dt><dd class="cf-kpi-value is-small" id="gb-stat-watcher">–</dd></div>
        </dl>

        <div class="sa-breakdowns">
            <section class="cf-section" aria-labelledby="gb-cat-title">
                <header class="cf-section-head"><div><h2 class="cf-section-title" id="gb-cat-title">By category</h2></div></header>
                <div class="cf-rows"><div class="sa-breakdown" id="gb-breakdown-category"><p class="cf-muted">Loading</p></div></div>
            </section>
            <section class="cf-section" aria-labelledby="gb-sev-title">
                <header class="cf-section-head"><div><h2 class="cf-section-title" id="gb-sev-title">By severity</h2></div></header>
                <div class="cf-rows"><div class="sa-breakdown" id="gb-breakdown-severity"><p class="cf-muted">Loading</p></div></div>
            </section>
        </div>

        <!-- Global Ban Tabs -->
        <section class="cf-section" aria-labelledby="gb-list-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="gb-list-title">Global ban list</h2>
                    <p class="cf-section-desc">Servers with global bans on refuse these users. Reports come from the audit bot and /globalban report; appeals from the people banned.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-primary btn-sm" id="gb-add-entry-btn" onclick="openGBEntryModal()"><i class="fas fa-plus" aria-hidden="true"></i> Add a ban</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="gb-import-csv-btn" onclick="document.getElementById('gb-csv-modal').classList.add('show')"><i class="fas fa-file-csv" aria-hidden="true"></i> Import CSV</button>
                </div>
            </header>
            <div class="cf-rows">
            <div class="cf-tabs gb-tabs" role="tablist" aria-label="Global bans">
                <button type="button" class="cf-tab active" role="tab" aria-selected="true" onclick="switchGBTab('entries', this)">Bans</button>
                <button type="button" class="cf-tab" role="tab" aria-selected="false" onclick="switchGBTab('reports', this)">Reports</button>
                <button type="button" class="cf-tab" role="tab" aria-selected="false" onclick="switchGBTab('appeals', this)">Appeals</button>
                <button type="button" class="cf-tab" role="tab" aria-selected="false" onclick="switchGBTab('action-log', this)">Action log</button>
            </div>
            <div class="sa-gb-body">
                <!-- Entries Tab -->
                <div id="gb-tab-entries">
                    <div class="sa-filters">
                        <input type="text" class="input sa-grow" id="gb-entries-search" aria-label="Search bans" placeholder="Search by User ID or username..." oninput="loadGBEntries()">
                        <select class="input sa-auto" id="gb-entries-severity" onchange="loadGBEntries()">
                            <option value="">All Severities</option>
                            <option value="critical">Critical</option>
                            <option value="high">High</option>
                            <option value="medium">Medium</option>
                            <option value="low">Low</option>
                        </select>
                        <select class="input sa-auto" id="gb-entries-category" onchange="loadGBEntries()">
                            <option value="">All Categories</option>
                            <option value="phishing">Phishing</option>
                            <option value="scam">Scam</option>
                            <option value="spam">Spam</option>
                            <option value="raid">Raid</option>
                            <option value="harassment">Harassment</option>
                            <option value="selfbot">Selfbot</option>
                            <option value="mass_dm">Mass DM</option>
                            <option value="impersonation">Impersonation</option>
                            <option value="other">Other</option>
                        </select>
                        <select class="input sa-auto" id="gb-entries-perpage" onchange="gbEntriesLimit = +this.value; gbEntriesPage = 1; loadGBEntries()">
                            <option value="20" selected>20 / page</option>
                            <option value="50">50 / page</option>
                            <option value="100">100 / page</option>
                            <option value="250">250 / page</option>
                        </select>
                    </div>
                    <div class="cf-table-wrap sa-table-wrap">
                        <table class="cf-table guild-table">
                            <thead>
                                <tr>
                                    <th style="width:1.5rem;"></th>
                                    <th class="gb-sortable" data-sort="username" onclick="toggleGBSort('username')">User <i class="fas fa-sort gb-sort-icon" id="gb-sort-username"></i></th>
                                    <th class="gb-sortable" data-sort="severity" onclick="toggleGBSort('severity')">Sev <i class="fas fa-sort gb-sort-icon" id="gb-sort-severity"></i></th>
                                    <th class="gb-sortable" data-sort="category" onclick="toggleGBSort('category')">Category <i class="fas fa-sort gb-sort-icon" id="gb-sort-category"></i></th>
                                    <th class="gb-sortable" data-sort="reason" onclick="toggleGBSort('reason')" style="max-width:200px;">Reason <i class="fas fa-sort gb-sort-icon" id="gb-sort-reason"></i></th>
                                    <th class="gb-sortable" data-sort="reporter_name" onclick="toggleGBSort('reporter_name')">Reporter <i class="fas fa-sort gb-sort-icon" id="gb-sort-reporter_name"></i></th>
                                    <th>Ev.</th>
                                    <th class="gb-sortable" data-sort="created_at" onclick="toggleGBSort('created_at')">Date <i class="fas fa-sort-down gb-sort-icon gb-sort-active" id="gb-sort-created_at"></i></th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="gb-entries-body">
                                <tr><td colspan="9" class="empty-state">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="gb-entries-pagination" class="sa-pagination"></div>
                </div>

                <!-- Reports Tab -->
                <div id="gb-tab-reports" style="display: none;">
                    <div class="sa-filters">
                        <select class="input sa-auto" id="gb-reports-status" onchange="loadGBReports()">
                            <option value="pending">Pending</option>
                            <option value="">All Statuses</option>
                            <option value="approved">Approved</option>
                            <option value="denied">Denied</option>
                        </select>
                    </div>
                    <div class="cf-table-wrap sa-table-wrap">
                        <table class="cf-table guild-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Target</th>
                                    <th>Category</th>
                                    <th>Severity</th>
                                    <th>Reason</th>
                                    <th>Votes</th>
                                    <th>Status</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="gb-reports-body">
                                <tr><td colspan="8" class="empty-state">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="gb-reports-pagination" class="sa-pagination"></div>
                </div>

                <!-- Appeals Tab -->
                <div id="gb-tab-appeals" style="display: none;">
                    <div class="sa-filters">
                        <select class="input sa-auto" id="gb-appeals-status" onchange="loadGBAppeals()">
                            <option value="pending">Pending</option>
                            <option value="">All Statuses</option>
                            <option value="under_review">Under Review</option>
                            <option value="approved">Approved</option>
                            <option value="denied">Denied</option>
                        </select>
                    </div>
                    <div class="cf-table-wrap sa-table-wrap">
                        <table class="cf-table guild-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>User ID</th>
                                    <th>Ban Reason</th>
                                    <th>Appeal Reason</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th style="text-align: right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="gb-appeals-body">
                                <tr><td colspan="7" class="empty-state">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="gb-appeals-pagination" class="sa-pagination"></div>
                </div>

                <!-- Action Log Tab -->
                <div id="gb-tab-action-log" style="display: none;">
                    <div class="cf-table-wrap sa-table-wrap">
                        <table class="cf-table guild-table">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>User ID</th>
                                    <th>Guild ID</th>
                                    <th>Performed By</th>
                                    <th>Details</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="gb-actionlog-body">
                                <tr><td colspan="6" class="empty-state">Loading...</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="gb-actionlog-pagination" class="sa-pagination"></div>
            </div>
            </div>
        </section>

        </div><!-- /#section-globalbans -->

        <!-- Greenhouse Tycoon Section (game jobs and the Twitch review save; dashboard/routes/greenhouse-admin.js) -->
        <div id="section-greenhouse" class="admin-section">
        <div id="gh-sa-notready" class="cf-notice is-info" role="status" hidden>Greenhouse Tycoon is not set up yet (its tables do not exist). These controls work once migration 437 is applied.</div>
        <div id="gh-sa-error" class="cf-notice is-bad" role="alert" hidden></div>
        <section class="cf-section" aria-labelledby="gh-sa-jobs-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="gh-sa-jobs-title">Game jobs</h2>
                    <p class="cf-section-desc">The game's background jobs: seasons and challenges, market days, clean-ups and the review save reset. Switching a job off takes effect at its next run (within 15 seconds of the check), with no restart.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label">All jobs</span>
                        <p class="cf-row-desc" id="gh-sa-jobs-state">Loading</p>
                    </div>
                    <div class="cf-row-control">
                        <button type="button" class="btn btn-secondary btn-sm" id="gh-sa-jobs-all-off">Stop all</button>
                        <button type="button" class="btn btn-secondary btn-sm" id="gh-sa-jobs-all-on">Run all</button>
                    </div>
                </div>
                <div class="cf-table-wrap sa-table-wrap">
                    <table class="cf-table">
                        <thead><tr><th>Job</th><th>Last run</th><th>Result</th><th>Runs / failures</th><th class="cf-cell-end">Runs?</th></tr></thead>
                        <tbody id="gh-sa-jobs-body"><tr><td colspan="5"><div class="empty-state"><p>Loading</p></div></td></tr></tbody>
                    </table>
                </div>
                <p class="cf-row-desc" id="gh-sa-env-note"></p>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="gh-sa-review-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="gh-sa-review-title">Twitch review save</h2>
                    <p class="cf-section-desc">A shared example save so Twitch reviewers see a mid-game greenhouse. While this is on, the panel offers "Try the review save" in Hosted Test and review; anyone switching to it plays a sandbox that is never ranked, cannot link or rename, and is put back every night at 04:00 UTC. Turn it off once the review is done.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="gh-sa-review-on">Review save open</label>
                        <p class="cf-row-desc" id="gh-sa-review-state">Loading</p>
                    </div>
                    <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="gh-sa-review-on"></div>
                </div>
                <form class="cf-row" id="gh-sa-review-form">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="gh-sa-review-channels">Only on these channels</label>
                        <p class="cf-row-desc">Twitch channel ids, separated by commas. Leave empty to allow any channel the extension is on.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-group">
                            <input type="text" id="gh-sa-review-channels" maxlength="440" placeholder="123456789" autocomplete="off">
                            <button type="submit" class="btn btn-primary btn-sm">Save</button>
                        </div>
                    </div>
                </form>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Put the save back now</span>
                        <p class="cf-row-desc">Restores the example greenhouse (level 12, six benches, staff, a cross nearly done).</p>
                    </div>
                    <div class="cf-row-control"><button type="button" class="btn btn-secondary btn-sm" id="gh-sa-review-reset">Reset</button></div>
                </div>
            </div>
        </section>
        </div><!-- /#section-greenhouse -->

        <script>
        (function () {
          const $ = (id) => document.getElementById(id);
          let jobs = [];
          let disabled = false;
          const when = (ms) => ms ? new Date(ms).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) : 'never';
          const cell = (text, cls) => { const td = document.createElement('td'); if (cls) td.className = cls; td.textContent = text; return td; };
          const isOff = (name) => disabled === true || (Array.isArray(disabled) && disabled.includes(name));

          function showError(msg) { const e = $('gh-sa-error'); e.textContent = msg || ''; e.hidden = !msg; }

          async function call(method, url, body) {
            const res = await fetch(url, { method, credentials: 'same-origin', headers: body ? { 'Content-Type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
            return data;
          }

          function draw(d) {
            if (!d.ready) { $('gh-sa-notready').hidden = false; document.querySelectorAll('#section-greenhouse .cf-section').forEach(s => { s.hidden = true; }); return; }
            jobs = d.jobs || [];
            disabled = d.disabled;
            $('gh-sa-jobs-state').textContent = disabled === true ? 'Every job is stopped.' : Array.isArray(disabled) && disabled.length ? `${disabled.length} stopped: ${disabled.join(', ')}.` : 'Every job runs.';
            $('gh-sa-env-note').textContent = d.envNote || '';
            const runs = new Map((d.runs || []).map(r => [r.name, r]));
            const body = $('gh-sa-jobs-body');
            body.replaceChildren();
            jobs.forEach(name => {
              const r = runs.get(name);
              const tr = document.createElement('tr');
              tr.append(cell(name), cell(r ? when(r.lastStartedAtMs) : 'not run yet'),
                cell(r ? (r.lastStatus || '–') + (r.lastError ? `: ${r.lastError}` : '') : '–'),
                cell(r ? `${r.runs} / ${r.failures}` : '0 / 0'));
              const td = document.createElement('td');
              td.className = 'cf-cell-end';
              const box = document.createElement('input');
              box.type = 'checkbox'; box.className = 'cf-switch'; box.setAttribute('role', 'switch');
              box.setAttribute('aria-label', `Run ${name}`);
              box.checked = !isOff(name);
              box.disabled = disabled === true;
              box.addEventListener('change', () => {
                const off = new Set(Array.isArray(disabled) ? disabled : []);
                if (box.checked) off.delete(name); else off.add(name);
                save([...off]);
              });
              td.append(box);
              tr.append(td);
              body.append(tr);
            });
            const rv = d.review || {};
            $('gh-sa-review-on').checked = !!rv.enabled;
            $('gh-sa-review-state').textContent = `${rv.enabled ? 'Open' : 'Closed'}. Last put back: ${when(rv.lastResetAtMs)}.`;
            $('gh-sa-review-channels').value = (rv.channelIds || []).join(', ');
          }

          async function load() {
            try { showError(''); draw(await call('GET', '/api/super-admin/greenhouse')); } catch (err) { showError(err.message); }
          }
          async function save(value) {
            try { showError(''); await call('POST', '/api/super-admin/greenhouse/jobs', { disabled: value }); } catch (err) { showError(err.message); }
            load();
          }
          async function saveReview(includeChannels) {
            const body = { enabled: $('gh-sa-review-on').checked };
            if (includeChannels) body.channelIds = $('gh-sa-review-channels').value;
            try { showError(''); await call('POST', '/api/super-admin/greenhouse/review', body); } catch (err) { showError(err.message); }
            load();
          }

          $('gh-sa-jobs-all-off').addEventListener('click', () => save(true));
          $('gh-sa-jobs-all-on').addEventListener('click', () => save(false));
          $('gh-sa-review-on').addEventListener('change', () => saveReview(false));
          $('gh-sa-review-form').addEventListener('submit', (e) => { e.preventDefault(); saveReview(true); });
          $('gh-sa-review-reset').addEventListener('click', async (e) => {
            const btn = e.currentTarget; btn.disabled = true;
            try { showError(''); const r = await call('POST', '/api/super-admin/greenhouse/review/reset'); if (r.ready && !r.reset) showError('There is no review save yet: turn it on first.'); } catch (err) { showError(err.message); }
            btn.disabled = false; load();
          });
          let loaded = false;
          const maybeLoad = () => { if (!loaded && location.hash === '#greenhouse') { loaded = true; load(); } };
          window.addEventListener('hashchange', maybeLoad);
          document.addEventListener('DOMContentLoaded', maybeLoad);
          document.querySelectorAll('.cf-owner-nav-item[data-sa-section="greenhouse"]').forEach(a => a.addEventListener('click', () => { if (!loaded) { loaded = true; load(); } }));
        })();
        </script>

</div>
</main>


