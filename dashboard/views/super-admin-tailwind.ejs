            renderPagination('gb-actionlog-pagination', d.pagination, (p) => { gbActionLogPage = p; loadGBActionLog(); });
        } catch (e) {
            document.getElementById('gb-actionlog-body').innerHTML = '<tr><td colspan="6" class="empty-state" style="color:var(--accent-red)">Error loading action log</td></tr>';
        }
    }

    function renderPagination(containerId, pagination, onPageChange) {
        const container = document.getElementById(containerId);
        if (!pagination || pagination.pages <= 1) {
            container.innerHTML = pagination ? `<span>${pagination.total} total</span><span></span>` : '';
            return;
        }
        let btns = '';
        if (pagination.page > 1) btns += `<button class="btn btn-ghost btn-sm" style="width:auto;" onclick="void(0)" data-page="${pagination.page - 1}"><i class="fas fa-chevron-left"></i></button>`;
        btns += `<span>Page ${pagination.page} of ${pagination.pages} (${pagination.total} total)</span>`;
        if (pagination.page < pagination.pages) btns += `<button class="btn btn-ghost btn-sm" style="width:auto;" onclick="void(0)" data-page="${pagination.page + 1}"><i class="fas fa-chevron-right"></i></button>`;
        container.innerHTML = `<div style="display:flex;align-items:center;gap:0.5rem;">${btns}</div>`;
        container.querySelectorAll('[data-page]').forEach(btn => {
            btn.addEventListener('click', () => onPageChange(parseInt(btn.dataset.page)));
        });
    }

    function openGBEntryModal(entry) {
        const isEdit = !!entry;
        document.getElementById('gb-entry-modal-title').textContent = isEdit ? 'Edit Global Ban Entry' : 'Add Global Ban Entry';
        document.getElementById('gb-entry-id').value = isEdit ? entry.id : '';
        document.getElementById('gb-entry-user-id').value = isEdit ? entry.user_id : '';
        document.getElementById('gb-entry-user-id').disabled = isEdit;
        document.getElementById('gb-entry-severity').value = isEdit ? entry.severity : 'medium';
        document.getElementById('gb-entry-category').value = isEdit ? entry.category : 'other';
        document.getElementById('gb-entry-reason').value = isEdit ? (entry.reason || '') : '';
        document.getElementById('gb-entry-evidence').value = isEdit ? (entry.evidence || '') : '';
        document.getElementById('gb-entry-modal').classList.add('show');
    }

    function closeGBEntryModal() {
        document.getElementById('gb-entry-modal').classList.remove('show');
        document.getElementById('gb-entry-user-id').disabled = false;
    }

    async function saveGBEntry() {
        const id = document.getElementById('gb-entry-id').value;
        const isEdit = !!id;
        const body = {
            user_id: document.getElementById('gb-entry-user-id').value.trim(),
            severity: document.getElementById('gb-entry-severity').value,
            category: document.getElementById('gb-entry-category').value,
            reason: document.getElementById('gb-entry-reason').value.trim(),
            evidence: document.getElementById('gb-entry-evidence').value.trim() || '[]'
        };

        if (!body.user_id) return alert('User ID is required');
        if (!body.reason) return alert('Reason is required');

        try {
            const url = isEdit ? `/api/super-admin/global-ban/entries/${id}` : '/api/super-admin/global-ban/entries';
            const r = await fetch(url, {
                method: isEdit ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const d = await r.json();
            if (d.success) {
                closeGBEntryModal();
                loadGBEntries();
                loadGBStats();
            } else {
                alert(d.error || 'Failed to save entry');
            }
        } catch (e) { alert('Error saving entry'); }
    }

    async function editGBEntry(id) {
        try {
            const r = await fetch(`/api/super-admin/global-ban/entries?search_id=${id}`);
            const d = await r.json();
            if (d.success && d.entries && d.entries.length > 0) {
                openGBEntryModal(d.entries[0]);
            } else {
                // Fallback: open modal with just the ID
                openGBEntryModal({ id, user_id: '', severity: 'medium', category: 'other', reason: '', evidence: '' });
            }
        } catch (e) { alert('Error fetching entry details'); }
    }

    async function deleteGBEntry(id) {
        if (!confirm('Delete this global ban entry? This cannot be undone.')) return;
        try {
            const r = await fetch(`/api/super-admin/global-ban/entries/${id}`, { method: 'DELETE' });
            const d = await r.json();
            if (d.success) {
                loadGBEntries();
                loadGBStats();
            } else {
                alert(d.error || 'Failed to delete entry');
            }
        } catch (e) { alert('Error deleting entry'); }
    }

    async function reviewGBReport(id, status) {
        const action = status === 'approved' ? 'approve' : 'deny';
        if (!confirm(`${action.charAt(0).toUpperCase() + action.slice(1)} this report?`)) return;
        try {
            const r = await fetch(`/api/super-admin/global-ban/reports/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });
            const d = await r.json();
            if (d.success) {
                loadGBReports();
                loadGBStats();
                loadGBEntries();
            } else {
                alert(d.error || 'Failed to update report');
            }
        } catch (e) { alert('Error reviewing report'); }
    }

    function openAppealReview(id, reason, userId) {
        document.getElementById('gb-appeal-id').value = id;
        document.getElementById('gb-appeal-details').innerHTML = `<strong>User:</strong> ${userId}<br><strong>Appeal reason:</strong> ${reason}`;
        document.getElementById('gb-appeal-response').value = '';
        document.getElementById('gb-appeal-modal').classList.add('show');
    }

    async function reviewGBAppeal(approved) {
        const id = document.getElementById('gb-appeal-id').value;
        const response = document.getElementById('gb-appeal-response').value.trim();
        if (!response) return alert('Please provide a response');

        try {
            const r = await fetch(`/api/super-admin/global-ban/appeals/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: approved ? 'approved' : 'denied', reviewer_response: response })
            });
            const d = await r.json();
            if (d.success) {
                document.getElementById('gb-appeal-modal').classList.remove('show');
                loadGBAppeals();
                loadGBStats();
                if (approved) loadGBEntries();
            } else {
                alert(d.error || 'Failed to review appeal');
            }
        } catch (e) { alert('Error reviewing appeal'); }
    }

    // ── CSV Import ──
    let csvParsedData = [];

    function handleCSVFile(file) {
        if (!file) return;
        Papa.parse(file, {
            header: true,
            skipEmptyLines: true,
            complete: function(results) {
                csvParsedData = results.data;
                if (csvParsedData.length === 0) {
                    alert('CSV file is empty or has no valid rows');
                    return;
                }
                const headers = results.meta.fields || [];
                ['csv-col-user-id', 'csv-col-severity', 'csv-col-category', 'csv-col-reason', 'csv-col-evidence'].forEach(id => {
                    const sel = document.getElementById(id);
                    const isUserId = id === 'csv-col-user-id';
                    const existing = sel.value;
                    sel.innerHTML = isUserId ? '' : '<option value="">— Use default —</option>';
                    headers.forEach(h => {
                        const opt = document.createElement('option');
                        opt.value = h;
                        opt.textContent = h;
                        sel.appendChild(opt);
                    });
                    // Auto-detect common column names
                    const field = id.replace('csv-col-', '').replace('-', '_');
                    const match = headers.find(h => h.toLowerCase().replace(/[\s-]/g, '_') === field || h.toLowerCase() === field);
                    if (match) sel.value = match;
                });
                document.getElementById('csv-step-upload').style.display = 'none';
                document.getElementById('csv-step-preview').style.display = 'block';
                document.getElementById('csv-import-btn').style.display = '';
                document.getElementById('csv-total-rows').textContent = csvParsedData.length;
                updateCSVPreview();
            },
            error: function(err) {
                alert('Failed to parse CSV: ' + err.message);
            }
        });
    }

    function updateCSVPreview() {
        const cols = {
            user_id: document.getElementById('csv-col-user-id').value,
            severity: document.getElementById('csv-col-severity').value,
            category: document.getElementById('csv-col-category').value,
            reason: document.getElementById('csv-col-reason').value,
            evidence: document.getElementById('csv-col-evidence').value
        };
        const defSev = document.getElementById('csv-default-severity').value;
        const defCat = document.getElementById('csv-default-category').value;
        const tbody = document.getElementById('csv-preview-body');
        const preview = csvParsedData.slice(0, 5);
        tbody.innerHTML = preview.map(row => {
            const uid = cols.user_id ? (row[cols.user_id] || '') : '';
            const sev = (cols.severity && row[cols.severity]) || defSev;
            const cat = (cols.category && row[cols.category]) || defCat;
            const rsn = (cols.reason && row[cols.reason]) || 'Imported from CSV';
            const evi = (cols.evidence && row[cols.evidence]) || '';
            return `<tr>
                <td style="font-family:monospace;">${uid}</td>
                <td>${severityBadge(sev)}</td>
                <td>${cat}</td>
                <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${rsn}</td>
                <td style="max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${evi}</td>
            </tr>`;
        }).join('');
    }

    async function executeCSVImport() {
        const cols = {
            user_id: document.getElementById('csv-col-user-id').value,
            severity: document.getElementById('csv-col-severity').value,
            category: document.getElementById('csv-col-category').value,
            reason: document.getElementById('csv-col-reason').value,
            evidence: document.getElementById('csv-col-evidence').value
        };
        if (!cols.user_id) { alert('Please select a User ID column'); return; }
        const defSev = document.getElementById('csv-default-severity').value;
        const defCat = document.getElementById('csv-default-category').value;

        const rows = csvParsedData.map(row => ({
            user_id: row[cols.user_id] || '',
            severity: (cols.severity && row[cols.severity]) || defSev,
            category: (cols.category && row[cols.category]) || defCat,
            reason: (cols.reason && row[cols.reason]) || 'Imported from CSV',
            evidence: (cols.evidence && row[cols.evidence]) || ''
        }));

        const btn = document.getElementById('csv-import-btn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Importing...';

        try {
            const r = await fetch('/api/super-admin/global-ban/import', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ rows })
            });
            const d = await r.json();
            if (d.success) {
                document.getElementById('csv-step-preview').style.display = 'none';
                document.getElementById('csv-step-results').style.display = 'block';
                document.getElementById('csv-result-imported').textContent = d.imported;
                document.getElementById('csv-result-skipped').textContent = d.skipped;
                document.getElementById('csv-result-errors').textContent = d.errors.length;
                btn.style.display = 'none';
                if (d.errors.length > 0) {
                    const el = document.getElementById('csv-error-list');
                    el.style.display = 'block';
                    el.innerHTML = d.errors.map(e => `<div style="color: var(--accent-red); margin-bottom: 0.25rem;">Row ${e.row}: ${e.error}${e.user_id ? ` (${e.user_id})` : ''}</div>`).join('');
                }
                loadGBEntries();
                loadGBStats();
            } else {
                alert(d.error || 'Import failed');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-upload"></i> Import';
            }
        } catch (e) {
            alert('Error importing CSV');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-upload"></i> Import';
        }
    }

    function closeCSVModal() {
        document.getElementById('gb-csv-modal').classList.remove('show');
        // Reset state
        csvParsedData = [];
        document.getElementById('csv-step-upload').style.display = 'block';
        document.getElementById('csv-step-preview').style.display = 'none';
        document.getElementById('csv-step-results').style.display = 'none';
        document.getElementById('csv-import-btn').style.display = 'none';
        document.getElementById('csv-import-btn').disabled = false;
        document.getElementById('csv-import-btn').innerHTML = '<i class="fas fa-upload"></i> Import';
        document.getElementById('csv-file-input').value = '';
        document.getElementById('csv-preview-body').innerHTML = '';
    }

    // Drag & drop support for CSV
    const csvDropZone = document.getElementById('csv-drop-zone');
    if (csvDropZone) {
        csvDropZone.addEventListener('dragover', (e) => { e.preventDefault(); csvDropZone.style.borderColor = 'var(--accent-purple)'; });
        csvDropZone.addEventListener('dragleave', () => { csvDropZone.style.borderColor = 'var(--border-color)'; });
        csvDropZone.addEventListener('drop', (e) => { e.preventDefault(); csvDropZone.style.borderColor = 'var(--border-color)'; if (e.dataTransfer.files.length) handleCSVFile(e.dataTransfer.files[0]); });
    }

    // User menu dropdown toggle
    const userMenuContainer = document.getElementById('userMenuContainer');
    const userMenuBtn = document.getElementById('userMenuBtn');

    if (userMenuBtn && userMenuContainer) {
        userMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userMenuContainer.classList.toggle('open');
        });

        document.addEventListener('click', (e) => {
            if (!userMenuContainer.contains(e.target)) {
                userMenuContainer.classList.remove('open');
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                userMenuContainer.classList.remove('open');
            }
        });
    }
    </script>
    <script src="/js/csrf.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
