<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<link rel="stylesheet" href="/css/cf-settings.css">
<style>
    .hero { padding: 24px 0 20px; }
    .hero h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; }
    .hero p { color: var(--cf-text-3); margin-top: 4px; font-size: var(--cf-text-md); }
    .config-wrap { max-width: 760px; padding-bottom: 72px; }
    .cf-rows .cf-row-control input[type=number] { width: 7rem; text-align: right; }
    .save-bar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 20px; }
    #toast { display: none; }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Server settings · Cards Against Humanity · CertiFried', description: 'Cards Against Humanity on CertiFried: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'config' }) %>
<%- include('components/cah-breadcrumbs', { crumbs: [{ href: '/manage/' + guildId, label: 'Server dashboard' }, { label: 'Cards Against Humanity' }] }) %>

<main class="container config-wrap" id="main-content">
    <section class="hero">
        <h1>Cards Against Humanity settings</h1>
        <p>Rules for games started in this server, from <code>/cah</code> or from the website.</p>
    </section>

    <form id="cah-config-form" onsubmit="return save(event)" novalidate>
        <section class="cf-section">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title">What hosts can turn on</h2>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="nsfw_allowed">Allow NSFW packs</label>
                        <p class="cf-row-desc" id="nsfw_allowed-desc">Hosts still choose per game whether to use them.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="nsfw_allowed" aria-describedby="nsfw_allowed-desc" <%= cfg.nsfw_allowed ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="blank_cards_allowed">Allow blank cards</label>
                        <p class="cf-row-desc" id="blank_cards_allowed-desc">Write-your-own white cards in players' hands.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="blank_cards_allowed" aria-describedby="blank_cards_allowed-desc" <%= cfg.blank_cards_allowed ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="max_blank_cards">Most blank cards per game</label>
                        <p class="cf-row-desc">0 to 50.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="number" class="form-control" id="max_blank_cards" min="0" max="50" value="<%= cfg.max_blank_cards %>">
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="allow_public_imports">Members can import packs</label>
                        <p class="cf-row-desc" id="allow_public_imports-desc">Anyone can run <code>/cah decks add</code>. When off, only server admins can.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="allow_public_imports" aria-describedby="allow_public_imports-desc" <%= cfg.allow_public_imports ? 'checked' : '' %>>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title">Defaults for /cah start</h2>
                    <p class="cf-section-desc">Used when the host doesn't set a value.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="default_points">Points to win</label>
                        <p class="cf-row-desc">3 to 30.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="number" class="form-control" id="default_points" min="3" max="30" value="<%= cfg.default_points %>">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="default_max_rounds">Most rounds</label>
                        <p class="cf-row-desc">The game ends after this many rounds even if nobody has won. 3 to 50.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="number" class="form-control" id="default_max_rounds" min="3" max="50" value="<%= cfg.default_max_rounds %>">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="default_timeout_secs">Turn time limit</label>
                        <p class="cf-row-desc">Seconds a player has to play before they are skipped. 30 to 600.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit"><input type="number" class="form-control" id="default_timeout_secs" min="30" max="600" value="<%= cfg.default_timeout_secs %>"><span class="cf-unit">s</span></div>
                    </div>
                </div>
            </div>
        </section>

        <div class="save-bar">
            <button class="btn btn-primary" type="submit" id="save-btn">Save changes</button>
            <div id="toast" class="toast" role="status"></div>
        </div>
    </form>
</main>

<script>
    const LIMITS = { max_blank_cards: [0, 50], default_points: [3, 30], default_max_rounds: [3, 50], default_timeout_secs: [30, 600] };
    async function save(e) {
        e.preventDefault();
        const toast = document.getElementById('toast');
        const show = (ok, text) => { toast.className = 'toast ' + (ok ? 'ok' : 'err'); toast.textContent = text; toast.style.display = 'inline-block'; };
        const body = {
            nsfw_allowed: document.getElementById('nsfw_allowed').checked,
            blank_cards_allowed: document.getElementById('blank_cards_allowed').checked,
            allow_public_imports: document.getElementById('allow_public_imports').checked
        };
        for (const [id, [min, max]] of Object.entries(LIMITS)) {
            const input = document.getElementById(id);
            const n = parseInt(input.value, 10);
            const bad = !Number.isInteger(n) || n < min || n > max;
            input.setAttribute('aria-invalid', bad ? 'true' : 'false');
            if (bad) { show(false, 'Enter a number from ' + min + ' to ' + max + '.'); input.focus(); return false; }
            body[id] = n;
        }
        const btn = document.getElementById('save-btn');
        btn.disabled = true;
        try {
            const res = await cfetch(location.pathname, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json().catch(() => ({ ok: false, reason: 'http_' + res.status }));
            show(!!data.ok, data.ok ? 'Saved' : 'Could not save (' + (data.reason || 'error') + ').');
            if (data.ok) setTimeout(() => toast.style.display = 'none', 2500);
        } catch (_) {
            show(false, 'Could not reach the server. Try again.');
        } finally {
            btn.disabled = false;
        }
        return false;
    }
</script>
<%- include('partials/site-footer') %>
</body>
</html>