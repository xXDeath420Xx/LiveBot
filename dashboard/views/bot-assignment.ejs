<%#
  /bot-management/assign/:botId — which servers a custom bot answers in.
  Locals (dashboard/server.js): bot { id, name, avatar, online, enabled, approved, servers, inviteBase },
  userGuilds [{ id, name, icon, canEdit, currentBot, present }]. Saves through POST /api/bots/:id/assign
  (this bot) and POST /api/bots/default/assign (back to the main bot), only for servers that changed.
%>
<%
// Locals from dashboard/server.js; the defaults keep the page working with an older route.
const _bot = locals.bot || { id: botId, name: 'Custom bot', avatar: null, online: false, enabled: true, approved: true, servers: 0,
    inviteBase: 'https://discord.com/oauth2/authorize?client_id=' + encodeURIComponent(botId) + '&permissions=1643797540086&scope=bot+applications.commands' };
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: ('Assign ' + _bot.name) + ' · CertiFried', noindex: true }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
</head>
<body class="cfs-body cf-site">
<%- include('partials/site-header', { user }) %>
<main id="main-content" class="cf-main" tabindex="-1">
<div class="cf-page is-narrow">
    <a class="cf-back" href="/bot-management"><i class="fas fa-arrow-left" aria-hidden="true"></i> Custom bots</a>
    <div class="cf-page-head">
        <div class="cf-page-icon"><% if (_bot.avatar) { %><img src="<%= _bot.avatar %>" alt="" data-cf-fallback="https://cdn.discordapp.com/embed/avatars/0.png"><% } else { %><i class="fas fa-robot" aria-hidden="true"></i><% } %></div>
        <div>
            <h1 class="cf-page-title"><%= _bot.name %></h1>
            <p class="cf-page-sub">
                <span class="cf-pill <%= !_bot.enabled ? '' : _bot.online ? 'is-ok' : 'is-bad' %>"><%= !_bot.enabled ? 'Turned off' : _bot.online ? 'Online' : 'Offline' %></span>
                <span class="ba-sub-gap"><%= _bot.servers %> <%= _bot.servers === 1 ? 'server' : 'servers' %> joined</span>
            </p>
        </div>
    </div>

    <% if (!_bot.enabled || !_bot.approved) { %>
    <div class="cf-notice is-warn"><i class="fas fa-circle-exclamation" aria-hidden="true"></i><div class="cf-notice-body">This bot is <%= _bot.approved ? 'turned off' : 'waiting for approval' %>, so it cannot be assigned until it is running. Turn it on from <a href="/bot-management">Custom bots</a>.</div></div>
    <% } %>

    <form id="ba-form">
    <section class="cf-section" aria-labelledby="ba-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ba-title">Servers<span class="cf-count"><%= userGuilds.length %></span></h2>
                <p class="cf-section-desc">Ticked servers are answered by <%= _bot.name %>; the rest by the main CertiFried bot. The bot must also be invited to a server before it can answer there.</p>
            </div>
            <% if (userGuilds.length > 1) { %>
            <div class="cf-section-actions">
                <button type="button" class="btn btn-secondary btn-sm" id="ba-all">Tick all</button>
                <button type="button" class="btn btn-secondary btn-sm" id="ba-none">Clear</button>
            </div>
            <% } %>
        </header>
        <div class="cf-rows">
            <% if (userGuilds.length > 15) { %>
            <div class="cf-toolbar"><label class="cf-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="ba-search" placeholder="Search servers" aria-label="Search servers"></label></div>
            <% } %>
            <% if (!userGuilds.length) { %>
            <div class="cf-state"><p class="cf-state-title">No servers to assign</p><p class="cf-state-text">You need the Administrator permission in a server to give it a custom bot.</p></div>
            <% } %>
            <div class="cf-list" id="ba-list">
            <% userGuilds.forEach(function (g) {
                const mine = g.currentBot === _bot.id;
                const other = !mine && g.currentBot !== 'default';
                const icon = g.icon ? (String(g.icon).startsWith('http') ? g.icon : `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png?size=64`) : null;
            %>
                <label class="cf-list-item ba-item" data-name="<%= String(g.name).toLowerCase() %>">
                    <span class="ba-check"><input type="checkbox" name="guild" value="<%= g.id %>" data-was="<%= mine ? '1' : '0' %>"<% if (mine) { %> checked<% } %><% if (g.canEdit === false || !_bot.enabled || !_bot.approved) { %> disabled<% } %>></span>
                    <span class="ba-icon"><% if (icon) { %><img src="<%= icon %>" alt="" loading="lazy" data-cf-fallback="https://cdn.discordapp.com/embed/avatars/0.png"><% } else { %><%= String(g.name).charAt(0).toUpperCase() %><% } %></span>
                    <span class="cf-list-main ba-main">
                        <span class="cf-em"><%= g.name %></span>
                        <span class="cf-list-meta ba-meta">
                            <% if (mine) { %><span>Assigned to this bot</span><% } else if (other && g.currentBot) { %><span>Assigned to another custom bot</span><% } else if (g.currentBot) { %><span>Main CertiFried bot</span><% } %>
                            <% if (g.canEdit === false) { %><span>You are not an administrator there</span><% } %>
                        </span>
                    </span>
                    <span class="ba-presence">
                        <% if (g.present === undefined) { %><% } else if (g.present) { %><span class="cf-pill is-ok">Joined</span>
                        <% } else { %><a class="cf-pill is-warn" href="<%= _bot.inviteBase %>&guild_id=<%= g.id %>&disable_guild_select=true" target="_blank" rel="noopener">Invite</a><% } %>
                    </span>
                </label>
            <% }); %>
            </div>
            <% if (userGuilds.length) { %>
            <div class="cf-section-foot">
                <span class="cf-status-line" id="ba-status" aria-live="polite"></span>
                <a class="btn btn-secondary btn-sm" href="/bot-management">Cancel</a>
                <button type="submit" class="btn btn-primary btn-sm" id="ba-save"<% if (!_bot.enabled || !_bot.approved) { %> disabled<% } %>>Save</button>
            </div>
            <% } %>
        </div>
    </section>
    </form>
</div>
</main>
<style>
    .ba-sub-gap { margin-left: 8px; }
    .cf-rows .ba-item { justify-content: flex-start; cursor: pointer; }
    .cf-rows .ba-item:hover { background: color-mix(in srgb, var(--cf-surface-2) 50%, transparent); }
    .ba-check { flex: none; display: inline-flex; }
    .ba-check input { width: 18px; height: 18px; accent-color: var(--cf-accent); margin: 0; }
    .ba-icon {
        flex: none; width: 36px; height: 36px; border-radius: 50%; overflow: hidden; display: inline-flex; align-items: center; justify-content: center;
        background: var(--cf-surface-3); color: var(--cf-text-2); font-weight: 600;
    }
    .ba-icon img { width: 100%; height: 100%; object-fit: cover; }
    .cf-rows .ba-main { flex: 1 1 auto; display: grid; gap: 2px; }
    .ba-presence { flex: none; margin-left: auto; }
    .ba-item[hidden] { display: none !important; }
    .cf-rows .cf-section-foot { display: flex; align-items: center; justify-content: flex-end; gap: var(--cf-2); flex-wrap: wrap; }
    .cf-rows .cf-section-foot .cf-status-line { margin-right: auto; }
</style>
<script>
(function () {
    'use strict';
    var BOT = <%- JSON.stringify(_bot.id).replace(/</g, '\\u003c') %>;
    var form = document.getElementById('ba-form');
    var boxes = function () { return Array.prototype.slice.call(document.querySelectorAll('#ba-list input[name="guild"]:not(:disabled)')); };
    var all = document.getElementById('ba-all'), none = document.getElementById('ba-none'), search = document.getElementById('ba-search');
    if (all) all.addEventListener('click', function () { boxes().forEach(function (b) { if (!b.closest('.ba-item').hidden) b.checked = true; }); });
    if (none) none.addEventListener('click', function () { boxes().forEach(function (b) { if (!b.closest('.ba-item').hidden) b.checked = false; }); });
    if (search) search.addEventListener('input', function () {
        var q = search.value.trim().toLowerCase();
        document.querySelectorAll('#ba-list .ba-item').forEach(function (it) { it.hidden = !!q && it.dataset.name.indexOf(q) === -1; });
    });

    async function post(botId, guildId) {
        var r = await fetch('/api/bots/' + encodeURIComponent(botId) + '/assign', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ guildId: guildId }),
        });
        var d = {};
        try { d = await r.json(); } catch (e) { /* not JSON */ }
        if (!r.ok || d.success === false) throw new Error(d.error || ('HTTP ' + r.status));
        return d;
    }

    if (form) form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var status = document.getElementById('ba-status');
        var save = document.getElementById('ba-save');
        // Only servers whose box changed: re-saving an unchanged server used to clear its live announcements.
        var changes = boxes().filter(function (b) { return b.checked !== (b.dataset.was === '1'); });
        if (!changes.length) { status.className = 'cf-status-line'; status.textContent = 'Nothing changed.'; return; }
        save.disabled = true;
        status.className = 'cf-status-line is-busy';
        status.textContent = 'Saving ' + changes.length + (changes.length === 1 ? ' server' : ' servers') + '…';
        var failed = [];
        for (var i = 0; i < changes.length; i++) {
            var b = changes[i];
            try {
                await post(b.checked ? BOT : 'default', b.value);
                b.dataset.was = b.checked ? '1' : '0';
            } catch (err) {
                failed.push(b.closest('.ba-item').querySelector('.cf-em').textContent + ': ' + err.message);
            }
        }
        save.disabled = false;
        if (failed.length) {
            status.className = 'cf-status-line is-bad';
            status.textContent = 'Not saved for ' + failed.join('; ');
        } else {
            status.className = 'cf-status-line is-ok';
            status.textContent = 'Saved. Live announcements in changed servers are re-posted by the new bot shortly.';
        }
    });
})();
</script>
<%- include('partials/site-footer') %>
<script src="/js/csrf.js"></script>
</body>
</html>
