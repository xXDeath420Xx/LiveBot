<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Assign Bot to Servers - CertiFried Utility</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --background-primary: #0b0f11;
            --background-secondary: #0f1316;
            --background-tertiary: #171c20;
            --border-color: rgba(167, 139, 250, 0.15);
            --color-text-primary: #e9edf0;
            --color-text-secondary: #a9b4b9;
            --accent-color: #a78bfa;
        }

        body {
            background: var(--background-primary);
            min-height: 100vh;
            color: var(--color-text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .container { max-width: 900px; padding: 40px 20px; }

        .header { color: var(--color-text-primary); margin-bottom: 30px; }
        .header h1 { font-weight: 700; }

        .card {
            background: var(--background-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
            margin-bottom: 24px;
        }

        .card-body { padding: 24px; }

        .bot-info {
            background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
            color: white;
            border: none;
        }

        .status-online { color: #22C55E; }
        .status-offline { color: #EF4444; }

        .guild-item {
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
            transition: background 0.2s;
        }
        .guild-item:last-child { border-bottom: none; }
        .guild-item:hover { background: var(--background-tertiary); }
        .guild-item label { color: var(--color-text-primary); }

        .guild-checkbox {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: var(--accent-color);
        }

        .current-bot { font-size: 0.85em; color: var(--color-text-secondary); }

        .btn-primary {
            background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
            border: none;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(167, 139, 250, 0.35);
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #8b5cf6 0%, #c4b5fd 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(167, 139, 250, 0.5);
        }

        .btn-light {
            background: var(--background-secondary);
            border: 1px solid var(--border-color);
            color: var(--color-text-primary);
        }
        .btn-light:hover {
            background: var(--background-tertiary);
            color: var(--color-text-primary);
        }

        .btn-outline-primary {
            border-color: var(--accent-color);
            color: var(--accent-color);
            background: transparent;
        }
        .btn-outline-primary:hover {
            background: var(--accent-color);
            color: white;
        }

        .btn-outline-secondary {
            border-color: var(--border-color);
            color: var(--color-text-secondary);
            background: transparent;
        }
        .btn-outline-secondary:hover {
            background: var(--background-tertiary);
            color: var(--color-text-primary);
            border-color: var(--border-color);
        }

        .guild-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 15px;
        }

        .guild-icon-placeholder {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--accent-color);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-weight: bold;
            font-size: 20px;
        }

        .text-muted { color: var(--color-text-secondary) !important; }
        .text-danger { color: #EF4444 !important; }

        h5 { color: var(--color-text-primary); }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <a href="/bot-management" class="btn btn-light mb-3">
                <i class="bi bi-arrow-left"></i> Back to Bot Management
            </a>
            <h1><i class="bi bi-diagram-3"></i> Assign Bot to Servers</h1>
        </div>

        <!-- Bot Info Card -->
        <div class="card bot-info">
            <div class="card-body">
                <h3 id="bot-name">Loading...</h3>
                <p class="mb-2" id="bot-status">
                    <i class="bi bi-circle-fill"></i> <span id="status-text">Checking...</span>
                </p>
                <p class="mb-0" id="bot-stats">
                    <i class="bi bi-server"></i> <span id="guilds-count">-</span> Servers |
                    <i class="bi bi-people"></i> <span id="users-count">-</span> Users
                </p>
            </div>
        </div>

        <!-- Guild Assignment Card -->
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Select Servers</h5>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-2" onclick="selectAll()">
                            <i class="bi bi-check-all"></i> Select All
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="clearAll()">
                            <i class="bi bi-x-circle"></i> Clear All
                        </button>
                    </div>
                </div>

                <div id="guilds-list">
                    <p class="text-muted">Loading your servers...</p>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-primary btn-lg" onclick="saveAssignments()">
                        <i class="bi bi-save"></i> Save Assignments
                    </button>
                    <button class="btn btn-outline-secondary" onclick="window.location.href='/bot-management'">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const botId = '<%= botId %>';
        const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
        let guilds = [];
        let currentAssignments = new Set();

        document.addEventListener('DOMContentLoaded', async () => {
            await loadBotInfo();
            await loadGuilds();
        });

        async function loadBotInfo() {
            try {
                const response = await fetch(`/api/bots/${botId}/status`);
                if (!response.ok) {
                    throw new Error('Failed to load bot info');
                }
                const bot = await response.json();

                document.getElementById('bot-name').textContent = bot.username || 'Custom Bot';

                const statusEl = document.getElementById('bot-status');
                if (bot.isReady) {
                    statusEl.innerHTML = '<i class="bi bi-circle-fill status-online"></i> <span id="status-text">Online</span>';
                } else {
                    statusEl.innerHTML = '<i class="bi bi-circle-fill status-offline"></i> <span id="status-text">Offline</span>';
                }

                document.getElementById('guilds-count').textContent = bot.guilds || 0;
                document.getElementById('users-count').textContent = bot.users || 0;

            } catch (error) {
                console.error('Error loading bot info:', error);
                document.getElementById('bot-name').textContent = 'Error Loading Bot';
            }
        }

        async function loadGuilds() {
            try {
                // Load user's guilds from the page data
                const userGuilds = <%- JSON.stringify(userGuilds) %>;
                guilds = userGuilds;

                // Load current assignments
                for (const guild of guilds) {
                    try {
                        const response = await fetch(`/api/guilds/${guild.id}/bot`);
                        const assignment = await response.json();
                        if (assignment.botId === botId) {
                            currentAssignments.add(guild.id);
                        }
                        guild.currentBot = assignment.botId || 'default';
                    } catch (error) {
                        guild.currentBot = 'default';
                    }
                }

                displayGuilds();
            } catch (error) {
                console.error('Error loading guilds:', error);
                document.getElementById('guilds-list').innerHTML = '<p class="text-danger">Error loading servers</p>';
            }
        }

        function displayGuilds() {
            const container = document.getElementById('guilds-list');

            if (guilds.length === 0) {
                container.innerHTML = '<p class="text-muted">No servers found where you have admin permissions.</p>';
                return;
            }

            container.innerHTML = guilds.map(guild => {
                const isAssigned = currentAssignments.has(guild.id);
                const currentBotText = guild.currentBot === botId ? 'This Bot' :
                                       guild.currentBot === 'default' ? 'Default Bot' :
                                       'Other Custom Bot';

                const iconUrl = guild.icon ?
                    `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=96` :
                    null;

                return `
                    <div class="guild-item">
                        <div class="d-flex align-items-center">
                            <input type="checkbox"
                                   class="guild-checkbox me-3"
                                   id="guild-${guild.id}"
                                   data-guild-id="${guild.id}"
                                   ${isAssigned ? 'checked' : ''}>
                            ${iconUrl ?
                                `<img src="${iconUrl}" alt="${escapeHtml(guild.name)}" class="guild-icon">` :
                                `<div class="guild-icon-placeholder">${guild.name.charAt(0).toUpperCase()}</div>`
                            }
                            <div class="flex-grow-1">
                                <label for="guild-${guild.id}" class="mb-0" style="cursor: pointer;">
                                    <strong>${escapeHtml(guild.name)}</strong>
                                </label>
                                <div class="current-bot">
                                    Currently: ${currentBotText}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function selectAll() {
            document.querySelectorAll('.guild-checkbox').forEach(checkbox => {
                checkbox.checked = true;
            });
        }

        function clearAll() {
            document.querySelectorAll('.guild-checkbox').forEach(checkbox => {
                checkbox.checked = false;
            });
        }

        async function saveAssignments() {
            const checkboxes = document.querySelectorAll('.guild-checkbox');
            const selectedGuilds = [];

            checkboxes.forEach(checkbox => {
                if (checkbox.checked) {
                    selectedGuilds.push(checkbox.dataset.guildId);
                }
            });

            // Show loading state
            const saveBtn = event.target;
            const originalText = saveBtn.innerHTML;
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';

            try {
                // Assign to selected guilds
                for (const guildId of selectedGuilds) {
                    await fetch(`/api/bots/${botId}/assign`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                        body: JSON.stringify({ guildId })
                    });
                }

                // Unassign from unchecked guilds
                const unselectedGuilds = guilds
                    .filter(g => !selectedGuilds.includes(g.id) && currentAssignments.has(g.id))
                    .map(g => g.id);

                for (const guildId of unselectedGuilds) {
                    await fetch(`/api/bots/default/assign`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                        body: JSON.stringify({ guildId })
                    });
                }

                alert(`✓ Successfully assigned bot to ${selectedGuilds.length} server(s)`);
                window.location.href = '/bot-management';

            } catch (error) {
                console.error('Error saving assignments:', error);
                alert('Error saving assignments. Please try again.');
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalText;
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
    <script src="/js/csrf.js"></script>
</body>
</html>
