<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%- include('partials/cards-page-css') %>
    <style>
        .hero { padding: 8px 0 32px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 32px; align-items: center; }
        .hero h1 { font-size: 2.1rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
        .hero p { color: var(--cf-text-2); font-size: var(--cf-text-lg); margin: 12px 0 20px; max-width: 520px; line-height: 1.55; }
        .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
        .hero-note { color: var(--cf-text-3); font-size: var(--cf-text-sm); margin-top: 10px; }
        .hero-art { position: relative; height: 240px; }
        .hero-art .sheet { position: absolute; border-radius: 10px; border: 1px solid var(--cf-border-strong); background: var(--cf-surface); box-shadow: var(--cf-shadow-pop, 0 12px 32px rgb(0 0 0 / .35)); padding: 14px; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
        .hero-art .s1 { inset: 0 28% 30% 0; transform: rotate(-3deg); }
        .hero-art .s2 { inset: 22% 0 6% 30%; transform: rotate(2deg); }
        .hero-art .s1 strong, .hero-art .s2 strong { display: block; color: var(--cf-text); font-size: var(--cf-text-lg); margin-bottom: 6px; }
        .hero-art .note { border-top: 1px dashed var(--cf-border); padding-top: 6px; margin-top: 6px; }
        @media (max-width: 760px) { .hero { grid-template-columns: 1fr; padding-top: 0; } .hero-art { display: none; } .hero h1 { font-size: 1.7rem; } }

        .section { margin: 40px 0; }
        .section h2 { font-size: var(--cf-text-xl); font-weight: 600; letter-spacing: -0.01em; }
        .section .sub { color: var(--cf-text-3); font-size: var(--cf-text-md); margin: 4px 0 16px; }

        .occasions { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
        .occasion-card { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); color: var(--cf-text); text-decoration: none; font-size: var(--cf-text-sm); font-weight: 500; transition: border-color .15s, background .15s; }
        .occasion-card:hover { border-color: var(--cf-border-strong); background: var(--cf-surface-2); }
        .occasion-card i { width: 18px; text-align: center; color: var(--cf-text-3); }
        @media (max-width: 420px) { .occasions { grid-template-columns: 1fr 1fr; } }

        .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; counter-reset: step; list-style: none; }
        .step { padding: 16px; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .step::before { counter-increment: step; content: counter(step); display: inline-flex; width: 24px; height: 24px; border-radius: 50%; align-items: center; justify-content: center; background: var(--cf-surface-3); color: var(--cf-text); font-size: var(--cf-text-xs); font-weight: 600; margin-bottom: 8px; }
        .step h3 { font-size: var(--cf-text-md); font-weight: 600; margin-bottom: 4px; }
        .step p { font-size: var(--cf-text-sm); color: var(--cf-text-3); line-height: 1.5; }

        .features { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 0; border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); overflow: hidden; background: var(--cf-surface); }
        .feature { padding: 16px; border-bottom: 1px solid var(--cf-border); border-right: 1px solid var(--cf-border); margin: 0 -1px -1px 0; }
        .feature h3 { font-size: var(--cf-text-md); font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
        .feature h3 i { color: var(--cf-text-3); width: 16px; text-align: center; }
        .feature p { font-size: var(--cf-text-sm); color: var(--cf-text-3); line-height: 1.5; }

        .cta { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 20px; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .cta h2 { font-size: var(--cf-text-lg); font-weight: 600; }
        .cta p { color: var(--cf-text-3); font-size: var(--cf-text-sm); margin-top: 2px; }
    </style>
<%- include('partials/site-head', { title: 'Group cards · CertiFried', description: 'Free group greeting cards for birthdays, farewells and thank-yous. Share one link and everyone adds a message, a GIF, a photo or a voice note. No account needed.', path: '/cards' }) %>
</head>
<body class="cfs-body">
    <%- include('partials/site-header', { user, active: 'cards', returnTo: '/cards' }) %>
    <%- include('partials/section-tabs', { label: 'Group cards', active: 'cards', tabs: [['cards', '/cards', 'Overview'], ['create', '/cards/create', 'Create a card'], ['mine', '/cards/my-cards', 'My cards']] }) %>

    <main class="cfs-main" id="main-content" tabindex="-1">
        <section class="hero">
            <div>
                <h1>Group cards for birthdays, farewells and thank-yous</h1>
                <p>Make a card, share the link, and everyone adds a message, a GIF or a voice note. Free, with no account needed to make or sign one.</p>
                <div class="hero-actions">
                    <a href="/cards/create" class="btn btn-primary btn-lg">Create a card</a>
                    <a href="/cards/my-cards" class="btn btn-secondary btn-lg">My cards</a>
                </div>
                <p class="hero-note">Cards are private: only people with the link can see them.</p>
            </div>
            <div class="hero-art" aria-hidden="true">
                <div class="sheet s1"><strong>Happy birthday, Sam</strong>From the whole team<div class="note">"Best desk neighbour ever." — Jo</div></div>
                <div class="sheet s2"><strong>12 messages</strong><div class="note">"Cake is on me this year." — Alex</div><div class="note">Voice note · 0:24</div></div>
            </div>
        </section>

        <section class="section" aria-labelledby="occ-title">
            <h2 id="occ-title">Start from an occasion</h2>
            <p class="sub">Sets the card's title and look. You can change everything later.</p>
            <div class="occasions">
                <% const occasions = [
                    { id: 'birthday', icon: 'fa-cake-candles', name: 'Birthday' },
                    { id: 'farewell', icon: 'fa-hand', name: 'Farewell' },
                    { id: 'thank-you', icon: 'fa-heart', name: 'Thank you' },
                    { id: 'congratulations', icon: 'fa-champagne-glasses', name: 'Congratulations' },
                    { id: 'retirement', icon: 'fa-umbrella-beach', name: 'Retirement' },
                    { id: 'welcome', icon: 'fa-handshake', name: 'Welcome' },
                    { id: 'anniversary', icon: 'fa-ring', name: 'Anniversary' },
                    { id: 'baby', icon: 'fa-baby', name: 'New baby' },
                    { id: 'get-well', icon: 'fa-kit-medical', name: 'Get well' },
                    { id: 'holidays', icon: 'fa-snowflake', name: 'Holidays' },
                    { id: 'graduation', icon: 'fa-graduation-cap', name: 'Graduation' },
                    { id: 'promotion', icon: 'fa-arrow-trend-up', name: 'Promotion' },
                    { id: 'miss-you', icon: 'fa-envelope-open-text', name: 'Miss you' },
                    { id: 'condolence', icon: 'fa-dove', name: 'Sympathy' },
                    { id: 'custom', icon: 'fa-pen', name: 'Something else' },
                ]; %>
                <% occasions.forEach(o => { %>
                <a href="/cards/create?occasion=<%= o.id %>" class="occasion-card"><i class="fas <%= o.icon %>" aria-hidden="true"></i><%= o.name %></a>
                <% }); %>
            </div>
        </section>

        <section class="section" aria-labelledby="how-title">
            <h2 id="how-title">How it works</h2>
            <p class="sub">Four steps, usually a few minutes.</p>
            <ol class="steps">
                <li class="step"><h3>Create</h3><p>Pick an occasion, name who it's for and choose a background.</p></li>
                <li class="step"><h3>Share</h3><p>Send the signing link to friends, family or coworkers.</p></li>
                <li class="step"><h3>Sign</h3><p>Everyone adds a message, a GIF, a photo, a voice note or a gift card code.</p></li>
                <li class="step"><h3>Deliver</h3><p>Send the card to the recipient, or download it as a PDF or image.</p></li>
            </ol>
        </section>

        <section class="section" aria-labelledby="feat-title">
            <h2 id="feat-title">What a card can hold</h2>
            <p class="sub">All of it is free.</p>
            <div class="features">
                <div class="feature"><h3><i class="fas fa-font" aria-hidden="true"></i>Fonts and colours</h3><p>28 fonts, including handwriting styles, with a live preview.</p></div>
                <div class="feature"><h3><i class="fas fa-image" aria-hidden="true"></i>Generated covers</h3><p>Describe a cover and get an image made for the card.</p></div>
                <div class="feature"><h3><i class="fas fa-microphone" aria-hidden="true"></i>Voice notes</h3><p>Record up to 30 seconds in the browser.</p></div>
                <div class="feature"><h3><i class="fas fa-gift" aria-hidden="true"></i>Gift card codes</h3><p>Stored encrypted and only shown to the recipient and the card's creator.</p></div>
                <div class="feature"><h3><i class="fas fa-images" aria-hidden="true"></i>GIFs, stickers, photos</h3><p>GIF and sticker search, image uploads and YouTube videos.</p></div>
                <div class="feature"><h3><i class="fas fa-music" aria-hidden="true"></i>Music and backgrounds</h3><p>Add a song, your own background or logo, and a password.</p></div>
                <div class="feature"><h3><i class="fas fa-file-arrow-down" aria-hidden="true"></i>PDF and image export</h3><p>Print it or share it as a picture.</p></div>
                <div class="feature"><h3><i class="fas fa-code" aria-hidden="true"></i>Embed</h3><p>An embed code to put the card on a website.</p></div>
            </div>
        </section>

        <section class="cta">
            <div>
                <h2>Make one now</h2>
                <p>No account needed. Log in with Discord if you want your cards listed in one place on every device.</p>
            </div>
            <a href="/cards/create" class="btn btn-primary btn-lg">Create a card</a>
        </section>
    </main>

    <%- include('partials/site-footer') %>
</body>
</html>
