<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>">
<head>
<%- include('partials/site-head', { title: 'Documentation | CertiFried', description: 'How to add CertiFried to a Discord server, set it up, and use its moderation, protection, stream alert, level, music, game and creator features.', path: '/docs' }) %>
<%
  // Guides (dashboard/content/guides, set on app.locals.siteGuides by server.js). Without them the page
  // still renders, with no guide links and no screenshots.
  const _sg = locals.siteGuides || null;
  const _guide = (slug) => (_sg && _sg.getGuide(slug)) || null;
  const _shot = (id) => (_sg && _sg.guideImage(id)) || null;
  const _guideLinks = (slugs) => slugs.map(_guide).filter(Boolean);
  const _e = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const _areaFig = (id) => { const im = _shot(id); const t = im && (im.thumb || im); return t ? { src: t.src, width: t.width, height: t.height, alt: im.alt } : null; };
%>
    <style>
        .docs-steps { list-style: none; counter-reset: step; padding: 0; margin: 0 0 var(--cf-4); }
        .docs-steps > li { counter-increment: step; position: relative; padding: 0 0 var(--cf-5) 40px; margin: 0; }
        .docs-steps > li::before {
            content: counter(step); position: absolute; left: 0; top: 0; width: 26px; height: 26px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: var(--cf-text-xs); font-weight: 600;
            background: var(--cf-surface-2); border: 1px solid var(--cf-border-strong); color: var(--cf-text);
        }
        .docs-steps h3 { margin: 0 0 4px; font-size: var(--cf-text-md); }
        .docs-steps p { margin: 0 0 var(--cf-2); }
        .docs-btns { display: flex; flex-wrap: wrap; gap: var(--cf-2); margin-top: var(--cf-2); }
        .docs-area { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--cf-5); padding: var(--cf-5); margin: 0 0 var(--cf-3); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); scroll-margin-top: calc(var(--cf-header-h) + 16px); }
        .docs-area.has-fig { grid-template-columns: minmax(0, 1fr) 240px; }
        .docs-area h3 { margin: 0 0 var(--cf-2); display: flex; align-items: center; gap: var(--cf-2); flex-wrap: wrap; }
        .docs-area p:last-child, .docs-area ul:last-child { margin-bottom: 0; }
        .docs-fig { margin: 0; align-self: start; }
        .docs-fig img { display: block; width: 100%; height: auto; border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-shot-bg); }
        .docs-cmds { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--cf-2) 0 0; padding: 0; list-style: none; }
        .docs-cmds li { margin: 0; }
        .docs-cmds a { text-decoration: none; }
        .docs-cmds a code { white-space: nowrap; }
        .docs-cmds a:hover code { border-color: var(--cf-border-strong); }
        .docs-guides-line { margin: var(--cf-3) 0 0; font-size: var(--cf-text-sm); }
        .docs-guide-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--cf-6); margin: 0 0 var(--cf-4); padding: 0; list-style: none; }
        .docs-guide-list li { margin: 0; padding: 8px 0; border-bottom: 1px solid var(--cf-border); }
        .docs-guide-list a { font-weight: 500; }
        .docs-guide-list span { display: block; font-size: var(--cf-text-sm); color: var(--cf-text-3); line-height: 1.5; }
        @media (max-width: 760px) {
            .docs-area.has-fig { grid-template-columns: minmax(0, 1fr); }
            .docs-fig { max-width: 360px; }
            .docs-guide-list { grid-template-columns: minmax(0, 1fr); }
        }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: 'docs', user: locals.user || null, returnTo: '/docs' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main cfs-main--wide">
        <div class="cfs-pagehead">
            <h1>Documentation</h1>
            <p class="cfs-lede">How to add CertiFried to your Discord server, set it up, and what each part of the bot does. Every feature is free for every server.</p>
        </div>

        <div class="cfs-doc">
            <nav class="cfs-toc" aria-label="On this page">
                <h2>On this page</h2>
                <ul>
                    <li><a href="#getting-started">Getting started</a></li>
                    <% if (_sg) { %><li><a href="#guides">Guides</a></li><% } %>
                    <li><a href="#using-commands">Using commands</a></li>
                    <li><a href="#features">Features</a>
                        <ul>
                            <li><a href="#moderation">Moderation and protection</a></li>
                            <li><a href="#streams">Stream alerts and feeds</a></li>
                            <li><a href="#levels">Levels, roles and community</a></li>
                            <li><a href="#music">Music and voice</a></li>
                            <li><a href="#games">Games and economy</a></li>
                            <li><a href="#creators">Creator tools</a></li>
                            <li><a href="#web">On the website</a></li>
                        </ul>
                    </li>
                    <li><a href="#kick-defender">Kick Defender</a></li>
                    <li><a href="#privacy">Your data</a></li>
                    <li><a href="#help">Getting help</a></li>
                </ul>
            </nav>

            <div class="cfs-prose">
                <h2 id="getting-started">Getting started</h2>
                <ol class="docs-steps">
                    <li>
                        <h3>Add the bot to your server</h3>
                        <p>You need the Manage Server permission on the server. The standard invite asks only for the permissions the current features use; the Administrator invite is there if you prefer to manage one permission.</p>
                        <div class="docs-btns">
                            <% const _cid = (locals.clientId && /^\d{15,22}$/.test(String(locals.clientId))) ? String(locals.clientId) : (((locals.discoveryUrl || '').match(/(\d{15,22})$/) || [])[1] || null); const _invite = _cid ? 'https://discord.com/oauth2/authorize?client_id=' + _cid + '&permissions=1643797540086&scope=bot+applications.commands' : '/invite'; %><a class="btn btn-primary" href="<%= _invite %>">Add to Discord</a>
                            <% if (locals.clientId) { %><a class="btn btn-secondary" href="https://discord.com/oauth2/authorize?client_id=<%= encodeURIComponent(locals.clientId) %>&amp;permissions=8&amp;scope=bot+applications.commands" rel="noopener">Add with Administrator</a><% } %>
                        </div>
                    </li>
                    <li>
                        <h3>Run <code>/setup</code></h3>
                        <p>The setup wizard shows what is already running and offers presets, or walks through each category so you can turn features on or leave them off. You can change everything later.</p>
                    </li>
                    <li>
                        <h3>Open the dashboard</h3>
                        <p>Log in with Discord and pick your server. Every setting has a page on the dashboard, with a short explanation at the top, and the overview has a setup checklist that links to each step.</p>
                        <div class="docs-btns"><a class="btn btn-secondary" href="/dashboard">Open the dashboard</a><% if (_guide('getting-started')) { %><a class="btn btn-secondary" href="/docs/guides/getting-started">Read the getting started guide</a><% } %></div>
                    </li>
                </ol>

                <% if (_sg) { %>
                <h2 id="guides">Guides</h2>
                <p>Step-by-step guides with screenshots: what the result looks like in Discord, then the exact command or dashboard setting for each step. <a href="/docs/guides">Browse all guides</a>.</p>
                <ul class="docs-guide-list">
                    <% _sg.GUIDES.forEach(function (g) { %><li><a href="/docs/guides/<%= g.slug %>"><%= g.title %></a><span><%= g.summary %></span></li><% }); %>
                </ul>
                <% } %>

                <h2 id="using-commands">Using commands</h2>
                <p>Admin, setup, moderation and private commands are slash commands: type <code>/</code> in Discord and pick one from the list. Game, fun and lookup commands, such as <code>/economy</code>, <code>/arcade</code> and <code>/rpg</code>, are not in that list: type them as an ordinary message that starts with <code>/</code>, for example <code>/economy bank balance</code>. By default every command also works with the prefixes <code>!</code>, <code>?</code>, <code>$</code> or <code>.</code>, or by mentioning the bot; server admins can change the prefixes.</p>
                <p>Server admins can add their own short names for commands, turn individual commands off, and write custom commands, which can remember values for each member or for the whole server. All of this is on the dashboard. The <a href="/commands">command list</a> has every command with its options and the permissions it needs.</p>

                <h2 id="features">Features</h2>
                <p>Most features are off until you turn them on, either with <code>/setup</code> or on the dashboard.</p>

                <% let _f = _areaFig('moderation-discord'); %>
                <div class="docs-area<%= _f ? ' has-fig' : '' %>" id="moderation">
                    <div>
                        <h3>Moderation and protection</h3>
                        <p>Moderation commands with a case history, ban requests from moderators who cannot ban (in servers that have <code>/ban</code>), escalation rules for repeat offences, automod rules, raid detection and lockdown, pausing member DMs and invites during a raid, anti-nuke limits for staff actions, a join gate, scam and phishing link removal backed by a shared list of known scam domains, name and avatar filters, a cross-server ban list servers can opt into, verification, and logs of what happens in the server, which <code>/manage logs-setup</code> can lay out in private channels for you.</p>
                        <ul class="docs-cmds" aria-label="Commands">
                            <li><a href="/commands#admin"><code>/admin mod</code></a></li>
                            <li><a href="/commands#protection"><code>/protection</code></a></li>
                            <li><a href="/commands#lockdown"><code>/lockdown</code></a></li>
                            <li><a href="/commands#globalban"><code>/globalban</code></a></li>
                            <li><a href="/commands#namefilter"><code>/moderation namefilter</code></a></li>
                            <li><a href="/commands#logs-setup"><code>/manage logs-setup</code></a></li>
                            <li><a href="/commands#support"><code>/support</code></a></li>
                        </ul>
                        <% const _gl = _guideLinks(['moderation', 'raid-protection', 'support-tickets']); if (_gl.length) { %><p class="docs-guides-line">Guides: <%- _gl.map((g) => `<a href="/docs/guides/${g.slug}">${_e(g.title)}</a>`).join(', ') %></p><% } %>
                    </div>
                    <% if (_f) { %><figure class="docs-fig"><img src="<%= _f.src %>" alt="<%= _f.alt %>" width="<%= _f.width %>" height="<%= _f.height %>" loading="lazy" decoding="async"></figure><% } %>
                </div>

                <% _f = _areaFig('go-live-discord'); %>
                <div class="docs-area<%= _f ? ' has-fig' : '' %>" id="streams">
                    <div>
                        <h3>Stream alerts and feeds</h3>
                        <p>Go-live posts for Twitch, YouTube, Kick, TikTok and Rumble streamers, with optional live roles. New-post feeds for X (Twitter), YouTube uploads, Bluesky and RSS (blogs, podcasts), and patch notes for 75+ games. Event schedules with a public page, and Twitch schedules posted as an image. For Twitch channels you connect, the dashboard adds stream analytics and moderation tools. A personal stream bot runs your own automations on Twitch and Kick events: chat replies, Discord posts, counters and webhooks.</p>
                        <p><span class="cfs-badge cfs-badge--off">Not available</span> Reddit feeds and Auto memes: Reddit no longer lets bots read subreddits.</p>
                        <ul class="docs-cmds" aria-label="Commands">
                            <li><a href="/commands#socials"><code>/socials streamer</code></a></li>
                            <li><a href="/commands#socials"><code>/socials twitter</code></a></li>
                            <li><a href="/commands#socials"><code>/socials feed</code></a></li>
                            <li><a href="/commands#stream"><code>/stream</code></a></li>
                            <li><a href="/commands#schedule"><code>/schedule</code></a></li>
                        </ul>
                        <% const _gs = _guideLinks(['go-live-alerts', 'social-feeds', 'schedules', 'stream-bot']); if (_gs.length) { %><p class="docs-guides-line">Guides: <%- _gs.map((g) => `<a href="/docs/guides/${g.slug}">${_e(g.title)}</a>`).join(', ') %></p><% } %>
                    </div>
                    <% if (_f) { %><figure class="docs-fig"><img src="<%= _f.src %>" alt="<%= _f.alt %>" width="<%= _f.width %>" height="<%= _f.height %>" loading="lazy" decoding="async"></figure><% } %>
                </div>

                <% _f = _areaFig('levels-discord'); %>
                <div class="docs-area<%= _f ? ' has-fig' : '' %>" id="levels">
                    <div>
                        <h3>Levels, roles and community</h3>
                        <p>XP and levels with role rewards and customisable rank cards, and a public leaderboard page for your server. Reaction roles, welcome messages and cards, birthdays with a birthday role for 24 hours, suggestions (optionally held for staff approval before members can vote), a starboard, question of the day, giveaways, achievements, tags, support tickets with forms and transcripts, and a weekly recap of server activity.</p>
                        <ul class="docs-cmds" aria-label="Commands">
                            <li><a href="/commands#level"><code>/level</code></a></li>
                            <li><a href="/commands#rankcard"><code>/rankcard</code></a></li>
                            <li><a href="/commands#engage"><code>/engage</code></a></li>
                            <li><a href="/commands#manage"><code>/manage roles</code></a></li>
                            <li><a href="/commands#qotd"><code>/qotd</code></a></li>
                            <li><a href="/commands#weekly-recap"><code>/weekly-recap</code></a></li>
                        </ul>
                        <% const _gc = _guideLinks(['levels', 'welcome', 'reaction-roles', 'community']); if (_gc.length) { %><p class="docs-guides-line">Guides: <%- _gc.map((g) => `<a href="/docs/guides/${g.slug}">${_e(g.title)}</a>`).join(', ') %></p><% } %>
                    </div>
                    <% if (_f) { %><figure class="docs-fig"><img src="<%= _f.src %>" alt="<%= _f.alt %>" width="<%= _f.width %>" height="<%= _f.height %>" loading="lazy" decoding="async"></figure><% } %>
                </div>

                <% _f = _areaFig('music-discord'); %>
                <div class="docs-area<%= _f ? ' has-fig' : '' %>" id="music">
                    <div>
                        <h3>Music and voice</h3>
                        <p>Music from YouTube, Spotify and SoundCloud links or searches (a SoundCloud track that cannot be streamed plays from YouTube instead), with a queue, playlists, filters, lyrics, vote skip and 24/7 mode. The AI DJ picks songs to a prompt, mood or genre and talks between tracks with a text-to-speech voice. Voice rooms members can manage themselves, a chat reader, and live transcription that members can opt out of.</p>
                        <ul class="docs-cmds" aria-label="Commands">
                            <li><a href="/commands#music"><code>/music</code></a></li>
                            <li><a href="/commands#music"><code>/music dj</code></a></li>
                            <li><a href="/commands#voice"><code>/voice</code></a></li>
                            <li><a href="/commands#soundboard"><code>/soundboard</code></a></li>
                        </ul>
                        <% const _gm = _guideLinks(['music']); if (_gm.length) { %><p class="docs-guides-line">Guide: <%- _gm.map((g) => `<a href="/docs/guides/${g.slug}">${_e(g.title)}</a>`).join(', ') %></p><% } %>
                    </div>
                    <% if (_f) { %><figure class="docs-fig"><img src="<%= _f.src %>" alt="<%= _f.alt %>" width="<%= _f.width %>" height="<%= _f.height %>" loading="lazy" decoding="async"></figure><% } %>
                </div>

                <% _f = _areaFig('economy-discord'); %>
                <div class="docs-area<%= _f ? ' has-fig' : '' %>" id="games">
                    <div>
                        <h3>Games and economy</h3>
                        <p>A server economy (earning, a bank, shop, pets, heists, trades and gambling games), Greenhouse Tycoon on the website and in Discord, a Dungeons &amp; Dragons 5e game with an AI Dungeon Master (see the <a href="/docs/rpg">D&amp;D guide</a>), word games (Last Letter, One Word Story, Coordle and WordSeek), Cards Against Humanity in Discord or the browser, counting, trivia, hangman, bracket tournaments and more.</p>
                        <p>OwO Hunt is off by default; turn it on by typing <code>/owo toggle enabled:True</code> as a message, or on its dashboard page.</p>
                        <ul class="docs-cmds" aria-label="Commands">
                            <li><a href="/commands#economy"><code>/economy</code></a></li>
                            <li><a href="/commands#arcade"><code>/arcade</code></a></li>
                            <li><a href="/commands#rpg"><code>/rpg</code></a></li>
                            <li><a href="/commands#wordgame"><code>/wordgame</code></a></li>
                            <li><a href="/commands#cah"><code>/cah</code></a></li>
                            <li><a href="/commands#tournament"><code>/tournament</code></a></li>
                            <li><a href="/commands#owo"><code>/owo</code></a></li>
                        </ul>
                        <% const _gg = _guideLinks(['economy', 'greenhouse']); if (_gg.length) { %><p class="docs-guides-line">Guides: <%- _gg.map((g) => `<a href="/docs/guides/${g.slug}">${_e(g.title)}</a>`).join(', ') %></p><% } %>
                    </div>
                    <% if (_f) { %><figure class="docs-fig"><img src="<%= _f.src %>" alt="<%= _f.alt %>" width="<%= _f.width %>" height="<%= _f.height %>" loading="lazy" decoding="async"></figure><% } %>
                </div>

                <div class="docs-area" id="creators">
                    <div>
                        <h3>Creator tools</h3>
                        <p>Supporter announcements and roles for Ko-fi, and announcements for your own Buy Me a Coffee page; Throne wishlist tracking; Fourthwall shop notifications; and stream team applications, where each application opens a private ticket between the applicant and the team owner.</p>
                        <ul class="docs-cmds" aria-label="Commands">
                            <li><a href="/commands#kofi"><code>/creator kofi</code></a></li>
                            <li><a href="/commands#buymeacoffee"><code>/creator buymeacoffee</code></a></li>
                            <li><a href="/commands#throne"><code>/creator throne</code></a></li>
                            <li><a href="/commands#fourthwall"><code>/fourthwall</code></a></li>
                        </ul>
                    </div>
                </div>

                <div class="docs-area" id="web">
                    <div>
                        <h3>On the website</h3>
                        <ul>
                            <li><a href="/greenhouse">Greenhouse Tycoon</a>: grow and breed plants, with seasons and weekly challenges; play with Discord, Twitch or Kick.</li>
                            <li><a href="/cards">Group greeting cards</a>: a card many people can sign, with messages, images, GIFs and short voice messages. No account needed; a card can be connected to a Discord server later.</li>
                            <li><a href="/cah">Cards Against Humanity</a> in the browser, sharing decks and settings with the Discord version.</li>
                            <li><a href="/schedule">Event schedules</a> for marathons and stream schedules made with <code>/schedule</code>.</li>
                            <li><a href="/stream-team">Stream team applications</a>.</li>
                            <li><a href="/sprites">Fortnite sprite tracker</a>.</li>
                            <li><a href="/scams">Scam link lookup</a>: check a domain against the list the bot uses.</li>
                        </ul>
                    </div>
                </div>

                <h2 id="kick-defender">Kick Defender</h2>
                <p>The Kick Defender is a shared ban list for Kick channels. Log in at <a href="/kick">certifriedmultitool.com/kick</a> with your Kick account and your channel is protected from the moment you connect: accounts banned in one connected channel, and known scam links, are removed in all of them. You can turn protection off or on for each channel at any time.<% if (_guide('kick-defender')) { %> The <a href="/docs/guides/kick-defender">Kick Defender guide</a> walks through it with screenshots.<% } %></p>
                <h3>Getting started</h3>
                <ol>
                    <li>Go to <a href="/kick">/kick</a> and log in with Kick.</li>
                    <li>Your channel is registered and the defender is turned on.</li>
                    <li>If asked, authorize again so the bot can ban and remove messages, and select <strong>Connect chat</strong> if the chat connection is not connected.</li>
                </ol>
                <h3>Settings for each channel</h3>
                <ul>
                    <li><strong>Ban length</strong>: permanent (the default) or a timed ban in minutes.</li>
                    <li><strong>Scam-link strikes before a ban</strong>: how many known scam links someone may post before they are banned (default 2; the first one is deleted with a warning).</li>
                    <li><strong>Scam-link warning</strong>: shown when a scam link is removed; <code>{{username}}</code> mentions the sender.</li>
                    <li><strong>Allowed domains</strong>: up to 50 domains that are never treated as scam links.</li>
                </ul>
                <h3>Managers</h3>
                <p>Managers, chosen by the owner, look after the shared lists at <a href="/kick/managers">/kick/managers</a>: the ban list, the sublist (fast defence against raids and bots), the protection list of accounts that are never actioned, and manually added scam domains. A lookup checks any domain against the block list.</p>
                <h3>Chat commands</h3>
                <p>In Kick chat: <code>!kbd-info</code> (help), <code>!check-ban &lt;user&gt;</code> and <code>!ping</code>. Managers also have <code>!add-ban</code>, <code>!remove-ban</code>, <code>!add-sublist</code>, <code>!add-unban</code> and <code>!mod-check</code>.</p>

                <h2 id="privacy">Your data</h2>
                <p>Anyone can see, export or delete what the bot holds about them with <code>/privacy</code>, in any server or in a DM with the bot: <code>/privacy export</code> sends a file by DM, <code>/privacy delete</code> removes your activity, levels, economy, game progress and linked accounts, and <code>/privacy opt-out</code> stops message logging or hides you from leaderboards. Greenhouse Tycoon players who sign in only with Twitch or Kick can download or delete their save from the game's Profile tab, under Your data. The <a href="/privacy">Privacy Policy</a> lists what is kept and for how long.<% if (_guide('privacy')) { %> See the <a href="/docs/guides/privacy">guide to your data</a> for each step.<% } %></p>

                <h2 id="help">Getting help</h2>
                <ul>
                    <li><a href="/discord" rel="noopener">Support server</a>: ask the team and other server owners.</li>
                    <li><a href="/status">Status</a>: whether the bot, the dashboard and the platforms it relies on are up.</li>
                    <li><a href="/report">Report a user</a> to the cross-server ban list, or <a href="/appeal">appeal a ban</a> on it.</li>
                    <li><a href="/changelog">Changelog</a>: recent changes to the bot.</li>
                </ul>
            </div>
        </div>
    </main>
<%- include('partials/site-footer') %>
<script>
(function () {
    // Highlight the contents entry for the section in view.
    var links = Array.prototype.slice.call(document.querySelectorAll('.cfs-toc a[href^="#"]'));
    if (!('IntersectionObserver' in window) || !links.length) return;
    var byId = {};
    links.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
    var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            links.forEach(function (a) { a.classList.remove('is-current'); });
            var a = byId[e.target.id];
            if (a) a.classList.add('is-current');
        });
    }, { rootMargin: '-64px 0px -70% 0px' });
    Object.keys(byId).forEach(function (id) { var el = document.getElementById(id); if (el) obs.observe(el); });
})();
</script>
</body>
</html>
