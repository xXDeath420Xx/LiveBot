<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<style>
    .container.cah-wide { max-width: 1200px; } /* same width as the site header */
    .hero { padding: 24px 0 16px; }
    .hero h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; }
    .hero p { color: var(--cf-text-3); margin-top: 4px; font-size: var(--cf-text-md); max-width: 680px; }

    .filter-bar { display: flex; flex-wrap: wrap; gap: 8px 12px; padding: 12px; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); margin-bottom: 12px; align-items: center; }
    .filter-bar input[type=search] { flex: 1 1 260px; min-width: 0; }
    .filter-bar select { flex: 0 0 auto; width: auto; }
    .filter-bar label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
    .filter-bar label input { accent-color: var(--cf-accent); width: 16px; height: 16px; }
    .filter-bar .btn { margin-left: auto; }
    @media (max-width: 600px) { .filter-bar select, .filter-bar .btn { flex: 1 1 100%; margin-left: 0; } }

    .pack-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 10px; }
    .pack-tile { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; transition: border-color 0.15s; cursor: pointer; text-align: left; color: inherit; font: inherit; width: 100%; min-width: 0; }
    .pack-tile:hover { border-color: var(--cf-border-strong); background: var(--cf-surface-2); }
    .pack-tile .name { font-weight: 600; font-size: var(--cf-text-md); line-height: 1.3; overflow-wrap: anywhere; }
    .pack-tile .source { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .pack-tile .source code { font-family: var(--cf-mono); }
    .pack-tile .stats { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px; }
    .pack-tile .desc { color: var(--cf-text-2); font-size: var(--cf-text-sm); line-height: 1.4; min-height: 2.5em; overflow-wrap: anywhere; }

    .result-meta { color: var(--cf-text-3); font-size: var(--cf-text-sm); margin: 0 2px 10px; }
    .pager { display: flex; gap: 8px; justify-content: center; align-items: center; padding: 20px 0 72px; color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .empty { padding: 32px 20px; text-align: center; color: var(--cf-text-3); background: var(--cf-surface); border: 1px dashed var(--cf-border); border-radius: var(--cf-radius-lg); font-size: var(--cf-text-sm); }

    /* Preview dialog */
    .preview-mask { position: fixed; inset: 0; background: rgb(0 0 0 / 0.6); display: none; align-items: center; justify-content: center; z-index: 1100; padding: 16px; }
    .preview-mask.open { display: flex; }
    .preview-box { background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-lg); max-width: 600px; width: 100%; max-height: 85vh; overflow: auto; box-shadow: var(--cf-shadow-pop, 0 16px 48px rgb(0 0 0 / .45)); }
    .preview-head { padding: 14px 18px; border-bottom: 1px solid var(--cf-border); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .preview-head h2 { font-size: var(--cf-text-lg); font-weight: 600; overflow-wrap: anywhere; }
    .preview-head small { color: var(--cf-text-3); font-family: var(--cf-mono); }
    .preview-body { padding: 14px 18px; }
    .preview-body h3 { font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text-2); margin: 0 0 6px; }
    .preview-body h3 + .preview-cards + h3 { margin-top: 16px; }
    .preview-cards { display: flex; flex-direction: column; gap: 6px; }
    .preview-card { padding: 10px 12px; border-radius: 8px; font-size: var(--cf-text-sm); line-height: 1.35; overflow-wrap: anywhere; }
    .preview-card.white { background: #f5f5f0; color: #111; font-weight: 500; }
    .preview-card.black { /* theme: fixed (CAH card face: black by design) */ background: #000; color: #fff; font-weight: 600; }
    .preview-card .pick { float: right; margin-left: 8px; color: #bbb; font-size: 0.72rem; font-weight: 700; }
    .preview-status { color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .icon-btn { background: none; border: 1px solid transparent; color: var(--cf-text-3); cursor: pointer; padding: 6px; line-height: 0; border-radius: var(--cf-radius); }
    .icon-btn:hover { color: var(--cf-text); background: var(--cf-surface-2); }
    .icon-btn svg { width: 18px; height: 18px; }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Browse Packs — CertiFried CAH', description: 'Cards Against Humanity on CertiFried MultiTool: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'packs' }) %>
<%- include('components/cah-breadcrumbs', { crumbs: [{ href: '/cah', label: 'CAH' }, { label: 'Card packs' }] }) %>

<%
    const curPage = (typeof page !== 'undefined' && page) ? page : 1;
    const pages = (typeof pageCount !== 'undefined' && pageCount) ? pageCount : 1;
    const perPage = (typeof pageSize !== 'undefined' && pageSize) ? pageSize : 200;
    const pageHref = (p) => '/cah/packs?' + new URLSearchParams(Object.assign({}, search ? { q: search } : {}, sort !== 'recent' ? { sort } : {}, includeNsfw ? { nsfw: '1' } : {}, includeNonEn ? { lang: 'all' } : {}, p > 1 ? { page: String(p) } : {})).toString();
    const firstShown = total ? (curPage - 1) * perPage + 1 : 0;
%>
<main class="container cah-wide" id="main-content">
    <section class="hero">
        <h1>Card packs</h1>
        <p>Select a pack to see some of its cards. To play with it, tick it on the Card packs tab when you host a game.</p>
    </section>

    <form class="filter-bar" method="GET" action="/cah/packs" role="search">
        <input type="search" class="form-input" name="q" aria-label="Search packs" placeholder="Search by name or code" value="<%= search %>">
        <select name="sort" class="form-select" aria-label="Sort">
            <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>>Newest first</option>
            <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name (A–Z)</option>
            <option value="size" <%= sort === 'size' ? 'selected' : '' %>>Most cards</option>
        </select>
        <label><input type="checkbox" name="nsfw" value="1" <%= includeNsfw ? 'checked' : '' %>> Include NSFW</label>
        <label><input type="checkbox" name="lang" value="all" <%= includeNonEn ? 'checked' : '' %>> All languages</label>
        <button type="submit" class="btn btn-primary btn-sm">Search</button>
    </form>

    <% if (!packs.length) { %>
        <div class="empty">No packs match. Try a shorter search or include NSFW and other languages.</div>
    <% } else { %>
    <div class="result-meta"><%= firstShown.toLocaleString() %>–<%= (firstShown + packs.length - 1).toLocaleString() %> of <%= total.toLocaleString() %> packs</div>

    <div class="pack-grid">
        <% packs.forEach(d => { %>
            <button type="button" class="pack-tile" data-id="<%= d.id %>" data-name="<%= d.name %>" data-code="<%= d.cast_id || '' %>">
                <span class="source"><%= d.source === 'custom' ? 'Community deck' : (d.source === 'builtin' ? 'Built in' : 'Imported') %><% if (d.cast_id) { %> · <code><%= d.cast_id %></code><% } %></span>
                <span class="name"><%= d.name %></span>
                <span class="desc"><%= (d.description || '').slice(0, 120) %></span>
                <span class="stats">
                    <span class="pill"><%= d.white_count %> white</span>
                    <span class="pill"><%= d.black_count %> black</span>
                    <% if (d.nsfw) { %><span class="pill pill-red">NSFW</span><% } %>
                </span>
            </button>
        <% }); %>
    </div>
    <% if (pages > 1) { %>
        <nav class="pager" aria-label="Pages">
            <% if (curPage > 1) { %><a class="btn btn-outline btn-sm" href="<%= pageHref(curPage - 1) %>">Previous</a><% } %>
            <span>Page <%= curPage %> of <%= pages %></span>
            <% if (curPage < pages) { %><a class="btn btn-outline btn-sm" href="<%= pageHref(curPage + 1) %>">Next</a><% } %>
        </nav>
    <% } else { %>
        <div style="height: 72px;"></div>
    <% } %>
    <% } %>
</main>

<div class="preview-mask" id="preview-mask" onclick="if(event.target===this)closePreview()">
    <div class="preview-box" role="dialog" aria-modal="true" aria-labelledby="preview-name">
        <div class="preview-head">
            <div>
                <h2 id="preview-name"></h2>
                <small id="preview-code"></small>
            </div>
            <button type="button" class="icon-btn" onclick="closePreview()" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <div class="preview-body">
            <p class="preview-status" id="preview-status" role="status"></p>
            <h3>Some black cards</h3>
            <div class="preview-cards" id="preview-black"></div>
            <h3>Some white cards</h3>
            <div class="preview-cards" id="preview-white"></div>
        </div>
    </div>
</div>

<script>
    async function preview(id, name, code) {
        document.getElementById('preview-name').textContent = name;
        document.getElementById('preview-code').textContent = code || '';
        document.getElementById('preview-black').replaceChildren();
        document.getElementById('preview-white').replaceChildren();
        document.getElementById('preview-mask').classList.add('open');
        const status = document.getElementById('preview-status');
        status.textContent = 'Loading…';
        let data;
        try {
            const res = await cfetch('/cah/packs/' + id + '/preview');
            data = await res.json();
        } catch (_) { data = { ok: false }; }
        if (!data.ok) { status.textContent = 'Could not load this pack.'; return; }
        status.textContent = (data.sampleBlack.length || data.sampleWhite.length) ? '' : 'This pack has no cards.';
        for (const b of data.sampleBlack) {
            const div = document.createElement('div'); div.className = 'preview-card black';
            const pick = document.createElement('span'); pick.className = 'pick'; pick.textContent = 'Pick ' + b.pick;
            div.appendChild(pick);
            div.appendChild(document.createTextNode(b.text.replace(/_____/g, '_______')));
            document.getElementById('preview-black').appendChild(div);
        }
        for (const t of data.sampleWhite) {
            const div = document.createElement('div'); div.className = 'preview-card white';
            div.textContent = t;
            document.getElementById('preview-white').appendChild(div);
        }
    }
    // Tiles carry their pack in data-* (pack names can contain quotes, so no inline onclick).
    document.querySelector('.pack-grid')?.addEventListener('click', (e) => {
        const t = e.target.closest('.pack-tile');
        if (t) preview(parseInt(t.dataset.id, 10), t.dataset.name, t.dataset.code);
    });
    function closePreview() { document.getElementById('preview-mask').classList.remove('open'); }
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePreview(); });
</script>
<%- include('partials/site-footer') %>
</body>
</html>
