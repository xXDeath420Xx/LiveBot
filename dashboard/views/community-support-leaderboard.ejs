<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>">
<head>
<%
    const _guild = (typeof guild !== 'undefined' && guild) ? guild : null;
    const _users = (typeof users !== 'undefined' && Array.isArray(users)) ? users : [];
    const _pg = (typeof pagination !== 'undefined' && pagination) ? pagination : null;
    const _err = (typeof error !== 'undefined' && error) ? error : null;
    const _admin = (typeof isAdmin !== 'undefined' && isAdmin) ? true : false;
    const _months = (typeof availableMonths !== 'undefined' && Array.isArray(availableMonths)) ? availableMonths : [];
    const _month = (typeof monthKey !== 'undefined' && monthKey) ? monthKey : null;
    const _entries = (typeof entriesByUser !== 'undefined' && entriesByUser) ? entriesByUser : {};
    const _scoring = (typeof scoring !== 'undefined' && scoring) ? scoring : null;
    const _monthLabel = (m) => { const [y, mo] = String(m).split('-'); const d = new Date(Date.UTC(parseInt(y, 10), parseInt(mo, 10) - 1, 1)); return isNaN(d) ? m : d.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }); };
    const _title = _guild ? _guild.name + ' supporters · CertiFried' : 'Supporters not found · CertiFried';
%>
<%- include('partials/site-head', { title: _title, description: _guild ? 'Monthly raid and support leaderboard for the ' + _guild.name + ' Discord server.' : 'Community supporters leaderboard.', path: _guild ? '/supporters/' + _guild.id : null, noindex: !_guild }) %>
    <style>
        .lb-guild { display: flex; align-items: center; gap: var(--cf-4); }
        .lb-guild img { width: 56px; height: 56px; border-radius: 14px; flex: none; background: var(--cf-surface-2); }
        .lb-guild h1 { margin: 0; }
        .lb-guild .cfs-meta { margin-top: 4px; }
        .lb-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--cf-3); margin: 0 0 var(--cf-4); }
        .lb-tools label { font-size: var(--cf-text-sm); color: var(--cf-text-2); margin-right: var(--cf-2); }
        .lb-tools select { min-width: 180px; }
        .lb-scoring { display: flex; flex-wrap: wrap; gap: 6px; font-size: var(--cf-text-xs); }
        .lb-table-wrap { position: relative; overflow-x: auto; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .lb { width: 100%; border-collapse: collapse; font-size: var(--cf-text-sm); }
        .lb th { padding: 9px 14px; font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); text-align: left; border-bottom: 1px solid var(--cf-border); white-space: nowrap; }
        .lb td { padding: 10px 14px; border-bottom: 1px solid var(--cf-border); vertical-align: middle; }
        .lb > tbody > tr:last-child > td { border-bottom: 0; }
        .lb .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .lb .lb-rank-col { width: 56px; }
        .lb-rank { display: inline-flex; align-items: center; justify-content: center; min-width: 28px; height: 28px; padding: 0 6px; border-radius: 999px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--cf-text-2); background: var(--cf-surface-2); }
        .lb-rank.top { color: var(--cf-on-accent); background: var(--cf-accent); }
        .lb-member { display: flex; align-items: center; gap: var(--cf-3); min-width: 0; }
        .lb-member img { width: 32px; height: 32px; border-radius: 50%; flex: none; }
        .lb-who { min-width: 0; }
        .lb-name { display: block; font-weight: 500; color: var(--cf-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 28ch; }
        .lb-handle { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .lb-toggle { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
        .lb-toggle .chev { width: 14px; height: 14px; color: var(--cf-text-3); transition: transform var(--cf-fast) var(--cf-ease); flex: none; }
        .lb-toggle[aria-expanded="true"] .chev { transform: rotate(90deg); }
        .lb-sub { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .lb-detail > td { padding: 0 14px 12px; background: var(--cf-inset); }
        .lb-detail[hidden] { display: none; }
        .lb-detail-scroll { overflow-x: auto; }
        .lb-entries { width: 100%; border-collapse: collapse; font-size: var(--cf-text-xs); }
        .lb-entries th, .lb-entries td { padding: 7px 8px; border-bottom: 1px solid var(--cf-border); text-align: left; white-space: nowrap; }
        .lb-entries tr:last-child td { border-bottom: 0; }
        .lb-entries a { color: var(--cf-accent-fg); }
        .lb-actions { display: inline-flex; gap: 4px; }
        .lb-pager { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px; margin-top: var(--cf-5); }
        .lb-pager a, .lb-pager span { min-width: 40px; height: 40px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--cf-radius); font-size: var(--cf-text-sm); text-decoration: none; color: var(--cf-text-2); border: 1px solid var(--cf-border); background: var(--cf-surface); }
        .lb-pager a:hover { color: var(--cf-text); border-color: var(--cf-border-strong); }
        .lb-pager [aria-current="page"] { color: var(--cf-on-accent); background: var(--cf-accent); border-color: var(--cf-accent); font-weight: 600; }
        .lb-pager .gap { border: 0; background: none; min-width: 0; padding: 0 4px; }
        .lb-count { margin-top: var(--cf-3); text-align: center; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        /* Admin edit dialog */
        .lb-dialog { width: min(420px, calc(100vw - 32px)); padding: 0; border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); background: var(--cf-surface); color: var(--cf-text); box-shadow: var(--cf-shadow-pop); }
        .lb-dialog::backdrop { background: rgba(0, 0, 0, 0.6); }
        .lb-dialog form { padding: var(--cf-5); display: flex; flex-direction: column; gap: var(--cf-3); }
        .lb-dialog h2 { margin: 0 0 var(--cf-1); font-size: var(--cf-text-lg); }
        .lb-dialog label { display: block; margin-bottom: 4px; font-size: var(--cf-text-sm); font-weight: 500; }
        .lb-dialog input, .lb-dialog select { width: 100%; }
        .lb-dialog .row-actions { display: flex; justify-content: flex-end; gap: var(--cf-2); margin-top: var(--cf-2); }
        .lb-toast { position: fixed; right: 16px; bottom: 16px; z-index: 10000; max-width: min(420px, calc(100vw - 32px)); padding: 10px 14px; border-radius: var(--cf-radius-lg); background: var(--cf-surface); border: 1px solid var(--cf-border-strong); box-shadow: var(--cf-shadow-pop); font-size: var(--cf-text-sm); }
        .lb-toast[hidden] { display: none; }
        .lb-toast.is-error { border-color: var(--cf-danger); }
        @media (max-width: 640px) { .lb .hide-sm, .lb-entries .hide-sm { display: none; } .lb-name { max-width: 16ch; } .lb td, .lb th { padding-left: 10px; padding-right: 10px; } }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', user: locals.user || null, returnTo: _guild ? '/supporters/' + _guild.id : '/' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main">
        <% if (!_guild) { %>
            <div class="cfs-rows"><div class="cfs-empty">
                <h1 class="cfs-h2">Supporters not found</h1>
                <p><%= _err || 'This server could not be found.' %></p>
            </div></div>
        <% } else { %>
            <div class="cfs-pagehead">
                <div class="lb-guild">
                    <img src="<%= _guild.icon ? 'https://cdn.discordapp.com/icons/' + _guild.id + '/' + _guild.icon + '.png?size=128' : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" width="56" height="56">
                    <div>
                        <span class="cfs-eyebrow">Community supporters</span>
                        <h1><%= _guild.name %></h1>
                        <p class="cfs-meta"><%= Number(_guild.memberCount || 0).toLocaleString('en-US') %> members</p>
                    </div>
                </div>
            </div>

            <% if (_err) { %>
                <div class="cfs-rows"><div class="cfs-empty"><p><%= _err %></p></div></div>
            <% } else { %>
                <div class="lb-tools">
                    <% if (_months.length) { %>
                    <form method="get" action="/supporters/<%= _guild.id %>" id="lb-month-form">
                        <label for="month-select">Month</label>
                        <select id="month-select" name="month" class="form-select">
                            <% _months.forEach(function (m) { %><option value="<%= m %>"<%= m === _month ? ' selected' : '' %>><%= _monthLabel(m) %></option><% }) %>
                        </select>
                        <noscript><button type="submit" class="btn btn-secondary btn-sm">Show</button></noscript>
                    </form>
                    <% } %>
                    <% if (_scoring) { %>
                    <div class="lb-scoring" aria-label="How points are earned">
                        <span class="cfs-badge">Raid a non-affiliate: <%= _scoring.raidNonAffiliate %> pts</span>
                        <span class="cfs-badge">Raid an affiliate: <%= _scoring.raidAffiliate %> pts</span>
                        <span class="cfs-badge">Support: <%= _scoring.support %> pts</span>
                    </div>
                    <% } %>
                </div>

                <% if (!_users.length) { %>
                    <div class="cfs-rows"><div class="cfs-empty"><h2>No supporters this month yet</h2><p>Members earn points by raiding and supporting other streamers and posting it in the server's raid and support channels.</p></div></div>
                <% } else { %>
                    <div class="lb-table-wrap">
                        <table class="lb">
                            <thead>
                                <tr>
                                    <th scope="col" class="lb-rank-col">Rank</th>
                                    <th scope="col">Member</th>
                                    <th scope="col" class="num">Points</th>
                                    <th scope="col" class="num hide-sm">Raids (affiliate / non-affiliate)</th>
                                    <th scope="col" class="num hide-sm">Supports</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% _users.forEach(function (u, idx) { const list = _entries[u.userId] || []; %>
                                <tr>
                                    <td><span class="lb-rank<%= u.rank <= 3 ? ' top' : '' %>"><%= u.rank %></span></td>
                                    <td>
                                        <div class="lb-member">
                                            <img src="<%= u.avatarURL %>" alt="" width="32" height="32" loading="lazy" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                                            <span class="lb-who">
                                                <% if (list.length) { %>
                                                <button type="button" class="lb-toggle" aria-expanded="false" aria-controls="detail-<%= idx %>">
                                                    <span class="lb-name"><%= u.displayName %></span>
                                                    <svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 4 4 4-4 4"/></svg>
                                                    <span class="visually-hidden">Show entries</span>
                                                </button>
                                                <% } else { %><span class="lb-name"><%= u.displayName %></span><% } %>
                                                <% if (u.username && u.username !== u.displayName) { %><span class="lb-handle">@<%= u.username %></span><% } %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="num"><strong><%= Number(u.totalPoints).toLocaleString('en-US') %></strong></td>
                                    <td class="num hide-sm"><%= u.raidCount %><% if (u.raidCount > 0) { %> <span class="lb-sub">(<%= u.raidAffiliateCount %> / <%= u.raidNonAffiliateCount %>)</span><% } %></td>
                                    <td class="num hide-sm"><%= u.supportCount %></td>
                                </tr>
                                <% if (list.length) { %>
                                <tr class="lb-detail" id="detail-<%= idx %>" hidden>
                                    <td colspan="5">
                                        <div class="lb-detail-scroll">
                                        <table class="lb-entries">
                                            <thead><tr><th scope="col">Date</th><th scope="col">Type</th><th scope="col">Streamer</th><th scope="col" class="hide-sm">Status</th><th scope="col">Points</th><th scope="col">Proof</th><% if (_admin) { %><th scope="col">Manage</th><% } %></tr></thead>
                                            <tbody>
                                                <% list.forEach(function (e) { %>
                                                <tr>
                                                    <td><%= new Date(e.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></td>
                                                    <td><%= e.type === 'raid' ? 'Raid' : 'Support' %></td>
                                                    <td><a href="<%= e.twitchLink %>" target="_blank" rel="noopener"><%= e.target %></a></td>
                                                    <td class="hide-sm"><%= e.isAffiliate ? 'Affiliate' : 'Non-affiliate' %></td>
                                                    <td>+<%= e.points %></td>
                                                    <td><a href="<%= e.messageLink %>" target="_blank" rel="noopener">Message</a></td>
                                                    <% if (_admin) { %>
                                                    <td>
                                                        <span class="lb-actions">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-act="edit" data-id="<%= e.id %>" data-target="<%= e.target %>" data-twitch-id="<%= e.targetTwitchId || '' %>" data-affiliate="<%= e.isAffiliate ? '1' : '0' %>" data-points="<%= e.points %>" data-type="<%= e.type %>">Edit</button>
                                                            <button type="button" class="btn btn-secondary btn-sm" data-act="repost" data-id="<%= e.id %>" title="Post the bot's reply in Discord again">Repost</button>
                                                            <button type="button" class="btn btn-danger btn-sm" data-act="delete" data-id="<%= e.id %>">Delete</button>
                                                        </span>
                                                    </td>
                                                    <% } %>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                        </div>
                                    </td>
                                </tr>
                                <% } %>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <% if (_pg && _pg.totalPages > 1) { const base = '/supporters/' + _guild.id + '?month=' + encodeURIComponent(_month || '') + '&page='; %>
                    <nav class="lb-pager" aria-label="Pages">
                        <% if (_pg.page > 1) { %><a href="<%= base + (_pg.page - 1) %>" rel="prev">Previous</a><% } %>
                        <% for (let p = 1; p <= _pg.totalPages; p++) { %>
                            <% if (p === _pg.page) { %><span aria-current="page"><%= p %></span>
                            <% } else if (Math.abs(p - _pg.page) <= 2 || p === 1 || p === _pg.totalPages) { %><a href="<%= base + p %>"><%= p %></a>
                            <% } else if (Math.abs(p - _pg.page) === 3) { %><span class="gap" aria-hidden="true">&hellip;</span><% } %>
                        <% } %>
                        <% if (_pg.page < _pg.totalPages) { %><a href="<%= base + (_pg.page + 1) %>" rel="next">Next</a><% } %>
                    </nav>
                    <% } %>
                    <% if (_pg) { %>
                    <p class="lb-count">Showing <%= (_pg.page - 1) * _pg.limit + 1 %>&ndash;<%= Math.min(_pg.page * _pg.limit, _pg.total) %> of <%= Number(_pg.total).toLocaleString('en-US') %> supporters</p>
                    <% } %>
                <% } %>
            <% } %>
        <% } %>
    </main>

    <% if (_guild && _admin) { %>
    <dialog class="lb-dialog" id="edit-modal" aria-labelledby="edit-modal-title">
        <form method="dialog" id="edit-form">
            <h2 id="edit-modal-title">Edit entry</h2>
            <input type="hidden" id="edit-entry-id">
            <div><label for="edit-target-username">Streamer username</label><input type="text" id="edit-target-username" class="form-control" maxlength="50" required></div>
            <div><label for="edit-target-twitch-id">Twitch ID</label><input type="text" id="edit-target-twitch-id" class="form-control" inputmode="numeric" maxlength="20"></div>
            <div><label for="edit-entry-type">Type</label><select id="edit-entry-type" class="form-select"><option value="raid">Raid</option><option value="support">Support</option></select></div>
            <div><label for="edit-is-affiliate">Streamer status</label><select id="edit-is-affiliate" class="form-select"><option value="1">Affiliate</option><option value="0">Non-affiliate</option></select></div>
            <div><label for="edit-points">Points</label><input type="number" id="edit-points" class="form-control" min="0" max="1000" required></div>
            <div class="row-actions">
                <button type="button" class="btn btn-secondary" id="edit-cancel">Cancel</button>
                <button type="submit" class="btn btn-primary" id="edit-save">Save</button>
            </div>
        </form>
    </dialog>
    <% } %>
    <div class="lb-toast" id="admin-status" role="status" aria-live="polite" hidden></div>

<%- include('partials/site-footer') %>
<script>
(function () {
    var GUILD_ID = <%- JSON.stringify(_guild ? String(_guild.id) : '').replace(/</g, '\\u003c') %>;

    var monthSel = document.getElementById('month-select');
    if (monthSel) monthSel.addEventListener('change', function () { document.getElementById('lb-month-form').submit(); });

    document.querySelectorAll('.lb-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var row = document.getElementById(btn.getAttribute('aria-controls'));
            if (!row) return;
            var open = row.hasAttribute('hidden');
            if (open) row.removeAttribute('hidden'); else row.setAttribute('hidden', '');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    });

    var toastTimer = null;
    function showStatus(msg, type) {
        var el = document.getElementById('admin-status');
        el.textContent = msg;
        el.className = 'lb-toast' + (type === 'error' ? ' is-error' : '');
        el.removeAttribute('hidden');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { el.setAttribute('hidden', ''); }, 4000);
    }
    function headers() {
        var h = { 'Content-Type': 'application/json' };
        var m = document.querySelector('meta[name="csrf-token"]');
        if (m && m.content) h['X-CSRF-Token'] = m.content;
        return h;
    }
    async function call(url, method, body) {
        var res = await fetch(url, { method: method, headers: headers(), credentials: 'same-origin', body: body ? JSON.stringify(body) : undefined });
        var data = {};
        try { data = await res.json(); } catch (e) { /* non-JSON error page */ }
        if (!res.ok && !data.error) data.error = 'Request failed (' + res.status + ')';
        return data;
    }

    var dlg = document.getElementById('edit-modal');
    if (!dlg) return;   // not an admin: nothing below applies
    var originalUsername = '';

    document.addEventListener('click', async function (ev) {
        var b = ev.target.closest('button[data-act]');
        if (!b) return;
        var id = b.getAttribute('data-id');
        var act = b.getAttribute('data-act');
        if (act === 'edit') {
            originalUsername = b.getAttribute('data-target') || '';
            document.getElementById('edit-entry-id').value = id;
            document.getElementById('edit-target-username').value = originalUsername;
            document.getElementById('edit-target-twitch-id').value = b.getAttribute('data-twitch-id') || '';
            document.getElementById('edit-entry-type').value = b.getAttribute('data-type') === 'support' ? 'support' : 'raid';
            document.getElementById('edit-is-affiliate').value = b.getAttribute('data-affiliate') === '1' ? '1' : '0';
            document.getElementById('edit-points').value = b.getAttribute('data-points') || '0';
            if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', '');
        } else if (act === 'repost') {
            b.disabled = true;
            try {
                showStatus('Reposting…');
                var r = await call('/api/guilds/' + GUILD_ID + '/community-support/entries/' + encodeURIComponent(id) + '/repost', 'POST');
                showStatus(r.success ? (r.message || 'Reposted') : (r.error || 'Could not repost'), r.success ? 'ok' : 'error');
            } catch (e) { showStatus('Network error', 'error'); }
            b.disabled = false;
        } else if (act === 'delete') {
            if (!confirm('Delete this entry? This cannot be undone.')) return;
            b.disabled = true;
            try {
                var d = await call('/api/guilds/' + GUILD_ID + '/community-support/entries/' + encodeURIComponent(id), 'DELETE');
                if (d.success) { showStatus('Entry deleted. Refreshing…'); setTimeout(function () { location.reload(); }, 900); }
                else { showStatus(d.error || 'Could not delete the entry', 'error'); b.disabled = false; }
            } catch (e) { showStatus('Network error', 'error'); b.disabled = false; }
        }
    });

    document.getElementById('edit-cancel').addEventListener('click', function () { dlg.close ? dlg.close() : dlg.removeAttribute('open'); });

    document.getElementById('edit-form').addEventListener('submit', async function (ev) {
        ev.preventDefault();
        var id = document.getElementById('edit-entry-id').value;
        var newUsername = document.getElementById('edit-target-username').value.trim();
        var twitchId = document.getElementById('edit-target-twitch-id').value.trim();
        var isAff = document.getElementById('edit-is-affiliate').value === '1';
        var points = parseInt(document.getElementById('edit-points').value, 10);
        if (!newUsername) { showStatus('Enter the streamer username', 'error'); return; }
        if (!Number.isFinite(points) || points < 0) { showStatus('Points must be 0 or more', 'error'); return; }
        var save = document.getElementById('edit-save');
        save.disabled = true;
        try {
            if (newUsername.toLowerCase() !== originalUsername.toLowerCase() &&
                confirm('Rename every entry for "' + originalUsername + '" to "' + newUsername + '"? The bot also edits its Discord messages.\n\nOK renames all of them. Cancel changes only this entry.')) {
                showStatus('Renaming entries and editing Discord messages…');
                var rn = await call('/supporters/' + GUILD_ID + '/rename-streamer', 'POST', {
                    old_username: originalUsername, new_username: newUsername,
                    new_twitch_id: twitchId || null, new_is_affiliate: isAff
                });
                if (rn.success) { showStatus('Renamed ' + rn.updated + ' entries and edited ' + (rn.messagesEdited || 0) + ' messages. Refreshing…'); dlg.close && dlg.close(); setTimeout(function () { location.reload(); }, 1200); }
                else { showStatus(rn.error || 'Rename failed', 'error'); }
                return;
            }
            var up = await call('/api/guilds/' + GUILD_ID + '/community-support/entries/' + encodeURIComponent(id), 'PATCH', {
                target_username: newUsername,
                target_twitch_id: twitchId,
                entry_type: document.getElementById('edit-entry-type').value,
                target_is_affiliate: isAff,
                points_awarded: points
            });
            if (up.success) { showStatus('Entry updated. Refreshing…'); dlg.close && dlg.close(); setTimeout(function () { location.reload(); }, 900); }
            else { showStatus(up.error || 'Could not update the entry', 'error'); }
        } catch (e) {
            showStatus('Network error', 'error');
        } finally {
            save.disabled = false;
        }
    });
})();
</script>
</body>
</html>
