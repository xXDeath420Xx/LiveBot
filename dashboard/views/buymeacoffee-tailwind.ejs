<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Link your own Buy Me a Coffee account to announce your supporters in your Discord servers.">
    <meta name="theme-color" content="#FFDD00">
    <meta name="robots" content="noindex">
    <title>Buy Me a Coffee - CertiFried MultiTool</title>
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0b0f11;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.5);
            --accent-purple: #a78bfa;
            --accent-blue: #60a5fa;
            --accent-green: #34d399;
            --accent-red: #f87171;
            --bmc-yellow: #FFDD00;
        }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; line-height: 1.6; }
        .bg-effects { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: hidden; }
        .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.25; animation: float 20s ease-in-out infinite; }
        .orb-1 { width: clamp(300px, 40vw, 500px); height: clamp(300px, 40vw, 500px); background: linear-gradient(135deg, #FFDD00, #fbbf24); top: -10%; right: -10%; }
        .orb-2 { width: clamp(250px, 35vw, 450px); height: clamp(250px, 35vw, 450px); background: linear-gradient(135deg, #7c3aed, #a78bfa); bottom: 10%; left: -10%; animation-delay: -10s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(20px, 20px) scale(1.02); } }
        .container { width: 100%; max-width: 880px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
        .navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 1rem 0; background: rgba(11, 15, 17, 0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-color); }
        .navbar-container { max-width: 1400px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
        .navbar-content { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .navbar-brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-primary); font-weight: 700; }
        .navbar-logo { width: 36px; height: 36px; aspect-ratio: 1/1; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-purple); }
        .navbar-links { display: flex; align-items: center; gap: 1.5rem; }
        .navbar-links a { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
        .navbar-links a:hover, .navbar-links a.active { color: var(--text-primary); }
        .user-menu { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; text-decoration: none; transition: all 0.2s; }
        .user-menu:hover { border-color: var(--accent-purple); }
        .user-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
        .user-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
        main { position: relative; z-index: 1; padding: 100px 0 4rem; min-height: 100vh; }
        .page-header { margin-bottom: 2rem; }
        .page-header h1 { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 800; background: linear-gradient(135deg, var(--text-primary), var(--bmc-yellow)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.5rem; }
        .page-header p { color: var(--text-secondary); font-size: 0.95rem; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        .card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
        .card h3 { font-size: 1.15rem; font-weight: 700; margin-bottom: 0.35rem; }
        .card .muted { color: var(--text-muted); font-size: 0.85rem; }
        .status-box { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 12px; font-weight: 600; margin-bottom: 1.25rem; }
        .status-box.linked { background: rgba(52, 211, 153, 0.12); border: 1px solid rgba(52, 211, 153, 0.3); color: var(--accent-green); }
        .status-box.unlinked { background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); color: var(--text-secondary); }
        .status-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
        .status-box.linked .status-dot { background: var(--accent-green); }
        .status-box.unlinked .status-dot { background: var(--text-muted); }
        .status-box .acct { font-family: 'SF Mono', monospace; font-size: 0.8rem; opacity: 0.85; font-weight: 500; }
        label.field-label { display: block; font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.4rem; }
        .input { width: 100%; padding: 0.7rem 0.9rem; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: 10px; color: var(--text-primary); font-family: inherit; font-size: 0.9rem; transition: border-color 0.2s; }
        .input:focus { outline: none; border-color: var(--bmc-yellow); }
        .row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.9rem; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; border: none; cursor: pointer; font-family: inherit; }
        .btn:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-primary { background: linear-gradient(135deg, var(--bmc-yellow), #fbbf24); color: #1a1500; }
        .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(255, 221, 0, 0.25); }
        .btn-danger { background: rgba(248, 113, 113, 0.15); border: 1px solid rgba(248, 113, 113, 0.3); color: var(--accent-red); }
        .btn-danger:hover:not(:disabled) { background: var(--accent-red); color: white; }
        .btn-secondary { background: rgba(255, 221, 0, 0.1); border: 1px solid rgba(255, 221, 0, 0.35); color: var(--bmc-yellow); }
        .btn-secondary:hover:not(:disabled) { background: rgba(255, 221, 0, 0.2); }
        .status-msg { font-size: 0.85rem; }
        .status-msg.ok { color: var(--accent-green); }
        .status-msg.err { color: var(--accent-red); }
        .status-msg.info { color: var(--text-muted); }
        .note { font-size: 0.78rem; color: var(--text-muted); margin-top: 0.5rem; }
        .targets-table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
        .targets-table th, .targets-table td { text-align: left; padding: 0.6rem 0.75rem; font-size: 0.85rem; border-bottom: 1px solid var(--border-color); }
        .targets-table th { color: var(--text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
        .targets-table td.mono { font-family: 'SF Mono', monospace; color: var(--text-secondary); }
        .badge { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.15rem 0.55rem; border-radius: 50px; font-size: 0.7rem; font-weight: 600; }
        .badge.on { background: rgba(52, 211, 153, 0.15); color: var(--accent-green); }
        .badge.off { background: rgba(255, 255, 255, 0.06); color: var(--text-muted); }
        .cmd { font-family: 'SF Mono', monospace; background: rgba(255,255,255,0.06); padding: 0.1rem 0.4rem; border-radius: 5px; font-size: 0.85em; }
        .howto { list-style: none; counter-reset: step; }
        .howto li { position: relative; padding: 0.4rem 0 0.4rem 2rem; font-size: 0.88rem; color: var(--text-secondary); counter-increment: step; }
        .howto li::before { content: counter(step); position: absolute; left: 0; top: 0.4rem; width: 1.4rem; height: 1.4rem; background: rgba(255, 221, 0, 0.15); color: var(--bmc-yellow); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; }
        .howto a { color: var(--bmc-yellow); text-decoration: none; }
        .howto a:hover { text-decoration: underline; }
        .empty-targets { color: var(--text-muted); font-size: 0.85rem; padding: 0.5rem 0; }
        .footer { padding: clamp(2rem, 5vh, 3.5rem) 0; background: var(--bg-primary); border-top: 1px solid var(--border-color); text-align: center; margin-top: 2rem; }
        .footer-links { display: flex; gap: clamp(1.25rem, 2.5vw, 2.5rem); justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
        .footer-link { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.3s ease; }
        .footer-link:hover { color: var(--accent-purple); }
        .footer-copyright { color: var(--text-muted); font-size: 0.85rem; }
        @media (max-width: 768px) { .navbar-links { display: none; } }
    </style>
</head>
<body>
    <div class="bg-effects"><div class="orb orb-1"></div><div class="orb orb-2"></div></div>

    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-content">
                <a href="/" class="navbar-brand">
                    <img src="/images/CertiFried.png" alt="CertiFried" class="navbar-logo">
                    <span>CertiFried</span>
                </a>
                <div class="navbar-links">
                    <a href="/">Home</a>
                    <a href="/commands">Commands</a>
                    <a href="/cards">Cards</a>
                    <a href="/status">Status</a>
                    <a href="/dashboard">Dashboard</a>
                </div>
                <a href="/profile" class="user-menu">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" class="user-avatar">
                    <span class="user-name"><%= user.username %></span>
                </a>
            </div>
        </div>
    </nav>

    <main>
        <div class="container">
            <div class="page-header">
                <h1>☕ Buy Me a Coffee</h1>
                <p>Link your own Buy Me a Coffee account so the bot can announce your supporters in your Discord servers. This is yours alone — only you can see or change it.</p>
            </div>

            <!-- Link / status card -->
            <div class="card">
                <div id="bmc-status" class="status-box unlinked">
                    <span class="status-dot"></span>
                    <span id="bmc-status-text">Loading…</span>
                </div>

                <p class="note" style="margin-bottom:0.6rem;">Buy Me a Coffee has no "Connect" button — every creator generates their own read-only token. It's two clicks:</p>
                <a href="https://developers.buymeacoffee.com" target="_blank" rel="noopener" class="btn btn-secondary" style="display:inline-block;margin-bottom:0.9rem;">① Generate your read-only token on Buy Me a Coffee ↗</a>

                <label class="field-label" for="bmc-key">② Paste your read-only API key</label>
                <input id="bmc-key" class="input" type="password" autocomplete="off" spellcheck="false"
                       placeholder="Paste your Buy Me a Coffee read-only API key">
                <p class="note">🔒 Stored encrypted, never displayed back to you, and it never passes through Discord — it goes straight from your browser to the server over HTTPS.</p>

                <div class="row">
                    <button id="bmc-link-btn" class="btn btn-primary" type="button">Link account</button>
                    <button id="bmc-unlink-btn" class="btn btn-danger" type="button" style="display:none;">Unlink</button>
                    <span id="bmc-status-msg" class="status-msg"></span>
                </div>
            </div>

            <!-- Announce targets (read-only) -->
            <div class="card">
                <h3>Where your supporters are announced</h3>
                <p class="muted">Set or change these with <span class="cmd">/buymeacoffee announce</span> in your server — pick the channel you want supporter shout-outs posted to.</p>
                <div id="bmc-targets-wrap" style="margin-top: 1rem;">
                    <div class="empty-targets">Loading…</div>
                </div>
            </div>

            <!-- How to -->
            <div class="card">
                <h3>How to get your read-only key</h3>
                <ol class="howto">
                    <li>Go to <a href="https://developers.buymeacoffee.com" target="_blank" rel="noopener">developers.buymeacoffee.com</a> and sign in.</li>
                    <li>Open <strong>Settings → API</strong>.</li>
                    <li>Create a <strong>read-only</strong> API key (it only lets the bot read your supporters — it can't touch your money).</li>
                    <li>Paste it above and click <strong>Link account</strong>.</li>
                </ol>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a href="/commands" class="footer-link">Commands</a>
                <a href="/profile" class="footer-link">Profile</a>
                <a href="/status" class="footer-link">Status</a>
                <a href="/docs" class="footer-link">Documentation</a>
                <a href="/terms" class="footer-link">Terms</a>
                <a href="/privacy" class="footer-link">Privacy</a>
            </div>
            <p class="footer-copyright">&copy; <%= new Date().getFullYear() %> CertiFried MultiTool. All rights reserved.</p>
        </div>
    </footer>

    <script>
    (function () {
        const base = '/api/me/buymeacoffee';

        function el(tag, cls) { const e = document.createElement(tag); if (cls) e.className = cls; return e; }
        function setMsg(msg, kind) {
            const s = document.getElementById('bmc-status-msg');
            if (!s) return;
            s.textContent = msg || '';
            s.className = 'status-msg ' + (kind === 'err' ? 'err' : kind === 'ok' ? 'ok' : 'info');
        }

        const keyInput = document.getElementById('bmc-key');
        const linkBtn = document.getElementById('bmc-link-btn');
        const unlinkBtn = document.getElementById('bmc-unlink-btn');

        function renderStatus(data) {
            const box = document.getElementById('bmc-status');
            const txt = document.getElementById('bmc-status-text');
            if (data.linked) {
                box.className = 'status-box linked';
                txt.innerHTML = 'Linked' + (data.accountId ? ' <span class="acct">(account ' + String(data.accountId).replace(/[<>&]/g, '') + ')</span>' : '');
                linkBtn.textContent = 'Replace key';
                unlinkBtn.style.display = '';
            } else {
                box.className = 'status-box unlinked';
                txt.textContent = 'Not linked yet';
                linkBtn.textContent = 'Link account';
                unlinkBtn.style.display = 'none';
            }
        }

        function renderTargets(targets) {
            const wrap = document.getElementById('bmc-targets-wrap');
            while (wrap.firstChild) wrap.removeChild(wrap.firstChild);

            if (!targets || targets.length === 0) {
                const p = el('div', 'empty-targets');
                p.textContent = 'No announce channels set yet. Use /buymeacoffee announce in a server to add one.';
                wrap.appendChild(p);
                return;
            }

            const tbl = el('table', 'targets-table');
            const thead = el('thead');
            const hr = el('tr');
            ['Server', 'Channel', 'Status'].forEach(h => { const th = el('th'); th.textContent = h; hr.appendChild(th); });
            thead.appendChild(hr);
            tbl.appendChild(thead);

            const tbody = el('tbody');
            for (const t of targets) {
                const tr = el('tr');
                const g = el('td', 'mono'); g.textContent = t.guild_id || '—'; tr.appendChild(g);
                const c = el('td', 'mono'); c.textContent = t.channel_id ? '#' + t.channel_id : '—'; tr.appendChild(c);
                const st = el('td');
                const badge = el('span', 'badge ' + (Number(t.enabled) ? 'on' : 'off'));
                badge.textContent = Number(t.enabled) ? 'Enabled' : 'Disabled';
                st.appendChild(badge);
                tr.appendChild(st);
                tbody.appendChild(tr);
            }
            tbl.appendChild(tbody);
            wrap.appendChild(tbl);
        }

        async function load() {
            try {
                const data = await fetch(base, { headers: { Accept: 'application/json' } }).then(r => r.json());
                renderStatus(data);
                renderTargets(data.targets);
            } catch (e) {
                setMsg('Failed to load status.', 'err');
            }
        }

        linkBtn.addEventListener('click', async () => {
            const apiKey = (keyInput.value || '').trim();
            if (!apiKey) { setMsg('Paste your read-only API key first.', 'err'); return; }
            linkBtn.disabled = true;
            setMsg('Validating key…', 'info');
            try {
                const r = await fetch(base + '/link', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apiKey })
                }).then(x => x.json());
                if (r.ok) {
                    keyInput.value = '';
                    setMsg('Linked successfully.', 'ok');
                    await load();
                } else {
                    setMsg(r.error || 'Could not link that key.', 'err');
                }
            } catch (e) {
                setMsg('Request failed.', 'err');
            } finally {
                linkBtn.disabled = false;
            }
        });

        unlinkBtn.addEventListener('click', async () => {
            if (!confirm('Unlink your Buy Me a Coffee account? This also removes all of your announce channels.')) return;
            unlinkBtn.disabled = true;
            setMsg('Unlinking…', 'info');
            try {
                const r = await fetch(base + '/link', { method: 'DELETE', headers: { Accept: 'application/json' } }).then(x => x.json());
                if (r.ok) {
                    setMsg('Unlinked.', 'ok');
                    await load();
                } else {
                    setMsg(r.error || 'Could not unlink.', 'err');
                }
            } catch (e) {
                setMsg('Request failed.', 'err');
            } finally {
                unlinkBtn.disabled = false;
            }
        });

        load();
    }());
    </script>
</body>
</html>
