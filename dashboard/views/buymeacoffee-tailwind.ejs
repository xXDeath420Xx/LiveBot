<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: 'Buy Me a Coffee · CertiFried', description: 'Link your own Buy Me a Coffee account so the bot can announce your supporters in your Discord servers.', path: '/buymeacoffee', noindex: true }) %>
    <script src="/js/csrf.js"></script>
    <style>
        .bmc-panel { padding: var(--cf-5); margin-bottom: var(--cf-4); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .bmc-panel > h2 { margin: 0 0 var(--cf-2); font-size: var(--cf-text-lg); font-weight: 600; }
        .bmc-panel .muted { margin: 0 0 var(--cf-3); font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); }
        .status-box { display: flex; align-items: center; gap: var(--cf-2); margin: 0 0 var(--cf-4); font-weight: 600; }
        .status-box .acct { font-weight: 400; color: var(--cf-text-3); }
        .bmc-field { margin: var(--cf-4) 0 0; }
        .bmc-field label { display: block; margin-bottom: 6px; font-size: var(--cf-text-sm); font-weight: 500; }
        .bmc-field .form-input { width: 100%; min-height: 40px; }
        .note { margin: 6px 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .bmc-actions { display: flex; align-items: center; gap: var(--cf-3); flex-wrap: wrap; margin-top: var(--cf-4); }
        .status-msg { font-size: var(--cf-text-sm); }
        .status-msg.ok { color: var(--cf-success); }
        .status-msg.err { color: var(--cf-danger); }
        .status-msg.info { color: var(--cf-text-3); }
        .bmc-cmd { font-family: var(--cf-mono); font-size: 0.92em; color: var(--cf-text); }
        .bmc-targets { width: 100%; border-collapse: collapse; font-size: var(--cf-text-sm); }
        .bmc-targets th, .bmc-targets td { padding: 9px 12px; text-align: left; border-bottom: 1px solid var(--cf-border); }
        .bmc-targets th { font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); }
        .bmc-targets tr:last-child td { border-bottom: 0; }
        .bmc-targets .mono { font-family: var(--cf-mono); font-size: var(--cf-text-xs); }
        .bmc-howto { margin: 0; padding-left: 1.3em; font-size: var(--cf-text-sm); line-height: 1.7; color: var(--cf-text-2); }
        .bmc-howto a { color: var(--cf-accent-fg); }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', user: locals.user || null, returnTo: '/buymeacoffee' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main cfs-main--narrow">
        <div class="cfs-pagehead">
            <h1>Buy Me a Coffee</h1>
            <p class="cfs-lede">Link your own Buy Me a Coffee account so the bot can announce your supporters in your Discord servers. Only you can see or change this link.</p>
        </div>

        <section class="bmc-panel" aria-labelledby="bmc-link-h">
            <h2 id="bmc-link-h" class="visually-hidden">Your link</h2>
            <p id="bmc-status" class="status-box" role="status"><span class="cfs-dot" aria-hidden="true"></span><span id="bmc-status-text">Loading…</span></p>
            <p class="muted">Buy Me a Coffee has no Connect button: you create a read-only key on their site and paste it here.</p>
            <a href="https://developers.buymeacoffee.com" target="_blank" rel="noopener" class="btn btn-secondary">Create a read-only key on Buy Me a Coffee</a>

            <div class="bmc-field">
                <label for="bmc-key">Read-only API key</label>
                <input id="bmc-key" class="form-input" type="password" autocomplete="off" spellcheck="false" aria-describedby="bmc-key-note">
                <p class="note" id="bmc-key-note">Stored encrypted and never shown again. It goes from your browser to our server over HTTPS, not through Discord.</p>
            </div>

            <div class="bmc-actions">
                <button id="bmc-link-btn" class="btn btn-primary" type="button">Link account</button>
                <button id="bmc-unlink-btn" class="btn btn-danger" type="button" hidden>Unlink</button>
                <span id="bmc-status-msg" class="status-msg" role="status" aria-live="polite"></span>
            </div>
        </section>

        <section class="bmc-panel" aria-labelledby="bmc-targets-h">
            <h2 id="bmc-targets-h">Where your supporters are announced</h2>
            <p class="muted">Add or change these with <span class="bmc-cmd">/creator buymeacoffee announce</span> in your server, choosing the channel for supporter posts.</p>
            <div id="bmc-targets-wrap"><p class="muted">Loading…</p></div>
        </section>

        <section class="bmc-panel" aria-labelledby="bmc-howto-h">
            <h2 id="bmc-howto-h">How to get a read-only key</h2>
            <ol class="bmc-howto">
                <li>Go to <a href="https://developers.buymeacoffee.com" target="_blank" rel="noopener">developers.buymeacoffee.com</a> and sign in.</li>
                <li>Open <strong>Settings</strong>, then <strong>API</strong>.</li>
                <li>Create a <strong>read-only</strong> key. It lets the bot read your supporters and nothing else.</li>
                <li>Paste it above and select <strong>Link account</strong>.</li>
            </ol>
        </section>
    </main>

<%- include('partials/site-footer') %>

    <script>
    (function () {
        const base = '/api/me/buymeacoffee';

        function el(tag, cls) { const e = document.createElement(tag); if (cls) e.className = cls; return e; }
        function setMsg(msg, kind) {
            const s = document.getElementById('bmc-status-msg');
            if (!s) return;
            s.textContent = msg || '';
            s.className = 'status-msg ' + (kind === 'err' ? 'err' : kind === 'ok' ? 'ok' : 'info');
        }

        const keyInput = document.getElementById('bmc-key');
        const linkBtn = document.getElementById('bmc-link-btn');
        const unlinkBtn = document.getElementById('bmc-unlink-btn');

        function renderStatus(data) {
            const box = document.getElementById('bmc-status');
            const txt = document.getElementById('bmc-status-text');
            if (data.linked) {
                box.querySelector('.cfs-dot').className = 'cfs-dot cfs-dot--ok';
                txt.textContent = 'Linked';
                if (data.accountId) { const a = el('span', 'acct'); a.textContent = ' (account ' + String(data.accountId) + ')'; txt.appendChild(a); }
                linkBtn.textContent = 'Replace key';
                unlinkBtn.hidden = false;
            } else {
                box.querySelector('.cfs-dot').className = 'cfs-dot';
                txt.textContent = 'Not linked yet';
                linkBtn.textContent = 'Link account';
                unlinkBtn.hidden = true;
            }
        }

        function renderTargets(targets) {
            const wrap = document.getElementById('bmc-targets-wrap');
            while (wrap.firstChild) wrap.removeChild(wrap.firstChild);

            if (!targets || targets.length === 0) {
                const p = el('p', 'muted');
                p.textContent = 'No announcement channels yet. Use /creator buymeacoffee announce in a server to add one.';
                wrap.appendChild(p);
                return;
            }

            const box = el('div', 'cfs-table-wrap');
            const tbl = el('table', 'bmc-targets');
            const thead = el('thead');
            const hr = el('tr');
            ['Server', 'Channel', 'Status'].forEach(h => { const th = el('th'); th.textContent = h; hr.appendChild(th); });
            thead.appendChild(hr);
            tbl.appendChild(thead);

            const tbody = el('tbody');
            for (const t of targets) {
                const tr = el('tr');
                const g = el('td', 'mono'); g.textContent = t.guild_id || '—'; tr.appendChild(g);
                const c = el('td', 'mono'); c.textContent = t.channel_id ? '#' + t.channel_id : '—'; tr.appendChild(c);
                const st = el('td');
                const badge = el('span', 'cfs-badge' + (Number(t.enabled) ? ' cfs-badge--ok' : ' cfs-badge--off'));
                badge.textContent = Number(t.enabled) ? 'On' : 'Off';
                st.appendChild(badge);
                tr.appendChild(st);
                tbody.appendChild(tr);
            }
            tbl.appendChild(tbody);
            box.appendChild(tbl);
            wrap.appendChild(box);
        }

        async function load() {
            try {
                const data = await fetch(base, { headers: { Accept: 'application/json' } }).then(r => r.json());
                renderStatus(data);
                renderTargets(data.targets);
            } catch (e) {
                setMsg('Could not load your link status.', 'err');
            }
        }

        linkBtn.addEventListener('click', async () => {
            const apiKey = (keyInput.value || '').trim();
            if (!apiKey) { setMsg('Paste your read-only API key first.', 'err'); return; }
            linkBtn.disabled = true;
            setMsg('Checking the key…', 'info');
            try {
                const r = await fetch(base + '/link', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apiKey })
                }).then(x => x.json());
                if (r.ok) {
                    keyInput.value = '';
                    setMsg('Linked.', 'ok');
                    await load();
                } else {
                    setMsg(r.error || 'Could not link that key.', 'err');
                }
            } catch (e) {
                setMsg('Could not reach the server. Try again in a minute.', 'err');
            } finally {
                linkBtn.disabled = false;
            }
        });

        unlinkBtn.addEventListener('click', async () => {
            if (!confirm('Unlink your Buy Me a Coffee account? This also removes all of your announce channels.')) return;
            unlinkBtn.disabled = true;
            setMsg('Unlinking…', 'info');
            try {
                const r = await fetch(base + '/link', { method: 'DELETE', headers: { Accept: 'application/json' } }).then(x => x.json());
                if (r.ok) {
                    setMsg('Unlinked.', 'ok');
                    await load();
                } else {
                    setMsg(r.error || 'Could not unlink.', 'err');
                }
            } catch (e) {
                setMsg('Could not reach the server. Try again in a minute.', 'err');
            } finally {
                unlinkBtn.disabled = false;
            }
        });

        load();
    }());
    </script>
</body>
</html>
