<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Commands - CertiFried MultiTool</title>
    <meta name="description" content="Browse all CertiFried MultiTool Discord bot commands. Streaming, moderation, economy, music, leveling, and more.">
    <meta name="theme-color" content="#a78bfa">
    <meta property="og:title" content="Commands - CertiFried MultiTool">
    <meta property="og:description" content="Browse all CertiFried MultiTool Discord bot commands.">
    <meta property="og:image" content="/images/CertiFried.png">
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0b0f11;
            --bg-secondary: #0f1416;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.15);
            --text-primary: #e9edf0;
            --text-secondary: #a9b4b9;
            --text-muted: #6b7280;
            --accent-purple: #a78bfa;
            --accent-purple-dim: rgba(167, 139, 250, 0.15);
            --accent-green: #23f56b;
            --accent-green-dim: rgba(35, 245, 107, 0.15);
            --accent-red: #ef4444;
            --accent-blue: #60a5fa;
            --accent-yellow: #fbbf24;
            --accent-cyan: #22d3ee;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        /* Navbar */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(11, 15, 17, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-color);
        }

        .navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 70px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .navbar-logo {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
        }

        .navbar-links {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .navbar-link {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

        .navbar-link:hover { color: var(--text-primary); }
        .navbar-link.active { color: var(--text-primary); }

        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.65rem 1.25rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.875rem;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--accent-purple);
            color: white;
        }

        .btn-primary:hover {
            background: #9171f0;
            transform: translateY(-1px);
        }

        /* Main Layout */
        main {
            padding-top: 70px;
            min-height: 100vh;
        }

        .page-layout {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            padding: 2rem 0;
        }

        /* Sidebar */
        .sidebar {
            position: sticky;
            top: 90px;
            height: fit-content;
            max-height: calc(100vh - 110px);
            overflow-y: auto;
        }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }

        .sidebar-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 1.25rem;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .sidebar-header-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--accent-purple-dim);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-purple);
        }

        .sidebar-header-icon svg { width: 20px; height: 20px; }

        .sidebar-title { font-weight: 700; font-size: 1rem; }
        .sidebar-subtitle { font-size: 0.75rem; color: var(--text-muted); }

        /* Search */
        .search-wrapper { position: relative; margin-bottom: 1rem; }

        .search-icon {
            position: absolute;
            left: 0.875rem;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--text-muted);
        }

        .search-input {
            width: 100%;
            padding: 0.75rem 0.875rem 0.75rem 2.5rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 0.875rem;
            font-family: inherit;
            transition: all 0.2s;
        }

        .search-input::placeholder { color: var(--text-muted); }

        .search-input:focus {
            outline: none;
            border-color: var(--accent-purple);
            box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.1);
        }

        /* Category Navigation */
        .category-nav { display: flex; flex-direction: column; gap: 0.25rem; }

        .category-nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.625rem 0.75rem;
            background: transparent;
            border: none;
            border-radius: 8px;
            color: var(--text-secondary);
            font-size: 0.875rem;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.2s;
            text-align: left;
        }

        .category-nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .category-nav-item.active {
            background: var(--accent-purple-dim);
            color: var(--accent-purple);
        }

        .category-nav-icon { width: 18px; height: 18px; flex-shrink: 0; }

        .category-nav-count {
            margin-left: auto;
            font-size: 0.75rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 0.125rem 0.5rem;
            border-radius: 10px;
        }

        /* Main Content */
        .main-content { min-width: 0; }

        /* Page Header */
        .page-header { margin-bottom: 2rem; }
        .page-title { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; }
        .page-subtitle { color: var(--text-secondary); font-size: 1rem; }

        /* Stats Bar */
        .stats-bar { display: flex; gap: 1.5rem; margin-bottom: 2rem; }

        .stat-pill {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 100px;
            font-size: 0.875rem;
        }

        .stat-pill-value { font-weight: 700; color: var(--accent-purple); }
        .stat-pill-label { color: var(--text-secondary); }

        /* Category Section */
        .category-section { margin-bottom: 3rem; scroll-margin-top: 100px; }

        .category-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .category-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .category-icon svg { width: 22px; height: 22px; }
        .category-icon.purple { background: var(--accent-purple-dim); color: var(--accent-purple); }
        .category-icon.green { background: var(--accent-green-dim); color: var(--accent-green); }
        .category-icon.blue { background: rgba(96, 165, 250, 0.15); color: var(--accent-blue); }
        .category-icon.red { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }
        .category-icon.yellow { background: rgba(251, 191, 36, 0.15); color: var(--accent-yellow); }
        .category-icon.cyan { background: rgba(34, 211, 238, 0.15); color: var(--accent-cyan); }

        .category-name { font-size: 1.25rem; font-weight: 700; }
        .category-count { font-size: 0.8rem; color: var(--text-muted); }

        /* Command Table */
        .command-table {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }

        .command-row {
            display: grid;
            grid-template-columns: minmax(180px, 1fr) 2fr auto;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-color);
            align-items: center;
            transition: background 0.2s;
        }

        .command-row:last-child { border-bottom: none; }
        .command-row:hover { background: var(--bg-card-hover); }

        .command-name {
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--accent-purple);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .command-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.2rem 0.5rem;
            background: rgba(251, 191, 36, 0.15);
            color: var(--accent-yellow);
            font-size: 0.65rem;
            font-weight: 600;
            border-radius: 4px;
            font-family: 'Inter', sans-serif;
        }

        .command-description { color: var(--text-secondary); font-size: 0.875rem; }

        .command-options { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.5rem; }

        .option-tag {
            padding: 0.2rem 0.5rem;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.7rem;
            border-radius: 4px;
        }

        .option-tag.required { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }
        .option-tag.optional { background: rgba(34, 211, 238, 0.15); color: var(--accent-cyan); }

        .command-actions { display: flex; gap: 0.5rem; }

        .copy-btn {
            padding: 0.5rem;
            background: transparent;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .copy-btn:hover { border-color: var(--accent-purple); color: var(--accent-purple); }
        .copy-btn.copied { border-color: var(--accent-green); color: var(--accent-green); }
        .copy-btn svg { width: 16px; height: 16px; }

        /* No Results */
        .no-results { text-align: center; padding: 4rem 2rem; display: none; }
        .no-results.visible { display: block; }
        .no-results svg { width: 48px; height: 48px; color: var(--text-muted); margin-bottom: 1rem; }
        .no-results h3 { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 0.5rem; }
        .no-results p { color: var(--text-muted); font-size: 0.9rem; }

        /* Footer */
        .footer { padding: 2.5rem 0; border-top: 1px solid var(--border-color); margin-top: 4rem; }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .footer-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
        .footer-link { color: var(--text-secondary); text-decoration: none; font-size: 0.875rem; transition: color 0.2s; }
        .footer-link:hover { color: var(--accent-purple); }
        .footer-copyright { color: var(--text-muted); font-size: 0.8rem; }

        /* Mobile Menu */
        .mobile-menu-btn { display: none; background: none; border: none; color: var(--text-primary); font-size: 1.5rem; cursor: pointer; padding: 0.5rem; }
        .mobile-menu { display: none; position: fixed; inset: 0; background: rgba(11, 15, 17, 0.98); backdrop-filter: blur(20px); z-index: 999; padding: 100px 2rem; }
        .mobile-menu.active { display: block; }
        .mobile-menu-links { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
        .mobile-menu-link { color: var(--text-primary); text-decoration: none; font-size: 1.25rem; font-weight: 600; }

        .hidden { display: none !important; }

        /* Responsive */
        @media (max-width: 1024px) {
            .page-layout { grid-template-columns: 1fr; }
            .sidebar { position: static; max-height: none; }
            .sidebar-card { margin-bottom: 1rem; }
            .category-nav { flex-direction: row; flex-wrap: wrap; gap: 0.5rem; }
            .category-nav-item { padding: 0.5rem 0.875rem; }
        }

        @media (max-width: 768px) {
            .navbar-links, .navbar-actions { display: none; }
            .mobile-menu-btn { display: block; }
            .command-row { grid-template-columns: 1fr; gap: 0.75rem; }
            .command-actions { justify-content: flex-end; }
            .footer-content { flex-direction: column; text-align: center; }
            .footer-links { justify-content: center; }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-inner">
                <a href="/" class="navbar-brand">
                    <img src="/images/CertiFried.png" alt="CertiFried" class="navbar-logo">
                    <span>CertiFried</span>
                </a>
                <div class="navbar-links">
                    <a href="/" class="navbar-link">Home</a>
                    <a href="/commands" class="navbar-link active">Commands</a>
                    <a href="/status" class="navbar-link">Status</a>
                    <a href="/docs" class="navbar-link">Docs</a>
                </div>
                <div class="navbar-actions">
                    <% if (user) { %>
                        <a href="/servers" class="btn btn-primary">Dashboard</a>
                    <% } else { %>
                        <a href="/auth/discord" class="btn btn-primary">Login</a>
                    <% } %>
                </div>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Toggle menu">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-links">
            <a href="/" class="mobile-menu-link">Home</a>
            <a href="/commands" class="mobile-menu-link">Commands</a>
            <a href="/status" class="mobile-menu-link">Status</a>
            <a href="/docs" class="mobile-menu-link">Docs</a>
            <% if (user) { %>
                <a href="/servers" class="btn btn-primary">Dashboard</a>
            <% } else { %>
                <a href="/auth/discord" class="btn btn-primary">Login</a>
            <% } %>
        </div>
    </div>

    <main>
        <div class="container">
            <div class="page-layout">
                <!-- Sidebar -->
                <aside class="sidebar">
                    <div class="sidebar-card">
                        <div class="sidebar-header">
                            <div class="sidebar-header-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <div class="sidebar-title">Commands</div>
                                <div class="sidebar-subtitle"><%= commands.length %> total</div>
                            </div>
                        </div>

                        <div class="search-wrapper">
                            <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <input type="text" id="commandSearch" class="search-input" placeholder="Search commands...">
                        </div>

                        <nav class="category-nav">
                            <button class="category-nav-item active" data-category="all">
                                <svg class="category-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                                All
                                <span class="category-nav-count"><%= commands.length %></span>
                            </button>
                            <%
                            const commandsByCategory = {};
                            commands.forEach(cmd => {
                                const cat = cmd.category || 'General';
                                if (!commandsByCategory[cat]) commandsByCategory[cat] = [];
                                commandsByCategory[cat].push(cmd);
                            });

                            const categoryConfig = {
                                'Admin': { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', color: 'purple' },
                                'Music': { icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3', color: 'blue' },
                                'Moderation': { icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z', color: 'red' },
                                'Fun': { icon: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z', color: 'yellow' },
                                'Utility': { icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z', color: 'cyan' },
                                'Streamer': { icon: 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z', color: 'purple' },
                                'Economy': { icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z', color: 'yellow' },
                                'Games': { icon: 'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z', color: 'green' },
                                'Community': { icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z', color: 'blue' },
                                'Grow': { icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', color: 'green' }
                            };

                            categories.forEach(cat => {
                                const config = categoryConfig[cat] || { icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', color: 'purple' };
                                const count = commandsByCategory[cat] ? commandsByCategory[cat].length : 0;
                                if (count === 0) return;
                            %>
                                <button class="category-nav-item" data-category="<%= cat %>">
                                    <svg class="category-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= config.icon %>"/></svg>
                                    <%= cat %>
                                    <span class="category-nav-count"><%= count %></span>
                                </button>
                            <% }); %>
                        </nav>
                    </div>
                </aside>

                <!-- Main Content -->
                <div class="main-content">
                    <div class="page-header">
                        <h1 class="page-title">Bot Commands</h1>
                        <p class="page-subtitle">Complete reference for all CertiFried MultiTool commands</p>
                    </div>

                    <div class="stats-bar">
                        <div class="stat-pill">
                            <span class="stat-pill-value"><%= commands.length %></span>
                            <span class="stat-pill-label">Commands</span>
                        </div>
                        <div class="stat-pill">
                            <span class="stat-pill-value"><%= categories.length %></span>
                            <span class="stat-pill-label">Categories</span>
                        </div>
                    </div>

                    <div id="commandsContainer">
                        <% categories.forEach(category => {
                            const cmds = commandsByCategory[category] || [];
                            if (cmds.length === 0) return;
                            const config = categoryConfig[category] || { icon: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', color: 'purple' };
                        %>
                            <section class="category-section" id="<%= category.toLowerCase().replace(/\s+/g, '-') %>" data-category="<%= category %>">
                                <div class="category-header">
                                    <div class="category-icon <%= config.color %>">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= config.icon %>"/></svg>
                                    </div>
                                    <div>
                                        <h2 class="category-name"><%= category %></h2>
                                        <span class="category-count"><%= cmds.length %> command<%= cmds.length !== 1 ? 's' : '' %></span>
                                    </div>
                                </div>

                                <div class="command-table">
                                    <% cmds.forEach(cmd => { %>
                                        <div class="command-row" data-command-name="/<%= cmd.name %>" data-command-description="<%= cmd.description %>">
                                            <div class="command-name">
                                                /<%= cmd.name %>
                                                <% if (cmd.default_member_permissions) { %>
                                                    <span class="command-badge">Admin</span>
                                                <% } %>
                                            </div>
                                            <div>
                                                <div class="command-description"><%= cmd.description %></div>
                                                <% if (cmd.options && cmd.options.length > 0) { %>
                                                    <div class="command-options">
                                                        <% cmd.options.forEach(opt => { %>
                                                            <span class="option-tag <%= opt.required ? 'required' : 'optional' %>"><%= opt.name %><%= opt.required ? '*' : '' %></span>
                                                        <% }); %>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="command-actions">
                                                <button class="copy-btn" data-command="/<%= cmd.name %>" title="Copy command">
                                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                                </button>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </section>
                        <% }); %>
                    </div>

                    <div class="no-results" id="noResults">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        <h3>No commands found</h3>
                        <p>Try adjusting your search query</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-links">
                    <a href="/commands" class="footer-link">Commands</a>
                    <a href="/status" class="footer-link">Status</a>
                    <a href="/docs" class="footer-link">Documentation</a>
                    <a href="/terms" class="footer-link">Terms</a>
                    <a href="/privacy" class="footer-link">Privacy</a>
                </div>
                <p class="footer-copyright">&copy; <%= new Date().getFullYear() %> CertiFried MultiTool</p>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('commandSearch');
            const navItems = document.querySelectorAll('.category-nav-item');
            const sections = document.querySelectorAll('.category-section');
            const noResults = document.getElementById('noResults');
            const commandsContainer = document.getElementById('commandsContainer');
            const copyBtns = document.querySelectorAll('.copy-btn');

            let currentCategory = 'all';

            searchInput.addEventListener('input', (e) => {
                filterCommands(e.target.value.toLowerCase(), currentCategory);
            });

            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    navItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                    currentCategory = item.dataset.category;
                    filterCommands(searchInput.value.toLowerCase(), currentCategory);

                    if (currentCategory !== 'all') {
                        const target = document.getElementById(currentCategory.toLowerCase().replace(/\s+/g, '-'));
                        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            function filterCommands(query, category) {
                let visibleCount = 0;

                sections.forEach(section => {
                    const catName = section.dataset.category;
                    let sectionVisible = false;

                    if (category !== 'all' && catName !== category) {
                        section.classList.add('hidden');
                        return;
                    }

                    section.classList.remove('hidden');
                    const rows = section.querySelectorAll('.command-row');

                    rows.forEach(row => {
                        const name = row.dataset.commandName.toLowerCase();
                        const desc = row.dataset.commandDescription.toLowerCase();

                        if (name.includes(query) || desc.includes(query)) {
                            row.classList.remove('hidden');
                            sectionVisible = true;
                            visibleCount++;
                        } else {
                            row.classList.add('hidden');
                        }
                    });

                    if (!sectionVisible) section.classList.add('hidden');
                });

                if (visibleCount === 0) {
                    commandsContainer.classList.add('hidden');
                    noResults.classList.add('visible');
                } else {
                    commandsContainer.classList.remove('hidden');
                    noResults.classList.remove('visible');
                }
            }

            copyBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const command = btn.dataset.command;
                    navigator.clipboard.writeText(command).then(() => {
                        btn.classList.add('copied');
                        btn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
                        setTimeout(() => {
                            btn.classList.remove('copied');
                            btn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
                        }, 2000);
                    });
                });
            });

            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    const isOpen = mobileMenu.classList.toggle('active');
                    mobileMenuBtn.innerHTML = isOpen
                        ? '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
                        : '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="24" height="24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
                });
            }
        });
    </script>
</body>
</html>
