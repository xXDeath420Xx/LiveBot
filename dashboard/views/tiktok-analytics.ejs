<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= username %> - TikTok Analytics | CertiFried MultiTool</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/unified-dark-theme.css">
    <style>
        body {
            background: linear-gradient(135deg, #0a0e27 0%, #1e2028 50%, #16181d 100%);
            min-height: 100vh;
        }

        .analytics-header {
            background: linear-gradient(135deg, rgba(167, 139, 250, 0.1) 0%, rgba(255, 0, 80, 0.1) 100%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem 0;
        }

        .creator-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid #a78bfa;
            object-fit: cover;
            box-shadow: 0 0 30px rgba(167, 139, 250, 0.4);
        }

        .creator-name {
            font-size: 2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.25rem;
        }

        .creator-handle {
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.1rem;
        }

        .stat-card {
            background: rgba(30, 32, 40, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: #a78bfa;
            box-shadow: 0 10px 30px rgba(167, 139, 250, 0.2);
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #a78bfa;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-tabs-custom {
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 2rem;
        }

        .nav-tabs-custom .nav-link {
            color: rgba(255, 255, 255, 0.6);
            border: none;
            padding: 1rem 1.5rem;
            font-weight: 500;
            position: relative;
        }

        .nav-tabs-custom .nav-link:hover {
            color: #fff;
        }

        .nav-tabs-custom .nav-link.active {
            color: #a78bfa;
            background: transparent;
        }

        .nav-tabs-custom .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: #a78bfa;
        }

        .data-table {
            background: rgba(30, 32, 40, 0.6);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .data-table th {
            background: rgba(167, 139, 250, 0.2);
            color: #fff;
            font-weight: 600;
            padding: 1rem;
            border: none;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        .data-table td {
            padding: 0.875rem 1rem;
            color: rgba(255, 255, 255, 0.8);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

        .data-table tbody tr:hover {
            background: rgba(167, 139, 250, 0.1);
        }

        .positive {
            color: #57F287;
        }

        .negative {
            color: #ED4245;
        }

        .video-thumbnail {
            width: 80px;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
        }

        .schedule-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 0.5rem;
        }

        .schedule-cell {
            background: rgba(30, 32, 40, 0.6);
            border-radius: 8px;
            padding: 0.75rem;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .schedule-cell .day {
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 0.25rem;
        }

        .schedule-cell .count {
            font-size: 1.25rem;
            font-weight: 700;
            color: #a78bfa;
        }

        .tiktok-brand {
            color: #FF0050;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .brand-header img {
            height: 30px;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.3;
        }

        .btn-tiktok {
            background: linear-gradient(135deg, #FF0050 0%, #00F2EA 100%);
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-tiktok:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(255, 0, 80, 0.4);
            color: #fff;
        }

        .video-link {
            color: #a78bfa;
            text-decoration: none;
        }

        .video-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: rgba(0, 0, 0, 0.3);">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/logo.png" alt="CertiFried" height="40" class="me-2">
                <span class="fw-bold">CertiFried MultiTool</span>
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/">Home</a>
                <a class="nav-link" href="/dashboard">Dashboard</a>
            </div>
        </div>
    </nav>

    <!-- Creator Header -->
    <div class="analytics-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto">
                    <img src="<%= avatar || '/images/default-avatar.png' %>" alt="<%= username %>" class="creator-avatar">
                </div>
                <div class="col">
                    <h1 class="creator-name"><%= username %></h1>
                    <p class="creator-handle mb-2">@<%= username %></p>
                    <a href="https://tiktok.com/@<%= username %>" target="_blank" class="btn btn-tiktok btn-sm">
                        <i class="fab fa-tiktok me-1"></i> View on TikTok
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="container py-4">
        <div class="row g-4 mb-4">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-value"><%= formatNumber(stats.totalVideos) %></div>
                    <div class="stat-label">Total Videos</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-value"><%= formatNumber(stats.totalViews) %></div>
                    <div class="stat-label">Total Views</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-value"><%= formatNumber(stats.totalLikes) %></div>
                    <div class="stat-label">Total Likes</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-value"><%= formatNumber(stats.avgEngagement) %>%</div>
                    <div class="stat-label">Avg Engagement</div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#videos" type="button">
                    <i class="fas fa-video me-1"></i> Video Statistics
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#schedule" type="button">
                    <i class="fas fa-calendar me-1"></i> Posting Schedule
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- Video Statistics Tab -->
            <div class="tab-pane fade show active" id="videos">
                <% if (videos.length > 0) { %>
                <div class="data-table">
                    <table class="table table-dark mb-0">
                        <thead>
                            <tr>
                                <th>Video</th>
                                <th>Title</th>
                                <th>Posted</th>
                                <th>Views</th>
                                <th>Likes</th>
                                <th>Comments</th>
                                <th>Shares</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% videos.forEach(video => { %>
                            <tr>
                                <td>
                                    <a href="<%= video.video_url %>" target="_blank">
                                        <img src="<%= video.thumbnail_url || avatar || '/images/default-avatar.png' %>"
                                             alt="Video thumbnail" class="video-thumbnail"
                                             onerror="this.src='<%= avatar || '/images/default-avatar.png' %>'">
                                    </a>
                                </td>
                                <td>
                                    <a href="<%= video.video_url %>" target="_blank" class="video-link">
                                        <%= video.title ? (video.title.length > 50 ? video.title.substring(0, 50) + '...' : video.title) : 'Untitled' %>
                                    </a>
                                </td>
                                <td><%= formatDate(video.posted_at) %></td>
                                <td><%= formatNumber(video.view_count) %></td>
                                <td><%= formatNumber(video.like_count) %></td>
                                <td><%= formatNumber(video.comment_count) %></td>
                                <td><%= formatNumber(video.share_count) %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fab fa-tiktok"></i>
                    <h4>No Videos Found</h4>
                    <p>We haven't tracked any videos for this creator yet.</p>
                </div>
                <% } %>
            </div>

            <!-- Posting Schedule Tab -->
            <div class="tab-pane fade" id="schedule">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h5 class="mb-3"><i class="fas fa-calendar-week me-2"></i>Posts by Day of Week</h5>
                        <div class="schedule-grid">
                            <% const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']; %>
                            <% days.forEach((day, index) => { %>
                            <div class="schedule-cell">
                                <div class="day"><%= day %></div>
                                <div class="count"><%= schedule.byDay[index] || 0 %></div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h5 class="mb-3"><i class="fas fa-clock me-2"></i>Most Active Hours</h5>
                        <div class="data-table">
                            <table class="table table-dark mb-0">
                                <thead>
                                    <tr>
                                        <th>Hour</th>
                                        <th>Posts</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% schedule.byHour.slice(0, 6).forEach(item => { %>
                                    <tr>
                                        <td><%= item.hour %>:00</td>
                                        <td><%= item.count %> posts</td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 py-4" style="border-top: 1px solid rgba(255,255,255,0.1);">
            <p class="text-muted mb-2">
                Powered by <a href="/" class="text-decoration-none" style="color: #a78bfa;">CertiFried MultiTool</a>
            </p>
            <p class="text-muted small">
                Analytics data is collected from tracked TikTok video posts.
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
