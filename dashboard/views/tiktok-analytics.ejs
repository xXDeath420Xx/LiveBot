<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: (username) + ' — TikTok analytics | CertiFried MultiTool', description: 'TikTok video statistics for ' + (username) + ': views, likes, comments, shares and posting times.' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
    <link rel="stylesheet" href="/css/cf-analytics.css">
    <style>
        .tt-avatar { flex: none; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; background: var(--cf-surface-2); border: 1px solid var(--cf-border);
            display: inline-flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 600; color: var(--cf-text-2); }
        .tt-thumb { width: 44px; height: 58px; object-fit: cover; border-radius: var(--cf-radius-sm); background: var(--cf-surface-2); display: block; }
        .tt-title { max-width: 32rem; overflow-wrap: anywhere; }
        .tt-tools { display: flex; gap: var(--cf-2); align-items: center; flex-wrap: wrap; margin: 0 0 var(--cf-3); }
        .tt-tools input[type="search"] { flex: 1 1 14rem; max-width: 22rem; }
        #ttTable th[data-sort] { cursor: pointer; user-select: none; }
        #ttTable th[aria-sort="ascending"]::after { content: " \2191"; }
        #ttTable th[aria-sort="descending"]::after { content: " \2193"; }
    </style>
</head>
<%
    const n = (v) => Number(v || 0).toLocaleString('en-US');
    const short = formatNumber;
    const handle = String(username || '').replace(/[^A-Za-z0-9._]/g, '');
    // Posting times in UTC, so the page reads the same for every visitor.
    const byDay = [0, 0, 0, 0, 0, 0, 0], byHour = new Array(24).fill(0);
    let dated = 0;
    for (const v of videos) { if (!v.posted_at) continue; const d = new Date(v.posted_at); if (isNaN(d)) continue; byDay[d.getUTCDay()]++; byHour[d.getUTCHours()]++; dated++; }
    const maxDay = Math.max(1, ...byDay), maxHour = Math.max(1, ...byHour);
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const bestDay = byDay.indexOf(Math.max(...byDay)), bestHour = byHour.indexOf(Math.max(...byHour));
    const avgViews = videos.length ? Math.round(stats.totalViews / videos.length) : 0;
    const safeUrl = (u) => /^https:\/\//i.test(String(u || '')) ? u : null;
%>
<body class="cf-an-body">
<%- include('partials/site-header') %>
<main id="main-content" class="cf-an-page" tabindex="-1">
    <header class="cf-an-head">
        <% if (safeUrl(avatar)) { %><img class="tt-avatar" src="<%= avatar %>" alt="" width="56" height="56" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'tt-avatar',textContent:'<%= handle.charAt(0).toUpperCase() %>'}))">
        <% } else { %><span class="tt-avatar" aria-hidden="true"><%= handle.charAt(0).toUpperCase() || '?' %></span><% } %>
        <div class="cf-an-head-text">
            <h1 class="cf-an-title"><%= username %></h1>
            <p class="cf-an-sub">TikTok video statistics from the last <%= n(videos.length) %> video<%= videos.length === 1 ? '' : 's' %> CertiFried tracked, as counted when each video was first seen.</p>
        </div>
        <div class="cf-an-actions">
            <a href="https://www.tiktok.com/@<%= handle %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><i class="fab fa-tiktok" aria-hidden="true"></i> Open on TikTok</a>
            <% if (videos.length) { %><button type="button" class="btn btn-secondary btn-sm" id="csvBtn"><i class="fas fa-file-csv" aria-hidden="true"></i> Export CSV</button><% } %>
        </div>
    </header>

    <dl class="cf-kpis">
        <div class="cf-kpi"><dt>Videos</dt><dd><%= n(stats.totalVideos) %></dd></div>
        <div class="cf-kpi"><dt>Views</dt><dd title="<%= n(stats.totalViews) %>"><%= short(stats.totalViews) %></dd><span class="cf-kpi-sub"><%= short(avgViews) %> per video</span></div>
        <div class="cf-kpi"><dt>Likes</dt><dd title="<%= n(stats.totalLikes) %>"><%= short(stats.totalLikes) %></dd></div>
        <div class="cf-kpi"><dt>Comments</dt><dd title="<%= n(stats.totalComments) %>"><%= short(stats.totalComments) %></dd></div>
        <div class="cf-kpi"><dt>Shares</dt><dd title="<%= n(stats.totalShares) %>"><%= short(stats.totalShares) %></dd></div>
        <div class="cf-kpi"><dt>Engagement</dt><dd><%= Number(stats.avgEngagement || 0) %>%</dd><span class="cf-kpi-sub">likes and comments per view</span></div>
    </dl>

    <% if (!videos.length) { %>
    <div class="cf-rows"><div class="cf-state">
        <p class="cf-state-title">No videos tracked yet</p>
        <p class="cf-state-text">Statistics appear once CertiFried has seen this creator post on TikTok.</p>
    </div></div>
    <% } else { %>
    <h2 class="cf-an-section-title">When <%= username %> posts <span class="cf-an-count">UTC</span></h2>
    <div class="cf-an-grid is-2">
        <section class="cf-an-card" aria-labelledby="tt-day">
            <div class="cf-an-card-head"><h3 class="cf-an-card-title" id="tt-day">Posts by day</h3><% if (dated) { %><span class="cf-an-muted" style="font-size: var(--cf-text-xs);">Most: <%= dayNames[bestDay] %></span><% } %></div>
            <% if (!dated) { %><div class="cf-state cf-state--compact"><p class="cf-state-text">No post dates recorded.</p></div><% } else { %>
            <div class="cf-an-bars" role="img" aria-label="Posts by day of week: <%= dayNames.map((d, i) => d + ' ' + byDay[i]).join(', ') %>">
                <% byDay.forEach((c, i) => { %><div class="cf-an-bar<%= c ? '' : ' is-zero' %>" style="height: <%= Math.max(2, Math.round(100 * c / maxDay)) %>%" title="<%= dayNames[i] %>: <%= c %> post<%= c === 1 ? '' : 's' %>"></div><% }) %>
            </div>
            <div class="cf-an-bar-labels" aria-hidden="true"><% dayNames.forEach(d => { %><span><%= d %></span><% }) %></div>
            <% } %>
        </section>
        <section class="cf-an-card" aria-labelledby="tt-hour">
            <div class="cf-an-card-head"><h3 class="cf-an-card-title" id="tt-hour">Posts by hour</h3><% if (dated) { %><span class="cf-an-muted" style="font-size: var(--cf-text-xs);">Most: <%= String(bestHour).padStart(2, '0') %>:00</span><% } %></div>
            <% if (!dated) { %><div class="cf-state cf-state--compact"><p class="cf-state-text">No post times recorded.</p></div><% } else { %>
            <div class="cf-an-bars" role="img" aria-label="Posts by hour of day, UTC">
                <% byHour.forEach((c, h) => { %><div class="cf-an-bar<%= c ? '' : ' is-zero' %>" style="height: <%= Math.max(2, Math.round(100 * c / maxHour)) %>%" title="<%= String(h).padStart(2, '0') %>:00: <%= c %> post<%= c === 1 ? '' : 's' %>"></div><% }) %>
            </div>
            <div class="cf-an-bar-labels" aria-hidden="true"><% for (let h = 0; h < 24; h++) { %><span><%= h % 6 === 0 ? String(h).padStart(2, '0') : '' %></span><% } %></div>
            <% } %>
        </section>
    </div>

    <h2 class="cf-an-section-title">Videos <span class="cf-an-count"><%= n(videos.length) %></span></h2>
    <% if (videos.length > 15) { %>
    <div class="tt-tools"><input type="search" id="ttFind" class="form-control form-control-sm" placeholder="Find a video by title" aria-label="Find a video by title"></div>
    <% } %>
    <div class="cf-rows"><div class="cf-table-wrap">
        <table class="cf-table cf-table--stack" id="ttTable">
            <thead><tr>
                <th scope="col"><span class="cf-an-sr">Thumbnail</span></th>
                <th scope="col">Title</th>
                <th scope="col" data-sort="num" aria-sort="descending">Posted</th>
                <th scope="col" data-sort="num" class="cf-cell-end">Views</th>
                <th scope="col" data-sort="num" class="cf-cell-end">Likes</th>
                <th scope="col" data-sort="num" class="cf-cell-end">Comments</th>
                <th scope="col" data-sort="num" class="cf-cell-end">Shares</th>
            </tr></thead>
            <tbody>
            <% videos.forEach(v => { const url = safeUrl(v.video_url); const thumb = safeUrl(v.thumbnail_url); %>
            <tr data-find="<%= String(v.title || v.description || '').toLowerCase() %>">
                <td><% if (thumb) { %><a href="<%= url || '#' %>" target="_blank" rel="noopener" tabindex="-1"><img class="tt-thumb" src="<%= thumb %>" alt="" loading="lazy" width="44" height="58" onerror="this.style.visibility='hidden'"></a><% } %></td>
                <td data-label="Title" class="tt-title"><% if (url) { %><a href="<%= url %>" target="_blank" rel="noopener"><%= v.title || 'Untitled' %></a><% } else { %><%= v.title || 'Untitled' %><% } %></td>
                <td data-label="Posted" data-v="<%= v.posted_at ? new Date(v.posted_at).getTime() : 0 %>"><%= formatDate(v.posted_at) %></td>
                <td data-label="Views" class="cf-cell-end" data-v="<%= Number(v.view_count || 0) %>" title="<%= n(v.view_count) %>"><%= short(v.view_count) %></td>
                <td data-label="Likes" class="cf-cell-end" data-v="<%= Number(v.like_count || 0) %>"><%= short(v.like_count) %></td>
                <td data-label="Comments" class="cf-cell-end" data-v="<%= Number(v.comment_count || 0) %>"><%= short(v.comment_count) %></td>
                <td data-label="Shares" class="cf-cell-end" data-v="<%= Number(v.share_count || 0) %>"><%= short(v.share_count) %></td>
            </tr>
            <% }) %>
            </tbody>
        </table>
    </div></div>
    <% } %>
    <p class="cf-an-foot">Numbers come from the TikTok posts CertiFried tracks for upload alerts. Each video's views, likes, comments and shares are saved when it is first seen and are not updated after that. Powered by <a href="/">CertiFried MultiTool</a>.</p>
</main>
<%- include('partials/site-footer') %>
<% if (videos.length) { %>
<script>
(function () {
    var table = document.getElementById('ttTable');
    var body = table.tBodies[0];
    var heads = table.tHead.rows[0].cells;
    Array.prototype.forEach.call(heads, function (th, col) {
        if (!th.hasAttribute('data-sort')) return;
        th.tabIndex = 0;
        function sort() {
            var dir = th.getAttribute('aria-sort') === 'descending' ? 1 : -1;
            Array.prototype.slice.call(body.rows).sort(function (a, b) {
                return (Number(a.cells[col].getAttribute('data-v')) - Number(b.cells[col].getAttribute('data-v'))) * dir;
            }).forEach(function (tr) { body.appendChild(tr); });
            Array.prototype.forEach.call(heads, function (h) { h.removeAttribute('aria-sort'); });
            th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
        }
        th.addEventListener('click', sort);
        th.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sort(); } });
    });
    var find = document.getElementById('ttFind');
    if (find) find.addEventListener('input', function () {
        var q = find.value.trim().toLowerCase();
        Array.prototype.forEach.call(body.rows, function (tr) { tr.hidden = !!q && tr.getAttribute('data-find').indexOf(q) === -1; });
    });
    var data = <%- JSON.stringify(videos.map(v => [v.video_id, v.title || '', v.posted_at || '', Number(v.view_count || 0), Number(v.like_count || 0), Number(v.comment_count || 0), Number(v.share_count || 0), v.video_url || ''])).replace(/</g, '\\u003c') %>;
    document.getElementById('csvBtn').addEventListener('click', function () {
        function cell(v) { var s = v == null ? '' : String(v); if (/^[=+\-@\t\r]/.test(s)) s = "'" + s; s = s.replace(/"/g, '""'); return /[",\n\r]/.test(s) ? '"' + s + '"' : s; }
        var lines = [['video_id', 'title', 'posted_at', 'views', 'likes', 'comments', 'shares', 'url']].concat(data);
        var blob = new Blob([lines.map(function (r) { return r.map(cell).join(','); }).join('\n') + '\n'], { type: 'text/csv;charset=utf-8' });
        var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'tiktok-<%= handle %>-videos.csv';
        document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
    });
})();
</script>
<% } %>
</body>
</html>
