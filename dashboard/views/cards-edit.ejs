<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%- include('partials/cards-page-css') %>
    <link rel="stylesheet" href="/css/cf-settings.css">
    <style>
        .wrap { max-width: 760px; margin: 0 auto; padding: 24px 20px 80px; }
        .back-link { color: var(--cf-text-3); text-decoration: none; font-size: var(--cf-text-sm); display: inline-flex; align-items: center; gap: 6px; margin-bottom: 12px; }
        .back-link:hover { color: var(--cf-text); }
        .cf-rows .cf-row-control input[type=text], .cf-rows .cf-row-control input[type=url], .cf-rows .cf-row-control input[type=password] { width: 100%; }
        .slug-preview { font-size: var(--cf-text-xs); color: var(--cf-text-3); overflow-wrap: anywhere; }
        .slug-preview strong { color: var(--cf-text); font-family: var(--cf-mono); font-weight: 500; }
        .preview-img { width: 100%; max-height: 140px; object-fit: cover; border-radius: var(--cf-radius); border: 1px solid var(--cf-border); }
        .color-pair { display: flex; gap: 8px; align-items: center; }
        .color-pair input[type=color] { width: 44px; flex: none; }
        .save-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 24px; }
        .save-bar .push { margin-left: auto; }
        .status-line { font-size: var(--cf-text-sm); }
        .status-line.ok { color: var(--cf-success); }
        .status-line.err { color: var(--cf-danger); }
    </style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Edit ' + (card.card_name || 'card') + ' · CertiFried' }) %>
</head>
<body>
    <% const cardLink = card.slug || card.share_token; %>
    <%- include('partials/site-header', { user, active: 'cards', returnTo: '/card/' + cardLink + '/edit' }) %>
    <%- include('partials/section-tabs', { label: 'Group cards', active: 'mine', tabs: [['cards', '/cards', 'Overview'], ['create', '/cards/create', 'Create a card'], ['mine', '/cards/my-cards', 'My cards']] }) %>

    <main class="wrap" id="main-content">
        <a href="/cards/my-cards" class="back-link"><i class="fas fa-arrow-left" aria-hidden="true"></i> My cards</a>
        <div class="page-head">
            <h1>Edit card</h1>
            <p><%= card.card_name || 'Untitled card' %> · <%= card.card_type === 'greeting_card' ? 'Greeting card' : card.card_type === 'one_person' ? 'One-person card' : 'Group board' %></p>
        </div>

        <form id="editForm" novalidate>
            <section class="cf-section">
                <header class="cf-section-head"><div><h2 class="cf-section-title">Basics</h2></div></header>
                <div class="cf-rows">
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-card_name">Card title</label></div>
                        <div class="cf-row-control"><input id="f-cards-edit-card_name" class="form-control" type="text" name="card_name" value="<%= card.card_name || '' %>" maxlength="200"></div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-recipient_name">Who it's for</label></div>
                        <div class="cf-row-control"><input id="f-cards-edit-recipient_name" class="form-control" type="text" name="recipient_name" value="<%= card.recipient_name || '' %>" maxlength="200"></div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-cards-edit-custom_slug">Card link</label>
                            <p class="cf-row-desc">Lowercase letters, numbers and dashes. Changing it breaks the old link.</p>
                        </div>
                        <div class="cf-row-control">
                            <input id="f-cards-edit-custom_slug" class="form-control" type="text" name="custom_slug" value="<%= card.slug || '' %>" maxlength="200" pattern="[a-z0-9-]+" autocomplete="off" spellcheck="false">
                            <span class="slug-preview">certifriedmultitool.com/card/<strong id="slug-preview"><%= cardLink %></strong></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="cf-section">
                <header class="cf-section-head"><div><h2 class="cf-section-title">Media</h2></div></header>
                <div class="cf-rows">
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-background_music_url">Background music</label><p class="cf-row-desc">YouTube, SoundCloud or a direct audio link.</p></div>
                        <div class="cf-row-control"><input id="f-cards-edit-background_music_url" class="form-control" type="url" name="background_music_url" value="<%= card.background_music_url || '' %>" placeholder="https://"></div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-wishlist_url">Wishlist or gift link</label></div>
                        <div class="cf-row-control"><input id="f-cards-edit-wishlist_url" class="form-control" type="url" name="wishlist_url" value="<%= card.wishlist_url || '' %>" placeholder="https://"></div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-card_background_url">Cover image</label><p class="cf-row-desc">Shown on the front of the card.</p></div>
                        <div class="cf-row-control">
                            <input id="f-cards-edit-card_background_url" class="form-control" type="url" name="card_background_url" value="<%= card.card_background_url || '' %>" placeholder="https://…/image.jpg">
                            <% if (card.card_background_url) { %><img src="<%= card.card_background_url %>" class="preview-img" alt="Current cover"><% } %>
                        </div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-board_bg_image_url">Board background image</label><p class="cf-row-desc">Behind the messages.</p></div>
                        <div class="cf-row-control">
                            <input id="f-cards-edit-board_bg_image_url" class="form-control" type="url" name="board_bg_image_url" value="<%= card.board_bg_image_url || '' %>" placeholder="https://…/image.jpg">
                            <% if (card.board_bg_image_url) { %><img src="<%= card.board_bg_image_url %>" class="preview-img" alt="Current board background"><% } %>
                        </div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text"><label class="cf-row-label" for="f-cards-edit-board_bg_color">Board background colour</label><p class="cf-row-desc">Used when there is no background image.</p></div>
                        <div class="cf-row-control">
                            <div class="color-pair">
                                <input type="color" id="board_bg_color_picker" aria-label="Pick a colour" value="<%= /^#[0-9a-f]{6}$/i.test(card.board_bg_color || '') ? card.board_bg_color : '#1a1a2e' %>">
                                <input id="f-cards-edit-board_bg_color" class="form-control" type="text" name="board_bg_color" value="<%= card.board_bg_color || '' %>" placeholder="#1a1a2e" maxlength="40">
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="cf-section">
                <header class="cf-section-head"><div><h2 class="cf-section-title">Access</h2></div></header>
                <div class="cf-rows">
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-cards-edit-password"><%= card.password_hash ? 'Change password' : 'Password' %></label>
                            <p class="cf-row-desc"><%= card.password_hash ? 'A password is set. Leave this empty to keep it.' : 'Optional. People need it to open the card.' %></p>
                        </div>
                        <div class="cf-row-control">
                            <input id="f-cards-edit-password" class="form-control" type="password" name="password" autocomplete="new-password">
                            <% if (card.password_hash) { %>
                            <label class="cf-choice"><input type="checkbox" name="remove_password" id="remove_password"> Remove the password</label>
                            <% } %>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="is_frozen">Freeze card</label>
                            <p class="cf-row-desc" id="is_frozen-desc">No new messages can be added.</p>
                        </div>
                        <div class="cf-row-control">
                            <input type="checkbox" class="cf-switch" role="switch" id="is_frozen" name="is_frozen" aria-describedby="is_frozen-desc" <%= card.is_frozen ? 'checked' : '' %>>
                        </div>
                    </div>
                </div>
            </section>

            <div class="save-bar">
                <button type="submit" class="btn btn-primary" id="save-btn">Save changes</button>
                <a href="/card/<%= cardLink %>" class="btn btn-secondary">View card</a>
                <span class="status-line" id="status" role="status"></span>
                <button type="button" class="btn btn-danger push" onclick="deleteCard()">Delete card</button>
            </div>
        </form>
    </main>
    <%- include('partials/site-footer') %>

    <script>
    const slug = <%- JSON.stringify(cardLink).replace(/</g, '\\u003c') %>;
    const picker = document.getElementById('board_bg_color_picker');
    const colorText = document.getElementById('f-cards-edit-board_bg_color');
    picker.addEventListener('input', () => { colorText.value = picker.value; });
    colorText.addEventListener('input', () => { if (/^#[0-9a-f]{6}$/i.test(colorText.value.trim())) picker.value = colorText.value.trim(); });
    const slugInput = document.getElementById('f-cards-edit-custom_slug');
    slugInput.addEventListener('input', () => {
        const v = slugInput.value.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/^-|-$/g, '');
        document.getElementById('slug-preview').textContent = v || slug;
    });

    document.getElementById('editForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = new FormData(e.target);
        const data = Object.fromEntries(form.entries());
        data.is_frozen = document.getElementById('is_frozen').checked ? '1' : '';
        data.remove_password = document.getElementById('remove_password')?.checked ? '1' : '';
        const btn = document.getElementById('save-btn');
        btn.disabled = true;
        try {
            const res = await fetch('/card/' + encodeURIComponent(slug) + '/edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                showStatus('Saved');
                // Cards made before links existed have no slug; result.slug is then null.
                if (result.slug && result.slug !== slug) {
                    setTimeout(() => window.location.href = '/card/' + encodeURIComponent(result.slug) + '/edit', 800);
                }
            } else {
                showStatus(result.error || 'Could not save.', true);
            }
        } catch (err) {
            showStatus('Could not reach the server. Try again.', true);
        } finally {
            btn.disabled = false;
        }
    });

    function deleteCard() {
        if (!confirm('Delete this card and all its messages? This cannot be undone.')) return;
        fetch('/card/' + encodeURIComponent(slug), { method: 'DELETE' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showStatus('Card deleted');
                    setTimeout(() => window.location.href = '/cards/my-cards', 800);
                } else {
                    showStatus(data.error || 'Could not delete the card.', true);
                }
            })
            .catch(() => showStatus('Could not reach the server. Try again.', true));
    }

    let statusTimer = null;
    function showStatus(msg, isError) {
        const t = document.getElementById('status');
        t.textContent = msg;
        t.className = 'status-line ' + (isError ? 'err' : 'ok');
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => { t.textContent = ''; }, isError ? 8000 : 3000);
    }
    </script>
</body>
</html>
