<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%
    const fmt = (n) => Number(n || 0).toLocaleString('en-US');
    const plural = (n, word) => `${fmt(n)} ${word}${n === 1 ? '' : 's'}`;
    const zone = (typeof tz === 'string' && tz) ? tz : 'UTC';
    const stampFmt = new Intl.DateTimeFormat('sv-SE', { timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const stamp = (d) => d ? stampFmt.format(new Date(d)) : '—';
    const day = (d) => d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: zone }) : '—';
    const ms = (d) => d ? new Date(d).getTime() : 0;
    const s = list.summary;
    const shown = onlyNew ? list.accounts.filter(a => a.isNew) : list.accounts;
%>
<style>
    /* Page palette, drawn from the site tokens (cf-ui.css) so it follows the theme. */
    :root { --bg: var(--cf-bg); --ink: var(--cf-text); --muted: var(--cf-text-3); --line: var(--cf-border); --soft: var(--cf-surface);
            --note-ink: var(--cf-text-2); --accent: var(--cf-accent); --link: var(--cf-accent-fg); --good: var(--cf-success); --warn: var(--cf-warning); --bad: var(--cf-danger);
            --tag-met: color-mix(in srgb, var(--cf-danger) 14%, transparent); --tag-na: var(--cf-surface-2); --tag-warn: color-mix(in srgb, var(--cf-warning) 14%, transparent); }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); }
    .page { max-width: 1240px; margin: 0 auto; padding: 24px 20px 48px; font-size: 13px; line-height: 1.5; }
    h1 { font-size: 22px; margin: 0; }
    .meta { color: var(--muted); font-size: 12px; margin-top: 4px; }
    .toolbar { display: flex; gap: 8px; margin: 16px 0 0; flex-wrap: wrap; align-items: center; }
    .toolbar a { padding: 6px 12px; border: 1px solid var(--line); border-radius: 6px; text-decoration: none; color: var(--ink); font-size: 12px; background: var(--cf-surface); }
    .toolbar a:hover { background: var(--soft); }
    .toolbar input { font: inherit; font-size: 12px; padding: 6px 10px; border: 1px solid var(--cf-border-strong); border-radius: 6px; background: var(--cf-inset); color: var(--ink); width: 220px; margin-left: auto; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 16px; }
    .stat { background: var(--soft); border-radius: 8px; padding: 10px 12px; }
    .stat .k { color: var(--muted); font-size: 11px; } .stat .v { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .stat .d { color: var(--muted); font-size: 11px; }
    .note { background: var(--soft); border-radius: 8px; padding: 10px 12px; font-size: 12px; color: var(--note-ink); margin-top: 8px; }
    .note p { margin: 0; } .note p + p { margin-top: 6px; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th, td { text-align: left; vertical-align: middle; padding: 5px 8px; border-bottom: 1px solid var(--line); font-size: 12px; white-space: nowrap; }
    thead th { position: sticky; top: var(--cf-header-h, 56px); z-index: 1; background: var(--bg); box-shadow: inset 0 -1px 0 var(--line); font-size: 11px; color: var(--muted); font-weight: 500; }
    th button { all: unset; cursor: pointer; font-size: 11px; color: var(--muted); font-weight: 500; }
    th button:hover, th button:focus-visible { color: var(--ink); }
    th[aria-sort="ascending"] button::after { content: " ↑"; } th[aria-sort="descending"] button::after { content: " ↓"; }
    th[aria-sort="ascending"] button, th[aria-sort="descending"] button { color: var(--ink); }
    tbody tr:hover td { background: var(--soft); }
    .num { font-variant-numeric: tabular-nums; }
    .dim { color: var(--muted); }
    td a { color: var(--link); text-decoration: none; } td a:hover { text-decoration: underline; }
    td a.acct { color: var(--ink); font-weight: 500; }
    .tag { display: inline-block; padding: 0 7px; border-radius: 999px; font-size: 10.5px; font-weight: 600; }
    .tag.met { background: var(--tag-met); color: var(--bad); } .tag.warn { background: var(--tag-warn); color: var(--warn); } .tag.na { background: var(--tag-na); color: var(--muted); }
    .tag.new { background: var(--accent); color: var(--cf-on-accent); }
    .tabs { display: flex; gap: 4px; margin-top: 16px; border-bottom: 1px solid var(--line); }
    .tabs a { padding: 6px 12px; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--muted); text-decoration: none; font-size: 12px; }
    .tabs a:hover { color: var(--ink); }
    .tabs a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--accent); font-weight: 500; }
    tr.is-new td:first-child { box-shadow: inset 2px 0 0 var(--accent); }
    .empty { margin-top: 16px; }
    @media (max-width: 1100px) { .sheet { overflow-x: auto; } thead th { position: static; } }
    @media (max-width: 640px) { .page { padding: 24px 16px 40px; } .grid { grid-template-columns: repeat(2, 1fr); } .toolbar input { width: 100%; margin-left: 0; } }
</style>
<%- include('partials/site-head', { title: (login) + ' · Known-bot accounts · CertiFried' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
    <link rel="stylesheet" href="/css/cf-analytics.css">
</head>
<body class="cf-an-body">
<%- include('partials/site-header') %>
<main id="main-content" class="page" tabindex="-1">
<%- include('partials/analytics/twitch-nav', { active: 'known-bots' }) %>
    <h1>Known-bot accounts — <%= login %></h1>
    <div class="meta">Accounts seen in this channel whose Twitch ID is on CommanderRoot's known-bot list · generated <%= stamp(list.generatedAt) %> · times in <%= zone %></div>
    <% if (s.seenFrom) { %><div class="meta">Chat data from <%= day(s.seenFrom) %>, when CertiFried started collecting for this channel. Nothing before that is known to this list.</div><% } %>

    <div class="toolbar">
        <a href="/manage/<%= guildId %>/twitch-analytics/integrity?days=<%= days %>">Back to channel audit</a>
        <% if (shown.length) { %>
        <a href="<%= base %>.csv<%= onlyNew ? '?view=new' : '' %>">Download <%= onlyNew ? 'new accounts ' : '' %>CSV</a>
        <input type="search" id="find" placeholder="Find an account or ID" aria-label="Find an account or ID">
        <% } %>
    </div>

    <% if (!list.accounts.length) { %>
    <div class="note empty">No account seen in this channel is on CommanderRoot's list.</div>
    <% } else { %>
    <div class="grid">
        <div class="stat"><div class="k">Accounts on the list</div><div class="v"><%= fmt(s.count) %></div></div>
        <div class="stat"><div class="k">Oldest account</div><div class="v"><%= day(s.oldest) %></div></div>
        <div class="stat"><div class="k">Newest account</div><div class="v"><%= day(s.newest) %></div></div>
        <div class="stat"><div class="k">Largest <%= batchDays %>-day creation batch</div><div class="v"><%= fmt(s.batch.count) %></div><% if (s.batch.count) { %><div class="d"><%= day(s.batch.from) %> to <%= day(s.batch.to) %></div><% } %></div>
    </div>

    <div class="note">
        <p>Being on the list says what an account is, not who sent it. It is no evidence of who is behind these accounts or that the streamer knew about them.</p>
        <p><strong>Confirm</strong> opens CommanderRoot's list at that account. The page is raw data: a list of Twitch IDs. If the account is listed, the first ID shown is the one in the User ID column here.</p>
        <p><strong>Report</strong> opens Twitch's own report form for that account. Nothing is filed until you submit it there.<% if (s.lookFirst) { %> <%= plural(s.lookFirst, 'account') %> marked in the Notes column <%= s.lookFirst === 1 ? 'has' : 'have' %> chatted or <%= s.lookFirst === 1 ? 'holds' : 'hold' %> a role in this channel, so look at <%= s.lookFirst === 1 ? 'it' : 'them' %> before reporting.<% } %></p>
    </div>

    <nav class="tabs" aria-label="Which accounts to show">
        <a href="<%= base %>?days=<%= days %>"<% if (!onlyNew) { %> aria-current="page"<% } %>>All accounts (<%= fmt(s.count) %>)</a>
        <a href="<%= base %>?days=<%= days %>&view=new"<% if (onlyNew) { %> aria-current="page"<% } %>>New in latest stream (<%= fmt(s.newCount) %>)</a>
    </nav>
    <% if (s.newSince) { %><div class="meta">New means first seen in this channel, or first found on CommanderRoot's list, since the latest stream started on <%= stamp(s.newSince) %>.</div><% } %>

    <% if (!shown.length) { %>
    <div class="note empty">No account has been added to this list since the latest stream started.</div>
    <% } else { %>
    <div class="sheet">
    <table id="sheet">
        <thead><tr>
            <th scope="col" class="num">#</th>
            <th scope="col" data-type="text"><button type="button">Account</button></th>
            <th scope="col" data-type="num"><button type="button">User ID</button></th>
            <th scope="col" data-type="num" aria-sort="ascending"><button type="button">Created</button></th>
            <th scope="col">On the list</th>
            <th scope="col" data-type="num"><button type="button">Checked</button></th>
            <th scope="col" data-type="num"><button type="button">First in chat</button></th>
            <th scope="col" data-type="num"><button type="button">Last in chat</button></th>
            <th scope="col" data-type="num"><button type="button">Minutes</button></th>
            <th scope="col">Notes</th>
            <th scope="col">Report</th>
        </tr></thead>
        <tbody>
        <% shown.forEach((a, i) => { %>
            <tr data-find="<%= a.login %> <%= a.id %>"<% if (a.isNew) { %> class="is-new"<% } %>>
                <td class="num dim"><%= i + 1 %></td>
                <td data-v="<%= a.login %>"><a class="acct" href="<%= a.profileUrl %>" target="_blank" rel="noopener noreferrer"><%= a.login %></a></td>
                <td class="num dim" data-v="<%= a.id %>"><%= a.id %></td>
                <td class="num" data-v="<%= ms(a.created) %>"><%= stamp(a.created) %></td>
                <td><span class="tag met">Listed</span> <a href="<%= a.listUrl %>" target="_blank" rel="noopener noreferrer">Confirm</a></td>
                <td class="num dim" data-v="<%= ms(a.checkedAt) %>"><%= stamp(a.checkedAt) %></td>
                <td class="num" data-v="<%= ms(a.firstSeen) %>"><%= stamp(a.firstSeen) %></td>
                <td class="num" data-v="<%= ms(a.lastSeen) %>"><%= stamp(a.lastSeen) %></td>
                <td class="num" data-v="<%= a.minutes %>"><%= fmt(a.minutes) %></td>
                <td>
                    <% if (a.isNew) { %><span class="tag new">New</span><% } %>
                    <% if (a.chatted) { %><span class="tag warn">Has chatted</span><% } %>
                    <% if (a.role) { %><span class="tag warn"><%= a.role %></span><% } %>
                    <% if (a.inBatch) { %><span class="tag na">Creation batch</span><% } %>
                </td>
                <td><% if (a.exists === false) { %><span class="dim">Removed<%= a.goneAt ? ` ${day(a.goneAt)}` : '' %></span><% } else { %><a href="<%= a.reportUrl %>" target="_blank" rel="noopener noreferrer">Report</a><% } %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    </div>
    <div class="meta" style="margin-top: 10px;"><% if (s.removed) { %><%= plural(s.removed, 'account') %> no longer returned by Twitch, suspended or deleted; Twitch does not say which. <% } %>Created is the account's creation date from Twitch. Checked is the last time we found it on the list; accounts are rechecked weekly and leave this page if they come off the list.</div>

    <script>
        (function () {
            var table = document.getElementById('sheet'), body = table.tBodies[0], heads = table.tHead.rows[0].cells;
            function renumber() {
                var n = 0;
                Array.prototype.forEach.call(body.rows, function (tr) { if (tr.style.display !== 'none') tr.cells[0].textContent = ++n; });
            }
            Array.prototype.forEach.call(heads, function (th, col) {
                var type = th.getAttribute('data-type');
                if (!type) return;
                th.querySelector('button').addEventListener('click', function () {
                    var dir = th.getAttribute('aria-sort') === 'ascending' ? -1 : 1;
                    var value = function (tr) { var v = tr.cells[col].getAttribute('data-v'); return type === 'num' ? Number(v) : v; };
                    Array.prototype.slice.call(body.rows).sort(function (a, b) {
                        var x = value(a), y = value(b);
                        return (x < y ? -1 : x > y ? 1 : 0) * dir;
                    }).forEach(function (tr) { body.appendChild(tr); });
                    Array.prototype.forEach.call(heads, function (h) { h.removeAttribute('aria-sort'); });
                    th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
                    renumber();
                });
            });
            document.getElementById('find').addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                Array.prototype.forEach.call(body.rows, function (tr) {
                    tr.style.display = !q || tr.getAttribute('data-find').indexOf(q) !== -1 ? '' : 'none';
                });
                renumber();
            });
        })();
    </script>
    <% } %>
    <% } %>
    <div class="meta" style="margin-top: 18px;">Generated by CertiFried · broadcaster id <%= bid %></div>
</main>
<%- include('partials/site-footer') %>
</body>
</html>
