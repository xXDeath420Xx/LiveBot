<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
  <style>
    /* Landing / product chooser. Tokens come from /css/cf-ui.css (loaded last).
       The two platform colours are Discord's and Kick's own, used only to mark
       which product a card is for and on its sign-in button. */
    .wrap,.wrap *{box-sizing:border-box}
    .wrap *{margin:0;padding:0}
    :root{--discord:#5865f2;--kick:#53fc18}
    .bg{display:none}
    .wrap{position:relative;z-index:1;max-width:60rem;margin:0 auto;padding:56px 24px 24px}
    @media(max-width:600px){.wrap{padding:32px 16px 16px}}
    .cta{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px}
    .what{margin:0 0 40px}
    .what h2{font-size:1.125rem;font-weight:600;letter-spacing:-.01em;margin:0 0 4px}
    .what > p{color:var(--text-secondary);font-size:.9375rem;margin:0 0 16px}
    .what .cfs-grid{grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}
    .ftt-sub b{color:var(--text-primary)}
    h1{font-weight:600;font-size:clamp(2rem,4.6vw,3rem);line-height:1.1;letter-spacing:-.03em;margin-bottom:16px;max-width:18ch}
    h1 .g{color:inherit;background:none}
    .lede{color:var(--text-secondary);font-size:1.0625rem;max-width:52ch;margin:0 0 24px;line-height:1.6}
    .verified{display:inline-flex;align-items:center;gap:8px;margin:0 0 40px;padding:6px 12px;border-radius:6px;border:1px solid var(--border-color);background:var(--bg-secondary);color:var(--text-secondary);font-size:.8125rem;text-decoration:none}
    .verified:hover,.verified:focus-visible{border-color:var(--border-strong);color:var(--text-primary)}
    .verified .check{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;background:var(--discord);color:#fff;font-size:10px;font-weight:700;flex:0 0 auto}
    .verified .go-disc{color:var(--text-primary);font-weight:500;white-space:nowrap}
    .cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:40px}
    @media(max-width:720px){.cards{grid-template-columns:1fr}}
    .card{position:relative;display:flex;flex-direction:column;border:1px solid var(--border-color);border-radius:8px;padding:24px;background:var(--bg-secondary);text-decoration:none;color:inherit;transition:border-color .15s}
    .card:hover{border-color:var(--border-strong);color:inherit}
    .badge{display:inline-flex;align-items:center;gap:8px;font-size:.8125rem;font-weight:500;color:var(--text-muted);margin-bottom:8px}
    .badge::before{content:'';width:8px;height:8px;border-radius:2px;background:var(--discord)}
    .card.k .badge::before{background:var(--kick)}
    .signed{font-size:.75rem;color:var(--accent-green)}
    .card h2{font-size:1.25rem;font-weight:600;letter-spacing:-.015em;margin-bottom:8px}
    .card p{color:var(--text-secondary);font-size:.9375rem;line-height:1.6;margin-bottom:20px;flex:1}
    .go{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:.875rem;padding:8px 14px;border-radius:6px}
    .card.d .go{background:var(--discord);color:#fff}.card.k .go{background:var(--kick);color:#06140a}
    .card:hover .go{filter:brightness(1.08)}
    .mini{margin-top:20px;padding-top:16px;border-top:1px solid var(--border-color);display:flex;gap:32px}
    .mini b{display:block;font-size:1.125rem;font-weight:600;font-variant-numeric:tabular-nums}
    .mini span{color:var(--text-muted);font-size:.8125rem}
    .mini .sub{display:block;margin-top:2px;font-size:.75rem}
    .statbar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:40px;border:1px solid var(--border-color);border-radius:8px;overflow:hidden;background:var(--bg-secondary)}
    .statbar .s{padding:16px 20px;border-left:1px solid var(--border-color)}
    .statbar .s:first-child{border-left:0}
    .statbar b{display:block;font-size:1.5rem;font-weight:600;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
    .statbar span{color:var(--text-muted);font-size:.8125rem}
    .statbar .sub{display:block;margin-top:2px;font-size:.75rem}
    @media(max-width:720px){.statbar{grid-template-columns:1fr 1fr}.statbar .s:nth-child(3){border-left:0}.statbar .s:nth-child(n+3){border-top:1px solid var(--border-color)}}
    /* ---- 4:20 world clock ---- */
    .ftt{position:relative;z-index:1;margin:0 0 40px;border:1px solid var(--border-color);border-radius:8px;padding:20px 24px;background:var(--bg-secondary);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 24px;align-items:center}
    .ftt-head{grid-column:1/-1;display:flex;align-items:center;gap:8px;font-size:.8125rem;color:var(--text-muted);margin-bottom:8px}
    .ftt-head b{color:var(--text-primary);font-weight:600}
    .ftt-leaf{display:none}
    .ftt-now{font-size:1rem;line-height:1.5;color:var(--text-secondary)}
    .ftt-now .place{font-weight:600;color:var(--text-primary)}
    .ftt-now.lit,.ftt-now.lit .place{color:var(--accent-green)}
    .ftt-clock{grid-row:2/4;grid-column:2;font-family:var(--cf-mono);font-weight:500;font-size:clamp(1.75rem,4vw,2.5rem);letter-spacing:-.02em;line-height:1;color:var(--text-primary);font-variant-numeric:tabular-nums}
    .ftt-sub{color:var(--text-muted);font-size:.8125rem}
    .ftt-ticker{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
    .ftt-ticker .chip{font-size:.75rem;color:var(--text-muted);border:1px solid var(--border-color);border-radius:4px;padding:2px 8px;white-space:nowrap;font-variant-numeric:tabular-nums}
    .ftt-ticker .chip b{color:var(--text-primary);font-weight:500}
    .ftt.islit{border-color:color-mix(in srgb,var(--accent-green) 50%,var(--border-color))}
    .ftt-obs{grid-column:1/-1;justify-self:start;margin-top:12px;font-size:.8125rem;color:var(--text-muted);text-decoration:underline;text-underline-offset:2px}
    .ftt-obs:hover,.ftt-obs:focus-visible{color:var(--text-primary)}
    @media(max-width:560px){.ftt{grid-template-columns:1fr}.ftt-clock{grid-row:auto;grid-column:1;margin-top:8px}}
    /* ---- See it in action: guide screenshots (dashboard/public/img/guides, scripts/site-shots) ---- */
    .show{margin:0 0 40px}
    .show h2{font-size:1.125rem;font-weight:600;letter-spacing:-.01em;margin:0 0 4px}
    .show > p{color:var(--text-secondary);font-size:.9375rem;margin:0 0 16px}
    .show ul{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,210px),1fr));gap:16px}
    .show a{display:block;height:100%;border:1px solid var(--border-color);border-radius:8px;overflow:hidden;background:var(--bg-secondary);color:inherit;text-decoration:none;transition:border-color .15s}
    .show a:hover{border-color:var(--border-strong)}
    .show a:focus-visible{outline:2px solid var(--cf-accent);outline-offset:2px}
    .show .pic{display:block;aspect-ratio:4/3;background:var(--cf-shot-bg);border-bottom:1px solid var(--border-color);overflow:hidden}
    .show img{display:block;width:100%;height:100%;object-fit:cover;object-position:top left}
    .show .cap{display:block;padding:12px 14px}
    .show .cap b{display:block;font-size:.9375rem;font-weight:600;margin-bottom:2px}
    .show .cap span{display:block;color:var(--text-secondary);font-size:.8125rem;line-height:1.5}
  </style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'CertiFried Utility — Discord & Kick bots', description: 'CertiFried Utility — server management and community games on Discord, and a shared-banlist defense network on Kick. Pick where you need us.' }) %>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: 'home', user: locals.user || null, returnTo: '/dashboard' }) %>
  <main id="main-content" tabindex="-1" class="wrap">
    <h1>One toolkit for <span class="g">Discord</span> and <span class="g">Kick</span>.</h1>
    <p class="lede">Server management, protection and community games for Discord, and a shared ban list for Kick channels. Every feature is free.</p>
    <div class="cta">
      <% const _cid = (locals.clientId && /^\d{15,22}$/.test(String(locals.clientId))) ? String(locals.clientId) : (((locals.discoveryUrl || '').match(/(\d{15,22})$/) || [])[1] || null); const _invite = _cid ? 'https://discord.com/oauth2/authorize?client_id=' + _cid + '&permissions=1643797540086&scope=bot+applications.commands' : '/invite'; %>
      <a class="btn btn-primary btn-lg" href="<%= _invite %>">Add to Discord</a>
      <a class="btn btn-secondary btn-lg" href="<%= discordHref %>"><%= locals.discordLoggedIn ? 'Open dashboard' : 'Log in to the dashboard' %></a>
      <a class="btn btn-secondary btn-lg" href="/docs">Read the docs</a>
    </div>

    <% if (locals.discoveryUrl) { %>
    <a class="verified" href="<%= locals.discoveryUrl %>" target="_blank" rel="noopener">
      <span class="check" aria-hidden="true">&#10003;</span>
      <span>Verified Discord app &middot; <span class="go-disc">View in App Discovery</span></span>
    </a>
    <% } %>

    <div class="ftt" id="ftt">
      <div class="ftt-head"><span class="ftt-leaf" aria-hidden="true"></span>Where it is <b>4:20</b> next</div>
      <div class="ftt-now" id="ftt-now">Syncing the globe…</div>
      <div class="ftt-clock" id="ftt-clock">--:--:--</div>
      <div class="ftt-sub" id="ftt-sub">until the next 4:20</div>
      <div class="ftt-ticker" id="ftt-ticker"></div>
      <noscript><div class="ftt-sub" style="margin-top:1rem">Enable JavaScript to watch 4:20 roll around the planet.</div></noscript>
      <a class="ftt-obs" href="/420/obs">Add this clock to your stream (OBS browser source) &rarr;</a>
    </div>

    <div class="statbar">
      <div class="s"><b><%= Number(locals.discordServers || 0).toLocaleString() %></b><span>Discord servers<% if (Number(locals.customBotServers || 0) > 0) { %><span class="sub"><%= Number(locals.customBotServers).toLocaleString() %> on their own branded bot</span><% } %></span></div>
      <div class="s"><b><%= Number(locals.discordUsers || 0).toLocaleString() %></b><span>Members reached</span></div>
      <div class="s"><b><%= Number(locals.kickChannels || 0).toLocaleString() %></b><span>Kick channels</span></div>
      <div class="s"><b><%= Number(locals.phishingBlocked || 0).toLocaleString() %></b><span>Scam domains blocked</span></div>
    </div>

    <div class="cards">
      <a class="card d" href="<%= discordHref %>">
        <span class="badge">Discord bot<% if (locals.discordLoggedIn) { %> <span class="signed">Signed in</span><% } %></span>
        <h2>Manage a Discord server</h2>
        <p>Moderation, raid and scam protection, verification, levels, economy, music, giveaways, reaction roles and stream alerts, plus games such as a D&amp;D 5e RPG, word games and Cards Against Humanity. Every feature can be set up from the dashboard.</p>
        <span class="go"><%= locals.discordLoggedIn ? 'Open dashboard' : 'Log in with Discord' %></span>
        <div class="mini">
          <div><b><%= Number(locals.discordServers || 0).toLocaleString() %></b><span>servers<% if (Number(locals.customBotServers || 0) > 0) { %><span class="sub"><%= Number(locals.customBotServers).toLocaleString() %> on a custom bot</span><% } %></span></div>
        </div>
      </a>
      <a class="card k" href="<%= kickHref %>">
        <span class="badge">Kick bot<% if (locals.kickLoggedIn) { %> <span class="signed">Signed in</span><% } %></span>
        <h2>Protect a Kick channel</h2>
        <p>Accounts and scam links banned in one connected channel are banned in all of them, starting as soon as you connect. No moderator setup is needed.</p>
        <span class="go"><%= locals.kickLoggedIn ? 'Open the defender' : 'Log in with Kick' %></span>
        <div class="mini">
          <div><b><%= Number(locals.kickChannels || 0).toLocaleString() %></b><span>channels</span></div>
          <div><b><%= Number(locals.kickEnrolled || 0).toLocaleString() %></b><span>with defender on</span></div>
        </div>
      </a>
    </div>

    <% const _sg = locals.siteGuides || null;
       const _show = _sg ? [
         ['go-live-discord', 'go-live-alerts', 'Go-live alerts', 'A post the moment a streamer goes live.'],
         ['welcome-discord', 'welcome', 'Welcome cards', 'A greeting and a card for every new member.'],
         ['levels-discord', 'levels', 'Levels and rank cards', 'XP, level-ups and role rewards.'],
         ['raid-discord', 'raid-protection', 'Raid lockdown', 'New joins blocked automatically during a raid.'],
       ].map(([id, slug, title, line]) => ({ im: _sg.guideImage(id), g: _sg.getGuide(slug), title, line })).filter((x) => x.im && x.g) : []; %>
    <% if (_show.length) { %>
    <section class="show" aria-labelledby="show-h">
      <h2 id="show-h">See it in action</h2>
      <p>What members see in Discord. Each picture links to the guide for setting it up.</p>
      <ul>
        <% _show.forEach(function (x) { const t = x.im.thumb || x.im; %>
        <li><a href="/docs/guides/<%= x.g.slug %>"><span class="pic"><img src="<%= t.src %>" alt="<%= x.im.alt %>" width="<%= t.width %>" height="<%= t.height %>" loading="lazy" decoding="async"></span><span class="cap"><b><%= x.title %></b><span><%= x.line %></span></span></a></li>
        <% }); %>
      </ul>
    </section>
    <% } %>

    <section class="what" aria-labelledby="what-h">
      <h2 id="what-h">What the Discord bot does</h2>
      <p>Most features are off until you turn them on with <code class="cfs-code">/setup</code> or on the dashboard. <a href="/compare">Compare with other bots</a>.</p>
      <div class="cfs-grid">
        <a class="cfs-tile" href="/docs#moderation"><h3>Moderation and protection</h3><p>Automod, raid lockdown, anti-nuke, a join gate, scam link removal and a cross-server ban list.</p></a>
        <a class="cfs-tile" href="/docs#streams"><h3>Stream alerts and feeds</h3><p>Go-live posts for Twitch, YouTube, Kick, TikTok and Rumble, and feeds from YouTube, X, Bluesky, TikTok and RSS.</p></a>
        <a class="cfs-tile" href="/docs#levels"><h3>Levels and community</h3><p>Levels with role rewards, reaction roles, welcome cards, tickets, birthdays, suggestions and giveaways.</p></a>
        <a class="cfs-tile" href="/docs#music"><h3>Music and voice</h3><p>Music with playlists and filters, an AI DJ, voice rooms and a chat reader.</p></a>
        <a class="cfs-tile" href="/docs#games"><h3>Games and economy</h3><p>A server economy, a D&amp;D 5e game with an AI Dungeon Master, Greenhouse Tycoon, word games and Cards Against Humanity.</p></a>
        <a class="cfs-tile" href="/docs#creators"><h3>Creator tools</h3><p>Ko-fi, Buy Me a Coffee, Throne and Fourthwall announcements, and stream team applications.</p></a>
      </div>
    </section>
  </main>
<%- include('partials/site-footer') %>

  <script>
  (function () {
    // Curated zones spanning (almost) every UTC offset, so a 4:20 is always
    // close by. IANA names mean DST is handled for us by Intl — we just read
    // each zone's real wall-clock time every second.
    var ZONES = [
      { tz: 'Pacific/Kiritimati',   label: 'Kiritimati, Kiribati',     flag: '🇰🇮' },
      { tz: 'Pacific/Auckland',     label: 'Auckland, New Zealand',    flag: '🇳🇿' },
      { tz: 'Pacific/Chatham',      label: 'Chatham Islands',          flag: '🇳🇿' },
      { tz: 'Australia/Sydney',     label: 'Sydney, Australia',        flag: '🇦🇺' },
      { tz: 'Australia/Adelaide',   label: 'Adelaide, Australia',      flag: '🇦🇺' },
      { tz: 'Asia/Tokyo',           label: 'Tokyo, Japan',             flag: '🇯🇵' },
      { tz: 'Asia/Seoul',           label: 'Seoul, South Korea',       flag: '🇰🇷' },
      { tz: 'Australia/Eucla',      label: 'Eucla, Australia',         flag: '🇦🇺' },
      { tz: 'Asia/Shanghai',        label: 'Shanghai, China',          flag: '🇨🇳' },
      { tz: 'Asia/Singapore',       label: 'Singapore',                flag: '🇸🇬' },
      { tz: 'Asia/Bangkok',         label: 'Bangkok, Thailand',        flag: '🇹🇭' },
      { tz: 'Asia/Yangon',          label: 'Yangon, Myanmar',          flag: '🇲🇲' },
      { tz: 'Asia/Dhaka',           label: 'Dhaka, Bangladesh',        flag: '🇧🇩' },
      { tz: 'Asia/Kathmandu',       label: 'Kathmandu, Nepal',         flag: '🇳🇵' },
      { tz: 'Asia/Kolkata',         label: 'Mumbai, India',            flag: '🇮🇳' },
      { tz: 'Asia/Karachi',         label: 'Karachi, Pakistan',        flag: '🇵🇰' },
      { tz: 'Asia/Kabul',           label: 'Kabul, Afghanistan',       flag: '🇦🇫' },
      { tz: 'Asia/Dubai',           label: 'Dubai, UAE',               flag: '🇦🇪' },
      { tz: 'Asia/Tehran',          label: 'Tehran, Iran',             flag: '🇮🇷' },
      { tz: 'Europe/Moscow',        label: 'Moscow, Russia',           flag: '🇷🇺' },
      { tz: 'Africa/Nairobi',       label: 'Nairobi, Kenya',           flag: '🇰🇪' },
      { tz: 'Europe/Athens',        label: 'Athens, Greece',           flag: '🇬🇷' },
      { tz: 'Europe/Paris',         label: 'Paris, France',            flag: '🇫🇷' },
      { tz: 'Europe/London',        label: 'London, UK',               flag: '🇬🇧' },
      { tz: 'Atlantic/Cape_Verde',  label: 'Cape Verde',               flag: '🇨🇻' },
      { tz: 'America/Noronha',      label: 'Fernando de Noronha',      flag: '🇧🇷' },
      { tz: 'America/Sao_Paulo',    label: 'São Paulo, Brazil',        flag: '🇧🇷' },
      { tz: 'America/St_Johns',     label: "St. John's, Canada",       flag: '🇨🇦' },
      { tz: 'America/New_York',     label: 'New York, USA',            flag: '🇺🇸' },
      { tz: 'America/Chicago',      label: 'Chicago, USA',             flag: '🇺🇸' },
      { tz: 'America/Denver',       label: 'Denver, USA',              flag: '🇺🇸' },
      { tz: 'America/Los_Angeles',  label: 'Los Angeles, USA',         flag: '🇺🇸' },
      { tz: 'America/Anchorage',    label: 'Anchorage, USA',           flag: '🇺🇸' },
      { tz: 'Pacific/Marquesas',    label: 'Marquesas Islands',        flag: '🇵🇫' },
      { tz: 'Pacific/Honolulu',     label: 'Honolulu, Hawaii',         flag: '🇺🇸' },
      { tz: 'Pacific/Pago_Pago',    label: 'Pago Pago, Samoa',         flag: '🇦🇸' },
      { tz: 'Pacific/Niue',         label: 'Niue',                     flag: '🇳🇺' }
    ];

    var AM = 4 * 3600 + 20 * 60;   // 04:20:00 -> 15600
    var PM = 16 * 3600 + 20 * 60;  // 16:20:00 -> 58800
    var DAY = 86400;
    var fmtCache = {};

    function fmt(tz) {
      if (!fmtCache[tz]) {
        fmtCache[tz] = new Intl.DateTimeFormat('en-US', {
          timeZone: tz, hour12: false,
          hour: '2-digit', minute: '2-digit', second: '2-digit'
        });
      }
      return fmtCache[tz];
    }

    // Seconds-of-day for a zone's current wall clock (DST-correct).
    function secondsOfDay(tz, now) {
      var parts = fmt(tz).formatToParts(now);
      var h = 0, m = 0, s = 0;
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        if (p.type === 'hour') h = parseInt(p.value, 10);
        else if (p.type === 'minute') m = parseInt(p.value, 10);
        else if (p.type === 'second') s = parseInt(p.value, 10);
      }
      if (h === 24) h = 0; // some engines render midnight as 24
      return h * 3600 + m * 60 + s;
    }

    // Is this zone inside its 4:20 minute right now? -> 'AM' | 'PM' | null
    function litNow(sod) {
      if (sod >= AM && sod < AM + 60) return 'AM';
      if (sod >= PM && sod < PM + 60) return 'PM';
      return null;
    }

    // Seconds until this zone NEXT enters a 4:20 (and which one).
    function nextEntry(sod) {
      var dAM = (AM - sod + DAY) % DAY;
      var dPM = (PM - sod + DAY) % DAY;
      return dAM <= dPM ? { secs: dAM, ap: 'AM' } : { secs: dPM, ap: 'PM' };
    }

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function hhmmss(t) {
      var h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
      return pad(h) + ':' + pad(m) + ':' + pad(s);
    }
    function localClock(tz, now) {
      var sod = secondsOfDay(tz, now);
      var h = Math.floor(sod / 3600), m = Math.floor((sod % 3600) / 60);
      var ap = h < 12 ? 'AM' : 'PM';
      var h12 = h % 12; if (h12 === 0) h12 = 12;
      return h12 + ':' + pad(m) + ' ' + ap;
    }

    var elBox = document.getElementById('ftt');
    var elNow = document.getElementById('ftt-now');
    var elClock = document.getElementById('ftt-clock');
    var elSub = document.getElementById('ftt-sub');
    var elTicker = document.getElementById('ftt-ticker');
    if (!elBox) return;

    function tick() {
      var now = new Date();
      var lit = [];
      var upcoming = [];

      for (var i = 0; i < ZONES.length; i++) {
        var z = ZONES[i];
        var sod;
        try { sod = secondsOfDay(z.tz, now); } catch (e) { continue; }
        var l = litNow(sod);
        if (l) lit.push({ z: z, ap: l });
        var ne = nextEntry(sod);
        upcoming.push({ z: z, secs: ne.secs, ap: ne.ap });
      }

      upcoming.sort(function (a, b) { return a.secs - b.secs; });
      // The soonest zone that isn't already lit becomes the countdown target.
      var target = null;
      for (var j = 0; j < upcoming.length; j++) {
        if (upcoming[j].secs > 0) { target = upcoming[j]; break; }
      }
      if (!target) target = upcoming[0];

      // Headline.
      if (lit.length) {
        elBox.classList.add('islit');
        elNow.classList.add('lit');
        var names = lit.map(function (x) {
          return '<span class="place">' + x.z.flag + ' ' + x.z.label + '</span> (4:20 ' + x.ap + ')';
        });
        var lead = lit.length === 1 ? "It's <b>4:20</b> right now in " : '<b>4:20</b> right now in ';
        elNow.innerHTML = lead + names.join(' · ');
      } else {
        elBox.classList.remove('islit');
        elNow.classList.remove('lit');
        elNow.innerHTML = 'Next up: <span class="place">' + target.z.flag + ' ' + target.z.label +
          '</span> — local time ' + localClock(target.z.tz, now);
      }

      // Countdown to the next 4:20.
      elClock.textContent = hhmmss(target.secs);
      elSub.innerHTML = 'until 4:20 ' + target.ap + ' in <b>' +
        target.z.flag + ' ' + target.z.label + '</b>';

      // Rotating ticker of the next handful of 4:20s.
      var chips = '';
      for (var k = 0; k < upcoming.length && k < 6; k++) {
        var u = upcoming[k];
        chips += '<span class="chip">' + u.z.flag + ' <b>' + u.z.label.split(',')[0] +
          '</b> ' + hhmmss(u.secs) + '</span>';
      }
      elTicker.innerHTML = chips;
    }

    tick();
    setInterval(tick, 1000);
  })();
  </script>
</body>
</html>
