<%- include('_head', { pageTitle: 'Features', csrfToken, kickUser: user, kickTab: 'features', isManager: typeof isManager !== 'undefined' && isManager, isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>
<%
  var groups = [
    { title: 'Protection', desc: 'On as soon as you connect your channel.', items: [
      { name: 'Shared banlist', text: 'Accounts on the network banlist are banned when they chat in your channel. Network managers keep the list.' },
      { name: 'Scam-link protection', text: 'Blocks ' + Number(phishingCount || 0).toLocaleString() + ' known phishing and scam domains. A link is removed with a warning; the poster is banned once their links reach your strike limit (2 by default, counted across every connected channel). You set the limit, the warning, the ban length and your own allowed domains.' },
      { name: 'Raid and whitelist lists', text: 'Managers can mass-add raid accounts to a sublist and whitelist people so the defender never acts on them.' }
    ] },
    { title: 'Moderation', desc: 'Set up and run from the dashboard.', items: [
      { name: 'Live moderation', text: 'Ban, time out or unban anyone by name, without being in chat.' },
      { name: 'Automod', text: 'Off until you turn rules on: too many capitals, links, symbol spam, banned words or a length limit. Mods and you are never filtered.' },
      { name: 'Activity log and charts', text: 'Every action the defender takes, with a 14-day chart for your channel and for the whole network.' },
      { name: 'Network managers', text: 'Trusted people who help look after the shared banlist.' }
    ] },
    { title: 'Chat', desc: 'Nothing here runs until you set it up. Commands have one switch per channel.', items: [
      { name: 'Your own commands', text: 'Commands that reply with your text, with {{username}}, {{lifetime_tokes}} and other variables.' },
      { name: 'Auto-responders', text: 'Reply automatically when a message contains a phrase, is exactly it, starts with it or has it as a whole word. Each has its own cooldown.' },
      { name: 'Timers', text: 'Post messages on a schedule while the defender is on: socials, rules or commands.' },
      { name: 'Per-command control', text: 'Turn any built-in command on or off and set its cooldown, aliases and whether only mods can use it.' },
      { name: 'Follow and sub thank-yous', text: 'Thank new followers and subscribers in chat, and welcome first-time chatters.' },
      { name: 'Giveaways', text: 'Viewers enter with a keyword; you draw the winner from the dashboard.' }
    ] },
    { title: 'Games', desc: 'Part of chat commands.', items: [
      { name: 'Tokes, streaks and sessions', text: '!lit tokes and XP, !spark daily streaks, !sesh smoke circles, !trivia, leaderboards and levels.' },
      { name: 'Strain library', text: '!strain lookups and !lineage genetics.' }
    ] }
  ];
%>

  <div class="pagehead">
    <div>
      <div class="kick-eyebrow">Kick Defender</div>
      <h1>What it does for your Kick channel</h1>
      <p class="sub">Protection is on as soon as you connect. Everything else is opt-in.</p>
    </div>
  </div>

  <% if (!hasChannels) { %>
    <div class="cf-notice is-accent">
      <div class="cf-notice-body">
        <span class="cf-notice-title">Get started</span>
        <p>1. Connect your Kick channel and approve the permissions. 2. Your channel is added and the defender turns on. 3. Change anything from <a href="/kick">your channels</a>.</p>
      </div>
      <a class="btn btn-primary btn-sm" href="<%= reauthHref %>">Connect your Kick channel</a>
    </div>
  <% } else { %>
    <div class="cf-notice is-ok">
      <div class="cf-notice-body">Your channel is connected. Everything below is set up from your channels page.</div>
      <a class="btn btn-primary btn-sm" href="/kick">Open your channels</a>
    </div>
  <% } %>

  <% groups.forEach(function (g) { %>
    <section class="cf-section">
      <header class="cf-section-head">
        <div>
          <h2 class="cf-section-title"><%= g.title %></h2>
          <p class="cf-section-desc"><%= g.desc %></p>
        </div>
      </header>
      <div class="cf-rows">
        <div class="cf-list">
          <% g.items.forEach(function (it) { %>
            <div class="cf-list-item">
              <div class="cf-list-main">
                <div class="cf-em"><%= it.name %></div>
                <div class="muted"><%= it.text %></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <p class="muted">Questions? Ask in the <a href="https://certifriedmultitool.com/discord" target="_blank" rel="noopener">support server</a> or read the <a href="/docs#kick-defender">docs</a>.</p>

<%- include('_foot') %>
