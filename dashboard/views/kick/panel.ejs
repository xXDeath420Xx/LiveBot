<%- include('_head', { pageTitle: 'Your channels', csrfToken, kickUser: user }) %>

  <div class="pagehead">
    <div>
      <div class="kick-eyebrow">Kick Defender</div>
      <h1>Your channels</h1>
      <p class="sub">Protection and chat tools for the Kick channels you own.</p>
    </div>
  </div>
  <%- include('_tabs', { active: 'channels', isManager, isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>

  <% var totalBanned = 0, totalDeleted = 0, totalDormant = 0, enrolledCount = 0;
     channels.forEach(function (c) { totalBanned += (c.stats.banned || 0); totalDeleted += (c.stats.deleted || 0); totalDormant += (c.stats.dormant || 0); if (c.enabled) enrolledCount++; }); %>
  <dl class="cf-kpis">
    <div class="cf-kpi"><dt>Channels</dt><dd><%= channels.length %></dd></div>
    <div class="cf-kpi"><dt>Defender on</dt><dd><%= enrolledCount %></dd></div>
    <div class="cf-kpi"><dt>Users banned</dt><dd><%= totalBanned.toLocaleString() %></dd></div>
    <div class="cf-kpi"><dt>Messages removed</dt><dd><%= totalDeleted.toLocaleString() %></dd></div>
    <div class="cf-kpi"><dt>Detected, no permission</dt><dd><%= totalDormant.toLocaleString() %></dd></div>
  </dl>

  <section class="cf-section" id="channels">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Channels <span class="muted">(<%= channels.length %>)</span></h2>
        <p class="cf-section-desc">Each channel's defender switch, chat connection and scam-link settings.</p>
      </div>
    </header>
    <div class="cf-notice is-warn" id="feed-problem" hidden><div class="cf-notice-body">Couldn't check the chat connections with Kick just now. Reload the page to try again.</div></div>

    <% if (!channels.length) { %>
      <div class="cf-rows">
        <div class="cf-state">
          <p class="cf-state-title">No Kick channels linked yet</p>
          <p class="cf-state-text">Sign in with Kick and grant the moderation permissions to add your channel.</p>
          <a class="btn btn-primary" href="<%= reauthHref %>">Authorize with Kick</a>
        </div>
      </div>
    <% } %>

    <div class="kick-panel-stack">
    <% channels.forEach(function (ch) { var cid = ch.channelId; %>
      <div class="cf-rows kick-channel" data-channel="<%= cid %>">
        <div class="cf-row">
          <div class="cf-row-text">
            <div class="kick-title-line">
              <%= ch.channelName %>
              <span class="pill <%= ch.enabled ? 'ok' : 'off' %>"><%= ch.enabled ? 'Protected' : 'Defender off' %></span>
              <% if (ch.enabled && !ch.hasBanScope) { %><span class="pill warn">Limited</span><% } %>
            </div>
            <p class="cf-row-desc">Banned <%= (ch.stats.banned || 0).toLocaleString() %> · Removed <%= (ch.stats.deleted || 0).toLocaleString() %> · Detected without permission <%= (ch.stats.dormant || 0).toLocaleString() %></p>
          </div>
          <div class="cf-row-control kick-end">
            <a class="btn btn-secondary btn-sm" href="/kick/channel/<%= cid %>">Settings and commands</a>
          </div>
        </div>

        <% if (ch.enabled && !ch.hasBanScope) { %>
          <div class="cf-notice is-warn">
            <div class="cf-notice-body">
              <% if (!ch.hasManageScope) { %>This channel has not granted any moderation permissions, so nothing can be removed or banned.<% } else { %>Messages can be removed, but users can't be banned yet.<% } %>
              <a href="<%= reauthHref %>">Re-authorize with Kick</a> to grant them.
            </div>
          </div>
        <% } %>

        <div class="cf-row cf-row--switch">
          <div class="cf-row-text">
            <label class="cf-row-label" for="enroll-<%= cid %>">Defender</label>
            <p class="cf-row-desc">Bans accounts on the shared banlist and removes known scam links in this channel's chat.</p>
          </div>
          <div class="cf-row-control">
            <input type="checkbox" role="switch" class="cf-switch enroll" id="enroll-<%= cid %>" data-channel="<%= cid %>" <%= ch.enabled ? 'checked' : '' %>>
          </div>
        </div>

        <div class="cf-row">
          <div class="cf-row-text">
            <span class="cf-row-label">Chat connection</span>
            <p class="cf-row-desc">Kick sends this channel's chat to the bot through webhooks. The defender, automod and commands only see chat while this is connected.</p>
          </div>
          <div class="cf-row-control">
            <div class="kick-inline">
              <span class="chat-status" data-channel="<%= cid %>"><span class="muted">Checking…</span></span>
              <button type="button" class="btn btn-secondary btn-sm chat-connect" data-channel="<%= cid %>" hidden>Connect chat</button>
            </div>
            <span class="kick-status chat-msg" data-channel="<%= cid %>" role="status" aria-live="polite"></span>
          </div>
        </div>

        <div class="cf-row">
          <div class="cf-row-text">
            <label class="cf-row-label" for="bantype-<%= cid %>">Ban length</label>
            <p class="cf-row-desc">Applies to banlist matches and repeat scam-link posters.</p>
          </div>
          <div class="cf-row-control">
            <div class="kick-inline">
              <select class="set-bantype" id="bantype-<%= cid %>" data-channel="<%= cid %>">
                <option value="">Permanent</option>
                <option value="timed">Timed</option>
              </select>
              <div class="cf-input-unit">
                <input class="set-duration" data-channel="<%= cid %>" type="number" min="1" max="525600" placeholder="60" aria-label="Ban length in minutes" disabled>
                <span class="cf-unit">min</span>
              </div>
            </div>
          </div>
        </div>

        <div class="cf-row">
          <div class="cf-row-text">
            <label class="cf-row-label" for="threshold-<%= cid %>">Scam-link strikes before a ban</label>
            <p class="cf-row-desc">How many scam links one poster can send before they are banned, counted across every connected channel. Links before that are removed with a warning; 1 bans on the first link. 1 to 10, default 2.</p>
          </div>
          <div class="cf-row-control">
            <input class="set-threshold" id="threshold-<%= cid %>" data-channel="<%= cid %>" type="number" min="1" max="10" value="2">
          </div>
        </div>

        <div class="cf-row cf-row--stack">
          <div class="cf-row-text">
            <label class="cf-row-label" for="warning-<%= cid %>">Scam-link warning</label>
            <p class="cf-row-desc">Posted in chat when a scam link is removed and the poster is not banned yet. <code>{{username}}</code> is the poster. Leave empty for the default.</p>
          </div>
          <div class="cf-row-control">
            <textarea class="set-warning" id="warning-<%= cid %>" data-channel="<%= cid %>" rows="2" maxlength="400" placeholder="@{{username}} posted a known scam link and it was removed. Repeat offenses = ban."></textarea>
          </div>
        </div>

        <div class="cf-row cf-row--stack">
          <div class="cf-row-text">
            <label class="cf-row-label" for="safe-<%= cid %>">Allowed domains</label>
            <p class="cf-row-desc">Links to these domains and their subdomains are never treated as scam links in this channel. One per line, up to 50.</p>
          </div>
          <div class="cf-row-control">
            <textarea class="set-safe" id="safe-<%= cid %>" data-channel="<%= cid %>" rows="3" placeholder="example.com"></textarea>
          </div>
        </div>

        <div class="cf-section-foot">
          <span class="kick-status cf-foot-note set-status" data-channel="<%= cid %>" role="status" aria-live="polite"></span>
          <button type="button" class="btn btn-primary btn-sm set-save" data-channel="<%= cid %>">Save protection settings</button>
        </div>

        <div class="cf-row cf-row--stack">
          <div class="cf-row-text">
            <span class="cf-row-label">Recent actions</span>
            <p class="cf-row-desc">The last 25 things the defender did in this channel.</p>
          </div>
          <div class="cf-row-control">
            <div><button type="button" class="btn btn-secondary btn-sm log-load" data-channel="<%= cid %>">Show recent actions</button></div>
            <div class="log-out" data-channel="<%= cid %>"></div>
          </div>
        </div>
      </div>
    <% }) %>
    </div>
  </section>

  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Across the network</h2>
        <p class="cf-section-desc">Every channel that uses Kick Defender shares one banlist.</p>
      </div>
    </header>
    <dl class="cf-kpis">
      <div class="cf-kpi"><dt>Users banned</dt><dd id="ns-banned">—</dd></div>
      <div class="cf-kpi"><dt>Messages removed</dt><dd id="ns-removed">—</dd></div>
      <div class="cf-kpi"><dt>Banlist size</dt><dd id="ns-banlist">—</dd></div>
      <div class="cf-kpi"><dt>Scam domains blocked</dt><dd id="ns-phishing">—</dd></div>
    </dl>
    <div class="cf-rows">
      <div class="cf-row cf-row--stack">
        <div class="cf-row-text">
          <span class="cf-row-label">Activity, last 14 days</span>
          <div class="kick-legend" aria-hidden="true"><span><i class="kick-sw-banned"></i>Banned</span><span><i class="kick-sw-removed"></i>Removed</span><span><i class="kick-sw-detected"></i>Detected</span></div>
        </div>
        <div class="kick-chart" id="trend-chart"><p class="muted">Loading…</p></div>
      </div>
    </div>
  </section>

  <script>
  (function () {
    var K = window.KickDash;
    var q = function (cls, ch) { return document.querySelector('.' + cls + '[data-channel="' + ch + '"]'); };

    // Defender switch: enroll / unenroll, then reload so the pills and counts match.
    document.querySelectorAll('.enroll').forEach(function (sw) {
      sw.addEventListener('change', async function () {
        sw.disabled = true;
        try { await K.post('/kick/api/enroll', { channelId: sw.dataset.channel, enabled: sw.checked ? 1 : 0 }); location.reload(); }
        catch (e) { sw.checked = !sw.checked; sw.disabled = false; K.status(q('chat-msg', sw.dataset.channel), e.message || 'Could not change the defender.', 'bad'); }
      });
    });

    // Ban length: minutes only apply to a timed ban.
    document.querySelectorAll('.set-bantype').forEach(function (sel) {
      var sync = function () { var d = q('set-duration', sel.dataset.channel); d.disabled = sel.value !== 'timed'; if (!d.disabled && !d.value) d.value = 60; };
      sel.addEventListener('change', sync);
      sel._sync = sync;
    });

    // Load each channel's saved protection settings.
    document.querySelectorAll('.set-save').forEach(async function (btn) {
      var ch = btn.dataset.channel;
      try {
        var j = await K.get('/kick/api/channel-settings?channelId=' + encodeURIComponent(ch));
        var s = j.settings;
        if (!s) return;
        if (s.ban_duration_min != null) { q('set-bantype', ch).value = 'timed'; q('set-duration', ch).value = s.ban_duration_min; }
        if (s.phishing_threshold != null) q('set-threshold', ch).value = s.phishing_threshold;
        if (s.warning_template) q('set-warning', ch).value = s.warning_template;
        if (s.safe_domains) q('set-safe', ch).value = String(s.safe_domains).split(',').map(function (x) { return x.trim(); }).filter(Boolean).join('\n');
      } catch (_) { /* defaults stay */ }
      finally { var sel = q('set-bantype', ch); if (sel && sel._sync) sel._sync(); }
    });

    document.querySelectorAll('.set-save').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var ch = btn.dataset.channel;
        var out = q('set-status', ch);
        var timed = q('set-bantype', ch).value === 'timed';
        var safe = q('set-safe', ch).value.split(/[\n,]+/).map(function (x) { return x.trim(); }).filter(Boolean);
        if (safe.length > 50) { K.status(out, 'Up to 50 allowed domains.', 'bad'); return; }
        btn.disabled = true; K.status(out, 'Saving…');
        try {
          var r = await K.post('/kick/api/channel-settings', {
            channelId: ch,
            banDurationMin: timed ? (Number(q('set-duration', ch).value) || 1) : '',
            phishingThreshold: q('set-threshold', ch).value,
            warningTemplate: q('set-warning', ch).value,
            safeDomains: safe
          });
          if (r && Array.isArray(r.safeDomains)) q('set-safe', ch).value = r.safeDomains.join('\n');
          K.status(out, 'Saved.', 'ok');
        } catch (e) { K.status(out, e.message || 'Save failed.', 'bad'); }
        finally { btn.disabled = false; }
      });
    });

    // Recent actions per channel.
    document.querySelectorAll('.log-load').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var ch = btn.dataset.channel;
        var out = q('log-out', ch);
        out.replaceChildren(K.el('p', 'muted', 'Loading…'));
        try {
          var j = await K.get('/kick/api/enforcement-log?channelId=' + encodeURIComponent(ch) + '&limit=25');
          K.table(out, ['Time', 'Action', 'User', 'Reason'], (j.events || []).map(function (e) {
            return [{ text: K.fmtTime(e.created_at) || '—', cls: 'nowrap' }, e.action + (e.success ? '' : ' (failed)'), e.target_username || '', e.reason || ''];
          }), 'No actions recorded yet.');
          btn.textContent = 'Refresh';
        } catch (e) { out.replaceChildren(K.el('p', 'muted', e.message || 'Failed to load.')); }
      });
    });

    // Chat connection (Kick webhooks) per channel.
    function showChat(c) {
      var host = q('chat-status', c.channelId);
      var btn = q('chat-connect', c.channelId);
      if (!host) return;
      host.replaceChildren();
      if (c.chatSubscribed === true) {
        host.appendChild(K.el('span', 'pill ok', 'Connected'));
        var seen = c.lastChatAt ? ' Last message ' + K.ago(c.lastChatAt) + '.' : '';
        if (seen) host.appendChild(K.el('span', 'muted', seen));
        var missing = (c.missingEvents || []).length;
        btn.hidden = !missing;
        btn.textContent = 'Connect follow and sub alerts';
      } else if (c.chatSubscribed === false) {
        host.appendChild(K.el('span', 'pill bad', 'Not connected'));
        btn.hidden = false;
        btn.textContent = 'Connect chat';
      } else {
        host.appendChild(K.el('span', 'pill off', 'Unknown'));
        btn.hidden = true;
      }
    }
    async function loadHealth() {
      try {
        var j = await K.get('/kick/api/bot-health');
        document.getElementById('feed-problem').hidden = !!j.connected;
        (j.channels || []).forEach(showChat);
      } catch (_) {
        document.getElementById('feed-problem').hidden = false;
        document.querySelectorAll('.chat-status').forEach(function (h) { h.replaceChildren(K.el('span', 'pill off', 'Unknown')); });
      }
    }
    document.querySelectorAll('.chat-connect').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        var ch = btn.dataset.channel;
        var out = q('chat-msg', ch);
        btn.disabled = true; K.status(out, 'Connecting…');
        try { await K.post('/kick/api/channel/' + encodeURIComponent(ch) + '/events/subscribe', {}); K.status(out, 'Connected.', 'ok'); await loadHealth(); }
        catch (e) { K.status(out, e.message || 'Kick did not accept the connection.', 'bad'); }
        finally { btn.disabled = false; }
      });
    });
    loadHealth();

    (async function loadNetworkStats() {
      try {
        var j = await K.get('/kick/api/network-stats');
        var s = j.stats || {};
        var set = function (id, v) { var n = document.getElementById(id); if (n && v != null) n.textContent = Number(v).toLocaleString(); };
        set('ns-banned', s.banned);
        set('ns-removed', s.deleted);
        set('ns-banlist', Array.isArray(j.banlist) ? j.banlist.length : j.banlist);
        set('ns-phishing', Array.isArray(j.phishing) ? j.phishing.length : j.phishing);
      } catch (_) { /* dashes stay */ }
    })();

    (async function loadTrend() {
      var host = document.getElementById('trend-chart');
      try {
        var j = await K.get('/kick/api/network-trend?days=14');
        K.bars(host, Array.isArray(j.series) ? j.series : [], [
          { key: 'banned', cls: 'banned', label: 'Banned' },
          { key: 'deleted', cls: 'removed', label: 'Removed' },
          { key: 'dormant', cls: 'detected', label: 'Detected' }
        ], { label: 'Network activity, last 14 days' });
      } catch (_) { host.replaceChildren(K.el('p', 'muted', 'Failed to load the chart.')); }
    })();
  })();
  </script>
<%- include('_foot') %>
