<%- include('_head', { pageTitle: 'Your Channels', csrfToken, kickUser: user }) %>

  <div class="pagehead">
    <div>
      <h1>🐻 Kick Defender</h1>
      <div class="sub">Shared-banlist protection &amp; chat-bot control for your Kick channels.</div>
    </div>
    <nav class="subnav">
      <a href="/kick" class="active">Channels</a>
      <% if (isManager) { %><a href="/kick/managers">Manager console</a><% } %>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %><a href="/kick/admin">Connected accounts</a><% } %>
    </nav>
  </div>

  <!-- ── Overview stats ─────────────────────────────────────── -->
  <% var totalBanned = 0, totalDeleted = 0, totalDormant = 0, enrolledCount = 0, scopeOK = 0;
     channels.forEach(function(c){ totalBanned += (c.stats.banned||0); totalDeleted += (c.stats.deleted||0); totalDormant += (c.stats.dormant||0); if(c.enabled) enrolledCount++; if(c.hasBanScope) scopeOK++; }); %>
  <div class="statgrid">
    <div class="stat kick"><b><%= channels.length %></b><span>Channels</span></div>
    <div class="stat kick"><b><%= enrolledCount %></b><span>Defender on</span></div>
    <div class="stat"><b><%= totalBanned.toLocaleString() %></b><span>Users banned</span></div>
    <div class="stat"><b><%= totalDeleted.toLocaleString() %></b><span>Messages removed</span></div>
    <div class="stat"><b><%= totalDormant.toLocaleString() %></b><span>Detected (no scope)</span></div>
  </div>

  <% if (!channels.length) { %>
    <div class="card">
      <div class="empty">
        <p style="font-size:1.05rem;color:var(--ink);margin-bottom:.5rem">No Kick channels linked yet.</p>
        <p class="muted" style="margin-bottom:1rem">Connect your channel and grant moderation permissions to activate the defender.</p>
        <a href="<%= reauthHref %>"><button>Authorize with Kick →</button></a>
      </div>
    </div>
  <% } %>

  <% channels.forEach(function(ch){ %>
    <div class="card">
      <div class="row">
        <div>
          <div style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.15rem;display:flex;align-items:center;gap:.5rem">
            <%= ch.channelName %>
            <span class="pill <%= ch.enabled ? 'ok' : 'off' %>"><%= ch.enabled ? '● protected' : 'off' %></span>
            <% if (ch.enabled && !ch.hasBanScope) { %><span class="pill warn">limited</span><% } %>
          </div>
          <div class="muted" style="margin-top:.4rem">Banned <%= ch.stats.banned %> · Removed <%= ch.stats.deleted %> · Detected <%= ch.stats.dormant %></div>
        </div>
        <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
          <button class="enroll <%= ch.enabled ? 'ghost' : '' %>" data-channel="<%= ch.channelId %>" data-enabled="<%= ch.enabled ? 0 : 1 %>">
            <%= ch.enabled ? 'Disable' : 'Enable defender' %>
          </button>
          <a href="/kick/channel/<%= ch.channelId %>"><button class="ghost">Settings &amp; commands →</button></a>
        </div>
      </div>

      <% if (ch.enabled && !ch.hasBanScope) { %>
        <div class="banner">
          ⚠ This channel can't issue bans yet. <a href="<%= reauthHref %>">Re-authorize with Kick</a> to grant moderation permissions.
          <% if (!ch.hasManageScope) { %> (No moderation scopes granted at all.)<% } else { %> (Messages can be deleted, but users can't be banned.)<% } %>
        </div>
      <% } %>

      <details class="settings">
        <summary>Protection settings &amp; recent actions</summary>
        <div class="srow" style="margin-top:.7rem">
          <label>Ban type
            <select class="set-bantype" data-channel="<%= ch.channelId %>">
              <option value="">Permanent</option>
              <option value="timed">Timed (minutes)</option>
            </select>
          </label>
          <input class="set-duration" data-channel="<%= ch.channelId %>" type="number" min="1" placeholder="minutes" style="width:8rem" />
          <label>Scam-link strikes before ban
            <input class="set-threshold" data-channel="<%= ch.channelId %>" type="number" min="1" max="10" value="2" style="width:5rem" />
          </label>
          <button class="set-save" data-channel="<%= ch.channelId %>">Save settings</button>
        </div>
        <textarea class="set-warning" data-channel="<%= ch.channelId %>" placeholder="Custom scam-link warning (use {{username}})" style="width:100%;margin-top:.6rem"></textarea>
        <div class="log" data-channel="<%= ch.channelId %>" style="margin-top:.75rem">
          <button class="log-load ghost" data-channel="<%= ch.channelId %>">Load recent actions</button>
          <div class="log-out"></div>
        </div>
      </details>
    </div>
  <% }) %>

<% var panelJs = `
  <script>
    document.querySelectorAll('.enroll').forEach(btn => {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try { await KickDash.post('/kick/api/enroll', { channelId: btn.dataset.channel, enabled: Number(btn.dataset.enabled) }); location.reload(); }
        catch (e) { btn.disabled = false; alert(e.message || 'Could not update enrollment.'); }
      });
    });
    document.querySelectorAll('.set-save').forEach(btn => {
      btn.addEventListener('click', async () => {
        const ch = btn.dataset.channel;
        const q = s => document.querySelector(s + '[data-channel="' + ch + '"]');
        const banType = q('.set-bantype').value;
        const duration = q('.set-duration').value;
        btn.disabled = true;
        try { await KickDash.post('/kick/api/channel-settings', { channelId: ch, banDurationMin: banType === 'timed' ? (Number(duration) || 1) : '', phishingThreshold: q('.set-threshold').value, warningTemplate: q('.set-warning').value }); btn.textContent = 'Saved ✓'; }
        catch (e) { alert(e.message || 'Save failed.'); }
        finally { btn.disabled = false; setTimeout(() => { btn.textContent = 'Save settings'; }, 1500); }
      });
    });
    document.querySelectorAll('.log-load').forEach(btn => {
      btn.addEventListener('click', async () => {
        const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const ch = btn.dataset.channel;
        const out = btn.parentElement.querySelector('.log-out');
        out.textContent = 'Loading…';
        try {
          const res = await fetch('/kick/api/enforcement-log?channelId=' + encodeURIComponent(ch) + '&limit=25');
          const j = await res.json();
          if (!res.ok) throw new Error(j.error || 'Failed');
          if (!j.events.length) { out.textContent = 'No actions recorded yet.'; return; }
          out.innerHTML = '<table>' + j.events.map(e =>
            '<tr><td>' + (e.created_at ? new Date(e.created_at).toISOString().slice(0,16).replace('T',' ') : '—') +
            '</td><td>' + esc(e.action) + (e.success ? '' : ' (failed)') +
            '</td><td>' + esc(e.target_username) + '</td><td>' + esc(e.reason) + '</td></tr>').join('') + '</table>';
        } catch (e) { out.textContent = e.message || 'Failed to load.'; }
      });
    });
    document.querySelectorAll('.set-save').forEach(async btn => {
      const ch = btn.dataset.channel;
      try {
        const res = await fetch('/kick/api/channel-settings?channelId=' + encodeURIComponent(ch));
        const j = await res.json();
        if (res.ok && j.settings) {
          const q = s => document.querySelector(s + '[data-channel="' + ch + '"]');
          if (j.settings.ban_duration_min != null) { q('.set-bantype').value = 'timed'; q('.set-duration').value = j.settings.ban_duration_min; }
          if (j.settings.phishing_threshold != null) q('.set-threshold').value = j.settings.phishing_threshold;
          if (j.settings.warning_template) q('.set-warning').value = j.settings.warning_template;
        }
      } catch (_) {}
    });
  </script>`; %>
<%- include('_foot', { extraJs: panelJs }) %>
