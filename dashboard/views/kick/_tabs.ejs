<%# Top-level Kick Defender tabs. Locals: active ('channels'|'features'|'managers'|'admin'), isManager, isAdmin. %>
<% var _act = typeof active !== 'undefined' ? active : ''; %>
<nav class="kick-tabs" aria-label="Kick Defender">
  <a href="/kick"<%- _act === 'channels' ? ' aria-current="page"' : '' %>>Channels</a>
  <a href="/kick/features"<%- _act === 'features' ? ' aria-current="page"' : '' %>>Features</a>
  <% if (typeof isManager !== 'undefined' && isManager) { %><a href="/kick/managers"<%- _act === 'managers' ? ' aria-current="page"' : '' %>>Manager console</a><% } %>
  <% if (typeof isAdmin !== 'undefined' && isAdmin) { %><a href="/kick/admin"<%- _act === 'admin' ? ' aria-current="page"' : '' %>>Connected accounts</a><% } %>
</nav>
