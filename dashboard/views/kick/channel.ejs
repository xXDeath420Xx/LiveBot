<%- include('_head', { pageTitle: channel.channel_name + ' — Control Center', csrfToken, kickUser: user }) %>

  <input id="chan" type="hidden" data-channel="<%= channel.channel_id %>" />

  <div class="pagehead">
    <div>
      <h1>⚙ <%= channel.channel_name %></h1>
      <div class="sub">Full control center for this Kick channel.</div>
    </div>
    <nav class="subnav">
      <a href="/kick/channel/<%= channel.channel_id %>" class="active">Settings</a>
      <a href="/kick/channel/<%= channel.channel_id %>/commands">Commands</a>
      <a href="/kick">← All channels</a>
    </nav>
  </div>

  <!-- ── Live moderation ─────────────────────────────────────── -->
  <div class="card">
    <h2>Live moderation</h2>
    <div class="muted" style="margin-bottom:.6rem">Take action on a viewer right now — ban, timeout, or unban.</div>
    <div class="srow">
      <label>Username
        <input id="mod-user" placeholder="username" />
      </label>
      <label>Action
        <select id="mod-action">
          <option value="ban">Ban</option>
          <option value="timeout">Timeout</option>
          <option value="unban">Unban</option>
        </select>
      </label>
      <label>Timeout (min)
        <input id="mod-mins" type="number" min="1" value="10" style="width:6rem" />
      </label>
      <label>Reason
        <input id="mod-reason" placeholder="reason (optional)" />
      </label>
      <button id="mod-go">Apply</button>
    </div>
    <div id="mod-result" class="muted" style="margin-top:.7rem"></div>
  </div>

  <!-- ── Giveaway ────────────────────────────────────────────── -->
  <div class="card">
    <h2>🎉 Giveaway</h2>
    <div id="gw-state">Loading…</div>
    <div id="gw-form" style="display:none">
      <div class="srow">
        <label>Title
          <input id="gw-title" placeholder="prize / title" />
        </label>
        <label>Keyword
          <input id="gw-keyword" value="enter" style="width:8rem" />
        </label>
        <button id="gw-start">Start giveaway</button>
      </div>
    </div>
  </div>

  <!-- ── Alerts & events ─────────────────────────────────────── -->
  <div class="card">
    <h2>🔔 Alerts &amp; events</h2>
    <div class="muted" style="margin-bottom:.6rem">Thank followers and subscribers automatically in chat. Requires event subscriptions to be enabled once.</div>
    <div class="srow">
      <button id="ev-sub" class="ghost">Enable event subscriptions</button>
      <span id="ev-sub-msg" class="muted"></span>
    </div>
    <textarea id="thank-follow" placeholder="Follow thank-you (blank = off) — supports {{username}}" style="width:100%;margin-top:.6rem"></textarea>
    <textarea id="thank-sub" placeholder="Sub thank-you (blank = off) — supports {{username}}" style="width:100%;margin-top:.6rem"></textarea>
    <button id="ev-save" style="margin-top:1.25rem">Save alert messages</button>
    <div class="muted" style="margin-top:1.1rem;margin-bottom:.4rem">Recent events</div>
    <div id="ev-feed" class="log-out">Loading…</div>
    <button id="ev-refresh" class="ghost" style="margin-top:.75rem">Refresh</button>
  </div>

  <!-- ── Channel settings (preserved) ────────────────────────── -->
  <div class="card">
    <h2>Channel settings</h2>
    <div class="srow">
      <label>Command prefix
        <input id="prefix" maxlength="5" value="<%= channel.command_prefix || '!' %>" style="width:5rem" />
      </label>
      <label>Global cooldown (s)
        <input id="cg" type="number" min="0" max="60" value="<%= channel.cooldown_global || 0 %>" style="width:6rem" />
      </label>
      <label>Per-user cooldown (s)
        <input id="cu" type="number" min="0" max="300" value="<%= channel.cooldown_user || 0 %>" style="width:6rem" />
      </label>
    </div>

    <div class="muted" style="margin-top:1.1rem;margin-bottom:.4rem">Features</div>
    <div id="feats" class="srow" data-json='<%= channel.features_enabled || "{}" %>'></div>

    <div class="muted" style="margin-top:1.1rem;margin-bottom:.4rem">Welcome message for first-time chatters</div>
    <textarea id="welcome-msg" placeholder="First-time chatter welcome (blank = off) — supports {{username}}" style="width:100%;margin-top:.6rem"></textarea>

    <button id="save" style="margin-top:1.25rem">Save settings</button>
  </div>

  <!-- ── Automod filters ─────────────────────────────────────── -->
  <div class="card">
    <h2>Automod filters</h2>
    <div class="muted" style="margin-bottom:.6rem">Auto-delete messages that break these rules. Mods and the broadcaster are exempt.</div>
    <div class="srow">
      <label style="flex-direction:row;gap:.35rem;align-items:center">
        <input id="am-caps" type="checkbox" /> Block excessive caps
      </label>
      <label>% caps
        <input id="am-caps-pct" type="number" min="10" max="100" value="70" style="width:5rem" />
      </label>
    </div>
    <div class="srow">
      <label style="flex-direction:row;gap:.35rem;align-items:center">
        <input id="am-links" type="checkbox" /> Block links
      </label>
      <label style="flex-direction:row;gap:.35rem;align-items:center">
        <input id="am-symbols" type="checkbox" /> Block symbol spam
      </label>
    </div>
    <div class="srow">
      <label>Max message length (0 = off)
        <input id="am-maxlen" type="number" min="0" max="500" value="0" style="width:6rem" />
      </label>
    </div>
    <textarea id="am-words" placeholder="Banned words/phrases — comma-separated; use * as a wildcard (e.g. scam*)" style="width:100%;margin-top:.6rem"></textarea>
    <button id="am-save" style="margin-top:1.25rem">Save automod</button>
  </div>

  <!-- ── Copy configuration ──────────────────────────────────── -->
  <div class="card" id="cp-card">
    <h2>Copy configuration</h2>
    <div class="muted" style="margin-bottom:.6rem">Copies commands, responders, timers, automod &amp; settings FROM another of your channels — overwriting this channel's current setup.</div>
    <div class="srow">
      <label>Copy from
        <select id="cp-from"></select>
      </label>
      <button id="cp-go" class="danger">Copy here</button>
    </div>
  </div>

  <!-- ── Activity — last 14 days ─────────────────────────────── -->
  <div class="card">
    <h2>Activity — last 14 days</h2>
    <div class="muted" style="margin-bottom:.6rem">Daily enforcement volume on this channel.</div>
    <div id="ch-trend">Loading…</div>
    <div class="muted" style="margin-top:.7rem;display:flex;gap:1.1rem;flex-wrap:wrap;font-size:.82rem">
      <span><span style="display:inline-block;width:.7rem;height:.7rem;border-radius:2px;background:#53FC18;vertical-align:middle;margin-right:.35rem"></span>Banned</span>
      <span><span style="display:inline-block;width:.7rem;height:.7rem;border-radius:2px;background:#7c84ff;vertical-align:middle;margin-right:.35rem"></span>Removed</span>
      <span><span style="display:inline-block;width:.7rem;height:.7rem;border-radius:2px;background:rgba(255,255,255,.25);vertical-align:middle;margin-right:.35rem"></span>Detected</span>
    </div>
    <div id="chat-trend" class="muted" style="margin-top:.9rem">Loading chat volume…</div>
    <div class="muted" style="margin-top:.35rem;font-size:.82rem">Messages per day</div>
  </div>

  <!-- ── Recent activity ─────────────────────────────────────── -->
  <div class="card">
    <h2>Recent activity</h2>
    <div class="muted" style="margin-bottom:.6rem">Latest enforcement actions on this channel.</div>
    <div id="feed" class="log-out">Loading…</div>
    <button id="feed-refresh" class="ghost" style="margin-top:.75rem">Refresh</button>
  </div>

  <!-- ── Quick links ─────────────────────────────────────────── -->
  <div class="card">
    <h2>Quick links</h2>
    <ul class="clean">
      <li><a href="/kick/channel/<%= channel.channel_id %>/commands">Manage commands →</a></li>
      <li><a href="https://kick.com/<%= channel.channel_name %>" target="_blank" rel="noopener">View on Kick →</a></li>
      <li><a href="/kick">All channels →</a></li>
    </ul>
  </div>

<% var pageJs = `
  <script>
    const CHANNEL = document.querySelector('[data-channel]').dataset.channel;
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

    // ── Feature toggles from stored JSON (data-attr avoids EJS-in-JS quoting bugs) ──
    const FEATURES = ['tokes','spark','sessions','trivia'];
    let feats = {};
    try { feats = JSON.parse(document.getElementById('feats').dataset.json || '{}') || {}; } catch (_) {}
    document.getElementById('feats').innerHTML = FEATURES.map(f =>
      '<label style="flex-direction:row;gap:.35rem;align-items:center">' +
      '<input type="checkbox" class="feat" data-feat="' + f + '"' + (feats[f] !== false ? ' checked' : '') + '/> ' + f + '</label>').join('');

    // ── Automod filters init (reuse the same parsed features object) ──
    const am = (feats && feats.automod) || {};
    document.getElementById('am-caps').checked = !!am.caps;
    document.getElementById('am-caps-pct').value = am.caps_pct || 70;
    document.getElementById('am-links').checked = !!am.links;
    document.getElementById('am-symbols').checked = !!am.symbols;
    document.getElementById('am-maxlen').value = am.max_len || 0;
    document.getElementById('am-words').value = am.words || '';
    document.getElementById('welcome-msg').value = feats.welcome_message || '';
    document.getElementById('thank-follow').value = feats.thank_follow || '';
    document.getElementById('thank-sub').value = feats.thank_sub || '';

    // ── Single source of truth for features_enabled: BOTH save paths round-trip
    //    game toggles + automod (incl. words) + welcome_message so neither clobbers ──
    function buildFeatures() {
      const features = {};
      document.querySelectorAll('.feat').forEach(c => { features[c.dataset.feat] = c.checked; });
      features.automod = {
        caps: document.getElementById('am-caps').checked,
        caps_pct: Number(document.getElementById('am-caps-pct').value) || 70,
        links: document.getElementById('am-links').checked,
        symbols: document.getElementById('am-symbols').checked,
        max_len: Number(document.getElementById('am-maxlen').value) || 0,
        words: document.getElementById('am-words').value
      };
      features.welcome_message = document.getElementById('welcome-msg').value;
      features.thank_follow = document.getElementById('thank-follow').value;
      features.thank_sub = document.getElementById('thank-sub').value;
      return features;
    }

    document.getElementById('am-save').addEventListener('click', async (e) => {
      const btn = e.currentTarget; btn.disabled = true;
      const features = buildFeatures();
      try {
        await KickDash.patch('/kick/api/channel/' + CHANNEL, { features_enabled: features });
        btn.textContent = 'Saved ✓';
      } catch (err) { alert(err.message || 'Save failed.'); }
      finally { btn.disabled = false; setTimeout(() => { btn.textContent = 'Save automod'; }, 1500); }
    });

    // ── Channel settings save ──
    document.getElementById('save').addEventListener('click', async (e) => {
      const btn = e.currentTarget; btn.disabled = true;
      const features = buildFeatures();
      try {
        await KickDash.patch('/kick/api/channel/' + CHANNEL, {
          command_prefix: document.getElementById('prefix').value,
          cooldown_global: document.getElementById('cg').value,
          cooldown_user: document.getElementById('cu').value,
          features_enabled: features
        });
        btn.textContent = 'Saved ✓';
      } catch (err) { alert(err.message || 'Save failed.'); }
      finally { btn.disabled = false; setTimeout(() => { btn.textContent = 'Save settings'; }, 1500); }
    });

    // ── Live moderation ──
    document.getElementById('mod-go').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const out = document.getElementById('mod-result');
      const action = document.getElementById('mod-action').value;
      const username = document.getElementById('mod-user').value.trim();
      const reason = document.getElementById('mod-reason').value.trim();
      const minutes = Number(document.getElementById('mod-mins').value) || 10;
      if (!username) { out.textContent = 'Enter a username first.'; return; }
      btn.disabled = true; out.textContent = 'Working…';
      const body = { action, username };
      if (action === 'timeout') body.minutes = minutes;
      if (reason) body.reason = reason;
      try {
        await KickDash.post('/kick/api/channel/' + CHANNEL + '/moderate', body);
        const verb = action === 'ban' ? 'Banned' : action === 'timeout' ? 'Timed out' : 'Unbanned';
        out.textContent = '✓ ' + verb + ' ' + username;
        document.getElementById('mod-user').value = '';
        document.getElementById('mod-reason').value = '';
        loadFeed();
      } catch (err) { out.textContent = err.message || 'Action failed.'; }
      finally { btn.disabled = false; }
    });

    // ── Activity feed ──
    async function loadFeed() {
      const feed = document.getElementById('feed');
      feed.textContent = 'Loading…';
      try {
        const res = await fetch('/kick/api/enforcement-log?channelId=' + encodeURIComponent(CHANNEL) + '&limit=30');
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || 'Failed');
        if (!j.events || !j.events.length) { feed.textContent = 'No actions recorded yet.'; return; }
        feed.innerHTML = '<table>' + j.events.map(ev =>
          '<tr><td>' + (ev.created_at ? new Date(ev.created_at).toISOString().slice(0,16).replace('T',' ') : '—') +
          '</td><td>' + esc(ev.action) + (ev.success ? '' : ' (failed)') +
          '</td><td>' + esc(ev.target_username) + '</td><td>' + esc(ev.reason) + '</td></tr>').join('') + '</table>';
      } catch (err) { feed.textContent = err.message || 'Failed to load.'; }
    }
    document.getElementById('feed-refresh').addEventListener('click', loadFeed);

    // ── 14-day activity chart (self-contained SVG stacked bars) ──
    async function loadChTrend() {
      const host = document.getElementById('ch-trend');
      try {
        const res = await fetch('/kick/api/channel/' + CHANNEL + '/trend?days=14');
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || 'Failed');
        const series = (j && j.series) || [];
        const totals = series.map(d => (Number(d.banned)||0) + (Number(d.deleted)||0) + (Number(d.dormant)||0));
        const max = Math.max(0, ...totals);
        if (!series.length || max === 0) { host.textContent = 'No activity in the last 14 days.'; return; }

        const W = 560, H = 160, padL = 8, padR = 8, padT = 12, padB = 22;
        const plotW = W - padL - padR, plotH = H - padT - padB;
        const n = series.length;
        const slot = plotW / n;
        const barW = Math.min(22, slot * 0.62);

        const bars = series.map((d, i) => {
          const banned = Number(d.banned) || 0;
          const deleted = Number(d.deleted) || 0;
          const dormant = Number(d.dormant) || 0;
          const total = banned + deleted + dormant;
          const x = padL + i * slot + (slot - barW) / 2;
          const baseY = padT + plotH;
          const px = v => (v / max) * plotH;
          let y = baseY;
          const segs = [];
          // stack bottom-up: banned, then deleted, then dormant
          [['dormant', dormant, 'rgba(255,255,255,.25)'], ['deleted', deleted, '#7c84ff'], ['banned', banned, '#53FC18']].forEach(s => {
            const h = px(s[1]);
            if (h > 0) { y -= h; segs.push('<rect x="' + x.toFixed(1) + '" y="' + y.toFixed(1) + '" width="' + barW.toFixed(1) + '" height="' + h.toFixed(1) + '" fill="' + s[2] + '" rx="1.5"/>'); }
          });
          let lbl = '';
          if (i % 3 === 0 && d.date) {
            const parts = String(d.date).split('-');
            const md = (parts[1] || '') + '/' + (parts[2] || '');
            const cx = x + barW / 2;
            lbl = '<text x="' + cx.toFixed(1) + '" y="' + (H - 7) + '" fill="var(--muted)" font-size="9" text-anchor="middle">' + md + '</text>';
          }
          return segs.join('') + lbl;
        }).join('');

        const baseline = '<line x1="' + padL + '" y1="' + (padT + plotH) + '" x2="' + (W - padR) + '" y2="' + (padT + plotH) + '" stroke="var(--line)" stroke-width="1"/>';
        host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" preserveAspectRatio="xMidYMid meet" role="img" aria-label="14-day activity chart">' + baseline + bars + '</svg>';
      } catch (err) { host.textContent = 'Failed to load chart.'; }
    }

    // ── Giveaway ──
    let gwTimer = null;
    async function loadGiveaway() {
      const state = document.getElementById('gw-state');
      const form = document.getElementById('gw-form');
      if (gwTimer) { clearInterval(gwTimer); gwTimer = null; }
      try {
        const res = await fetch('/kick/api/channel/' + CHANNEL + '/giveaway');
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || 'Failed');
        const g = j.giveaway;
        if (!g || g.status !== 'active') {
          state.innerHTML = (g && g.status === 'drawn')
            ? '<div class="muted" style="margin-bottom:.6rem">Last winner: @' + esc(g.winner_username) + ' (' + esc(g.title) + ')</div>'
            : '';
          form.style.display = '';
          return;
        }
        form.style.display = 'none';
        state.innerHTML =
          '<div style="margin-bottom:.35rem"><strong>' + esc(g.title) + '</strong></div>' +
          '<div class="muted" style="margin-bottom:.7rem">type !' + esc(g.keyword) + ' to enter — <span id="gw-entries">' + (Number(g.entries) || 0) + '</span> entries</div>' +
          '<div class="srow">' +
          '<button id="gw-draw">Draw winner 🎲</button>' +
          '<button id="gw-close" class="ghost">Close without drawing</button>' +
          '</div>';
        document.getElementById('gw-draw').addEventListener('click', async (e) => {
          const btn = e.currentTarget; btn.disabled = true;
          document.getElementById('gw-close').disabled = true;
          try {
            const r = await KickDash.post('/kick/api/channel/' + CHANNEL + '/giveaway/' + g.id + '/draw', {});
            alert('Winner: @' + (r && r.winner ? r.winner : 'unknown'));
          } catch (err) { alert(err.message || 'Draw failed.'); }
          loadGiveaway();
        });
        document.getElementById('gw-close').addEventListener('click', async (e) => {
          if (!confirm('Close this giveaway without drawing a winner?')) return;
          const btn = e.currentTarget; btn.disabled = true;
          document.getElementById('gw-draw').disabled = true;
          try {
            await KickDash.post('/kick/api/channel/' + CHANNEL + '/giveaway/' + g.id + '/close', {});
          } catch (err) { alert(err.message || 'Close failed.'); }
          loadGiveaway();
        });
        gwTimer = setInterval(async () => {
          try {
            const r2 = await fetch('/kick/api/channel/' + CHANNEL + '/giveaway');
            const j2 = await r2.json();
            if (r2.ok && j2.giveaway && j2.giveaway.status === 'active') {
              const el = document.getElementById('gw-entries');
              if (el) el.textContent = Number(j2.giveaway.entries) || 0;
            } else { loadGiveaway(); }
          } catch (_) {}
        }, 15000);
      } catch (err) { state.textContent = err.message || 'Failed to load giveaway.'; }
    }

    document.getElementById('gw-start').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const title = document.getElementById('gw-title').value.trim();
      const keyword = document.getElementById('gw-keyword').value.trim() || 'enter';
      if (!title) { alert('Enter a prize / title first.'); return; }
      btn.disabled = true;
      try {
        await KickDash.post('/kick/api/channel/' + CHANNEL + '/giveaway', { title: title, keyword: keyword });
        document.getElementById('gw-title').value = '';
        loadGiveaway();
      } catch (err) { alert(err.message || 'Failed to start giveaway.'); }
      finally { btn.disabled = false; }
    });

    // ── 14-day chat-volume chart (single-metric SVG bars) ──
    async function loadChatTrend() {
      const host = document.getElementById('chat-trend');
      try {
        const res = await fetch('/kick/api/channel/' + CHANNEL + '/chat-trend?days=14');
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || 'Failed');
        const series = (j && j.series) || [];
        const max = Math.max(0, ...series.map(d => Number(d.messages) || 0));
        if (!series.length || max === 0) { host.textContent = 'No chat recorded yet.'; return; }
        const W = 560, H = 80, padL = 8, padR = 8, padT = 6, padB = 6;
        const plotW = W - padL - padR, plotH = H - padT - padB;
        const slot = plotW / series.length;
        const barW = Math.min(14, slot * 0.55);
        const bars = series.map((d, i) => {
          const v = Number(d.messages) || 0;
          if (v <= 0) return '';
          const h = (v / max) * plotH;
          const x = padL + i * slot + (slot - barW) / 2;
          const y = padT + plotH - h;
          return '<rect x="' + x.toFixed(1) + '" y="' + y.toFixed(1) + '" width="' + barW.toFixed(1) + '" height="' + h.toFixed(1) + '" fill="var(--kick-dim)" fill-opacity=".55" rx="1.5"/>';
        }).join('');
        host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" preserveAspectRatio="xMidYMid meet" role="img" aria-label="14-day chat volume chart">' + bars + '</svg>';
      } catch (err) { host.textContent = 'Failed to load chat volume.'; }
    }

    // ── Alerts & events ──
    document.getElementById('ev-sub').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const msg = document.getElementById('ev-sub-msg');
      btn.disabled = true; msg.textContent = 'Working…';
      try {
        await KickDash.post('/kick/api/channel/' + CHANNEL + '/events/subscribe', {});
        msg.textContent = '✓ Subscribed';
      } catch (err) { msg.textContent = err.message || 'Subscribe failed.'; }
      finally { btn.disabled = false; }
    });

    document.getElementById('ev-save').addEventListener('click', async (e) => {
      const btn = e.currentTarget; btn.disabled = true;
      try {
        await KickDash.patch('/kick/api/channel/' + CHANNEL, { features_enabled: buildFeatures() });
        btn.textContent = 'Saved ✓';
      } catch (err) { alert(err.message || 'Save failed.'); }
      finally { btn.disabled = false; setTimeout(() => { btn.textContent = 'Save alert messages'; }, 1500); }
    });

    async function loadEvents() {
      const feed = document.getElementById('ev-feed');
      feed.textContent = 'Loading…';
      try {
        const res = await fetch('/kick/api/channel/' + CHANNEL + '/events/recent');
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || 'Failed');
        if (!j.events || !j.events.length) { feed.textContent = 'No events received yet — enable subscriptions above.'; return; }
        feed.innerHTML = '<table>' + j.events.map(ev =>
          '<tr><td>' + (ev.created_at ? new Date(ev.created_at).toISOString().slice(0,16).replace('T',' ') : '—') +
          '</td><td>' + esc(ev.event_type) + '</td><td>' + esc(ev.actor_username) + '</td></tr>').join('') + '</table>';
      } catch (err) { feed.textContent = err.message || 'Failed to load.'; }
    }
    document.getElementById('ev-refresh').addEventListener('click', loadEvents);

    // ── Copy configuration ──
    document.getElementById('cp-go').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const from = document.getElementById('cp-from').value;
      if (!from) { alert('Pick a source channel first.'); return; }
      if (!confirm("This OVERWRITES this channel's commands, responders, timers and settings. Continue?")) return;
      btn.disabled = true;
      try {
        await KickDash.post('/kick/api/channel/' + CHANNEL + '/copy-config', { from: from });
        alert('Copied ✓');
        location.reload();
      } catch (err) { alert(err.message || 'Copy failed.'); btn.disabled = false; }
    });

    async function loadCopySources() {
      const card = document.getElementById('cp-card');
      const sel = document.getElementById('cp-from');
      try {
        const res = await fetch('/kick/api/my-channels');
        const j = await res.json();
        if (!res.ok) throw new Error(j.error || 'Failed');
        const others = ((j && j.channels) || []).filter(c => String(c.channel_id) !== String(CHANNEL));
        if (!others.length) {
          card.innerHTML = '<h2>Copy configuration</h2><div class="muted">You only have one channel.</div>';
          return;
        }
        sel.innerHTML = others.map(c =>
          '<option value="' + esc(c.channel_id) + '">' + esc(c.channel_name) + '</option>').join('');
      } catch (err) {
        card.innerHTML = '<h2>Copy configuration</h2><div class="muted">' + esc(err.message || 'Failed to load your channels.') + '</div>';
      }
    }

    loadFeed();
    loadChTrend();
    loadGiveaway();
    loadChatTrend();
    loadCopySources();
    loadEvents();
  </script>`; %>
