<%- include('_head', { pageTitle: 'Commands for ' + channel.channel_name, csrfToken, kickUser: user }) %>
<%
  // Master-switch state: chat commands are opt-in (off unless explicitly true).
  var _feats = {};
  try { _feats = channel.features_enabled ? (typeof channel.features_enabled === 'string' ? JSON.parse(channel.features_enabled) : channel.features_enabled) : {}; } catch (e) { _feats = {}; }
  var commandsOn = !!(_feats && _feats.commands === true);
  var cid = channel.channel_id;
%>

  <div class="pagehead">
    <div>
      <div class="kick-eyebrow">Kick Defender</div>
      <h1><%= channel.channel_name %></h1>
      <p class="sub">Built-in commands, your own commands, auto-responders and timers.</p>
    </div>
  </div>
  <nav class="kick-tabs" aria-label="Channel">
    <a href="/kick">All channels</a>
    <a href="/kick/channel/<%= cid %>">Settings</a>
    <a href="/kick/channel/<%= cid %>/commands" aria-current="page">Commands</a>
  </nav>

  <% if (!commandsOn) { %>
    <div class="cf-notice is-warn">
      <div class="cf-notice-body">
        <strong>Chat commands are off for this channel.</strong> Everything here stays silent until you turn on
        <a href="/kick/channel/<%= cid %>">Chat commands</a> in the channel's chat settings. Timers are not affected.
      </div>
    </div>
  <% } %>
  <%- include('../partials/channel-bot/commands-body', { apiBase: '/kick/api/channel/' + encodeURIComponent(String(cid)), showTimers: true }) %>
<%- include('_foot') %>
