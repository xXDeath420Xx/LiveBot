<%- include('_head', { pageTitle: 'Manager console', csrfToken, kickUser: user, kickTab: 'managers', isManager: true, isAdmin }) %>
<%
  var nameOf = function (b) { return b.username || b.platform_user_id || ''; };
%>

  <div class="pagehead">
    <div>
      <div class="kick-eyebrow">Kick Defender</div>
      <h1>Manager console</h1>
      <p class="sub">The shared lists every connected channel is protected by.</p>
    </div>
  </div>

  <dl class="cf-kpis">
    <div class="cf-kpi"><dt>Banlist</dt><dd><%= Number(counts.banlist || 0).toLocaleString() %></dd></div>
    <div class="cf-kpi"><dt>Sublist</dt><dd><%= Number(counts.sublist || 0).toLocaleString() %></dd></div>
    <div class="cf-kpi"><dt>Whitelist</dt><dd><%= Number(counts.unbanlist || 0).toLocaleString() %></dd></div>
    <div class="cf-kpi"><dt>Manual sites</dt><dd><%= Number(counts.sites || 0).toLocaleString() %></dd></div>
    <div class="cf-kpi"><dt>Scam domains</dt><dd><%= Number(phishingCount || 0).toLocaleString() %></dd></div>
  </dl>

  <!-- Banlist -->
  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Banlist <span class="muted">(<%= Number(counts.banlist || 0).toLocaleString() %>)</span></h2>
        <p class="cf-section-desc">Accounts banned in every enrolled channel. In chat, <code>!add-ban &lt;user&gt;</code> does the same.</p>
      </div>
      <% if (bans.length > 15) { %><div class="cf-section-actions"><input type="search" class="kick-search kick-filter" data-list="ban-list" placeholder="Filter shown names" aria-label="Filter the banlist"></div><% } %>
    </header>
    <div class="cf-rows">
      <div class="cf-row cf-row--stack">
        <div class="cf-fields">
          <div class="cf-field"><label for="ban-username">Kick username</label><input id="ban-username" maxlength="60" autocomplete="off"></div>
          <div class="cf-field"><label for="ban-reason">Reason</label><input id="ban-reason" maxlength="200" autocomplete="off" placeholder="Optional"></div>
          <div class="cf-field">
            <label for="ban-type">List</label>
            <select id="ban-type">
              <option value="ban">Banlist</option>
              <option value="sublist">Sublist</option>
            </select>
          </div>
        </div>
      </div>
      <div class="cf-section-foot">
        <span class="kick-status cf-foot-note" id="ban-msg" role="status" aria-live="polite"></span>
        <button type="button" id="ban-remove" class="btn btn-danger btn-sm">Remove this name</button>
        <button type="button" id="ban-add" class="btn btn-primary btn-sm">Add</button>
      </div>
      <% if (!bans.length) { %>
        <div class="cf-state cf-state--compact"><p class="cf-state-text">Nobody is on the banlist yet.</p></div>
      <% } %>
      <div class="cf-list" id="ban-list">
        <% bans.forEach(function (b) { %>
          <div class="cf-list-item" data-name="<%= nameOf(b).toLowerCase() %>">
            <div class="cf-list-main"><span class="cf-em"><%= nameOf(b) %></span><% if (b.reason) { %> <span class="muted"><%= b.reason %></span><% } %></div>
            <div class="cf-list-actions"><button type="button" class="btn btn-danger btn-sm ban-remove" data-username="<%= nameOf(b) %>">Remove</button></div>
          </div>
        <% }) %>
      </div>
      <% if (counts.banlist > bans.length) { %>
        <div class="cf-list-item"><span class="muted">Showing the latest <%= bans.length %> of <%= Number(counts.banlist).toLocaleString() %>. Add or remove any name with the form above.</span></div>
      <% } %>
    </div>
  </section>

  <!-- Scam-link check -->
  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Scam links</h2>
        <p class="cf-section-desc"><%= Number(phishingCount || 0).toLocaleString() %> known phishing and scam domains, refreshed from community lists every 4 hours. A link in an enrolled channel is removed with a warning; the poster is banned once their links reach that channel's strike limit (2 by default, counted across the network).</p>
      </div>
    </header>
    <div class="cf-rows">
      <div class="cf-row">
        <div class="cf-row-text"><label class="cf-row-label" for="check-domain">Check a domain</label><p class="cf-row-desc">Uses the same matching as the defender, including parent domains.</p></div>
        <div class="cf-row-control">
          <div class="kick-inline"><input id="check-domain" maxlength="300" placeholder="free-nitro.xyz"><button type="button" id="check-btn" class="btn btn-secondary btn-sm">Check</button></div>
          <span id="check-result" class="kick-status" role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Manual sites -->
  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Manual sites <span class="muted">(<%= Number(counts.sites || 0).toLocaleString() %>)</span></h2>
        <p class="cf-section-desc">Bad domains seen on Kick that the shared lists don't have yet.</p>
      </div>
    </header>
    <div class="cf-rows">
      <div class="cf-row">
        <div class="cf-row-text"><label class="cf-row-label" for="site-uri">Add a site</label></div>
        <div class="cf-row-control"><div class="kick-inline"><input id="site-uri" maxlength="300" placeholder="https://bad.example"><button type="button" id="site-add" class="btn btn-primary btn-sm">Add site</button></div><span id="site-msg" class="kick-status" role="status" aria-live="polite"></span></div>
      </div>
      <div class="cf-list">
        <% sites.forEach(function (s) { %>
          <div class="cf-list-item">
            <div class="cf-list-main"><%= s.uri %></div>
            <div class="cf-list-actions"><button type="button" class="btn btn-danger btn-sm site-remove" data-uri="<%= s.uri %>">Remove</button></div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Sublist -->
  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Sublist <span class="muted">(<%= Number(counts.sublist || 0).toLocaleString() %>)</span></h2>
        <p class="cf-section-desc">Raid and bot accounts added during an attack. Cleared in one go when it's over.</p>
      </div>
      <div class="cf-section-actions">
        <% if (sublist.length > 15) { %><input type="search" class="kick-search kick-filter" data-list="sub-list" placeholder="Filter names" aria-label="Filter the sublist"><% } %>
        <button type="button" id="sub-clear" class="btn btn-danger btn-sm">Clear sublist</button>
      </div>
    </header>
    <div class="cf-rows">
      <div class="cf-row cf-row--stack">
        <div class="cf-fields">
          <div class="cf-field"><label for="sub-username">Kick username</label><input id="sub-username" maxlength="60" autocomplete="off"></div>
          <div class="cf-field"><label for="sub-reason">Reason</label><input id="sub-reason" maxlength="200" autocomplete="off" placeholder="Optional"></div>
        </div>
      </div>
      <div class="cf-section-foot">
        <span class="kick-status cf-foot-note" id="sub-msg" role="status" aria-live="polite"></span>
        <button type="button" id="sub-add" class="btn btn-primary btn-sm">Add to sublist</button>
      </div>
      <div class="cf-list" id="sub-list">
        <% sublist.forEach(function (b) { %>
          <div class="cf-list-item" data-name="<%= nameOf(b).toLowerCase() %>">
            <div class="cf-list-main"><span class="cf-em"><%= nameOf(b) %></span><% if (b.reason) { %> <span class="muted"><%= b.reason %></span><% } %></div>
            <div class="cf-list-actions"><button type="button" class="btn btn-danger btn-sm ban-remove" data-username="<%= nameOf(b) %>">Remove</button></div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Whitelist -->
  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Whitelist <span class="muted">(<%= Number(counts.unbanlist || 0).toLocaleString() %>)</span></h2>
        <p class="cf-section-desc">The defender never acts on these accounts, even if they're on the banlist.</p>
      </div>
      <% if (unbans && unbans.length > 15) { %><div class="cf-section-actions"><input type="search" class="kick-search kick-filter" data-list="unban-list" placeholder="Filter names" aria-label="Filter the whitelist"></div><% } %>
    </header>
    <div class="cf-rows">
      <div class="cf-row">
        <div class="cf-row-text"><label class="cf-row-label" for="unban-username">Add an account</label></div>
        <div class="cf-row-control"><div class="kick-inline"><input id="unban-username" maxlength="60" autocomplete="off" placeholder="Kick username"><button type="button" id="unban-add" class="btn btn-primary btn-sm">Add to whitelist</button></div><span id="unban-msg" class="kick-status" role="status" aria-live="polite"></span></div>
      </div>
      <div class="cf-list" id="unban-list">
        <% (unbans || []).forEach(function (u) { %>
          <div class="cf-list-item" data-name="<%= nameOf(u).toLowerCase() %>">
            <div class="cf-list-main"><span class="cf-em"><%= nameOf(u) %></span></div>
            <div class="cf-list-actions"><button type="button" class="btn btn-danger btn-sm unban-remove" data-username="<%= nameOf(u) %>">Remove</button></div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Network activity -->
  <section class="cf-section">
    <header class="cf-section-head">
      <div>
        <h2 class="cf-section-title">Recent network activity</h2>
        <p class="cf-section-desc">The latest defender actions across every connected channel.</p>
      </div>
      <div class="cf-section-actions"><button type="button" id="net-refresh" class="btn btn-secondary btn-sm">Refresh</button></div>
    </header>
    <div class="cf-rows"><div class="cf-row cf-row--stack"><div id="net-feed"><p class="muted">Loading…</p></div></div></div>
  </section>

  <% if (isAdmin) { %>
    <p class="muted">Managers are added and removed on <a href="/kick/admin">Connected accounts</a>.</p>
  <% } %>

  <script>
  (function () {
    var K = window.KickDash;
    var $ = function (id) { return document.getElementById(id); };
    var v = function (id) { return $(id).value.trim(); };

    // Every change here reloads the page so the lists and counts are current.
    async function send(method, url, body, out) {
      K.status(out, 'Working…');
      try {
        if (method === 'DELETE') await K.del(url, body); else await K.post(url, body);
        location.reload();
      } catch (e) { K.status(out, e.message || 'Request failed.', 'bad'); }
    }

    $('ban-add').addEventListener('click', function () {
      if (!v('ban-username')) { K.status($('ban-msg'), 'Enter a username.', 'bad'); return; }
      send('POST', '/kick/api/ban', { username: v('ban-username'), reason: v('ban-reason'), listType: $('ban-type').value }, $('ban-msg'));
    });
    $('ban-remove').addEventListener('click', function () {
      if (!v('ban-username')) { K.status($('ban-msg'), 'Enter the username to remove.', 'bad'); return; }
      send('DELETE', '/kick/api/ban', { username: v('ban-username') }, $('ban-msg'));
    });
    document.querySelectorAll('.ban-remove').forEach(function (b) {
      b.addEventListener('click', function () { b.disabled = true; send('DELETE', '/kick/api/ban', { username: b.dataset.username }, $('ban-msg')); });
    });

    $('site-add').addEventListener('click', function () {
      if (!v('site-uri')) return;
      send('POST', '/kick/api/site', { uri: v('site-uri') }, $('site-msg'));
    });
    document.querySelectorAll('.site-remove').forEach(function (b) {
      b.addEventListener('click', function () { b.disabled = true; send('DELETE', '/kick/api/site', { uri: b.dataset.uri }, $('site-msg')); });
    });

    $('sub-add').addEventListener('click', function () {
      if (!v('sub-username')) { K.status($('sub-msg'), 'Enter a username.', 'bad'); return; }
      send('POST', '/kick/api/sublist', { username: v('sub-username'), reason: v('sub-reason') }, $('sub-msg'));
    });
    $('sub-clear').addEventListener('click', function () {
      if (confirm('Clear the entire sublist?')) send('POST', '/kick/api/sublist/clear', {}, $('sub-msg'));
    });

    $('unban-add').addEventListener('click', function () {
      if (!v('unban-username')) return;
      send('POST', '/kick/api/unban', { username: v('unban-username') }, $('unban-msg'));
    });
    document.querySelectorAll('.unban-remove').forEach(function (b) {
      b.addEventListener('click', function () { b.disabled = true; send('DELETE', '/kick/api/unban', { username: b.dataset.username }, $('unban-msg')); });
    });

    // Filters for long lists (only the rows on the page).
    document.querySelectorAll('.kick-filter').forEach(function (inp) {
      inp.addEventListener('input', function () {
        var t = inp.value.trim().toLowerCase();
        document.querySelectorAll('#' + inp.dataset.list + ' .cf-list-item').forEach(function (row) {
          row.hidden = !!t && (row.dataset.name || '').indexOf(t) === -1;
        });
      });
    });

    // Scam-link lookup (no reload).
    async function runCheck() {
      var q = v('check-domain'), out = $('check-result');
      if (!q) return;
      K.status(out, 'Checking…');
      try {
        var j = await K.get('/kick/api/check-domain?q=' + encodeURIComponent(q));
        if (j.safe) K.status(out, j.query + ' is on the allow list and is never blocked.', 'ok');
        else if (j.blocked) K.status(out, j.query + ' is blocked (matched ' + j.matched + ').', 'bad');
        else K.status(out, j.query + ' is not on the blocklist.');
      } catch (e) { K.status(out, e.message || 'Check failed.', 'bad'); }
    }
    $('check-btn').addEventListener('click', runCheck);
    $('check-domain').addEventListener('keydown', function (e) { if (e.key === 'Enter') runCheck(); });

    async function loadNetFeed() {
      var host = $('net-feed');
      try {
        var j = await K.get('/kick/api/network-activity?limit=40');
        K.table(host, ['Time', 'Channel', 'Action', 'User', 'Reason'], (j.events || []).map(function (e) {
          return [{ text: K.fmtTime(e.created_at) || '—', cls: 'nowrap' }, e.channel_name || e.channel_id || '', e.action + (e.success ? '' : ' (failed)'), e.target_username || '', e.reason || ''];
        }), 'No actions recorded yet.');
      } catch (e) { host.replaceChildren(K.el('p', 'muted', e.message || 'Failed to load.')); }
    }
    $('net-refresh').addEventListener('click', loadNetFeed);
    loadNetFeed();
  })();
  </script>
<%- include('_foot') %>
