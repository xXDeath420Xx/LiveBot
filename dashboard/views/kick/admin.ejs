<%- include('_head', { pageTitle: 'Connected Accounts', csrfToken, kickUser: user }) %>

  <div class="pagehead">
    <div>
      <h1>🐻 Connected Accounts</h1>
      <div class="sub">Everyone connected to the network, their channels, permissions and token health.</div>
    </div>
    <nav class="subnav">
      <a href="/kick">Channels</a>
      <a href="/kick/managers">Manager console</a>
      <a href="/kick/admin" class="active">Connected accounts</a>
    </nav>
  </div>

  <!-- ── Overview stats ─────────────────────────────────────── -->
  <div class="statgrid">
    <div class="stat"><b><%= totals.accounts %></b><span>Connected accounts</span></div>
    <div class="stat kick"><b><%= totals.kick %></b><span>Kick accounts</span></div>
    <div class="stat"><b><%= totals.channels %></b><span>Channels</span></div>
    <div class="stat"><b><%= totals.enrolled %></b><span>Defender-enrolled</span></div>
  </div>

  <!-- ── Token-health callout (computed in-view) ─────────────── -->
  <% var expiredCount = accounts.filter(function(a){ return a.tokenExpired; }).length; %>
  <% if (expiredCount > 0) { %>
    <div class="banner">
      ⚠ <%= expiredCount %> account<%= expiredCount === 1 ? '' : 's' %> ha<%= expiredCount === 1 ? 's' : 've' %> expired tokens — those users must re-authorize with Kick to keep protection active.
    </div>
  <% } %>

  <!-- ── Manager roster ─────────────────────────────────────── -->
  <div class="card">
    <h2 style="margin:0 0 .8rem">Network managers</h2>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.9rem">
      <input id="mgr-add-user" class="search" placeholder="Kick username or user id" style="flex:1;min-width:200px" />
      <button id="mgr-add-btn">Add manager</button>
    </div>
    <ul class="clean" id="mgr-list"><li class="muted">Loading…</li></ul>
  </div>

  <!-- ── Network activity feed ──────────────────────────────── -->
  <div class="card">
    <div class="row" style="margin-bottom:.8rem">
      <h2 style="margin:0">Recent network activity</h2>
      <button id="net-refresh">Refresh</button>
    </div>
    <div id="net-feed" class="log-out">Loading…</div>
  </div>

  <input id="search" class="search" placeholder="Filter by username…" style="width:100%;margin:1.1rem 0" />

  <% if (!accounts.length) { %>
    <div class="card">
      <div class="empty">No connected accounts yet.</div>
    </div>
  <% } %>

  <% accounts.forEach(function(a){ %>
    <div class="card acct" data-name="<%= (a.platformName || a.primaryName || '').toLowerCase() %>">
      <div class="row">
        <div style="display:flex;align-items:center;gap:.8rem">
          <img src="<%= a.avatar || '/images/CertiFried.png' %>" alt="" onerror="this.src='/images/CertiFried.png'" style="width:42px;height:42px;border-radius:50%;object-fit:cover;background:#14121d" />
          <div>
            <div style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.1rem"><%= a.platformName || a.primaryName || 'Unknown' %></div>
            <div class="muted" style="margin-top:.2rem">
              user #<%= a.userId %><% if (a.lastSeen) { %> · last seen <%= new Date(a.lastSeen).toISOString().slice(0,16).replace('T',' ') %> UTC<% } %>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
          <span class="pill off"><%= a.platform %></span>
          <% if (a.isAdmin) { %><span class="pill ok">admin</span><% } %>
          <% if (a.isManager && !a.isAdmin) { %><span class="pill warn">manager</span><% } %>
          <% if (a.isBotAccount) { %><span class="pill off">bot account</span><% } %>
          <% if (a.isBanned) { %><span class="pill bad">banned</span><% } %>
          <% if (a.platform === 'kick') { %>
            <span class="pill <%= a.hasBanScope ? 'ok' : 'warn' %>"><%= a.hasBanScope ? 'can ban' : 'no ban scope' %></span>
          <% } %>
          <% if (a.tokenExpired) { %><span class="pill bad">token expired</span><% } %>
        </div>
      </div>

      <% if (a.tokenExpired) { %>
        <div class="banner">⚠ This account's Kick token has expired — protection is paused until they re-authorize.</div>
      <% } %>

      <% if (!a.channels.length) { %>
        <div class="muted" style="margin-top:.8rem">No channels registered.</div>
      <% } else { %>
        <ul class="clean" style="margin-top:.8rem">
          <% a.channels.forEach(function(ch){ %>
            <li>
              <span style="font-weight:600"><%= ch.channelName %></span>
              <span style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
                <% if (ch.stats) { %><span class="muted">banned <%= ch.stats.banned %> · deleted <%= ch.stats.deleted %> · dormant <%= ch.stats.dormant %></span><% } %>
                <span class="pill <%= ch.defenderEnabled ? 'ok' : 'off' %>"><%= ch.defenderEnabled ? 'defender ON' : 'defender off' %></span>
                <% if (!ch.enabled) { %><span class="pill off">disabled</span><% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <div class="muted" style="margin-top:.6rem;font-size:.72rem;word-break:break-word">
        scopes: <%= a.scopes && a.scopes.length ? a.scopes.join('  ') : '(none granted)' %>
      </div>
    </div>
  <% }) %>

<% var pageJs = `
  <script>
    // Client-side filter — no requests, purely cosmetic.
    var search = document.getElementById('search');
    if (search) {
      search.addEventListener('input', function () {
        var q = search.value.trim().toLowerCase();
        document.querySelectorAll('.acct').forEach(function (el) {
          el.style.display = !q || (el.dataset.name || '').includes(q) ? '' : 'none';
        });
      });
    }

    var esc = function (s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      });
    };

    var fmtTime = function (v) {
      if (!v) return '';
      var d = new Date(v);
      if (isNaN(d.getTime())) return esc(v);
      return d.toISOString().slice(0, 16).replace('T', ' ') + ' UTC';
    };

    async function loadManagers() {
      var list = document.getElementById('mgr-list');
      if (!list) return;
      try {
        var res = await fetch('/kick/api/managers', { headers: { 'Accept': 'application/json' } });
        var data = await res.json();
        var mgrs = (data && data.managers) || [];
        if (!mgrs.length) {
          list.innerHTML = '<li class="muted">No managers yet.</li>';
          return;
        }
        list.innerHTML = mgrs.map(function (m) {
          var added = m.addedAt ? ' <span class="muted">added ' + fmtTime(m.addedAt) + '</span>' : '';
          return '<li><span style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;justify-content:space-between">' +
            '<span><b>' + esc(m.name || m.userId) + '</b>' + added + '</span>' +
            '<button class="danger mgr-remove" data-user="' + esc(m.userId) + '">Remove</button>' +
            '</span></li>';
        }).join('');
        list.querySelectorAll('.mgr-remove').forEach(function (btn) {
          btn.addEventListener('click', async function () {
            try {
              await KickDash.post('/kick/api/managers', { user: btn.dataset.user, action: 'remove' });
              loadManagers();
            } catch (e) { alert('Failed to remove manager.'); }
          });
        });
      } catch (e) {
        list.innerHTML = '<li class="muted">Failed to load managers.</li>';
      }
    }

    async function loadNetFeed() {
      var feed = document.getElementById('net-feed');
      if (!feed) return;
      feed.textContent = 'Loading…';
      try {
        var res = await fetch('/kick/api/network-activity?limit=40', { headers: { 'Accept': 'application/json' } });
        var data = await res.json();
        var events = (data && data.events) || [];
        if (!events.length) {
          feed.innerHTML = '<div class="muted">No actions recorded yet.</div>';
          return;
        }
        var rows = events.map(function (ev) {
          var ok = ev.success ? 'ok' : 'bad';
          return '<tr>' +
            '<td class="muted" style="white-space:nowrap">' + fmtTime(ev.created_at) + '</td>' +
            '<td>' + esc(ev.channel_name || ev.channel_id) + '</td>' +
            '<td><span class="pill ' + ok + '">' + esc(ev.action) + '</span></td>' +
            '<td>' + esc(ev.target_username) + '</td>' +
            '<td class="muted">' + esc(ev.reason) + '</td>' +
            '</tr>';
        }).join('');
        feed.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:.82rem">' +
          '<thead><tr style="text-align:left">' +
          '<th>time</th><th>channel</th><th>action</th><th>user</th><th>reason</th>' +
          '</tr></thead><tbody>' + rows + '</tbody></table>';
      } catch (e) {
        feed.innerHTML = '<div class="muted">Failed to load activity.</div>';
      }
    }

    var mgrAddBtn = document.getElementById('mgr-add-btn');
    if (mgrAddBtn) {
      mgrAddBtn.addEventListener('click', async function () {
        var inp = document.getElementById('mgr-add-user');
        var val = inp ? inp.value.trim() : '';
        if (!val) return;
        mgrAddBtn.disabled = true;
        try {
          await KickDash.post('/kick/api/managers', { user: val, action: 'add' });
          if (inp) inp.value = '';
          loadManagers();
        } catch (e) {
          alert('Failed to add manager.');
        } finally {
          mgrAddBtn.disabled = false;
        }
      });
    }

    var netRefresh = document.getElementById('net-refresh');
    if (netRefresh) netRefresh.addEventListener('click', loadNetFeed);

    try { loadManagers(); } catch (e) {}
    try { loadNetFeed(); } catch (e) {}
  </script>`; %>
<%- include('_foot', { extraJs: pageJs }) %>
