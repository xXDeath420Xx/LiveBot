<%- include('_head', { pageTitle: 'Connected Accounts', csrfToken, kickUser: user }) %>

  <div class="pagehead">
    <div>
      <h1>🐻 Connected Accounts</h1>
      <div class="sub">Everyone connected to the network, their channels, permissions and token health.</div>
    </div>
    <nav class="subnav">
      <a href="/kick">Channels</a>
      <a href="/kick/managers">Manager console</a>
      <a href="/kick/admin" class="active">Connected accounts</a>
    </nav>
  </div>

  <!-- ── Overview stats ─────────────────────────────────────── -->
  <div class="statgrid">
    <div class="stat"><b><%= totals.accounts %></b><span>Connected accounts</span></div>
    <div class="stat kick"><b><%= totals.kick %></b><span>Kick accounts</span></div>
    <div class="stat"><b><%= totals.channels %></b><span>Channels</span></div>
    <div class="stat"><b><%= totals.enrolled %></b><span>Defender-enrolled</span></div>
  </div>

  <!-- ── Token-health callout (computed in-view) ─────────────── -->
  <% var expiredCount = accounts.filter(function(a){ return a.tokenExpired; }).length; %>
  <% if (expiredCount > 0) { %>
    <div class="banner">
      ⚠ <%= expiredCount %> account<%= expiredCount === 1 ? '' : 's' %> ha<%= expiredCount === 1 ? 's' : 've' %> expired tokens — those users must re-authorize with Kick to keep protection active.
    </div>
  <% } %>

  <input id="search" class="search" placeholder="Filter by username…" style="width:100%;margin:1.1rem 0" />

  <% if (!accounts.length) { %>
    <div class="card">
      <div class="empty">No connected accounts yet.</div>
    </div>
  <% } %>

  <% accounts.forEach(function(a){ %>
    <div class="card acct" data-name="<%= (a.platformName || a.primaryName || '').toLowerCase() %>">
      <div class="row">
        <div style="display:flex;align-items:center;gap:.8rem">
          <img src="<%= a.avatar || '/images/CertiFried.png' %>" alt="" onerror="this.src='/images/CertiFried.png'" style="width:42px;height:42px;border-radius:50%;object-fit:cover;background:#14121d" />
          <div>
            <div style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1.1rem"><%= a.platformName || a.primaryName || 'Unknown' %></div>
            <div class="muted" style="margin-top:.2rem">
              user #<%= a.userId %><% if (a.lastSeen) { %> · last seen <%= new Date(a.lastSeen).toISOString().slice(0,16).replace('T',' ') %> UTC<% } %>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
          <span class="pill off"><%= a.platform %></span>
          <% if (a.isAdmin) { %><span class="pill ok">admin</span><% } %>
          <% if (a.isManager && !a.isAdmin) { %><span class="pill warn">manager</span><% } %>
          <% if (a.isBotAccount) { %><span class="pill off">bot account</span><% } %>
          <% if (a.isBanned) { %><span class="pill bad">banned</span><% } %>
          <% if (a.platform === 'kick') { %>
            <span class="pill <%= a.hasBanScope ? 'ok' : 'warn' %>"><%= a.hasBanScope ? 'can ban' : 'no ban scope' %></span>
          <% } %>
          <% if (a.tokenExpired) { %><span class="pill bad">token expired</span><% } %>
        </div>
      </div>

      <% if (a.tokenExpired) { %>
        <div class="banner">⚠ This account's Kick token has expired — protection is paused until they re-authorize.</div>
      <% } %>

      <% if (!a.channels.length) { %>
        <div class="muted" style="margin-top:.8rem">No channels registered.</div>
      <% } else { %>
        <ul class="clean" style="margin-top:.8rem">
          <% a.channels.forEach(function(ch){ %>
            <li>
              <span style="font-weight:600"><%= ch.channelName %></span>
              <span style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
                <% if (ch.stats) { %><span class="muted">banned <%= ch.stats.banned %> · deleted <%= ch.stats.deleted %> · dormant <%= ch.stats.dormant %></span><% } %>
                <span class="pill <%= ch.defenderEnabled ? 'ok' : 'off' %>"><%= ch.defenderEnabled ? 'defender ON' : 'defender off' %></span>
                <% if (!ch.enabled) { %><span class="pill off">disabled</span><% } %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <div class="muted" style="margin-top:.6rem;font-size:.72rem;word-break:break-word">
        scopes: <%= a.scopes && a.scopes.length ? a.scopes.join('  ') : '(none granted)' %>
      </div>
    </div>
  <% }) %>

<% var pageJs = `
  <script>
    // Client-side filter — no requests, purely cosmetic.
    var search = document.getElementById('search');
    if (search) {
      search.addEventListener('input', function () {
        var q = search.value.trim().toLowerCase();
        document.querySelectorAll('.acct').forEach(function (el) {
          el.style.display = !q || (el.dataset.name || '').includes(q) ? '' : 'none';
        });
      });
    }
  </script>`; %>
<%- include('_foot', { extraJs: pageJs }) %>
