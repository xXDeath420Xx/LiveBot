<%#
  Kick Defender pages (/kick, dashboard/routes/kick-defender.js and kick-channel.js): the shared site frame
  (partials/site-head, site-header, site-footer via _foot.ejs) plus the Kick Defender bar under the site header.
  Kick sign-in is separate from the Discord login, so the Kick account (or "Sign in with Kick") sits in that bar.
  Locals: pageTitle, kickUser, csrfToken, kickTab ('channels'|'features'|'managers'|'admin', the current bar tab),
  isManager / isAdmin (show those tabs), extraCss (page CSS, trusted).
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' · ' : '') + 'Kick Defender · CertiFried', description: 'Kick Defender: a shared banlist, scam-link protection, automod and chat tools for Kick channels, run from the CertiFried dashboard.', noindex: true }) %>
  <script src="/js/kick-dashboard.js"></script>
  <link rel="stylesheet" href="/css/channel-bot.css">
  <link rel="stylesheet" href="/css/cf-settings.css">
  <style>
    /* Kick Defender pages: cf-ui.css (tokens, buttons, inputs), cf-site.css (the site frame) and cf-settings.css
       (sections, rows, KPIs, notices) carry the look. Only Kick's own mark (the green square, the current-tab
       underline and the chart's "banned" series) uses Kick green; everything else is the site palette. */
    :root { --kick: #53fc18; }
    /* Light/Sand: neon Kick green vanishes on a light surface (chart bars, tab underline); a deeper Kick green keeps 3:1. */
    :root:is([data-theme="light"], [data-theme="sand"]) { --kick: #2b8a0a; }
    .kick-main { max-width: 64rem; padding-top: var(--cf-8); padding-bottom: var(--cf-12); min-width: 0; }

    /* Kick Defender bar (same shape as partials/section-tabs.ejs) with the Kick account on the right */
    .kick-bar { border-bottom: 1px solid var(--cf-border); background: var(--cf-bg); }
    .kick-bar-inner { max-width: 1200px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; gap: 2px; min-height: 42px; }
    .kick-bar-name { display: inline-flex; align-items: center; gap: 8px; margin-right: 10px; font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text); text-decoration: none; white-space: nowrap; }
    .kick-bar-name::before { content: ''; width: 10px; height: 10px; border-radius: 2px; background: var(--kick); flex: none; }
    .kick-bar-tabs { display: flex; align-items: center; gap: 2px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
    .kick-bar-tabs::-webkit-scrollbar { display: none; }
    .kick-bar-tabs a { display: inline-flex; align-items: center; height: 42px; padding: 0 10px; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-2); text-decoration: none; white-space: nowrap; box-shadow: inset 0 -2px 0 transparent; }
    .kick-bar-tabs a:hover { color: var(--cf-text); }
    .kick-bar-tabs a[aria-current="page"] { color: var(--cf-text); box-shadow: inset 0 -2px 0 var(--kick); }
    .kick-bar-account { margin-left: auto; padding-left: 12px; display: flex; align-items: center; gap: var(--cf-2); flex: none; }
    .kick-account { display: inline-flex; align-items: center; gap: 8px; font-size: var(--cf-text-sm); color: var(--cf-text-2); max-width: 12rem; }
    .kick-account span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .kick-account img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; flex: none; background: var(--cf-surface-2); }
    @media (max-width: 640px) {
      .kick-bar-inner { padding: 0 12px; flex-wrap: wrap; }
      .kick-bar-name { display: none; }
      .kick-bar-tabs { order: 2; flex: 1 0 100%; }
      .kick-bar-account { order: 1; margin-left: 0; padding: 6px 0 0; flex: 1 0 100%; justify-content: space-between; }
    }

    /* Page head: product mark, title, in-page tabs */
    .kick-eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 6px;
      font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-2); }
    .kick-eyebrow::before { content: ''; width: 10px; height: 10px; border-radius: 2px; background: var(--kick); flex: none; }
    .pagehead { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--cf-3) var(--cf-4); flex-wrap: wrap; margin: 0 0 var(--cf-4); }
    .pagehead > div:first-child { min-width: 0; flex: 1 1 20rem; }
    .pagehead h1 { margin: 0; font-size: var(--cf-text-2xl); font-weight: 600; line-height: 1.2; overflow-wrap: anywhere; }
    .pagehead .sub { margin: 4px 0 0; color: var(--cf-text-3); font-size: var(--cf-text-md); max-width: 70ch; }
    .pagehead-actions { display: flex; gap: var(--cf-2); flex-wrap: wrap; }
    .kick-tabs { display: flex; gap: var(--cf-1); flex-wrap: wrap; margin: 0 0 var(--cf-8); border-bottom: 1px solid var(--cf-border); }
    .kick-tabs a { padding: 8px 10px; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-2); text-decoration: none; border-radius: var(--cf-radius) var(--cf-radius) 0 0; }
    .kick-tabs a:hover { color: var(--cf-text); background: var(--cf-surface-2); }
    .kick-tabs a[aria-current="page"] { color: var(--cf-text); box-shadow: inset 0 -2px 0 var(--kick); }

    /* Small pieces the kit does not have */
    .kick-title-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: var(--cf-text-lg); font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
    .kick-panel-stack > .cf-rows + .cf-rows { margin-top: var(--cf-4); }
    .kick-log { width: 100%; border-collapse: collapse; font-size: var(--cf-text-sm); }
    .kick-log th { text-align: left; font-weight: 500; font-size: var(--cf-text-xs); color: var(--cf-text-3); padding: 6px 10px; border-bottom: 1px solid var(--cf-border); white-space: nowrap; }
    .kick-log td { padding: 6px 10px; border-bottom: 1px solid var(--cf-border); vertical-align: top; overflow-wrap: anywhere; }
    .kick-log tr:last-child td { border-bottom: 0; }
    .kick-log td.nowrap { white-space: nowrap; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    .kick-scroll { overflow-x: auto; max-width: 100%; -webkit-overflow-scrolling: touch; }
    .kick-chart svg { display: block; width: 100%; height: auto; }
    .kick-chart .axis { stroke: var(--cf-border); stroke-width: 1; }
    .kick-chart .lbl { fill: var(--cf-text-3); font-size: 9px; font-family: var(--cf-font); }
    .kick-chart .b-banned { fill: var(--kick); }
    .kick-chart .b-removed { fill: var(--cf-info); }
    .kick-chart .b-detected { fill: var(--cf-border-strong); }
    .kick-chart .b-chat { fill: var(--cf-accent); }
    .kick-legend { display: flex; gap: var(--cf-4); flex-wrap: wrap; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .kick-legend span { display: inline-flex; align-items: center; gap: 6px; }
    .kick-legend i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
    .kick-sw-banned { background: var(--kick); }
    .kick-sw-removed { background: var(--cf-info); }
    .kick-sw-detected { background: var(--cf-border-strong); }
    .kick-sw-chat { background: var(--cf-accent); }
    .cf-rows .cf-row-control .kick-inline { display: flex; gap: var(--cf-2); align-items: center; flex-wrap: wrap; }
    .cf-rows .cf-row-control .kick-inline > input[type="number"] { width: 7rem; }
    .cf-rows .cf-row-control .kick-inline > .cf-input-unit { width: 9rem; }
    .cf-rows .cf-row-control.kick-end { align-items: flex-end; }
    .kick-acct-head { display: flex; align-items: center; gap: var(--cf-3); }
    .kick-acct-head img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex: none; background: var(--cf-surface-2); }
    .kick-scopes { font-size: var(--cf-text-xs); overflow-wrap: anywhere; }
    @media (max-width: 640px) {
      .kick-main { padding-left: var(--cf-4); padding-right: var(--cf-4); }
      .kick-search { max-width: none; }
    }
    <%- typeof extraCss !== 'undefined' ? extraCss : '' %>
  </style>
</head>
<body class="cfs-body">
<% var _ku = (typeof kickUser !== 'undefined' && kickUser) ? kickUser : null; %>
<%- include('partials/site-header', { active: '', user: null, returnTo: locals.sitePath || '/kick' }) %>
<nav class="kick-bar" aria-label="Kick Defender">
  <div class="kick-bar-inner">
    <a class="kick-bar-name" href="/kick">Kick Defender</a>
    <%- include('_tabs', { active: typeof kickTab !== 'undefined' ? kickTab : '', isManager: typeof isManager !== 'undefined' && isManager, isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>
    <div class="kick-bar-account">
      <% if (_ku) { %>
        <span class="kick-account" title="Signed in with Kick">
          <% if (_ku.avatar) { %><img src="<%= _ku.avatar %>" alt="" onerror="this.remove()"><% } %>
          <span><%= _ku.name || 'Kick account' %></span>
        </span>
        <a href="/tokes-bot/auth/logout" class="btn btn-secondary btn-sm">Sign out of Kick</a>
      <% } else { %>
        <a href="/tokes-bot/auth/kick" class="btn btn-primary btn-sm">Sign in with Kick</a>
      <% } %>
    </div>
  </div>
</nav>

<main id="main-content" class="cfs-main kick-main page-content" tabindex="-1">
