<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: 'Stream team signup · CertiFried', description: 'Apply to join the Against_The_Tide Twitch stream team. Your application opens a private Discord ticket that the server owner reviews.', path: '/stream-team', noindex: true }) %>
    <script src="/js/csrf.js"></script>
    <style>
        .st-panel { padding: var(--cf-5); margin-bottom: var(--cf-4); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .st-panel > h2 { margin: 0 0 var(--cf-2); font-size: var(--cf-text-lg); font-weight: 600; }
        .st-panel .muted { margin: 0 0 var(--cf-4); font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); }
        .st-panel .muted:last-child { margin-bottom: 0; }
        .st-state { display: flex; align-items: center; gap: var(--cf-2); margin: 0 0 var(--cf-2); font-weight: 600; }
        .field { margin-bottom: var(--cf-4); }
        .field-label { display: block; margin-bottom: 6px; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text); }
        .field .form-input, .field .form-select, .field .form-textarea { width: 100%; min-height: 40px; }
        .field .form-textarea { min-height: 110px; resize: vertical; }
        .st-actions { display: flex; align-items: center; gap: var(--cf-3); flex-wrap: wrap; }
        .status-msg { font-size: var(--cf-text-sm); }
        .status-msg.ok { color: var(--cf-success); }
        .status-msg.err { color: var(--cf-danger); }
        .status-msg.info { color: var(--cf-text-3); }
        .note { margin: var(--cf-3) 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .st-honeypot { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; overflow: hidden; }
        .hidden { display: none !important; }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', user: locals.user || null, returnTo: '/stream-team' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main cfs-main--narrow">
        <div class="cfs-pagehead">
            <h1>Stream team signup</h1>
            <p class="cfs-lede">Apply to join the Against_The_Tide Twitch team. You only need a Twitch channel. If you are in our Discord server, log in first and you can chat with the owner in your ticket.</p>
        </div>

        <div class="cfs-note">
            <p>Each application opens a private ticket channel in the team's Discord server that other members cannot see. If you log in with Discord and are a member of the server, you are added to the ticket too.</p>
        </div>

        <div id="loading" class="st-panel" role="status"><p class="muted">Loading the form…</p></div>

        <div id="unavailable" class="st-panel hidden">
            <p class="st-state"><span class="cfs-dot" aria-hidden="true"></span>The signup form is closed right now.</p>
            <p class="muted">Check back later.</p>
        </div>

        <div id="already" class="st-panel hidden" role="status">
            <p class="st-state"><span class="cfs-dot cfs-dot--ok" aria-hidden="true"></span><span>You already have an open application.</span></p>
            <p class="muted">Continue in your private ticket in the Discord server. You can have one open application at a time.</p>
        </div>

        <section id="form-card" class="st-panel hidden" aria-labelledby="st-form-h">
            <h2 id="st-form-h">Tell us about your stream</h2>
            <p class="muted">Answer every question that is not marked optional. We check that your Twitch channel exists before the application is sent.</p>
            <div id="fields"></div>

            <div class="field" id="discord-field">
                <label class="field-label" for="discord_username">Your Discord username (optional)</label>
                <input type="text" class="form-input" id="discord_username" autocomplete="off">
            </div>

            <!-- Spam trap: hidden from people, filled in by bots. -->
            <div class="st-honeypot" aria-hidden="true">
                <label for="website">Website (leave blank)</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="st-actions">
                <button id="submit-btn" class="btn btn-primary" type="button">Send application</button>
                <span id="status-msg" class="status-msg" role="status" aria-live="polite"></span>
            </div>
            <p class="note">Sending opens a private ticket that the server owner reviews.</p>
        </section>

        <section class="st-panel" aria-labelledby="st-team-h">
            <h2 id="st-team-h">About the team</h2>
            <p class="muted">Against_The_Tide is a Twitch team. See who is on it:</p>
            <a href="https://www.twitch.tv/team/against_the_tide" target="_blank" rel="noopener" class="btn btn-secondary">Against_The_Tide on Twitch</a>
        </section>
    </main>

<%- include('partials/site-footer') %>

    <script>
    (function () {
        const base = '/api/public/stream-team';
        let questions = [];
        let loggedIn = false;

        function show(id) { document.getElementById(id).classList.remove('hidden'); }
        function hide(id) { document.getElementById(id).classList.add('hidden'); }
        function setMsg(msg, kind) {
            const s = document.getElementById('status-msg');
            if (!s) return;
            s.textContent = msg || '';
            s.className = 'status-msg ' + (kind === 'err' ? 'err' : kind === 'ok' ? 'ok' : 'info');
        }

        function renderFields(qs) {
            const wrap = document.getElementById('fields');
            wrap.textContent = '';
            for (const q of qs) {
                const field = document.createElement('div');
                field.className = 'field';

                const label = document.createElement('label');
                label.className = 'field-label';
                label.setAttribute('for', 'q-' + q.question_id);
                label.textContent = q.question_text + (q.is_required ? '' : ' (optional)');
                field.appendChild(label);

                // Mirror the answer formats the form was built with. The member/role/channel
                // pickers have no meaning outside Discord, so they degrade to a text box here.
                let inputEl;
                const choices = Array.isArray(q.question_options) ? q.question_options : [];
                if (choices.length && (q.question_type === 'select' || q.question_type === 'multiselect')) {
                    inputEl = document.createElement('select');
                    if (q.question_type === 'multiselect') {
                        inputEl.multiple = true;
                        inputEl.size = Math.min(choices.length, 6);
                    } else if (!q.is_required) {
                        inputEl.appendChild(new Option('No answer', ''));
                    }
                    for (const choice of choices) inputEl.appendChild(new Option(choice, choice));
                } else if (q.question_type === 'paragraph') {
                    inputEl = document.createElement('textarea');
                } else {
                    inputEl = document.createElement('input');
                    inputEl.type = q.question_type === 'number' ? 'number' : 'text';
                }
                inputEl.className = inputEl.tagName === 'SELECT' ? 'form-select' : inputEl.tagName === 'TEXTAREA' ? 'form-textarea' : 'form-input';
                inputEl.id = 'q-' + q.question_id;
                inputEl.dataset.qid = q.question_id;
                inputEl.dataset.qtype = q.question_type;
                field.appendChild(inputEl);

                wrap.appendChild(field);
            }
        }

        async function load() {
            try {
                const data = await fetch(base + '/panel', { headers: { Accept: 'application/json' } }).then(r => r.json());
                hide('loading');
                loggedIn = !!data.loggedIn;
                if (!data.exists) { show('unavailable'); return; }
                questions = data.questions || [];
                renderFields(questions);
                show('form-card');
            } catch (e) {
                hide('loading');
                show('unavailable');
            }
        }

        document.addEventListener('click', async (ev) => {
            if (ev.target && ev.target.id === 'submit-btn') {
                const btn = ev.target;
                const answers = {};
                for (const q of questions) {
                    const inp = document.getElementById('q-' + q.question_id);
                    // A multi-select answers with a list; everything else with one trimmed string.
                    const value = (inp && inp.multiple)
                        ? Array.from(inp.selectedOptions).map(o => o.value).filter(Boolean)
                        : ((inp && inp.value) || '').trim();
                    answers[q.question_id] = value;
                    const blank = Array.isArray(value) ? value.length === 0 : !value;
                    if (blank && q.is_required) {
                        setMsg('Answer this question: ' + q.question_text, 'err');
                        if (inp) inp.focus();
                        return;
                    }
                }
                const discordEl = document.getElementById('discord_username');
                const honeypotEl = document.getElementById('website');
                btn.disabled = true;
                setMsg('Sending…', 'info');
                try {
                    const r = await fetch(base + '/apply', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            answers,
                            discord_username: (discordEl && discordEl.value || '').trim(),
                            website: (honeypotEl && honeypotEl.value || '')
                        })
                    }).then(x => x.json());
                    if (r.ok) {
                        hide('form-card');
                        const box = document.querySelector('#already .st-state span:last-child');
                        const note = document.querySelector('#already .muted');
                        if (r.linked) {
                            if (box) box.textContent = 'Application sent.';
                            if (note) note.textContent = 'A private ticket is open in the Discord server: chat with the owner there. You can have one open application at a time.';
                        } else {
                            if (box) box.textContent = 'Application received.';
                            if (note) note.textContent = 'The server owner will review it. You applied without logging in, so they will contact you through the details you gave.';
                        }
                        show('already');
                    } else {
                        setMsg(r.error || 'Could not send your application.', 'err');
                        btn.disabled = false;
                    }
                } catch (e) {
                    setMsg('Could not reach the server. Try again in a minute.', 'err');
                    btn.disabled = false;
                }
            }
        });

        load();
    }());
    </script>
</body>
</html>
