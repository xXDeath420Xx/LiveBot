                <input type="number" name="duration" min="15" max="1800" value="60" placeholder="Duration (seconds)" style="padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
