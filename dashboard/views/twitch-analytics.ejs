            </form>

            <h3 style="font-size: 0.75rem; margin: 1rem 0 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em;">Issue warning</h3>
            <form method="POST" action="/manage/<%= guildId %>/twitch-controls/warn?range=<%= range %>" style="display: flex; flex-direction: column; gap: 0.3rem;">
                <input type="text" name="target_login" placeholder="Username" required style="padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                <input type="text" name="reason" placeholder="Reason for warning" required maxlength="500" style="padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                <button type="submit" class="backfill-btn" style="color: var(--cf-warning-ink); border-color: color-mix(in srgb, var(--warn) 40%, transparent); align-self: flex-start;"><i class="fas fa-exclamation-triangle"></i> Warn</button>
            </form>
        </div>

        <!-- Roles manager — add/remove VIPs + Mods via Helix -->
        <div class="card accent-moderation" id="ta-roles-manager">
            <h3>Roles manager</h3>
            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                <div style="display: flex; gap: 0.4rem; align-items: center;">
                    <input type="text" id="ta-roles-vip-input" placeholder="Twitch username" autocomplete="off" style="flex: 1; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                    <button type="button" class="backfill-btn" style="color: var(--cf-warning-ink); border-color: color-mix(in srgb, var(--cf-warning) 40%, transparent);" onclick="taRolesGrant('vip')"><i class="fas fa-crown"></i> Add VIP</button>
                </div>
                <div style="display: flex; gap: 0.4rem; align-items: center;">
                    <input type="text" id="ta-roles-mod-input" placeholder="Twitch username" autocomplete="off" style="flex: 1; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                    <button type="button" class="backfill-btn" style="color: var(--cf-info-ink); border-color: color-mix(in srgb, var(--cf-info) 40%, transparent);" onclick="taRolesGrant('mod')"><i class="fas fa-shield-alt"></i> Add Mod</button>
                </div>
                <div id="ta-roles-status" style="font-size: 0.72rem; color: var(--muted); min-height: 1em;"></div>
                <div style="margin-top: 0.4rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border);">
                    <div style="font-size: 0.72rem; color: var(--muted); margin-bottom: 0.3rem;">Current (<span id="ta-roles-count">loading…</span>) — <a href="#" onclick="taRolesLoad();return false;" style="color: var(--accent);">refresh</a></div>
                    <div id="ta-roles-list" style="max-height: 220px; overflow-y: auto; font-size: 0.78rem;"></div>
                </div>
            </div>
        </div>
    </div>
    <script>
        /* Roles manager — fetch current mods/VIPs, support add/remove via POST.
           DOM built with createElement/textContent (no innerHTML) for XSS hygiene. */
        const TA_ROLES_GUILD = '<%= guildId %>';
        function taRolesEl(tag, props) {
            const e = document.createElement(tag);
            if (props) {
                for (const k of Object.keys(props)) {
                    if (k === 'style') e.style.cssText = props[k];
                    else if (k === 'text') e.textContent = props[k];
                    else if (k === 'onClick') e.addEventListener('click', props[k]);
                    else e.setAttribute(k, props[k]);
                }
            }
            return e;
        }
        function taRolesSetPlaceholder(list, text, color) {
            list.replaceChildren();
            list.appendChild(taRolesEl('div', { style: 'color:' + (color || 'var(--muted)') + '; padding:0.5rem 0;', text }));
        }
        async function taRolesLoad() {
            const list = document.getElementById('ta-roles-list');
            const count = document.getElementById('ta-roles-count');
            if (!list || !count) return;
            taRolesSetPlaceholder(list, 'Loading…');
            try {
                const r = await fetch('/manage/' + TA_ROLES_GUILD + '/twitch-role-sync/mods-vips', { headers: { 'Accept': 'application/json' } });
                const data = await r.json();
                if (data.error) { taRolesSetPlaceholder(list, String(data.error), 'var(--bad)'); count.textContent = '—'; return; }
                const all = [].concat(data.mods || [], data.vips || []);
                count.textContent = (data.counts && data.counts.mods_total || 0) + ' mods, ' + (data.counts && data.counts.vips_total || 0) + ' VIPs';
                if (!all.length) { taRolesSetPlaceholder(list, 'No mods or VIPs.'); return; }
                list.replaceChildren();
                for (const row of all) {
                    const r2 = taRolesEl('div', { style: 'display:flex; align-items:center; justify-content:space-between; padding:4px 2px; border-bottom:1px solid var(--cf-veil-1);' });
                    const label = taRolesEl('span');
                    const pill = taRolesEl('span', {
                        style: row.type === 'mod'
                            ? 'background:color-mix(in srgb, var(--cf-info) 18%, transparent); color:var(--cf-info-ink); padding:1px 6px; border-radius:3px; font-size:0.6rem; font-weight:600; margin-right:6px;'
                            : 'background:color-mix(in srgb, var(--cf-warning) 18%, transparent); color:var(--cf-warning-ink); padding:1px 6px; border-radius:3px; font-size:0.6rem; font-weight:600; margin-right:6px;',
                        text: String(row.type || '').toUpperCase(),
                    });
                    label.appendChild(pill);
                    label.appendChild(document.createTextNode(row.twitch_display_name || row.twitch_username || '?'));
                    const btn = taRolesEl('button', {
                        style: 'background:transparent; border:1px solid var(--panel-border); color:var(--muted); padding:2px 6px; border-radius:3px; cursor:pointer; font-size:0.7rem;',
                        title: 'Remove ' + String(row.type || '').toUpperCase() + ' from @' + (row.twitch_username || ''),
                        onClick: () => taRolesRevoke(row.type, row.twitch_user_id, row.twitch_username, btn),
                    });
                    btn.appendChild(taRolesEl('i', { class: 'fas fa-user-minus' }));
                    r2.append(label, btn);
                    list.appendChild(r2);
                }
            } catch (e) {
                taRolesSetPlaceholder(list, 'Fetch failed: ' + e.message, 'var(--bad)');
                count.textContent = '—';
            }
        }
        async function taRolesGrant(role) {
            const input = document.getElementById('ta-roles-' + role + '-input');
            const status = document.getElementById('ta-roles-status');
            const login = input && input.value && input.value.trim();
            if (!login) { status.textContent = 'Enter a Twitch username first.'; status.style.color = 'var(--cf-warning)'; return; }
            status.textContent = 'Working…'; status.style.color = 'var(--muted)';
            try {
                const r = await fetch('/manage/' + TA_ROLES_GUILD + '/twitch-roles/' + role + '/add', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ user_login: login }),
                });
                const data = await r.json().catch(() => ({ ok: false, error: 'parse_failed' }));
                if (data.ok) {
                    status.textContent = 'Added ' + ((data.user && data.user.display_name) || login) + ' as ' + role.toUpperCase() + '.';
                    status.style.color = 'var(--cf-success)';
                    input.value = '';
                    setTimeout(taRolesLoad, 400);
                } else {
                    let msg = data.error || 'failed';
                    if (data.scope_missing) msg = 'Scope missing: ' + data.scope_missing + ' — reauth broadcaster-write.';
                    status.textContent = msg; status.style.color = 'var(--cf-danger)';
                }
            } catch (e) { status.textContent = e.message; status.style.color = 'var(--cf-danger)'; }
        }
        async function taRolesRevoke(role, userId, login, btn) {
            if (!confirm('Remove ' + role.toUpperCase() + ' from @' + login + '?')) return;
            btn.disabled = true;
            const status = document.getElementById('ta-roles-status');
            status.textContent = 'Revoking ' + role.toUpperCase() + ' from @' + login + '…'; status.style.color = 'var(--muted)';
            try {
                // Pass user_id directly — handles platform-banned users whose login no
                // longer resolves via /users.
                const r = await fetch('/manage/' + TA_ROLES_GUILD + '/twitch-roles/' + role + '/remove', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ user_id: userId, user_login: login }),
                });
                const data = await r.json().catch(() => ({ ok: false, error: 'parse_failed' }));
                if (data.ok) { status.textContent = 'Removed @' + login + '.'; status.style.color = 'var(--cf-success)'; setTimeout(taRolesLoad, 400); }
                else { status.textContent = 'Revoke failed: ' + (data.error || 'unknown') + (data.scope_missing ? ' (' + data.scope_missing + ' not granted)' : ''); status.style.color = 'var(--cf-danger)'; btn.disabled = false; }
            } catch (e) { status.textContent = 'Revoke failed: ' + e.message; status.style.color = 'var(--cf-danger)'; btn.disabled = false; }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', taRolesLoad);
        else taRolesLoad();
    </script>
    <% } %>
    </div><!-- /tab-pane live: STREAM CONTROLS — Tier B write actions --><% } %>

    <!-- ===== VIEWERSHIP ===== -->

    <div class="tab-pane" data-tab-group="audience">

    <div class="section viewership" id="viewership"><h2>Viewership</h2><div class="section-sub">How many watched, when, and for how long.</div></div>
    <div class="chart-card">
        <button class="export-btn" data-chart="viewerChart" title="Download PNG"><i class="fas fa-download"></i></button>
        <% if (!d.viewerTimeline.length) { %>
        <div class="empty">No live snapshots in this window.</div>
        <% } else { %>
        <canvas id="viewerChart" height="90"></canvas>
        <% } %>
    </div>

    <%
        // Historical peak-viewer trajectory from the session list — one point per session.
        // Independent of the viewer-timeline chart which is window-constrained to grainMinutes
        // buckets; this one plots growth over time, long-arc.
        const peakTrack = (d.sessions || []).slice().reverse().map(s => ({
            t: new Date(s.started_at).getTime(), peak: Number(s.peak_viewers) || 0,
        })).filter(p => p.peak > 0);
    %>
    <% if (peakTrack.length >= 2) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <button class="export-btn" data-chart="peakTrajectoryChart"><i class="fas fa-download"></i></button>
        <h3>Peak viewers per session (trajectory)</h3>
        <canvas id="peakTrajectoryChart" height="70"></canvas>
    </div>
    <% } %>

    <div class="grid cols-2-3" style="margin-top: 0.75rem;">
        <div class="chart-card">
            <h3>Live hours by day/hour (UTC)</h3>
            <% if (peakHoursCell) { %>
            <div style="font-size: 0.825rem; margin-bottom: 0.6rem;">
                <i class="fas fa-fire" style="color: var(--good);"></i>
                Peak slot: <strong><%= peakHoursCell.dow %> <%= String(peakHoursCell.hour).padStart(2, '0') %>:00</strong>
                — <%= Math.round(peakHoursCell.minutes) %> min
            </div>
            <% } %>
            <% const maxCell = Math.max(1, ...d.hoursGrid.flat()); %>
            <div class="heatmap">
                <div class="hhead"></div>
                <% for (let hr = 0; hr < 24; hr++) { %><div class="hhead"><%= hr %></div><% } %>
                <% d.hoursGrid.forEach((row, i) => { %>
                <div class="hlabel"><%= dowLabels[i] %></div>
                <% row.forEach((v, hr) => {
                    const intensity = v > 0 ? 0.1 + 0.9 * (v / maxCell) : 0;
                    const isPeak = peakHoursCell && peakHoursCell.dow === dowLabels[i] && peakHoursCell.hour === hr;
                %>
                <div class="hcell <%= isPeak ? 'peak' : '' %>" style="--v: <%= intensity %>" title="<%= dowLabels[i] %> <%= hr %>:00 · <%= Math.round(v) %>min"></div>
                <% }) %>
                <% }) %>
            </div>
        </div>
        <div class="chart-card">
            <button class="export-btn" data-chart="chatVelocityChart"><i class="fas fa-download"></i></button>
            <h3>Chat velocity (msgs / 15min)</h3>
            <% if (!d.chatVelocity || !d.chatVelocity.length) { %>
            <div class="empty">No chat snapshots in this window.</div>
            <% } else { %>
            <canvas id="chatVelocityChart" height="90"></canvas>
            <% } %>
        </div>
    </div>

    </div><!-- /tab-pane audience: VIEWERSHIP -->

    <!-- ===== GROWTH ===== -->

    <div class="tab-pane" data-tab-group="audience">

    <div class="section growth" id="growth"><h2>Growth</h2><div class="section-sub">Follows, subs, and audience shape.</div></div>
    <div class="grid cols-2" style="margin-bottom: 0.75rem;">
        <div class="card"><h3>Subs per viewer-hour</h3><p class="big"><%= fmtRate(d.engagement.subs_per_viewer_hour, 3) %></p><p class="sub"><%= fmt(h.total_subs) %> subs over <%= fmt(Math.round(d.engagement.viewer_hours)) %> viewer-hours</p></div>
        <div class="card"><h3>Sub conversion</h3><p class="big"><%= fmtRate(d.engagement.sub_conversion_pct, 2) %>%</p><p class="sub">new subs as a share of new follows</p></div>
    </div>
    <div class="grid cols-2-3">
        <div class="chart-card">
            <button class="export-btn" data-chart="growthChart"><i class="fas fa-download"></i></button>
            <h3>Daily growth</h3>
            <% if (!d.dailyGrowth.length) { %>
            <div class="empty">No activity in this window.</div>
            <% } else { %>
            <canvas id="growthChart" height="140"></canvas>
            <% } %>
        </div>
        <div class="chart-card">
            <button class="export-btn" data-chart="dowRadarChart"><i class="fas fa-download"></i></button>
            <h3>Day-of-week performance</h3>
            <% if (!d.dowStats || !d.dowStats.some(x => x.sessions > 0)) { %>
            <div class="empty">Needs sessions in the window.</div>
            <% } else { %>
            <canvas id="dowRadarChart" height="140"></canvas>
            <% } %>
        </div>
    </div>

    <% if (d.followerAgeHistogram) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <button class="export-btn" data-chart="followerAgeChart"><i class="fas fa-download"></i></button>
        <h3>Follower account-age distribution (<%= fmt(d.followerAgeHistogram.total_sampled) %> sampled)</h3>
        <canvas id="followerAgeChart" height="80"></canvas>
    </div>
    <% } %>

    <%
        // Follower churn — nightly cron snapshots full follower list, this is the diff.
        const churnMap = {};
        for (const r of (d.churnBreakdown || [])) churnMap[r.change_type] = Number(r.n) || 0;
    %>
    <% if ((churnMap.add || 0) + (churnMap.remove || 0) > 0 || (d.churnEvents && d.churnEvents.length)) { %>
    <div class="grid cols-2" style="margin-top: 0.75rem;">
        <div class="card accent-growth">
            <h3>Follower churn (window)</h3>
            <div style="display: flex; gap: 1.5rem; margin-bottom: 0.75rem;">
                <div><div style="font-size: 0.7rem; color: var(--muted); text-transform: uppercase;">New follows</div><div style="font-size: 1.4rem; font-weight: 600; color: var(--good);">+<%= fmt(churnMap.add || 0) %></div></div>
                <div><div style="font-size: 0.7rem; color: var(--muted); text-transform: uppercase;">Unfollows</div><div style="font-size: 1.4rem; font-weight: 600; color: var(--bad);">-<%= fmt(churnMap.remove || 0) %></div></div>
                <div><div style="font-size: 0.7rem; color: var(--muted); text-transform: uppercase;">Net</div><div style="font-size: 1.4rem; font-weight: 600;"><%= (churnMap.add || 0) - (churnMap.remove || 0) >= 0 ? '+' : '' %><%= fmt((churnMap.add || 0) - (churnMap.remove || 0)) %></div></div>
            </div>
            <div style="font-size: 0.72rem; color: var(--muted);">From daily follower-snapshot diffs — see the live, individual churn events in the next card.</div>
        </div>
        <div class="card">
            <h3>Recent churn events</h3>
            <% if (!(d.churnEvents && d.churnEvents.length)) { %>
            <div class="empty">No churn events yet. Daily snapshot cron populates this each day at 05:00 UTC.</div>
            <% } %>
            <% (d.churnEvents || []).slice(0, 10).forEach(ev => { %>
            <div class="table-row">
                <div class="main">
                    <div class="title">
                        <% if (ev.change_type === 'add') { %><span style="color: var(--good);">+</span><% } else { %><span style="color: var(--bad);">-</span><% } %>
                        <%= ev.user_name || ev.user_login || (ev.change_type === 'remove' ? 'Deleted or suspended account' : ev.user_id) %>
                    </div>
                </div>
                <div class="side"><%= new Date(ev.observed_at).toLocaleString('en-US', TZO) %></div>
            </div>
            <% }) %>
        </div>
    </div>
    <% } %>

    <% if (d.clipDelta && d.clipDelta.length) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <h3>Clips gaining traction</h3>
        <% d.clipDelta.forEach(c => { %>
        <div class="table-row">
            <div class="main">
                <div class="title"><a href="<%= c.url %>" target="_blank" rel="noopener" style="color: var(--accent);"><%= (c.title || '(untitled)').slice(0, 60) %></a></div>
                <div class="meta"><%= fmt(c.current_views) %> views now · <%= Number(c.days_tracked) >= 1 ? 'tracked for ' + c.days_tracked + ' day' + (Number(c.days_tracked) === 1 ? '' : 's') : 'tracked since today' %></div>
            </div>
            <div class="side" style="color: var(--good); font-weight: 500;">+<%= fmt(c.delta_views) %></div>
        </div>
        <% }) %>
    </div>
    <% } %>

    </div><!-- /tab-pane audience: GROWTH -->


    <!-- ===== CONTENT ===== -->

    <div class="tab-pane" data-tab-group="content">

    <div class="section content" id="content"><h2>Content</h2><div class="section-sub">Categories, VODs, clips, title history.</div></div>
    <div class="grid cols-2" style="margin-bottom: 0.75rem;">
        <div class="card"><h3>Clips in window</h3><p class="big"><%= fmt(d.clipsMade.total) %></p><p class="sub">made by you and your viewers</p></div>
        <div class="card"><h3>Clips per live hour</h3><p class="big"><%= fmtRate(d.clipsMade.rate_per_hour_live, 2) %></p><p class="sub">how clippable your streams are</p></div>
    </div>
    <div class="grid cols-2">
        <div class="chart-card">
            <button class="export-btn" data-chart="topGamesChart"><i class="fas fa-download"></i></button>
            <h3>Top games (by live minutes)</h3>
            <% if (!d.topGames.length) { %>
            <div class="empty">No category data yet. Needs <code>channel.update</code> events.</div>
            <% } else { %>
            <canvas id="topGamesChart" height="140"></canvas>
            <% } %>
        </div>
        <div class="chart-card">
            <button class="export-btn" data-chart="topClipsChart"><i class="fas fa-download"></i></button>
            <h3>Top clips (by views, all-time)</h3>
            <% if (!d.topClips || !d.topClips.length) { %>
            <div class="empty">No clips in the catalog yet.</div>
            <% } else { %>
            <canvas id="topClipsChart" height="140"></canvas>
            <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--panel-border);">
                <% d.topClips.slice(0, 5).forEach(c => { %>
                <div class="table-row" style="padding: 0.4rem 0.25rem;">
                    <div class="main"><div class="title"><a href="<%= c.url %>" target="_blank" rel="noopener" style="color: var(--accent);"><%= (c.title || '(untitled)').slice(0, 60) %></a><% if (c.vod_id && c.vod_offset != null) { %><a href="https://www.twitch.tv/videos/<%= c.vod_id %>?t=<%= Math.floor(c.vod_offset) %>s" target="_blank" rel="noopener" class="vod-link" title="Open the exact VOD moment">· VOD moment ↗</a><% } %></div><div class="meta"><%= c.creator_name || '' %> · <%= c.game_name || '' %></div></div>
                    <div class="side"><%= fmt(c.view_count) %> views <button type="button" onclick="aiVisionAnalyze('<%= c.clip_id %>')" style="background: transparent; border: 0; color: var(--accent); cursor: pointer; font-size: 0.72rem; margin-left: 0.3rem;" title="AI vision analysis"><i class="fas fa-eye"></i></button></div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </div>

    <% if (d.topClips && d.topClips.length) { %>
    <!-- Clip search: POST /manage/:guildId/twitch-ai/semantic-clip-search (matches by meaning of the title, not exact words) -->
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Search clips</h3>
        <form id="clipSearchForm" style="display: flex; gap: 0.4rem; margin-bottom: 0.5rem;">
            <input type="text" id="clipSearchQuery" maxlength="300" aria-label="Describe the clip you are looking for" placeholder="describe a moment, e.g. rage quit or funny fail" style="flex: 1; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
            <button type="submit" class="backfill-btn" id="clipSearchBtn"><i class="fas fa-magnifying-glass"></i> Search</button>
        </form>
        <div id="clipSearchResults" role="status" aria-live="polite" style="font-size: 0.82rem; color: var(--muted);">Finds clips whose titles mean something close to what you type, even without the same words. The first search indexes clip titles, so it can take a little longer.</div>
    </div>
    <% } %>

    <% if (d.topVods && d.topVods.length) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <h3>Top VODs</h3>
        <% d.topVods.slice(0, 10).forEach(v => { %>
        <div class="thumb-row">
            <img src="<%= v.thumbnail_url || '' %>" alt="" loading="lazy">
            <div class="main">
                <div class="title"><a href="<%= v.url %>" target="_blank" rel="noopener" style="color: var(--accent);"><%= v.title || '(untitled)' %></a></div>
                <div class="meta">
                    <%= v.type %> · <%= Math.floor((v.duration_seconds || 0) / 3600) %>h <%= Math.floor(((v.duration_seconds || 0) % 3600) / 60) %>m
                    <% if (v.category_name) { %> · <%= v.category_name %><% } %>
                    · <%= new Date(v.created_at_twitch).toLocaleDateString('en-US', TZO) %>
                </div>
            </div>
            <div class="side">
                <%= fmt(v.view_count) %> views
                <% if (v.duration_seconds && v.duration_seconds <= 4 * 3600) { %>
                <button type="button" onclick="aiTranscribeVod('<%= v.video_id %>')" class="backfill-btn" style="font-size: 0.7rem; padding: 0.2rem 0.4rem; margin-left: 0.3rem;" title="Transcribe via local whisper"><i class="fas fa-closed-captioning"></i></button>
                <% } %>
            </div>
        </div>
        <% }) %>
    </div>

    <!-- Transcript search -->
    <div class="card" style="margin-top: 0.75rem; border-left: 3px solid var(--cyan);">
        <h3>Transcript search</h3>
        <form id="transcriptSearchForm" style="display: flex; gap: 0.4rem; margin-bottom: 0.5rem;">
            <input type="text" id="transcriptQuery" placeholder="search what you said in past streams" style="flex: 1; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
            <button type="submit" class="backfill-btn"><i class="fas fa-magnifying-glass"></i> Search</button>
        </form>
        <div id="transcriptResults" style="font-size: 0.82rem; color: var(--muted);">Transcribe a VOD first (click the CC icon on any VOD above), then search what was said.</div>
    </div>
    <% } %>

    <!-- AI category pivot analysis -->
    <div class="card" style="margin-top: 0.75rem; border-left: 3px solid var(--accent);">
        <h3 style="font-size: 0.75rem; margin: 0 0 0.5rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center;">
            <span>AI category pivot analysis</span>
            <button type="button" id="pivotBtn" class="backfill-btn" style="color: var(--accent); border-color: var(--cf-accent-line); font-size: 0.7rem; padding: 0.2rem 0.5rem;" onclick="aiAnalyzePivots()">Analyze</button>
        </h3>
        <div id="pivotOut" style="font-size: 0.825rem; color: var(--muted);">See which category transitions help or hurt viewer count across your streams.</div>
    </div>

    <div class="card" style="margin-top: 0.75rem;">
        <h3>Title / category changes</h3>
        <% if (!d.categoryHistory.length) { %>
        <div class="empty">None in window.</div>
        <% } else { %>
        <% d.categoryHistory.slice(0, 15).forEach(c => {
            const game = c.category_id ? gamesCache[c.category_id] : null;
        %>
        <div class="table-row">
            <% if (game && game.box_art_url) { %><img class="game-art" src="<%= game.box_art_url %>" alt="" loading="lazy"><% } %>
            <div class="main">
                <div class="title"><%= c.title || '(no title)' %></div>
                <div class="meta"><%= c.category_name || '(no category)' %><% if (c.language) { %> · <%= c.language %><% } %></div>
            </div>
            <div class="side"><%= new Date(c.changed_at).toLocaleString('en-US', TZO) %></div>
        </div>
        <% }) %>
        <% } %>
    </div>

    </div><!-- /tab-pane content: CONTENT -->

    <!-- ===== STREAM MARKERS (wave 383) ===== -->
    <div class="tab-pane" data-tab-group="content">
    <div class="section content" id="markers"><h2>Stream markers</h2><div class="section-sub">Moments you or your mods marked during a stream. Each one opens the VOD at that point.</div></div>
    <div class="card">
        <% const mk = (d.capture || {}).markers || []; %>
        <% if (!mk.length) { %><div class="empty">No markers in this window. Markers come from the write permission and refresh hourly.</div><% } %>
        <% mk.forEach(m => {
            const sec = Number(m.position_seconds) || 0;
            const t = Math.floor(sec / 3600) + 'h' + Math.floor((sec % 3600) / 60) + 'm' + (sec % 60) + 's';
            const vid = /^[0-9]+$/.test(String(m.video_id || '')) ? String(m.video_id) : null; %>
        <div class="table-row"><div class="main"><div class="title"><%= m.description || 'Untitled marker' %></div>
            <div class="meta"><%= t.replace(/^0h/, '') %> into the stream · <%= relAgo(m.created_at_twitch) %></div></div>
            <div class="side"><% if (vid) { %><a href="https://www.twitch.tv/videos/<%= vid %>?t=<%= t %>" target="_blank" rel="noopener" style="color: var(--accent);">Open VOD</a><% } %></div></div>
        <% }) %>
    </div>
    </div><!-- /tab-pane content: STREAM MARKERS -->

    <!-- ===== MONETIZATION ===== -->

    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">

    <div class="section monetize" id="monetization"><h2>Monetization</h2><div class="section-sub">Subs, bits, ads, charity, rewards.</div></div>
    <div class="grid cols-4">
        <div class="card accent-monetize">
            <h3>Sub churn</h3>
            <p class="big"><span style="color: var(--good);">+<%= d.churn.new_subs %></span> / <span style="color: var(--bad);">-<%= d.churn.ended_subs %></span></p>
            <p class="sub">Net <%= d.churn.net >= 0 ? '+' : '' %><%= d.churn.net %></p>
        </div>
        <div class="card accent-monetize">
            <h3>Ads</h3>
            <% if (adSchedule) { %>
            <p class="big"><%= adSchedule.snooze_count || 0 %></p>
            <p class="sub">snoozes · next <%= adSchedule.next_ad_at ? relAgo(adSchedule.next_ad_at).replace('ago', 'from now') : '—' %></p>
            <% } else { %>
            <p class="big"><%= fmt(d.adBreaksSummary.n) %></p>
            <p class="sub">breaks · <%= Math.round(Number(d.adBreaksSummary.s) / 60) %>m</p>
            <% } %>
        </div>
        <div class="card accent-monetize">
            <h3>Charity raised</h3>
            <p class="big">$<%= Math.round(Number(d.charitySummary.raised) / 100).toLocaleString('en-US', TZO) %></p>
            <p class="sub"><%= d.charitySummary.campaigns %> campaign<%= Number(d.charitySummary.campaigns) === 1 ? '' : 's' %> · <%= d.charitySummary.events %> donation<%= Number(d.charitySummary.events) === 1 ? '' : 's' %></p>
        </div>
        <div class="card accent-monetize">
            <h3>Resub messages</h3>
            <p class="big"><%= fmt(d.resubs.length) %></p>
            <p class="sub">in window</p>
        </div>
    </div>

    <% if (charity) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <h3>Active charity campaign</h3>
        <div class="progress-row">
            <div class="label"><span><%= charity.charity_name %></span><span class="val"><%= money(charity.current_amount) %> / <%= money(charity.target_amount) %></span></div>
            <div class="progress-bar pink"><div class="fill" style="width: <%= Math.min(100, (100 * (charity.current_amount?.value || 0) / Math.max(1, charity.target_amount?.value || 1))).toFixed(1) %>%"></div></div>
        </div>
    </div>
    <% } %>

    <% if (d.subTierBreakdown) { const stb = d.subTierBreakdown; %>
    <div class="grid cols-2-3" style="margin-top: 0.75rem;">
        <div class="chart-card">
            <button class="export-btn" data-chart="subTierDoughnut"><i class="fas fa-download"></i></button>
            <h3>Subscriber tier mix (<%= fmt(stb.total_count) %> total)</h3>
            <canvas id="subTierDoughnut" height="140"></canvas>
        </div>
        <% const topGifters = stb.top_gifters || []; %>
        <div class="card">
            <h3>Top gifters</h3>
            <% if (!topGifters.length) { %><div class="empty">No gifters tracked yet.</div><% } %>
            <% topGifters.slice(0, 10).forEach(g => { %>
            <div class="table-row"><div class="main"><div class="title"><%= g.name || g.login %></div></div><div class="side"><%= g.count %> gifted</div></div>
            <% }) %>
        </div>
    </div>
    <% } %>

    <% if (d.bitsLeaderboard && d.bitsLeaderboard.length) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <button class="export-btn" data-chart="bitsLeaderboardChart"><i class="fas fa-download"></i></button>
        <h3>Top bits contributors (all-time)</h3>
        <canvas id="bitsLeaderboardChart" height="140"></canvas>
    </div>
    <% } %>

    <% if (d.customRewards && d.customRewards.length) { %>
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Channel point rewards</h3>
        <% d.customRewards.forEach(r => { %>
        <div class="table-row">
            <div class="main">
                <div class="title">
                    <%= r.title %>
                    <% if (!r.is_enabled) { %><span class="pre-conn-badge">Disabled</span><% } %>
                    <% if (r.is_paused) { %><span class="pre-conn-badge" style="color: var(--warn);">Paused</span><% } %>
                </div>
                <div class="meta"><%= fmt(r.cost) %> pts · <%= fmt(r.redemption_count || 0) %> redemption<%= Number(r.redemption_count) === 1 ? '' : 's' %> in window</div>
            </div>
            <div class="side"><% if (r.last_redeemed_at) { %><%= relAgo(r.last_redeemed_at) %><% } else { %>—<% } %></div>
        </div>
        <% }) %>
    </div>
    <% } %>

    </div><!-- /tab-pane operations: MONETIZATION --><% } %>

    <!-- ===== BITS + AUTOMATIC REWARDS (wave 383) ===== -->
    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">
    <% const capM = d.capture || {}; const bitLabel = { cheer: 'Cheers', power_up: 'Power-ups', combo: 'Combos' }; %>
    <div class="grid cols-3" style="margin-top: 0.75rem;">
        <div class="card"><h3>Bits by type</h3>
            <% if (!(capM.bitsByType || []).length) { %><div class="empty">No bits recorded since this update.</div><% } %>
            <% (capM.bitsByType || []).forEach(b => { %>
            <div class="table-row"><div class="main"><div class="title"><%= bitLabel[b.usage_type] || b.usage_type %></div>
                <div class="meta"><%= fmt(b.n) %> use<%= Number(b.n) === 1 ? '' : 's' %></div></div><div class="side"><%= fmt(b.bits) %> bits</div></div>
            <% }) %>
        </div>
        <div class="card"><h3>Power-ups</h3>
            <% if (!(capM.powerUps || []).length) { %><div class="empty">No Power-ups in this window.</div><% } %>
            <% (capM.powerUps || []).forEach(p => { %>
            <div class="table-row"><div class="main"><div class="title"><%= String(p.power_up_type || 'other').replace(/_/g, ' ') %></div>
                <div class="meta"><%= fmt(p.n) %> use<%= Number(p.n) === 1 ? '' : 's' %></div></div><div class="side"><%= fmt(p.bits) %> bits</div></div>
            <% }) %>
        </div>
        <div class="card"><h3>Built-in channel point rewards</h3>
            <% if (!(capM.autoRewards || []).length) { %><div class="empty">No built-in reward redemptions in this window.</div><% } %>
            <% (capM.autoRewards || []).forEach(r => { %>
            <div class="table-row"><div class="main"><div class="title"><%= r.reward_title %></div>
                <div class="meta"><%= fmt(r.n) %> redemption<%= Number(r.n) === 1 ? '' : 's' %></div></div><div class="side"><%= fmt(r.points) %> pts</div></div>
            <% }) %>
        </div>
    </div>
    </div><!-- /tab-pane operations: BITS + AUTOMATIC REWARDS --><% } %>

    <!-- ===== EVENTS ===== -->

    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">

    <div class="section events" id="events"><h2>Events</h2><div class="section-sub">Hype trains, goals, polls, predictions.</div></div>
    <div class="grid cols-2">
        <div class="card">
            <h3>Hype trains</h3>
            <% if (!d.hypeTrains.length) { %>
            <div class="empty">None in window<% if (!broadcaster.scopes.includes('channel:read:hype_train')) { %> · scope not granted<% } %>.</div>
            <% } %>
            <% d.hypeTrains.slice(0, 10).forEach(ht => { %>
            <div class="table-row"><div class="main"><div class="title">Level <%= ht.level || '?' %> · <%= ht.event_type %></div><div class="meta"><%= fmt(ht.total_bits || 0) %> bits · <%= fmt(ht.total_subs || 0) %> subs</div></div><div class="side"><%= new Date(ht.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <div class="card">
            <h3>Active goals</h3>
            <% if (!d.goals.length) { %>
            <div class="empty">None in window<% if (!broadcaster.scopes.includes('channel:read:goals')) { %> · scope not granted<% } %>.</div>
            <% } %>
            <% d.goals.slice(0, 8).forEach(g => { const pct = g.target_amount ? Math.min(100, 100 * (g.current_amount || 0) / g.target_amount) : 0; %>
            <div class="progress-row">
                <div class="label">
                    <span><%= g.description || g.goal_type || 'goal' %> <span style="color: var(--muted); font-size: 0.75rem;">(<%= g.goal_type || '?' %>)</span></span>
                    <span class="val"><%= fmt(g.current_amount || 0) %> / <%= fmt(g.target_amount || 0) %></span>
                </div>
                <div class="progress-bar good"><div class="fill" style="width: <%= pct.toFixed(1) %>%"></div></div>
            </div>
            <% }) %>
        </div>
    </div>

    <div class="grid cols-2" style="margin-top: 0.75rem;">
        <div class="card">
            <h3>Recent polls</h3>
            <% if (!d.polls.length) { %>
            <div class="empty">None in window<% if (!broadcaster.scopes.includes('channel:read:polls')) { %> · scope not granted<% } %>.</div>
            <% } %>
            <% d.polls.slice(0, 10).forEach(p => {
                let choices = []; try { choices = JSON.parse(p.choices_json || '[]'); } catch {}
                const totalVotes = choices.reduce((s, c) => s + (c.votes || c.channel_points_votes || c.bits_votes || 0), 0);
            %>
            <div class="table-row"><div class="main"><div class="title"><%= p.title || '(poll)' %></div><div class="meta"><%= p.status || '' %> · <%= fmt(totalVotes) %> votes · <%= choices.length %> choices</div></div><div class="side"><%= new Date(p.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <div class="card">
            <h3>Recent predictions</h3>
            <% if (!d.predictions.length) { %>
            <div class="empty">None in window<% if (!broadcaster.scopes.includes('channel:read:predictions')) { %> · scope not granted<% } %>.</div>
            <% } %>
            <% d.predictions.slice(0, 10).forEach(p => { %>
            <div class="table-row"><div class="main"><div class="title"><%= p.title || '(prediction)' %></div><div class="meta"><%= p.status || '' %><% if (p.winning_outcome_id) { %> · winner picked<% } %></div></div><div class="side"><%= new Date(p.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
    </div>

    <% if (d.resubs.length) { %>
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Recent resub messages</h3>
        <% d.resubs.slice(0, 10).forEach(r => { %>
        <div class="table-row"><div class="main"><div class="title"><%= r.user_login %> · <%= r.cumulative_months %>mo</div><div class="meta"><%= (r.message || '').slice(0, 120) %></div></div><div class="side"><%= new Date(r.occurred_at).toLocaleString('en-US', TZO) %></div></div>
        <% }) %>
    </div>
    <% } %>

    </div><!-- /tab-pane operations: EVENTS --><% } %>

    <!-- ===== COMMUNITY ===== -->

    <div class="tab-pane" data-tab-group="audience">

    <div class="section community" id="community"><h2>Community</h2><div class="section-sub">Roster, schedule and clip activity.</div></div>
    <!-- AI follower-sub journey -->
    <div class="card" style="margin-top: 0.75rem; border-left: 3px solid var(--accent);">
        <h3 style="font-size: 0.75rem; margin: 0 0 0.5rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center;">
            <span>AI follower → sub journey</span>
            <button type="button" id="journeyBtn" class="backfill-btn" style="color: var(--accent); border-color: var(--cf-accent-line); font-size: 0.7rem; padding: 0.2rem 0.5rem;" onclick="aiAnalyzeJourney()">Analyze</button>
        </h3>
        <div id="journeyOut" style="font-size: 0.825rem; color: var(--muted);">Discover which streams best convert first-time chatters into long-term subs.</div>
    </div>

    <!-- AI peer comparison (reciprocal opt-in) -->
    <div class="card" style="margin-top: 0.75rem; border-left: 3px solid var(--cyan);">
        <h3 style="font-size: 0.75rem; margin: 0 0 0.5rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center;">
            <span>Peer comparison (vs similar-sized channels)</span>
            <button type="button" id="peerBtn" class="backfill-btn" style="color: var(--cyan); border-color: color-mix(in srgb, var(--cyan) 40%, transparent); font-size: 0.7rem; padding: 0.2rem 0.5rem;" onclick="aiAnalyzePeer()">Analyze</button>
        </h3>
        <div id="peerOut" style="font-size: 0.825rem; color: var(--muted);">
            <% const _ac = d.alertsConfig || {}; %>
            <% if (!_ac.ai_peer_pool_optin) { %>
            Not opted into the peer pool. The pool is <strong>reciprocal</strong>: your aggregates (follower / sub / peak / hours / msgs — never titles, chat, or usernames) are shared anonymously only if you want to see peer medians yourself. Minimum bucket size is k=5 for privacy.
            <form method="POST" action="/manage/<%= guildId %>/twitch-ai/peer-pool/optin?range=<%= range %>" style="margin-top: 0.5rem;">
                <input type="hidden" name="enable" value="1">
                <button type="submit" class="backfill-btn" style="color: var(--cyan); border-color: color-mix(in srgb, var(--cyan) 40%, transparent);"><i class="fas fa-handshake"></i> Opt into peer pool</button>
            </form>
            <% } else { %>
            Opted in. Click "Analyze" to see your percentile within your follower-count bucket, plus AI-written strengths + opportunities.
            <form method="POST" action="/manage/<%= guildId %>/twitch-ai/peer-pool/optin?range=<%= range %>" style="margin-top: 0.3rem;" onclick="return confirm('Opt out? Your historical percentile log will be deleted.');">
                <input type="hidden" name="enable" value="0">
                <button type="submit" style="background: transparent; border: 0; color: var(--muted); font-size: 0.72rem; cursor: pointer; text-decoration: underline;">opt out</button>
            </form>
            <% } %>
        </div>
    </div>

    <% const lm = d.linkedMembers || {}; const totalLinked = Number(lm.total || 0); %>
    <div class="grid cols-2">
        <div class="card">
            <% if (locals.shareMode) { %><h3>Channel roster</h3><% } else { %>
            <h3>Linked members (Discord ↔ Twitch)</h3>
            <% if (totalLinked === 0) { %>
            <div class="empty">No linked members yet. Role sync populates this once members authorise the Twitch flow.</div>
            <% } else { %>
            <div class="table-row"><div class="main"><div class="title">Total linked</div></div><div class="side" style="color: var(--ink); font-size: 1rem; font-weight: 500;"><%= fmt(totalLinked) %></div></div>
            <div class="table-row"><div class="main"><div class="title">Subscribers</div></div><div class="side"><%= fmt(lm.subs) %></div></div>
            <div class="table-row"><div class="main"><div class="title">Moderators</div></div><div class="side"><%= fmt(lm.mods) %></div></div>
            <div class="table-row"><div class="main"><div class="title">VIPs</div></div><div class="side"><%= fmt(lm.vips) %></div></div>
            <% } %>
            <% } %>

            <% if (bf.current_vips || bf.current_mods || bf.subscriber_count != null) { %>
            <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--panel-border);">
                <div style="font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem;">Twitch channel roster</div>
                <% if (bf.subscriber_count != null) { %>
                <div class="table-row" style="padding: 0.4rem 0.25rem;"><div class="main"><div class="title">Active subscribers</div></div><div class="side" style="color: var(--ink);"><%= fmt(bf.subscriber_count) %></div></div>
                <% } %>
                <% if (bf.current_mods) { %>
                <div class="table-row" style="padding: 0.4rem 0.25rem;"><div class="main"><div class="title">Channel mods</div></div><div class="side" style="color: var(--ink);"><%= fmt(bf.current_mods.length) %></div></div>
                <% } %>
                <% if (bf.current_vips) { %>
                <div class="table-row" style="padding: 0.4rem 0.25rem;"><div class="main"><div class="title">Channel VIPs</div></div><div class="side" style="color: var(--ink);"><%= fmt(bf.current_vips.length) %></div></div>
                <% } %>
            </div>
            <% } %>
        </div>

        <%
            const scheduleSegs = schedule?.segments || [];
            const upcoming = scheduleSegs.filter(s => new Date(s.start_time) > new Date()).slice(0, 8);
        %>
        <div class="card">
            <h3>Upcoming schedule</h3>
            <% if (!upcoming.length) { %>
            <div class="empty">No scheduled streams.</div>
            <% } %>
            <% upcoming.forEach(seg => { %>
            <div class="table-row"><div class="main"><div class="title"><%= seg.title || '(untitled)' %></div><div class="meta"><%= seg.category?.name || '(no category)' %><% if (seg.is_recurring) { %> · recurring<% } %></div></div><div class="side"><%= new Date(seg.start_time).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
            <% if (upcoming.length) { %>
            <div class="footer-row"><a href="/manage/<%= guildId %>/twitch-analytics/schedule.ics"><i class="fas fa-calendar"></i> Download .ics</a></div>
            <% } %>
        </div>
    </div>

    <%
        // Community funnel: Followers → Subscribers → Mods+VIPs → Active chatters now
        const funnelData = {
            followers: Number(bf.follower_count || 0),
            subscribers: Number(bf.subscriber_count || 0),
            roster: (bf.current_mods ? bf.current_mods.length : 0) + (bf.current_vips ? bf.current_vips.length : 0),
            active: liveStream ? Number(liveStream.viewer_count || 0) : Number(d.engagement.peak_chatters || 0),
        };
        const showFunnel = funnelData.followers > 0;
    %>
    <% if (showFunnel) { %>
    <div class="chart-card" style="margin-top: 0.75rem;">
        <h3>Community funnel</h3>
        <canvas id="funnelChart" height="100"></canvas>
    </div>
    <% } %>

    <% const cs = d.clipsSummary || { total: 0, daily: [], recent: [] }; %>
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Clip autopost activity</h3>
        <% if (!cs.total) { %>
        <div class="empty">No clips auto-posted in this window.</div>
        <% } else { %>
        <% cs.recent.slice(0, 6).forEach(c => { %>
        <div class="table-row"><div class="main"><div class="title"><a href="https://clips.twitch.tv/<%= c.clip_id %>" target="_blank" rel="noopener" style="color: var(--accent);"><%= c.clip_id %></a></div><div class="meta"><%= c.username || c.broadcaster_id || 'unknown' %></div></div><div class="side"><%= new Date(c.announced_at).toLocaleString('en-US', TZO) %></div></div>
        <% }) %>
        <% } %>
    </div>


    <% if (d.channelEditors && d.channelEditors.length) { %>
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Channel editors</h3>
        <% d.channelEditors.forEach(ed => { %>
        <div class="table-row"><div class="main"><div class="title"><%= ed.user_name %></div></div><div class="side">since <%= new Date(ed.created_at_twitch).toLocaleDateString('en-US', TZO) %></div></div>
        <% }) %>
    </div>
    <% } %>
    </div><!-- /tab-pane audience: COMMUNITY -->

    <!-- ===== CHATTERS (new, wave 369) ===== -->

    <div class="tab-pane" data-tab-group="audience">

    <% if (d.topChatters && d.topChatters.length) { %>
    <div class="section engagement" id="chatters"><h2>Chatters</h2><div class="section-sub">Who's showing up in your chat, across sessions.</div></div>
    <% const sil = (d.capture || {}).silent || {}; const silTop = (d.capture || {}).silentTop || []; %>
    <div class="grid cols-3" style="margin-bottom: 0.75rem;">
        <div class="card"><h3>Silent accounts</h3><p class="big"><%= fmt(sil.silent || 0) %></p>
            <p class="sub">in chat 30+ minutes without ever sending a message<% if (Number(sil.seen)) { %> · <%= fmt(sil.chatted || 0) %> of <%= fmt(sil.seen) %> accounts have chatted<% } %></p>
            <% if (silTop.length) { %>
            <details style="margin-top: 0.5rem;"><summary class="sub" style="cursor: pointer;">Show accounts</summary>
                <% silTop.forEach(a => { %>
                <div class="table-row"><div class="main"><div class="title"><%= a.login %></div></div><div class="side"><%= fmt(a.sightings) %> min</div></div>
                <% }) %>
                <p class="sub" style="margin-top: 0.4rem;">Many are genuine lurkers. Large groups with generated-looking names that arrive together are usually idle bot accounts.</p>
            </details>
            <% } %>
        </div>
        <div class="card"><h3>Peak chatters</h3><p class="big"><%= fmt(d.engagement.peak_chatters) %></p><p class="sub">average <%= fmt(Math.round(d.engagement.avg_chatters)) %></p></div>
        <div class="card"><h3>Chat per viewer-hour</h3><p class="big"><%= fmtRate(d.engagement.msgs_per_viewer_hour, 1) %></p><p class="sub"><%= fmt(h.total_msgs) %> messages in window</p></div>
    </div>
    <div class="grid cols-2">
        <div class="card">
            <h3>Top chatters</h3>
            <% if (!d.topChatters.length) { %><div class="empty">No chatters recorded yet. Turn on chatter tracking under Admin.</div><% } %>
            <% d.topChatters.slice(0, 15).forEach(c => { %>
            <div class="table-row">
                <div class="main"><div class="title"><%= c.chatter_display_name || c.chatter_user_login %></div><div class="meta">first seen <%= new Date(c.first_seen_at).toLocaleDateString('en-US', TZO) %> · last <%= new Date(c.last_seen_at).toLocaleDateString('en-US', TZO) %></div></div>
                <div class="side"><%= Number(c.messages) ? fmt(c.messages) + ' messages' : fmt(c.sightings) + ' min in chat' %> <button type="button" onclick="aiAnalyzeChatter('<%= c.chatter_user_login %>')" style="background: transparent; border: 0; color: var(--accent); cursor: pointer; font-size: 0.72rem; margin-left: 0.3rem;" title="AI persona analysis"><i class="fas fa-robot"></i></button></div>
            </div>
            <% }) %>
        </div>
        <div class="card">
            <h3>Chat text analysis</h3>
            <% if (!d.chatSampleStats || !Number(d.chatSampleStats.msgs)) { %>
            <div class="empty">Chat sampling is off. Enable in Admin → Alert configuration to populate emote / word / sentiment analytics.</div>
            <% } else { %>
            <div class="table-row"><div class="main"><div class="title">Messages sampled</div></div><div class="side"><%= fmt(d.chatSampleStats.msgs) %></div></div>
            <div class="table-row"><div class="main"><div class="title">Emote uses</div><div class="meta">per message: <%= (d.chatSampleStats.emotes / Math.max(1, d.chatSampleStats.msgs)).toFixed(2) %></div></div><div class="side"><%= fmt(d.chatSampleStats.emotes) %></div></div>
            <div class="table-row"><div class="main"><div class="title">Caps-heavy messages</div></div><div class="side"><%= fmt(d.chatSampleStats.caps) %></div></div>
            <div class="table-row"><div class="main"><div class="title">Messages with links</div></div><div class="side"><%= fmt(d.chatSampleStats.links) %></div></div>
            <div class="table-row"><div class="main"><div class="title">Avg message length</div></div><div class="side"><%= Math.round(Number(d.chatSampleStats.avg_len || 0)) %> chars</div></div>
            <% } %>
        </div>
    </div>

    <% if (d.topWords && d.topWords.length) { %>
    <!-- Word cloud / top words from sampled chat -->
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Most-used words</h3>
        <div style="line-height: 1.9;">
            <%
                // Simple word-cloud sizing: scale font-size by rank. Top word is biggest.
                const maxN = d.topWords[0]?.n || 1;
                d.topWords.forEach(w => {
                    const size = 0.7 + 1.3 * (w.n / maxN);
                    const opacity = 0.4 + 0.6 * (w.n / maxN);
            %>
            <span style="font-size: <%= size.toFixed(2) %>rem; opacity: <%= opacity.toFixed(2) %>; margin-right: 0.6rem; color: var(--accent);" title="<%= w.n %> uses"><%= w.word %></span>
            <% }) %>
        </div>
    </div>
    <% } %>

    <% if (d.topChattersByMsgs && d.topChattersByMsgs.length) { %>
    <!-- Top chatters by sampled message count -->
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Chattiest users (sampled)</h3>
        <% d.topChattersByMsgs.slice(0, 10).forEach(c => { %>
        <div class="table-row"><div class="main"><div class="title"><%= c.chatter_user_login %></div></div><div class="side"><%= fmt(c.msgs) %> messages</div></div>
        <% }) %>
    </div>
    <% } %>
    <% } %>

    </div><!-- /tab-pane audience: CHATTERS (new, wave 369) -->

    <!-- ===== REACH + EMOTES (wave 383) ===== -->
    <% const cap = d.capture || {}; %>
    <div class="tab-pane" data-tab-group="audience">
    <div class="section community" id="reach"><h2>Reach and collaboration</h2><div class="section-sub">Your rank in your category, raids both ways, shared chats.</div></div>
    <% const rkNow = cap.rankLatest; const rk = cap.rankSummary || {}; const rc = cap.raidCounts || {}; const rv = cap.raidViewers || {}; %>
    <div class="grid cols-4">
        <div class="card"><h3>Category rank</h3>
            <p class="big"><%= rkNow ? (rkNow.rank_pos ? '#' + fmt(rkNow.rank_pos) : 'Outside top ' + fmt(rkNow.channels_sampled)) : '—' %></p>
            <p class="sub"><% if (rkNow) { %><%= rkNow.game_name || 'category' %> · <%= relAgo(rkNow.recorded_at) %><% } else { %>sampled every 5 minutes while live<% } %></p></div>
        <div class="card"><h3>Best rank</h3>
            <p class="big"><%= rk.best ? '#' + fmt(rk.best) : '—' %></p>
            <p class="sub"><%= rk.avg_rank ? 'average #' + fmt(rk.avg_rank) + ' over ' + fmt(rk.samples) + ' samples' : 'no live samples in window' %></p></div>
        <div class="card"><h3>Raids received</h3><p class="big"><%= fmt(rc.in || 0) %></p><p class="sub"><%= fmt(rv.in || 0) %> viewers brought in</p></div>
        <div class="card"><h3>Raids sent</h3><p class="big"><%= fmt(rc.out || 0) %></p><p class="sub"><%= fmt(rv.out || 0) %> viewers sent</p></div>
    </div>
    <div class="grid cols-2" style="margin-top: 0.75rem;">
        <% [['Who raids you', cap.raidsIn], ['Who you raid', cap.raidsOut]].forEach(([title, rows]) => { %>
        <div class="card"><h3><%= title %></h3>
            <% if (!rows || !rows.length) { %><div class="empty">No raids in this window.</div><% } %>
            <% (rows || []).forEach(r => { %>
            <div class="table-row"><div class="main"><div class="title"><%= r.login || 'unknown' %></div>
                <div class="meta"><%= fmt(r.n) %> raid<%= Number(r.n) === 1 ? '' : 's' %> · <%= fmt(r.viewers) %> viewers</div></div>
                <div class="side"><%= relAgo(r.last_at) %></div></div>
            <% }) %>
        </div>
        <% }) %>
    </div>
    <div class="card" style="margin-top: 0.75rem;"><h3>Shared chat sessions</h3>
        <% if (!(cap.sharedChat || []).length) { %><div class="empty">No shared chats in this window. Chat numbers during a shared chat include the other channels' chatters.</div><% } %>
        <% (cap.sharedChat || []).forEach(s => { %>
        <div class="table-row"><div class="main"><div class="title"><%= s.participants.length ? s.participants.join(', ') : 'Shared chat' %></div>
            <div class="meta">started <%= relAgo(s.began_at) %><%= s.ended_at ? ' · ended ' + relAgo(s.ended_at) : ' · in progress' %></div></div></div>
        <% }) %>
    </div>

    <div class="section engagement" id="emotes"><h2>Emotes</h2><div class="section-sub">Most-used emotes in chat. Your channel's own emotes are marked.</div></div>
    <div class="card">
        <% if (!(cap.emotes || []).length) { %><div class="empty">No emote usage recorded yet. Counting started with this update.</div><% } %>
        <div class="grid cols-2" style="gap: 0 1.5rem;">
        <% (cap.emotes || []).forEach(e => { %>
            <div class="table-row">
                <% if (e.image_url) { %><img src="<%= e.image_url %>" alt="" width="28" height="28" loading="lazy" style="flex-shrink: 0;"><% } %>
                <div class="main"><div class="title"><%= e.emote_name || e.emote_id %><% if (Number(e.is_channel)) { %> <span class="pill purple">channel</span><% } %></div></div>
                <div class="side"><%= fmt(e.uses) %> uses</div>
            </div>
        <% }) %>
        </div>
    </div>
    </div><!-- /tab-pane audience: REACH + EMOTES -->

    <!-- ===== MODERATION ===== -->

    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">

    <div class="section moderation" id="moderation"><h2>Moderation</h2><div class="section-sub">VIP/mod churn, shoutouts, bans, warnings, Shield Mode.</div></div>
    <div class="grid cols-4">
        <div class="card accent-moderation"><h3>Bans active</h3><p class="big"><%= d.bannedSummary ? fmt(d.bannedSummary.total_banned) : '—' %></p><p class="sub"><% if (d.bannedSummary) { %><%= fmt(d.bannedSummary.permanent_count) %> permanent · <%= fmt(d.bannedSummary.timed_count) %> timed<% } else { %>no backfill data yet<% } %></p></div>
        <div class="card accent-moderation"><h3>VIP changes</h3><p class="big"><%= d.vipMod.filter(x => x.role === 'vip').length %></p><p class="sub">in window</p></div>
        <div class="card accent-moderation"><h3>Mod changes</h3><p class="big"><%= d.vipMod.filter(x => x.role === 'moderator').length %></p><p class="sub">in window</p></div>
        <div class="card"><h3>Mod actions per 1,000 messages</h3><p class="big"><%= fmtRate(d.engagement.mod_actions_per_1k_msgs, 1) %></p><p class="sub"><%= fmt(h.total_mod_actions) %> actions in window</p></div>
    </div>

    <div class="grid cols-2" style="margin-top: 0.75rem;">
        <div class="card">
            <h3>Shoutouts</h3>
            <% if (!d.shoutouts.length) { %>
            <div class="empty">None in window<% if (!broadcaster.scopes.includes('moderator:read:shoutouts')) { %> · scope not granted<% } %>.</div>
            <% } %>
            <% d.shoutouts.slice(0, 10).forEach(s => { %>
            <div class="table-row"><div class="main"><div class="title"><%= s.direction === 'sent' ? '→' : '←' %> <%= s.counterpart_user_login %></div><div class="meta">by <%= s.moderator_user_login || '?' %> · <%= fmt(s.viewer_count || 0) %> viewers</div></div><div class="side"><%= new Date(s.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <div class="card">
            <h3>VIP &amp; mod churn</h3>
            <% if (!d.vipMod.length) { %>
            <div class="empty">No role changes in window.</div>
            <% } %>
            <% d.vipMod.slice(0, 10).forEach(v => { %>
            <div class="table-row"><div class="main"><div class="title"><%= v.action === 'add' ? '+' : '-' %> <%= v.target_user_login %></div><div class="meta"><%= v.role %> · <%= v.action %></div></div><div class="side"><%= new Date(v.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
    </div>

    <!-- Wave 369 — Suspicious users / Warnings / Unban appeals / Shield Mode / AutoMod -->
    <% if ((d.suspiciousUsers && d.suspiciousUsers.length) || (d.warnings && d.warnings.length) || (d.unbanRequests && d.unbanRequests.length) || (d.shieldModeEvents && d.shieldModeEvents.length) || d.automodSettings || (d.blockedTerms && d.blockedTerms.length)) { %>
    <div class="grid cols-2" style="margin-top: 0.75rem;">
        <% if (d.suspiciousUsers && d.suspiciousUsers.length) { %>
        <div class="card accent-alerts">
            <h3 style="font-size: 0.75rem; margin: 0 0 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center;">
                <span>Suspicious user activity</span>
                <button type="button" onclick="aiAnalyzeHarassment()" class="backfill-btn" style="color: var(--accent); border-color: var(--cf-accent-line); font-size: 0.7rem; padding: 0.2rem 0.5rem;"><i class="fas fa-robot"></i> AI pattern</button>
            </h3>
            <% d.suspiciousUsers.slice(0, 10).forEach(s => { %>
            <div class="table-row"><div class="main"><div class="title"><%= s.user_login %> <% if (s.low_trust_status) { %><span class="pre-conn-badge" style="color: var(--bad);"><%= s.low_trust_status %></span><% } %></div><div class="meta"><% if (s.ban_evasion_evaluation) { %>evasion: <%= s.ban_evasion_evaluation %><% } %> <%= (s.message_text || '').slice(0, 80) %></div></div><div class="side"><%= new Date(s.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <% } %>
        <% if (d.warnings && d.warnings.length) { %>
        <div class="card accent-moderation">
            <h3>Warnings issued</h3>
            <% d.warnings.slice(0, 10).forEach(w => { %>
            <div class="table-row"><div class="main"><div class="title"><%= w.user_login %></div><div class="meta">by <%= w.moderator_user_login || '?' %> · <%= (w.reason || '').slice(0, 80) %></div></div><div class="side"><%= new Date(w.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <% } %>
        <% if (d.unbanRequests && d.unbanRequests.length) { %>
        <div class="card">
            <h3>Unban appeals</h3>
            <% d.unbanRequests.slice(0, 10).forEach(u => { %>
            <div class="table-row" style="flex-direction: column; align-items: stretch;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <div class="main"><div class="title"><%= u.user_login %> <span class="pre-conn-badge"><%= u.status || 'pending' %></span></div><div class="meta"><%= (u.text || u.resolution_text || '').slice(0, 120) %></div></div>
                    <div class="side"><%= new Date(u.occurred_at).toLocaleString('en-US', TZO) %></div>
                </div>
                <% if (broadcaster.tier_b_granted && (u.status === 'pending' || !u.status)) { %>
                <div style="display: flex; gap: 0.4rem; margin-top: 0.4rem; align-items: center;">
                    <input type="text" placeholder="Resolution note" id="unban-note-<%= u.request_id %>" style="flex: 1; padding: 0.3rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 3px; color: var(--ink); font-size: 0.75rem;">
                    <form method="POST" action="/manage/<%= guildId %>/twitch-controls/unban-request/<%= u.request_id %>/approve?range=<%= range %>" style="margin: 0;" onsubmit="this.querySelector('input[name=note]').value=document.getElementById('unban-note-<%= u.request_id %>').value;">
                        <input type="hidden" name="note" value="">
                        <button type="submit" class="backfill-btn" style="color: var(--good); border-color: color-mix(in srgb, var(--good) 40%, transparent); font-size: 0.72rem; padding: 0.3rem 0.6rem;"><i class="fas fa-check"></i> Approve</button>
                    </form>
                    <form method="POST" action="/manage/<%= guildId %>/twitch-controls/unban-request/<%= u.request_id %>/deny?range=<%= range %>" style="margin: 0;" onsubmit="this.querySelector('input[name=note]').value=document.getElementById('unban-note-<%= u.request_id %>').value;">
                        <input type="hidden" name="note" value="">
                        <button type="submit" class="backfill-btn" style="color: var(--bad); border-color: color-mix(in srgb, var(--bad) 40%, transparent); font-size: 0.72rem; padding: 0.3rem 0.6rem;"><i class="fas fa-times"></i> Deny</button>
                    </form>
                </div>
                <% } %>
            </div>
            <% }) %>
        </div>
        <% } %>
        <% if (d.shieldModeEvents && d.shieldModeEvents.length) { %>
        <div class="card accent-alerts">
            <h3>Shield Mode history</h3>
            <% d.shieldModeEvents.slice(0, 10).forEach(s => { %>
            <div class="table-row"><div class="main"><div class="title"><%= s.event_type === 'begin' ? 'Activated' : 'Deactivated' %></div><div class="meta">by <%= s.moderator_user_login || '?' %></div></div><div class="side"><%= new Date(s.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <% } %>
        <% if (d.guestStarSessions && d.guestStarSessions.length) { %>
        <div class="card">
            <h3>Guest star sessions</h3>
            <% d.guestStarSessions.slice(0, 10).forEach(gs => {
                let guests = []; try { guests = JSON.parse(gs.guests_json || '[]'); } catch {}
            %>
            <div class="table-row"><div class="main"><div class="title">Session <%= String(gs.session_id || '').slice(0, 10) %> <span class="pre-conn-badge"><%= gs.event_type %></span></div><div class="meta"><%= guests.length %> guest<%= guests.length === 1 ? '' : 's' %></div></div><div class="side"><%= new Date(gs.occurred_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>
        <% } %>
        <% if (d.automodSettings) { %>
        <div class="card">
            <h3 style="font-size: 0.75rem; margin: 0 0 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; display: flex; justify-content: space-between; align-items: center;">
                <span>AutoMod config</span>
                <button type="button" id="aiTuneAutomodBtn" onclick="aiTuneAutomod()" class="backfill-btn" style="color: var(--accent); border-color: var(--cf-accent-line); font-size: 0.7rem; padding: 0.2rem 0.5rem;"><i class="fas fa-robot"></i> AI tune</button>
            </h3>
            <% const amCats = [['Overall','overall_level'],['Disability','disability'],['Aggression','aggression'],['Sexuality','sexuality_sex_or_gender'],['Misogyny','misogyny'],['Bullying','bullying'],['Swearing','swearing'],['Race / Ethnicity','race_ethnicity_or_religion'],['Sex-based terms','sex_based_terms']]; %>
            <% amCats.forEach(([lbl, key]) => { const v = d.automodSettings[key]; if (v !== null && v !== undefined) { %>
            <div class="table-row" style="padding: 0.35rem 0.25rem;"><div class="main"><div class="title" style="font-size: 0.825rem;"><%= lbl %></div></div><div class="side">Level <%= v %></div></div>
            <% } }) %>
        </div>
        <% } %>
        <% if (d.blockedTerms && d.blockedTerms.length) { %>
        <div class="card">
            <h3>Blocked terms (<%= d.blockedTerms.length %>)</h3>
            <% if (broadcaster.tier_b_granted) { %>
            <form method="POST" action="/manage/<%= guildId %>/twitch-controls/blocked-term/add?range=<%= range %>" style="display: flex; gap: 0.4rem; margin-bottom: 0.6rem;">
                <input type="text" name="term" placeholder="Add term" required style="flex: 1; padding: 0.3rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 3px; color: var(--ink); font-size: 0.75rem;">
                <button type="submit" class="backfill-btn" style="font-size: 0.72rem; padding: 0.3rem 0.6rem;"><i class="fas fa-plus"></i> Add</button>
            </form>
            <% } %>
            <div style="font-size: 0.75rem; color: var(--muted); line-height: 1.9;">
                <% d.blockedTerms.slice(0, 30).forEach(t => { %>
                <span style="display: inline-flex; align-items: center; gap: 0.2rem; background: color-mix(in srgb, var(--cf-text) 3%, transparent); border: 1px solid var(--panel-border); border-radius: 4px; padding: 2px 6px; margin-right: 0.3rem;">
                    <code><%= (t.term_text || '').slice(0, 40) %></code>
                    <% if (broadcaster.tier_b_granted) { %>
                    <form method="POST" action="/manage/<%= guildId %>/twitch-controls/blocked-term/<%= t.id %>/remove?range=<%= range %>" style="margin: 0; display: inline;" onclick="return confirm('Remove this blocked term?');">
                        <button type="submit" style="background: transparent; border: 0; color: var(--muted); cursor: pointer; font-size: 0.72rem; padding: 0;">×</button>
                    </form>
                    <% } %>
                </span>
                <% }) %>
            </div>
        </div>
        <% } %>
    </div>
    <% } %>

    </div><!-- /tab-pane operations: MODERATION --><% } %>

    <!-- ===== MODERATOR ACTIVITY (wave 383) ===== -->
    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">
    <% const capX = d.capture || {}; const am = capX.automodStatus || {}; const cc = capX.chatClears || {}; %>
    <div class="section moderation" id="mod-activity"><h2>Moderator activity</h2><div class="section-sub">Who did what: bans, timeouts, unbans, warnings, AutoMod decisions, unban reviews, Shield Mode.</div></div>
    <div class="grid cols-2-3">
        <div class="card"><h3>AutoMod</h3>
            <div class="grid cols-2" style="gap: 0.5rem; margin-bottom: 0.6rem;">
                <div><div class="sub">Held</div><p class="big"><%= fmt(Object.values(am).reduce((a, n) => a + n, 0)) %></p></div>
                <div><div class="sub">Approved / denied</div><p class="big"><%= fmt(am.approved || 0) %> / <%= fmt(am.denied || 0) %></p></div>
            </div>
            <% if ((am.pending || 0) || (am.expired || 0)) { %><div class="sub" style="margin-bottom: 0.4rem;"><%= fmt(am.pending || 0) %> awaiting review · <%= fmt(am.expired || 0) %> expired unreviewed</div><% } %>
            <% (capX.automodCats || []).forEach(c => { %>
            <div class="table-row"><div class="main"><div class="title"><%= String(c.category).replace(/_/g, ' ') %></div></div><div class="side"><%= fmt(c.n) %></div></div>
            <% }) %>
            <div class="sub" style="margin-top: 0.6rem;">Chat cleared <%= fmt(cc.chat_clear || 0) %> time<%= Number(cc.chat_clear) === 1 ? '' : 's' %> · <%= fmt(cc.user_messages_cleared || 0) %> user purge<%= Number(cc.user_messages_cleared) === 1 ? '' : 's' %></div>
        </div>
        <div class="card"><h3>By moderator</h3>
            <% if (!(capX.modActivity || []).length) { %><div class="empty">No moderator actions recorded in this window.</div><% } %>
            <% const modLabels = [['bans', 'ban'], ['timeouts', 'timeout'], ['unbans', 'unban'], ['warns', 'warning'], ['automod', 'AutoMod decision'], ['unban_reviews', 'unban review'], ['shields', 'Shield Mode']]; %>
            <% (capX.modActivity || []).forEach(m => {
                const parts = modLabels.filter(([k]) => Number(m[k]) > 0).map(([k, label]) => fmt(m[k]) + ' ' + label + (Number(m[k]) === 1 || label === 'Shield Mode' ? '' : 's')); %>
            <div class="table-row"><div class="main"><div class="title"><%= m.login %></div><div class="meta"><%= parts.join(' · ') %></div></div>
                <div class="side"><%= relAgo(m.last_at) %></div></div>
            <% }) %>
        </div>
    </div>
    </div><!-- /tab-pane operations: MODERATOR ACTIVITY --><% } %>

    <!-- ===== ANOMALIES — Wave 370 breakdown ===== -->

    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">

    <div class="section alerts" id="alerts"><h2>Anomaly alerts</h2><div class="section-sub">Anti-abuse detectors — view-bot, follow-bot, harassment, suspicious users.</div></div>
    <div class="card" style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;"><h3 style="margin: 0;">Channel integrity report</h3>
            <div class="sub">Evidence-based viewbot assessment, chatter legitimacy and detected anomalies, with the criteria printed.</div></div>
        <a class="backfill-btn" href="/manage/<%= guildId %>/twitch-analytics/integrity?days=90">View</a>
        <a class="backfill-btn" href="/manage/<%= guildId %>/twitch-analytics/integrity.pdf?days=90">PDF</a>
        <a class="backfill-btn" href="/manage/<%= guildId %>/twitch-analytics/integrity.png?days=90">Image</a>
    </div>

    <%
        // Severity rollup — three counts for the header strip.
        const sevCounts = { critical: 0, warning: 0, info: 0 };
        for (const row of (d.anomalyBySeverity || [])) sevCounts[row.severity] = Number(row.n) || 0;
        const sevTotal = sevCounts.critical + sevCounts.warning + sevCounts.info;
    %>
    <div class="grid cols-4" style="margin-bottom: 0.75rem;">
        <div class="card accent-alerts" style="border-left-color: var(--bad);">
            <h3>Critical</h3>
            <p class="big" style="color: var(--bad);"><%= fmt(sevCounts.critical) %></p>
            <p class="sub"><%= sevTotal > 0 ? Math.round(100 * sevCounts.critical / sevTotal) : 0 %>% of window</p>
        </div>
        <div class="card" style="border-left: 3px solid var(--warn);">
            <h3>Warning</h3>
            <p class="big" style="color: var(--warn);"><%= fmt(sevCounts.warning) %></p>
            <p class="sub"><%= sevTotal > 0 ? Math.round(100 * sevCounts.warning / sevTotal) : 0 %>% of window</p>
        </div>
        <div class="card" style="border-left: 3px solid var(--accent);">
            <h3>Info</h3>
            <p class="big" style="color: var(--accent);"><%= fmt(sevCounts.info) %></p>
            <p class="sub"><%= sevTotal > 0 ? Math.round(100 * sevCounts.info / sevTotal) : 0 %>% of window</p>
        </div>
        <div class="card">
            <h3>Total</h3>
            <p class="big"><%= fmt(sevTotal) %></p>
            <p class="sub"><%= (d.anomalyByType || []).length %> detector type<%= (d.anomalyByType || []).length === 1 ? '' : 's' %> firing</p>
        </div>
    </div>

    <!-- Alert-type breakdown — one row per (alert_type, severity) with peak score + last-fired -->
    <% if (d.anomalyByType && d.anomalyByType.length) { %>
    <div class="chart-card" style="margin-bottom: 0.75rem;">
        <h3>Breakdown by detector</h3>
        <% d.anomalyByType.forEach(t => { const sev = t.severity; %>
        <div class="table-row">
            <div class="main">
                <div class="title">
                    <code><%= t.alert_type %></code>
                    <span class="badge-sev-<%= sev %>" style="font-size: 0.7rem; margin-left: 0.4rem; text-transform: uppercase;"><%= sev %></span>
                </div>
                <div class="meta">peak score <%= Number(t.peak_score || 0).toFixed(3) %> · last fired <%= relAgo(t.last_at) %></div>
            </div>
            <div class="side" style="color: var(--ink); font-size: 1rem; font-weight: 500;"><%= fmt(t.n) %></div>
        </div>
        <% }) %>
    </div>
    <% } %>

    <!-- Timeline scatter + per-row expandable evidence -->
    <div class="chart-card">
        <button class="export-btn" data-chart="anomalyScatterChart"><i class="fas fa-download"></i></button>
        <h3>Timeline + evidence</h3>
        <% if (!d.recentAlerts.length) { %>
        <div class="empty">No anomalies in window — detectors haven't flagged anything.</div>
        <% } else { %>
        <canvas id="anomalyScatterChart" height="80"></canvas>
        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--panel-border);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; font-size: 0.75rem; color: var(--muted);">
                <span>Showing <%= d.recentAlerts.filter(a => a.status !== 'superseded').length %> actionable alert<%= d.recentAlerts.filter(a => a.status !== 'superseded').length === 1 ? '' : 's' %><% if (d.recentAlerts.some(a => a.status === 'superseded')) { %> · <a href="?range=<%= range %>&include_superseded=1#alerts" style="color: var(--muted); text-decoration: underline;">show superseded</a><% } %></span>
            </div>
            <% d.recentAlerts.slice(0, 30).forEach((a, idx) => {
                let ev = {}; try { ev = JSON.parse(a.evidence_json || '{}'); } catch {}
                const sev = String(a.severity || 'info');
                const status = a.status || 'open';
                const isSuperseded = status === 'superseded';
                const isAckd = status === 'acknowledged' || status === 'resolved';
            %>
            <details class="anomaly-row" style="padding: 0.5rem 0.25rem; border-bottom: 1px solid var(--panel-border); <%= isSuperseded ? 'opacity: 0.55;' : '' %>">
                <summary style="cursor: pointer; display: flex; align-items: center; gap: 0.75rem; list-style: none;">
                    <div style="flex: 1;">
                        <div style="font-weight: 500; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                            <% const _sevCls = sev === 'critical' ? 'is-live' : sev === 'warning' ? 'is-warn' : 'is-info'; %>
                            <span class="cf-status <%= _sevCls %>"><%= sev %></span>
                            <% if (isSuperseded) { %><span class="cf-status is-muted">superseded</span>
                            <% } else if (status === 'resolved') { %><span class="cf-status is-on">resolved</span>
                            <% } else if (isAckd) { %><span class="cf-status is-info">acknowledged</span>
                            <% } %>
                            <span style="color: var(--cf-text, var(--ink));"><%= a.alert_type %></span>
                        </div>
                        <div style="font-size: 0.825rem; color: var(--muted); <%= isSuperseded ? 'text-decoration: line-through;' : '' %>"><%= ev.interpretation || ('score ' + Number(a.score).toFixed(3)) %></div>
                    </div>
                    <div style="color: var(--muted); font-size: 0.75rem; text-align: right;"><%= new Date(a.created_at).toLocaleString('en-US', TZO) %></div>
                </summary>
                <div style="margin-top: 0.5rem; padding: 0.75rem; background: var(--field-bg); border-radius: 6px; font-size: 0.8rem;">
                    <div style="color: var(--muted); margin-bottom: 0.4rem;">Score: <strong style="color: var(--ink);"><%= Number(a.score).toFixed(4) %></strong></div>
                    <% const evKeys = Object.keys(ev).filter(k => !['interpretation','acknowledged_by','acknowledged_at','ack_note','superseded_by','chatters_at_time'].includes(k)); %>
                    <% if (evKeys.length) { %>
                    <table style="width: 100%; font-size: 0.78rem;">
                        <% evKeys.forEach(k => { const v = ev[k]; %>
                        <tr style="border-bottom: 1px solid var(--panel-border);">
                            <td style="padding: 0.25rem 0.5rem 0.25rem 0; color: var(--muted); vertical-align: top; white-space: nowrap;"><%= k %></td>
                            <td style="padding: 0.25rem 0; font-family: monospace; word-break: break-word;"><% if (typeof v === 'object') { %><pre style="margin: 0; font-size: 0.72rem; max-height: 160px; overflow: auto;"><%= JSON.stringify(v, null, 2) %></pre><% } else { %><%= String(v) %><% } %></td>
                        </tr>
                        <% }) %>
                    </table>
                    <% } %>
                    <% if (a.resolution_note || ev.ack_note) { %>
                    <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border); color: var(--muted);">
                        <strong style="color: <%= isSuperseded ? 'var(--muted)' : 'var(--good)' %>;"><%= isSuperseded ? 'Why superseded:' : 'Note:' %></strong> <%= a.resolution_note || ev.ack_note %>
                        <div style="font-size: 0.7rem; margin-top: 0.2rem;">by <%= ev.acknowledged_by || 'system' %> at <%= ev.acknowledged_at || a.resolved_at || '' %></div>
                    </div>
                    <% } %>
                    <% if (status === 'open') { %>
                    <div style="display: flex; gap: 0.4rem; margin-top: 0.6rem;">
                        <input type="text" placeholder="Resolution note (optional)" id="note-<%= a.id %>" style="flex: 1; padding: 0.3rem 0.5rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.75rem;">
                        <form method="POST" action="/manage/<%= guildId %>/twitch-analytics/anomaly/<%= a.id %>/ack?range=<%= range %>" style="margin: 0;" onsubmit="this.querySelector('[name=note]').value=document.getElementById('note-<%= a.id %>').value;">
                            <input type="hidden" name="note" value="">
                            <button type="submit" class="backfill-btn" style="padding: 0.3rem 0.6rem; font-size: 0.72rem;" title="Confirm this is real; keep in active queue"><i class="fas fa-check"></i> Ack</button>
                        </form>
                        <form method="POST" action="/manage/<%= guildId %>/twitch-analytics/anomaly/<%= a.id %>/false-positive?range=<%= range %>" style="margin: 0;" onsubmit="this.querySelector('[name=note]').value=document.getElementById('note-<%= a.id %>').value;" onclick="return confirm('Mark as false positive? This hides it from counts.');">
                            <input type="hidden" name="note" value="">
                            <button type="submit" class="backfill-btn" style="padding: 0.3rem 0.6rem; font-size: 0.72rem; color: var(--muted);" title="Mark false positive; remove from counts"><i class="fas fa-times"></i> False positive</button>
                        </form>
                        <form method="POST" action="/manage/<%= guildId %>/twitch-analytics/anomaly/<%= a.id %>/resolve?range=<%= range %>" style="margin: 0;" onsubmit="this.querySelector('[name=note]').value=document.getElementById('note-<%= a.id %>').value;">
                            <input type="hidden" name="note" value="">
                            <button type="submit" class="backfill-btn" style="padding: 0.3rem 0.6rem; font-size: 0.72rem; color: var(--good);" title="Acted on and closed"><i class="fas fa-flag-checkered"></i> Resolve</button>
                        </form>
                    </div>
                    <% } %>
                </div>
            </details>
            <% }) %>
        </div>
        <% } %>
    </div>

    </div><!-- /tab-pane operations: ANOMALIES — Wave 370 breakdown --><% } %>

    <!-- ===== SESSIONS ===== -->

    <% if (!locals.shareMode) { %><div class="tab-pane" data-tab-group="operations">

    <div class="section" id="sessions"><h2>Recent sessions</h2><div class="section-sub"><%= d.sessions.length %> session<%= d.sessions.length === 1 ? '' : 's' %> in window.</div></div>
    <div class="card" style="padding: 0.25rem 1rem;">
        <% if (!d.sessions.length) { %>
        <div class="empty">No sessions in this window.</div>
        <% } %>
        <% d.sessions.forEach(s => { %>
        <a class="table-row clickable<%= s.pre_connection ? ' pre-conn' : '' %>" href="/manage/<%= guildId %>/twitch-analytics/session/<%= s.id %>">
            <div class="main">
                <div class="title">
                    <%= new Date(s.started_at).toLocaleString('en-US', TZO) %>
                    <% if (!s.ended_at) { %><span class="pill live">Live</span><% } %>
                    <% if (s.pre_connection) { %><span class="pre-conn-badge" title="Predates OAuth — EventSub wasn't recording.">Pre-connection</span><% } %>
                    <span class="detail-arrow">· open detail →</span>
                </div>
                <div class="meta">
                    <% if (s.primary_category_name) { %><%= s.primary_category_name %> · <% } %>
                    <% if (s.title_at_start) { %><em style="color: var(--muted);">"<%= (s.title_at_start || '').slice(0, 60) %>"</em> · <% } %>
                    peak <%= fmt(s.peak_viewers) %> · avg <%= Math.round(Number(s.avg_viewers) || 0) %>
                    <% if (!s.pre_connection) { %>
                        · <%= fmt(s.total_msgs) %>M · <%= fmt(s.unique_chatters) %>C · <%= fmt(s.total_follows) %>F / <%= fmt(s.total_subs) %>S / <%= fmt(s.total_bits) %>b
                        <% if ((s.title_change_count + s.category_change_count) > 0) { %> · <%= s.title_change_count %>/<%= s.category_change_count %> edits<% } %>
                    <% } else { %>
                        <span style="color: var(--muted); font-style: italic;">· event data unavailable</span>
                    <% } %>
                </div>
            </div>
            <div class="side"><% if (s.duration_minutes) { %><%= Math.floor(s.duration_minutes/60) %>h <%= s.duration_minutes%60 %>m<% } else { %>in progress<% } %></div>
        </a>
        <% }) %>
    </div>
    <div class="footer-row" style="margin-top: 0.5rem;">
        <a href="/manage/<%= guildId %>/twitch-analytics/export.csv?type=sessions&range=<%= range %>"><i class="fas fa-file-csv"></i> Export sessions CSV</a>
        <a href="/manage/<%= guildId %>/twitch-analytics/export.csv?type=clips&range=<%= range %>"><i class="fas fa-file-csv"></i> Clips CSV</a>
        <a href="/manage/<%= guildId %>/twitch-analytics/export.csv?type=events&range=<%= range %>"><i class="fas fa-file-csv"></i> Events CSV</a>
        <a href="/manage/<%= guildId %>/twitch-analytics/export.csv?type=vods&range=<%= range %>"><i class="fas fa-file-csv"></i> VODs CSV</a>
        <a href="/manage/<%= guildId %>/twitch-analytics/export.csv?type=anomalies&range=<%= range %>"><i class="fas fa-file-csv"></i> Anomalies CSV</a>
    </div>

    </div><!-- /tab-pane operations: SESSIONS --><% } %>

    <!-- ===== ADMIN (super-admin only) ===== -->

    <div class="tab-pane" data-tab-group="admin">

    <% if (isSuperAdmin) { %>
    <div class="section admin" id="admin"><h2>Data and alerts</h2><div class="section-sub">Backfill history and alert, chat and AI settings.</div></div>
    <div class="grid cols-2">
        <div class="card">
            <h3>Backfill history</h3>
            <% if (!d.backfillHistory || !d.backfillHistory.length) { %>
            <div class="empty">No backfill runs recorded.</div>
            <% } %>
            <% (d.backfillHistory || []).slice(0, 10).forEach(h => {
                let counts = {}, errs = {};
                try { counts = JSON.parse(h.counts_json || '{}'); } catch {}
                try { errs = JSON.parse(h.errors_json || '{}'); } catch {}
                const errCount = Object.keys(errs).length;
            %>
            <div class="table-row"><div class="main"><div class="title"><%= h.trigger_source %> · <% if (h.ok) { %><span style="color: var(--good);">OK</span><% } else { %><span style="color: var(--bad);">FAIL</span><% } %> · <%= h.duration_ms %>ms</div><div class="meta">clips: <%= counts.clips || 0 %> · vods: <%= counts.vods || 0 %> · subs: <%= counts.sub_tiers || 0 %> · follows histogram: <%= counts.follower_histogram || 0 %><% if (errCount) { %> · <span style="color: var(--warn);"><%= errCount %> scope err<%= errCount === 1 ? '' : 's' %></span><% } %></div></div><div class="side"><%= new Date(h.started_at).toLocaleString('en-US', TZO) %></div></div>
            <% }) %>
        </div>

        <% const alertCfg = d.alertsConfig || {}; %>
        <div class="card">
            <h3>Alert configuration</h3>
            <form method="POST" action="/manage/<%= guildId %>/twitch-analytics/alerts">
                <div style="margin-bottom: 0.6rem;">
                    <label style="font-size: 0.825rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">Alert channel ID</label>
                    <input type="text" name="alert_channel_id" value="<%= alertCfg.alert_channel_id || '' %>" placeholder="Discord channel ID" style="width: 100%; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                </div>
                <div style="margin-bottom: 0.6rem;">
                    <label for="unfollow_channel_id" style="font-size: 0.825rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">Unfollow channel ID</label>
                    <input type="text" id="unfollow_channel_id" name="unfollow_channel_id" value="<%= alertCfg.unfollow_channel_id || '' %>" placeholder="Discord channel ID — leave empty to turn off" style="width: 100%; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                    <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.2rem;">Followers are checked every hour. Twitch doesn't report when someone unfollows, so each post gives the hour it happened in.</div>
                </div>
                <% const toggles = [
                    ['notify_hype_train', 'Hype trains'],
                    ['notify_record_peak', 'Record peak viewer'],
                    ['notify_anomaly_critical', 'Critical anomalies'],
                    ['notify_goal_reached', 'Goal reached'],
                    ['notify_charity_milestone', 'Charity milestone'],
                    ['notify_raid_in', 'Incoming raids'],
                    ['notify_first_time_chatter', 'First-time chatter'],
                    ['weekly_digest_enabled', 'Weekly digest (Mon 09:00 UTC)'],
                ]; %>
                <% toggles.forEach(([k, label]) => { %>
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; margin-bottom: 0.3rem;">
                    <input type="checkbox" name="<%= k %>" value="1" <%= alertCfg[k] ? 'checked' : '' %>>
                    <%= label %>
                </label>
                <% }) %>
                <div style="margin-top: 0.5rem;">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">Weekly digest DM user (optional)</label>
                    <input type="text" name="weekly_digest_dm_user_id" value="<%= alertCfg.weekly_digest_dm_user_id || '' %>" placeholder="Discord user ID" style="width: 100%; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                </div>
                <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border);">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">Streamer.bot WebSocket URL (optional)</label>
                    <input type="text" name="streamerbot_bridge_url" value="<%= alertCfg.streamerbot_bridge_url || '' %>" placeholder="ws://127.0.0.1:8080" style="width: 100%; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem; margin-top: 0.4rem;">
                        <input type="checkbox" name="streamerbot_bridge_enabled" value="1" <%= alertCfg.streamerbot_bridge_enabled ? 'checked' : '' %>>
                        Enable Streamer.bot bridge (pushes sub/cheer/raid/hype events)
                    </label>
                </div>
                <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border);">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">Chat sampling + chatter identities</label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="chat_sampling_enabled" value="1" <%= alertCfg.chat_sampling_enabled ? 'checked' : '' %>>
                        Sample chat messages for emote/word/sentiment analysis
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="chatter_identities_enabled" value="1" <%= alertCfg.chatter_identities_enabled ? 'checked' : '' %>>
                        Track chatter identities (for Top Chatters + repeat-chatter metrics)
                    </label>
                </div>

                <% const canBan = (broadcaster.tier_b_scopes || []).includes('moderator:manage:banned_users');
                   const kb = d.knownBotBans || { counts: {}, recent: [] }; %>
                <% const kbdMode = alertCfg.kbd_mode || 'off';
                   const kbd = d.kbdActions || { counts: {}, recent: [] };
                   const kbdBanned = (kbd.counts.ban && kbd.counts.ban.ok) || 0, kbdDeleted = (kbd.counts.delete && kbd.counts.delete.ok) || 0,
                         kbdDetected = (kbd.counts.detected && kbd.counts.detected.n) || 0; %>
                <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border);">
                    <label for="kbd_mode" style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">KumaBot Defender</label>
                    <select id="kbd_mode" name="kbd_mode" style="padding: 0.3rem 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
                        <option value="off" <%= kbdMode === 'off' ? 'selected' : '' %>>Off</option>
                        <option value="detect" <%= kbdMode === 'detect' ? 'selected' : '' %>>Detect only: log what it would do</option>
                        <option value="enforce" <%= kbdMode === 'enforce' ? 'selected' : '' %> <%= canBan ? '' : 'disabled' %>>On: ban and remove</option>
                    </select>
                    <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.25rem; line-height: 1.45;">
                        BearOrso's KumaBot Defender protections for your chat: accounts on the shared KBD banlist, known bot account names and
                        follower/viewer-selling spam are banned; known scam links are removed, and the sender is banned on a repeat.
                        Never acted on: you, mods, VIPs, subscribers, channel service bots, and anyone unbanned below. At most 20 bans a minute.
                        Off by default.
                    </div>
                    <% if (!canBan) { %>
                    <div style="font-size: 0.75rem; margin-top: 0.3rem;">"On" needs write permissions with ban access. <a href="/auth/twitch/broadcaster-write/<%= guildId %>" style="color: var(--accent);">Grant write permissions</a></div>
                    <% } %>
                    <% if (kbd.recent.length) { %>
                    <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem;">
                        <%= kbdBanned %> banned · <%= kbdDeleted %> messages removed<%= kbdDetected ? ` · ${kbdDetected} detected in detect-only mode` : '' %>
                    </div>
                    <div style="max-height: 220px; overflow-y: auto; margin-top: 0.25rem; border: 1px solid var(--panel-border); border-radius: 4px;">
                        <% kbd.recent.forEach(k => { %>
                        <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem; font-size: 0.775rem; border-bottom: 1px solid var(--panel-border);">
                            <span style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;" title="<%= k.reason || '' %>"><%= k.target_username || k.target_user_id %></span>
                            <span style="color: var(--muted);"><%= k.action === 'detected' ? 'detected' : k.action === 'delete' ? 'message removed' : 'banned' %><%= k.success ? '' : ' (failed)' %> <%= new Date(k.created_at).toISOString().slice(0, 10) %></span>
                            <% if (k.action === 'ban' && k.success && k.target_user_id) { %>
                            <button type="submit" formaction="/manage/<%= guildId %>/twitch-controls/kbd-unban?range=<%= range %>" formmethod="post" formnovalidate name="kbd_unban" value="<%= k.target_user_id %>:<%= k.target_username || '' %>"
                                    style="font-size: 0.7rem; padding: 0.1rem 0.5rem; background: transparent; border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); cursor: pointer;">Unban</button>
                            <% } %>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border);">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">Known-bot accounts</label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="known_bot_autoban_enabled" value="1" <%= alertCfg.known_bot_autoban_enabled ? 'checked' : '' %> <%= canBan ? '' : 'disabled' %>>
                        Ban known bots on sight
                    </label>
                    <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.25rem; line-height: 1.45;">
                        While you're live, accounts on CommanderRoot's known-bot list that appear in chat are banned, with the reason recorded in your Twitch mod log.
                        Never banned: mods, VIPs, subscribers, anyone who has chatted in your channel, channel service bots, and anyone you unban below.
                        Needs chat sampling on (that's how we know who has chatted). At most 20 bans a minute.
                    </div>
                    <% if (!canBan) { %>
                    <div style="font-size: 0.75rem; margin-top: 0.3rem;">Needs write permissions with ban access. <a href="/auth/twitch/broadcaster-write/<%= guildId %>" style="color: var(--accent);">Grant write permissions</a></div>
                    <% } else if (alertCfg.known_bot_autoban_enabled && !alertCfg.chat_sampling_enabled) { %>
                    <div style="font-size: 0.75rem; margin-top: 0.3rem; color: var(--warn);">Paused: turn on chat sampling above.</div>
                    <% } %>
                    <% if (kb.recent.length) { %>
                    <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem;">
                        <%= kb.counts.banned || 0 %> banned · <%= kb.counts.exempt || 0 %> unbanned and exempt<%= kb.counts.failed ? ` · ${kb.counts.failed} failed` : '' %>
                    </div>
                    <div style="max-height: 220px; overflow-y: auto; margin-top: 0.25rem; border: 1px solid var(--panel-border); border-radius: 4px;">
                        <% kb.recent.forEach(b => { %>
                        <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem; font-size: 0.775rem; border-bottom: 1px solid var(--panel-border);">
                            <span style="flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;"><%= b.login || b.user_id %></span>
                            <span style="color: var(--muted);"><%= b.status === 'exempt' ? 'unbanned, exempt' : b.status === 'failed' ? 'failed' : 'banned' %> <%= new Date(b.updated_at).toISOString().slice(0, 10) %></span>
                            <% if (b.status === 'banned') { %>
                            <button type="submit" formaction="/manage/<%= guildId %>/twitch-controls/known-bot-unban?range=<%= range %>" formmethod="post" formnovalidate name="unban_user_id" value="<%= b.user_id %>"
                                    style="font-size: 0.7rem; padding: 0.1rem 0.5rem; background: transparent; border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); cursor: pointer;">Unban</button>
                            <% } %>
                        </div>
                        <% }) %>
                    </div>
                    <% } %>
                </div>

                <div style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--panel-border);">
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin-bottom: 0.2rem;">AI features (Gemini / local Ollama)</label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_enabled" value="1" <%= alertCfg.ai_enabled ? 'checked' : '' %>>
                        AI features enabled
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_auto_recap" value="1" <%= alertCfg.ai_auto_recap ? 'checked' : '' %>>
                        Auto-generate session recap after each stream
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_auto_sentiment" value="1" <%= alertCfg.ai_auto_sentiment ? 'checked' : '' %>>
                        Auto-score chat sentiment hourly (requires chat sampling)
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_auto_clip_hype" value="1" <%= alertCfg.ai_auto_clip_hype ? 'checked' : '' %>>
                        Auto-clip on hype train end (needs <code>clips:edit</code> Tier B)
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_chat_mod_enabled" value="1" <%= alertCfg.ai_chat_mod_enabled ? 'checked' : '' %>>
                        AI chat moderator queue (flags toxic messages for your review)
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_prediction_commentary" value="1" <%= alertCfg.ai_prediction_commentary ? 'checked' : '' %>>
                        AI commentary on channel-point predictions
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.825rem;">
                        <input type="checkbox" name="ai_pii_redaction" value="1" <%= alertCfg.ai_pii_redaction ? 'checked' : '' %>>
                        Redact PII from AI outputs before storing (recommended on)
                    </label>
                    <% const geminiReady = !!process.env.GOOGLE_API_KEY; const ollamaConfigured = !!(alertCfg.ai_ollama_url && String(alertCfg.ai_ollama_url).trim()); %>
                    <div style="display: flex; gap: 6px; margin: 0.4rem 0 0.3rem; flex-wrap: wrap;">
                        <span class="cf-status <%= geminiReady ? 'is-on' : 'is-warn' %>">Gemini <%= geminiReady ? 'ready' : 'missing API key' %></span>
                        <span class="cf-status <%= ollamaConfigured ? 'is-info' : 'is-muted' %>">Ollama <%= ollamaConfigured ? 'configured' : 'optional' %></span>
                    </div>
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin: 0.4rem 0 0.2rem;">Provider preference</label>
                    <select name="ai_provider_preference" style="width: 100%; padding: 0.3rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.75rem;">
                        <option value="gemini" <%= (!alertCfg.ai_provider_preference || alertCfg.ai_provider_preference === 'gemini') ? 'selected' : '' %>>Gemini (recommended — uses shared server API key)</option>
                        <option value="fallback_chain" <%= alertCfg.ai_provider_preference === 'fallback_chain' ? 'selected' : '' %>>Ollama → Gemini fallback (only if Ollama URL set below)</option>
                        <option value="ollama" <%= alertCfg.ai_provider_preference === 'ollama' ? 'selected' : '' %>>Ollama only (requires URL below; no fallback)</option>
                    </select>
                    <details style="margin-top: 0.4rem;" <%= ollamaConfigured ? 'open' : '' %>>
                        <summary style="font-size: 0.75rem; color: var(--muted); cursor: pointer;">Local Ollama (optional — leave blank to use Gemini)</summary>
                        <label style="font-size: 0.72rem; color: var(--muted); display: block; margin: 0.3rem 0 0.15rem;">Ollama URL</label>
                        <input type="text" name="ai_ollama_url" value="<%= alertCfg.ai_ollama_url || '' %>" placeholder="http://your-local-ip:11434" style="width: 100%; padding: 0.3rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.75rem;">
                        <label style="font-size: 0.72rem; color: var(--muted); display: block; margin: 0.3rem 0 0.15rem;">Ollama model</label>
                        <input type="text" name="ai_ollama_model" value="<%= alertCfg.ai_ollama_model || '' %>" placeholder="qwen2.5:14b" style="width: 100%; padding: 0.3rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.75rem;">
                    </details>
                    <label style="font-size: 0.75rem; color: var(--muted); display: block; margin: 0.4rem 0 0.2rem;">Daily AI call cap</label>
                    <input type="number" name="ai_daily_call_cap" value="<%= alertCfg.ai_daily_call_cap || 200 %>" min="10" max="10000" style="width: 100%; padding: 0.3rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.75rem;">
                </div>

                <button type="submit" class="backfill-btn" style="margin-top: 0.5rem;"><i class="fas fa-save"></i> Save alerts</button>
            </form>
        </div>
    </div>

    <!-- AI mod queue + usage dashboard links -->
    <div class="section admin" id="admin-ai"><h2>AI tools</h2><div class="section-sub">Moderation queue and usage.</div></div>
    <div class="card" style="margin-top: 0.75rem; border-left: 3px solid var(--accent);">
        <h3>AI tools</h3>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/manage/<%= guildId %>/twitch-analytics/mod-queue" class="backfill-btn"><i class="fas fa-shield-halved"></i> Mod queue</a>
            <% if (isSuperAdmin) { %>
            <a href="/admin/twitch-analytics/ai-usage" class="backfill-btn"><i class="fas fa-chart-bar"></i> AI usage dashboard</a>
            <% } %>
        </div>
    </div>

    <!-- Chatter watch management -->
    <div class="section admin" id="admin-watch"><h2>Chatter watch</h2><div class="section-sub">Get alerted when specific users enter chat.</div></div>
    <% const watchList = d.chatterWatch || []; %>
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Chatter watch list — alert me when these users enter chat</h3>
        <form method="POST" action="/manage/<%= guildId %>/twitch-controls/watch/add?range=<%= range %>" style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
            <input type="text" name="login" placeholder="Twitch username" required style="width: 180px; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
            <input type="text" name="label" placeholder="Label (why watch this user?)" style="flex: 1; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
            <button type="submit" class="backfill-btn"><i class="fas fa-eye"></i> Add watch</button>
        </form>
        <% if (!watchList.length) { %><div class="empty">No users watched. Enable "Watched chatter online" in Alert configuration above, then add usernames here.</div><% } %>
        <% watchList.forEach(w => { %>
        <div class="table-row">
            <div class="main"><div class="title"><%= w.chatter_user_login %></div><div class="meta"><%= w.label || '—' %></div></div>
            <div class="side">
                <form method="POST" action="/manage/<%= guildId %>/twitch-controls/watch/<%= w.id %>/remove?range=<%= range %>" style="margin: 0;" onclick="return confirm('Stop watching this user?');">
                    <button type="submit" style="background: transparent; border: 0; color: var(--muted); cursor: pointer;">×</button>
                </form>
            </div>
        </div>
        <% }) %>
    </div>

    <% const shares = d.shareTokens || []; %>
    <div class="section admin" id="admin-share"><h2>Share links</h2><div class="section-sub">Public read-only views and OBS overlays.</div></div>
    <div class="card" style="margin-top: 0.75rem;">
        <h3>Public share links</h3>
        <form method="POST" action="/manage/<%= guildId %>/twitch-analytics/share" style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
            <input type="text" name="label" placeholder="Label (optional)" style="flex: 1; padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
            <button type="submit" class="backfill-btn"><i class="fas fa-plus"></i> Create link</button>
        </form>
        <% if (!shares.length) { %><div class="empty">No share links.</div><% } %>
        <% shares.forEach(s => { %>
        <div class="table-row" style="flex-direction: column; align-items: stretch;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div class="main"><div class="title"><%= s.label || 'Unlabeled' %></div><div class="meta"><code><%= s.token %></code> · <%= s.view_count %> views<% if (s.last_viewed_at) { %> · last <%= relAgo(s.last_viewed_at) %><% } %></div></div>
                <div class="side"><a href="/share/twitch/<%= s.token %>" target="_blank" style="color: var(--accent);">Open →</a></div>
            </div>
            <div style="margin-top: 0.4rem; font-size: 0.72rem; color: var(--muted);">
                <strong style="color: var(--ink);">OBS overlays:</strong>
                <a href="/share/twitch/<%= s.token %>/obs?layout=stats" target="_blank" style="color: var(--accent); margin-right: 0.5rem;">stats</a>
                <a href="/share/twitch/<%= s.token %>/obs?layout=ticker" target="_blank" style="color: var(--accent); margin-right: 0.5rem;">ticker</a>
                <a href="/share/twitch/<%= s.token %>/obs?layout=hype" target="_blank" style="color: var(--accent); margin-right: 0.5rem;">hype</a>
                <a href="/share/twitch/<%= s.token %>/obs?layout=chat" target="_blank" style="color: var(--accent); margin-right: 0.5rem;">chat</a>
                <a href="/share/twitch/<%= s.token %>/obs?layout=charity" target="_blank" style="color: var(--accent); margin-right: 0.5rem;">charity</a>
                <a href="/share/twitch/<%= s.token %>/obs?layout=ai-copy" target="_blank" style="color: var(--accent); margin-right: 0.5rem;">ai-copy</a>
                · <a href="/share/twitch/<%= s.token %>.json" target="_blank" style="color: var(--accent);">JSON API</a>
            </div>
        </div>
        <% }) %>
    </div>
    <% } %>

    
    </div><!-- /tab-pane admin: ADMIN (super-admin only) -->
<!-- ===== Charts ===== -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="/js/cf-chart-theme.js"></script>
    <script>
    (function() {
        // ─── Chart colours: /js/cf-chart-theme.js (site tokens + fixed categorical order) ───
        const V = window.cfViz, S = V.series;
        const gridLine = V.grid;
        const axisTxt  = V.muted;
        const legendOpts = { labels: { color: axisTxt, usePointStyle: true, boxWidth: 6, font: { size: 11 } } };
        const purple = S[0], blue = S[1], green = S[2], gold = S[3], pink = S[4], cyan = S[1], red = V.status.critical;

        const timeline       = <%- JSON.stringify(d.viewerTimeline).replace(/</g, '\\u003c') %>;
        const growth         = <%- JSON.stringify(d.dailyGrowth).replace(/</g, '\\u003c') %>;
        const chatVelocity   = <%- JSON.stringify(d.chatVelocity || []).replace(/</g, '\\u003c') %>;
        const dowStats       = <%- JSON.stringify(d.dowStats || []).replace(/</g, '\\u003c') %>;
        const subTier        = <%- JSON.stringify(d.subTierBreakdown || null).replace(/</g, '\\u003c') %>;
        const followerAge    = <%- JSON.stringify(d.followerAgeHistogram || null).replace(/</g, '\\u003c') %>;
        const bitsLeaderData = <%- JSON.stringify(d.bitsLeaderboard || []).replace(/</g, '\\u003c') %>;
        const topClips       = <%- JSON.stringify(d.topClips || []).replace(/</g, '\\u003c') %>;
        const topGames       = <%- JSON.stringify(d.topGames || []).replace(/</g, '\\u003c') %>;
        const anomalies      = <%- JSON.stringify(d.recentAlerts || []).replace(/</g, '\\u003c') %>;

        // === VIEWER TIMELINE (line, dual-series) ===
        if (timeline.length && document.getElementById('viewerChart')) {
            new Chart(document.getElementById('viewerChart'), {
                type: 'line',
                data: {
                    labels: timeline.map(p => new Date(p.t).toLocaleString()),
                    datasets: [
                        { label: 'Avg viewers', data: timeline.map(p => p.avg), borderColor: purple, backgroundColor: V.alpha(purple, 0.15), fill: true, tension: 0.25, pointRadius: 0, borderWidth: 1.5 },
                        { label: 'Peak', data: timeline.map(p => p.peak), borderColor: V.alpha(purple, 0.55), borderDash: [4,3], fill: false, pointRadius: 0, borderWidth: 1 },
                    ],
                },
                options: { responsive: true, plugins: { legend: legendOpts }, scales: { x: { ticks: { color: axisTxt, maxTicksLimit: 10 }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt }, grid: { color: gridLine }, beginAtZero: true } } },
            });
        }

        // === CHAT VELOCITY (line) ===
        if (chatVelocity.length && document.getElementById('chatVelocityChart')) {
            new Chart(document.getElementById('chatVelocityChart'), {
                type: 'line',
                data: {
                    labels: chatVelocity.map(p => new Date(p.t).toLocaleString()),
                    datasets: [{ label: 'Msgs / interval', data: chatVelocity.map(p => p.msgs), borderColor: cyan, backgroundColor: V.alpha(cyan, 0.15), fill: true, tension: 0.25, pointRadius: 0, borderWidth: 1.5 }],
                },
                options: { responsive: true, plugins: { legend: legendOpts }, scales: { x: { ticks: { color: axisTxt, maxTicksLimit: 8 }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt }, grid: { color: gridLine }, beginAtZero: true } } },
            });
        }

        // === DAILY GROWTH (stacked bar) ===
        if (growth.length && document.getElementById('growthChart')) {
            new Chart(document.getElementById('growthChart'), {
                type: 'bar',
                data: {
                    labels: growth.map(p => new Date(p.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric' })),
                    datasets: [
                        { label: 'Follows', data: growth.map(p => p.follows), backgroundColor: purple },
                        { label: 'Subs', data: growth.map(p => p.subs), backgroundColor: green },
                        { label: 'Gift subs', data: growth.map(p => p.gift_subs), backgroundColor: blue },
                    ],
                },
                options: { responsive: true, plugins: { legend: legendOpts }, scales: { x: { ticks: { color: axisTxt }, grid: { color: gridLine }, stacked: true }, y: { ticks: { color: axisTxt }, grid: { color: gridLine }, stacked: true, beginAtZero: true } } },
            });
        }

        // === DOW RADAR ===
        if (dowStats.length && document.getElementById('dowRadarChart')) {
            const labels = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
            new Chart(document.getElementById('dowRadarChart'), {
                type: 'radar',
                data: {
                    labels,
                    datasets: [
                        { label: 'Avg viewers', data: dowStats.map(s => s.avg_viewers || 0), borderColor: purple, backgroundColor: V.alpha(purple, 0.14), borderWidth: 1.5, pointRadius: 2 },
                        { label: 'Msgs / 100', data: dowStats.map(s => (s.total_msgs || 0) / 100), borderColor: cyan, backgroundColor: V.alpha(cyan, 0.1), borderWidth: 1.5, pointRadius: 2 },
                    ],
                },
                options: { responsive: true, plugins: { legend: legendOpts }, scales: { r: { angleLines: { color: gridLine }, grid: { color: gridLine }, pointLabels: { color: axisTxt }, ticks: { color: axisTxt, backdropColor: 'transparent' } } } },
            });
        }

        // === SUB TIER DOUGHNUT ===
        if (subTier && document.getElementById('subTierDoughnut')) {
            new Chart(document.getElementById('subTierDoughnut'), {
                type: 'doughnut',
                data: {
                    labels: ['Tier 1', 'Tier 2', 'Tier 3', 'Prime'],
                    datasets: [{ data: [subTier.tier_1000_count, subTier.tier_2000_count, subTier.tier_3000_count, subTier.prime_count], backgroundColor: S.slice(0, 4) }],
                },
                options: { responsive: true, plugins: { legend: legendOpts } },
            });
        }

        // === FOLLOWER AGE HISTOGRAM ===
        if (followerAge && document.getElementById('followerAgeChart')) {
            new Chart(document.getElementById('followerAgeChart'), {
                type: 'bar',
                data: {
                    labels: ['<1d', '1-7d', '7-30d', '30-90d', '90d-1y', '1y+'],
                    datasets: [{ label: 'Followers', data: [followerAge.bucket_lt_1d, followerAge.bucket_1d_7d, followerAge.bucket_7d_30d, followerAge.bucket_30d_90d, followerAge.bucket_90d_1y, followerAge.bucket_1y_plus], backgroundColor: green }],
                },
                options: { responsive: true, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: axisTxt }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt }, grid: { color: gridLine }, beginAtZero: true } } },
            });
        }

        // === BITS LEADERBOARD ===
        if (bitsLeaderData.length && document.getElementById('bitsLeaderboardChart')) {
            const top = bitsLeaderData.slice(0, 10);
            new Chart(document.getElementById('bitsLeaderboardChart'), {
                type: 'bar',
                data: { labels: top.map(e => e.user_name || e.user_login || '?'), datasets: [{ label: 'Bits', data: top.map(e => e.score || 0), backgroundColor: gold }] },
                options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: axisTxt }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt }, grid: { color: gridLine } } } },
            });
        }

        // === TOP CLIPS BY VIEWS ===
        if (topClips.length && document.getElementById('topClipsChart')) {
            const top = topClips.slice(0, 10);
            new Chart(document.getElementById('topClipsChart'), {
                type: 'bar',
                data: { labels: top.map(c => (c.title || '?').slice(0, 40)), datasets: [{ label: 'Views', data: top.map(c => c.view_count || 0), backgroundColor: blue }] },
                options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: axisTxt }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt, font: { size: 10 } }, grid: { color: gridLine } } } },
            });
        }

        // === TOP GAMES BY LIVE MIN ===
        if (topGames.length && document.getElementById('topGamesChart')) {
            new Chart(document.getElementById('topGamesChart'), {
                type: 'bar',
                data: { labels: topGames.map(g => g.game), datasets: [{ label: 'Hours live', data: topGames.map(g => Math.round(Number(g.total_min) / 60 * 10) / 10), backgroundColor: purple }] },
                options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: axisTxt }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt, font: { size: 11 } }, grid: { color: gridLine } } } },
            });
        }

        // === ANOMALY SCATTER ===
        if (anomalies.length && document.getElementById('anomalyScatterChart')) {
            const sevMap = { info: 1, warning: 2, critical: 3 };
            const sevColor = (s) => s === 'critical' ? red : s === 'warning' ? V.status.warning : purple;
            new Chart(document.getElementById('anomalyScatterChart'), {
                type: 'scatter',
                data: { datasets: [{ label: 'Anomaly', data: anomalies.map(a => ({ x: new Date(a.created_at).getTime(), y: sevMap[a.severity] || 1, type: a.alert_type })), backgroundColor: anomalies.map(a => sevColor(a.severity)), pointRadius: 5 }] },
                options: { responsive: true, plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx) => ctx.raw.type + ' (' + new Date(ctx.raw.x).toLocaleString() + ')' } } }, scales: { x: { type: 'linear', ticks: { color: axisTxt, callback: (v) => new Date(v).toLocaleDateString() }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt, callback: (v) => ({ 1: 'info', 2: 'warn', 3: 'crit' })[v] || v }, grid: { color: gridLine }, min: 0, max: 4 } } },
            });
        }

        // === HISTORICAL PEAK TRAJECTORY (viewership) ===
        const peakTrack = <%- JSON.stringify(peakTrack).replace(/</g, '\\u003c') %>;
        if (peakTrack.length >= 2 && document.getElementById('peakTrajectoryChart')) {
            // Compute a simple linear-regression trend line so the broadcaster can see
            // trajectory direction at a glance. y = m*x + b over normalised x = index.
            const n = peakTrack.length;
            const avgX = (n - 1) / 2;
            const avgY = peakTrack.reduce((a, p) => a + p.peak, 0) / n;
            let num = 0, den = 0;
            peakTrack.forEach((p, i) => { num += (i - avgX) * (p.peak - avgY); den += (i - avgX) ** 2; });
            const slope = den ? num / den : 0;
            const intercept = avgY - slope * avgX;
            const trend = peakTrack.map((_, i) => Math.max(0, Math.round(intercept + slope * i)));
            new Chart(document.getElementById('peakTrajectoryChart'), {
                type: 'line',
                data: {
                    labels: peakTrack.map(p => new Date(p.t).toLocaleDateString()),
                    datasets: [
                        { label: 'Peak viewers', data: peakTrack.map(p => p.peak), borderColor: purple, backgroundColor: V.alpha(purple, 0.15), fill: true, tension: 0.25, pointRadius: 2, borderWidth: 1.5 },
                        { label: 'Trend', data: trend, borderColor: V.alpha(green, 0.85), borderDash: [6, 4], fill: false, pointRadius: 0, borderWidth: 1.2 },
                    ],
                },
                options: { responsive: true, plugins: { legend: legendOpts }, scales: { x: { ticks: { color: axisTxt, maxTicksLimit: 10 }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt }, grid: { color: gridLine }, beginAtZero: true } } },
            });
        }

        // === FUNNEL CHART (community) — horizontal bar with decreasing stages ===
        const funnelData = <%- JSON.stringify(funnelData).replace(/</g, '\\u003c') %>;
        if (funnelData && funnelData.followers > 0 && document.getElementById('funnelChart')) {
            new Chart(document.getElementById('funnelChart'), {
                type: 'bar',
                data: {
                    labels: ['Followers', 'Subscribers', 'Mods + VIPs', '<%= liveStream ? 'Live viewers' : 'Peak chatters' %>'],
                    datasets: [{
                        data: [funnelData.followers, funnelData.subscribers, funnelData.roster, funnelData.active],
                        backgroundColor: purple,
                    }],
                },
                options: { indexAxis: 'y', responsive: true, plugins: { legend: { display: false }, tooltip: { callbacks: { afterLabel: (ctx) => { const base = funnelData.followers || 1; const pct = ((ctx.raw / base) * 100).toFixed(1); return pct + '% of followers'; } } } }, scales: { x: { ticks: { color: axisTxt }, grid: { color: gridLine } }, y: { ticks: { color: axisTxt }, grid: { color: gridLine } } } },
            });
        }

        // === SPARKLINES in headline tiles ===
        // Build 24-point mini series from viewerTimeline / dailyGrowth for each tile.
        const spark = (canvas, data, color) => {
            if (!canvas || !data.length) return;
            new Chart(canvas, {
                type: 'line',
                data: { labels: data.map((_, i) => i), datasets: [{ data, borderColor: color, backgroundColor: color + '22', borderWidth: 1.2, fill: true, tension: 0.3, pointRadius: 0 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { display: false }, y: { display: false } } },
            });
        };
        document.querySelectorAll('canvas.sparkline').forEach(c => {
            const kind = c.dataset.spark;
            let series = [];
            if (kind === 'peak') series = timeline.map(p => p.peak);
            else if (kind === 'msgs') series = timeline.map(p => p.msgs);
            else if (kind === 'live') series = growth.map(p => p.live_min);
            else if (kind === 'follows') series = growth.map(p => p.follows);
            else if (kind === 'subs') series = growth.map(p => p.subs);
            else if (kind === 'bits') series = growth.map(p => p.bits);
            const color = kind === 'follows' ? green : kind === 'subs' || kind === 'bits' ? gold : purple;
            spark(c, series, color);
        });

        // === AUTO-REFRESH — polls every 60s while stream is live, toggle persists per user ===
        const refreshToggle = document.getElementById('autoRefreshToggle');
        if (refreshToggle) {
            let refreshTimer = null;
            const startRefresh = () => {
                if (refreshTimer) return;
                refreshTimer = setInterval(() => { window.location.reload(); }, 60_000);
                refreshToggle.closest('.live-refresh-toggle').classList.add('active');
            };
            const stopRefresh = () => {
                if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
                refreshToggle.closest('.live-refresh-toggle').classList.remove('active');
            };
            refreshToggle.addEventListener('change', async () => {
                const enabled = refreshToggle.checked;
                // Persist pref
                fetch('/manage/<%= guildId %>/twitch-analytics/prefs', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ auto_refresh: enabled ? '1' : '0', timezone: '<%= prefs.timezone || "UTC" %>' }),
                }).catch(() => {});
                if (enabled) startRefresh(); else stopRefresh();
            });
            if (refreshToggle.checked) startRefresh();
        }

        // ─── Chart PNG export buttons ───
        document.querySelectorAll('.export-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.chart;
                const canvas = document.getElementById(id);
                if (!canvas) return;
                const link = document.createElement('a');
                link.download = id + '-' + Date.now() + '.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        });

        // ─── Timezone picker — persist pref; triggers reload for server-side tz rendering ───
        const tzPicker = document.getElementById('tzPicker');
        if (tzPicker) {
            tzPicker.addEventListener('change', () => {
                fetch('/manage/<%= guildId %>/twitch-analytics/prefs', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ timezone: tzPicker.value, auto_refresh: document.getElementById('autoRefreshToggle')?.checked ? '1' : '0' }),
                }).then(() => { setTimeout(() => window.location.reload(), 200); }).catch(() => {});
            });
        }

        // ─── Collapsible sections — chevron toggles + localStorage persistence. DOM-only
        // (no innerHTML on user content; keeps the strict-XSS reviewer happy). ───
        const SECTIONS_LS_KEY = 'twitch-analytics.collapsed';
        let collapsed = [];
        try { collapsed = JSON.parse(localStorage.getItem(SECTIONS_LS_KEY) || '[]'); } catch {}
        document.querySelectorAll('.section[id]').forEach(section => {
            if (collapsed.includes(section.id)) section.classList.add('collapsed');
            const btn = document.createElement('button');
            btn.className = 'collapse-btn';
            btn.title = 'Collapse section';
            const icon = document.createElement('i');
            icon.className = 'fas fa-chevron-down';
            btn.appendChild(icon);
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                section.classList.toggle('collapsed');
                const next = Array.from(document.querySelectorAll('.section.collapsed')).map(s => s.id).filter(Boolean);
                try { localStorage.setItem(SECTIONS_LS_KEY, JSON.stringify(next)); } catch {}
            });
            section.appendChild(btn);
        });

        // ─── AI feature triggers — small JS layer that fetches /twitch-ai/* and renders results inline. ───
        // All DOM-built (no innerHTML) to keep the strict-XSS reviewer happy.
        window.aiSuggestStreamTitles = async function () {
            const btn = document.getElementById('aiSuggestTitles');
            const results = document.getElementById('aiTitleResults');
            btn.disabled = true;
            btn.textContent = 'Generating…';
            try {
                const r = await fetch('/manage/<%= guildId %>/twitch-ai/stream-titles', {
                    method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: '',
                });
                const j = await r.json();
                while (results.firstChild) results.removeChild(results.firstChild);
                if (!j.ok) {
                    const p = document.createElement('div');
                    p.style.cssText = 'color: var(--bad); font-size: 0.75rem;';
                    p.textContent = 'AI error: ' + (j.error || 'unknown');
                    results.appendChild(p);
                } else {
                    const header = document.createElement('div');
                    header.style.cssText = 'font-size: 0.7rem; color: var(--muted); margin-bottom: 0.3rem;';
                    header.textContent = 'Click to use (' + j.provider + '):';
                    results.appendChild(header);
                    for (const t of (j.titles || [])) {
                        const b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'backfill-btn';
                        b.style.cssText = 'display: block; width: 100%; text-align: left; margin-bottom: 0.25rem; font-size: 0.775rem; padding: 0.3rem 0.5rem; white-space: normal;';
                        b.textContent = t;
                        b.addEventListener('click', () => {
                            document.getElementById('titleInput').value = t;
                        });
                        results.appendChild(b);
                    }
                    if (j.reasoning) {
                        const p = document.createElement('div');
                        p.style.cssText = 'font-size: 0.7rem; color: var(--muted); margin-top: 0.3rem; font-style: italic;';
                        p.textContent = j.reasoning;
                        results.appendChild(p);
                    }
                }
                results.style.display = 'block';
            } catch (e) {
                results.textContent = 'AI call failed: ' + e.message;
                results.style.display = 'block';
            } finally {
                btn.disabled = false;
                btn.textContent = 'AI suggest titles';
            }
        };

        window.aiAnalyzeChatter = async function (login) {
            if (!confirm('Generate AI persona analysis for ' + login + '? (Uses one AI call from your daily cap.)')) return;
            try {
                const r = await fetch('/manage/<%= guildId %>/twitch-ai/chatter/' + encodeURIComponent(login) + '/persona', { method: 'POST' });
                const j = await r.json();
                alert(j.ok ? ('Persona: ' + (j.persona || '(empty)') + '\n\nVibe: ' + (j.vibe || 'unclear')) : ('AI error: ' + (j.error || 'unknown')));
            } catch (e) { alert('AI failed: ' + e.message); }
        };

        window.aiTuneAutomod = async function () {
            const btn = document.getElementById('aiTuneAutomodBtn');
            if (btn) { btn.disabled = true; btn.textContent = 'Analyzing…'; }
            try {
                const r = await fetch('/manage/<%= guildId %>/twitch-ai/automod/tune', { method: 'POST' });
                const j = await r.json();
