        <!-- Launch poll + launch raid -->
        <div class="card accent-events">
            <h3>Launch poll</h3>
            <form method="POST" action="/manage/<%= guildId %>/twitch-controls/create-poll?range=<%= range %>" style="display: flex; flex-direction: column; gap: 0.3rem;">
                <input type="text" name="title" placeholder="Question" maxlength="60" style="padding: 0.4rem; background: var(--field-bg); border: 1px solid var(--panel-border); border-radius: 4px; color: var(--ink); font-size: 0.825rem;">
