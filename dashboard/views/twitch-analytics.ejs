    <!-- ===== Tab switcher (Phase 1) ===== -->
    <script>
    (function() {
        const links = Array.from(document.querySelectorAll('.tab-nav .tab-link'));
        const panes = Array.from(document.querySelectorAll('.tab-pane'));
        // Tabs on the page (a share link has only Audience and Content).
        const valid = new Set(links.map(a => a.dataset.tab));
        const fallback = valid.has('live') ? 'live' : (links[0] ? links[0].dataset.tab : 'audience');
        let pendingTarget = null;
        // "#tab=name", or a section id such as #controls / #admin / #alerts that the server
        // redirects to after an action: open the tab holding that section and scroll to it.
        function parseHash() {
            const h = location.hash || '';
            const m = h.match(/tab=([a-z]+)/);
            if (m && valid.has(m[1])) return m[1];
            const id = h.slice(1);
            if (/^[A-Za-z][\w-]*$/.test(id)) {
                const el = document.getElementById(id);
                const pane = el && el.closest('.tab-pane');
                if (pane && valid.has(pane.dataset.tabGroup)) { pendingTarget = el; return pane.dataset.tabGroup; }
            }
            return fallback;
        }
        function activate(name, opts) {
            opts = opts || {};
            links.forEach(a => a.classList.toggle('active', a.dataset.tab === name));
            panes.forEach(p => { p.hidden = p.dataset.tabGroup !== name; });
            document.body.dataset.activeTab = name;
            const subNav = document.getElementById('subNav');
            if (subNav) {
                const sections = panes.filter(p => !p.hidden).flatMap(p => Array.from(p.querySelectorAll('.section[id]')));
                subNav.replaceChildren(...(sections.length > 1 ? sections : []).map(sec => {
                    const a = document.createElement('a');
                    a.href = '#' + sec.id;
                    a.textContent = sec.querySelector('h2')?.textContent || sec.id;
                    a.addEventListener('click', (e) => { e.preventDefault(); sec.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
                    return a;
                }));
            }
            document.querySelectorAll('.range-nav a[data-key]').forEach(a => {
                a.href = '?range=' + encodeURIComponent(a.dataset.key) + '#tab=' + name;
            });
            document.dispatchEvent(new CustomEvent('cf:tab', { detail: name }));
            // Nudge any Chart.js charts now visible so they resize to the new container.
            if (window.Chart && Chart.instances) {
                requestAnimationFrame(() => {
                    for (const id in Chart.instances) {
                        try { Chart.instances[id].resize(); } catch {}
                    }
                });
            }
            // Preserve the range query but swap the hash.
            try { history.replaceState(null, '', location.pathname + location.search + '#tab=' + name); } catch {}
            if (!opts.keepScroll) window.scrollTo({ top: 0, behavior: 'instant' });
        }
        // On first paint, briefly leave all tab-panes visible so Chart.js can measure containers;
        // then activate the chosen tab on the next animation frame.
        requestAnimationFrame(() => {
            activate(parseHash(), { keepScroll: true });
            if (pendingTarget) { const t = pendingTarget; pendingTarget = null; requestAnimationFrame(() => t.scrollIntoView({ block: 'start' })); }
        });
        links.forEach(a => a.addEventListener('click', (e) => {
            e.preventDefault();
            activate(a.dataset.tab);
        }));
        window.addEventListener('hashchange', () => activate(parseHash()));
    })();
    </script>

    <!-- ===== Result of the last action ===== -->
    <script>
    (function () {
        const box = document.getElementById('opNotice');
        if (!box) return;
        const q = new URLSearchParams(location.search);
        const ops = { title: 'Update the title and category', snooze_ad: 'Snooze the next ad', raid: 'Start the raid', shield_on: 'Turn Shield Mode on',
            shield_off: 'Turn Shield Mode off', chat_settings: 'Change chat modes', poll: 'Start the poll', clip: 'Create a clip', ban: 'Ban the user',
            timeout: 'Time out the user', warn: 'Warn the user', unban_approved: 'Approve the unban request', unban_denied: 'Deny the unban request',
            blocked_add: 'Add the blocked term', blocked_remove: 'Remove the blocked term', known_bot_unban: 'Unban the account', kbd_unban: 'Unban the account' };
        const auth = { ok: ['ok', 'Write permission granted. Stream controls are on the Live tab.'], denied: ['bad', 'Write permission was not granted.'],
            failed: ['bad', 'Connecting write permission failed. Try again.'], no_code: ['bad', 'Twitch did not finish the sign-in. Try again.'],
            wrong_user: ['bad', 'That Twitch account is not the connected broadcaster. Sign in as the channel owner.'],
            no_broadcaster: ['bad', 'Connect the broadcaster account on the Role sync tab first.'] };
        let tone = null, text = '';
        const op = q.get('op'), act = q.get('action');
        if (op && (act === 'ok' || act === 'fail')) {
            const what = ops[op] || 'That action';
            tone = act === 'ok' ? 'ok' : 'bad';
            text = act === 'ok' ? what + ': done.' : what + ': it did not work. Check that write permission is granted; details are in the action log.';
        } else if (auth[q.get('writeauth')]) {
            [tone, text] = auth[q.get('writeauth')];
        } else if (q.get('share') === 'fail') { tone = 'bad'; text = 'The share link could not be created.'; }
        else if (q.get('alerts') === 'fail') { tone = 'bad'; text = 'The alert settings were not saved.'; }
        else if (q.get('peer') === 'fail') { tone = 'bad'; text = 'The peer comparison setting was not changed.'; }
        if (!tone) return;
        box.classList.add(tone === 'ok' ? 'is-ok' : 'is-bad');
        document.getElementById('opNoticeText').textContent = text;
        box.hidden = false;
        // Drop the one-off parameters so a reload does not repeat the message.
        ['op', 'action', 'writeauth', 'share', 'alerts', 'peer'].forEach(k => q.delete(k));
        try { history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : '') + location.hash); } catch (e) {}
    })();
    </script>

    <!-- ===== Live hero client (Phase 2) ===== -->
    <script>
    (function() {
        const root = document.getElementById('liveHero');
        if (!root) return;
        const POLL_MS = 20000;
        const $ = (id) => document.getElementById(id);
        const nf = new Intl.NumberFormat();
        let chart = null, timer = null, inflight = false;

        function el(tag, cls, text) {
            const n = document.createElement(tag);
            if (cls) n.className = cls;
            if (text != null) n.textContent = text;
            return n;
        }
        function dur(ms) {
            const m = Math.max(0, Math.floor(ms / 60000));
            const h = Math.floor(m / 60);
            return h ? `${h}h ${m % 60}m` : `${m}m`;
        }
        function ago(ts) {
            const s = Math.max(0, Math.floor((Date.now() - new Date(ts).getTime()) / 1000));
            if (s < 90) return `${s}s ago`;
            if (s < 5400) return `${Math.round(s / 60)}m ago`;
            if (s < 172800) return `${Math.round(s / 3600)}h ago`;
            return `${Math.round(s / 86400)}d ago`;
        }
        function spark(values) {
            const ns = 'http://www.w3.org/2000/svg';
            const svg = document.createElementNS(ns, 'svg');
            svg.setAttribute('viewBox', '0 0 100 22');
            svg.setAttribute('preserveAspectRatio', 'none');
            if (values.length < 2) return svg;
            const max = Math.max(...values, 1);
            const pts = values.map((v, i) => `${(i / (values.length - 1)) * 100},${21 - (v / max) * 20}`).join(' ');
            const line = document.createElementNS(ns, 'polyline');
            line.setAttribute('points', pts);
            line.setAttribute('fill', 'none');
            line.setAttribute('stroke', window.cfViz ? cfViz.series[0] : '#3987e5');
            line.setAttribute('stroke-width', '1.5');
            line.setAttribute('vector-effect', 'non-scaling-stroke');
            svg.appendChild(line);
            return svg;
        }
        function cumulative(series, idx) {
            let run = 0;
            return series.map(r => (run += r[idx]));
        }
        function stat(k, v, d, sparkValues) {
            const box = el('div', 'lh-stat');
            box.appendChild(el('div', 'k', k));
            box.appendChild(el('div', 'v', v));
            if (d) box.appendChild(el('div', 'd', d));
            if (sparkValues) box.appendChild(spark(sparkValues));
            return box;
        }

        function renderLive(d) {
            const badge = $('lhBadge');
            badge.textContent = 'Live';
            badge.classList.add('on');
            const parts = [];
            if (d.started_at) parts.push(dur(Date.now() - new Date(d.started_at).getTime()));
            if (d.category) parts.push(d.category);
            $('lhMeta').textContent = parts.join(' · ');
            $('lhTitle').textContent = d.title || '';

            const s = d.series || [];
            const stats = $('lhStats');
            stats.replaceChildren(
                stat('Viewers now', nf.format(d.viewers), `peak ${nf.format(d.peak_viewers)}`, s.map(r => r[1])),
                stat('Chat / min', nf.format(d.chat_per_min), '15-minute average', s.map(r => r[2])),
                stat('Category rank', d.rank ? (d.rank.pos ? '#' + nf.format(d.rank.pos) : '#' + nf.format(d.rank.of) + '+') : '—',
                     d.rank ? (d.rank.pos ? `by viewers in ${d.rank.game || 'category'}` : `not in the top ${nf.format(d.rank.of)}`) : 'updates every 5 minutes'),
                stat('Follows', nf.format(d.totals.follows), 'this stream', cumulative(s, 3)),
                stat('Subs', nf.format(d.totals.subs), 'incl. gifted, this stream', cumulative(s, 4)),
                stat('Bits', nf.format(d.totals.bits), 'this stream', cumulative(s, 5)),
            );
            drawChart(s);
        }

        function renderOffline(d) {
            const badge = $('lhBadge');
            badge.textContent = 'Offline';
            badge.classList.remove('on');
            const last = d.last_session;
            $('lhMeta').textContent = last ? `Last stream ended ${ago(last.ended_at)}` : 'No completed streams recorded yet';
            $('lhTitle').textContent = last?.title_at_start || '';
            $('lhChartWrap').hidden = true;
            const stats = $('lhStats');
            if (!last) { stats.replaceChildren(); return; }
            const subs = (Number(last.total_subs) || 0) + (Number(last.total_gift_subs) || 0);
            stats.replaceChildren(
                stat('Duration', dur((Number(last.duration_minutes) || 0) * 60000), last.primary_category_name || ''),
                stat('Peak viewers', nf.format(last.peak_viewers || 0)),
                stat('Avg viewers', nf.format(Math.round(Number(last.avg_viewers) || 0))),
                stat('Follows', nf.format(last.total_follows || 0)),
                stat('Subs', nf.format(subs), 'incl. gifted'),
                stat('Bits', nf.format(last.total_bits || 0)),
            );
        }

        function drawChart(series) {
            const wrap = $('lhChartWrap');
            if (!window.Chart || series.length < 2) { wrap.hidden = true; return; }
            wrap.hidden = false;
            const labels = series.map(r => new Date(r[0] * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
            const viewers = series.map(r => r[1]);
            const chat = series.map(r => r[2]);
            if (chart) {
                chart.data.labels = labels;
                chart.data.datasets[0].data = viewers;
                chart.data.datasets[1].data = chat;
                chart.update('none');
                return;
            }
            chart = new Chart($('lhChart'), {
                data: {
                    labels,
                    datasets: [
                        { type: 'line', label: 'Viewers', data: viewers, borderColor: window.cfViz ? cfViz.series[0] : '#3987e5', borderWidth: 2, pointRadius: 0, tension: 0.25, yAxisID: 'y' },
                        { type: 'bar', label: 'Chat messages / min', data: chat, backgroundColor: window.cfViz ? cfViz.alpha(cfViz.muted, 0.35) : 'rgba(154,160,166,0.3)', yAxisID: 'y1' },
                    ],
                },
                options: {
                    responsive: true, maintainAspectRatio: false, animation: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { labels: { boxWidth: 8, font: { size: 11 } } } },
                    scales: {
                        x: { ticks: { maxTicksLimit: 8, font: { size: 10 } }, grid: { display: false } },
                        y: { position: 'left', beginAtZero: true, ticks: { font: { size: 10 } } },
                        y1: { position: 'right', beginAtZero: true, ticks: { font: { size: 10 } }, grid: { display: false } },
                    },
                },
            });
        }

        function renderAlerts(alerts) {
            const box = $('lhAlerts');
            box.replaceChildren(...(alerts || []).map(a => {
                const row = el('div', 'lh-alert' + (a.severity === 'critical' ? ' critical' : ''));
                row.appendChild(el('strong', null, a.type.replace(/_/g, ' ')));
                if (a.note) row.appendChild(document.createTextNode(' — ' + a.note));
                row.appendChild(el('span', 'when', ago(a.at)));
                return row;
            }));
        }

        function heroVisible() {
            return !document.hidden && !root.closest('.tab-pane').hidden;
        }

        async function refresh() {
            if (inflight || !heroVisible()) return;
            inflight = true;
            try {
                const r = await fetch(root.dataset.feed, { credentials: 'same-origin', cache: 'no-store' });
                if (!r.ok) throw new Error('HTTP ' + r.status);
                const d = await r.json();
                if (!d.ok) throw new Error(d.error || 'feed error');
                if (d.live) renderLive(d); else renderOffline(d);
                renderAlerts(d.alerts);
                $('lhAsOf').textContent = d.as_of ? `updated ${ago(d.as_of)}` : '';
            } catch (e) {
                $('lhAsOf').textContent = 'live feed unavailable — retrying';
            } finally {
                inflight = false;
            }
        }

        function start() {
            if (timer) return;
            refresh();
            timer = setInterval(refresh, POLL_MS);
        }
        function stop() { clearInterval(timer); timer = null; }

        document.addEventListener('cf:tab', (e) => (e.detail === 'live' ? start() : stop()));
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : (heroVisible() && start())));
        requestAnimationFrame(() => requestAnimationFrame(() => { if (heroVisible()) start(); }));
    })();
    </script>
</body>
</html>
