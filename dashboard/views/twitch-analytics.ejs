        helpBox.appendChild(_title);
        [
            ['Range 24h / 7d / 30d / 90d', ['1','2','3','4']],
            ['Refresh backfill', ['R']],
            ['Toggle live refresh', ['L']],
            ['Show / hide this help', ['?']],
        ].forEach(([label, keys]) => {
            const row = document.createElement('div'); row.className = 'row';
            const l = document.createElement('span'); l.textContent = label; row.appendChild(l);
            const r = document.createElement('span');
            keys.forEach((k, i) => {
                if (i > 0) r.appendChild(document.createTextNode(' '));
                const kbd = document.createElement('kbd'); kbd.textContent = k; r.appendChild(kbd);
            });
            row.appendChild(r);
            helpBox.appendChild(row);
        });
        document.body.appendChild(helpBox);

        // ─── Keyboard shortcuts: 1/2/3/4 for range, R to refresh backfill ───
        document.addEventListener('keydown', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
            const map = { '1': '24h', '2': '7d', '3': '30d', '4': '90d' };
            if (map[e.key]) {
                const link = document.querySelector('.range-nav a[data-key="' + map[e.key] + '"]');
                if (link) link.click();
            } else if (e.key.toLowerCase() === 'r' && !e.ctrlKey && !e.metaKey) {
                const form = document.querySelector('form[action*="/backfill"]');
                if (form) form.submit();
            } else if (e.key.toLowerCase() === 'l' && !e.ctrlKey && !e.metaKey) {
                const toggle = document.getElementById('autoRefreshToggle');
                if (toggle) { toggle.checked = !toggle.checked; toggle.dispatchEvent(new Event('change')); }
            } else if (e.key === '?') {
                helpBox.classList.toggle('open');
            } else if (e.key === 'Escape') {
                helpBox.classList.remove('open');
            }
        });
    })();
    </script>
