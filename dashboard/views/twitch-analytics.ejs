<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link rel="manifest" href="/manifest.json">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/unified-dark-theme.css">
    <style>
        /* Page tokens point at the site tokens (cf-ui.css) so the page follows the theme. */
        :root {
            --panel-bg: var(--cf-surface);
            --panel-border: var(--cf-border);
            --muted: var(--cf-text-3);
            --ink: var(--cf-text);
            --field-bg: var(--cf-inset);

            /* Status and accent come from the site tokens. Section header hues
               below mark section clusters. Colours chosen
               to be legible against the dark background without competing with each other. */
            --accent: var(--cf-accent-fg);
            --accent-dim: var(--cf-accent-soft);
            --good: var(--cf-success);
            --warn: var(--cf-warning);
            --bad: var(--cf-danger);
            --blue: var(--cf-info);
            --cyan: #22d3ee;
            --orange: #f97316;
            --pink: #ec4899;

            /* Category hues — one per section cluster. */
            --hue-viewership: #9146ff;
            --hue-growth:     #4ade80;
            --hue-engagement: #22d3ee;
            --hue-content:    #38bdf8;
            --hue-monetize:   #e2b23a;
            --hue-events:     #ec4899;
            --hue-community:  #a855f7;
            --hue-moderation: #f97316;
            --hue-alerts:     #e35858;
            --hue-admin:      #9aa0a6;
        }
        /* Light/Sand: the bright 400-hues above wash out on a light surface; step them down. */
        :root:is([data-theme="light"], [data-theme="sand"]) {
            --cyan: #0e7490;
            --orange: #c2410c;
            --pink: #be185d;
            --hue-growth: #15803d;
            --hue-engagement: #0e7490;
            --hue-content: #0369a1;
            --hue-monetize: #a16207;
            --hue-events: #be185d;
            --hue-community: #7e22ce;
            --hue-moderation: #c2410c;
            --hue-alerts: #c53030;
            --hue-admin: #6b7280;
        }
        :root:is([data-theme="light"], [data-theme="sand"]) .progress-bar .fill { background: var(--accent); }
        :root:is([data-theme="light"], [data-theme="sand"]) .progress-bar.good .fill { background: var(--good); }
        :root:is([data-theme="light"], [data-theme="sand"]) .progress-bar.gold .fill { background: var(--warn); }
        :root:is([data-theme="light"], [data-theme="sand"]) .progress-bar.pink .fill { background: var(--pink); }
        :root:is([data-theme="light"], [data-theme="sand"]) .pre-conn { opacity: 1; }
        :root:is([data-theme="light"], [data-theme="sand"]) .kbd-help { box-shadow: var(--cf-shadow-pop); }
        body { background: var(--cf-bg); color: var(--ink); min-height: 100vh; }
        a { color: inherit; }
        code { color: inherit; background: color-mix(in srgb, var(--cf-text) 5%, transparent); padding: 1px 5px; border-radius: 3px; font-size: 0.825em; }
        .wrap { max-width: 1360px; margin: 0 auto; padding: 1.5rem 1.5rem 4rem; }

        /* === Header === */
        .page-head {
            display: flex; align-items: center; gap: 1.25rem;
            padding: 1.25rem 1.5rem; margin-bottom: 1rem;
            background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px;
        }
        .page-head .broadcaster-id { display: flex; flex-direction: column; min-width: 0; }
        .page-head h1 { font-size: 1.5rem; margin: 0; font-weight: 600; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
        .page-head .sub { color: var(--muted); font-size: 0.825rem; margin-top: 0.2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
        .page-head .right { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
        .pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 500; border: 1px solid var(--panel-border); background: var(--cf-veil-1); color: var(--muted); }
        .pill.live { background: color-mix(in srgb, var(--good) 14%, transparent); color: var(--cf-success-ink); border-color: color-mix(in srgb, var(--good) 40%, transparent); }
        .pill.admin { background: color-mix(in srgb, var(--warn) 14%, transparent); color: var(--cf-warning-ink); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
        .pill.pink { background: color-mix(in srgb, var(--pink) 14%, transparent); color: var(--pink); border-color: color-mix(in srgb, var(--pink) 40%, transparent); }
        .pill.purple { background: var(--accent-dim); color: var(--accent); border-color: var(--cf-accent-line); }

        /* === Sticky section nav === */
        .section-nav {
            position: sticky; top: var(--cf-header-h); z-index: 50;
            display: flex; gap: 0.3rem; padding: 0.5rem 0; margin: 0 0 1rem;
            background: var(--cf-bg);
            overflow-x: auto; -webkit-overflow-scrolling: touch;
            border-bottom: 1px solid var(--panel-border);
        }
        .section-nav::-webkit-scrollbar { height: 4px; }
        .section-nav::-webkit-scrollbar-thumb { background: var(--cf-veil-2); border-radius: 2px; }
        .section-nav a {
            white-space: nowrap; padding: 0.3rem 0.75rem; border-radius: 6px;
            text-decoration: none; color: var(--muted); font-size: 0.8rem;
            border: 1px solid transparent; display: inline-flex; align-items: center; gap: 0.4rem;
        }
        .section-nav a:hover { color: var(--ink); background: var(--cf-veil-1); }
        .section-nav a .dot { width: 6px; height: 6px; border-radius: 999px; display: inline-block; }
        /* === Primary tab bar (Phase 1) === */
        .tab-nav {
            position: sticky; top: var(--cf-header-h); z-index: 50;
            display: flex; gap: 0.3rem; padding: 0.65rem 0 0.75rem;
            margin: 0 0 1.25rem;
            background: var(--cf-bg);
            border-bottom: 1px solid var(--panel-border);
            overflow-x: auto; -webkit-overflow-scrolling: touch;
        }
        .tab-nav::-webkit-scrollbar { height: 4px; }
        .tab-nav::-webkit-scrollbar-thumb { background: var(--cf-veil-2); border-radius: 2px; }
        .tab-nav .tab-link {
            padding: 0.55rem 1.1rem; border-radius: 8px;
            text-decoration: none; color: var(--muted);
            font-size: 0.925rem; font-weight: 500;
            white-space: nowrap;
            border: 1px solid transparent;
            transition: color 0.1s ease, background 0.1s ease, border-color 0.1s ease;
        }
        .tab-nav .tab-link:hover { color: var(--ink); background: color-mix(in srgb, var(--cf-text) 3%, transparent); }
        .tab-nav .tab-link.active {
            color: var(--ink);
            background: var(--cf-surface-3);
            border-color: var(--cf-border-strong);
        }
        .tab-pane[hidden] { display: none !important; }
        /* === Calm pass (Phase 3) === */
        .card h3, .chart-card h3 { font-size: 0.8rem; font-weight: 500; color: var(--muted); text-transform: none; letter-spacing: 0; margin: 0 0 0.5rem; }
        .card .big { font-variant-numeric: tabular-nums; }
        .card[class*="accent-"] { border-left: 1px solid var(--panel-border); }
        .section { border-left: 0; padding-left: 0; margin: 2.25rem 0 0.85rem; }
        .section h2 { font-size: 1.05rem; }
        .progress-bar .fill { background: var(--accent); }
        .progress-bar.good .fill { background: var(--good); }
        .progress-bar.gold .fill { background: var(--warn); }
        .progress-bar.pink .fill { background: var(--pink); }
        .tab-nav { background: var(--cf-bg); }
        .sub-nav { display: flex; gap: 0.25rem; flex-wrap: wrap; margin: -0.5rem 0 1.25rem; }
        .sub-nav:empty { display: none; }
        .sub-nav a { padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.8rem; color: var(--muted); text-decoration: none; border: 1px solid var(--panel-border); }
        .sub-nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--cf-text) 3%, transparent); }
        body[data-active-tab="live"] .range-nav { display: none; }
        body[data-active-tab="live"] .range-note { display: none; }
        .range-note { color: var(--muted); font-size: 0.8rem; margin: -0.5rem 0 1rem; }

        /* === Live hero (Phase 2) === */
        .live-hero { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 12px; padding: 1.25rem 1.4rem; margin-bottom: 1.25rem; }
        .lh-status { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); }
        .lh-badge { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 6px; border: 1px solid var(--panel-border); color: var(--muted); }
        .lh-badge.on { color: var(--cf-success-ink); border-color: color-mix(in srgb, var(--good) 40%, transparent); background: color-mix(in srgb, var(--good) 10%, transparent); }
        .lh-asof { margin-left: auto; font-size: 0.75rem; }
        .lh-title { font-size: 1.05rem; color: var(--ink); margin: 0.65rem 0 1rem; overflow-wrap: anywhere; }
        .lh-title:empty { display: none; }
        .lh-stats { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; background: var(--panel-border); border: 1px solid var(--panel-border); border-radius: 10px; overflow: hidden; }
        .lh-stat { background: var(--cf-surface); padding: 0.85rem 1rem; min-width: 0; }
        .lh-stat .k { font-size: 0.72rem; color: var(--muted); }
        .lh-stat .v { font-size: 1.6rem; font-weight: 600; line-height: 1.15; margin-top: 0.15rem; font-variant-numeric: tabular-nums; }
        .lh-stat .d { font-size: 0.72rem; color: var(--muted); margin-top: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .lh-stat svg { display: block; width: 100%; height: 22px; margin-top: 0.4rem; }
        .lh-chart { position: relative; height: 190px; margin-top: 1rem; }
        .lh-alert { margin-top: 0.75rem; padding: 0.6rem 0.85rem; border-radius: 8px; font-size: 0.85rem; border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent); background: color-mix(in srgb, var(--warn) 8%, transparent); }
        .lh-alert.critical { border-color: color-mix(in srgb, var(--bad) 40%, transparent); background: color-mix(in srgb, var(--bad) 8%, transparent); }
        .lh-alert .when { color: var(--muted); margin-left: 0.5rem; font-size: 0.75rem; }
        @media (max-width: 1100px) { .lh-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
        @media (max-width: 600px) { .lh-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .live-hero { padding: 1rem; } }

        /* === Range selector === */
        .range-nav { display: flex; gap: 0.25rem; margin-bottom: 1rem; }
        .range-nav a {
            padding: 0.4rem 0.9rem; border-radius: 8px; text-decoration: none;
            background: var(--panel-bg); color: var(--muted); font-size: 0.875rem;
            border: 1px solid var(--panel-border);
        }
        .range-nav a.active { color: var(--ink); background: var(--cf-surface-3); border-color: var(--cf-border-strong); }
        .range-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
        .range-row .range-nav { margin-bottom: 0; flex-wrap: wrap; }
        .range-row .range-compare { color: var(--muted); font-size: 0.8rem; }
        .export-menu { margin-left: auto; position: relative; }
        .export-menu > summary { list-style: none; cursor: pointer; }
        .export-menu > summary::-webkit-details-marker { display: none; }
        .export-menu .export-list { position: absolute; right: 0; top: calc(100% + 4px); z-index: 60; min-width: 13rem; padding: 4px;
            background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-lg); box-shadow: var(--cf-shadow-pop); }
        .export-menu .export-list a { display: block; padding: 7px 10px; border-radius: var(--cf-radius-sm); color: var(--cf-text-2); text-decoration: none; font-size: 0.85rem; }
        .export-menu .export-list a:hover { background: var(--cf-surface-2); color: var(--ink); }
        a.table-row { color: inherit; text-decoration: none; }
        a.table-row:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: -2px; }
        .op-notice { margin-bottom: 1rem; }
        body.is-share .card:has(#journeyBtn, #peerBtn, #pivotBtn, #clipSearchForm, #transcriptSearchForm),
        body.is-share button[onclick^="ai"], body.is-share .collapse-btn { display: none !important; }
        .range-nav a:hover { color: var(--ink); }

        /* === Grids === */
        .grid { display: grid; gap: 0.75rem; }
        .grid.cols-6 { grid-template-columns: repeat(6, 1fr); }
        .grid.cols-5 { grid-template-columns: repeat(5, 1fr); }
        .grid.cols-4 { grid-template-columns: repeat(4, 1fr); }
        .grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
        .grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
        .grid.cols-2-3 { grid-template-columns: 2fr 3fr; }
        .grid.cols-1-2 { grid-template-columns: 1fr 2fr; }
        @media (max-width: 1100px) {
            .grid.cols-6, .grid.cols-5, .grid.cols-4 { grid-template-columns: repeat(3, 1fr); }
            .grid.cols-3, .grid.cols-2-3, .grid.cols-1-2 { grid-template-columns: 1fr; }
        }
        @media (max-width: 760px) {
            .grid.cols-6, .grid.cols-5, .grid.cols-4, .grid.cols-3 { grid-template-columns: repeat(2, 1fr); }
            .grid.cols-2 { grid-template-columns: 1fr; }
        }

        /* === Cards === */
        .card {
            background: var(--panel-bg); border: 1px solid var(--panel-border);
            border-radius: 10px; padding: 1rem 1.1rem;
        }
        .card h3 { font-size: 0.75rem; margin: 0 0 0.4rem; color: var(--muted); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
        .card .big { font-size: 1.5rem; font-weight: 600; margin: 0; line-height: 1.1; }
        .card .sub { color: var(--muted); font-size: 0.75rem; margin-top: 0.3rem; }
        .card.accent-viewership { border-left: 3px solid var(--hue-viewership); }
        .card.accent-growth { border-left: 3px solid var(--hue-growth); }
        .card.accent-monetize { border-left: 3px solid var(--hue-monetize); }
        .card.accent-events { border-left: 3px solid var(--hue-events); }
        .card.accent-moderation { border-left: 3px solid var(--hue-moderation); }
        .card.accent-alerts { border-left: 3px solid var(--hue-alerts); }

        /* === Section headers (colour-coded) === */
        .section {
            margin: 2rem 0 0.75rem; padding-left: 0.75rem; display: flex; align-items: baseline; gap: 0.75rem;
            border-left: 3px solid var(--panel-border); scroll-margin-top: 140px;
        }
        .section h2 { font-size: 1.1rem; margin: 0; font-weight: 600; }
        .section .section-sub { color: var(--muted); font-size: 0.825rem; }
        .section.viewership   { border-left-color: var(--hue-viewership); }
        .section.growth       { border-left-color: var(--hue-growth); }
        .section.engagement   { border-left-color: var(--hue-engagement); }
        .section.content      { border-left-color: var(--hue-content); }
        .section.monetize     { border-left-color: var(--hue-monetize); }
        .section.events       { border-left-color: var(--hue-events); }
        .section.community    { border-left-color: var(--hue-community); }
        .section.moderation   { border-left-color: var(--hue-moderation); }
        .section.alerts       { border-left-color: var(--hue-alerts); }
        .section.admin        { border-left-color: var(--hue-admin); }

        .chart-card { background: var(--panel-bg); border: 1px solid var(--panel-border); border-radius: 10px; padding: 1rem; position: relative; }
        .chart-card canvas { max-width: 100%; }
        .chart-card .export-btn {
            position: absolute; top: 0.5rem; right: 0.5rem; background: transparent; border: none;
            color: var(--muted); cursor: pointer; font-size: 0.75rem; padding: 2px 6px; border-radius: 4px;
        }
        .chart-card .export-btn:hover { color: var(--ink); background: color-mix(in srgb, var(--cf-text) 5%, transparent); }

        /* === Tables === */
        .table-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.25rem; border-bottom: 1px solid var(--panel-border); }
        .table-row:last-child { border-bottom: 0; }
        .table-row .main { flex: 1; min-width: 0; overflow: hidden; }
        .table-row .title { font-weight: 500; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .table-row .meta { font-size: 0.825rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .table-row .side { color: var(--muted); font-size: 0.75rem; text-align: right; flex-shrink: 0; }

        .empty { color: var(--muted); padding: 1.5rem; text-align: center; font-size: 0.875rem; }

        /* === Heatmap === */
        .heatmap { display: grid; grid-template-columns: 2.5rem repeat(24, 1fr); gap: 2px; font-size: 0.7rem; }
        .heatmap .hcell { aspect-ratio: 1 / 1; border-radius: 2px; background: color-mix(in srgb, var(--cf-viz-1, #3987e5) calc(var(--v, 0) * 100%), var(--cf-surface-2)); min-height: 14px; position: relative; }
        .heatmap .hcell.peak { outline: 2px solid var(--good); outline-offset: -1px; }
        .heatmap .hlabel { color: var(--muted); display: flex; align-items: center; }
        .heatmap .hhead { color: var(--muted); text-align: center; }

        /* === Progress bars (goals, charity) === */
        .progress-row { padding: 0.5rem 0.75rem; margin-bottom: 0.5rem; background: color-mix(in srgb, var(--cf-text) 2%, transparent); border-radius: 6px; }
        .progress-row .label { display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 0.4rem; }
        .progress-row .label .val { color: var(--ink); font-weight: 500; }
        .progress-bar { height: 6px; background: color-mix(in srgb, var(--cf-text) 6%, transparent); border-radius: 3px; overflow: hidden; }
        .progress-bar .fill { height: 100%; background: linear-gradient(90deg, var(--accent), #c084fc); transition: width 0.3s; }
        .progress-bar.good .fill { background: linear-gradient(90deg, var(--good), #86efac); }
        .progress-bar.gold .fill { background: linear-gradient(90deg, var(--warn), #fcd34d); }
        .progress-bar.pink .fill { background: linear-gradient(90deg, var(--pink), #f9a8d4); }

        /* === Banners / notices === */
        .back { font-size: 0.875rem; color: var(--muted); text-decoration: none; }
        .back:hover { color: var(--ink); }
        .scope-missing { padding: 0.75rem 1rem; background: color-mix(in srgb, var(--warn) 10%, transparent); border: 1px solid color-mix(in srgb, var(--warn) 35%, transparent); border-radius: 8px; color: var(--cf-warning-ink); font-size: 0.875rem; margin-bottom: 1rem; }
        .scope-missing code { background: transparent; color: var(--cf-warning-ink); font-family: monospace; }

        .notice-connected { padding: 0.9rem 1.1rem; background: var(--cf-accent-soft); border: 1px solid var(--cf-accent-line); border-radius: 10px; color: var(--ink); font-size: 0.875rem; margin-bottom: 1rem; display: flex; align-items: flex-start; gap: 0.9rem; }
        .notice-connected .ico { color: var(--accent); font-size: 1.1rem; margin-top: 2px; }
        .notice-connected .body { flex: 1; }
        .notice-connected.good { background: color-mix(in srgb, var(--good) 8%, transparent); border-color: color-mix(in srgb, var(--good) 30%, transparent); }
        .notice-connected.good .ico { color: var(--good); }
        .notice-rolesync { padding: 0.75rem 1rem; background: color-mix(in srgb, var(--warn) 8%, transparent); border: 1px solid color-mix(in srgb, var(--warn) 25%, transparent); border-radius: 8px; color: var(--muted); font-size: 0.825rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.75rem; }
        .notice-rolesync a { color: var(--cf-warning-ink); text-decoration: none; font-weight: 500; }
        .notice-rolesync a:hover { text-decoration: underline; }

        /* === Chips / badges === */
        .big-chip { display: inline-block; margin-left: 0.4rem; vertical-align: middle; font-size: 0.6rem; padding: 2px 6px; border-radius: 4px; background: var(--accent-dim); color: var(--cf-accent-ink); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
        .big-chip.month { background: color-mix(in srgb, var(--warn) 14%, transparent); color: var(--cf-warning-ink); }

        .pre-conn { opacity: 0.72; }
        .pre-conn-badge { display: inline-block; padding: 1px 6px; border-radius: 4px; background: var(--cf-veil-1); color: var(--muted); font-size: 0.65rem; font-weight: 500; margin-left: 0.4rem; text-transform: uppercase; letter-spacing: 0.04em; }

        .backfill-btn, .btn-ghost {
            background: var(--panel-bg); color: var(--muted); border: 1px solid var(--panel-border);
            padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.8rem; cursor: pointer;
            display: inline-flex; gap: 0.4rem; align-items: center; text-decoration: none;
        }
        .backfill-btn:hover, .btn-ghost:hover { color: var(--ink); border-color: var(--accent); }
        .backfill-btn:disabled { opacity: 0.5; cursor: wait; }
        .backfill-meta { color: var(--muted); font-size: 0.72rem; margin-left: 0.4rem; }

        /* === Delta chips in headline tiles === */
        .delta-chip { display: inline-block; margin-left: 0.3rem; vertical-align: middle; font-size: 0.65rem; padding: 1px 5px; border-radius: 3px; font-weight: 600; }
        .delta-chip.up { background: color-mix(in srgb, var(--good) 14%, transparent); color: var(--cf-success-ink); }
        .delta-chip.down { background: color-mix(in srgb, var(--bad) 14%, transparent); color: var(--cf-danger-ink); }
        .delta-chip.flat { background: var(--cf-veil-1); color: var(--muted); }

        /* === Sparkline (headline tile) === */
        .spark-wrap { position: relative; height: 32px; margin-top: 0.5rem; }
        .spark-wrap > canvas.sparkline { width: 100% !important; height: 100% !important; opacity: 0.75; display: block; }

        /* === Milestone callouts === */
        .milestones-strip { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.75rem 0 0.25rem; }
        .milestone-chip { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.825rem; flex: 1; min-width: 200px; }
        .milestone-chip .label { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; }
        .milestone-chip .value { font-size: 1rem; font-weight: 600; margin-top: 2px; }
        .milestone-chip .meta { color: var(--muted); font-size: 0.7rem; margin-top: 2px; }

        /* === Collapsible section header === */
        .section .collapse-btn { color: var(--muted); background: transparent; border: none; cursor: pointer; padding: 0 0.4rem; font-size: 0.8rem; }
        .section .collapse-btn:hover { color: var(--ink); }
        .section.collapsed + * { display: none; }

        /* === Game box art === */
        .game-art { width: 40px; height: 54px; object-fit: cover; border-radius: 3px; margin-right: 0.5rem; vertical-align: middle; }

        /* === Live-refresh toggle === */
        .live-refresh-toggle { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--muted); cursor: pointer; }
        .live-refresh-toggle input { cursor: pointer; }
        .live-refresh-toggle.active { color: var(--good); }

        /* === Session row — clickable for detail view === */
        .table-row.clickable { cursor: pointer; }
        .table-row.clickable:hover { background: color-mix(in srgb, var(--cf-text) 2%, transparent); }
        .table-row .detail-arrow { color: var(--muted); font-size: 0.75rem; opacity: 0; transition: opacity 0.1s; }
        .table-row.clickable:hover .detail-arrow { opacity: 1; }

        /* === Timezone + settings dropdown === */
        .tz-picker { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: var(--muted); }
        .tz-picker select { background: var(--field-bg); color: var(--ink); border: 1px solid var(--panel-border); border-radius: 4px; padding: 2px 6px; font-size: 0.75rem; }

        /* === Clip VOD-moment deep link === */
        .vod-link { color: var(--muted); font-size: 0.7rem; margin-left: 0.3rem; text-decoration: none; }
        .vod-link:hover { color: var(--accent); }

        /* === Mobile responsive tweaks === */
        @media (max-width: 760px) {
            .wrap { padding: 1rem; padding-bottom: 3rem; }
            .page-head { flex-direction: column; align-items: stretch; gap: 0.75rem; padding: 1rem; }
            .page-head .right { margin-left: 0; justify-content: flex-start; }
            .page-head h1 { font-size: 1.2rem; }
            .heatmap { font-size: 0.55rem; grid-template-columns: 2rem repeat(24, 1fr); }
            .milestone-chip { min-width: 100%; }
            .thumb-row img { width: 60px; height: 34px; }
            .game-art { width: 28px; height: 38px; }
            .table-row .meta { white-space: normal; }
        }

        /* === Keyboard-shortcut help overlay === */
        .kbd-help { position: fixed; bottom: 1rem; right: 1rem; background: var(--cf-surface); border: 1px solid var(--panel-border); border-radius: 10px; padding: 1rem 1.25rem; font-size: 0.825rem; color: var(--ink); display: none; max-width: 300px; z-index: 100; box-shadow: 0 10px 40px rgba(0,0,0,0.5); }
        .kbd-help kbd { background: color-mix(in srgb, var(--cf-text) 10%, transparent); padding: 2px 6px; border-radius: 3px; font-family: monospace; font-size: 0.8rem; }
        .kbd-help.open { display: block; }
        .kbd-help .row { display: flex; justify-content: space-between; margin-bottom: 0.3rem; }
        .kbd-help .close { position: absolute; top: 0.3rem; right: 0.5rem; color: var(--muted); background: transparent; border: 0; cursor: pointer; }

        .badge-sev-critical { color: var(--bad); }
        .badge-sev-warning { color: var(--warn); }
        .badge-sev-info { color: var(--accent); }

        /* === Thumbs === */
        .thumb-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.25rem; border-bottom: 1px solid var(--panel-border); }
        .thumb-row:last-child { border-bottom: 0; }
        .thumb-row img { width: 100px; height: 56px; object-fit: cover; border-radius: 4px; background: color-mix(in srgb, var(--cf-text) 3%, transparent); flex-shrink: 0; }
        .thumb-row .main { flex: 1; min-width: 0; }
        .thumb-row .title { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .thumb-row .meta { color: var(--muted); font-size: 0.75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .thumb-row .side { color: var(--muted); font-size: 0.75rem; text-align: right; flex-shrink: 0; min-width: 60px; }

        /* === Section-footer actions row === */
        .footer-row { padding: 0.6rem 0.25rem 0; border-top: 1px solid var(--panel-border); display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem; font-size: 0.75rem; }
        .footer-row a { color: var(--muted); text-decoration: none; }
        .footer-row a:hover { color: var(--ink); }
        .grid > * { min-width: 0; }
        .card p.big, .card p.sub { margin-bottom: 0; }
        body[data-active-tab="live"] .range-compare { display: none; }
        .chart-card:has(.heatmap) { overflow-x: auto; }
        @media (max-width: 760px) {
            .export-menu { margin-left: 0; }
            .tab-nav .tab-link { padding: 0.5rem 0.8rem; }
            .wrap form, .wrap form > div { flex-wrap: wrap; }
            .wrap input, .wrap select, .wrap textarea { max-width: 100%; }
        }
        @media (max-width: 500px) { .heatmap .hcell { min-height: 8px; } .heatmap { font-size: 0.5rem; grid-template-columns: 1.6rem repeat(24, 1fr); gap: 1px; } }
    </style>
<%- include('partials/site-head', { title: (broadcaster ? broadcaster.login : guildName) + ' — Twitch analytics | CertiFried', noindex: !!locals.shareMode }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
    <link rel="stylesheet" href="/css/cf-analytics.css">
</head>
<body class="cf-an-body<%= locals.shareMode ? ' is-share' : '' %>">
<%- include('partials/site-header', { hideUser: !!locals.shareMode }) %>
<div class="wrap" id="main-content">
    <% if (!locals.shareMode) { %>
    <a href="/manage/<%= guildId %>?page=streamers&tab=analytics" class="back">← Back to <%= guildName %></a>
    <% } %>

    <% if (!broadcaster) { %>
    <div class="page-head">
        <div class="broadcaster-id">
            <h1>Twitch analytics</h1>
            <div class="sub"><%= guildName %></div>
        </div>
    </div>
    <div class="cf-rows"><div class="cf-state">
        <p class="cf-state-title">No Twitch channel connected</p>
        <p class="cf-state-text">Connect the broadcaster's Twitch account on the Role sync tab. Analytics uses the same sign-in, so there is nothing else to set up.</p>
        <a class="btn btn-primary btn-sm" href="/manage/<%= guildId %>?page=streamers&tab=role-sync">Open Role sync</a>
    </div></div>
    <% } else {
        const d = data;
        const h = d.headline;
        const hd = d.headlineDisplay || {};
        const bf = d.backfill || {};
        const liveHours = Math.round((Number(h.live_minutes) || 0) / 60 * 10) / 10;
        const avgV = Math.round(Number(h.avg_viewers) || 0);
        const fmt = n => Number(n || 0).toLocaleString();
        const money = (a) => { if (!a) return '0'; const dp = Number.isFinite(Number(a.decimal_places)) ? Number(a.decimal_places) : 2; const v = Number(a.value || 0) / Math.pow(10, dp); try { return new Intl.NumberFormat('en-US', { style: 'currency', currency: String(a.currency || 'USD').toUpperCase(), maximumFractionDigits: 0 }).format(v); } catch (e) { return '$' + Math.round(v).toLocaleString('en-US'); } };
        const fmtRate = (v, digits = 2) => v === null || v === undefined ? '—' : Number(v).toFixed(digits);
        const dowLabels = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        const relAgo = (ts) => {
            if (!ts) return '—';
            const ms = Date.now() - new Date(ts).getTime();
            if (!Number.isFinite(ms) || ms < 0) return '—';
            const m = Math.round(ms / 60000);
            if (m < 60) return m + 'm ago';
            const hh = Math.round(m / 60);
            if (hh < 48) return hh + 'h ago';
            return Math.round(hh / 24) + 'd ago';
        };
        const scopeNeeds = [
            { s: 'channel:read:hype_train', msg: 'Hype trains' },
            { s: 'channel:read:goals', msg: 'Goals' },
            { s: 'channel:read:ads', msg: 'Ad schedule' },
            { s: 'channel:read:charity', msg: 'Charity' },
            { s: 'channel:read:redemptions', msg: 'Channel point redemptions' },
            { s: 'channel:read:polls', msg: 'Polls' },
            { s: 'channel:read:predictions', msg: 'Predictions' },
            { s: 'moderator:read:shoutouts', msg: 'Shoutouts' },
            { s: 'moderator:read:chatters', msg: 'Unique chatter counts' },
        ];
        const missingScopes = scopeNeeds.filter(x => !broadcaster.scopes.includes(x.s));
        const bfStatus = typeof backfillStatus !== 'undefined' ? backfillStatus : null;
        const deltas = d.deltas || {};
        const milestones = d.milestones || {};
        const prefs = d.userPrefs || { timezone: 'UTC', auto_refresh_enabled: 0 };
        // Timestamps on this page are written in the viewer's chosen timezone (the picker in the header).
        const TZO = (() => { try { const z = String(prefs.timezone || 'UTC'); new Intl.DateTimeFormat('en-US', { timeZone: z }); return { timeZone: z }; } catch (e) { return { timeZone: 'UTC' }; } })();
        const gamesCache = d.gamesCache || {};

        // Delta chip renderer — returns HTML or empty string. Null delta (no prior data) → empty.
        function deltaChip(pct) {
            if (pct === null || pct === undefined || !Number.isFinite(pct)) return '';
            if (Math.abs(pct) < 0.5) return '<span class="delta-chip flat">±0%</span>';
            const cls = pct > 0 ? 'up' : 'down';
            const arrow = pct > 0 ? '↑' : '↓';
            return `<span class="delta-chip ${cls}">${arrow}${Math.abs(pct).toFixed(0)}%</span>`;
        }

        // Derived data from backfill blobs for in-view use.
        const liveStream = bf.current_stream && bf.current_stream.type === 'live' ? bf.current_stream : null;
        const chatSettings = bf.chat_settings || null;
        const adSchedule = bf.ad_schedule || null;
        const charity = bf.charity_campaign || null;
        const schedule = bf.current_schedule || null;
        const nextSegment = schedule?.segments?.find(s => new Date(s.start_time) > new Date()) || null;
        const peakHoursCell = (() => {
            let bestD = 0, bestH = 0, bestV = 0;
            for (let i = 0; i < 7; i++) for (let j = 0; j < 24; j++) {
                if (d.hoursGrid[i][j] > bestV) { bestV = d.hoursGrid[i][j]; bestD = i; bestH = j; }
            }
            return bestV > 0 ? { dow: dowLabels[bestD], hour: bestH, minutes: bestV } : null;
        })();
    %>

    <!-- ===== Header ===== -->
    <div class="page-head">
        <div class="broadcaster-id">
            <h1>
                <%= broadcaster.login %>
                <% if (isSuperAdmin) { %><span class="pill admin">Admin</span><% } %>
                <% if (liveStream) { %>
                <span class="pill live"><i class="fas fa-circle" style="font-size: 0.5rem;"></i> Live · <%= fmt(liveStream.viewer_count) %> viewers</span>
                <% } %>
            </h1>
            <div class="sub">
                <span>Twitch analytics for <strong><%= guildName %></strong></span>
                <span>· <a href="https://twitch.tv/<%= broadcaster.login %>" target="_blank" rel="noopener" style="color: var(--accent);">twitch.tv/<%= broadcaster.login %></a></span>
                <% if (bf.follower_count != null) { %><span>· <strong><%= fmt(bf.follower_count) %></strong> followers</span><% } %>
                <% if (bf.subscriber_count != null) { %><span>· <strong><%= fmt(bf.subscriber_count) %></strong> subs</span><% } %>
                <% if (charity && charity.charity_name) { %>
                <span class="pill pink"><i class="fas fa-heart" style="font-size: 0.65rem;"></i> <%= charity.charity_name %><%= charity.current_amount ? ' ' + money(charity.current_amount) : '' %></span>
                <% } %>
                <% if (chatSettings) {
                    const chatChips = [];
                    if (chatSettings.follower_mode) chatChips.push('Follower-only' + (chatSettings.follower_mode_duration ? ' (' + chatSettings.follower_mode_duration + 'min)' : ''));
                    if (chatSettings.subscriber_mode) chatChips.push('Sub-only');
                    if (chatSettings.slow_mode) chatChips.push('Slow ' + (chatSettings.slow_mode_wait_time || 0) + 's');
                    if (chatSettings.emote_mode) chatChips.push('Emote-only');
                    if (chatSettings.unique_chat_mode) chatChips.push('Unique');
                   if (chatChips.length) { %>
                <% chatChips.forEach(c => { %><span class="pill"><%= c %></span><% }) %>
                <% } } %>
                <% if (nextSegment) { %>
                <span>· Next stream <strong><%= new Date(nextSegment.start_time).toLocaleString('en-US', TZO) %></strong></span>
                <% } %>
                <% if (d.teams && d.teams.length) { %>
                <span>· Teams: <%= d.teams.join(', ') %></span>
                <% } %>
            </div>
        </div>
        <div class="right">
            <% if (!locals.shareMode) { %>
            <%
                const bfLastRun = bf.last_run_at;
                const bfLastMs = bf.last_run_duration_ms;
            %>
            <form method="POST" action="/manage/<%= guildId %>/twitch-analytics/backfill?range=<%= range %>" style="margin: 0;">
                <button type="submit" class="backfill-btn" title="Re-run the Helix backfill: VODs, clips, lifetime followers, subs breakdown, bits leaderboard, VIPs/mods, ads, polls, predictions, goals, teams, schedule">
                    <i class="fas fa-sync-alt"></i>
                    Refresh backfill
                </button>
                <% if (bfLastRun) { %>
                <span class="backfill-meta">last run <%= relAgo(bfLastRun) %><% if (bfLastMs) { %> · <%= Math.round(bfLastMs / 100) / 10 %>s<% } %></span>
                <% } %>
            </form>
            <label class="tz-picker" title="Timezone for the dates and times on this page">
                <i class="fas fa-globe" aria-hidden="true"></i>
                <select id="tzPicker" aria-label="Timezone for dates and times">
                    <%
                        const tzOptions = ['UTC', 'America/Los_Angeles', 'America/Denver', 'America/Chicago', 'America/New_York', 'Europe/London', 'Europe/Berlin', 'Europe/Moscow', 'Asia/Tokyo', 'Asia/Hong_Kong', 'Australia/Sydney'];
                        const currentTz = prefs.timezone || 'UTC';
                    %>
                    <% tzOptions.forEach(tz => { %>
                    <option value="<%= tz %>" <%= tz === currentTz ? 'selected' : '' %>><%= tz %></option>
                    <% }) %>
                </select>
            </label>
            <label class="live-refresh-toggle" title="Auto-refresh page every 60s while live">
                <input type="checkbox" id="autoRefreshToggle" <%= prefs.auto_refresh_enabled ? 'checked' : '' %>>
                Live refresh
            </label>
            <a href="/manage/<%= guildId %>?page=streamers&tab=analytics" class="btn-ghost"><i class="fas fa-cog" aria-hidden="true"></i> Settings</a>
            <a href="/manage/<%= guildId %>/twitch-analytics/schedule.ics" class="btn-ghost" title="Download the upcoming stream schedule for a calendar app"><i class="fas fa-calendar" aria-hidden="true"></i> Schedule (.ics)</a>
            <a href="/manage/<%= guildId %>/twitch-analytics/recap.md" class="btn-ghost" title="Download this week's recap as a Markdown file"><i class="fas fa-file-alt" aria-hidden="true"></i> Weekly recap</a>
            <% } %>
        </div>
    </div>

    <% if (!locals.shareMode) { %><%- include('partials/analytics/twitch-nav', { active: 'overview' }) %><% } %>
    <div class="cf-notice op-notice" id="opNotice" role="status" hidden><i class="fas fa-circle-info" aria-hidden="true"></i><div class="cf-notice-body" id="opNoticeText"></div></div>

    <!-- ===== Range selector ===== -->
    <div class="range-row">
        <nav class="range-nav" aria-label="Date range">
            <% Object.entries(ranges).forEach(([key, r]) => { %>
            <a href="?range=<%= key %>" class="<%= range === key ? 'active' : '' %>" data-key="<%= key %>"<%- range === key ? ' aria-current="true"' : '' %>><%= r.label %></a>
            <% }) %>
        </nav>
        <span class="range-compare">Arrows on the top cards compare with the <%= String(ranges[range].label).replace(/^Last /, 'previous ') %>.</span>
        <% if (!locals.shareMode) { %>
        <details class="export-menu">
            <summary class="btn-ghost"><i class="fas fa-file-csv" aria-hidden="true"></i> Export CSV</summary>
            <div class="export-list">
                <% [['sessions', 'Streams in this range'], ['events', 'Events in this range'], ['anomalies', 'Anomaly alerts in this range'], ['clips', 'Top 500 clips'], ['vods', 'Top 500 VODs']].forEach(([t, label]) => { %>
                <a href="/manage/<%= guildId %>/twitch-analytics/export.csv?type=<%= t %>&range=<%= range %>"><%= label %></a>
                <% }) %>
            </div>
        </details>
        <% } %>
    </div>

    <% if (data.dataSince) {
        const since = new Date(data.dataSince);
        const rangeDays = Math.round(ranges[range].hours / 24);
        const coveredDays = Math.max(1, Math.round((Date.now() - since.getTime()) / 86400000));
        if (coveredDays < rangeDays) { %>
    <div class="range-note">Minute-by-minute history for this channel starts <%= since.toLocaleDateString('en-US', { month: 'short', day: 'numeric', ...TZO }) %>, so this view covers <%= coveredDays %> day<%= coveredDays === 1 ? '' : 's' %>, not <%= rangeDays %>.</div>
    <% } } %>

    <!-- ===== Banners ===== -->
    <% if (!locals.shareMode) { %>
    <% if (broadcaster.needs_reauth || broadcaster.write_needs_reauth) { %>
    <div class="scope-missing" role="status">
        <strong>Reconnect needed:</strong> Twitch no longer accepts the <%= broadcaster.needs_reauth ? 'analytics' : 'write' %> connection for this channel, so <%= broadcaster.needs_reauth ? 'new data stops arriving' : 'moderation and stream controls stop working' %> until it is connected again.
        <a href="/auth/twitch/<%= broadcaster.needs_reauth ? 'broadcaster' : 'broadcaster-write' %>/<%= guildId %>" style="color: var(--accent); margin-left: 0.5rem;">Reconnect Twitch</a>
    </div>
    <% } %>
    <% if (missingScopes.length) { %>
    <div class="scope-missing">
        <strong>Partial coverage:</strong> this broadcaster hasn't granted <%= missingScopes.length %> scope<%= missingScopes.length === 1 ? '' : 's' %> yet
        (<%= missingScopes.map(x => '<code title="Grants: ' + x.msg + '">' + x.s + '</code>').join(', ') %>).
        <a href="/auth/twitch/broadcaster/<%= guildId %>" style="color: var(--accent); margin-left: 0.5rem;">Reconnect to grant them →</a>
    </div>
    <% } %>
    <% if (broadcaster.just_connected) { %>
    <div class="notice-connected">
        <i class="fas fa-wand-magic-sparkles ico"></i>
        <div class="body">
            <strong>Just connected</strong> — EventSub webhooks are now live. Lifetime totals (followers, subs, bits) + recent polls, predictions, goals, VODs, and top clips were seeded on connect. Event tables (hype trains, sub log, bits) will populate as your stream progresses.
        </div>
    </div>
    <% } %>
    <% if (!broadcaster.role_sync_configured) { %>
    <div class="notice-rolesync">
        <i class="fas fa-plug" style="color: var(--warn);"></i>
        <div style="flex: 1;">
            <strong style="color: var(--ink);">Role sync not configured.</strong> Discord ↔ Twitch role sync is off, so <em>Linked members</em> stays empty. Pick which Discord roles should map to Twitch VIPs, mods, and subs.
        </div>
        <a href="/manage/<%= guildId %>?page=streamers&tab=role-sync">Configure →</a>
    </div>
    <% } %>
    <% if (bfStatus === 'ok') { %>
    <div class="notice-connected good"><i class="fas fa-check-circle ico"></i><div class="body"><strong>Backfill refreshed.</strong></div></div>
    <% } else if (bfStatus === 'fail') { %>
    <div class="scope-missing"><strong>Backfill failed.</strong> See server logs. Usual cause: expired token — reconnect from the Role sync tab.</div>
    <% } %>

    <% if (!broadcaster.tier_b_granted) { %>
    <div class="notice-connected" style="background: var(--cf-accent-soft); border-color: var(--cf-accent-line);">
        <i class="fas fa-wand-magic-sparkles ico"></i>
        <div class="body">
            <strong>Enable Stream Controls</strong> — grant write permissions to turn the dashboard into a full creator-dashboard replacement: edit title/category live, launch polls / predictions / raids, snooze ads, toggle Shield Mode, ban/timeout from the dashboard, review AutoMod. Every action is audit-logged.
            <div style="margin-top: 0.5rem;">
                <a href="/auth/twitch/broadcaster-write/<%= guildId %>" class="backfill-btn" style="color: var(--accent); border-color: var(--accent);"><i class="fas fa-lock-open"></i> Grant write permissions</a>
            </div>
        </div>
    </div>
    <% } %>

    <% } %>
    <!-- ===== Primary tab bar (Phase 1) ===== -->
    <div class="tab-nav" role="tablist" aria-label="Twitch analytics sections">
        <% if (!locals.shareMode) { %><a href="#tab=live" class="tab-link" data-tab="live" role="tab">Live</a><% } %>
        <a href="#tab=audience" class="tab-link" data-tab="audience" role="tab">Audience</a>
        <a href="#tab=content" class="tab-link" data-tab="content" role="tab">Content</a>
        <% if (!locals.shareMode) { %><a href="#tab=operations" class="tab-link" data-tab="operations" role="tab">Operations</a><% } %>
        <% if (isSuperAdmin && !locals.shareMode) { %><a href="#tab=admin" class="tab-link" data-tab="admin" role="tab">Admin</a><% } %>
    </div>
    <nav class="sub-nav" id="subNav" aria-label="Sections in this tab"></nav>

    <!-- ===== Pipeline health ===== -->

    <div class="tab-pane" data-tab-group="audience">

    <%
        const health = d.subsHealth || {};
        const healthEnabled = Number(health.enabled || 0);
        const healthTotal = Number(health.total_expected || 0);
        const healthLost = (health.missing || []).length + (health.degraded || []).length;
        const healthHue = healthLost === 0 ? 'var(--good)' : (healthLost < 4 ? 'var(--warn)' : 'var(--bad)');
        const li = health.last_ingest || {};
    %>
    <% if (!locals.shareMode) { %>
    <div class="card" style="padding: 0.75rem 1rem; margin-bottom: 1rem;">
        <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap; font-size: 0.825rem;">
            <div><strong style="color: <%= healthHue %>;"><%= healthEnabled %>/<%= healthTotal %></strong> <span style="color: var(--muted);">EventSub topics</span></div>
            <% const shards = Number(health.conduit?.shard_count || 0); %>
            <div><strong><%= health.conduit ? (shards + ' shard' + (shards === 1 ? '' : 's')) : 'Direct webhook' %></strong> <span style="color: var(--muted);"><%= health.conduit ? '· Conduit ' + String(health.conduit.conduit_id || '').slice(0, 8) : '' %></span></div>
            <div style="color: var(--muted);">Last chat: <strong style="color: var(--ink);"><%= relAgo(li.last_snapshot) %></strong></div>
            <div style="color: var(--muted);">Last hype: <strong style="color: var(--ink);"><%= relAgo(li.last_hype) %></strong></div>
            <div style="color: var(--muted);">Last ad: <strong style="color: var(--ink);"><%= relAgo(li.last_ad) %></strong></div>
            <div style="color: var(--muted);">Last cat edit: <strong style="color: var(--ink);"><%= relAgo(li.last_category_change) %></strong></div>
