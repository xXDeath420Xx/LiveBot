    <!-- Global showToast for all partials -->
    <script>
    window.showToast = window.showToast || function(msg, type) {
        var existing = document.querySelector('.global-toast');
        if (existing) existing.remove();
        var toast = document.createElement('div');
        toast.className = 'global-toast';
        toast.className = 'global-toast' + (type === 'success' ? ' is-success' : type === 'error' ? ' is-error' : '');
        toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
        toast.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:10001;font-size:0.85rem;';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.remove(); }, 4000);
    };
    </script>

    <!-- Global AJAX form interceptor — converts all POST forms to no-reload saves -->
    <script>
    (function() {
        document.addEventListener('submit', async function(e) {
            // If another handler already called preventDefault, this form has its own AJAX handler — skip
            if (e.defaultPrevented) return;
            var form = e.target;
            if (!form || form.method.toUpperCase() !== 'POST') return;
            // Skip forms that explicitly opt out
            if (form.dataset.noAjax) return;
            // Skip file upload forms (multipart needs special handling)
            if (form.enctype === 'multipart/form-data') return;

            e.preventDefault();

            var action = form.getAttribute('action');
            var submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
            var originalText = submitBtn ? submitBtn.textContent : '';

            // Disable button and show loading state
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.6';
                submitBtn.textContent = 'Saving...';
            }

            try {
                var formData = new FormData(form);
                var resp = await fetch(action, {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    credentials: 'include',
                    redirect: 'follow',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                // Check if server returned JSON
                var contentType = resp.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    var data = await resp.json();
                    if (data.success || data.ok) {
                        showToast(data.message || 'Saved successfully!', 'success');
                    } else {
                        showToast(data.error || data.message || 'Failed to save', 'error');
                    }
                } else if (resp.status === 404) {
                    showToast('This feature is not yet available', 'error');
                } else if (resp.status >= 400) {
                    showToast('Request failed (status ' + resp.status + ')', 'error');
                } else {
                    // Server returned HTML (redirect was followed) — check URL for success/error params
                    var url = new URL(resp.url);
                    if (url.searchParams.has('success')) {
                        var successType = url.searchParams.get('success');
                        var messages = {
                            'created': 'Created successfully!',
                            'updated': 'Updated successfully!',
                            'deleted': 'Deleted successfully!',
                            'saved': 'Settings saved!',
                            'restored': 'Restore complete!',
                            'restore_logged': 'Restore logged for review'
                        };
                        showToast(messages[successType] || 'Saved successfully!', 'success');
                    } else if (url.searchParams.has('error')) {
                        showToast('Error: ' + (url.searchParams.get('error') || 'Something went wrong').replace(/_/g, ' '), 'error');
                    } else if (resp.ok) {
                        showToast('Saved successfully!', 'success');
                    } else {
                        showToast('Request failed', 'error');
                    }
                }

                // Reload the page content without full refresh for forms that change visible data
                // Only reload if the form action suggests data was created/deleted (not just config updates)
                var actionPath = action.startsWith('/') ? action : new URL(action).pathname;
                if (actionPath.match(/\/(create|add|delete|remove|import|sync|edit|repost)/)) {
                    setTimeout(function() { window.location.reload(); }, 800);
                }
            } catch (err) {
                showToast('Network error: ' + err.message, 'error');
            }

            // Restore button
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.style.opacity = '';
                submitBtn.textContent = originalText;
            }
        }); // Bubble phase — runs AFTER partial-specific handlers, so e.defaultPrevented check works
    })();
    </script>

    <!-- Fuzzy Finder (Ctrl+K / Cmd+K); styles in cf-manage.css -->

    <div id="ffOverlay" class="ff-overlay" onclick="if(event.target===this)closeFinder()">
        <div class="ff-dialog" role="dialog" aria-modal="true" aria-label="Go to page">
            <div class="ff-input-wrap">
                <i class="fas fa-search"></i>
                <input type="text" class="ff-input" id="ffInput" placeholder="Go to a page or setting" aria-label="Go to a settings page or a setting" autocomplete="off" spellcheck="false">
                <span class="ff-kbd">ESC</span>
            </div>
            <div class="ff-results" id="ffResults"></div>
            <div class="ff-footer">
                <span><kbd class="ff-kbd">&uarr;&darr;</kbd> Navigate</span>
                <span><kbd class="ff-kbd">Enter</kbd> Open</span>
                <span><kbd class="ff-kbd">Esc</kbd> Close</span>
            </div>
        </div>
    </div>

    <script>
    (function() {
        // Index every page from the nav data, so the palette works on sub-pages too.
        const modules = [];
        var navData = {};
        try { navData = JSON.parse((document.getElementById('cfNavData') || {}).textContent || '{}'); } catch (e) { navData = {}; }
        (navData.sections || []).forEach(function(sec) {
            sec.items.forEach(function(it) {
                modules.push({ title: it.title, desc: it.desc, iconClass: it.icon, href: '/manage/' + navData.guildId + '?page=' + it.page, section: sec.label, color: '', searchText: (it.title + ' ' + it.desc + ' ' + sec.label + ' ' + it.tags).toLowerCase() });
            });
        });

        var overlay = document.getElementById('ffOverlay');
        var input = document.getElementById('ffInput');
        var resultsContainer = document.getElementById('ffResults');
        var activeIndex = 0;

        function fuzzyMatch(query, text) {
            query = query.toLowerCase();
            text = text.toLowerCase();
            if (text.indexOf(query) !== -1) return 100;
            var qi = 0, score = 0, lastIdx = -1;
            for (var ti = 0; ti < text.length && qi < query.length; ti++) {
                if (text[ti] === query[qi]) {
                    score += (ti === lastIdx + 1) ? 15 : 5;
                    if (ti === 0 || text[ti - 1] === ' ') score += 10;
                    lastIdx = ti;
                    qi++;
                }
            }
            return qi === query.length ? score : 0;
        }

        function createItem(m) {
            var a = document.createElement('a');
            a.href = m.href;
            a.className = 'ff-item';

            var iconWrap = document.createElement('div');
            iconWrap.className = 'ff-item-icon';
            var icon = document.createElement('i');
            icon.className = m.iconClass || 'fas fa-gear';
            icon.setAttribute('aria-hidden', 'true');
            iconWrap.appendChild(icon);

            var textWrap = document.createElement('div');
            textWrap.className = 'ff-item-text';
            var titleEl = document.createElement('div');
            titleEl.className = 'ff-item-title';
            titleEl.textContent = m.title;
            var descEl = document.createElement('div');
            descEl.className = 'ff-item-desc';
            descEl.textContent = m.desc;
            textWrap.appendChild(titleEl);
            textWrap.appendChild(descEl);

            var sectionEl = document.createElement('div');
            sectionEl.className = 'ff-item-section';
            sectionEl.textContent = m.section;

            a.appendChild(iconWrap);
            a.appendChild(textWrap);
            a.appendChild(sectionEl);
            return a;
        }

        // Individual settings (cf-field-search.js): loaded the first time the finder opens, then
        // listed after the matching pages as "Setting · <page>".
        function fieldResults(query) {
            if (!query || !window.CFFields || !window.CFFields.entries()) return [];
            return window.CFFields.match(window.CFFields.entries(), query, 8).map(function (e) {
                return { title: e.label, desc: e.pageTitle, iconClass: 'fas fa-sliders', href: window.CFFields.href(navData.guildId, e), section: 'Setting' };
            });
        }

        function renderResults(query) {
            resultsContainer.textContent = '';

            var list;
            if (!query) {
                list = modules;
            } else {
                list = modules
                    .map(function(m) { return { m: m, score: fuzzyMatch(query, m.searchText) }; })
                    .filter(function(x) { return x.score > 0; })
                    .sort(function(a, b) { return b.score - a.score; })
                    .map(function(x) { return x.m; })
                    .slice(0, 20)
                    .concat(fieldResults(query));
            }

            if (list.length === 0) {
                var empty = document.createElement('div');
                empty.className = 'ff-empty';
                var emptyIcon = document.createElement('i');
                emptyIcon.className = 'fas fa-search';
                emptyIcon.style.cssText = 'display:block;margin-bottom:8px;font-size:1.2rem;';
                empty.appendChild(emptyIcon);
                empty.appendChild(document.createTextNode('No page or setting matches'));
                resultsContainer.appendChild(empty);
                activeIndex = -1;
                return;
            }

            list.forEach(function(m) {
                resultsContainer.appendChild(createItem(m));
            });
            activeIndex = 0;
            updateActive();
        }

        function updateActive() {
            var items = resultsContainer.querySelectorAll('.ff-item');
            items.forEach(function(el, i) { el.classList.toggle('ff-active', i === activeIndex); });
            if (items[activeIndex]) {
                items[activeIndex].scrollIntoView({ block: 'nearest' });
            }
        }

        function openFinder() {
            overlay.classList.add('open');
            input.value = '';
            renderResults('');
            setTimeout(function() { input.focus(); }, 10);
            if (window.CFFields && !window.CFFields.entries()) {
                window.CFFields.load(navData.indexVersion).then(function () {
                    if (overlay.classList.contains('open') && input.value.trim()) renderResults(input.value.trim());
                }).catch(function () { /* pages still search; settings just are not listed */ });
            }
        }

        function closeFinder() {
            overlay.classList.remove('open');
        }

        function navigateToActive() {
            var items = resultsContainer.querySelectorAll('.ff-item');
            if (items[activeIndex]) {
                window.location.href = items[activeIndex].getAttribute('href');
            }
        }

        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                overlay.classList.contains('open') ? closeFinder() : openFinder();
                return;
            }
            if (!overlay.classList.contains('open')) return;
            if (e.key === 'Escape') {
                e.preventDefault();
                closeFinder();
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                var items = resultsContainer.querySelectorAll('.ff-item');
                if (items.length > 0) { activeIndex = (activeIndex + 1) % items.length; updateActive(); }
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                var items2 = resultsContainer.querySelectorAll('.ff-item');
                if (items2.length > 0) { activeIndex = (activeIndex - 1 + items2.length) % items2.length; updateActive(); }
            } else if (e.key === 'Enter') {
                e.preventDefault();
                navigateToActive();
            }
        });

        input.addEventListener('input', function() {
            renderResults(input.value.trim());
        });

        window.openFinder = openFinder;
        window.closeFinder = closeFinder;
    })();

    </script>
