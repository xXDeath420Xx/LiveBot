                    'phishing': { partial: 'phishing', data: { guild, phishingConfig: typeof phishingConfig !== 'undefined' ? phishingConfig : {}, channels } },
                    'free-games': { partial: 'free-games', data: { guild, freeGamesSubs: typeof freeGamesSubs !== 'undefined' ? freeGamesSubs : [], channels, roles: typeof roles !== 'undefined' ? roles : [] } },
                    'tiktok': { partial: 'tiktok', data: { guild, tiktokSubs: typeof tiktokSubs !== 'undefined' ? tiktokSubs : [], tiktokConfig: typeof tiktokConfig !== 'undefined' ? tiktokConfig : {}, recentVideos: typeof recentTiktokVideos !== 'undefined' ? recentTiktokVideos : [], channels, roles } },
                    'stat-displays': { partial: 'stat-displays', data: { guild, statDisplayChannels: typeof statDisplayChannels !== 'undefined' ? statDisplayChannels : [], voiceChannels: typeof voiceChannels !== 'undefined' ? voiceChannels : [], roles } },
                    'throne': { partial: 'throne', data: { guild, channels, throneNotifications: typeof throneNotifications !== 'undefined' ? throneNotifications : [], throneGuildConfig: typeof throneGuildConfig !== 'undefined' ? throneGuildConfig : null, throneSettings: typeof throneSettings !== 'undefined' ? throneSettings : null } },
