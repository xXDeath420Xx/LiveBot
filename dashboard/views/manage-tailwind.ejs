            <% } else { %>
            <!-- Overview Dashboard with Module Grid -->
            <%
            // Feature status indicators — derive from existing data
            // Use try/catch per field to handle any undefined variables gracefully
            function safeCheck(fn) { try { return !!fn(); } catch(e) { return false; } }
            const featureStatus = {
                'streamers': safeCheck(() => consolidatedStreamers && consolidatedStreamers.length > 0),
                'twitch-schedules': safeCheck(() => twitchScheduleSyncs && twitchScheduleSyncs.length > 0),
                'tiktok': safeCheck(() => tiktokSubs && tiktokSubs.length > 0),
                'welcome': safeCheck(() => welcomeSettings && (welcomeSettings.enabled || welcomeSettings.join_channel_id)),
                'reaction-roles': safeCheck(() => reactionRolePanels && reactionRolePanels.length > 0),
                'starboard': safeCheck(() => starboardConfig && (starboardConfig.enabled || starboardConfig.channel_id)),
                'leveling': safeCheck(() => settings && settings.leveling_enabled),
                'giveaways': safeCheck(() => giveaways && giveaways.length > 0),
                'suggestions': safeCheck(() => suggestionConfig && suggestionConfig.channel_id),
                'music': safeCheck(() => musicConfig && musicConfig.enabled !== false),
                'moderation': safeCheck(() => moderationConfig && (moderationConfig.mod_role_id || moderationConfig.mute_role_id)),
                'automod': safeCheck(() => automodRules && automodRules.length > 0),
                'security': safeCheck(() => (joinGateConfig && joinGateConfig.enabled) || (antiRaidConfig && antiRaidConfig.enabled) || (antiNukeConfig && antiNukeConfig.enabled)),
                'advanced-protection': safeCheck(() => antiRaidConfig && antiRaidConfig.enabled),
                'phishing': safeCheck(() => phishingConfig && phishingConfig.enabled),
                'global-ban': safeCheck(() => globalBanConfig && globalBanConfig.enabled),
                'logging': safeCheck(() => logConfig && logConfig.log_channel_id),
                'auto-purge': safeCheck(() => purgeConfigs && purgeConfigs.length > 0),
                'self-promo': safeCheck(() => selfPromoConfig && selfPromoConfig.channel_id),
                'feeds': safeCheck(() => socialFeeds && socialFeeds.length > 0),
                'birthday': safeCheck(() => settings && settings.birthday_channel_id),
                'economy': safeCheck(() => settings && settings.economy_enabled),
                'custom-commands': safeCheck(() => prefixConfig && prefixConfig.enabled),
            };
            %>

            <!-- Quick Stats -->
            <div class="quick-stats">
                <div class="stat-card stat-purple">
                    <div class="stat-icon"><i class="fas fa-video"></i></div>
                    <div>
