                        <div class="stat-label">Streamers</div>
                    </div>
                </div>
                <div class="stat-card stat-green">
                    <div class="stat-icon"><i class="fas fa-circle"></i></div>
                    <div>
                        <div class="stat-value"><%= liveCount %></div>
                        <div class="stat-label">Live Now</div>
                    </div>
                </div>
                <div class="stat-card stat-cyan">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <div>
                        <div class="stat-value"><%= memberCount.toLocaleString() %></div>
                        <div class="stat-label">Members</div>
                    </div>
                </div>
                <div class="stat-card stat-red">
                    <div class="stat-icon"><i class="fas fa-user-friends"></i></div>
                    <div>
                        <div class="stat-value"><%= teamSubscriptions.length %></div>
                        <div class="stat-label">Teams</div>
                    </div>
                </div>
            </div>

            <!-- Support Banner -->
            <a href="https://certifriedmultitool.com/donate" target="_blank" class="support-banner">
                <div class="support-banner-glow"></div>
                <div class="support-banner-content">
                    <div class="support-banner-icon"><i class="fas fa-heart"></i></div>
                    <div class="support-banner-text">
                        <div class="support-banner-title">Support CertiFried MultiTool</div>
                        <div class="support-banner-desc">Help keep the bot running and fund new features</div>
                    </div>
                    <div class="support-banner-cta">
                        <span>Donate</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- Server Transfer Banner (shown when both default + custom bot are present) -->
            <div id="transferBanner" style="display:none; margin-bottom: 16px;">
                <div style="background: linear-gradient(135deg, rgba(124,58,237,0.15), rgba(239,68,68,0.1)); border: 1px solid rgba(124,58,237,0.3); border-radius: 12px; padding: 20px; position: relative; overflow: hidden;">
                    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                        <div style="flex-shrink: 0; width: 48px; height: 48px; background: rgba(124,58,237,0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-exchange-alt" style="font-size: 1.2rem; color: #a78bfa;"></i>
                        </div>
                        <div style="flex: 1; min-width: 200px;">
                            <div style="font-size: 1rem; font-weight: 700; color: #fff;">Transfer Server to Custom Bot</div>
                            <div style="font-size: 0.8rem; color: rgba(255,255,255,0.5); margin-top: 2px;" id="transferDesc">Migrate all panels, embeds, and interactive content to your custom bot</div>
                        </div>
                        <div style="display: flex; gap: 8px; flex-shrink: 0;">
                            <button id="transferPreviewBtn" onclick="previewTransfer()" style="background: #7c3aed; color: #fff; border: none; border-radius: 8px; padding: 10px 20px; cursor: pointer; font-weight: 600; font-size: 0.85rem; transition: all 0.2s;">
                                <i class="fas fa-eye" style="margin-right: 6px;"></i>Preview
                            </button>
                        </div>
                    </div>
                    <div id="transferPreview" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1);">
                        <div id="transferCounts" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 8px; margin-bottom: 16px;"></div>
                        <div style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; font-size: 0.8rem; color: #fca5a5;">
                            <i class="fas fa-exclamation-triangle" style="margin-right: 6px;"></i>
                            <strong>Warning:</strong> Active giveaway entries (reactions) cannot be transferred. The default bot will leave the server after transfer.
                        </div>
                        <div style="display: flex; gap: 8px; justify-content: flex-end;">
                            <button onclick="document.getElementById('transferPreview').style.display='none'" style="background: rgba(255,255,255,0.1); color: #d1d5db; border: none; border-radius: 8px; padding: 8px 16px; cursor: pointer; font-size: 0.85rem;">Cancel</button>
                            <button id="transferStartBtn" onclick="confirmTransfer()" style="background: #ef4444; color: #fff; border: none; border-radius: 8px; padding: 8px 16px; cursor: pointer; font-weight: 600; font-size: 0.85rem;">
                                <i class="fas fa-rocket" style="margin-right: 6px;"></i>Start Transfer
                            </button>
                        </div>
                    </div>
                    <div id="transferProgress" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1);">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                            <div style="width: 16px; height: 16px; border: 2px solid rgba(167,139,250,0.3); border-top-color: #a78bfa; border-radius: 50%; animation: xferspin 0.8s linear infinite;"></div>
                            <span id="transferStep" style="color: #a78bfa; font-weight: 600; font-size: 0.85rem;">Starting...</span>
                        </div>
                        <div id="transferItemProgress" style="font-size: 0.8rem; color: rgba(255,255,255,0.5);"></div>
                        <div id="transferErrors" style="display: none; margin-top: 8px; font-size: 0.8rem; color: #fca5a5;"></div>
                        <button onclick="abortXfer()" id="transferAbortBtn" style="margin-top: 12px; background: rgba(239,68,68,0.2); color: #f87171; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 6px 14px; cursor: pointer; font-size: 0.8rem;">Abort</button>
                    </div>
                    <div id="transferComplete" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
                        <i class="fas fa-check-circle" style="font-size: 2rem; color: #22c55e; margin-bottom: 8px;"></i>
                        <div style="color: #fff; font-weight: 700; font-size: 1rem;">Transfer Complete!</div>
                        <div id="transferSummary" style="color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-top: 4px;"></div>
                    </div>
                </div>
            </div>
            <style>@keyframes xferspin { to { transform: rotate(360deg); } }</style>
            <script>
            (function() {
                var gid = '<%= guild.id %>';
                var cBotId = null;
                fetch('/api/guilds/' + gid + '/custom-bot/').then(function(r){return r.json()}).then(function(d){
                    if (d.hasCustomBot && d.bot && d.bot.bot_id && d.defaultBotPresent) {
                        // Custom bot is assigned — check which direction transfer goes
                        // The "current" bot serving this guild is the custom bot
                        // If default bot is also present, offer transfer TO custom (default→custom)
                        // OR transfer BACK to default (custom→default)
                        cBotId = d.bot.bot_id;
                        var banner = document.getElementById('transferBanner');
                        var desc = document.getElementById('transferDesc');
                        var previewBtn = document.getElementById('transferPreviewBtn');
                        banner.style.display = 'block';

                        // Check if the bot serving the guild is the custom bot (guild_bot_mapping exists)
                        // If so, the default bot is the "extra" one — offer reverse transfer
                        // We know mapping exists because hasCustomBot=true
                        // Add both directions as buttons
                        desc.textContent = 'Transfer content between CertiFried Utility and ' + (d.bot.bot_name || 'your custom bot');
                        previewBtn.style.display = 'none';

                        var btnContainer = previewBtn.parentElement;
                        var toCustomBtn = document.createElement('button');
                        toCustomBtn.style.cssText = 'background:#7c3aed;color:#fff;border:none;border-radius:8px;padding:10px 16px;cursor:pointer;font-weight:600;font-size:0.82rem;';
                        toCustomBtn.textContent = 'Transfer to ' + (d.bot.bot_name || 'Custom Bot');
                        toCustomBtn.onclick = function() { xferDirection = 'to-custom'; previewTransfer(); };
                        btnContainer.appendChild(toCustomBtn);

                        var toDefaultBtn = document.createElement('button');
                        toDefaultBtn.style.cssText = 'background:rgba(255,255,255,0.1);color:#d1d5db;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:10px 16px;cursor:pointer;font-weight:600;font-size:0.82rem;';
                        toDefaultBtn.textContent = 'Transfer to CertiFried Utility';
                        toDefaultBtn.onclick = function() { xferDirection = 'to-default'; previewTransfer(); };
                        btnContainer.appendChild(toDefaultBtn);
                    }
                }).catch(function(){});

                var xferDirection = 'to-custom'; // or 'to-default'

                window.previewTransfer = async function() {
                    if (!cBotId) return;
                    var body = xferDirection === 'to-default'
                        ? { toBotId: 'default', fromBotId: cBotId }
                        : { toBotId: cBotId };
                    try {
                        var r = await fetch('/api/guilds/'+gid+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
                        var d = await r.json();
                        if (!d.success) { alert(d.error||'Validation failed'); return; }
                        var c = d.counts, el = document.getElementById('transferCounts');
                        var labels = {reactionPanels:'Reaction Panels',ticketPanels:'Ticket Panels',customEmbeds:'Custom Embeds',activeGiveaways:'Giveaways',activePolls:'Polls',stickyMessages:'Sticky Messages',musicPanels:'Music Panels'};
                        while(el.firstChild) el.removeChild(el.firstChild);
                        for (var k in labels) {
                            if (c[k]>0) {
                                var div=document.createElement('div');
                                div.style.cssText='background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:8px 12px;text-align:center;';
                                var n=document.createElement('div');n.style.cssText='font-size:1.2rem;font-weight:700;color:#a78bfa;';n.textContent=c[k];
                                var l=document.createElement('div');l.style.cssText='font-size:0.7rem;color:rgba(255,255,255,0.4);';l.textContent=labels[k];
                                div.appendChild(n);div.appendChild(l);el.appendChild(div);
                            }
                        }
                        var tot=document.createElement('div');tot.style.cssText='background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:8px 12px;text-align:center;';
                        var tn=document.createElement('div');tn.style.cssText='font-size:1.2rem;font-weight:700;color:#fff;';tn.textContent=c.total;
                        var tl=document.createElement('div');tl.style.cssText='font-size:0.7rem;color:rgba(255,255,255,0.4);';tl.textContent='Total';
                        tot.appendChild(tn);tot.appendChild(tl);el.appendChild(tot);
                        document.getElementById('transferPreview').style.display='block';
                    } catch(e){alert(e.message)}
                };

                window.confirmTransfer = async function() {
                    var dirLabel = xferDirection === 'to-default' ? 'Transfer ALL content back to CertiFried Utility and remove the custom bot?' : 'Transfer ALL content to the custom bot and remove CertiFried Utility?';
                    if (!cBotId||!confirm(dirLabel + ' This cannot be undone.')) return;
                    document.getElementById('transferPreview').style.display='none';
                    document.getElementById('transferProgress').style.display='block';
                    try {
                        var body = xferDirection === 'to-default'
                            ? {toBotId:'default',fromBotId:cBotId,confirmed:true}
                            : {toBotId:cBotId,confirmed:true};
                        var r=await fetch('/api/guilds/'+gid+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
                        var d=await r.json();
                        if(!d.success){alert(d.error);return;}
                        pollXfer();
                    }catch(e){alert(e.message)}
                };

                function pollXfer() {
                    var iv=setInterval(async function(){
                        try{
                            var r=await fetch('/api/guilds/'+gid+'/transfer/status');
                            var d=await r.json();
                            var p=d.active?d:{};
                            if(!d.active&&d.transfer&&d.transfer.progress){try{p=typeof d.transfer.progress==='string'?JSON.parse(d.transfer.progress):d.transfer.progress;}catch(e){p={};}}
                            var step=p.step||(d.transfer?d.transfer.status:null)||'starting...';
                            document.getElementById('transferStep').textContent=step;
                            var items=p.items||{};
                            var prog=document.getElementById('transferItemProgress');
                            while(prog.firstChild)prog.removeChild(prog.firstChild);
                            for(var k in items){
                                var row=document.createElement('div');
                                row.textContent=k+': '+(items[k].done||0)+'/'+(items[k].total||0)+(items[k].errors>0?' ('+items[k].errors+' errors)':'');
                                prog.appendChild(row);
                            }
                            var errs=p.errors||[];
                            if(errs.length>0){
                                var errEl=document.getElementById('transferErrors');
                                errEl.style.display='block';
                                while(errEl.firstChild)errEl.removeChild(errEl.firstChild);
                                errs.forEach(function(e){var div=document.createElement('div');div.textContent='⚠ '+e;errEl.appendChild(div);});
                            }
                            if(step==='completed'||step==='failed'||step==='aborted'){
                                clearInterval(iv);
                                document.getElementById('transferProgress').style.display='none';
                                if(step==='completed'){
                                    document.getElementById('transferComplete').style.display='block';
                                    document.getElementById('transferSummary').textContent='All content migrated. Default bot has left the server.';
                                }else{
                                    document.getElementById('transferStep').textContent=step==='failed'?'Failed: '+(p.error||'Unknown'):' Aborted';
                                    document.getElementById('transferProgress').style.display='block';
                                    document.getElementById('transferAbortBtn').style.display='none';
                                }
                            }
                        }catch(e){}
                    },2000);
                }

                window.abortXfer = async function(){
                    if(!confirm('Abort? Already-transferred content stays with the new bot.'))return;
                    fetch('/api/guilds/'+gid+'/transfer/abort',{method:'POST'});
                };
            })();
            </script>

            <!-- Recently Visited -->
            <div class="recent-visited" id="recentVisited" style="display:none;">
                <div class="recent-visited-label"><i class="fas fa-history"></i> Recently Visited</div>
                <div class="recent-visited-grid" id="recentVisitedGrid"></div>
            </div>

            <!-- Search & Filter Bar -->
            <div class="overview-search-wrap">
                <div class="overview-search">
                    <i class="fas fa-search"></i>
                    <input type="text" id="overviewSearch" placeholder="Search settings... (Ctrl+K)" autocomplete="off">
                </div>
                <div class="category-tabs" id="categoryTabs">
                    <button class="category-tab active" data-cat="all">All <span class="tab-count">57</span></button>
