                    'self-promo': { partial: 'self-promo', data: { guild, selfPromoConfig: typeof selfPromoConfig !== 'undefined' ? selfPromoConfig : {}, channels } },
                    'community-support': { partial: 'community-support', data: { guild, communitySupportConfig: typeof communitySupportConfig !== 'undefined' ? communitySupportConfig : {}, channels } },
