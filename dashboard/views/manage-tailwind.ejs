    <!-- Global showToast for all partials -->
    <script>
    window.showToast = window.showToast || function(msg, type) {
        var existing = document.querySelector('.global-toast');
        if (existing) existing.remove();
        var toast = document.createElement('div');
        toast.className = 'global-toast';
        toast.style.cssText = 'position:fixed;bottom:24px;right:24px;padding:12px 20px;border-radius:10px;font-size:0.85rem;font-weight:600;z-index:10001;animation:fadeInUp 0.3s ease;box-shadow:0 8px 24px rgba(0,0,0,0.3);' + (type === 'success' ? 'background:#059669;color:white;' : type === 'error' ? 'background:#dc2626;color:white;' : 'background:#1a1d23;color:white;border:1px solid rgba(255,255,255,0.1);');
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.remove(); }, 4000);
    };
    </script>

    <!-- Global AJAX form interceptor — converts all POST forms to no-reload saves -->
    <script>
    (function() {
        document.addEventListener('submit', async function(e) {
            // If another handler already called preventDefault, this form has its own AJAX handler — skip
            if (e.defaultPrevented) return;
            var form = e.target;
            if (!form || form.method.toUpperCase() !== 'POST') return;
            // Skip forms that explicitly opt out
            if (form.dataset.noAjax) return;
            // Skip file upload forms (multipart needs special handling)
            if (form.enctype === 'multipart/form-data') return;

            e.preventDefault();

            var action = form.getAttribute('action');
            var submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
            var originalText = submitBtn ? submitBtn.textContent : '';

            // Disable button and show loading state
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.6';
                submitBtn.textContent = 'Saving...';
            }

            try {
                var formData = new FormData(form);
                var resp = await fetch(action, {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    credentials: 'include',
                    redirect: 'follow',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                // Check if server returned JSON
                var contentType = resp.headers.get('content-type') || '';
                if (contentType.includes('application/json')) {
                    var data = await resp.json();
                    if (data.success || data.ok) {
                        showToast(data.message || 'Saved successfully!', 'success');
                    } else {
                        showToast(data.error || data.message || 'Failed to save', 'error');
                    }
                } else if (resp.status === 404) {
                    showToast('This feature is not yet available', 'error');
                } else if (resp.status >= 400) {
                    showToast('Request failed (status ' + resp.status + ')', 'error');
                } else {
                    // Server returned HTML (redirect was followed) — check URL for success/error params
                    var url = new URL(resp.url);
                    if (url.searchParams.has('success')) {
                        var successType = url.searchParams.get('success');
                        var messages = {
                            'created': 'Created successfully!',
                            'updated': 'Updated successfully!',
                            'deleted': 'Deleted successfully!',
                            'saved': 'Settings saved!',
                            'restored': 'Restore complete!',
                            'restore_logged': 'Restore logged for review'
                        };
                        showToast(messages[successType] || 'Saved successfully!', 'success');
                    } else if (url.searchParams.has('error')) {
                        showToast('Error: ' + (url.searchParams.get('error') || 'Something went wrong'), 'error');
                    } else if (resp.ok) {
                        showToast('Saved successfully!', 'success');
                    } else {
                        showToast('Request failed', 'error');
                    }
                }

                // Reload the page content without full refresh for forms that change visible data
                // Only reload if the form action suggests data was created/deleted (not just config updates)
                var actionPath = action.startsWith('/') ? action : new URL(action).pathname;
                if (actionPath.match(/\/(create|add|delete|remove|import|sync|edit)/)) {
                    setTimeout(function() { window.location.reload(); }, 800);
                }
            } catch (err) {
                showToast('Network error: ' + err.message, 'error');
            }

            // Restore button
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.style.opacity = '';
                submitBtn.textContent = originalText;
            }
        }); // Bubble phase — runs AFTER partial-specific handlers, so e.defaultPrevented check works
    })();
    </script>

