            <!-- Page Content -->
            <div class="page-content">
                <%
                const streamingData = { guild, consolidatedStreamers, teamSubscriptions, twitchScheduleSyncs: typeof twitchScheduleSyncs !== 'undefined' ? twitchScheduleSyncs : [], autoTrackConfigs: typeof autoTrackConfigs !== 'undefined' ? autoTrackConfigs : [], streamEndedSubs: typeof streamEndedSubs !== 'undefined' ? streamEndedSubs : [], settings, channels, roles, twitchRoleSyncConfig: typeof twitchRoleSyncConfig !== 'undefined' ? twitchRoleSyncConfig : null, twitchRoleSyncMembers: typeof twitchRoleSyncMembers !== 'undefined' ? twitchRoleSyncMembers : [] };
                const pageMap = {
                    'streaming': { partial: 'streaming', data: streamingData },
