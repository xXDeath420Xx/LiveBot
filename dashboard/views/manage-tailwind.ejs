    const automodRules = locals.automodRules || [];
    const heatConfig = locals.heatConfig || {};
    const joinGateConfig = locals.joinGateConfig || {};
    const antiRaidConfig = locals.antiRaidConfig || {};
    const antiNukeConfig = locals.antiNukeConfig || {};
    const quarantineConfig = locals.quarantineConfig || {};
    const statroleConfigs = locals.statroleConfigs || [];
    const logConfig = locals.logConfig || {};
    const actionLogs = locals.actionLogs || [];
    const channelSettingsMap = locals.channelSettingsMap || new Map();
    const analyticsData = locals.analyticsData || {};
    const redditFeeds = locals.redditFeeds || [];
    const youtubeFeeds = locals.youtubeFeeds || [];
    const twitterFeeds = locals.twitterFeeds || [];
    const twitchScheduleSyncs = locals.twitchScheduleSyncs || [];
    const autoPublisherConfig = locals.autoPublisherConfig || {};
    const autorolesConfig = locals.autorolesConfig || {};
    const tempChannelConfig = locals.tempChannelConfig || {};
    const tempChannels = tempChannelConfig;
    const customCommands = locals.customCommands || [];
    const commandSettings = locals.commandSettings || [];
    const forms = locals.forms || [];
    const ticketConfig = locals.ticketConfig || {};
    const ticketFormsList = locals.ticketFormsList || [];
    const backups = locals.backups || [];
    const permissionOverrides = locals.permissionOverrides || [];
    const reminders = locals.reminders || [];
    const tags = locals.tags || [];
    const roles = locals.roles || [];
    const channels = locals.channels || [];
    const categories = locals.categories || [];

    // Stats
    const memberCount = guild.memberCount || 0;
    const liveCount = consolidatedStreamers.filter(s => s.is_live).length;
    const streamerCount = consolidatedStreamers.length;

    // Page titles for breadcrumb
    const pageTitles = {
        'overview': 'Overview',
        'streamers': 'Streamers',
        'teams': 'Teams',
        'appearance': 'Appearance',
        'core': 'Core Settings',
        'welcome': 'Welcome',
        'reaction-roles': 'Reaction Roles',
        'starboard': 'Starboard',
        'leveling': 'Leveling',
        'giveaways': 'Giveaways',
        'polls': 'Polls',
        'suggestions': 'Suggestions',
        'music': 'Music',
        'schedule': 'Schedule',
        'birthday': 'Birthdays',
        'weather': 'Weather',
        'confessions': 'Confessions',
        'timecapsules': 'Time Capsules',
        'economy': 'Economy',
        'games': 'Games',
        'gambling': 'Gambling',
        'trading': 'Trading',
        'rpg': 'RPG',
        'achievements': 'Achievements',
        'moderation': 'Moderation',
        'automod': 'AutoMod',
        'security': 'Security',
        'advanced-protection': 'Advanced Protection',
        'quarantine': 'Quarantine',
        'mass': 'Mass Actions',
        'stat-roles': 'Stat Roles',
        'logging': 'Logging',
        'action-log': 'Action Log',
        'analytics': 'Analytics',
        'serverstats': 'Server Stats',
        'emojistats': 'Emoji Stats',
        'feeds': 'Social Feeds',
        'twitch-schedules': 'Twitch Schedules',
        'announcements': 'Announcements',
        'automemes': 'Auto-Memes',
        'utilities': 'Utilities',
        'custom-commands': 'Custom Commands',
        'commands': 'Commands',
        'forms': 'Forms',
        'tickets': 'Tickets',
        'backups': 'Backups',
        'permissions': 'Permissions',
        'reminders': 'Reminders',
        'tags': 'Tags',
        'csv': 'CSV Import/Export',
        'sticky': 'Sticky Messages',
        'self-promo': 'Self-Promo',
        'community-support': 'Community Support',
        'stream-ended': 'Stream-Ended Behavior',
        'auto-track': 'Auto-Track'
    };
    %>

    <div class="bg-effects"><div class="orb orb-1"></div><div class="orb orb-2"></div></div>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-content">
                <a href="/" class="navbar-brand">
                    <img src="/images/CertiFried.png" alt="CertiFried" class="navbar-logo">
                    <span>CertiFried</span>
                </a>
                <div class="navbar-links">
                    <a href="/">Home</a>
                    <a href="/commands">Commands</a>
                    <a href="/status">Status</a>
                    <a href="/dashboard" class="active">Dashboard</a>
                    <a href="/lb/<%= guild.id %>">Leaderboard</a>
                    <a href="/supporters/<%= guild.id %>">Supporters</a>
                </div>
                <% if (user) { %>
                <div class="user-menu-container" id="userMenuContainer">
                    <div class="user-menu" id="userMenuBtn">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="" class="user-avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                        <span class="user-name"><%= user.username %></span>
                        <i class="fas fa-chevron-down user-menu-chevron"></i>
                    </div>
                    <div class="user-dropdown">
                        <div class="dropdown-header">
                            <div class="dropdown-user-info">Signed in as <strong><%= user.username %></strong></div>
                        </div>
                        <a href="/profile" class="dropdown-item">
                            <i class="fas fa-user"></i>
                            <span>Profile</span>
                        </a>
                        <a href="/servers" class="dropdown-item">
                            <i class="fas fa-server"></i>
                            <span>My Servers</span>
                        </a>
                        <% if (user.isSuperAdmin || user.canCreateBots) { %>
                        <div class="dropdown-divider"></div>
                        <% } %>
                        <% if (user.canCreateBots || user.isSuperAdmin) { %>
                        <a href="/bot-management" class="dropdown-item text-warning">
                            <i class="fas fa-robot"></i>
                            <span>Bot Management</span>
                        </a>
                        <% } %>
                        <% if (user.isSuperAdmin) { %>
                        <a href="/super-admin" class="dropdown-item text-warning">
                            <i class="fas fa-shield-alt"></i>
                            <span>Super Admin</span>
                        </a>
                        <% } %>
                        <div class="dropdown-divider"></div>
                        <a href="/logout" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Log Out</span>
                        </a>
                    </div>
                </div>
                <% } else { %>
                <a href="/auth/discord" class="user-menu">
                    <i class="fab fa-discord"></i>
                    <span class="user-name">Login</span>
                </a>
                <% } %>
                <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-inner">
            <a href="/" class="mobile-menu-link">Home</a>
            <a href="/commands" class="mobile-menu-link">Commands</a>
            <a href="/status" class="mobile-menu-link">Status</a>
            <a href="/dashboard" class="mobile-menu-link">Dashboard</a>
            <a href="/lb/<%= guild.id %>" class="mobile-menu-link">Leaderboard</a>
            <a href="/supporters/<%= guild.id %>" class="mobile-menu-link">Supporters</a>
        </div>
    </div>

    <main>
        <div class="container">
            <!-- Server Header -->
            <div class="server-header">
                <div class="server-icon-wrap">
                    <img src="<%= guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=128` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" class="server-icon" alt="<%= guild.name %>">
                    <div class="server-status"></div>
                </div>
                <div class="server-info">
                    <h1 class="server-name"><%= guild.name %></h1>
                    <div class="server-meta">
                        <span class="server-meta-item"><i class="fas fa-users"></i> <%= memberCount.toLocaleString() %> members</span>
                        <span class="server-meta-item"><i class="fas fa-video"></i> <%= streamerCount %> streamers</span>
                        <% if (liveCount > 0) { %>
                        <span class="server-meta-item" style="color: var(--accent-green);"><i class="fas fa-circle" style="font-size: 0.5rem;"></i> <%= liveCount %> live now</span>
                        <% } %>
