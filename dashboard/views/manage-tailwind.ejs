                                <li><a href="/manage/<%= guild.id %>?page=<%= it.page %>"<% if (cur) { %> aria-current="page"<% } %><% if (_st) { %> class="has-dot"<% } %>><%= it.title %><% if (_st) { %><span class="cf-nav-dot is-<%= _st %>" role="img" aria-label="<%= stateLabel[_st] %>" title="<%= _st === 'on' ? 'On' : 'Set up, switched off' %>"></span><% } %></a></li>
