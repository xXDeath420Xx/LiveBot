                const activePage = pageMap[page];
                if (activePage) {
                %>
                    <!--
                      Seed the channel/role lookups before the partial's own script runs, so any
                      partial can call Discord.channel(id) without re-serialising the guild.
                    -->
                    <script>
                        // Which tab this page opens on, for partials that serve more than one page.
                        window.MANAGE_PAGE = <%- JSON.stringify(page) %>;
                        window.MANAGE_PAGE_TAB = <%- JSON.stringify(activePage.tab || null) %>;
                        Discord.init({
                            guildId: '<%= guild.id %>',
