            <% } else { %>
            <!-- Overview. featureStatus: pages whose on/off state is known from data already loaded. Pages not listed have no badge (unknown is not off). -->
            <%
            // Badges on the page lists below: the same map as the sidebar dots (pageState, above).
            const featureStatus = pageState;
            %>
            <header class="cf-ov-head">
                <h1 class="cf-ov-title"><%= guild.name %></h1>
                <p class="cf-ov-meta">Server overview · <%= memberCount.toLocaleString() %> members</p>
            </header>

            <%# The icon tiles show in the Cards and Classic styles; Compact hides them (cf-manage.css). %>
            <dl class="cf-stats" aria-label="Server at a glance">
                <div class="cf-stat" data-sec="setup"><dt><span class="cf-stat-icon" aria-hidden="true"><i class="fas fa-users"></i></span>Members</dt><dd class="cf-num"><%= memberCount.toLocaleString() %></dd></div>
                <div class="cf-stat" data-sec="streams"><dt><span class="cf-stat-icon" aria-hidden="true"><i class="fas fa-tower-broadcast"></i></span>Streamers tracked</dt><dd class="cf-num"><%= streamerCount %></dd></div>
                <div class="cf-stat" data-sec="protection"><dt><span class="cf-stat-icon" aria-hidden="true"><i class="fas fa-circle-play"></i></span>Live now</dt><dd class="cf-num"><% if (liveCount > 0) { %><span class="cf-live-dot" aria-hidden="true"></span><% } %><%= liveCount %></dd></div>
                <div class="cf-stat" data-sec="media"><dt><span class="cf-stat-icon" aria-hidden="true"><i class="fas fa-people-group"></i></span>Stream teams</dt><dd class="cf-num"><%= teamSubscriptions.length %></dd></div>
            </dl>

            <%# Last 7 days: messages, joins and leaves (services/manage-sections.js LOADERS.overview). %>
            <%- include('partials/manage/_overview-activity', { guild, activity: locals.overviewActivity || null }) %>

            <%# Setup checklist (core/setup-checklist.js); not rendered at all once this user hid it here. %>
            <% if (!locals.checklistHidden) { %><%- include('partials/manage/_setup-checklist', { guild }) %><% } %>

            <!-- Server Transfer Banner (shown when both default + custom bot are present) -->
            <div id="transferBanner" class="cf-callout" style="display:none;">
                <div class="cf-callout-row">
                    <div class="cf-callout-text">
                        <div class="cf-callout-title">Move this server to your custom bot</div>
                        <div class="cf-callout-desc" id="transferDesc">Moves panels, embeds and other interactive messages to your custom bot.</div>
                    </div>
                    <div class="cf-callout-actions">
                        <button type="button" id="transferPreviewBtn" class="btn btn-sm btn-secondary" onclick="previewTransfer()">Preview</button>
                    </div>
                </div>
                <div id="transferPreview" class="cf-callout-section" style="display: none;">
                    <div id="transferCounts" class="cf-xfer-counts"></div>
                    <div class="alert alert-warning">Giveaway entries (reactions) cannot be moved. The default bot leaves the server once the transfer finishes.</div>
                    <div class="cf-callout-actions cf-callout-actions--end">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('transferPreview').style.display='none'">Cancel</button>
                        <button type="button" id="transferStartBtn" class="btn btn-sm btn-danger" onclick="confirmTransfer()">Start transfer</button>
                    </div>
                </div>
                <div id="transferProgress" class="cf-callout-section" style="display: none;">
                    <div class="cf-xfer-step"><span class="cf-spinner" aria-hidden="true"></span><span id="transferStep">Starting…</span></div>
                    <div id="transferItemProgress" class="cf-xfer-items"></div>
                    <div id="transferErrors" class="cf-xfer-errors" style="display: none;"></div>
                    <button type="button" onclick="abortXfer()" id="transferAbortBtn" class="btn btn-sm btn-danger">Abort</button>
                </div>
                <div id="transferComplete" class="cf-callout-section" style="display: none;">
                    <div class="cf-callout-title">Transfer complete</div>
                    <div id="transferSummary" class="cf-callout-desc"></div>
                </div>
            </div>
            <script>
            (function() {
                var gid = '<%= guild.id %>';
                var cBotId = null;
                fetch('/api/guilds/' + gid + '/custom-bot/').then(function(r){return r.json()}).then(function(d){
                    if (d.hasCustomBot && d.bot && d.bot.bot_id && d.defaultBotPresent) {
                        // Custom bot is assigned — check which direction transfer goes
                        // The "current" bot serving this guild is the custom bot
                        // If default bot is also present, offer transfer TO custom (default→custom)
                        // OR transfer BACK to default (custom→default)
                        cBotId = d.bot.bot_id;
                        var banner = document.getElementById('transferBanner');
                        var desc = document.getElementById('transferDesc');
                        var previewBtn = document.getElementById('transferPreviewBtn');
                        banner.style.display = 'block';

                        // Check if the bot serving the guild is the custom bot (guild_bot_mapping exists)
                        // If so, the default bot is the "extra" one — offer reverse transfer
                        // We know mapping exists because hasCustomBot=true
                        // Add both directions as buttons
                        desc.textContent = 'Move content between CertiFried Utility and ' + (d.bot.bot_name || 'your custom bot') + '.';
                        previewBtn.style.display = 'none';

                        var btnContainer = previewBtn.parentElement;
                        var toCustomBtn = document.createElement('button');
                        toCustomBtn.type = 'button';
                        toCustomBtn.className = 'btn btn-sm btn-primary';
                        toCustomBtn.textContent = 'Move to ' + (d.bot.bot_name || 'custom bot');
                        toCustomBtn.onclick = function() { xferDirection = 'to-custom'; previewTransfer(); };
                        btnContainer.appendChild(toCustomBtn);

                        var toDefaultBtn = document.createElement('button');
                        toDefaultBtn.type = 'button';
                        toDefaultBtn.className = 'btn btn-sm btn-secondary';
                        toDefaultBtn.textContent = 'Move back to CertiFried Utility';
                        toDefaultBtn.onclick = function() { xferDirection = 'to-default'; previewTransfer(); };
                        btnContainer.appendChild(toDefaultBtn);
                    }
                }).catch(function(){});

                var xferDirection = 'to-custom'; // or 'to-default'

                window.previewTransfer = async function() {
                    if (!cBotId) return;
                    var body = xferDirection === 'to-default'
                        ? { toBotId: 'default', fromBotId: cBotId }
                        : { toBotId: cBotId };
                    try {
                        var r = await fetch('/api/guilds/'+gid+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
                        var d = await r.json();
                        if (!d.success) { alert(d.error||'Validation failed'); return; }
                        var c = d.counts, el = document.getElementById('transferCounts');
                        var labels = {reactionPanels:'Reaction Panels',ticketPanels:'Ticket Panels',customEmbeds:'Custom Embeds',activeGiveaways:'Giveaways',activePolls:'Polls',stickyMessages:'Sticky Messages',musicPanels:'Music Panels'};
                        while(el.firstChild) el.removeChild(el.firstChild);
                        for (var k in labels) {
                            if (c[k]>0) {
                                var div=document.createElement('div');
                                div.className='cf-xfer-count';
                                var n=document.createElement('div');n.className='cf-xfer-count-n';n.textContent=c[k];
                                var l=document.createElement('div');l.className='cf-xfer-count-l';l.textContent=labels[k];
                                div.appendChild(n);div.appendChild(l);el.appendChild(div);
                            }
                        }
                        var tot=document.createElement('div');tot.className='cf-xfer-count';
                        var tn=document.createElement('div');tn.className='cf-xfer-count-n';tn.textContent=c.total;
                        var tl=document.createElement('div');tl.className='cf-xfer-count-l';tl.textContent='Total';
                        tot.appendChild(tn);tot.appendChild(tl);el.appendChild(tot);
                        document.getElementById('transferPreview').style.display='block';
                    } catch(e){alert(e.message)}
                };

                window.confirmTransfer = async function() {
                    var dirLabel = xferDirection === 'to-default' ? 'Transfer ALL content back to CertiFried Utility and remove the custom bot?' : 'Transfer ALL content to the custom bot and remove CertiFried Utility?';
                    if (!cBotId||!confirm(dirLabel + ' This cannot be undone.')) return;
                    document.getElementById('transferPreview').style.display='none';
                    document.getElementById('transferProgress').style.display='block';
                    try {
                        var body = xferDirection === 'to-default'
                            ? {toBotId:'default',fromBotId:cBotId,confirmed:true}
                            : {toBotId:cBotId,confirmed:true};
                        var r=await fetch('/api/guilds/'+gid+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
                        var d=await r.json();
                        if(!d.success){alert(d.error);return;}
                        pollXfer();
                    }catch(e){alert(e.message)}
                };

                function pollXfer() {
                    var iv=setInterval(async function(){
                        try{
                            var r=await fetch('/api/guilds/'+gid+'/transfer/status');
                            var d=await r.json();
                            var p=d.active?d:{};
                            if(!d.active&&d.transfer&&d.transfer.progress){try{p=typeof d.transfer.progress==='string'?JSON.parse(d.transfer.progress):d.transfer.progress;}catch(e){p={};}}
                            var step=p.step||(d.transfer?d.transfer.status:null)||'starting...';
                            document.getElementById('transferStep').textContent=step;
                            var items=p.items||{};
                            var prog=document.getElementById('transferItemProgress');
                            while(prog.firstChild)prog.removeChild(prog.firstChild);
                            for(var k in items){
                                var row=document.createElement('div');
                                row.textContent=k+': '+(items[k].done||0)+'/'+(items[k].total||0)+(items[k].errors>0?' ('+items[k].errors+' errors)':'');
                                prog.appendChild(row);
                            }
                            var errs=p.errors||[];
                            if(errs.length>0){
                                var errEl=document.getElementById('transferErrors');
                                errEl.style.display='block';
                                while(errEl.firstChild)errEl.removeChild(errEl.firstChild);
                                errs.forEach(function(e){var div=document.createElement('div');div.textContent=e;errEl.appendChild(div);});
                            }
                            if(step==='completed'||step==='failed'||step==='aborted'){
                                clearInterval(iv);
                                document.getElementById('transferProgress').style.display='none';
                                if(step==='completed'){
                                    document.getElementById('transferComplete').style.display='block';
                                    document.getElementById('transferSummary').textContent='All content migrated. Default bot has left the server.';
                                }else{
                                    document.getElementById('transferStep').textContent=step==='failed'?'Failed: '+(p.error||'Unknown'):' Aborted';
                                    document.getElementById('transferProgress').style.display='block';
                                    document.getElementById('transferAbortBtn').style.display='none';
                                }
                            }
                        }catch(e){}
                    },2000);
                }

                window.abortXfer = async function(){
                    if(!confirm('Abort? Already-transferred content stays with the new bot.'))return;
                    fetch('/api/guilds/'+gid+'/transfer/abort',{method:'POST'});
                };
            })();
            </script>

            <!-- Pinned (server-synced) and Recently Visited (per-browser) -->
