                    'commands': { partial: 'commands', data: { guild, commands: typeof commandSettings !== 'undefined' ? commandSettings : [], commandRestrictions: typeof commandRestrictions !== 'undefined' ? commandRestrictions : {}, guildId: guild.id, prefixConfig: typeof prefixConfig !== 'undefined' ? prefixConfig : {}, prefixAliases: typeof prefixAliases !== 'undefined' ? prefixAliases : [] } },
