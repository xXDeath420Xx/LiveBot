<script>
/* Layout preference. Applies instantly for feel, then persists so the choice
   follows the user to their next device — Recently Visited is localStorage-only
   and doesn't. A failed save is surfaced rather than silently reverting, which
   would look like the button simply didn't work. */
(function () {
    const main = document.getElementById('main-content');
    if (!main) return;

    const CSRF = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    const buttons = document.querySelectorAll('[data-layout-set]');
    const paint = (layout) => buttons.forEach((b) => b.classList.toggle('is-on', b.dataset.layoutSet === layout));
    paint(main.getAttribute('data-layout') || 'grid');

    buttons.forEach((btn) => btn.addEventListener('click', async () => {
        const layout = btn.dataset.layoutSet;
        const previous = main.getAttribute('data-layout');
        if (layout === previous) return;

        main.setAttribute('data-layout', layout);
        paint(layout);

        try {
            const res = await fetch('/api/me/preferences', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    // /api/me/* is NOT in the CSRF ignorePaths (unlike /manage),
                    // so the token is required or this 403s. Same header the
                    // bot-management page uses.
                    'X-CSRF-Token': CSRF,
                },
                body: JSON.stringify({ dashboardLayout: layout }),
            });
            if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || 'Save failed');
        } catch (err) {
            main.setAttribute('data-layout', previous);
            paint(previous);
            console.warn('[layout] could not save preference:', err.message);
        }
    }));
})();
</script>

<script>
/* ---------------------------------------------------------------------------
   Arrangeable dashboard.

   Sections are reordered by moving the real <section> elements, so search,
   category tabs and collapse all keep working on the same DOM they always did —
   no shadow model to fall out of sync.

   Order is applied on load from the server-rendered list rather than by JS
   after paint, which would show the shipped order first and then jump.

   Every change saves immediately. A failed save reverts VISIBLY: silently
   rolling back looks like the drag simply didn't take.
--------------------------------------------------------------------------- */
(function () {
    const main = document.getElementById('main-content');
    const container = document.getElementById('cfSections');
    if (!main || !container) return;

    const CSRF = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    const serverOrder = <%- JSON.stringify(locals.uiSectionOrder || []) %>;
    const hidden = new Set(<%- JSON.stringify((locals.userPrefs && userPrefs.hiddenSections) || []) %>);

    const sections = () => [...container.querySelectorAll('.modules-section')];
    const keyOf = (el) => el.dataset.category;

    // ---- apply saved state ------------------------------------------------
    if (serverOrder.length) {
        const byKey = new Map(sections().map((el) => [keyOf(el), el]));
        // Append in saved order; anything not named keeps its relative position
        // at the end, so a section added after the user last arranged things
        // still appears rather than vanishing.
        serverOrder.forEach((k) => { const el = byKey.get(k); if (el) container.appendChild(el); });
    }
    sections().forEach((el) => el.classList.toggle('is-hidden', hidden.has(keyOf(el))));

    async function save(payload) {
        const res = await fetch('/api/me/preferences', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': CSRF },
            body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || `Save failed (${res.status})`);
    }

    const currentOrder = () => sections().map(keyOf);

    async function persist() {
        const snapshot = currentOrder();
        try {
            await save({ sectionOrder: snapshot, hiddenSections: [...hidden] });
        } catch (err) {
            console.warn('[arrange] save failed:', err.message);
            alert('Could not save your layout: ' + err.message);
        }
    }

    // ---- arrange mode -----------------------------------------------------
    const toggle = document.getElementById('arrangeToggle');
    const bar = document.getElementById('arrangeBar');
    let arranging = false;

    function setArranging(on) {
        arranging = on;
        main.setAttribute('data-arranging', on ? '1' : '0');
        if (bar) bar.hidden = !on;
        if (toggle) {
            toggle.classList.toggle('is-on', on);
            toggle.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        sections().forEach((el) => { el.draggable = on; });
    }
    if (toggle) toggle.addEventListener('click', () => setArranging(!arranging));

    // ---- drag -------------------------------------------------------------
    let dragged = null;
    container.addEventListener('dragstart', (e) => {
        const el = e.target.closest('.modules-section');
        if (!arranging || !el) return;
        dragged = el;
        el.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
    });
    container.addEventListener('dragend', () => {
        if (!dragged) return;
        dragged.classList.remove('dragging');
        sections().forEach((el) => el.classList.remove('drop-target'));
        dragged = null;
        persist();
    });
    container.addEventListener('dragover', (e) => {
        if (!arranging || !dragged) return;
        e.preventDefault();
        const over = e.target.closest('.modules-section');
        if (!over || over === dragged) return;
        sections().forEach((el) => el.classList.toggle('drop-target', el === over));
        const rect = over.getBoundingClientRect();
        const after = (e.clientY - rect.top) > rect.height / 2;
        container.insertBefore(dragged, after ? over.nextSibling : over);
    });

    // ---- keyboard / button controls --------------------------------------
    // Drag-and-drop alone is unusable without a mouse, so the same three
    // operations exist as buttons.
    container.addEventListener('click', (e) => {
        const up = e.target.closest('[data-section-up]');
        const down = e.target.closest('[data-section-down]');
        const hide = e.target.closest('[data-section-hide]');
        if (!up && !down && !hide) return;

        e.preventDefault();
        e.stopPropagation();
        const el = e.target.closest('.modules-section');
        if (!el) return;

        if (up && el.previousElementSibling) container.insertBefore(el, el.previousElementSibling);
        if (down && el.nextElementSibling) container.insertBefore(el.nextElementSibling, el);
        if (hide) {
            const k = keyOf(el);
            if (hidden.has(k)) hidden.delete(k); else hidden.add(k);
            el.classList.toggle('is-hidden', hidden.has(k));
        }
        persist();
    });

    // ---- reset ------------------------------------------------------------
    const reset = document.getElementById('arrangeReset');
    if (reset) reset.addEventListener('click', async () => {
        try {
            await save({ sectionOrder: null, hiddenSections: [] });
            location.reload();
        } catch (err) {
            alert('Could not reset: ' + err.message);
        }
    });
})();
</script>
