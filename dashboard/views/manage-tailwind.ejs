                        <i class="fas fa-arrow-left"></i>
                        All Servers
                    </a>
                </div>
            </div>

            <% if (page && page !== 'overview') { %>
            <!-- Breadcrumb for sub-pages -->
            <nav class="breadcrumb-nav">
