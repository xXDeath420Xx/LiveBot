            var sectionEl = card.closest('.modules-section');
            var section = sectionEl ? (sectionEl.querySelector('.section-title') || {}).textContent || '' : '';
            var colorMatch = card.className.match(/module-card\s+(\w+)/);
            var color = colorMatch ? colorMatch[1] : 'purple';
            title = title.trim();
            desc = desc.trim();
            section = section.trim();
            var tags = card.getAttribute('data-tags') || '';
            modules.push({ title: title, desc: desc, iconClass: iconClass, href: href, section: section, color: color, searchText: (title + ' ' + desc + ' ' + section + ' ' + tags).toLowerCase() });
        });

        var overlay = document.getElementById('ffOverlay');
        var input = document.getElementById('ffInput');
        var resultsContainer = document.getElementById('ffResults');
        var activeIndex = 0;

        function fuzzyMatch(query, text) {
            query = query.toLowerCase();
            text = text.toLowerCase();
            if (text.indexOf(query) !== -1) return 100;
            var qi = 0, score = 0, lastIdx = -1;
            for (var ti = 0; ti < text.length && qi < query.length; ti++) {
                if (text[ti] === query[qi]) {
                    score += (ti === lastIdx + 1) ? 15 : 5;
                    if (ti === 0 || text[ti - 1] === ' ') score += 10;
                    lastIdx = ti;
                    qi++;
                }
            }
            return qi === query.length ? score : 0;
        }

        function createItem(m) {
            var a = document.createElement('a');
            a.href = m.href;
            a.className = 'ff-item';

            var iconWrap = document.createElement('div');
            iconWrap.className = 'ff-item-icon ' + m.color;
            var icon = document.createElement('i');
            // Extract the fa- icon name from the full class string
            var faMatch = m.iconClass.match(/fa-\S+/);
            icon.className = 'fas ' + (faMatch ? faMatch[0] : 'fa-cog');
            iconWrap.appendChild(icon);

            var textWrap = document.createElement('div');
            textWrap.className = 'ff-item-text';
            var titleEl = document.createElement('div');
            titleEl.className = 'ff-item-title';
            titleEl.textContent = m.title;
            var descEl = document.createElement('div');
            descEl.className = 'ff-item-desc';
            descEl.textContent = m.desc;
            textWrap.appendChild(titleEl);
            textWrap.appendChild(descEl);

            var sectionEl = document.createElement('div');
            sectionEl.className = 'ff-item-section';
            sectionEl.textContent = m.section;

            a.appendChild(iconWrap);
            a.appendChild(textWrap);
            a.appendChild(sectionEl);
            return a;
        }

        function renderResults(query) {
            resultsContainer.textContent = '';

            var list;
            if (!query) {
                list = modules;
            } else {
                list = modules
                    .map(function(m) { return { m: m, score: fuzzyMatch(query, m.searchText) }; })
                    .filter(function(x) { return x.score > 0; })
                    .sort(function(a, b) { return b.score - a.score; })
                    .map(function(x) { return x.m; });
            }

            if (list.length === 0) {
                var empty = document.createElement('div');
                empty.className = 'ff-empty';
                var emptyIcon = document.createElement('i');
                emptyIcon.className = 'fas fa-search';
                emptyIcon.style.cssText = 'display:block;margin-bottom:8px;font-size:1.2rem;';
                empty.appendChild(emptyIcon);
                empty.appendChild(document.createTextNode('No modules found'));
                resultsContainer.appendChild(empty);
                activeIndex = -1;
                return;
            }

            list.forEach(function(m) {
                resultsContainer.appendChild(createItem(m));
            });
            activeIndex = 0;
            updateActive();
        }

        function updateActive() {
            var items = resultsContainer.querySelectorAll('.ff-item');
            items.forEach(function(el, i) { el.classList.toggle('ff-active', i === activeIndex); });
            if (items[activeIndex]) {
                items[activeIndex].scrollIntoView({ block: 'nearest' });
            }
        }

        function openFinder() {
            overlay.classList.add('open');
            input.value = '';
            renderResults('');
            setTimeout(function() { input.focus(); }, 10);
        }

        function closeFinder() {
            overlay.classList.remove('open');
        }

        function navigateToActive() {
            var items = resultsContainer.querySelectorAll('.ff-item');
            if (items[activeIndex]) {
                window.location.href = items[activeIndex].getAttribute('href');
            }
        }

        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                overlay.classList.contains('open') ? closeFinder() : openFinder();
                return;
            }
            if (!overlay.classList.contains('open')) return;
            if (e.key === 'Escape') {
                e.preventDefault();
                closeFinder();
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                var items = resultsContainer.querySelectorAll('.ff-item');
                if (items.length > 0) { activeIndex = (activeIndex + 1) % items.length; updateActive(); }
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                var items2 = resultsContainer.querySelectorAll('.ff-item');
                if (items2.length > 0) { activeIndex = (activeIndex - 1 + items2.length) % items2.length; updateActive(); }
            } else if (e.key === 'Enter') {
                e.preventDefault();
                navigateToActive();
            }
        });

        input.addEventListener('input', function() {
            renderResults(input.value.trim());
        });

        window.openFinder = openFinder;
        window.closeFinder = closeFinder;
    })();

    // Overview search, category tabs, and section collapse
    (function() {
        var searchInput = document.getElementById('overviewSearch');
        var noResults = document.getElementById('noSearchResults');
        var tabs = document.querySelectorAll('.category-tab');
        var sections = document.querySelectorAll('.modules-section[data-category]');
        var activeCat = 'all';

        if (!searchInput) return; // Not on overview page

        // Category tabs
        tabs.forEach(function(tab) {
            tab.addEventListener('click', function() {
                activeCat = tab.getAttribute('data-cat');
                tabs.forEach(function(t) { t.classList.remove('active'); });
                tab.classList.add('active');
                applyFilters();
            });
        });

        // Search input
        searchInput.addEventListener('input', function() { applyFilters(); });

        function applyFilters() {
            var query = (searchInput.value || '').trim().toLowerCase();
            var anyVisible = false;

            sections.forEach(function(section) {
                var cat = section.getAttribute('data-category');
                var catMatch = activeCat === 'all' || cat === activeCat;

                if (!catMatch) {
                    section.classList.add('search-hidden');
                    return;
                }

                if (!query) {
                    section.classList.remove('search-hidden');
                    section.querySelectorAll('.module-card').forEach(function(card) {
                        card.classList.remove('search-hidden');
                    });
                    anyVisible = true;
                    return;
                }

                var sectionHasMatch = false;
                section.querySelectorAll('.module-card').forEach(function(card) {
                    var title = (card.querySelector('.module-title') || {}).textContent || '';
                    var desc = (card.querySelector('.module-desc') || {}).textContent || '';
                    var tags = card.getAttribute('data-tags') || '';
                    var text = (title + ' ' + desc + ' ' + tags).toLowerCase();
                    if (text.indexOf(query) > -1) {
                        card.classList.remove('search-hidden');
                        sectionHasMatch = true;
                    } else {
                        card.classList.add('search-hidden');
                    }
                });

                if (sectionHasMatch) {
                    section.classList.remove('search-hidden');
                    anyVisible = true;
                } else {
                    section.classList.add('search-hidden');
                }
            });

            if (noResults) {
                noResults.style.display = (query && !anyVisible) ? 'block' : 'none';
            }
        }

        // Section collapse/expand
        document.querySelectorAll('.section-toggle').forEach(function(header) {
            var section = header.closest('.modules-section');
            var cat = section ? section.getAttribute('data-category') : null;

            // Restore state from localStorage
            if (cat) {
                var stored = localStorage.getItem('section-collapsed-' + cat);
                if (stored === '1') section.classList.add('collapsed');
            }

            header.addEventListener('click', function() {
                section.classList.toggle('collapsed');
                if (cat) {
                    localStorage.setItem('section-collapsed-' + cat, section.classList.contains('collapsed') ? '1' : '0');
                }
            });
        });

        // Focus search on Ctrl+K (also opens the fuzzy finder, but this focuses the visible one)
        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') { searchInput.value = ''; applyFilters(); searchInput.blur(); }
        });

        // Feature status dots — inject from server-side data
        <% if (typeof featureStatus !== 'undefined') { %>
        (function() {
            var status = <%- JSON.stringify(featureStatus) %>;
            document.querySelectorAll('.module-card').forEach(function(card) {
                var href = card.getAttribute('href') || '';
                var match = href.match(/page=([^&]+)/);
                if (!match) return;
                var page = match[1];
                var dot = document.createElement('div');
                dot.className = 'module-status' + (status[page] ? ' active' : '');
                dot.title = status[page] ? 'Configured' : 'Not configured';
                card.appendChild(dot);
            });
        })();
        <% } %>

        // Recently Visited — localStorage tracking
        (function() {
            var GUILD_ID = '<%= guild.id %>';
            var STORAGE_KEY = 'recent-visited-' + GUILD_ID;
            var MAX_RECENT = 8;

            // Icon map for recently visited chips
            var iconMap = {
                'appearance': 'fa-paint-brush', 'core': 'fa-sliders-h', 'commands': 'fa-terminal',
                'stat-displays': 'fa-tv', 'permissions': 'fa-user-lock', 'streamers': 'fa-broadcast-tower',
                'twitch-schedules': 'fa-calendar', 'tiktok': 'fab fa-tiktok', 'self-promo': 'fa-bullhorn',
                'community-support': 'fa-hands-helping', 'feeds': 'fa-rss', 'welcome': 'fa-hand-sparkles',
                'reaction-roles': 'fa-smile-beam', 'leveling': 'fa-trophy', 'achievements': 'fa-medal',
                'birthday': 'fa-birthday-cake', 'starboard': 'fa-star', 'giveaways': 'fa-gift',
                'polls': 'fa-poll', 'suggestions': 'fa-lightbulb', 'confessions': 'fa-user-secret',
                'music': 'fa-music', 'economy': 'fa-coins', 'games': 'fa-gamepad',
                'gambling': 'fa-dice', 'rpg': 'fa-dragon', 'free-games': 'fa-gift',
                'automemes': 'fa-laugh-squint', 'moderation': 'fa-gavel', 'automod': 'fa-robot',
                'security': 'fa-lock', 'advanced-protection': 'fa-shield-virus', 'phishing': 'fa-link',
                'quarantine': 'fa-user-shield', 'global-ban': 'fa-globe', 'mass': 'fa-users-cog',
                'logging': 'fa-file-alt', 'action-log': 'fa-history', 'analytics': 'fa-chart-line',
                'serverstats': 'fa-server', 'stat-roles': 'fa-chart-pie', 'emojistats': 'fa-smile',
                'auto-purge': 'fa-broom', 'reminders': 'fa-bell', 'schedule': 'fa-calendar-alt',
                'sticky': 'fa-thumbtack', 'timecapsules': 'fa-hourglass-half', 'weather': 'fa-cloud-sun',
                'tickets': 'fa-ticket-alt', 'utilities': 'fa-toolbox', 'custom-commands': 'fa-terminal',
                'custom-embeds': 'fa-newspaper', 'emoji-manager': 'fa-icons', 'tags': 'fa-tag', 'autoresponders': 'fa-robot',
                'forms': 'fa-file-alt', 'csv': 'fa-file-csv', 'backups': 'fa-save'
            };

            // Title map
            var titleMap = {};
            document.querySelectorAll('.module-card').forEach(function(card) {
                var href = card.getAttribute('href') || '';
                var match = href.match(/page=([^&]+)/);
                var title = card.querySelector('.module-title');
                if (match && title) titleMap[match[1]] = title.textContent;
            });

            function getRecent() {
                try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch { return []; }
            }

            function renderRecent() {
                var recent = getRecent();
                var container = document.getElementById('recentVisited');
                var grid = document.getElementById('recentVisitedGrid');
                if (!container || !grid || recent.length === 0) { if (container) container.style.display = 'none'; return; }

                container.style.display = '';
                grid.textContent = '';
                recent.forEach(function(page) {
                    var a = document.createElement('a');
                    a.href = '/manage/' + GUILD_ID + '?page=' + page;
                    a.className = 'recent-chip';
                    var icon = document.createElement('i');
                    var iconClass = iconMap[page] || 'fa-cog';
                    icon.className = (iconClass.startsWith('fab') ? '' : 'fas ') + iconClass;
                    a.appendChild(icon);
                    var span = document.createElement('span');
                    span.textContent = titleMap[page] || page;
                    a.appendChild(span);
                    grid.appendChild(a);
                });
            }

            renderRecent();

            // Track page visits (runs on sub-pages, not overview)
            var currentPage = new URLSearchParams(window.location.search).get('page');
            if (currentPage && currentPage !== 'overview') {
                var recent = getRecent();
                recent = recent.filter(function(p) { return p !== currentPage; });
                recent.unshift(currentPage);
                if (recent.length > MAX_RECENT) recent = recent.slice(0, MAX_RECENT);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(recent));
            }
        })();
    })();
    </script>
</body>
</html>
