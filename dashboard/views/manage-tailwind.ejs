    <%
    // ---- Navigation (core/manage-nav.js, built in server.js) ---------------------------
    // One list drives the sidebar, the overview's grouped page lists, search and the
    // recently-visited chips. pageMap below still decides what each page renders.
    const nav = Array.isArray(locals.manageNav) ? manageNav : [];
    const navItemByPage = {};
    const navSectionByPage = {};
    nav.forEach(function (sec) { sec.items.forEach(function (it) { navItemByPage[it.page] = it; navSectionByPage[it.page] = sec; }); });
    const navPageKey = (page === 'streaming') ? 'streamers' : (page === 'cfx' ? 'greenhouse' : page);
    const currentNavItem = navItemByPage[navPageKey] || null;
    const currentNavSection = navSectionByPage[navPageKey] || null;
    const navTitle = function (p) {
        if (navItemByPage[p]) return navItemByPage[p].title;
        if (pageTitles[p]) return pageTitles[p];
        const s = String(p || '').replace(/-/g, ' ');
        return s.charAt(0).toUpperCase() + s.slice(1);
    };
    const isOverview = !page || page === 'overview';
    // Compact index for search, the command palette and recently-visited chips.
    const navIndex = nav.map(function (sec) {
        return { key: sec.key, label: sec.label, items: sec.items.map(function (it) {
            return { page: it.page, title: it.title, desc: it.desc, icon: it.icon, tags: it.tags };
        }) };
    });
    const guildIconUrl = guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png';
