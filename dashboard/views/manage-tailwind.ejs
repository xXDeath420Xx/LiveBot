                    <li class="breadcrumb-item"><a href="/manage/<%= guild.id %>">Dashboard</a></li>
                    <li class="breadcrumb-sep"><i class="fas fa-chevron-right" style="font-size: 0.7rem; color: var(--text-muted);"></i></li>
                    <li class="breadcrumb-item active"><%= pageTitles[page] || page %></li>
                </ol>
            </nav>

            <!-- Page Content -->
            <div class="page-content">
                <%
                const pageMap = {
                    'streamers': { partial: 'streamers', data: { guild, consolidatedStreamers, roles, channels, settings } },
                    'teams': { partial: 'teams', data: { guild, teamSubscriptions, roles, channels } },
                    'appearance': { partial: 'appearance', data: { guild, settings } },
                    'core': { partial: 'core', data: { guild, settings, roles } },
                    'welcome': { partial: 'welcome', data: { guild, settings: welcomeSettings, channels } },
                    'reaction-roles': { partial: 'reaction-roles', data: { guild, panels: reactionRolePanels, roles, channels } },
                    'starboard': { partial: 'starboard', data: { guild, settings: starboardConfig, channels } },
                    'leveling': { partial: 'leveling', data: { guild, settings, rewards: roleRewards, roles, channels } },
                    'giveaways': { partial: 'giveaways', data: { guild, giveaways, channels } },
                    'polls': { partial: 'polls', data: { guild, polls, channels } },
                    'suggestions': { partial: 'suggestions', data: { guild, suggestions, suggestionConfig, suggestionStats, suggestionTags, channels, roles } },
                    'music': { partial: 'music', data: { guild, musicConfig: typeof musicConfig !== 'undefined' ? musicConfig : {}, availableDJVoices: typeof availableDJVoices !== 'undefined' ? availableDJVoices : [], roles, channels, voiceChannels } },
                    'birthday': { partial: 'birthday', data: { guild, birthdays: typeof birthdayUsers !== 'undefined' ? birthdayUsers : [], birthdayStats: typeof birthdayStats !== 'undefined' ? birthdayStats : {}, birthdayConfig: typeof birthdayConfig !== 'undefined' ? birthdayConfig : {}, channels } },
                    'weather': { partial: 'weather', data: { guild, weatherStats, weatherConfig: typeof weatherConfig !== 'undefined' ? weatherConfig : {}, channels } },
                    'economy': { partial: 'economy', data: { guild, economyConfig, shopItems, economyStats, topUsers } },
                    'games': { partial: 'games', data: { guild, triviaQuestions, hangmanWords, countingChannels, gameStats } },
                    'gambling': { partial: 'gambling', data: { guild, gamblingConfig, gamblingHistory, gamblingStats, topGamblers } },
                    'trading': { partial: 'trading', data: { guild, activeTrades, tradeHistory, tradeStats } },
                    'rpg': { partial: 'rpg', data: { guild, rpgStats, characters: rpgCharacters || [], quests: [] } },
                    'moderation': { partial: 'moderation', data: { guild, settings: moderationConfig, infractions: recentInfractions, escalationRules: escalationRules, channels, roles } },
                    'automod': { partial: 'automod', data: { guild, automodRules: automodRules, heatConfig } },
                    'security': { partial: 'security', data: { guild, joinGate: joinGateConfig, antiRaid: antiRaidConfig, antiNuke: antiNukeConfig, quarantine: quarantineConfig, roles } },
                    'advanced-protection': { partial: 'advanced-protection', data: { guild, raidConfig: typeof raidConfig !== 'undefined' ? raidConfig : null, selfbotConfig: typeof selfbotConfig !== 'undefined' ? selfbotConfig : null, adaptiveSpamConfig: typeof adaptiveSpamConfig !== 'undefined' ? adaptiveSpamConfig : null, raidIncidents: typeof raidIncidents !== 'undefined' ? raidIncidents : [], selfbotDetections: typeof selfbotDetections !== 'undefined' ? selfbotDetections : [], channels, roles } },
                    'quarantine': { partial: 'quarantine', data: { guild, quarantineConfig, roles } },
                    'mass': { partial: 'mass', data: { guild, roles, channels } },
                    'stat-roles': { partial: 'stat-roles', data: { guild, statroles: statroleConfigs, roles } },
                    'logging': { partial: 'logging', data: { guild, settings: logConfig, auditLogs: typeof auditLogs !== 'undefined' ? auditLogs : [], channels, channelSettingsMap: typeof channelSettingsMap !== 'undefined' ? channelSettingsMap : new Map() } },
                    'action-log': { partial: 'action-log', data: { guild, actionLogs: typeof actionLogs !== 'undefined' ? actionLogs : [] } },
                    'analytics': { partial: 'analytics', data: { guild, serverStats: typeof serverStats !== 'undefined' ? serverStats : [] } },
                    'feeds': { partial: 'feeds', data: { guild, redditFeeds, youtubeFeeds, twitterFeeds, channels } },
                    'twitch-schedules': { partial: 'twitch-schedules', data: { guild, syncs: twitchScheduleSyncs, streamers: consolidatedStreamers, channels, roles } },
                    'announcements': { partial: 'announcements', data: { guild, settings, channels, roles } },
                    'utilities': { partial: 'utilities', data: { guild, settings, autoPublisher: autoPublisherConfig, autoroles: autorolesConfig, tempChannels: tempChannelConfig, roles, channels, categories } },
                    'custom-commands': { partial: 'custom-commands', data: { guild, commands: customCommands, roles } },
                    'commands': { partial: 'commands', data: { guild, commands: typeof commandSettings !== 'undefined' ? commandSettings : [] } },
                    'forms': { partial: 'forms', data: { guild, forms: typeof forms !== 'undefined' ? forms : [], channels } },
                    'tickets': { partial: 'tickets', data: { guild, ticketConfig, forms: typeof ticketFormsList !== 'undefined' ? ticketFormsList : [], categories, roles } },
                    'backups': { partial: 'backups', data: { guild, backups: typeof backups !== 'undefined' ? backups : [] } },
                    'permissions': { partial: 'permissions', data: { guild, permissionOverrides: typeof permissionOverrides !== 'undefined' ? permissionOverrides : [], roles, channels } },
                    'reminders': { partial: 'reminders', data: { guild, reminders: typeof reminders !== 'undefined' ? reminders : [], channels } },
                    'tags': { partial: 'tags', data: { guild, tags: typeof tags !== 'undefined' ? tags : [] } },
                    'csv': { partial: 'csv', data: { guild } },
                    'achievements': { partial: 'achievements', data: { guild } },
                    'serverstats': { partial: 'serverstats', data: { guild } },
                    'emojistats': { partial: 'emojistats', data: { guild } },
                    'confessions': { partial: 'confessions', data: { guild, channels } },
                    'timecapsules': { partial: 'timecapsules', data: { guild } },
                    'automemes': { partial: 'automemes', data: { guild, channels } },
                    'sticky': { partial: 'sticky', data: { guild, channels } },
                    'schedule': { partial: 'schedule', data: { guild, channels } },
                    'self-promo': { partial: 'self-promo', data: { guild, selfPromoConfig: typeof selfPromoConfig !== 'undefined' ? selfPromoConfig : {}, channels } },
                    'community-support': { partial: 'community-support', data: { guild, communitySupportConfig: typeof communitySupportConfig !== 'undefined' ? communitySupportConfig : {}, channels } },
                    'stream-ended': { partial: 'stream-ended', data: { guild, streamEndedSubs: typeof streamEndedSubs !== 'undefined' ? streamEndedSubs : [], channels } },
                    'auto-track': { partial: 'auto-track', data: { guild, autoTrackConfigs: typeof autoTrackConfigs !== 'undefined' ? autoTrackConfigs : [], channels, roles: typeof roles !== 'undefined' ? roles : [] } },
                    'global-ban': { partial: 'global-ban', data: { guild, globalBanConfig: typeof globalBanConfig !== 'undefined' ? globalBanConfig : {}, channels } }
                };
                const activePage = pageMap[page];
                if (activePage) {
                %>
                    <%- include(`partials/manage/${activePage.partial}`, activePage.data) %>
                <% } %>
            </div>

            <% } else { %>
            <!-- Overview Dashboard with Module Grid -->

            <!-- Quick Stats -->
            <div class="quick-stats">
                <div class="stat-card stat-purple">
                    <div class="stat-icon"><i class="fas fa-video"></i></div>
                    <div>
                        <div class="stat-value"><%= streamerCount %></div>
                        <div class="stat-label">Streamers</div>
                    </div>
                </div>
                <div class="stat-card stat-green">
                    <div class="stat-icon"><i class="fas fa-circle"></i></div>
                    <div>
                        <div class="stat-value"><%= liveCount %></div>
                        <div class="stat-label">Live Now</div>
                    </div>
                </div>
                <div class="stat-card stat-cyan">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <div>
                        <div class="stat-value"><%= memberCount.toLocaleString() %></div>
                        <div class="stat-label">Members</div>
                    </div>
                </div>
                <div class="stat-card stat-red">
                    <div class="stat-icon"><i class="fas fa-user-friends"></i></div>
                    <div>
                        <div class="stat-value"><%= teamSubscriptions.length %></div>
                        <div class="stat-label">Teams</div>
                    </div>
                </div>
            </div>

            <!-- Core Modules -->
            <section class="modules-section">
                <div class="section-header purple">
                    <div class="section-icon"><i class="fas fa-cog"></i></div>
                    <h2 class="section-title">Core</h2>
                </div>
                <div class="module-grid">
                    <a href="/manage/<%= guild.id %>?page=streamers" class="module-card purple">
                        <div class="module-header">
                            <div class="module-icon"><i class="fas fa-video"></i></div>
                            <div>
                                <div class="module-title">Streamers</div>
                                <div class="module-desc">Manage tracked streamers and go-live notifications</div>
                            </div>
                        </div>
                        <% if (liveCount > 0) { %>
                        <div class="module-badge"><i class="fas fa-circle"></i> <%= liveCount %> Live</div>
                        <% } %>
                    </a>
                    <a href="/manage/<%= guild.id %>?page=teams" class="module-card purple">
                        <div class="module-header">
                            <div class="module-icon"><i class="fas fa-user-friends"></i></div>
                            <div>
                                <div class="module-title">Teams</div>
                                <div class="module-desc">Subscribe to Twitch teams for automatic notifications</div>
                            </div>
                        </div>
                    </a>
                    <a href="/manage/<%= guild.id %>?page=appearance" class="module-card purple">
                        <div class="module-header">
                            <div class="module-icon"><i class="fas fa-paint-brush"></i></div>
                            <div>
                                <div class="module-title">Appearance</div>
                                <div class="module-desc">Customize embed colors and notification styles</div>
                            </div>
                        </div>
                    </a>
