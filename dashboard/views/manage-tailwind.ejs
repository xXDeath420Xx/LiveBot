                </div>
                <script>
                (function () {
                    var input = document.getElementById('cfSidenavSearch');
                    if (!input) return;
                    var groups = Array.prototype.slice.call(document.querySelectorAll('.cf-sidenav-group'));
                    function apply() {
                        var q = input.value.trim().toLowerCase();
                        groups.forEach(function (g) {
                            var items = g.querySelectorAll('.cf-sidenav-items li');
                            var anyVisible = false;
                            items.forEach(function (li) {
                                var text = (li.textContent || '').toLowerCase();
                                var match = !q || text.indexOf(q) !== -1;
                                li.hidden = !match;
                                if (match) anyVisible = true;
                            });
                            // When there's a query, hide the whole details block if nothing matches
                            // inside it, and auto-open the ones that do match.
                            if (q) {
                                g.hidden = !anyVisible;
                                if (anyVisible) g.setAttribute('open', '');
                            } else {
                                g.hidden = false;
                                // Don't force-close groups the user had open — just drop the open we added.
                            }
                        });
                    }
                    input.addEventListener('input', apply);
                    input.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape') { input.value = ''; apply(); input.blur(); }
                    });
                })();
                </script>
