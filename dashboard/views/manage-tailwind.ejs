<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Manage <%= guild.name %> with CertiFried MultiTool">
    <meta name="theme-color" content="#a78bfa">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Manage <%= guild.name %> - CertiFried MultiTool</title>
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0b0f11;
            --bg-secondary: #0f1316;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.5);
            --accent-purple: #a78bfa;
            --accent-blue: #60a5fa;
            --accent-green: #23f56b;
            --accent-cyan: #22d3ee;
            --accent-yellow: #fbbf24;
            --accent-red: #f87171;
            --accent-orange: #fb923c;
            --accent-pink: #f472b6;

            /* Extended color palette for partials */
            --color-dark-400: rgba(255, 255, 255, 0.1);
            --color-dark-500: #1a1d21;
            --color-dark-600: #14171a;
            --color-dark-700: #0f1214;
            --color-dark-800: #0b0d0f;
            --color-text-primary: #ffffff;
            --color-text-secondary: rgba(255, 255, 255, 0.7);
            --color-text-muted: rgba(255, 255, 255, 0.5);
            --color-primary-400: #a78bfa;
            --color-primary-500: #8b5cf6;
            --color-accent-purple: #a78bfa;
            --color-accent-green: #23f56b;
            --color-success: #23f56b;
            --color-danger: #f87171;
            --color-warning: #fbbf24;

            /* Spacing */
            --spacing-1: 0.25rem;
            --spacing-2: 0.5rem;
            --spacing-3: 0.75rem;
            --spacing-4: 1rem;
            --spacing-5: 1.25rem;
            --spacing-6: 1.5rem;
            --spacing-8: 2rem;
            --spacing-10: 2.5rem;
            --spacing-12: 3rem;

            /* Typography */
            --font-size-xs: 0.75rem;
            --font-size-sm: 0.875rem;
            --font-size-base: 1rem;
            --font-size-lg: 1.125rem;
            --font-size-xl: 1.25rem;
            --font-size-2xl: 1.5rem;
            --font-weight-normal: 400;
            --font-weight-medium: 500;
            --font-weight-semibold: 600;
            --font-weight-bold: 700;

            /* Border radius */
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --radius-xl: 18px;
        }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            line-height: 1.6;
        }

        /* Background Effects */
        .bg-effects { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: hidden; }
        .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.2; animation: float 25s ease-in-out infinite; }
        .orb-1 { width: 500px; height: 500px; background: linear-gradient(135deg, #7c3aed, #a78bfa); top: -15%; right: -10%; }
        .orb-2 { width: 400px; height: 400px; background: linear-gradient(135deg, #3b82f6, #60a5fa); bottom: -15%; left: -10%; animation-delay: -12s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, 30px) scale(1.05); } }

        .container { width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }

        /* Navbar */
        .navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 1rem 0; background: rgba(11, 15, 17, 0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-color); }
        .navbar-content { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .navbar-brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-primary); font-weight: 700; font-size: 1.1rem; }
        .navbar-logo { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-purple); }
        .navbar-links { display: flex; align-items: center; gap: 1.5rem; }
        .navbar-links a { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
        .navbar-links a:hover, .navbar-links a.active { color: var(--text-primary); }
        .user-menu-container { position: relative; }
        .user-menu { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 50px; cursor: pointer; transition: all 0.2s; }
        .user-menu:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .user-avatar { width: 28px; height: 28px; border-radius: 50%; }
        .user-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
        .user-menu-chevron { font-size: 0.7rem; color: var(--text-muted); transition: transform 0.2s; }
        .user-menu-container.open .user-menu-chevron { transform: rotate(180deg); }

        /* User Dropdown */
        .user-dropdown { position: absolute; top: calc(100% + 8px); right: 0; min-width: 220px; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: all 0.2s ease; z-index: 1001; overflow: hidden; }
        .user-menu-container.open .user-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-header { padding: 1rem; border-bottom: 1px solid var(--border-color); }
        .dropdown-user-info { font-size: 0.8rem; color: var(--text-muted); }
        .dropdown-divider { height: 1px; background: var(--border-color); margin: 0.5rem 0; }
        .dropdown-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: all 0.15s; }
        .dropdown-item:hover { background: var(--bg-card-hover); color: var(--text-primary); }
        .dropdown-item i { width: 18px; text-align: center; }
        .dropdown-item.text-warning { color: var(--accent-yellow); }
        .dropdown-item.text-warning:hover { background: rgba(251, 191, 36, 0.1); }
        .dropdown-item.text-danger { color: var(--accent-red); }
        .dropdown-item.text-danger:hover { background: rgba(248, 113, 113, 0.1); }

        /* Main Content */
        main { position: relative; z-index: 1; padding: 100px 0 4rem; min-height: 100vh; }

        /* Server Header */
        .server-header { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-color); }
        .server-icon-wrap { position: relative; }
        .server-icon { width: 72px; height: 72px; border-radius: 16px; object-fit: cover; border: 3px solid var(--border-color); transition: border-color 0.3s; }
        .server-icon:hover { border-color: var(--accent-purple); }
        .server-status { position: absolute; bottom: -4px; right: -4px; width: 22px; height: 22px; background: var(--accent-green); border-radius: 50%; border: 3px solid var(--bg-primary); }
        .server-info { flex: 1; min-width: 200px; }
        .server-name { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.25rem; }
        .server-meta { display: flex; flex-wrap: wrap; gap: 1.5rem; color: var(--text-secondary); font-size: 0.9rem; }
        .server-meta-item { display: flex; align-items: center; gap: 0.5rem; }
        .server-meta-item i { color: var(--accent-purple); width: 16px; }
        .server-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
        .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); text-decoration: none; border-radius: 12px; font-weight: 600; font-size: 0.9rem; transition: all 0.2s; }
        .btn-back:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); color: var(--text-primary); }
        .btn-back i { font-size: 0.85rem; }

        /* Breadcrumb */
        .breadcrumb-nav { margin-bottom: 2rem; }
        .breadcrumb { display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
        .breadcrumb-item { display: flex; align-items: center; gap: 0.5rem; }
        .breadcrumb-item a { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
        .breadcrumb-item a:hover { color: var(--accent-purple); }
        .breadcrumb-item.active { color: var(--text-primary); font-weight: 600; font-size: 0.9rem; }
        .breadcrumb-sep { color: var(--text-muted); }

        /* Animations */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes sectionReveal {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Module Grid */
        .modules-section {
            margin-bottom: 1.75rem;
            background: rgba(255, 255, 255, 0.012);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-left: 3px solid var(--card-accent, #a78bfa);
            border-radius: 4px 16px 16px 4px;
            padding: 1.5rem 1.5rem 1.25rem;
            position: relative;
            animation: sectionReveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
            transition: background 0.3s ease;
        }
        .modules-section:nth-child(1) { animation-delay: 0s; }
        .modules-section:nth-child(2) { animation-delay: 0.06s; }
        .modules-section:nth-child(3) { animation-delay: 0.12s; }
        .modules-section:nth-child(4) { animation-delay: 0.18s; }
        .modules-section:nth-child(5) { animation-delay: 0.24s; }
        .modules-section:nth-child(6) { animation-delay: 0.30s; }
        .modules-section:nth-child(7) { animation-delay: 0.36s; }
        .modules-section:nth-child(8) { animation-delay: 0.42s; }
        .modules-section:nth-child(9) { animation-delay: 0.48s; }
        .modules-section:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
            padding-bottom: 0.875rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .section-header-text {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        .section-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            box-shadow: 0 4px 14px color-mix(in srgb, var(--card-accent, #a78bfa) 25%, transparent);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .section-toggle:hover .section-icon {
            transform: scale(1.08);
        }
        .section-title {
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--card-accent, var(--text-primary));
            text-transform: uppercase;
            letter-spacing: 0.08em;
            line-height: 1;
        }
        .section-desc {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 400;
            letter-spacing: 0;
            text-transform: none;
        }
        .section-count {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--card-accent, var(--text-muted));
            background: color-mix(in srgb, var(--card-accent, #a78bfa) 10%, transparent);
            padding: 0.2rem 0.55rem;
            border-radius: 50px;
            margin-left: 0.5rem;
            border: 1px solid color-mix(in srgb, var(--card-accent, #a78bfa) 15%, transparent);
        }

        .module-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
        }

        .module-card {
            display: block;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 1.35rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        /* Staggered card entrance — up to 16 cards per section */
        .module-grid .module-card:nth-child(1) { animation-delay: 0.04s; }
        .module-grid .module-card:nth-child(2) { animation-delay: 0.08s; }
        .module-grid .module-card:nth-child(3) { animation-delay: 0.12s; }
        .module-grid .module-card:nth-child(4) { animation-delay: 0.16s; }
        .module-grid .module-card:nth-child(5) { animation-delay: 0.20s; }
        .module-grid .module-card:nth-child(6) { animation-delay: 0.24s; }
        .module-grid .module-card:nth-child(7) { animation-delay: 0.28s; }
        .module-grid .module-card:nth-child(8) { animation-delay: 0.32s; }
        .module-grid .module-card:nth-child(9) { animation-delay: 0.36s; }
        .module-grid .module-card:nth-child(10) { animation-delay: 0.40s; }
        .module-grid .module-card:nth-child(11) { animation-delay: 0.44s; }
        .module-grid .module-card:nth-child(12) { animation-delay: 0.48s; }
        .module-grid .module-card:nth-child(13) { animation-delay: 0.52s; }
        .module-grid .module-card:nth-child(14) { animation-delay: 0.56s; }
        .module-grid .module-card:nth-child(15) { animation-delay: 0.60s; }

        .module-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--card-gradient, linear-gradient(90deg, var(--card-accent, #a78bfa), var(--card-accent-end, #a78bfa)));
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .module-card::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at top left, color-mix(in srgb, var(--card-accent, #a78bfa) 5%, transparent), transparent 60%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .module-card:hover {
            border-color: color-mix(in srgb, var(--card-accent, #a78bfa) 35%, transparent);
            transform: translateY(-3px);
            box-shadow: 0 12px 32px color-mix(in srgb, var(--card-accent, #a78bfa) 8%, rgba(0,0,0,0.25));
            background: rgba(255, 255, 255, 0.035);
        }
        .module-card:hover::before { opacity: 1; }
        .module-card:hover::after { opacity: 1; }
        .module-card:hover .module-icon {
            transform: scale(1.1);
            box-shadow: 0 4px 16px color-mix(in srgb, var(--card-accent, #a78bfa) 20%, transparent);
        }
        .module-card:hover .module-title {
            color: var(--card-accent, var(--text-primary));
        }

        .module-header { display: flex; align-items: center; gap: 0.875rem; }
        .module-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            flex-shrink: 0;
            border: 1px solid color-mix(in srgb, var(--card-accent, #a78bfa) 15%, transparent);
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .module-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.2rem;
            transition: color 0.3s ease;
        }
        .module-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.45; }
        .module-badge { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.2rem 0.5rem; background: rgba(35, 245, 107, 0.15); color: var(--accent-green); border-radius: 50px; font-size: 0.65rem; font-weight: 600; margin-top: 0.5rem; }
        .module-badge i { font-size: 0.5rem; }

        /* Feature status dot */
        .module-status {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            transition: all 0.3s ease;
            z-index: 2;
        }
        .module-status.active {
            background: #23f56b;
            box-shadow: 0 0 8px rgba(35, 245, 107, 0.4);
        }
        .module-status.active::after {
            content: '';
            position: absolute;
            top: -2px; left: -2px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid rgba(35, 245, 107, 0.25);
            animation: statusPulse 2s ease-in-out infinite;
        }
        @keyframes statusPulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.4); opacity: 0; }
        }

        /* Search & Filter */
        .overview-search-wrap { margin-bottom: 1.75rem; }
        .overview-search { position: relative; margin-bottom: 0.875rem; }
        .overview-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem; }
        .overview-search input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: #ffffff;
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .overview-search input:focus {
            outline: none;
            border-color: var(--accent-purple);
            box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.12), 0 4px 16px rgba(167, 139, 250, 0.08);
            background: rgba(255, 255, 255, 0.035);
        }
        .overview-search input:focus + .search-shortcut { opacity: 0; }
        .overview-search input::placeholder { color: var(--text-muted); }
        .category-tabs {
            display: flex;
            gap: 0.25rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            padding: 4px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }
        .category-tab {
            padding: 0.5rem 0.875rem;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            border-radius: 7px;
            white-space: nowrap;
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
            font-family: inherit;
            position: relative;
        }
        .category-tab .tab-count {
            font-size: 0.6rem;
            font-weight: 700;
            opacity: 0.5;
            margin-left: 0.25rem;
        }
        .category-tab:hover {
            color: var(--text-primary);
            background: rgba(255,255,255,0.06);
        }
        .category-tab.active {
            color: var(--tab-accent, var(--accent-purple));
            background: color-mix(in srgb, var(--tab-accent, var(--accent-purple)) 12%, transparent);
            box-shadow: 0 1px 8px color-mix(in srgb, var(--tab-accent, var(--accent-purple)) 12%, transparent);
        }
        .category-tab.active .tab-count {
            opacity: 0.8;
        }

        /* Section collapse */
        .section-toggle { cursor: pointer; user-select: none; position: relative; }
        .section-chevron {
            margin-left: auto;
            font-size: 0.7rem;
            color: var(--text-muted);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
        }
        .section-toggle:hover .section-chevron {
            background: rgba(255, 255, 255, 0.06);
            color: var(--text-primary);
        }
        .modules-section.collapsed .module-grid {
            display: none;
        }
        .modules-section.collapsed .section-chevron { transform: rotate(-90deg); }
        .modules-section.collapsed {
            padding-bottom: 1rem;
        }
        .modules-section.collapsed .section-header {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
        .module-card.search-hidden { display: none !important; }
        .modules-section.search-hidden { display: none !important; }

        /* Color classes for modules — each with unique gradient */
        .purple { --card-accent: #a78bfa; --card-accent-end: #c4b5fd; --card-gradient: linear-gradient(90deg, #8b5cf6, #c4b5fd); }
        .purple .module-icon, .purple .section-icon { background: rgba(167, 139, 250, 0.15); color: #a78bfa; }

        .blue { --card-accent: #60a5fa; --card-accent-end: #93c5fd; --card-gradient: linear-gradient(90deg, #3b82f6, #93c5fd); }
        .blue .module-icon, .blue .section-icon { background: rgba(96, 165, 250, 0.15); color: #60a5fa; }

        .green { --card-accent: #23f56b; --card-accent-end: #86efac; --card-gradient: linear-gradient(90deg, #22c55e, #86efac); }
        .green .module-icon, .green .section-icon { background: rgba(35, 245, 107, 0.15); color: #23f56b; }

        .cyan { --card-accent: #22d3ee; --card-accent-end: #67e8f9; --card-gradient: linear-gradient(90deg, #06b6d4, #67e8f9); }
        .cyan .module-icon, .cyan .section-icon { background: rgba(34, 211, 238, 0.15); color: #22d3ee; }

        .yellow { --card-accent: #fbbf24; --card-accent-end: #fde68a; --card-gradient: linear-gradient(90deg, #f59e0b, #fde68a); }
        .yellow .module-icon, .yellow .section-icon { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }

        .red { --card-accent: #f87171; --card-accent-end: #fca5a5; --card-gradient: linear-gradient(90deg, #ef4444, #fca5a5); }
        .red .module-icon, .red .section-icon { background: rgba(248, 113, 113, 0.15); color: #f87171; }

        .orange { --card-accent: #fb923c; --card-accent-end: #fdba74; --card-gradient: linear-gradient(90deg, #f97316, #fdba74); }
        .orange .module-icon, .orange .section-icon { background: rgba(251, 146, 60, 0.15); color: #fb923c; }

        .pink { --card-accent: #f472b6; --card-accent-end: #f9a8d4; --card-gradient: linear-gradient(90deg, #ec4899, #f9a8d4); }
        .pink .module-icon, .pink .section-icon { background: rgba(244, 114, 182, 0.15); color: #f472b6; }

        .indigo { --card-accent: #818cf8; --card-accent-end: #a5b4fc; --card-gradient: linear-gradient(90deg, #6366f1, #a5b4fc); }
        .indigo .module-icon, .indigo .section-icon { background: rgba(129, 140, 248, 0.15); color: #818cf8; }

        .teal { --card-accent: #2dd4bf; --card-accent-end: #5eead4; --card-gradient: linear-gradient(90deg, #14b8a6, #5eead4); }
        .teal .module-icon, .teal .section-icon { background: rgba(45, 212, 191, 0.15); color: #2dd4bf; }

        /* Quick Stats */
        .quick-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-left: 3px solid var(--stat-accent, var(--accent-purple));
            border-radius: 4px 14px 14px 4px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        .stat-card:nth-child(1) { animation-delay: 0.05s; }
        .stat-card:nth-child(2) { animation-delay: 0.1s; }
        .stat-card:nth-child(3) { animation-delay: 0.15s; }
        .stat-card:nth-child(4) { animation-delay: 0.2s; }
        .stat-card::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at left, color-mix(in srgb, var(--stat-accent, #a78bfa) 5%, transparent), transparent 60%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .stat-card:hover {
            border-color: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px color-mix(in srgb, var(--stat-accent, #a78bfa) 8%, rgba(0,0,0,0.2));
        }
        .stat-card:hover::after { opacity: 1; }
        .stat-card:hover .stat-icon { transform: scale(1.08); }
        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            box-shadow: 0 4px 12px color-mix(in srgb, var(--stat-accent, #a78bfa) 20%, transparent);
        }
        .stat-value { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }

        .stat-purple { --stat-accent: #a78bfa; }
        .stat-purple .stat-icon { background: rgba(167, 139, 250, 0.15); color: #a78bfa; }
        .stat-cyan { --stat-accent: #22d3ee; }
        .stat-cyan .stat-icon { background: rgba(34, 211, 238, 0.15); color: #22d3ee; }
        .stat-green { --stat-accent: #23f56b; }
        .stat-green .stat-icon { background: rgba(35, 245, 107, 0.15); color: #23f56b; }
        .stat-red { --stat-accent: #f87171; }
        .stat-red .stat-icon { background: rgba(248, 113, 113, 0.15); color: #f87171; }

        /* Recently Visited */
        .recent-visited {
            margin-bottom: 1.75rem;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
            animation-delay: 0.1s;
        }
        .recent-visited-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .recent-visited-label i { font-size: 0.65rem; }
        .recent-visited-grid {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding-bottom: 4px;
            -webkit-overflow-scrolling: touch;
        }
        .recent-chip {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 10px;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
            flex-shrink: 0;
        }
        .recent-chip:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(167, 139, 250, 0.3);
            transform: translateY(-1px);
        }
        .recent-chip i {
            font-size: 0.75rem;
            color: var(--accent-purple);
            width: 14px;
            text-align: center;
        }
        .recent-chip span {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-secondary);
        }
        .recent-chip:hover span { color: var(--text-primary); }

        /* Card Components for Partials */
        .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; backdrop-filter: blur(10px); }
        .card-hover { transition: all 0.3s; }
        .card-hover:hover { border-color: var(--accent-purple); transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); }
        .card-body { padding: 1.5rem; }
        .card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); }
        .card-footer { padding: 1.25rem 1.5rem; border-top: 1px solid var(--border-color); }

        /* Grid System */
        .grid { display: grid; }
        .grid-cols-1 { grid-template-columns: repeat(1, 1fr); }
        .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
        .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
        .grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
        @media (max-width: 768px) {
            .grid-cols-2, .grid-cols-3, .grid-cols-4 { grid-template-columns: 1fr; }
        }

        /* Page Section Styles */
        .page-section { margin-bottom: 2rem; }
        .page-section-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
        .page-section-title { display: flex; align-items: center; gap: 0.75rem; font-size: 1.25rem; font-weight: 700; color: var(--text-primary); }
        .page-section-title i { color: var(--accent-purple); }
        .page-section-subtitle { font-size: 0.9rem; color: var(--text-muted); margin-top: 0.25rem; }

        /* Stat Cards for Partials */
        .stat-card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .stat-card-item { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; text-align: center; }
        .stat-card-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
        .stat-card-value { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); }
        .stat-card-value.primary { color: var(--accent-purple); }
        .stat-card-value.purple { color: var(--accent-purple); }
        .stat-card-value.success { color: var(--accent-green); }
        .stat-card-value.danger { color: var(--accent-red); }

        /* Table Styles */
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th { background: var(--bg-secondary); padding: 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color); }
        .data-table td { padding: 1rem; border-bottom: 1px solid var(--border-color); color: var(--text-secondary); }
        .data-table tr:hover td { background: rgba(255, 255, 255, 0.02); }
        .data-table tr:last-child td { border-bottom: none; }

        /* Page Content Area */
        .page-content { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 2rem; }

        /* Form styles */
        .manage-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; backdrop-filter: blur(10px); }
        .manage-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
        .manage-card-title { font-size: 1.125rem; font-weight: 700; }

        .form-label { font-size: 0.875rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.5rem; display: block; }
        .form-control, .form-select, .form-input, .form-textarea { background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-color); color: #ffffff !important; border-radius: 10px; padding: 0.625rem 0.875rem; font-size: 0.875rem; transition: all 0.2s; }
        .form-control:focus, .form-select:focus, .form-input:focus, .form-textarea:focus { background: rgba(255, 255, 255, 0.08); border-color: var(--accent-purple); box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.1); outline: none; }
        .form-control::placeholder, .form-input::placeholder, .form-textarea::placeholder { color: var(--text-muted); }
        /* Global input text fix — ensure ALL inputs have white text on dark backgrounds */
        input, select, textarea { color: #ffffff !important; }
        input[type="text"], input[type="number"], input[type="password"], input[type="email"], input[type="url"], input[type="search"], input[type="tel"],
        textarea, select { background-color: rgba(255, 255, 255, 0.05); }
        input::placeholder, textarea::placeholder { color: rgba(255, 255, 255, 0.35) !important; }
        .form-select option { background: var(--bg-primary); color: var(--text-primary); }
        .form-select option:checked, .form-select option:active { background: var(--accent-purple); color: #fff; }
        .form-select[multiple] option:checked { background: linear-gradient(0deg, var(--accent-purple) 0%, var(--accent-purple) 100%); color: #fff; }
        .form-check-input { background-color: rgba(255, 255, 255, 0.1); border-color: var(--border-color); }
        .form-check-input:checked { background-color: var(--accent-purple); border-color: var(--accent-purple); }

        /* Button styles */
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; font-family: inherit; }
        .btn i { font-size: 0.85rem; }
        .btn-primary { background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue)); color: white; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 15px rgba(167, 139, 250, 0.3); color: white; }
        .btn-secondary { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); }
        .btn-secondary:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); color: var(--text-primary); }
        .btn-danger { background: rgba(248, 113, 113, 0.15); border: 1px solid rgba(248, 113, 113, 0.3); color: var(--accent-red); }
        .btn-danger:hover { background: rgba(248, 113, 113, 0.25); }
        .btn-success { background: rgba(35, 245, 107, 0.15); border: 1px solid rgba(35, 245, 107, 0.3); color: var(--accent-green); }
        .btn-success:hover { background: rgba(35, 245, 107, 0.25); }

        /* Table styles */
        .table { --bs-table-bg: transparent; --bs-table-color: var(--text-primary); --bs-table-border-color: var(--border-color); }
        .table th { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom-width: 1px; }
        .table td { font-size: 0.875rem; vertical-align: middle; border-bottom: 1px solid var(--border-color); }
        .table-hover tbody tr:hover { background: var(--bg-card-hover); }

        /* Badge styles */
        .badge { font-weight: 500; padding: 0.375rem 0.625rem; border-radius: 6px; font-size: 0.75rem; }
        .badge.bg-primary { background: rgba(167, 139, 250, 0.2) !important; color: var(--accent-purple); }
        .badge.bg-success { background: rgba(35, 245, 107, 0.2) !important; color: var(--accent-green); }
        .badge.bg-warning { background: rgba(251, 191, 36, 0.2) !important; color: var(--accent-yellow); }
        .badge.bg-danger { background: rgba(248, 113, 113, 0.2) !important; color: var(--accent-red); }
        .badge.bg-secondary { background: var(--bg-card) !important; color: var(--text-secondary); }

        /* Modal styles - Fixed z-index and visibility */
        /* Force modals to break out of stacking context created by backdrop-filter */
        .modal {
            z-index: 9999 !important;
            position: fixed !important;
        }
        .modal-backdrop {
            z-index: 9998 !important;
            background-color: rgba(0, 0, 0, 0.8) !important;
            position: fixed !important;
        }
        .modal.show .modal-dialog {
            display: flex !important;
            align-items: center;
            min-height: 100vh;
            margin: 0 auto;
        }
        .modal-dialog {
            z-index: 9999 !important;
            position: relative;
            max-width: 500px;
            width: 100%;
            margin: 1.75rem auto;
        }
        .modal-dialog.modal-lg { max-width: 800px; }
        .modal-dialog.modal-xl { max-width: 1140px; }
        .modal-content {
            background: #0f1316 !important;
            border: 1px solid rgba(167, 139, 250, 0.3) !important;
            border-radius: 16px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.8);
            color: var(--text-primary);
            position: relative;
            display: flex;
            flex-direction: column;
            width: 100%;
        }
        .modal-header {
            border-bottom: 1px solid rgba(167, 139, 250, 0.2);
            padding: 1.25rem 1.5rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px 16px 0 0;
        }
        .modal-title { font-weight: 700; color: #ffffff !important; }
        .modal-body {
            padding: 1.5rem;
            color: var(--text-primary) !important;
            flex: 1 1 auto;
        }
        .modal-body label { color: rgba(255, 255, 255, 0.9) !important; }
        .modal-footer {
            border-top: 1px solid rgba(167, 139, 250, 0.2);
            padding: 1rem 1.5rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 0 0 16px 16px;
        }
        .btn-close { filter: invert(1); opacity: 0.6; }
        .btn-close:hover { opacity: 1; }

        /* Fix for modals inside backdrop-filter containers */
        .modal.show { display: block !important; opacity: 1 !important; }

        /* Global dark theme text colors */
        h1, h2, h3, h4, h5, h6 { color: var(--text-primary); }
        p, span, div, label { color: inherit; }
        td, th { color: var(--text-secondary); }

        /* Ensure all text in page-content is readable */
        .page-content, .page-content * { color: var(--text-primary); }
        .page-content .text-muted, .page-content small { color: var(--text-muted) !important; }
        .page-content .text-secondary { color: var(--text-secondary) !important; }

        /* Alert styles */
        .alert { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; color: var(--text-primary); }
        .alert-success { background: rgba(35, 245, 107, 0.1); border-color: rgba(35, 245, 107, 0.3); }
        .alert-warning { background: rgba(251, 191, 36, 0.1); border-color: rgba(251, 191, 36, 0.3); }
        .alert-danger { background: rgba(248, 113, 113, 0.1); border-color: rgba(248, 113, 113, 0.3); }
        .alert-info { background: rgba(96, 165, 250, 0.1); border-color: rgba(96, 165, 250, 0.3); }

        /* Toggle switch */
        .toggle-switch { position: relative; width: 44px; height: 24px; cursor: pointer; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider { position: absolute; inset: 0; background: rgba(255, 255, 255, 0.1); border-radius: 24px; transition: all 0.3s; }
        .toggle-slider::before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; top: 3px; background: white; border-radius: 50%; transition: transform 0.3s; }
        .toggle-switch input:checked + .toggle-slider { background: var(--accent-purple); }
        .toggle-switch input:checked + .toggle-slider::before { transform: translateX(20px); }

        /* Empty state */
        .empty-state { text-align: center; padding: 3rem 1.5rem; color: var(--text-muted); }
        .empty-state i { font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; }
        .empty-state h3 { font-size: 1.125rem; color: var(--text-secondary); margin-bottom: 0.5rem; }
        .empty-state p { font-size: 0.875rem; }

        /* Support Banner */
        .support-banner {
            display: block;
            position: relative;
            overflow: hidden;
            border-radius: 4px 16px 16px 4px;
            padding: 1.15rem 1.5rem;
            margin-bottom: 1.75rem;
            text-decoration: none;
            background: rgba(236, 72, 153, 0.06);
            border: 1px solid rgba(236, 72, 153, 0.15);
            border-left: 3px solid #ec4899;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            cursor: pointer;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
            animation-delay: 0.25s;
        }
        .support-banner:hover {
            border-color: rgba(236, 72, 153, 0.35);
            background: rgba(236, 72, 153, 0.1);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(236, 72, 153, 0.1);
        }
        .support-banner-glow {
            position: absolute;
            top: -50%;
            right: -5%;
            width: 180px;
            height: 180px;
            background: radial-gradient(circle, rgba(236, 72, 153, 0.1), transparent 70%);
            pointer-events: none;
        }
        .support-banner-content {
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
            z-index: 1;
        }
        .support-banner-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #ec4899, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(236, 72, 153, 0.25);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .support-banner:hover .support-banner-icon { transform: scale(1.08); }
        .support-banner-text { flex: 1; min-width: 0; }
        .support-banner-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.1rem;
        }
        .support-banner-desc {
            font-size: 0.78rem;
            color: var(--text-muted);
        }
        .support-banner-cta {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.45rem 1.1rem;
            border-radius: 8px;
            background: linear-gradient(135deg, #ec4899, #a78bfa);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 600;
            flex-shrink: 0;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .support-banner:hover .support-banner-cta {
            box-shadow: 0 4px 16px rgba(236, 72, 153, 0.35);
            transform: translateX(2px);
        }
        .support-banner-cta i {
            font-size: 0.7rem;
            transition: transform 0.3s;
        }
        .support-banner:hover .support-banner-cta i {
            transform: translateX(3px);
        }

        /* Footer */
        .footer { padding: 2.5rem 0; background: var(--bg-primary); border-top: 1px solid var(--border-color); text-align: center; margin-top: 3rem; }
        .footer-links { display: flex; gap: 2rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.25rem; }
        .footer-link { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
        .footer-link:hover { color: var(--accent-purple); }
        .footer-copyright { color: var(--text-muted); font-size: 0.85rem; }

        /* Mobile Menu */
        .mobile-menu-btn { display: none; background: transparent; border: none; color: var(--text-primary); cursor: pointer; padding: 0.5rem; }
        .mobile-menu { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(11, 15, 17, 0.98); backdrop-filter: blur(20px); z-index: 999; padding-top: 80px; opacity: 0; visibility: hidden; transition: all 0.3s; }
        .mobile-menu.active { opacity: 1; visibility: visible; }
        .mobile-menu-inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; padding: 2rem; }
        .mobile-menu-link { color: var(--text-primary); text-decoration: none; font-size: 1.25rem; font-weight: 600; }
        .mobile-menu-link:hover { color: var(--accent-purple); }

        /* ═══════════════════════════════════════════════════
           MOBILE RESPONSIVE — 768px and below
           Designed for Galaxy Z Fold 7 outer (~374px wide)
           ═══════════════════════════════════════════════════ */
        @media (max-width: 768px) {
            /* ── Layout & Navigation ── */
            .mobile-menu-btn { display: block; }
            .navbar-links { display: none; }
            .mobile-menu.active { display: block; }
            .footer-links { flex-direction: column; gap: 0.75rem; }

            /* ── Support Banner ── */
            .support-banner { padding: 1rem; margin-bottom: 1.5rem; }
            .support-banner-content { flex-wrap: wrap; gap: 0.75rem; }
            .support-banner-icon { width: 36px; height: 36px; font-size: 0.9rem; }
            .support-banner-title { font-size: 0.85rem; }
            .support-banner-desc { font-size: 0.75rem; }
            .support-banner-cta { padding: 0.4rem 1rem; font-size: 0.8rem; width: 100%; justify-content: center; }
            .support-banner-glow { display: none; }

            /* ── Server Header ── */
            .server-header { flex-direction: column; align-items: flex-start; text-align: left; gap: 0.75rem; margin-bottom: 1.25rem; padding-bottom: 1rem; }
            .server-name { font-size: 1.2rem; }
            .server-actions { width: 100%; }
            .server-actions .btn-back { width: 100%; text-align: center; justify-content: center; }
            .server-meta { flex-wrap: wrap; gap: 0.5rem; font-size: 0.8rem; }

            /* ── Page Content Container ── */
            .page-content { padding: 0.875rem !important; overflow-x: hidden; border-radius: 12px; }
            .page-section { margin-bottom: 1rem; }
            .page-section-header { flex-direction: column; align-items: flex-start !important; gap: 0.5rem; margin-bottom: 0.75rem; padding-bottom: 0.5rem; }
            .page-section-title { font-size: 1rem; }
            .page-section-subtitle { font-size: 0.8rem; }
            .breadcrumb-nav { font-size: 0.8rem; }

            /* ── NUCLEAR: Force ALL grids to single column ──
               This catches inline style="display: grid; grid-template-columns: ..." too */
            .grid.grid-cols-4,
            .grid.grid-cols-3,
            .grid.grid-cols-2 { grid-template-columns: 1fr !important; }
            .quick-stats { grid-template-columns: repeat(2, 1fr) !important; }
            .module-grid { grid-template-columns: 1fr !important; }
            .modules-section { padding: 1rem; margin-bottom: 1.25rem; }
            .category-tabs { -webkit-mask-image: linear-gradient(90deg, black 85%, transparent); mask-image: linear-gradient(90deg, black 85%, transparent); }
            .recent-visited-grid { -webkit-mask-image: linear-gradient(90deg, black 80%, transparent); mask-image: linear-gradient(90deg, black 80%, transparent); }
            .stat-card-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 0.5rem; }
            .stat-card-item { padding: 0.75rem; }
            .stat-card-value { font-size: 1.2rem; }

            /* Force ANY element with inline grid to single column on mobile */
            .page-content [style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
            }
            /* Except stat grids that look good as 2-col */
            .streamers-stats-grid,
            .quick-stats,
            .stat-card-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }

            /* ── NUCLEAR: Force inline flex layouts to stack ── */
            .page-content [style*="display: flex"][style*="justify-content"],
            .page-content [style*="display: flex"][style*="gap"] {
                flex-wrap: wrap !important;
            }
            .page-content [style*="display: flex"][style*="justify-content: space-between"] {
                flex-direction: column !important;
                gap: 0.5rem !important;
            }
            .page-content [style*="display: flex"][style*="justify-content: flex-end"] {
                justify-content: stretch !important;
            }
            .page-content [style*="display: flex"][style*="justify-content: flex-end"] > * {
                width: 100%;
            }

            /* ── Inline padding/margin reduction ── */
            .page-content [style*="padding: var(--spacing-6)"],
            .page-content [style*="padding: var(--spacing-5)"] {
                padding: 0.75rem !important;
            }
            .page-content [style*="margin-bottom: var(--spacing-6)"] {
                margin-bottom: 0.75rem !important;
            }

            /* ── ALL Tables — universal mobile treatment ── */
            .page-content table {
                font-size: 0.78rem !important;
                width: 100% !important;
            }
            .page-content th {
                padding: 0.5rem 0.5rem !important;
                font-size: 0.65rem !important;
                width: auto !important;
            }
            .page-content td {
                padding: 0.5rem 0.5rem !important;
            }
            /* Table wrappers — horizontal scroll with momentum */
            .page-content .table-container,
            .page-content .mod-table-wrapper,
            .page-content .leveling-table-wrapper,
            .page-content .streamers-table-wrapper,
            .page-content [style*="overflow"] {
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch;
            }
            /* Hide low-priority columns */
            .mobile-hide { display: none !important; }

            /* ── Touch Targets — 44px minimum ── */
            .page-content select,
            .page-content input[type="text"],
            .page-content input[type="number"],
            .page-content input[type="url"],
            .page-content input[type="email"],
            .page-content input[type="password"],
            .page-content textarea,
            .form-control,
            .form-select,
            .form-input,
            .form-textarea,
            .mod-form-input,
            .mod-form-select,
            .leveling-form-input,
            .leveling-form-select,
            .search-input {
                min-height: 44px !important;
                font-size: 16px !important; /* prevents iOS auto-zoom */
            }
            .page-content input[type="color"] {
                width: 44px !important;
                height: 44px !important;
                min-height: 44px !important;
            }

            /* ── Buttons — touch-friendly ── */
            .page-content .btn,
            .page-content button[type="submit"],
            .btn-action {
                min-height: 44px;
                padding: 0.5rem 0.875rem;
            }
            .btn-sm { min-height: 38px; }

            /* ── Forms — force single column ── */
            .mod-form-grid,
            .mod-add-rule-grid,
            .leveling-form-grid,
            .leveling-add-reward-grid,
            .settings-grid {
                grid-template-columns: 1fr !important;
            }
            .settings-grid-full { grid-column: span 1 !important; }
            .form-help, .form-hint, .mod-form-hint, .leveling-form-hint {
                font-size: 0.7rem;
            }

            /* ── Cards & Sections — tighter on mobile ── */
            .manage-card { padding: 0.75rem !important; margin-bottom: 0.75rem; }
            .mod-section-body,
            .leveling-section-body { padding: 0.75rem !important; }
            .mod-section-header,
            .leveling-section-header,
            .settings-panel-header { padding: 0.625rem 0.75rem !important; }
            .mod-add-rule-form,
            .leveling-add-reward { padding: 0.75rem !important; }
            .settings-panel-body { padding: 0.75rem !important; }

            /* ── Rule/Streamer Cards ── */
            .mod-rule-card {
                flex-direction: column !important;
                gap: 0.5rem;
                align-items: stretch !important;
                padding: 0.75rem !important;
            }

            /* ── Full-width action buttons ── */
            .mod-delete-btn, .mod-add-btn, .mod-save-btn,
            .leveling-add-btn, .leveling-delete-btn, .leveling-save-btn {
                width: 100% !important;
                justify-content: center !important;
                min-height: 44px;
            }

            /* ── Modals ── */
            .modal-dialog {
                margin: 0.5rem !important;
                max-width: calc(100vw - 1rem) !important;
            }
            .modal-body { padding: 0.875rem !important; }
            .modal-header, .modal-footer { padding: 0.75rem !important; }

            /* ── Streamers page specifics ── */
            .streamers-stats-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 8px; }
            .stat-card-compact { padding: 10px 12px; }
            .streamer-avatar { width: 28px; height: 28px; }
            .streamer-name { font-size: 0.8rem; }
            .action-buttons { flex-wrap: wrap; gap: 4px; justify-content: flex-start !important; }
            .btn-action { font-size: 0.75rem; padding: 6px 10px; }
            .platform-badge { font-size: 0.6rem; padding: 2px 6px; }

            /* ── Misc ── */
            .mod-reason { max-width: none; white-space: normal; word-break: break-word; }
            .badge { font-size: 0.65rem; padding: 0.2rem 0.4rem; }
            .toggle-switch { flex-shrink: 0; }
            .empty-state, .empty-state-modern, .mod-empty-state, .leveling-empty-state {
                padding: 1.5rem 0.75rem !important;
            }
            .empty-state i, .empty-state-icon-modern, .mod-empty-icon, .leveling-empty-icon {
                font-size: 1.75rem !important;
            }
            .warning-banner { flex-direction: column; text-align: center; gap: 8px; padding: 10px 12px; }

            /* ── Typography tightening ── */
            .page-content h3 { font-size: 0.95rem !important; }
            .page-content h4 { font-size: 0.875rem !important; }
            .page-content p { font-size: 0.8rem; }
        }

        /* ═══════════════════════════════════════════════════
           EXTRA SMALL — 400px and below (Z Fold outer screen)
           ═══════════════════════════════════════════════════ */
        @media (max-width: 400px) {
            .container { padding: 0 0.5rem !important; }
            .page-content { padding: 0.625rem !important; border-radius: 10px; }
            .server-header { gap: 0.5rem; margin-bottom: 0.75rem; }
            .server-name { font-size: 1.05rem; }
            .server-icon { width: 40px !important; height: 40px !important; }
            .page-section-title { font-size: 0.9rem; gap: 0.4rem; }
            .page-section-subtitle { font-size: 0.75rem; }

            /* Everything single column */
            .streamers-stats-grid,
            .quick-stats,
            .stat-card-grid,
            .grid.grid-cols-4 {
                grid-template-columns: 1fr !important;
            }

            .btn { font-size: 0.78rem; padding: 0.5rem 0.625rem; }
            .btn-action { font-size: 0.7rem; }

            /* Table even tighter */
            .page-content th { font-size: 0.6rem !important; padding: 0.375rem !important; }
            .page-content td { padding: 0.375rem !important; font-size: 0.75rem !important; }
        }
    </style>
</head>
