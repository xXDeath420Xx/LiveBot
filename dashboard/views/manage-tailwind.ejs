                    'message-threats': { partial: 'message-threats', data: { guild } },
                    'nsfw-protection': { partial: 'nsfw-protection', data: { guild } },
                    'domain-reports': { partial: 'domain-reports', data: { guild } },
                    'activity-audit': { partial: 'activity-audit', data: { guild } },
                    'join-requests': { partial: 'join-requests', data: { guild } },
                    'channel-post-rules': { partial: 'channel-post-rules', data: { guild, channels, roles } },
                    'self-promo': { partial: 'self-promo', data: { guild, selfPromoConfig: typeof selfPromoConfig !== 'undefined' ? selfPromoConfig : {}, channels } },
                    'community-support': { partial: 'community-support', data: { guild, communitySupportConfig: typeof communitySupportConfig !== 'undefined' ? communitySupportConfig : {}, channels } },
                    // Per-streamer Edit-on-End lives in the streamers table, so that is the landing tab.
                    'stream-ended': { partial: 'streaming', tab: 'streamers', data: streamingData },
                    'auto-track': { partial: 'streaming', tab: 'auto-track', data: streamingData },
                    'global-ban': { partial: 'global-ban', data: { guild, globalBanConfig: typeof globalBanConfig !== 'undefined' ? globalBanConfig : {}, channels } },
                    'phishing': { partial: 'phishing', data: { guild, phishingConfig: typeof phishingConfig !== 'undefined' ? phishingConfig : {}, channels } },
                    'free-games': { partial: 'free-games', data: { guild, freeGamesSubs: typeof freeGamesSubs !== 'undefined' ? freeGamesSubs : [], channels, roles: typeof roles !== 'undefined' ? roles : [] } },
                    // Fully API-driven: loads watchers + the preset catalogue on mount.
                    'game-news': { partial: 'game-news', data: { guild, channels, roles } },
                    'twitch-clips': { partial: 'twitch-clips', data: { guild, channels } },
                    'steam-library': { partial: 'steam-library', data: { guild, channels } },
                    'digimon': { partial: 'digimon', data: { guild, channels } },
                    'digimon-odds': { partial: 'digimon-odds', data: { guild } },
                    'digimon-quiz': { partial: 'digimon-quiz', data: { guild } },
                    // ?page=cfx (the old game) now shows Greenhouse Tycoon (core/manage-nav.js PAGE_ALIASES)
                    'cfx': { partial: 'greenhouse', data: { guild } },
                    'greenhouse': { partial: 'greenhouse', data: { guild } },
                    'tiktok': { partial: 'tiktok', data: { guild, tiktokSubs: typeof tiktokSubs !== 'undefined' ? tiktokSubs : [], tiktokConfig: typeof tiktokConfig !== 'undefined' ? tiktokConfig : {}, recentVideos: typeof recentTiktokVideos !== 'undefined' ? recentTiktokVideos : [], channels, roles } },
                    'stat-displays': { partial: 'stat-displays', data: { guild, statDisplayChannels: typeof statDisplayChannels !== 'undefined' ? statDisplayChannels : [], voiceChannels: typeof voiceChannels !== 'undefined' ? voiceChannels : [], roles } },
                    'throne': { partial: 'throne', data: { guild, channels, throneNotifications: typeof throneNotifications !== 'undefined' ? throneNotifications : [], throneGuildConfig: typeof throneGuildConfig !== 'undefined' ? throneGuildConfig : null, throneSettings: typeof throneSettings !== 'undefined' ? throneSettings : null } },
                    'event-schedule': { partial: 'event-schedule', data: { guild, channels } },
                    'language': { partial: 'language', data: { guild, locales: typeof availableLocaleMeta !== 'undefined' ? availableLocaleMeta : [], guildLocale: typeof guildLocale !== 'undefined' ? guildLocale : null } },
                    'theme': { partial: 'theme', data: { guild, theme: typeof guildTheme !== 'undefined' ? guildTheme : {}, defaultTheme: typeof defaultTheme !== 'undefined' ? defaultTheme : {} } },
                    'catalog': { partial: 'catalog', data: { guild, catalog: typeof featureCatalog !== 'undefined' ? featureCatalog : new Map() } }
                };

                // Every feature declared in core/feature-config-spec.js gets a page for free.
                // Generated rather than listed so a new spec entry cannot be added without its
                // page existing — the class of gap this whole exercise was fixing.
                if (typeof featureConfigKeys !== 'undefined' && Array.isArray(featureConfigKeys)) {
                    featureConfigKeys.forEach(function(key) {
                        if (!pageMap[key]) {
                            pageMap[key] = {
                                partial: 'feature-config',
                                data: { guild, channels, roles, voiceChannels, featureKey: key },
                            };
                        }
                    });
