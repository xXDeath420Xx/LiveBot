    <%
    // Feature state per page for the sidebar dots and the overview badges: 'on', 'off' (set up but
    // switched off) or 'none' (never set up). Base map from core/page-status.js (feature catalog +
    // generated pages' master switches, cached); checks on config rows this route already loaded
    // are layered on top. A check that cannot tell "off" from "never set up" only ever adds 'on'.
    // Pages without an entry show nothing (unknown is not off).
    const pageState = Object.assign({}, locals.pageStatus || {});
    (function () {
        const L = locals;
        const has = function (o) { return !!(o && typeof o === 'object' && Object.keys(o).length); };
        const len = function (a) { return Array.isArray(a) ? a.length : 0; };
        const on = function (b) { return b ? 'on' : null; };
        const tri = function (row, isOn) { return has(row) ? (isOn ? 'on' : 'off') : null; };
        const ws = L.welcomeSettings || {}, sb = L.starboardConfig || {}, sc = L.suggestionConfig || {};
        const lc = (L.settings && L.settings.leveling_config) || {};
        const ph = L.phishingConfig || {}, gb = L.globalBanConfig || {}, sp = L.selfPromoConfig || {}, mu = L.musicConfig || {};
        const jg = L.joinGateConfig || {}, ar = L.antiRaidConfig || {}, an = L.antiNukeConfig || {}, md = L.moderationConfig || {};
        const checks = {
            'streamers': on(len(L.consolidatedStreamers)),
            'twitch-schedules': on(len(L.twitchScheduleSyncs)),
            'tiktok': on(len(L.tiktokSubs)),
            'welcome': tri(ws, ws.channel_id || (ws.goodbye_enabled && ws.goodbye_channel_id) || ws.dm_welcome_enabled),
            'reaction-roles': on(len(L.reactionRolePanels)),
            'starboard': tri(sb, sb.enabled && sb.channel_id),
            'leveling': tri(lc, lc.enabled),
            'giveaways': on(len(L.giveaways)),
            'suggestions': tri(sc, sc.enabled && (sc.suggestions_channel_id || sc.channel_id)),
            'music': tri(mu, mu.enabled !== 0 && mu.is_enabled !== 0),
            'moderation': on(md.mod_role_id || md.mute_role_id),
            'automod': on(len(L.automodRules)),
            'security': on(jg.enabled || ar.enabled || an.enabled),
            'rejoin': on(jg.rejoin_limit_enabled),
            'phishing': tri(ph, ph.enabled),
            'global-ban': tri(gb, gb.enabled),
            'logging': on(L.logConfig && L.logConfig.log_channel_id),
            'auto-purge': on(len(L.purgeConfigs)),
            'smart-purge': on(len(L.purgeRules)),
            'self-promo': tri(sp, sp.enabled && sp.channel_id),
            'feeds': on(len(L.redditFeeds) + len(L.youtubeFeeds) + len(L.twitterFeeds) + len(L.blueskyFeeds) + len(L.rssFeeds)),
            'custom-commands': on(len(L.customCommands)),
        };
        Object.keys(checks).forEach(function (p) {
            if (checks[p]) pageState[p] = checks[p];
            else if (!pageState[p]) pageState[p] = 'none';
        });
    })();
    const stateLabel = { on: 'On', off: 'Off' };
