<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: title + ' · CertiFried', noindex: true }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Follows the site theme (cf-ui.css tokens from partials/site-head; Dark by default). */
        :root { --bg: var(--cf-bg); --card: var(--cf-surface); --line: var(--cf-border); --text: var(--cf-text); --muted: var(--cf-text-3); --good: var(--cf-success); --warn: var(--cf-warning); }
        * { box-sizing:border-box; }
        body { background:var(--bg); color:var(--text); font-family:'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; -webkit-font-smoothing:antialiased; margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:16px; }
        .card { max-width:480px; width:100%; background:var(--card); border:1px solid var(--line); border-radius:8px; padding:28px 24px; text-align:center; }
        .icon { font-size:28px; margin-bottom:12px; display:flex; justify-content:center; gap:10px; }
        .icon .fa-steam { color:var(--muted); }
        .icon.ok { color:var(--good); } .icon.no { color:var(--warn); }
        h1 { font-size:1.25rem; font-weight:600; margin:0 0 8px; }
        p { color:var(--muted); line-height:1.6; margin:0; }
        .guild { font-size:.85rem; color:var(--muted); margin-bottom:6px; }
        .foot { margin-top:22px; font-size:.78rem; color:var(--muted); }
    </style>
</head>
<body>
    <main class="card">
        <div class="icon <%= ok ? 'ok' : 'no' %>" aria-hidden="true"><i class="fas <%= ok ? 'fa-circle-check' : 'fa-triangle-exclamation' %>"></i><i class="fab fa-steam"></i></div>
        <% if (guildName) { %><div class="guild"><%= guildName %></div><% } %>
        <h1><%= title %></h1>
        <p><%= message %></p>
        <p class="foot">Only your SteamID (never shown to anyone) and the list of games you own are stored.<br>Use <b>/steam unlink</b> in Discord to delete them. You can close this tab.</p>
    </main>
</body>
</html>
