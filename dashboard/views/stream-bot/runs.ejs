<%#
  GET /stream/bot/runs. Locals: runs [runView], filters { status, automation, before }, statuses[], automations [{ id, name }],
  olderHref, newestHref. Filters and paging are a plain GET form and links.
%>
<%- include('_head', { pageTitle: 'Run history', active: 'runs' }) %>
<%
  const _when = (iso) => iso ? new Date(iso).toISOString().slice(0, 16).replace('T', ' ') + ' UTC' : '';
  const _status = { ok: ['is-ok', 'OK'], partial: ['is-warn', 'Partly failed'], failed: ['is-bad', 'Failed'], skipped: ['', 'Skipped'], running: ['is-info', 'Running'] };
  const _source = { event: 'Event', test: 'Test', automation: 'Run by another automation', studio: 'CertiFried Studio', timer: 'Timer', dock: 'OBS dock' };
%>
<div class="cf-page-head">
    <div>
        <h1 class="cf-page-title">Run history</h1>
        <p class="cf-page-sub">Every time an automation's trigger matched, with the conditions it checked and what each action did. Kept for 30 days.</p>
    </div>
</div>
<%- include('_tabs', { active: 'runs' }) %>

<section class="cf-section" aria-labelledby="sb-runs-title">
    <h2 class="sr-only" id="sb-runs-title">Runs</h2>
    <div class="cf-rows">
        <form class="sb-filters" method="get" action="/stream/bot/runs" aria-label="Filter runs">
            <div class="sb-filter">
                <label for="sb-runs-status">Result</label>
                <select id="sb-runs-status" name="status">
                    <option value="">Any result</option>
                    <% statuses.forEach((s) => { %><option value="<%= s %>"<% if (s === filters.status) { %> selected<% } %>><%= (_status[s] || ['', s])[1] %></option><% }) %>
                </select>
            </div>
            <div class="sb-filter">
                <label for="sb-runs-auto">Automation</label>
                <select id="sb-runs-auto" name="automation">
                    <option value="">All automations</option>
                    <% automations.forEach((a) => { %><option value="<%= a.id %>"<% if (a.id === filters.automation) { %> selected<% } %>><%= a.name %></option><% }) %>
                </select>
            </div>
            <div class="sb-filter sb-filter-end">
                <button type="submit" class="btn btn-primary btn-sm">Show</button>
                <% if (filters.status || filters.automation) { %><a class="btn btn-secondary btn-sm" href="/stream/bot/runs">Clear</a><% } %>
            </div>
        </form>
        <% if (!runs.length) { %>
        <div class="cf-state"><p class="cf-state-title">No runs<%= filters.status || filters.automation ? ' match' : ' yet' %>.</p>
            <p class="cf-state-text">A run is logged each time an automation's trigger matches an event, and each time you use Test.</p></div>
        <% } else { %>
        <div class="cf-table-wrap">
            <table class="cf-table cf-table--stack">
                <thead><tr><th scope="col">Started</th><th scope="col">Automation</th><th scope="col">Result</th><th scope="col">Started by</th><th scope="col" class="cf-cell-end">Time</th></tr></thead>
                <tbody>
                    <% runs.forEach((r) => { const st = _status[r.status] || ['', r.status]; %>
                    <tr>
                        <td class="cf-nowrap"><a href="/stream/bot/runs/<%= r.id %>"><time datetime="<%= r.startedAt %>"><%= _when(r.startedAt) %></time></a></td>
                        <td class="sb-wrap"><%= r.automationName %><% if (r.eventText) { %><div class="cf-cell-muted"><%= r.eventText %></div><% } %></td>
                        <td><span class="cf-pill <%= st[0] %>"><%= st[1] %></span><% if (r.dryRun) { %> <span class="cf-pill is-info">Dry run</span><% } %><% if (r.skipReason) { %><div class="cf-cell-muted"><%= r.skipReason %></div><% } %></td>
                        <td><%= _source[r.source] || r.source %></td>
                        <td class="cf-cell-end cf-nowrap"><%= r.ms == null ? '' : (r.ms < 1000 ? r.ms + ' ms' : (r.ms / 1000).toFixed(1) + ' s') %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
        <% if (olderHref || newestHref) { %>
        <div class="cf-section-foot">
            <% if (newestHref) { %><a class="btn btn-secondary btn-sm" href="<%= newestHref %>">Newest</a><% } %>
            <% if (olderHref) { %><a class="btn btn-secondary btn-sm" href="<%= olderHref %>">Older</a><% } %>
        </div>
        <% } %>
    </div>
</section>

<%- include('_foot') %>
