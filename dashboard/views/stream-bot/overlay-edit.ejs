<%#
  GET /stream/bot/overlays/:id (dashboard/routes/stream-bot-overlays.js). Locals: overlay (overlayView), config (complete settings),
  state, url (the browser-source address, or null), form (lists), media, sounds, voices, editData (page JSON), previewSrc (tests only).
  A scene screen (type scene) has its own sections: title and lines, artwork (background, frame picture, see-through window),
  glows and weather. The widgets (train, tipjar, credits, emotewall, poll, labels, viewers, heartrate) have a Test button that sends invented
  frames; the Poll widget starts and ends chat polls, the Tip jar can be emptied, and Stream labels list their text addresses.
  Every setting carries data-cfg="<path>"; /js/stream-bot-overlays.js reads them into the config it saves (PUT), runs Test,
  goal, copy and new-address buttons, and scales the live preview. Nothing here builds markup from viewer text.
%>
<%- include('_head', { pageTitle: overlay.name, active: 'overlays', sbPage: 'overlay-edit' }) %>
<link rel="stylesheet" href="/css/stream-bot-overlays.css">
<%
  const _e = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const _opts = (list, value) => list.map((o) => `<option value="${_e(o.value)}"${String(o.value) === String(value) ? ' selected' : ''}>${_e(o.label)}</option>`).join('');
  const _on = (v) => v ? ' checked' : '';
  const _mediaOpts = (value) => `<option value="">None</option>` + media.map((m) => `<option value="${_e(m.id)}"${m.id === value ? ' selected' : ''}>${_e(m.name)} (${m.kind === 'video' ? 'video' : 'image'})</option>`).join('');
  const _soundOpts = (value) => `<option value="">None</option>` + sounds.map((s) => `<option value="${_e(s.id)}"${s.id === value ? ' selected' : ''}>${_e(s.name)}</option>`).join('');
  const _layoutOpts = (value, inherit) => (inherit ? '<option value="">Same as the alert</option>' : '') + _opts(form.layouts, value);
  const t = overlay.type;
  const c = config;
%>
<div class="cf-page-head">
    <div>
        <p class="sbo-back"><a href="/stream/bot/overlays">All overlays</a></p>
        <h1 class="cf-page-title"><%= overlay.name %></h1>
        <p class="cf-page-sub"><%= overlay.typeLabel %>. In OBS it is the browser source <strong><%= overlay.sourceName %></strong>, 1920 × 1080.</p>
    </div>
</div>
<%- include('_tabs', { active: 'overlays' }) %>

<div class="cf-notice" id="sbo-msg" role="status" aria-live="polite" hidden><div class="cf-notice-body" id="sbo-msg-text"></div></div>

<section class="cf-section" aria-labelledby="sbo-url-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-url-title">Browser source address</h2>
        <p class="cf-section-desc">Keep it private: anyone with it can see this overlay. A new address stops the old one at once; update OBS afterwards (Studio can add it again).</p></div>
        <div class="cf-section-actions"><span class="cf-status-line" id="sbo-online" role="status" aria-live="polite"><%= overlay.online ? 'Open in OBS now' : 'Not open in OBS' %></span></div></header>
    <div class="cf-rows">
        <div class="cf-row">
            <div class="cf-row-text"><label class="cf-row-label" for="sbo-url">Address</label><p class="cf-row-desc">Width 1920, height 1080.<% if (overlay.type === 'alerts' || overlay.type === 'canvas') { %> Tick Control audio via OBS for its sounds.<% } %></p></div>
            <div class="cf-row-control"><input type="text" id="sbo-url" readonly value="<%= url || '' %>"> <button type="button" class="btn btn-secondary btn-sm" id="sbo-copy">Copy</button> <button type="button" class="btn btn-secondary btn-sm" id="sbo-rotate">New address</button></div>
        </div>
    </div>
</section>

<section class="cf-section" aria-labelledby="sbo-prev-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-prev-title">Preview</h2>
        <p class="cf-section-desc">The real overlay, scaled down, over a checkerboard where OBS shows your scene. It updates when you save. Live events show here too.</p></div>
        <div class="cf-section-actions"><label class="sb-check"><input type="checkbox" id="sbo-prev-sound"> Play sounds here</label></div></header>
    <div class="cf-rows">
        <div class="sbo-preview" id="sbo-preview"><iframe id="sbo-frame" title="Overlay preview" data-src="<%= locals.previewSrc || (url ? url + '?preview=1' : '') %>" loading="lazy" tabindex="-1"></iframe></div>
    </div>
</section>

<% if (t === 'alerts') { %>
<section class="cf-section" aria-labelledby="sbo-test-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-test-title">Test alerts</h2>
        <p class="cf-section-desc">Shows an invented alert on this overlay wherever it is open (OBS and the preview). An amount tries a variation, for example 1000 Bits.</p></div>
        <div class="cf-section-actions"><span class="cf-status-line" id="sbo-test-status" role="status" aria-live="polite"></span></div></header>
    <div class="cf-rows">
        <div class="cf-row">
            <div class="cf-row-text"><label class="cf-row-label" for="sbo-test-amount">Amount (optional)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-test-amount" min="0" step="any" inputmode="decimal"></div>
        </div>
        <div class="sbo-tests">
            <% form.alertKinds.forEach((k) => { %><button type="button" class="btn btn-secondary btn-sm" data-test-alert="<%= k.key %>"><%= k.label %></button><% }) %>
        </div>
    </div>
</section>
<% } %>

<% if (t === 'goal') { %>
<section class="cf-section" aria-labelledby="sbo-goal-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-goal-title">Progress</h2>
        <p class="cf-section-desc"><%= c.metric === 'manual' ? 'Set it here or with the Change a goal action.' : 'Counted from your events as they arrive; correct it here at any time. Test events do not count.' %></p></div>
        <div class="cf-section-actions"><span class="cf-status-line" id="sbo-goal-status" role="status" aria-live="polite"></span></div></header>
    <div class="cf-rows">
        <div class="cf-row">
            <div class="cf-row-text"><label class="cf-row-label" for="sbo-goal-value">Progress now</label><p class="cf-row-desc">Goal: <%= c.target %>.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-goal-value" min="0" step="any" value="<%= Number(state.current) || 0 %>"> <button type="button" class="btn btn-secondary btn-sm" id="sbo-goal-set">Set</button> <button type="button" class="btn btn-secondary btn-sm" id="sbo-goal-reset">Start again at 0</button></div>
        </div>
    </div>
</section>
<% } %>

<% const _widget = ['train', 'tipjar', 'credits', 'emotewall', 'poll', 'labels', 'viewers', 'heartrate', 'events', 'chat'].includes(t); %>
<% if (_widget) { %>
<section class="cf-section" aria-labelledby="sbo-wtest-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-wtest-title">Test</h2>
        <p class="cf-section-desc">Shows invented viewers on this overlay wherever it is open (OBS and the preview). Nothing is stored or counted.</p></div>
        <div class="cf-section-actions"><span class="cf-status-line" id="sbo-test-status" role="status" aria-live="polite"></span> <button type="button" class="btn btn-secondary btn-sm" data-test-widget>Send a test</button></div></header>
</section>
<% } %>

<% if (t === 'poll') { %>
<section class="cf-section" aria-labelledby="sbo-cpoll-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-cpoll-title">Chat poll</h2>
        <p class="cf-section-desc">Viewers vote by typing !vote and the number in Twitch, Kick or YouTube chat. One vote each; a new vote replaces the old one. The bot posts the question and the result in chat. Twitch polls and predictions show here by themselves.</p></div>
        <div class="cf-section-actions"><span class="cf-status-line" id="sbo-cpoll-status" role="status" aria-live="polite"></span></div></header>
    <div class="cf-rows">
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cpoll-q">Question</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-cpoll-q" maxlength="120" autocomplete="off"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cpoll-opts">Answers</label><p class="cf-row-desc">2 to 6, one per line.</p></div>
            <div class="cf-row-control"><textarea id="sbo-cpoll-opts" rows="4" maxlength="400"></textarea></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cpoll-sec">Runs for (seconds)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-cpoll-sec" min="10" max="3600" value="60"> <button type="button" class="btn btn-secondary btn-sm" id="sbo-cpoll-start">Start</button> <button type="button" class="btn btn-secondary btn-sm" id="sbo-cpoll-end">End now</button></div></div>
    </div>
</section>
<% } %>

<% if (t === 'tipjar') { %>
<section class="cf-section" aria-labelledby="sbo-jar-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-jar-title">In the jar</h2>
        <p class="cf-section-desc">Now <%= Number(state.total) || 0 %> of <%= c.target %>. Test tips do not count.<%= c.resetOnLive ? ' It empties by itself when your stream goes live.' : '' %></p></div>
        <div class="cf-section-actions"><span class="cf-status-line" id="sbo-jar-status" role="status" aria-live="polite"></span> <button type="button" class="btn btn-secondary btn-sm" id="sbo-jar-reset">Empty the jar</button></div></header>
</section>
<% } %>

<% if (t === 'labels') { %>
<section class="cf-section" aria-labelledby="sbo-ltext-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-ltext-title">One label on its own</h2>
        <p class="cf-section-desc">Each label as a browser source of its own, or as plain text for a tool that fills an OBS text source from an address. Keep these private like the address above.</p></div></header>
    <div class="cf-rows">
        <% form.labelKeys.forEach((k) => { %>
        <div class="cf-row"><div class="cf-row-text"><p class="cf-row-label"><%= k.label %></p></div>
            <div class="cf-row-control sb-fields">
                <div class="sb-field is-wide"><label for="sbo-lb-<%= k.value %>">Browser source</label><input type="text" id="sbo-lb-<%= k.value %>" readonly value="<%= url ? url + '?label=' + k.value : '' %>"></div>
                <div class="sb-field is-wide"><label for="sbo-lt-<%= k.value %>">Plain text</label><input type="text" id="sbo-lt-<%= k.value %>" readonly value="<%= url ? url + '/text/' + k.value : '' %>"></div>
            </div></div>
        <% }) %>
    </div>
</section>
<% } %>

<form id="sbo-form" novalidate>
<section class="cf-section" aria-labelledby="sbo-look-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-look-title"><%= t === 'alerts' ? 'Look of every alert' : 'Settings' %></h2></div></header>
    <div class="cf-rows">
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-name">Name</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-name" maxlength="80" value="<%= overlay.name %>" autocomplete="off"></div></div>
        <% const g = t === 'alerts' ? c.general : c; const gp = t === 'alerts' ? 'general.' : ''; %>
        <% if (t === 'counter') { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-key">Counter or value</label><p class="cf-row-desc">The name used in <code>{sdb:incr:deaths}</code> or an Add to a counter action. Imported Firebot counters keep their names.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-key" data-cfg="key" maxlength="64" spellcheck="false" value="<%= c.key %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-label">Label</label><p class="cf-row-desc">Shown before the number, such as Deaths. Empty shows the number only.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-label" data-cfg="label" maxlength="60" value="<%= c.label %>"></div></div>
        <% } %>
        <% if (t === 'goal') { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-title">Title</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-title" data-cfg="title" maxlength="80" value="<%= c.title %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-metric">Counts</label></div>
            <div class="cf-row-control"><select id="sbo-metric" data-cfg="metric"><%- _opts(form.goalMetrics, c.metric) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-target">Goal</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-target" data-cfg="target" min="1" step="any" value="<%= c.target %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-nums">Show the numbers</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-nums" data-cfg="showNumbers"<%= _on(c.showNumbers) %>></div></div>
        <% } %>
        <% if (t === 'events') { %>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Show</legend></div>
            <div class="cf-row-control sb-checks"><% form.eventTypes.forEach((e) => { %><label class="sb-check"><input type="checkbox" data-cfg="types" data-multi value="<%= e.value %>"<%= _on(c.types.includes(e.value)) %>> <%= e.label %></label><% }) %></div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-max">How many</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-max" data-cfg="max" min="1" max="20" value="<%= c.max %>"></div></div>
        <% } %>
        <% if (t === 'chat') { %>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Chat from</legend></div>
            <div class="cf-row-control sb-checks"><label class="sb-check"><input type="checkbox" data-cfg="platforms" data-multi value="twitch"<%= _on(c.platforms.includes('twitch')) %>> Twitch</label><label class="sb-check"><input type="checkbox" data-cfg="platforms" data-multi value="kick"<%= _on(c.platforms.includes('kick')) %>> Kick</label><label class="sb-check"<%= form.youtube ? '' : ' hidden' %>><input type="checkbox" data-cfg="platforms" data-multi value="youtube"<%= _on(c.platforms.includes('youtube')) %>> YouTube</label></div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-lines">Lines on screen</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-lines" data-cfg="maxMessages" min="1" max="50" value="<%= c.maxMessages %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-fade">Fade out after (seconds)</label><p class="cf-row-desc">0 keeps lines until newer ones push them out.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-fade" data-cfg="fadeAfterSec" min="0" max="600" value="<%= c.fadeAfterSec %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-badges">Badges</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-badges" data-cfg="showBadges"<%= _on(c.showBadges) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-3p">7TV, BTTV and FFZ emotes</label><p class="cf-row-desc">Your Twitch channel's emotes and the global ones, shown as pictures. CertiFried fetches them; OBS loads nothing from those sites.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-3p" data-cfg="thirdParty"<%= _on(c.thirdParty !== false) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-pmark">Platform mark</label><p class="cf-row-desc">A small Twitch, Kick or YouTube sign before each name.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-pmark" data-cfg="showPlatform"<%= _on(c.showPlatform) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hidecmd">Hide commands</label><p class="cf-row-desc">Lines that start with !.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-hidecmd" data-cfg="hideCommands"<%= _on(c.hideCommands) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hideusers">Hide these names</label><p class="cf-row-desc">Bots, for example, separated by commas.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-hideusers" data-cfg="hideUsers" maxlength="500" spellcheck="false" value="<%= c.hideUsers %>"></div></div>
        <% } %>
        <% if (t === 'nowplaying') { %>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-art">Cover art</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-art" data-cfg="showArt"<%= _on(c.showArt) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-req">Who requested it</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-req" data-cfg="showRequester"<%= _on(c.showRequester) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-npbg">Card background</label></div>
            <div class="cf-row-control"><select id="sbo-npbg" data-cfg="background"><%- _opts(form.npBackgrounds, c.background) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-npw">Card width (px)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-npw" data-cfg="width" min="240" max="1920" value="<%= c.width %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-npts">Song title size (px)</label><p class="cf-row-desc">The artist line is a little smaller.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-npts" data-cfg="titleSize" min="12" max="48" value="<%= c.titleSize %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-npbar">Progress bar colour</label></div>
            <div class="cf-row-control"><input type="color" id="sbo-npbar" data-cfg="barColor" value="<%= c.barColor %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-nptimes">Times beside the bar</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-nptimes" data-cfg="showTimes"<%= _on(c.showTimes) %>></div></div>
        <% } %>
        <% if (t === 'train') { %>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-tr-hype">Hype train (Twitch)</label><p class="cf-row-desc">Level, progress to the next level and time left, while a hype train runs.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-tr-hype" data-cfg="showHype"<%= _on(c.showHype) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-tr-ht">Hype train title</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-tr-ht" data-cfg="hypeTitle" maxlength="60" value="<%= c.hypeTitle %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-tr-sub">Sub train</label><p class="cf-row-desc">Counts subs, resubs and gifts on Twitch and Kick and memberships on YouTube while each arrives soon after the last.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-tr-sub" data-cfg="showSubTrain"<%= _on(c.showSubTrain) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-tr-st">Sub train title</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-tr-st" data-cfg="subTitle" maxlength="60" value="<%= c.subTitle %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-tr-sec">Seconds before the sub train stops</label><p class="cf-row-desc">Each new sub starts the clock again.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-tr-sec" data-cfg="subTrainSec" min="10" max="600" value="<%= c.subTrainSec %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-tr-min">Show from this many subs</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-tr-min" data-cfg="subTrainMin" min="1" max="50" value="<%= c.subTrainMin %>"></div></div>
        <% } %>
        <% if (t === 'tipjar') { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-tt">Title</label><p class="cf-row-desc">Empty shows no title.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-jar-tt" data-cfg="title" maxlength="60" value="<%= c.title %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-target">Full at</label><p class="cf-row-desc">Tip amounts are added as they arrive, whatever the currency.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-jar-target" data-cfg="target" min="1" step="any" value="<%= c.target %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-sym">Money sign</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-jar-sym" data-cfg="symbol" maxlength="4" value="<%= c.symbol %>"></div></div>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Fills from</legend></div>
            <div class="cf-row-control sb-checks"><% form.jarSources.forEach((s) => { %><label class="sb-check"><input type="checkbox" data-cfg="sources" data-multi value="<%= s.value %>"<%= _on(c.sources.includes(s.value)) %>> <%= s.label %></label><% }) %></div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-bits">Bits for one unit</label><p class="cf-row-desc">100 Bits are about one dollar.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-jar-bits" data-cfg="bitsPerUnit" min="1" max="100000" value="<%= c.bitsPerUnit %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-kicks">Kicks for one unit</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-jar-kicks" data-cfg="kicksPerUnit" min="1" max="100000" value="<%= c.kicksPerUnit %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-size">Jar height (px)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-jar-size" data-cfg="size" min="120" max="900" value="<%= c.size %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-total">Show the total</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-jar-total" data-cfg="showTotal"<%= _on(c.showTotal) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-jar-reset-live">Empty it when the stream goes live</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-jar-reset-live" data-cfg="resetOnLive"<%= _on(c.resetOnLive) %>></div></div>
        <% } %>
        <% if (t === 'credits') { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cr-title">Title</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-cr-title" data-cfg="title" maxlength="80" value="<%= c.title %>"></div></div>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Sections</legend><p class="cf-row-desc">From this stream: since it last went live. Moderators are the ones who chatted.</p></div>
            <div class="cf-row-control sb-checks"><% form.creditSections.forEach((s) => { %><label class="sb-check"><input type="checkbox" data-cfg="sections" data-multi value="<%= s.value %>"<%= _on(c.sections.includes(s.value)) %>> <%= s.label %></label><% }) %></div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cr-sec">Roll takes (seconds)</label><p class="cf-row-desc">It starts when the source is shown. Tick "Refresh browser when scene becomes active" on the source in OBS.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-cr-sec" data-cfg="durationSec" min="10" max="600" value="<%= c.durationSec %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cr-loop">Roll again when it ends</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-cr-loop" data-cfg="loop"<%= _on(c.loop) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-cr-dim">Darken the scene behind (%)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-cr-dim" data-cfg="dim" min="0" max="90" value="<%= c.dim %>"></div></div>
        <% } %>
        <% if (t === 'emotewall') { %>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Emotes from</legend></div>
            <div class="cf-row-control sb-checks"><label class="sb-check"><input type="checkbox" data-cfg="platforms" data-multi value="twitch"<%= _on(c.platforms.includes('twitch')) %>> Twitch chat</label><label class="sb-check"><input type="checkbox" data-cfg="platforms" data-multi value="kick"<%= _on(c.platforms.includes('kick')) %>> Kick chat</label><label class="sb-check"<%= form.youtube ? '' : ' hidden' %>><input type="checkbox" data-cfg="platforms" data-multi value="youtube"<%= _on(c.platforms.includes('youtube')) %>> YouTube chat</label></div></fieldset>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-ew-3p">7TV, BTTV and FFZ emotes</label><p class="cf-row-desc">Your Twitch channel's emotes and the global ones. CertiFried fetches them; OBS loads nothing from those sites.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-ew-3p" data-cfg="thirdParty"<%= _on(c.thirdParty) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-ew-size">Emote height (px)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-ew-size" data-cfg="size" min="24" max="256" value="<%= c.size %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-ew-max">Most on screen at once</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-ew-max" data-cfg="max" min="5" max="150" value="<%= c.max %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-ew-per">Most from one message</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-ew-per" data-cfg="perMessage" min="1" max="20" value="<%= c.perMessage %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-ew-rise">Seconds to float up</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-ew-rise" data-cfg="riseSec" min="2" max="30" value="<%= c.riseSec %>"></div></div>
        <% } %>
        <% if (t === 'poll') { %>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-pl-tw">Twitch polls</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-pl-tw" data-cfg="twitchPolls"<%= _on(c.twitchPolls) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-pl-pr">Twitch predictions</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-pl-pr" data-cfg="predictions"<%= _on(c.predictions) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-pl-ch">Chat polls</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-pl-ch" data-cfg="chatPolls"<%= _on(c.chatPolls) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-pl-hide">Keep the result up for (seconds)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-pl-hide" data-cfg="hideAfterSec" min="0" max="600" value="<%= c.hideAfterSec %>"></div></div>
        <% } %>
        <% if (t === 'labels') { %>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Labels</legend></div>
            <div class="cf-row-control sb-checks"><% form.labelKeys.forEach((k) => { %><label class="sb-check"><input type="checkbox" data-cfg="items" data-multi value="<%= k.value %>"<%= _on(c.items.includes(k.value)) %>> <%= k.label %></label><% }) %></div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-lb-layout">Arrange</label></div>
            <div class="cf-row-control"><select id="sbo-lb-layout" data-cfg="layout"><%- _opts([{ value: 'column', label: 'One under another' }, { value: 'row', label: 'Side by side' }], c.layout) %></select></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-lb-titles">Show what each one is</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-lb-titles" data-cfg="showTitles"<%= _on(c.showTitles) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-lb-scope">Top cheer from</label></div>
            <div class="cf-row-control"><select id="sbo-lb-scope" data-cfg="topCheerScope"><%- _opts([{ value: 'stream', label: 'This stream' }, { value: 'all', label: 'All time' }], c.topCheerScope) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-lb-empty">Before there is one</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-lb-empty" data-cfg="empty" maxlength="40" value="<%= c.empty %>"></div></div>
        <% } %>
        <% if (t === 'viewers') { %>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Count</legend></div>
            <div class="cf-row-control sb-checks"><label class="sb-check"><input type="checkbox" data-cfg="platforms" data-multi value="twitch"<%= _on(c.platforms.includes('twitch')) %>> Twitch</label><label class="sb-check"><input type="checkbox" data-cfg="platforms" data-multi value="kick"<%= _on(c.platforms.includes('kick')) %>> Kick</label><label class="sb-check"<%= form.youtube ? '' : ' hidden' %>><input type="checkbox" data-cfg="platforms" data-multi value="youtube"<%= _on(c.platforms.includes('youtube')) %>> YouTube</label></div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-vw-mode">Show</label><p class="cf-row-desc">Updated every 30 seconds.</p></div>
            <div class="cf-row-control"><select id="sbo-vw-mode" data-cfg="mode"><%- _opts([{ value: 'total', label: 'One number, added up' }, { value: 'each', label: 'Each platform with its sign' }], c.mode) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-vw-label">Label</label><p class="cf-row-desc">Before the added-up number. Empty shows the number only.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-vw-label" data-cfg="label" maxlength="40" value="<%= c.label %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-vw-hide">Hide while offline</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-vw-hide" data-cfg="hideOffline"<%= _on(c.hideOffline) %>></div></div>
        <% } %>
        <% if (t === 'heartrate') { %>
        <div class="cf-row"><div class="cf-row-text"><span class="cf-row-label">Where the number comes from</span><p class="cf-row-desc">Your watch, through CertiFried Studio (Studio, Heart rate). With a Pulsoid token on the Connections page, Pulsoid fills in when the watch has sent nothing for 10 seconds.</p></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-label">Text after the number</label><p class="cf-row-desc">Empty shows the number only.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-hr-label" data-cfg="label" maxlength="20" value="<%= c.label %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-heart">A heart that beats with it</label><p class="cf-row-desc">In the accent colour, once per heartbeat.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-hr-heart" data-cfg="showHeart"<%= _on(c.showHeart) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-graph">Graph</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-hr-graph" data-cfg="showGraph"<%= _on(c.showGraph) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-gsec">Graph covers (seconds)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-hr-gsec" data-cfg="graphSec" min="10" max="120" value="<%= c.graphSec %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-gw">Graph width (px)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-hr-gw" data-cfg="graphWidth" min="120" max="900" value="<%= c.graphWidth %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-stats">Low, average and high</label><p class="cf-row-desc">For this stream. They start again when you go live.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-hr-stats" data-cfg="showStats"<%= _on(c.showStats) %>></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-zones">Colour the number by zone</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-hr-zones" data-cfg="zones"<%= _on(c.zones) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-warm">Amber from (BPM)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-hr-warm" data-cfg="warmAt" min="40" max="240" value="<%= c.warmAt %>"> <input type="color" aria-label="Amber colour" data-cfg="warmColor" value="<%= c.warmColor %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-hot">Red from (BPM)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-hr-hot" data-cfg="hotAt" min="40" max="240" value="<%= c.hotAt %>"> <input type="color" aria-label="Red colour" data-cfg="hotColor" value="<%= c.hotColor %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-hr-hide">Hide after no reading for (seconds)</label><p class="cf-row-desc">0 keeps the last number on screen.</p></div>
            <div class="cf-row-control"><input type="number" id="sbo-hr-hide" data-cfg="hideAfterSec" min="0" max="600" value="<%= c.hideAfterSec %>"></div></div>
        <% } %>
        <% if (t !== 'nowplaying' && t !== 'scene' && t !== 'emotewall') { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-font">Font</label><p class="cf-row-desc">Fonts every Windows PC has, so OBS shows them without downloading anything.</p></div>
            <div class="cf-row-control"><select id="sbo-font" data-cfg="<%= gp %>font"><%- _opts(form.fonts, g.font) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-size"><%= t === 'canvas' ? 'Default text size (px)' : 'Text size (px at 1080p)' %></label></div>
            <div class="cf-row-control"><input type="number" id="sbo-size" data-cfg="<%= gp %>fontSize" min="16" max="120" value="<%= g.fontSize %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-color">Text colour</label></div>
            <div class="cf-row-control"><input type="color" id="sbo-color" data-cfg="<%= gp %>textColor" value="<%= g.textColor %>"></div></div>
        <% if (g.accentColor) { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-accent">Accent colour</label><p class="cf-row-desc"><%= t === 'alerts' ? "The viewer's name and the message line." : 'Highlights.' %></p></div>
            <div class="cf-row-control"><input type="color" id="sbo-accent" data-cfg="<%= gp %>accentColor" value="<%= g.accentColor %>"></div></div>
        <% } %>
        <% if (['goal', 'train', 'poll'].includes(t)) { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-bar">Bar colour</label></div>
            <div class="cf-row-control"><input type="color" id="sbo-bar" data-cfg="barColor" value="<%= c.barColor %>"></div></div>
        <% } %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-plate">Background</label><p class="cf-row-desc">A panel keeps text readable over a busy scene.</p></div>
            <div class="cf-row-control"><select id="sbo-plate" data-cfg="<%= gp %>plate"><%- _opts(form.plates, g.plate) %></select></div></div>
        <% } %>
        <% if (t === 'alerts') { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-apos">Where alerts appear</label></div>
            <div class="cf-row-control"><select id="sbo-apos" data-cfg="general.position"><%- _opts([{ value: 'top', label: 'Top' }, { value: 'center', label: 'Centre' }, { value: 'bottom', label: 'Bottom' }], c.general.position) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-gap">Pause between alerts (ms)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-gap" data-cfg="general.gapMs" min="0" max="5000" step="100" value="<%= c.general.gapMs %>"></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-giftees">An alert for each gifted sub</label><p class="cf-row-desc">Off: a gift of five shows one Gift subs alert, not five Subscription alerts as well.<%= form.youtube ? ' The same goes for gifted YouTube memberships.' : '' %></p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-giftees" data-cfg="general.showGiftedSubs"<%= _on(c.general.showGiftedSubs) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-voice">Read-aloud voice</label><p class="cf-row-desc">For Bits and tip messages when Read the message aloud is on. Spoken by CertiFried's own voices and played inside this overlay, like the alert sound.</p></div>
            <div class="cf-row-control"><select id="sbo-voice" data-cfg="general.ttsVoice"><option value="">Default (Ryan)</option><%- _opts(voices, c.general.ttsVoice) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-ttsvol">Read-aloud volume</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-ttsvol" data-cfg="general.ttsVolume" min="0" max="100" value="<%= c.general.ttsVolume %>"></div></div>
        <% } %>
        <% if (['chat', 'events', 'goal', 'counter', 'nowplaying', 'train', 'tipjar', 'poll', 'labels', 'viewers', 'heartrate'].includes(t)) { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-pos">Where on screen</label></div>
            <div class="cf-row-control"><select id="sbo-pos" data-cfg="position"><%- _opts(form.positions, c.position) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-margin">Distance from the edge (px)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-margin" data-cfg="margin" min="0" max="400" value="<%= c.margin %>"></div></div>
        <% } %>
        <% if (['chat', 'events', 'goal', 'train', 'poll'].includes(t)) { %>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-width">Width (px)</label></div>
            <div class="cf-row-control"><input type="number" id="sbo-width" data-cfg="width" min="160" max="1920" value="<%= c.width %>"></div></div>
        <% } %>
    </div>
</section>

<% if (t === 'scene') { const _num = (id, path, v, lo, hi, step) => `<input type="number" id="${id}" data-cfg="${path}" min="${lo}" max="${hi}" step="${step || 1}" value="${_e(v)}">`; %>
<section class="cf-section" aria-labelledby="sbo-scene-text-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-scene-text-title">Title and lines</h2>
        <p class="cf-section-desc">Up and down positions are a share of the screen height, 0 at the top and 100 at the bottom.</p></div></header>
    <div class="cf-rows">
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-title">Title</label><p class="cf-row-desc">Empty shows no title (a Just Chatting screen, for example).</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-sc-title" data-cfg="title" maxlength="80" value="<%= c.title %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-tstyle">Title look</label></div>
            <div class="cf-row-control"><select id="sbo-sc-tstyle" data-cfg="titleStyle"><%- _opts(form.titleStyles, c.titleStyle) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-font">Font</label><p class="cf-row-desc">Fonts every Windows PC has, so OBS shows them without downloading anything.</p></div>
            <div class="cf-row-control"><select id="sbo-sc-font" data-cfg="font"><%- _opts(form.fonts, c.font) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-tsize">Title size (px at 1080p)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-tsize', 'titleSize', c.titleSize, 24, 200) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-tcolor">Title colour</label></div>
            <div class="cf-row-control"><input type="color" id="sbo-sc-tcolor" data-cfg="titleColor" value="<%= c.titleColor %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-glow">Glow colour</label><p class="cf-row-desc">Around the title and the lines under it.</p></div>
            <div class="cf-row-control"><input type="color" id="sbo-sc-glow" data-cfg="glowColor" value="<%= c.glowColor %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-ty">Title up or down</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-ty', 'titleY', c.titleY, 0, 100, 0.1) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-sub">Second line</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-sc-sub" data-cfg="subtitle" maxlength="160" value="<%= c.subtitle %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-smode">Second line moves</label></div>
            <div class="cf-row-control"><select id="sbo-sc-smode" data-cfg="subtitleMode"><%- _opts([{ value: 'marquee', label: 'Scrolls across the screen' }, { value: 'still', label: 'Stays in the middle' }], c.subtitleMode) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-msec">Seconds to scroll across</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-msec', 'marqueeSec', c.marqueeSec, 4, 120) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-ssize">Line size (px)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-ssize', 'subtitleSize', c.subtitleSize, 12, 80) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-scolor">Line colour</label></div>
            <div class="cf-row-control"><input type="color" id="sbo-sc-scolor" data-cfg="subtitleColor" value="<%= c.subtitleColor %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-sy">Line up or down</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-sy', 'subtitleY', c.subtitleY, 0, 100, 0.1) %></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-cd">Countdown</label><p class="cf-row-desc">Starts when the scene is shown (Studio adds the source with "Refresh browser when scene becomes active").</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-sc-cd" data-cfg="countdown.enabled"<%= _on(c.countdown.enabled) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-cdmin">Countdown minutes</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-cdmin', 'countdown.minutes', c.countdown.minutes, 1, 180) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-cdlabel">Before the time</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-sc-cdlabel" data-cfg="countdown.label" maxlength="40" value="<%= c.countdown.label %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-cdend">When it reaches 0</label></div>
            <div class="cf-row-control"><input type="text" id="sbo-sc-cdend" data-cfg="countdown.endText" maxlength="60" value="<%= c.countdown.endText %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-cdy">Countdown up or down</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-cdy', 'countdown.y', c.countdown.y, 0, 100, 0.1) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-soc">Socials line</label><p class="cf-row-desc">For example twitch.tv/you · kick.com/you. Empty shows nothing.</p></div>
            <div class="cf-row-control"><input type="text" id="sbo-sc-soc" data-cfg="socials" maxlength="200" value="<%= c.socials %>"></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-socy">Socials up or down</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-socy', 'socialsY', c.socialsY, 0, 100, 0.1) %></div></div>
    </div>
</section>

<section class="cf-section" aria-labelledby="sbo-scene-art-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-scene-art-title">Artwork</h2>
        <p class="cf-section-desc">The picture fills the screen. Positions below are a share of the picture, 0 to 100 across and down, so they stay on the same spot of your art.</p></div></header>
    <div class="cf-rows">
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-bg">Background picture or video</label><p class="cf-row-desc">From Images and videos on the Overlays tab.</p></div>
            <div class="cf-row-control"><select id="sbo-sc-bg" data-cfg="background"><%- _mediaOpts(c.background) %></select></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-kb">Slow zoom</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-sc-kb" data-cfg="kenBurns"<%= _on(c.kenBurns) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-kbs">Zoom to (%)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-kbs', 'kenBurnsScale', c.kenBurnsScale, 100, 130) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-kbt">Zoom takes (seconds)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-kbt', 'kenBurnsSec', c.kenBurnsSec, 5, 120) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-dim">Darken the picture (%)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-dim', 'dim', c.dim, 0, 90) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-inset">Picture in a frame</label><p class="cf-row-desc">A second picture or animation placed on your art, such as a poster in a frame.</p></div>
            <div class="cf-row-control"><select id="sbo-sc-inset" data-cfg="inset.media"><%- _mediaOpts(c.inset.media) %></select></div></div>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Frame picture: left, top, width, height</legend></div>
            <div class="cf-row-control sb-fields">
                <div class="sb-field"><label for="sbo-sc-ix">Left</label><%- _num('sbo-sc-ix', 'inset.x', c.inset.x, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-iy">Top</label><%- _num('sbo-sc-iy', 'inset.y', c.inset.y, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-iw">Width</label><%- _num('sbo-sc-iw', 'inset.w', c.inset.w, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-ih">Height</label><%- _num('sbo-sc-ih', 'inset.h', c.inset.h, 0, 100, 0.1) %></div>
            </div></fieldset>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-win">See-through window</label><p class="cf-row-desc">Cuts a soft-edged hole in the art so a camera placed under this source in OBS shows through. Replaces the frame picture.</p></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-sc-win" data-cfg="window.enabled"<%= _on(c.window.enabled) %>></div></div>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Window: left, top, width, height, soft edge</legend></div>
            <div class="cf-row-control sb-fields">
                <div class="sb-field"><label for="sbo-sc-wx">Left</label><%- _num('sbo-sc-wx', 'window.x', c.window.x, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-wy">Top</label><%- _num('sbo-sc-wy', 'window.y', c.window.y, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-ww">Width</label><%- _num('sbo-sc-ww', 'window.w', c.window.w, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-wh">Height</label><%- _num('sbo-sc-wh', 'window.h', c.window.h, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-wf">Soft edge</label><%- _num('sbo-sc-wf', 'window.feather', c.window.feather, 0, 10, 0.1) %></div>
            </div></fieldset>
    </div>
</section>

<section class="cf-section" aria-labelledby="sbo-scene-fx-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-scene-fx-title">Glows and weather</h2>
        <p class="cf-section-desc">Glows are soft lights on your art: eyes, a lantern, a screen. Size is a share of the picture's width.</p></div></header>
    <div class="cf-rows">
        <% for (let gi = 0; gi < form.sceneLimits.glows; gi++) { const gl = c.glows[gi] || null; const gid = 'sbo-sc-g' + gi; %>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Glow <%= gi + 1 %></legend></div>
            <div class="cf-row-control sb-fields">
                <div class="sb-field"><label class="sb-check" for="<%= gid %>-on"><input type="checkbox" id="<%= gid %>-on" data-cfg="glows.<%= gi %>.on"<%= _on(!!gl) %>> On</label></div>
                <div class="sb-field"><label for="<%= gid %>-x">Across</label><%- _num(gid + '-x', 'glows.' + gi + '.x', gl ? gl.x : 50, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="<%= gid %>-y">Down</label><%- _num(gid + '-y', 'glows.' + gi + '.y', gl ? gl.y : 50, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="<%= gid %>-s">Size</label><%- _num(gid + '-s', 'glows.' + gi + '.size', gl ? gl.size : 4, 0.5, 30, 0.1) %></div>
                <div class="sb-field"><label for="<%= gid %>-c">Colour</label><input type="color" id="<%= gid %>-c" data-cfg="glows.<%= gi %>.color" value="<%= gl ? gl.color : '#ffb256' %>"></div>
                <div class="sb-field"><label for="<%= gid %>-st">Moves</label><select id="<%= gid %>-st" data-cfg="glows.<%= gi %>.style"><%- _opts(form.glowStyles, gl ? gl.style : 'pulse') %></select></div>
            </div></fieldset>
        <% } %>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-smoke">Rising smoke</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-sc-smoke" data-cfg="smoke.enabled"<%= _on(c.smoke.enabled) %>></div></div>
        <fieldset class="cf-row"><div class="cf-row-text"><legend class="cf-row-label">Smoke: across, down, amount (%)</legend></div>
            <div class="cf-row-control sb-fields">
                <div class="sb-field"><label for="sbo-sc-smx">Across</label><%- _num('sbo-sc-smx', 'smoke.x', c.smoke.x, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-smy">Down</label><%- _num('sbo-sc-smy', 'smoke.y', c.smoke.y, 0, 100, 0.1) %></div>
                <div class="sb-field"><label for="sbo-sc-smi">Amount</label><%- _num('sbo-sc-smi', 'smoke.intensity', c.smoke.intensity, 10, 300) %></div>
            </div></fieldset>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-emb">Embers (how many)</label><p class="cf-row-desc">0 for none.</p></div>
            <div class="cf-row-control"><%- _num('sbo-sc-emb', 'embers', c.embers, 0, 150) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-emba">Embers rise</label></div>
            <div class="cf-row-control"><select id="sbo-sc-emba" data-cfg="emberArea"><%- _opts([{ value: 'all', label: 'Across the whole screen' }, { value: 'centre', label: 'From the middle and bottom only' }], c.emberArea) %></select></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-rain">Rain (%)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-rain', 'rain', c.rain, 0, 100) %></div></div>
        <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-light">Lightning flashes</label></div>
            <div class="cf-row-control"><input type="checkbox" id="sbo-sc-light" data-cfg="lightning"<%= _on(c.lightning) %>></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-fog">Drifting fog (%)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-fog', 'fog', c.fog, 0, 100) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-vig">Dark edges (%)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-vig', 'vignette', c.vignette, 0, 100) %></div></div>
        <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="sbo-sc-grain">Film grain (%)</label></div>
            <div class="cf-row-control"><%- _num('sbo-sc-grain', 'grain', c.grain, 0, 30) %></div></div>
    </div>
</section>
<% } %>

<% if (t === 'alerts') { form.alertKinds.forEach((k) => { const a = c.alerts[k.key]; const id = 'sbo-a-' + k.key; const p = 'alerts.' + k.key + '.'; %>
<section class="cf-section" aria-labelledby="<%= id %>-title">
    <details class="cf-expand sbo-alert-set">
        <summary><span id="<%= id %>-title"><%= k.label %></span> <span class="sbo-alert-state" data-state-for="<%= k.key %>"><%= a.enabled ? 'On' : 'Off' %><%= a.variations.length ? ', ' + a.variations.length + ' variation' + (a.variations.length === 1 ? '' : 's') : '' %></span></summary>
        <div class="cf-expand-body cf-rows" data-alert="<%= k.key %>">
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-on">Show this alert</label></div>
                <div class="cf-row-control"><input type="checkbox" id="<%= id %>-on" data-cfg="<%= p %>enabled"<%= _on(a.enabled) %>> <button type="button" class="btn btn-secondary btn-sm" data-test-alert="<%= k.key %>">Test</button></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-msg">Text</label><p class="cf-row-desc">Variables such as {user.name}, {amount}, {months}, {count}, {viewers}, {reward} and {tier} work here. The name shows in the accent colour.</p></div>
                <div class="cf-row-control"><input type="text" id="<%= id %>-msg" data-cfg="<%= p %>message" maxlength="300" value="<%= a.message %>"></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-detail">Second line</label><p class="cf-row-desc">Optional, smaller.</p></div>
                <div class="cf-row-control"><input type="text" id="<%= id %>-detail" data-cfg="<%= p %>detail" maxlength="300" value="<%= a.detail %>"></div></div>
            <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-showmsg">Show the viewer's message</label></div>
                <div class="cf-row-control"><input type="checkbox" id="<%= id %>-showmsg" data-cfg="<%= p %>showMessage"<%= _on(a.showMessage) %>></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-layout">Layout</label></div>
                <div class="cf-row-control"><select id="<%= id %>-layout" data-cfg="<%= p %>layout"><%- _layoutOpts(a.layout) %></select></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-anim">Animation</label></div>
                <div class="cf-row-control"><select id="<%= id %>-anim" data-cfg="<%= p %>animation"><%- _opts(form.animations, a.animation) %></select></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-media">Image or video</label><p class="cf-row-desc">From Images and videos on the Overlays tab.</p></div>
                <div class="cf-row-control"><select id="<%= id %>-media" data-cfg="<%= p %>media"><%- _mediaOpts(a.media) %></select></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-scale">Image size (%)</label><p class="cf-row-desc">A share of the file's own size. 100 keeps the layout's usual size.</p></div>
                <div class="cf-row-control"><input type="number" id="<%= id %>-scale" data-cfg="<%= p %>mediaScale" min="10" max="200" value="<%= a.mediaScale %>"></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-tdelay">Text appears after (ms)</label><p class="cf-row-desc">Lets the image or video play in first. 0 shows the text at once.</p></div>
                <div class="cf-row-control"><input type="number" id="<%= id %>-tdelay" data-cfg="<%= p %>textDelayMs" min="0" max="5000" step="100" value="<%= a.textDelayMs %>"></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-sound">Sound</label><p class="cf-row-desc">From your <a href="/stream/bot/sounds">Sounds</a>. It plays inside this overlay.</p></div>
                <div class="cf-row-control"><select id="<%= id %>-sound" data-cfg="<%= p %>sound"><%- _soundOpts(a.sound) %></select></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-vol">Sound volume</label></div>
                <div class="cf-row-control"><input type="number" id="<%= id %>-vol" data-cfg="<%= p %>volume" min="0" max="100" value="<%= a.volume %>"></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-dur">Show for (ms)</label><p class="cf-row-desc">2000 to 30000. A message read aloud keeps it up until it ends.</p></div>
                <div class="cf-row-control"><input type="number" id="<%= id %>-dur" data-cfg="<%= p %>durationMs" min="2000" max="30000" step="500" value="<%= a.durationMs %>"></div></div>
            <% if (k.ttsCapable) { %>
            <div class="cf-row cf-row--switch"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-tts">Read the message aloud</label><p class="cf-row-desc">Links are read as "a link"; at most 200 characters.</p></div>
                <div class="cf-row-control"><input type="checkbox" id="<%= id %>-tts" data-cfg="<%= p %>tts"<%= _on(a.tts) %>></div></div>
            <div class="cf-row"><div class="cf-row-text"><label class="cf-row-label" for="<%= id %>-ttsmin">Only from this amount</label></div>
                <div class="cf-row-control"><input type="number" id="<%= id %>-ttsmin" data-cfg="<%= p %>ttsMin" min="0" step="any" value="<%= a.ttsMin %>"></div></div>
            <% } %>
            <% if (k.amountLabel) { %>
            <div class="cf-row sbo-var-head"><div class="cf-row-text"><p class="cf-row-label">Variations</p><p class="cf-row-desc">A bigger <%= k.amountLabel.replace(/ at least.*$/, '').toLowerCase() %> can show something else. The highest one reached wins; empty fields keep the alert's own.</p></div>
                <div class="cf-row-control"><button type="button" class="btn btn-secondary btn-sm" data-add-variation="<%= k.key %>">Add a variation</button></div></div>
            <div class="sbo-vars" data-variations="<%= k.key %>" data-amount-label="<%= k.amountLabel %>">
                <% a.variations.forEach((v, vi) => { const vid = id + '-v' + vi; %>
                <fieldset class="sbo-var">
                    <legend class="sbo-var-title">Variation <%= vi + 1 %></legend>
                    <div class="sb-fields">
                        <div class="sb-field"><label for="<%= vid %>-min"><%= k.amountLabel %></label><input type="number" id="<%= vid %>-min" data-var="min" min="0" step="any" value="<%= v.min %>"></div>
                        <div class="sb-field is-wide"><label for="<%= vid %>-msg">Text</label><input type="text" id="<%= vid %>-msg" data-var="message" maxlength="300" value="<%= v.message %>"></div>
                        <div class="sb-field is-wide"><label for="<%= vid %>-detail">Second line</label><input type="text" id="<%= vid %>-detail" data-var="detail" maxlength="300" value="<%= v.detail %>"></div>
                        <div class="sb-field"><label for="<%= vid %>-media">Image or video</label><select id="<%= vid %>-media" data-var="media"><%- _mediaOpts(v.media).replace('>None<', '>Same as the alert<') %></select></div>
                        <div class="sb-field"><label for="<%= vid %>-sound">Sound</label><select id="<%= vid %>-sound" data-var="sound"><%- _soundOpts(v.sound).replace('>None<', '>Same as the alert<') %></select></div>
                        <div class="sb-field"><label for="<%= vid %>-layout">Layout</label><select id="<%= vid %>-layout" data-var="layout"><%- _layoutOpts(v.layout, true) %></select></div>
                        <div class="sb-field"><label for="<%= vid %>-dur">Show for (ms)</label><input type="number" id="<%= vid %>-dur" data-var="durationMs" min="2000" max="30000" step="500" value="<%= v.durationMs %>"></div>
                    </div>
                    <div class="sbo-var-tools"><button type="button" class="btn btn-secondary btn-sm" data-remove-variation>Remove variation <%= vi + 1 %></button></div>
                </fieldset>
                <% }) %>
            </div>
            <% } %>
        </div>
    </details>
</section>
<% }) } %>

<div class="cf-section-foot sbo-save">
    <span class="cf-status-line" id="sbo-save-status" role="status" aria-live="polite"></span>
    <button type="submit" class="btn btn-primary">Save</button>
</div>
</form>

<section class="cf-section" aria-labelledby="sbo-del-title">
    <header class="cf-section-head"><div><h2 class="cf-section-title" id="sbo-del-title">Delete this overlay</h2>
        <p class="cf-section-desc">Its address stops working at once. Remove the browser source from OBS yourself.</p></div>
        <div class="cf-section-actions"><button type="button" class="btn btn-secondary btn-sm" id="sbo-delete" data-name="<%= overlay.name %>">Delete</button></div></header>
</section>

<script type="application/json" id="sbo-edit-data"><%- editData %></script>
<template id="sbo-media-options"><%- _mediaOpts('').replace('>None<', '>Same as the alert<') %></template>
<template id="sbo-sound-options"><%- _soundOpts('').replace('>None<', '>Same as the alert<') %></template>
<template id="sbo-layout-options"><%- _layoutOpts('', true) %></template>
<script src="/js/stream-bot-overlays.js" defer></script>
<%- include('_foot') %>
