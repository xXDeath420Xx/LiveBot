<%#
  /bot-management — custom bots. Bot creators see their own bots; super-admins also get every
  owner's bots (?scope=all), which is the owner console's bot list, plus who may create bots.
  Data: GET /api/bots/fleet (dashboard/routes/bots.js). Actions: PUT/DELETE /api/bots/:id,
  POST /api/bots/:id/reconnect, POST /api/bots, super-admin approve + bot creators.
%>
<%
// Locals from dashboard/server.js; the defaults keep the page working with an older route.
const _scope = (typeof scope !== 'undefined' && scope) ? scope : 'mine';
const _sa = !!((typeof isSuperAdmin !== 'undefined' && isSuperAdmin) || (user && user.isSuperAdmin));
const _all = _scope === 'all';
%>
<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: ('Custom bots') + ' · CertiFried', noindex: true }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
</head>
<body class="cfs-body cf-site">
<%- include('partials/site-header', { user }) %>
<main id="main-content" class="cf-main" tabindex="-1">
<div class="cf-page">
    <% if (_sa) { %><%- include('partials/site/_owner-nav', { ownerActive: _all ? 'bots' : '' }) %><% } %>

    <div class="cf-page-head">
        <div class="cf-page-icon"><i class="fas fa-robot" aria-hidden="true"></i></div>
        <div>
            <h1 class="cf-page-title">Custom bots</h1>
            <p class="cf-page-sub"><%= _all ? 'Every custom bot on the network, who owns it and where it runs.' : 'Bots you run on CertiFried under your own name and avatar.' %></p>
        </div>
        <div class="cf-page-actions">
            <% if (_sa) { %>
            <div class="cf-segmented" role="group" aria-label="Which bots">
                <a href="/bot-management?scope=mine"<% if (!_all) { %> aria-pressed="true" class="is-active"<% } %>>My bots</a>
                <a href="/bot-management?scope=all"<% if (_all) { %> aria-pressed="true" class="is-active"<% } %>>All bots</a>
            </div>
            <% } %>
            <% if (user.canCreateBots || _sa) { %>
            <button type="button" class="btn btn-primary btn-sm" id="bm-add-open"><i class="fas fa-plus" aria-hidden="true"></i> Add a bot</button>
            <% } %>
        </div>
    </div>

    <dl class="cf-kpis" id="bm-kpis" aria-label="Bots at a glance">
        <div class="cf-kpi"><dt>Bots</dt><dd class="cf-kpi-value" data-kpi="total">–</dd></div>
        <div class="cf-kpi"><dt>Online</dt><dd class="cf-kpi-value" data-kpi="online">–</dd></div>
        <div class="cf-kpi"><dt>Need attention</dt><dd class="cf-kpi-value" data-kpi="attention">–</dd></div>
        <div class="cf-kpi"><dt>Servers served</dt><dd class="cf-kpi-value" data-kpi="servers">–</dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="bm-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bm-list-title">Bots<span class="cf-count" id="bm-count"></span></h2>
                <p class="cf-section-desc">A bot shows as online once it has logged in to Discord. A server marked "not joined" is assigned, but the bot has not been invited there yet.</p>
            </div>
            <div class="cf-section-actions">
                <button type="button" class="btn btn-secondary btn-sm" id="bm-refresh"><i class="fas fa-rotate" aria-hidden="true"></i> Refresh</button>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-toolbar" id="bm-toolbar" hidden>
                <label class="cf-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="bm-search" placeholder="Search by name, ID, owner or server" aria-label="Search bots"></label>
                <div class="cf-segmented" role="group" aria-label="Filter" id="bm-filter">
                    <button type="button" data-filter="all" aria-pressed="true">All</button>
                    <button type="button" data-filter="online" aria-pressed="false">Online</button>
                    <button type="button" data-filter="attention" aria-pressed="false">Needs attention</button>
                    <button type="button" data-filter="off" aria-pressed="false">Turned off</button>
                </div>
            </div>
            <div class="cf-state cf-state--loading" id="bm-state" role="status" aria-live="polite"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading bots</p></div>
            <div class="cf-list" id="bm-list"></div>
        </div>
    </section>

    <% if (_sa) { %>
    <section class="cf-section" aria-labelledby="bm-creators-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bm-creators-title">Bot creators<span class="cf-count" id="bm-creators-count"></span></h2>
                <p class="cf-section-desc">People allowed to add their own custom bots on this page.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form class="cf-row" id="bm-creator-form">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="bm-creator-id">Add a creator</label>
                    <p class="cf-row-desc">Their Discord user ID.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-group">
                        <input type="text" id="bm-creator-id" inputmode="numeric" pattern="\d{17,20}" maxlength="20" placeholder="123456789012345678" autocomplete="off" required>
                        <button type="submit" class="btn btn-primary btn-sm">Add</button>
                    </div>
                </div>
            </form>
            <div class="cf-state cf-state--loading cf-state--compact" id="bm-creators-state"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading</p></div>
            <div class="cf-list" id="bm-creators"></div>
        </div>
    </section>
    <% } %>
</div>
</main>

<div class="cf-modal" id="bm-add" hidden>
    <div class="cf-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="bm-add-title">
        <header class="cf-modal-head">
            <div>
                <h2 class="cf-modal-title" id="bm-add-title">Add a custom bot</h2>
                <p class="cf-modal-desc">Create the application in the Discord Developer Portal first. The name and avatar come from Discord.</p>
            </div>
            <button type="button" class="cf-modal-close" data-close aria-label="Close"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </header>
        <form id="bm-add-form" class="cf-modal-body" autocomplete="off">
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-bot-management-tailwind-client_id">Application ID</label>
                        <p class="cf-row-desc">General Information, Application ID.</p>
                    </div>
                    <div class="cf-row-control"><input id="f-bot-management-tailwind-client_id" type="text" name="client_id" inputmode="numeric" pattern="\d{17,20}" maxlength="20" placeholder="123456789012345678" required></div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-bot-management-tailwind-bot_token">Bot token</label>
                        <p class="cf-row-desc">Bot, Reset Token. It is checked with Discord, then stored encrypted.</p>
                    </div>
                    <div class="cf-row-control"><input id="f-bot-management-tailwind-bot_token" type="password" name="bot_token" maxlength="200" placeholder="Paste the token" required></div>
                </div>
            </div>
            <p class="cf-status-line" id="bm-add-status" aria-live="polite"></p>
        </form>
        <footer class="cf-modal-foot">
            <button type="button" class="btn btn-secondary btn-sm" data-close>Cancel</button>
            <button type="submit" form="bm-add-form" class="btn btn-primary btn-sm" id="bm-add-submit">Add bot</button>
        </footer>
    </div>
</div>

<div class="cf-modal" id="bm-confirm" hidden>
    <div class="cf-modal-dialog" role="alertdialog" aria-modal="true" aria-labelledby="bm-confirm-title" aria-describedby="bm-confirm-text">
        <header class="cf-modal-head">
            <div><h2 class="cf-modal-title" id="bm-confirm-title">Are you sure?</h2></div>
            <button type="button" class="cf-modal-close" data-close aria-label="Close"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="cf-modal-body"><p id="bm-confirm-text" class="bm-confirm-text"></p></div>
        <footer class="cf-modal-foot">
            <button type="button" class="btn btn-secondary btn-sm" data-close>Cancel</button>
            <button type="button" class="btn btn-danger btn-sm" id="bm-confirm-ok">Confirm</button>
        </footer>
    </div>
</div>

<script>
(function () {
    'use strict';
    var SCOPE = <%- JSON.stringify(_scope).replace(/</g, '\\u003c') %>;
    var SUPER = <%- JSON.stringify(_sa) %>;
    var ME = <%- JSON.stringify(String(user.id)).replace(/</g, '\\u003c') %>;
    var bots = [];
    var filter = 'all';

    function h(tag, attrs, kids) {
        var el = document.createElement(tag);
        if (attrs) Object.keys(attrs).forEach(function (k) {
            var v = attrs[k];
            if (v == null || v === false) return;
            if (k === 'class') el.className = v;
            else if (k === 'text') el.textContent = v;
            else el.setAttribute(k, v === true ? '' : v);
        });
        (kids || []).forEach(function (c) { if (c != null && c !== false) el.appendChild(typeof c === 'string' ? document.createTextNode(c) : c); });
        return el;
    }
    function icon(cls) { return h('i', { class: 'fas ' + cls, 'aria-hidden': 'true' }); }
    function toast(t, tone) { if (window.cfSite) window.cfSite.toast(t, tone); }
    function ago(iso) {
        if (!iso) return '';
        var s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
        if (s < 90) return 'just now';
        if (s < 5400) return Math.round(s / 60) + ' min ago';
        if (s < 129600) return Math.round(s / 3600) + ' h ago';
        return Math.round(s / 86400) + ' days ago';
    }
    function dur(ms) {
        if (ms == null) return '';
        var m = Math.floor(ms / 60000), d = Math.floor(m / 1440), hh = Math.floor((m % 1440) / 60);
        if (d) return d + 'd ' + hh + 'h';
        if (hh) return hh + 'h ' + (m % 60) + 'm';
        return Math.max(1, m) + 'm';
    }
    function date(iso) { try { return new Date(iso).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }); } catch (e) { return ''; } }
    async function api(url, opts) {
        var r = await fetch(url, Object.assign({ headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' } }, opts || {}));
        var ct = r.headers.get('content-type') || '';
        var fail = function (msg) { var e = new Error(msg); e.status = r.status; return e; };
        if (ct.indexOf('application/json') === -1) throw fail(r.status === 401 ? 'Your session expired. Reload the page to sign in again.' : 'Unexpected response (' + r.status + ').');
        var d = await r.json();
        if (!r.ok || d.success === false) throw fail(d.message || d.details || d.error || ('Request failed (' + r.status + ')'));
        return d;
    }

    var STATE = {
        online: { label: 'Online', tone: 'is-ok', dot: 'is-ok' },
        connecting: { label: 'Connecting', tone: 'is-warn', dot: 'is-warn' },
        offline: { label: 'Offline', tone: 'is-bad', dot: 'is-bad' },
        disabled: { label: 'Turned off', tone: '', dot: '' },
        pending: { label: 'Waiting for approval', tone: 'is-warn', dot: 'is-warn' },
    };
    function needsAttention(b) { return b.state === 'offline' || b.state === 'connecting' || b.state === 'pending' || (b.state === 'online' && b.counts.waiting > 0); }

    // ---------------------------------------------------------------- dialogs
    var lastFocus = null;
    function openModal(m) { lastFocus = document.activeElement; m.hidden = false; var f = m.querySelector('input') || m.querySelector('.cf-modal-foot .btn:last-child'); if (f) f.focus(); }
    function closeModal(m) { m.hidden = true; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
    document.querySelectorAll('.cf-modal').forEach(function (m) {
        m.addEventListener('click', function (e) { if (e.target === m || e.target.closest('[data-close]')) closeModal(m); });
        m.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(m); });
    });
    var confirmEl = document.getElementById('bm-confirm');
    var confirmCb = null;
    function ask(title, text, okLabel, cb) {
        document.getElementById('bm-confirm-title').textContent = title;
        document.getElementById('bm-confirm-text').textContent = text;
        document.getElementById('bm-confirm-ok').textContent = okLabel || 'Confirm';
        confirmCb = cb;
        openModal(confirmEl);
    }
    document.getElementById('bm-confirm-ok').addEventListener('click', function () { var cb = confirmCb; confirmCb = null; closeModal(confirmEl); if (cb) cb(); });

    // ---------------------------------------------------------------- list
    async function load() {
        var state = document.getElementById('bm-state');
        try {
            var d;
            try { d = await api('/api/bots/fleet?scope=' + encodeURIComponent(SCOPE)); }
            catch (e) {
                // Until the dashboard restarts with /api/bots/fleet, fall back to the older list.
                if (e.status !== 404) throw e;
                var old = await api('/api/bots');
                d = { bots: (Array.isArray(old) ? old : []).map(function (b) {
                    var st = b.status;
                    return {
                        bot_id: b.bot_id, name: b.bot_name, avatar: b.bot_avatar, owner_user_id: b.owner_user_id, mine: true,
                        enabled: !!b.enabled, approved: !!b.approved, created_at: b.created_at,
                        state: !b.approved ? 'pending' : !b.enabled ? 'disabled' : !st ? 'offline' : st.isReady ? 'online' : 'connecting',
                        uptime_ms: st && st.isReady ? st.uptime : null, error: null,
                        servers: (st && st.assignedGuilds || []).map(function (id) { return { id: id, name: null, mapped: true, present: true }; }),
                        counts: { assigned: st ? (st.assignedGuilds || []).length : 0, joined: st ? st.guilds : 0, waiting: 0 },
                        invite_url: 'https://discord.com/oauth2/authorize?client_id=' + encodeURIComponent(b.client_id || b.bot_id) + '&permissions=1643797540086&scope=bot+applications.commands',
                    };
                }) };
            }
            bots = d.bots || [];
            state.hidden = true;
            render();
        } catch (e) {
            state.hidden = false;
            state.className = 'cf-state cf-state--error';
            state.replaceChildren(h('p', { class: 'cf-state-title', text: 'Could not load the bots' }), h('p', { class: 'cf-state-text', text: e.message }));
        }
    }

    function kpis() {
        var servers = new Set();
        bots.forEach(function (b) { b.servers.forEach(function (s) { if (s.present) servers.add(s.id); }); });
        var set = function (k, v) { var el = document.querySelector('[data-kpi="' + k + '"]'); if (el) el.textContent = v; };
        set('total', bots.length);
        set('online', bots.filter(function (b) { return b.state === 'online'; }).length);
        set('attention', bots.filter(needsAttention).length);
        set('servers', servers.size);
    }

    function matches(b, q) {
        if (filter === 'online' && b.state !== 'online') return false;
        if (filter === 'attention' && !needsAttention(b)) return false;
        if (filter === 'off' && b.state !== 'disabled') return false;
        if (!q) return true;
        var hay = [b.name, b.bot_id, b.owner_name || '', b.owner_user_id].concat(b.servers.map(function (s) { return (s.name || '') + ' ' + s.id; })).join(' ').toLowerCase();
        return hay.indexOf(q) !== -1;
    }

    function render() {
        kpis();
        var list = document.getElementById('bm-list');
        var q = (document.getElementById('bm-search').value || '').trim().toLowerCase();
        document.getElementById('bm-toolbar').hidden = bots.length <= 15 && filter === 'all' && !q;
        var shown = bots.filter(function (b) { return matches(b, q); });
        // Problems first, then by name.
        var rank = { offline: 0, connecting: 1, pending: 2, online: 3, disabled: 4 };
        shown.sort(function (a, b) { return (rank[a.state] - rank[b.state]) || String(a.name).localeCompare(String(b.name)); });
        document.getElementById('bm-count').textContent = bots.length ? (shown.length === bots.length ? String(bots.length) : shown.length + ' of ' + bots.length) : '';
        if (!bots.length) {
            list.replaceChildren(h('div', { class: 'cf-state' }, [
                h('p', { class: 'cf-state-title', text: SCOPE === 'all' ? 'No custom bots yet' : 'You have no custom bots yet' }),
                h('p', { class: 'cf-state-text', text: 'Add a bot with its application ID and token, then assign it to your servers.' }),
            ]));
            return;
        }
        if (!shown.length) { list.replaceChildren(h('div', { class: 'cf-state cf-state--compact' }, [h('p', { class: 'cf-state-title', text: 'No bots match.' })])); return; }
        list.replaceChildren.apply(list, shown.map(row));
    }

    function serverChip(b, s) {
        var label = s.name || s.id;
        if (s.mapped && !s.present) {
            return h('a', { class: 'cf-chip is-warn', href: b.invite_url + '&guild_id=' + encodeURIComponent(s.id) + '&disable_guild_select=true', target: '_blank', rel: 'noopener', title: 'Assigned, but the bot is not in this server. Click to invite it.' },
                [h('span', { text: label }), h('span', { text: '· not joined' })]);
        }
        if (!s.mapped) return h('span', { class: 'cf-chip is-info', title: 'The bot is in this server but not assigned to it, so the main bot answers there.' }, [h('span', { text: label }), h('span', { text: '· not assigned' })]);
        return h('span', { class: 'cf-chip', title: (s.members ? s.members.toLocaleString() + ' members · ' : '') + s.id }, [h('span', { text: label })]);
    }

    function btn(label, cls, onclick, ic) {
        var el = h('button', { type: 'button', class: 'btn btn-sm ' + cls }, [ic ? icon(ic) : null, ic ? ' ' + label : label]);
        el.addEventListener('click', function () { onclick(el); });
        return el;
    }
    function busy(el, on, label) {
        el.disabled = on;
        if (on) { el._kids = Array.prototype.slice.call(el.childNodes); el.textContent = label || 'Working…'; }
        else if (el._kids) { el.replaceChildren.apply(el, el._kids); }
    }

    function row(b) {
        var st = STATE[b.state] || STATE.offline;
        var meta = [h('span', { class: 'cf-mono', text: b.bot_id })];
        meta.push(h('span', { text: b.counts.joined + (b.counts.joined === 1 ? ' server' : ' servers') }));
        if (b.state === 'online' && b.uptime_ms != null) meta.push(h('span', { text: 'up ' + dur(b.uptime_ms) }));
        if (SCOPE === 'all') meta.push(h('span', { text: 'owner ' + (b.mine ? 'you' : (b.owner_name || b.owner_user_id)) }));
        if (b.created_at) meta.push(h('span', { text: 'added ' + date(b.created_at) }));

        var main = [
            h('p', { class: 'cf-list-title' }, [h('span', { text: b.name }), h('span', { class: 'cf-pill ' + st.tone }, [h('span', { class: 'cf-dot ' + st.dot }), st.label])]),
            h('p', { class: 'cf-list-meta' }, meta),
        ];
        if (b.error) main.push(h('p', { class: 'cf-list-body bm-error' }, [icon('fa-triangle-exclamation'), ' ' + b.error.message, h('span', { class: 'cf-muted', text: ' · ' + ago(b.error.at) })]));
        if (b.state === 'offline' && !b.error) main.push(h('p', { class: 'cf-list-body cf-muted', text: b.counts.assigned ? 'Not logged in. It may have failed at the last restart; Reconnect tries again.' : 'Not running: assign it to a server first.' }));
        if (b.state === 'pending' && b.approval_notes) main.push(h('p', { class: 'cf-list-body is-pre cf-muted', text: b.approval_notes }));

        var chips = h('div', { class: 'cf-chips' });
        var LIMIT = 4;
        b.servers.slice(0, LIMIT).forEach(function (s) { chips.appendChild(serverChip(b, s)); });
        if (b.servers.length > LIMIT) {
            var more = h('button', { type: 'button', class: 'cf-chip', text: '+' + (b.servers.length - LIMIT) + ' more' });
            more.addEventListener('click', function () { more.remove(); b.servers.slice(LIMIT).forEach(function (s) { chips.appendChild(serverChip(b, s)); }); });
            chips.appendChild(more);
        }
        if (!b.servers.length) chips.appendChild(h('span', { class: 'cf-chip', text: 'No servers yet' }));
        main.push(chips);

        var actions = [];
        if (b.state === 'pending' && SUPER) actions.push(btn('Approve', 'btn-primary', function (el) { approve(b, el); }));
        actions.push(h('a', { class: 'btn btn-secondary btn-sm', href: '/bot-management/assign/' + encodeURIComponent(b.bot_id) }, [icon('fa-diagram-project'), ' Servers']));
        actions.push(h('a', { class: 'btn btn-secondary btn-sm', href: b.invite_url, target: '_blank', rel: 'noopener', title: 'Invite this bot to a server' }, [icon('fa-user-plus'), ' Invite']));
        if (b.enabled && b.approved) actions.push(btn('Reconnect', 'btn-secondary', function (el) { reconnect(b, el); }, 'fa-plug'));
        if (b.approved) actions.push(btn(b.enabled ? 'Turn off' : 'Turn on', 'btn-secondary', function (el) { toggle(b, el); }, b.enabled ? 'fa-power-off' : 'fa-play'));
        actions.push(btn('Delete', 'btn-danger', function (el) { del(b, el); }, 'fa-trash'));

        return h('div', { class: 'cf-list-item cf-list-item--multi bm-bot' + (b.state === 'disabled' ? ' is-off' : ''), 'data-bot': b.bot_id }, [
            h('div', { class: 'cf-list-lead' }, [h('img', { src: b.avatar || 'https://cdn.discordapp.com/embed/avatars/0.png', alt: '', loading: 'lazy', 'data-cf-fallback': 'https://cdn.discordapp.com/embed/avatars/0.png' })]),
            h('div', { class: 'cf-list-main' }, main),
            h('div', { class: 'cf-list-actions' }, actions),
        ]);
    }

    async function reconnect(b, el) {
        busy(el, true, 'Reconnecting…');
        try { var d = await api('/api/bots/' + encodeURIComponent(b.bot_id) + '/reconnect', { method: 'POST' }); toast(d.message || 'Reconnected.', 'ok'); await load(); }
        catch (e) { toast(b.name + ': ' + e.message, 'bad'); busy(el, false); }
    }
    function toggle(b, el) {
        var go = async function () {
            busy(el, true);
            try {
                var d = await api('/api/bots/' + encodeURIComponent(b.bot_id), { method: 'PUT', body: JSON.stringify({ enabled: !b.enabled }) });
                toast(d.message || (b.enabled ? 'Turned off.' : 'Turned on.'), d.started === false ? 'bad' : 'ok');
                await load();
            } catch (e) { toast(e.message, 'bad'); busy(el, false); }
        };
        if (b.enabled) ask('Turn off ' + b.name + '?', 'It logs out of Discord now. Its servers are answered by the main CertiFried bot until you turn it back on.', 'Turn off', go);
        else go();
    }
    function del(b, el) {
        ask('Delete ' + b.name + '?', 'Its token and server assignments are removed and its servers fall back to the main CertiFried bot. This cannot be undone.', 'Delete bot', async function () {
            busy(el, true, 'Deleting…');
            try { await api('/api/bots/' + encodeURIComponent(b.bot_id), { method: 'DELETE' }); toast(b.name + ' deleted.', 'ok'); await load(); }
            catch (e) { toast(e.message, 'bad'); busy(el, false); }
        });
    }
    async function approve(b, el) {
        busy(el, true, 'Checking…');
        try { var d = await api('/api/super-admin/bots/' + encodeURIComponent(b.bot_id) + '/approve', { method: 'POST', body: JSON.stringify({ approved: true }) }); toast(d.message || 'Approved.', 'ok'); await load(); }
        catch (e) { toast(e.message, 'bad'); busy(el, false); }
    }

    document.getElementById('bm-search').addEventListener('input', render);
    document.getElementById('bm-filter').addEventListener('click', function (e) {
        var b = e.target.closest('button[data-filter]');
        if (!b) return;
        filter = b.dataset.filter;
        this.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        render();
    });
    document.getElementById('bm-refresh').addEventListener('click', function () { load(); });

    // ---------------------------------------------------------------- add a bot
    var addModal = document.getElementById('bm-add');
    var addOpen = document.getElementById('bm-add-open');
    if (addOpen) addOpen.addEventListener('click', function () { document.getElementById('bm-add-form').reset(); document.getElementById('bm-add-status').textContent = ''; openModal(addModal); });
    document.getElementById('bm-add-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        var status = document.getElementById('bm-add-status');
        var submit = document.getElementById('bm-add-submit');
        var data = Object.fromEntries(new FormData(this));
        submit.disabled = true;
        status.className = 'cf-status-line is-busy';
        status.textContent = 'Checking the token with Discord…';
        try {
            var d = await api('/api/bots', { method: 'POST', body: JSON.stringify(data) });
            closeModal(addModal);
            toast(d.message || 'Bot added.', 'ok');
            await load();
        } catch (err) {
            status.className = 'cf-status-line is-bad';
            status.textContent = err.message;
        } finally { submit.disabled = false; }
    });

    // ---------------------------------------------------------------- bot creators (super-admin)
    async function loadCreators() {
        var wrap = document.getElementById('bm-creators');
        if (!wrap) return;
        var state = document.getElementById('bm-creators-state');
        try {
            var d = await api('/api/super-admin/bot-managers');
            var list = d.managers || [];
            state.hidden = true;
            document.getElementById('bm-creators-count').textContent = list.length ? String(list.length) : '';
            if (!list.length) { wrap.replaceChildren(h('div', { class: 'cf-state cf-state--compact' }, [h('p', { class: 'cf-state-title', text: 'Nobody else can add bots yet.' })])); return; }
            var owned = {};
            bots.forEach(function (b) { owned[b.owner_user_id] = (owned[b.owner_user_id] || 0) + 1; });
            wrap.replaceChildren.apply(wrap, list.map(function (m) {
                var rm = null;
                if (m.user_id !== ME) {
                    rm = h('button', { type: 'button', class: 'btn btn-secondary btn-sm', text: 'Remove' });
                    rm.addEventListener('click', function () {
                        ask('Remove ' + (m.username || m.user_id) + '?', 'They can no longer add bots. Bots they already own keep running.', 'Remove', async function () {
                            try { await api('/api/super-admin/bot-managers/' + encodeURIComponent(m.user_id), { method: 'DELETE' }); toast('Removed.', 'ok'); loadCreators(); }
                            catch (e) { toast(e.message, 'bad'); }
                        });
                    });
                }
                var n = SCOPE === 'all' ? (owned[m.user_id] || 0) : null;
                return h('div', { class: 'cf-list-item' }, [
                    h('div', { class: 'cf-list-main' }, [
                        h('span', { class: 'cf-em', text: m.username || 'Unknown user' }), ' ',
                        h('span', { class: 'cf-muted cf-mono', text: m.user_id }),
                        n != null ? h('span', { class: 'cf-muted', text: ' · ' + n + (n === 1 ? ' bot' : ' bots') }) : null,
                    ]),
                    h('div', { class: 'cf-list-actions' }, [rm]),
                ]);
            }));
        } catch (e) {
            state.hidden = false;
            state.className = 'cf-state cf-state--error cf-state--compact';
            state.replaceChildren(h('p', { class: 'cf-state-title', text: 'Could not load: ' + e.message }));
        }
    }
    var cform = document.getElementById('bm-creator-form');
    if (cform) cform.addEventListener('submit', async function (e) {
        e.preventDefault();
        var input = document.getElementById('bm-creator-id');
        var id = input.value.trim();
        if (!/^\d{17,20}$/.test(id)) { toast('Enter a Discord user ID (17-20 digits).', 'bad'); input.focus(); return; }
        try { await api('/api/super-admin/bot-managers', { method: 'POST', body: JSON.stringify({ userId: id }) }); input.value = ''; toast('Added.', 'ok'); loadCreators(); }
        catch (err) { toast(err.message, 'bad'); }
    });

    load().then(loadCreators);
})();
</script>
<style>
    .bm-bot.is-off .cf-list-lead img { filter: grayscale(1); opacity: 0.6; }
    .bm-bot .cf-pill { gap: 6px; }
    .bm-error { color: var(--cf-danger) !important; }
    .bm-error .fas { font-size: 12px; }
    .bm-confirm-text { margin: 0; color: var(--cf-text-2); }
    @media (max-width: 640px) {
        .bm-bot { flex-wrap: wrap; }
        .bm-bot > .cf-list-actions { width: 100%; margin-left: 0; }
    }
</style>
<%- include('partials/site-footer') %>
<script src="/js/csrf.js"></script>
</body>
</html>
