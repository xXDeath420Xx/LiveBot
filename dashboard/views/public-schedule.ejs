<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%#
  Public event schedule (GET /schedule/:eventSlug, routes/public-schedule.js). Locals: error, event,
  schedules, currentSchedule, items (with estimated_start Date and position), twitchUser.
  Start times are printed in UTC by the server and rewritten in the visitor's time zone by the
  script, which also refreshes the "now" panel and the run statuses from /api/schedule/<slug>/ticker.
%>
<%
    const _twitch = (typeof twitchUser !== 'undefined' && twitchUser) ? twitchUser : null;
    const _event = (typeof event !== 'undefined' && event) ? event : null;
    const _error = (typeof error !== 'undefined' && error) ? error : null;
    const _schedules = (typeof schedules !== 'undefined' && Array.isArray(schedules)) ? schedules : [];
    const _current = (typeof currentSchedule !== 'undefined' && currentSchedule) ? currentSchedule : null;
    const _items = (typeof items !== 'undefined' && Array.isArray(items)) ? items : [];
    const _found = !!_event && !_error;
    const _dur = (s) => { s = Number(s) || 0; const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60; return h + ':' + String(m).padStart(2, '0') + ':' + String(x).padStart(2, '0'); };
    const _iso = (d) => { const t = d ? new Date(d) : null; return t && !isNaN(t) ? t.toISOString() : ''; };
    const _utc = (d) => new Date(d).toLocaleString('en-GB', { weekday: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';
    const _statusLabel = { pending: 'Pending', running: 'Running', completed: 'Done', skipped: 'Skipped' };
    const _statusClass = { running: 'cfs-badge--ok', completed: 'cfs-badge--off', skipped: 'cfs-badge--warn' };
    let _desc = 'This event schedule does not exist or is not public.';
    if (_found) {
        const d = _event.description ? String(_event.description).replace(/\s+/g, ' ').trim() : '';
        _desc = d ? (d.length > 155 ? d.slice(0, 155).replace(/\s+\S*$/, '') + '…' : d) : 'Run order, estimates and start times for ' + _event.name + '.';
    }
    const _completed = _items.filter(i => i.status === 'completed').length;
    const _pct = _items.length ? Math.round((_completed / _items.length) * 100) : 0;
    // The "now" panel as of page load, picked the same way as the ticker API does.
    let _prev = null, _cur = null, _next = null;
    _items.forEach(i => {
        if (i.status === 'running') _cur = i;
        else if (i.status === 'completed') _prev = i;
        else if (!_cur && !_next && (i.status || 'pending') === 'pending') _next = i;
    });
    if (!_cur && _next) { _cur = _next; _next = _items.find(i => (i.status || 'pending') === 'pending' && i.position > _cur.position) || null; }
%>
<%- include('partials/site-head', { title: (_found ? _event.name + ' schedule' : 'Schedule not found') + ' · CertiFried', description: _desc, path: _found ? '/schedule/' + encodeURIComponent(_event.slug) : null, noindex: !_found }) %>
    <style>
        /* Tap targets: at least 40px tall on every screen size. */
        main .btn { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; }
        .sc-account { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2) var(--cf-3); margin-top: var(--cf-4); font-size: var(--cf-text-sm); color: var(--cf-text-2); }
        .sc-account img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
        .sc-back { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; margin-bottom: var(--cf-2); font-size: var(--cf-text-sm); color: var(--cf-text-2); text-decoration: none; }
        .sc-back:hover { color: var(--cf-text); }

        .sc-now { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--cf-3); }
        @media (max-width: 760px) { .sc-now { grid-template-columns: minmax(0, 1fr); } }
        .sc-run { padding: var(--cf-4); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); min-width: 0; }
        .sc-run.is-current { border-color: var(--cf-accent-line); }
        .sc-run h3 { margin: 0 0 var(--cf-2); font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); }
        .sc-run .sc-game { margin: 0; font-size: var(--cf-text-lg); font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
        .sc-run p { margin: 2px 0 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); overflow-wrap: anywhere; }
        .sc-run p:empty { display: none; }
        .sc-live-note { margin: var(--cf-3) 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }

        .sc-progress { margin-top: var(--cf-5); }
        .sc-progress-row { display: flex; justify-content: space-between; gap: var(--cf-3); margin-bottom: 6px; font-size: var(--cf-text-sm); color: var(--cf-text-2); font-variant-numeric: tabular-nums; }
        .sc-bar { height: 8px; border-radius: 999px; background: var(--cf-surface-2); border: 1px solid var(--cf-border); overflow: hidden; }
        .sc-bar span { display: block; height: 100%; background: var(--cf-accent); transition: width var(--cf-base) var(--cf-ease); }

        .sc-tabs { display: flex; flex-wrap: wrap; gap: var(--cf-2); margin: 0 0 var(--cf-4); padding: 0; list-style: none; }
        .sc-tabs a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface); color: var(--cf-text-2); font-size: var(--cf-text-sm); font-weight: 500; text-decoration: none; }
        .sc-tabs a:hover { color: var(--cf-text); border-color: var(--cf-border-strong); }
        .sc-tabs a[aria-current="page"] { color: var(--cf-text); background: var(--cf-surface-3); border-color: var(--cf-border-strong); }
        .sc-tabs a:focus-visible, .sc-back:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 2px; }

        .sc-table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: var(--cf-text-sm); }
        .sc-table th, .sc-table td { padding: 10px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--cf-border); }
        .sc-table th { font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); white-space: nowrap; }
        .sc-table tr:last-child td { border-bottom: 0; }
        .sc-table td.num { width: 3rem; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
        .sc-table .sc-time { white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--cf-text); }
        .sc-table .sc-sub { display: block; margin-top: 2px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .sc-table .sc-name { font-weight: 500; color: var(--cf-text); }
        .sc-table tr.is-running td { background: var(--cf-accent-soft); }
        .sc-table tr.is-completed .sc-name, .sc-table tr.is-skipped .sc-name { color: var(--cf-text-2); }
        .sc-tz { margin: var(--cf-3) 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }

        @media print {
            .cfs-header, .cfs-footer, .sc-account, .sc-back, .cfs-actions-row, #sc-now-section, .sc-tabs { display: none !important; }
            .cfs-body, .cfs-table-wrap, .sc-table td, .sc-table th { background: #fff !important; color: #111 !important; border-color: #ccc !important; }
            .sc-table { min-width: 0; }
        }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', returnTo: _found ? '/schedule/' + encodeURIComponent(_event.slug) : '/schedule' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main">
        <a class="sc-back" href="/schedule"><span aria-hidden="true">&larr;</span> Event calendar</a>

        <% if (!_found) { %>
            <div class="cfs-pagehead">
                <h1>Schedule not found</h1>
                <p class="cfs-lede"><%= _error && _error !== 'Event not found or not active' ? 'The schedule could not be loaded just now. Try again in a minute.' : 'There is no public event at this address. It may have ended, been renamed or been made private.' %></p>
                <div class="cfs-actions-row"><a class="btn btn-primary" href="/schedule">Browse the event calendar</a></div>
            </div>
        <% } else {
            // A schedule can override the event's stream, website and X account.
            const liveChannel = (_current && _current.twitch_channel) || _event.twitch_channel;
            const siteUrl = (_current && _current.website_url) || _event.website_url;
            const xHandle = String((_current && _current.twitter) || _event.twitter || '').replace(/^@/, '');
            const slug = encodeURIComponent(_event.slug);
        %>
            <div class="cfs-pagehead">
                <h1><%= _event.name %></h1>
                <% if (_event.description) { %><p class="cfs-lede"><%= _event.description %></p><% } %>
                <div class="cfs-actions-row">
                    <% if (liveChannel) { %><a class="btn btn-primary" href="https://twitch.tv/<%= encodeURIComponent(liveChannel) %>" target="_blank" rel="noopener">Watch on Twitch</a><% } %>
                    <% if (siteUrl && /^https?:\/\//i.test(siteUrl)) { %><a class="btn btn-secondary" href="<%= siteUrl %>" target="_blank" rel="noopener">Website</a><% } %>
                    <% if (xHandle) { %><a class="btn btn-secondary" href="https://x.com/<%= encodeURIComponent(xHandle) %>" target="_blank" rel="noopener">@<%= xHandle %> on X</a><% } %>
                    <a class="btn btn-secondary" href="/api/schedule/<%= slug %>/export" download="<%= _event.slug %>-schedule.json">Download as JSON</a>
                </div>
                <div class="sc-account">
                    <% if (_twitch) { %>
                        <% if (_twitch.avatar && /^https:\/\//.test(_twitch.avatar)) { %><img src="<%= _twitch.avatar %>" alt="" width="28" height="28" referrerpolicy="no-referrer"><% } %>
                        <span>Signed in to Twitch as <strong><%= _twitch.display_name || _twitch.login || 'you' %></strong></span>
                        <a href="/my-schedules" class="btn btn-secondary btn-sm">My schedules</a>
                        <a href="/auth/twitch/logout" class="btn btn-secondary btn-sm">Log out of Twitch</a>
                    <% } else { %>
                        <a href="/auth/twitch?returnTo=/schedule/<%= slug %>" class="btn btn-secondary btn-sm">Log in with Twitch to publish your own schedule</a>
                    <% } %>
                </div>
            </div>

            <section class="cfs-section" id="sc-now-section" aria-labelledby="sc-now-h">
                <h2 id="sc-now-h">Now</h2>
                <div class="sc-now" aria-live="polite">
                    <div class="sc-run">
                        <h3>Previous</h3>
                        <p class="sc-game" id="prev-game"><%= _prev ? _prev.game_name : 'None yet' %></p>
                        <p id="prev-category"><%= _prev && _prev.category || '' %></p>
                        <p id="prev-runners"><%= _prev && _prev.runners || '' %></p>
                    </div>
                    <div class="sc-run is-current">
                        <h3>Current run</h3>
                        <p class="sc-game" id="current-game"><%= _cur ? _cur.game_name : 'No run in progress' %></p>
                        <p id="current-category"><%= _cur && _cur.category || '' %></p>
                        <p id="current-runners"><%= _cur && _cur.runners || '' %></p>
                        <p id="current-estimate"><%= _cur ? 'Estimate ' + _dur(_cur.estimate_seconds) : '' %></p>
                    </div>
                    <div class="sc-run">
                        <h3>Up next</h3>
                        <p class="sc-game" id="next-game"><%= _next ? _next.game_name : 'Nothing after this' %></p>
                        <p id="next-category"><%= _next && _next.category || '' %></p>
                        <p id="next-runners"><%= _next && _next.runners || '' %></p>
                        <p id="next-eta"><% if (_next && _iso(_next.estimated_start)) { %>Starts about <time datetime="<%= _iso(_next.estimated_start) %>" data-local="start"><%= _utc(_next.estimated_start) %></time><% } %></p>
                    </div>
                </div>
                <div class="sc-progress">
                    <div class="sc-progress-row"><span id="progress-text"><%= _completed %> of <%= _items.length %> runs done</span><span id="progress-percent"><%= _pct %>%</span></div>
                    <div class="sc-bar" role="progressbar" aria-labelledby="progress-text" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= _pct %>" id="progress-bar"><span id="progress-fill" style="width: <%= _pct %>%"></span></div>
                </div>
                <p class="sc-live-note" id="sc-live-note">Updates every 30 seconds while this page is open.</p>
            </section>

            <section class="cfs-section" aria-labelledby="sc-runs-h">
                <h2 id="sc-runs-h"><%= _schedules.length > 1 && _current ? _current.name : 'Run order' %></h2>
                <% if (_schedules.length > 1) { %>
                    <nav aria-label="Schedules in this event">
                        <ul class="sc-tabs">
                            <% _schedules.forEach(function (s) { %>
                            <li><a href="/schedule/<%= slug %>?schedule=<%= encodeURIComponent(s.slug) %>"<% if (_current && _current.id === s.id) { %> aria-current="page"<% } %>><%= s.name %></a></li>
                            <% }); %>
                        </ul>
                    </nav>
                <% } %>

                <% if (!_items.length) { %>
                    <div class="cfs-rows"><div class="cfs-empty"><p>No runs have been added to this schedule yet.</p></div></div>
                <% } else { %>
                    <div class="cfs-table-wrap">
                        <table class="sc-table">
                            <thead>
                                <tr><th scope="col">#</th><th scope="col">Starts</th><th scope="col">Game</th><th scope="col">Runners</th><th scope="col">Estimate</th><th scope="col">Status</th></tr>
                            </thead>
                            <tbody id="runs-tbody">
                                <% _items.forEach(function (item) {
                                    const st = _statusLabel[item.status] ? item.status : 'pending';
                                    const startIso = _iso(item.estimated_start);
                                %>
                                <tr class="is-<%= st %>" data-item-id="<%= item.id %>">
                                    <td class="num"><%= item.position %></td>
                                    <td><% if (startIso) { %><time class="sc-time" datetime="<%= startIso %>" data-local="start"><%= _utc(item.estimated_start) %></time><% } else { %><span class="sc-sub">Not set</span><% } %></td>
                                    <td><span class="sc-name"><%= item.game_name %></span><% if (item.category) { %><span class="sc-sub"><%= item.category %></span><% } %></td>
                                    <td><%= item.runners || '–' %></td>
                                    <td><span class="sc-time"><%= _dur(item.estimate_seconds) %></span><% if (item.setup_seconds) { %><span class="sc-sub">+<%= _dur(item.setup_seconds) %> setup</span><% } %></td>
                                    <td><span class="cfs-badge <%= _statusClass[st] || '' %>" data-status><%= _statusLabel[st] %></span></td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <p class="sc-tz" id="sc-tz">Start times are estimates in UTC, from the schedule's start plus each run's estimate and setup.</p>
                <% } %>
            </section>
        <% } %>
    </main>
<%- include('partials/site-footer') %>
<% if (_found) { %>
<script>
(function () {
    var eventSlug = <%- JSON.stringify(String(_event.slug)).replace(/</g, '\\u003c') %>;
    var scheduleSlug = <%- JSON.stringify(_current && _current.slug ? String(_current.slug) : '').replace(/</g, '\\u003c') %>;
    var LABEL = { pending: 'Pending', running: 'Running', completed: 'Done', skipped: 'Skipped' };
    var BADGE = { running: 'cfs-badge--ok', completed: 'cfs-badge--off', skipped: 'cfs-badge--warn' };
    var $ = function (id) { return document.getElementById(id); };

    function dur(s) {
        s = Number(s) || 0;
        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60;
        return h + ':' + String(m).padStart(2, '0') + ':' + String(x).padStart(2, '0');
    }
    function localTime(iso) {
        var d = new Date(iso);
        return isNaN(d) ? '' : d.toLocaleString(undefined, { weekday: 'short', hour: '2-digit', minute: '2-digit' });
    }

    // Start times: the server prints UTC; show them in the visitor's time zone.
    var times = document.querySelectorAll('time[data-local="start"]');
    times.forEach(function (t) { var s = localTime(t.getAttribute('datetime')); if (s) t.textContent = s; });
    if (times.length && $('sc-tz')) {
        var zone = '';
        try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone; } catch (e) { /* older browsers */ }
        $('sc-tz').textContent = 'Start times are estimates in your time zone' + (zone ? ' (' + zone + ')' : '') + ", from the schedule's start plus each run's estimate and setup.";
    }

    function fill(prefix, run, extra) {
        $(prefix + '-game').textContent = run ? run.game_name : (prefix === 'current' ? 'No run in progress' : prefix === 'prev' ? 'None yet' : 'Nothing after this');
        $(prefix + '-category').textContent = run && run.category ? run.category : '';
        $(prefix + '-runners').textContent = run && run.runners ? run.runners : '';
        if (extra) $(extra.id).textContent = run ? extra.text(run) : '';
    }

    function update() {
        var url = '/api/schedule/' + encodeURIComponent(eventSlug) + '/ticker' + (scheduleSlug ? '?schedule=' + encodeURIComponent(scheduleSlug) : '');
        fetch(url, { cache: 'no-store', credentials: 'same-origin' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (data) {
                var t = data.ticker;
                if (t) {
                    fill('prev', t.previous);
                    fill('current', t.current, { id: 'current-estimate', text: function (r) { return 'Estimate ' + dur(r.estimate_seconds); } });
                    fill('next', t.next, { id: 'next-eta', text: function (r) { return r.estimated_start ? 'Starts about ' + localTime(r.estimated_start) : ''; } });
                    var pct = t.total_runs > 0 ? Math.round((t.completed_runs / t.total_runs) * 100) : 0;
                    $('progress-text').textContent = t.completed_runs + ' of ' + t.total_runs + ' runs done';
                    $('progress-percent').textContent = pct + '%';
                    $('progress-fill').style.width = pct + '%';
                    $('progress-bar').setAttribute('aria-valuenow', String(pct));
                }
                (data.items || []).forEach(function (item) {
                    var row = document.querySelector('tr[data-item-id="' + item.id + '"]');
                    if (!row) return;
                    var st = LABEL[item.status] ? item.status : 'pending';
                    row.className = 'is-' + st;
                    var badge = row.querySelector('[data-status]');
                    if (badge) { badge.className = 'cfs-badge ' + (BADGE[st] || ''); badge.textContent = LABEL[st]; }
                });
                $('sc-live-note').textContent = 'Updates every 30 seconds while this page is open.';
            })
            .catch(function () {
                $('sc-live-note').textContent = 'Live updates are not available right now. The run order below is from when the page loaded.';
            });
    }
    update();
    setInterval(function () { if (!document.hidden) update(); }, 30000);
})();
</script>
<% } %>
</body>
</html>
