<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>">
<head>
<%- include('partials/site-head', { title: 'Donate · CertiFried', description: 'CertiFried is free for every server. Donations are voluntary and help pay for hosting, APIs and development.', path: '/donate' }) %>
    <style>
        .dn-methods { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--cf-3); }
        @media (max-width: 640px) { .dn-methods { grid-template-columns: minmax(0, 1fr); } }
        .dn-method { display: flex; flex-direction: column; gap: var(--cf-3); padding: var(--cf-5); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .dn-method h2 { margin: 0; font-size: var(--cf-text-lg); font-weight: 600; }
        .dn-method p { margin: 0; color: var(--cf-text-2); font-size: var(--cf-text-sm); }
        .dn-handle { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-2); padding: 8px 8px 8px 12px; background: var(--cf-inset); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); }
        .dn-handle span { font-family: var(--cf-mono); font-size: var(--cf-text-md); color: var(--cf-text); overflow-wrap: anywhere; }
        .dn-method .btn { align-self: flex-start; }
        .dn-uses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--cf-3); }
        @media (max-width: 760px) { .dn-uses { grid-template-columns: minmax(0, 1fr); } }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: 'donate', user: locals.user || null, returnTo: '/donate' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main cfs-main--narrow">
        <div class="cfs-pagehead">
            <h1>Support the bot</h1>
            <p class="cfs-lede">CertiFried is free for every server, with no paid tiers. Donations help pay for the servers, the paid APIs and development time (Death's midnight stoner sessions).</p>
        </div>

        <section class="cfs-section" aria-label="Ways to donate">
            <div class="dn-methods">
                <div class="dn-method">
                    <h2>Cash App</h2>
                    <p>Send a donation directly with Cash App.</p>
                    <div class="dn-handle"><span>$DeathC</span><button type="button" class="btn btn-secondary btn-sm" data-copy="$DeathC">Copy</button></div>
                    <a href="https://cash.app/$DeathC" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open Cash App</a>
                </div>
                <div class="dn-method">
                    <h2>PayPal</h2>
                    <p>Send a donation with PayPal.</p>
                    <div class="dn-handle"><span>@xXDeath420Xx</span><button type="button" class="btn btn-secondary btn-sm" data-copy="xXDeath420Xx">Copy</button></div>
                    <a href="https://paypal.me/xXDeath420Xx" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open PayPal</a>
                </div>
            </div>
        </section>

        <section class="cfs-section" aria-labelledby="dn-uses-h">
            <h2 id="dn-uses-h">What donations pay for</h2>
            <div class="dn-uses">
                <div class="cfs-tile"><h3>Servers</h3><p>Hosting, bandwidth and the database.</p></div>
                <div class="cfs-tile"><h3>Development</h3><p>New features, fixes and improvements.</p></div>
                <div class="cfs-tile"><h3>APIs</h3><p>Google Gemini and the other paid services the AI features use.</p></div>
            </div>
            <p class="cfs-meta">Donations are voluntary and do not unlock anything: every feature stays free for every server. See section 9 of the <a href="/terms#pricing-and-donations">Terms of Service</a>.</p>
        </section>
    </main>
<%- include('partials/site-footer') %>
<script>
(function () {
    document.querySelectorAll('[data-copy]').forEach(function (b) {
        b.addEventListener('click', function () {
            var text = b.getAttribute('data-copy');
            var done = function () { var t = b.textContent; b.textContent = 'Copied'; setTimeout(function () { b.textContent = t; }, 1500); };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () {});
        });
    });
})();
</script>
</body>
</html>
