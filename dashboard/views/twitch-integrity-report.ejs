<!DOCTYPE html>
<html lang="en"<%- printMode ? ' class="print"' : ` data-theme="${String(locals.uiTheme || 'dark').replace(/[^a-z-]/g, '')}" data-density="${String(locals.uiDensity || 'comfortable').replace(/[^a-z-]/g, '')}" data-style="${String(locals.uiStyle || 'cards').replace(/[^a-z-]/g, '')}"` %>>
<head>
<% if (printMode) { %>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= login %> — Channel audit | CertiFried</title>
<% } %>
<%
    const r = report;
    const fmt = (n) => Number(n || 0).toLocaleString('en-US');
    const pct = (x) => `${Math.round((Number(x) || 0) * 100)}%`;
    const zone = (typeof tz === 'string' && tz) ? tz : 'UTC';
    const abbr = (d) => new Intl.DateTimeFormat('en-US', { timeZone: zone, timeZoneName: 'short' }).formatToParts(new Date(d)).find(p => p.type === 'timeZoneName')?.value || zone;
    const day = (d) => d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: zone }) : '—';
    const time = (d) => d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: zone, hourCycle: 'h23' }) + ' ' + abbr(d) : '—';
    const stampFmt = new Intl.DateTimeFormat('sv-SE', { timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const covDays = r.window.days;

    // Viewer chart: downsample to <= 600 points, mark unexplained jumps.
    const series = r.jumps.series;
    const step = Math.max(1, Math.ceil(series.length / 600));
    const pts = series.filter((_, i) => i % step === 0);
    const W = 760, H = 170, P = 28;
    const maxV = Math.max(1, ...pts.map(p => p.v));
    const minM = pts.length ? pts[0].m : 0, maxM = pts.length ? pts[pts.length - 1].m : 1;
    const x = (m) => P + ((m - minM) / Math.max(1, maxM - minM)) * (W - 2 * P);
    const y = (v) => H - P - (v / maxV) * (H - 2 * P);
    // Break the line across gaps (offline time) longer than 10 minutes.
    let path = '';
    pts.forEach((p, i) => { path += (i === 0 || p.m - pts[i - 1].m > 10 ? 'M' : 'L') + x(p.m).toFixed(1) + ' ' + y(p.v).toFixed(1) + ' '; });
    const vl = r.viewerLink;
    let listedPath = '';
    vl.track.forEach((p, i) => { if (p.m >= minM && p.m <= maxM) listedPath += (!listedPath || p.m - vl.track[i - 1].m > 10 ? 'M' : 'L') + x(p.m).toFixed(1) + ' ' + y(p.listed).toFixed(1) + ' '; });
    const atMin = (m) => new Date(m * 60000);
%>
<style>
    /* On screen the palette follows the site theme (cf-ui.css tokens); html.print below is the fixed PDF/PNG palette. */
    :root { --bg: var(--cf-bg); --ink: var(--cf-text); --muted: var(--cf-text-3); --line: var(--cf-border); --soft: var(--cf-surface);
            --note-ink: var(--cf-text-2); --accent: var(--cf-accent-fg); --good: var(--cf-success); --warn: var(--cf-warning); --bad: var(--cf-danger);
            --tag-met: color-mix(in srgb, var(--cf-danger) 14%, transparent); --tag-notmet: color-mix(in srgb, var(--cf-success) 14%, transparent); --tag-na: var(--cf-surface-2);
            --tag-warn: color-mix(in srgb, var(--cf-warning) 14%, transparent); --hl: color-mix(in srgb, var(--cf-danger) 7%, transparent); }
    html.print { --bg: #fff; --ink: #111827; --muted: #6b7280; --line: #e5e7eb; --soft: #f9fafb;
            --note-ink: #374151; --accent: #6d28d9; --good: #15803d; --warn: #b45309; --bad: #b91c1c;
            --tag-met: #fee2e2; --tag-notmet: #dcfce7; --tag-na: #f3f4f6; --tag-warn: #fef3c7; --hl: #fef2f2; color-scheme: light; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 13px/1.5 -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    .page { max-width: 820px; margin: 0 auto; padding: 32px 24px 48px; }
    h1 { font-size: 22px; margin: 0; }
    h2 { font-size: 15px; margin: 28px 0 8px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
    .muted { color: var(--muted); }
    .meta { color: var(--muted); font-size: 12px; margin-top: 4px; }
    .toolbar { display: flex; gap: 8px; margin: 16px 0 0; flex-wrap: wrap; }
    .toolbar a { padding: 6px 12px; border: 1px solid var(--line); border-radius: 6px; text-decoration: none; color: var(--ink); font-size: 12px; background: var(--soft); }
    .toolbar a:hover { background: var(--soft); }
    .verdict { margin-top: 20px; border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; }
    .verdict .label { font-size: 20px; font-weight: 600; }
    .verdict + .verdict { margin-top: 12px; }
    .verdict.none .label { color: var(--good); } .verdict.some .label { color: var(--warn); } .verdict.strong .label { color: var(--bad); } .verdict.na .label { color: var(--muted); }
    .verdict .rule { color: var(--muted); font-size: 12px; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { text-align: left; vertical-align: top; padding: 7px 8px; border-bottom: 1px solid var(--line); }
    th { font-size: 11px; color: var(--muted); font-weight: 500; }
    .tag { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap; }
    .tag.met { background: var(--tag-met); color: var(--bad); } .tag.notmet { background: var(--tag-notmet); color: var(--good); } .tag.na { background: var(--tag-na); color: var(--muted); }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 8px; }
    .stat { background: var(--soft); border-radius: 8px; padding: 10px 12px; }
    .stat .k { color: var(--muted); font-size: 11px; } .stat .v { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .small { font-size: 11px; } .logins { color: var(--muted); font-size: 11px; word-break: break-word; }
    .note { background: var(--soft); border-radius: 8px; padding: 10px 12px; font-size: 12px; color: var(--note-ink); margin-top: 8px; }
    svg { width: 100%; height: auto; display: block; margin-top: 8px; }
    .alert-msgs { margin-top: 6px; font-size: 12px; } .alert-msgs summary { cursor: pointer; color: var(--muted); }
    .alert-msgs ul { list-style: none; margin: 6px 0 0; word-break: break-word; }
    .alert-actions { display: flex; gap: 6px; margin-top: 6px; }
    .alert-actions button { background: var(--soft); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px; font-size: 11px; cursor: pointer; }
    ul { margin: 6px 0 0 18px; padding: 0; } li { margin: 3px 0; }
    svg .axis { stroke: var(--line); } svg .lbl { fill: var(--muted); } svg .line { stroke: var(--accent); } svg .jump { stroke: var(--bad); }
    table.accts td, table.accts th { padding: 4px 6px; font-size: 11.5px; }
    .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .prof { font-size: 10.5px; color: var(--muted); margin-top: 1px; white-space: nowrap; }
    .tag.warn { background: var(--tag-warn); color: var(--warn); }
    .chips { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 3px; }
    .chips .tag { font-size: 10px; font-weight: 500; padding: 0 6px; }
    .chips .tag.listed { font-weight: 700; }
    table.accts tr.listed td { background: var(--hl); }
    table.accts tr.main td { border-bottom: 0; padding-bottom: 0; }
    table.accts tr.chiprow td { padding-top: 0; padding-bottom: 6px; }
    table.accts tr.chiprow .chips { margin-top: 2px; }
    html.print table.accts tr.main { break-after: avoid; }
    table.accts tr.listed td:first-child { box-shadow: inset 3px 0 0 var(--bad); }
    .findings { margin: 8px 0 0; padding: 0; list-style: none; counter-reset: f; }
    .findings li { counter-increment: f; position: relative; padding: 8px 10px 8px 34px; margin: 0; border-bottom: 1px solid var(--line); }
    .findings li::before { content: counter(f); position: absolute; left: 8px; top: 8px; width: 18px; height: 18px; border-radius: 50%;
            font-size: 10.5px; font-weight: 700; text-align: center; line-height: 18px; background: var(--tag-met); color: var(--bad); }
    .findings.ok li::before { content: "✓"; background: var(--tag-notmet); color: var(--good); }
    .findings.ctx li::before { content: "i"; background: var(--tag-na); color: var(--muted); }
    .findings .what { font-weight: 600; } .findings .ev { color: var(--muted); font-size: 12px; margin-top: 2px; }
    .findings a { color: var(--accent); font-size: 11px; text-decoration: none; margin-left: 4px; }
    .filters { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0 0; }
    .filters button { font: inherit; font-size: 11.5px; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; }
    .filters button.on { border-color: var(--accent); color: var(--accent); }
    .legend { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px 16px; margin-top: 8px; font-size: 11.5px; }
    .legend .tag { font-size: 10px; font-weight: 500; padding: 0 6px; margin-right: 4px; }
    html.print .filters { display: none; }
    a.acct { color: var(--ink); text-decoration: none; border-bottom: 1px dotted var(--muted); }
    .meta a { color: var(--accent); }
    html.print .appendix { break-before: page; } html.print table.accts tr { break-inside: avoid; }
    @media print { .appendix { break-before: page; } table.accts tr { break-inside: avoid; } :root { --bg: #fff; --ink: #111827; --muted: #6b7280; --line: #e5e7eb; --soft: #f9fafb;
            --note-ink: #374151; --accent: #6d28d9; --good: #15803d; --warn: #b45309; --bad: #b91c1c;
            --tag-met: #fee2e2; --tag-notmet: #dcfce7; --tag-na: #f3f4f6; --tag-warn: #fef3c7; --hl: #fef2f2; } .toolbar, .filters { display: none; } .page { padding-top: 0; } h2 { break-after: avoid; } table, .verdict { break-inside: avoid; } }
    @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
<% if (!printMode) { %><%- include('partials/site-head', { title: login + ' — Channel audit | CertiFried' }) %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/cf-settings.css">
    <link rel="stylesheet" href="/css/cf-analytics.css">
    <style>html:not(.print) .page { max-width: 1000px; font-size: 13px; line-height: 1.5; } html:not(.print) .page > .cf-an-nav { margin-bottom: 20px; }
        @media (max-width: 760px) { html:not(.print) table.accts, html:not(.print) .page table { display: block; overflow-x: auto; max-width: 100%; }
            html:not(.print) .legend { grid-template-columns: minmax(0, 1fr); } html:not(.print) .page { padding: 16px 16px 40px; } }
        /* Screen only: small status text on its own tint uses the -ink tokens (darker on Light/Sand, same as now on dark). */
        @media screen {
            html:not(.print) .tag.met, html:not(.print) .findings li::before { color: var(--cf-danger-ink); }
            html:not(.print) .tag.notmet, html:not(.print) .findings.ok li::before { color: var(--cf-success-ink); }
            html:not(.print) .tag.warn { color: var(--cf-warning-ink); }
            html:not(.print) .findings.ctx li::before { color: var(--muted); }
        }</style><% } %>
</head>
<body<%- printMode ? '' : ' class="cf-an-body"' %>>
<% if (!printMode) { %><%- include('partials/site-header') %><% } %>
<div class="page" id="main-content">
<% if (!printMode) { %><%- include('partials/analytics/twitch-nav', { active: 'integrity' }) %><% } %>
    <h1>Channel audit — <%= login %></h1>
    <div class="meta">Covers <%= day(r.window.from) %> to <%= day(r.window.to) %> (<%= covDays %> day<%= covDays === 1 ? '' : 's' %><%= r.window.cut ? ', since CertiFried started collecting for this channel' : '' %>) · generated <%= time(r.generatedAt) %> · times in <%= zone %></div>
    <div class="meta"><%= r.window.cut ? 'Viewer counts' : 'First viewer count in this period' %> from <%= day(r.coverage.firstSnapshot) %><%= r.coverage.firstChatterList ? `; chat lists from ${day(r.coverage.firstChatterList)}, ${fmt(r.coverage.chatterListMinutes)} minutes in all` : '; no chat lists' %><%= r.chat.firstMessageAt ? `; chat messages from ${day(r.chat.firstMessageAt)}` : '' %>.<%= r.window.cut ? ' Nothing before those dates is known to this report.' : '' %></div>

    <% if (!printMode) { %>
    <div class="toolbar">
        <a href="<%= base %>.pdf?days=<%= r.days %>">Download PDF</a>
        <a href="<%= base %>.png?days=<%= r.days %>">Download image</a>
        <% if ((r.accounts || []).length) { %><a href="<%= base %>.csv?days=<%= r.days %>">Account list (CSV)</a><% } %>
        <% if (r.audience.listed) { %><a href="<%= base %>/known-bots?days=<%= r.days %>">Known-bot accounts</a><% } %>
        <% const spans = [7, 30, 90], whole = spans.find(d => d >= covDays) || 90;
           spans.filter(d => d <= whole).forEach(d => { %><a href="<%= base %>?days=<%= d %>"<%- d === r.days || (d === whole && r.days > whole) ? ' style="border-color: var(--accent); color: var(--accent);"' : '' %>><%= d === whole && r.window.cut ? `All data (${covDays} day${covDays === 1 ? '' : 's'})` : `${d} days` %></a><% }) %>
        <a href="/manage/<%= guildId %>/twitch-analytics#tab=operations">Back to analytics</a>
    </div>
    <% } %>

    <%
        // Audit findings: everything measured as out of place, then context, then what was checked and found in order.
        const fc = r.flagCounts || {};
        const ind = Object.fromEntries([...r.verdicts.viewers.indicators, ...r.verdicts.chat.indicators].map(i => [i.id, i]));
        const kn = r.known, ag = r.ages, pr = r.presence, kp = kn && kn.profile;
        const out = [], ctx = [], ok = [];
        const pctOf = (n, d) => d ? Math.round(n / d * 100) + '%' : '—';
        const plural = (n, one, many) => `${fmt(n)} ${n === 1 ? one : (many || one + 's')}`;
        if (kn && kn.listed) {
            out.push({ what: `${fmt(kn.listed)} of ${fmt(kn.checked)} silent accounts are on CommanderRoot's known-bot list (${pct(kn.share)})`,
                       ev: `${kn.batchSize ? `${fmt(kn.batchListed)} of the ${fmt(kn.batchSize)} bulk-created accounts are among them. ` : ''}${ind.D.met ? 'Indicator D met.' : 'Below the indicator D threshold.'}`, href: '#sec-known' });
        } else if (kn && ind.D.met === false) {
            ok.push({ what: "No silent accounts are on CommanderRoot's known-bot list", ev: `${fmt(kn.checked)} checked.`, href: '#sec-known' });
        }
        if (ind.B.met) {
            out.push({ what: `${fmt(ag.silentCluster.count)} silent accounts were created within ${r.thresholds.creationClusterDays} days of each other (${pct(ag.silentClusterShare)} of those checked)`,
                       ev: `Created ${day(ag.silentCluster.from)} to ${day(ag.silentCluster.to)}. Among accounts that did chat, the largest ${r.thresholds.creationClusterDays}-day batch is ${pct(ag.chatterClusterShare)}. Indicator B met.`, href: '#sec-ages' });
        } else if (ind.B.met === false) {
            ok.push({ what: 'Account creation dates are spread out', ev: `Largest ${r.thresholds.creationClusterDays}-day batch: ${fmt(ag.silentCluster.count)} accounts (${pct(ag.silentClusterShare)}).`, href: '#sec-ages' });
        }
        if (ind.A.met) {
            out.push({ what: `${plural(pr.cohorts.length, 'group')} of silent accounts joined and left chat together`, ev: `Largest group: ${fmt(pr.cohorts[0].size)} accounts. Indicator A met.`, href: '#sec-chat' });
        } else if (ind.A.met === false) {
            ok.push({ what: `No group of ${r.thresholds.cohortMinSize}+ silent accounts joined and left chat together`, ev: 'Arrivals and departures look independent.', href: '#sec-chat' });
        }
        const blocks = r.jumps.list.filter(j => j.departure).length, loose = r.jumps.list.length - blocks;
        if (ind.E.met) {
            const firstMove = vl.moves[0];
            out.unshift({ what: `The viewer count moves with the listed accounts: ${plural(vl.moves.length, 'block move')} with viewers following`,
                          ev: `Correlation ${vl.rListed.toFixed(2)} against ${vl.rOther === null ? 'none' : vl.rOther.toFixed(2)} for everyone else in chat. ${time(atMin(firstMove.m))}: ${fmt(firstMove.accounts)} listed accounts ${firstMove.direction}, viewers ${fmt(firstMove.viewersFrom)} to ${fmt(firstMove.viewersTo)}. Indicator E met.`, href: '#sec-link' });
        } else if (ind.E.met === false) {
            ok.push({ what: 'The viewer count does not move with listed accounts', ev: `${fmt(vl.minutes)} minutes compared.`, href: '#sec-link' });
        }
        if (ind.C.met) {
            out.push({ what: `Viewers arrived and later left as a block ${plural(blocks, 'time')}`, ev: 'Indicator C met.', href: '#sec-viewers' });
        } else if (ind.C.met === false) {
            (ind.E.met ? ctx : ok).push({ what: 'No viewer rise was followed by a block departure (indicator C)', ev: `${plural(r.jumps.explained, 'rise')} explained by raids or shoutouts. This check skips the first ${r.thresholds.jumpIgnoreStartMinutes} minutes of a stream, so it cannot see accounts that arrive as a stream starts.`, href: '#sec-viewers' });
        }
        if (vl.dips.length) ctx.push({ what: `${plural(vl.dips.length, 'mid-stream viewer drop')} that came back`, ev: 'The viewer count fell sharply and returned within 30 minutes. Listed under Viewers and listed accounts.', href: '#sec-link' });
        if (kp && kp.listed) {
            const pc = kp.compare || {};
            out.push({ what: `The listed accounts have empty profiles: ${pctOf(kp.noBio, kp.listed)} no bio, ${pctOf(kp.neverStreamed, kp.streamChecked)} no stream history, ${pctOf(kp.defaultAvatar, kp.listed)} default picture`,
                       ev: pc.count ? `Silent accounts not on the list: ${pctOf(pc.noBio, pc.count)} no bio, ${pctOf(pc.neverStreamed, pc.count)} no stream history, ${pctOf(pc.defaultAvatar, pc.count)} default picture. Context, not counted toward a verdict.` : 'Context, not counted toward a verdict.', href: '#sec-known' });
        }
        if (fc.new) out.push({ what: `${plural(fc.new, 'silent account')} ${fc.new === 1 ? 'was' : 'were'} created less than 30 days before we first saw ${fc.new === 1 ? 'it' : 'them'} in chat`, ev: 'Flagged "Created … before we first saw it" in the account list.', href: '#sec-accounts' });
        if (fc.removed) out.push({ what: `${plural(fc.removed, 'silent account')} no longer ${fc.removed === 1 ? 'exists' : 'exist'} on Twitch`, ev: 'Suspended or deleted after appearing here; Twitch does not say which.', href: '#sec-accounts' });
        const anCount = (r.anomalies.alerts || []).length;
        if (anCount) out.push({ what: `${plural(anCount, 'anomaly alert')} in this window`, ev: 'Listed under Detected anomalies.', href: '#sec-anomalies' });
        else ok.push({ what: 'No anomaly alerts in this window', ev: `${plural(r.anomalies.excludedFalsePositives, 'false positive')} excluded.`, href: '#sec-anomalies' });

        if (fc.silent) ctx.push({ what: `${plural(fc.silent, 'account')} sat in chat ${r.thresholds.silentMinMinutes}+ minutes in one stretch without sending a message`, ev: 'Lurking is normal. These are the accounts every check above looks at.', href: '#sec-accounts' });
        if (loose) ctx.push({ what: `${plural(loose, 'unexplained viewer rise')} with no matching departure`, ev: 'Shared links, front-page features and embeds look the same, so these do not count.', href: '#sec-viewers' });
        if (ag && ag.clusterSeenElsewhere) ctx.push({ what: `${fmt(ag.clusterSeenElsewhere)} of the bulk-created accounts also sit in other channels we track`, ev: 'Points to a lurker network that idles across channels rather than one aimed at this channel.', href: '#sec-ages' });
        if (r.chatList.minutes && r.chatList.listed > r.chatList.viewers) ctx.push({ what: `Chat holds more logged-in accounts (${fmt(Math.round(r.chatList.listed))} on average) than the viewer count (${fmt(Math.round(r.chatList.viewers))})`, ev: 'Accounts idling in chat are not necessarily counted as viewers.', href: '#sec-viewers' });
        if (r.chat.copyPasteBursts && r.chat.copyPasteBursts.length) ctx.push({ what: `${plural(r.chat.copyPasteBursts.length, 'copy-paste burst')} in chat`, ev: 'Often emote chains or hype; listed under Chat legitimacy.', href: '#sec-legit' });
        [...r.verdicts.viewers.indicators, ...r.verdicts.chat.indicators].filter(i => i.met === null).forEach(i => ctx.push({ what: `Indicator ${i.id} (${i.name.toLowerCase()}) could not be assessed`, ev: i.missing || '', href: null }));
        const flist = (items, cls) => items.map(f => `<li><div class="what">${f.what}${f.href && !printMode ? ` <a href="${f.href}">details</a>` : ''}</div>${f.ev ? `<div class="ev">${f.ev}</div>` : ''}</li>`).join('');
    %>
    <h2>Audit findings</h2>
    <div class="small muted">"Silent accounts" means logged-in accounts that sat in chat <%= r.thresholds.silentMinMinutes %>+ minutes in one stretch without sending a message. Each finding is a measurement; the verdicts below say which ones count.</div>
    <% if (out.length) { %>
    <div class="small" style="margin-top: 10px;"><strong>Out of place (<%= out.length %>)</strong></div>
    <ol class="findings"><%- flist(out) %></ol>
    <% } %>
    <% if (ctx.length) { %>
    <div class="small" style="margin-top: 10px;"><strong>Context (<%= ctx.length %>)</strong></div>
    <ul class="findings ctx"><%- flist(ctx) %></ul>
    <% } %>
    <% if (ok.length) { %>
    <div class="small" style="margin-top: 10px;"><strong>Checked and in order (<%= ok.length %>)</strong></div>
    <ul class="findings ok"><%- flist(ok) %></ul>
    <% } %>

    <% [['Viewer count (viewbotting)', r.verdicts.viewers], ['Accounts in chat', r.verdicts.chat]].forEach(([title, v], idx) => { %>
    <div class="verdict <%= v.level %>">
        <div class="muted small"><%= title %></div>
        <div class="label"><%= v.label %></div>
        <div class="rule"><%= v.met %> of <%= v.assessed %> assessed indicator<%= v.assessed === 1 ? '' : 's' %> met<%= v.assessed < v.total ? ` (${v.total - v.assessed} could not be assessed)` : '' %>. <%= v.rule %></div>
        <table>
            <tr><th style="width: 34px;"></th><th>Indicator</th><th style="width: 92px;">Result</th><th>Measured</th></tr>
            <% v.indicators.forEach(i => { %>
            <tr>
                <td><strong><%= i.id %></strong></td>
                <td><strong><%= i.name %></strong><div class="small muted">Threshold: <%= i.threshold %>.</div><div class="small muted"><%= i.why %></div></td>
                <td><span class="tag <%= i.met === null ? 'na' : i.met ? 'met' : 'notmet' %>"><%= i.met === null ? 'Not assessed' : i.met ? 'Met' : 'Not met' %></span></td>
                <td><%= i.value %><% if (i.missing) { %><div class="small muted"><%= i.missing %></div><% } %></td>
            </tr>
            <% }) %>
        </table>
        <% if (idx === 0 && r.chatList.minutes) { %>
        <div class="small muted" style="margin-top: 6px;">Context: across <%= fmt(r.chatList.minutes) %> live minutes with a chatter list, chat held <%= fmt(Math.round(r.chatList.listed)) %> logged-in accounts on average against <%= fmt(Math.round(r.chatList.viewers)) %> viewers.<%= r.chatList.listed > r.chatList.viewers ? ' Chat can hold accounts that are not watching, so these two numbers cannot be subtracted from each other.' : '' %></div>
        <% } %>
    </div>
    <% }) %>

    <h2 id="sec-viewers">Viewers</h2>
    <div class="grid">
        <div class="stat"><div class="k">Stream sessions</div><div class="v"><%= fmt(r.stats.sessions) %></div></div>
        <div class="stat"><div class="k">Live time</div><div class="v"><%= fmt(Math.round(r.coverage.liveMinutes / 60)) %>h</div></div>
        <div class="stat"><div class="k">Average viewers</div><div class="v"><%= fmt(Math.round(r.stats.avgViewers)) %></div></div>
        <div class="stat"><div class="k">Peak viewers</div><div class="v"><%= fmt(r.stats.peakViewers) %></div></div>
    </div>
    <% if (pts.length > 1) { %>
    <svg viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Viewer count over live time">
        <line x1="<%= P %>" y1="<%= H - P %>" x2="<%= W - P %>" y2="<%= H - P %>" class="axis"/>
        <text x="<%= P %>" y="<%= P - 10 %>" font-size="10" class="lbl"><%= fmt(maxV) %> viewers</text>
        <path d="<%= path %>" fill="none" class="line" stroke-width="1.4"/>
        <% if (listedPath) { %><path d="<%= listedPath %>" fill="none" stroke="var(--bad)" stroke-width="1.4"/><% } %>
        <% r.jumps.list.forEach(j => { const jm = Math.floor(new Date(j.at).getTime() / 60000); if (jm >= minM && jm <= maxM) { %>
        <circle cx="<%= x(jm).toFixed(1) %>" cy="<%= y(j.after).toFixed(1) %>" r="4" fill="none" class="jump" stroke-width="1.5"/>
        <% } }) %>
        <text x="<%= P %>" y="<%= H - 8 %>" font-size="10" class="lbl"><%= time(new Date(minM * 60000)) %></text>
        <text x="<%= W - P %>" y="<%= H - 8 %>" font-size="10" class="lbl" text-anchor="end"><%= time(new Date(maxM * 60000)) %></text>
    </svg>
    <div class="small muted">Live minutes only; offline gaps are not drawn.<%= listedPath ? ' The red line is listed accounts in chat, drawn where we have chat lists.' : '' %> Red circles mark unexplained rises. Twitch reports viewer counts in batched updates every few minutes, so small steps in the line are normal.</div>
    <% } %>
    <% if (r.jumps.list.length) { %>
    <table>
        <tr><th>Rise at</th><th>Before</th><th>After</th><th>Rise</th><th>Block departure</th></tr>
        <% r.jumps.list.forEach(j => { %>
        <tr><td><%= time(j.at) %></td><td><%= fmt(j.before) %></td><td><%= fmt(j.after) %></td><td>+<%= fmt(j.delta) %> (<%= pct(j.ratio) %>)</td>
            <td><%= j.departure ? `${time(j.departure.at)}: ${fmt(j.departure.from)} → ${fmt(j.departure.to)} after ${fmt(j.departure.afterMinutes)} min` : 'none — counts as context only' %></td></tr>
        <% }) %>
    </table>
    <div class="small muted">Only rises followed by a block departure count toward indicator C. <%= fmt(r.jumps.explained) %> rise<%= r.jumps.explained === 1 ? ' was' : 's were' %> explained by a raid or a received shoutout.</div>
    <% } else { %>
    <div class="note">No unexplained viewer rises. <%= fmt(r.jumps.explained) %> rise<%= r.jumps.explained === 1 ? ' was' : 's were' %> explained by a raid or a received shoutout.</div>
    <% } %>

    <h2 id="sec-link">Viewers and listed accounts</h2>
    <% if (vl.stretches.length) { %>
    <div class="note">Compares the viewer count with accounts on CommanderRoot's known-bot list that were in chat, minute by minute. <%= vl.rListed === null ? 'No listed accounts were in chat.' : `Across ${fmt(vl.minutes)} minutes the correlation with listed accounts is ${vl.rListed.toFixed(2)}${vl.rOther === null ? '' : `, against ${vl.rOther.toFixed(2)} for everyone else in chat`}. 1.00 would mean the two move in perfect step.` %> This does not say each listed account equals one viewer, and it cannot see logged-out viewers.</div>
    <table>
        <tr><th>Chat data from</th><th>Minutes</th><th>Listed accounts in chat</th><th>Average viewers</th><th>Average others in chat</th></tr>
        <% vl.stretches.forEach(s => { %>
        <tr><td><%= time(atMin(s.fromM)) %></td><td class="num"><%= fmt(s.minutes) %></td><td><%= fmt(s.commonListed) %> for <%= fmt(s.commonMinutes) %> of <%= fmt(s.minutes) %> minutes</td><td class="num"><%= fmt(Math.round(s.avgViewers)) %></td><td class="num"><%= fmt(Math.round(s.avgOther)) %></td></tr>
        <% }) %>
    </table>
    <% if (vl.moves.length) { %>
    <div class="small" style="margin-top: 10px;"><strong>Block moves with viewers following</strong></div>
    <table>
        <tr><th>When</th><th>Listed accounts</th><th>Viewers</th><th>Others in chat</th></tr>
        <% vl.moves.forEach(mv => { %>
        <tr><td><%= time(atMin(mv.m)) %></td><td><%= fmt(mv.listedFrom) %> → <%= fmt(mv.listedTo) %></td><td><%= fmt(mv.viewersFrom) %> → <%= fmt(mv.viewersTo) %></td><td><%= fmt(mv.otherFrom) %> → <%= fmt(mv.otherTo) %></td></tr>
        <% }) %>
    </table>
    <% } %>
    <% } else { %>
    <div class="note">Not assessed: there are no live minutes with both a viewer count and a chat list in this window.</div>
    <% } %>
    <% if (vl.dips.length) { %>
    <div class="small" style="margin-top: 10px;"><strong>Mid-stream viewer drops that came back</strong></div>
    <table>
        <tr><th>When</th><th>Before</th><th>Lowest</th><th>Back to</th><th>Back at</th></tr>
        <% vl.dips.forEach(dp => { %>
        <tr><td><%= time(atMin(dp.m)) %></td><td class="num"><%= fmt(dp.from) %></td><td class="num"><%= fmt(dp.low) %></td><td class="num"><%= fmt(dp.backTo) %></td><td><%= time(atMin(dp.backM)) %></td></tr>
        <% }) %>
    </table>
    <div class="small muted">Context only. These come from the viewer count alone, so they also cover nights without chat lists, and a stream or Twitch problem can cause one.</div>
    <% } %>

    <h2 id="sec-chat">Who is in chat</h2>
    <% if (r.presence) { const p = r.presence; %>
    <div class="grid">
        <div class="stat"><div class="k">Accounts seen</div><div class="v"><%= fmt(p.accountsSeen) %></div></div>
        <div class="stat"><div class="k">Stayed <%= r.thresholds.silentMinMinutes %>+ min</div><div class="v"><%= fmt(p.longPresent) %></div></div>
        <div class="stat"><div class="k">…and never chatted</div><div class="v"><%= fmt(p.silentLongPresent) %></div></div>
        <div class="stat"><div class="k">Synchronized groups</div><div class="v"><%= fmt(p.cohorts.length) %></div></div>
    </div>
    <div class="note">Lurking is normal: most viewers never chat. Silent accounts alone are not evidence. Indicator A counts only groups that arrive and leave together. The chatter list shows logged-in accounts only; logged-out viewers count toward viewers but never appear here. Per-minute chatter lists cover <%= fmt(r.coverage.chatterListMinutes) %> minutes of this window, starting <%= day(r.coverage.firstChatterList) %>. <%= p.messagesFrom ? `Silent means no messages since ${day(p.messagesFrom)}, when we started saving chat messages; time in chat before that is not counted, because we cannot know who chatted then.` : 'No chat messages were saved in this window, so no account is counted as silent.' %></div>
    <% if (p.cohorts.length) { %>
    <table>
        <tr><th>Joined</th><th>Left</th><th>Stayed</th><th>Accounts</th></tr>
        <% p.cohorts.slice(0, 10).forEach(c => { %>
        <tr><td><%= time(c.joinedAt) %></td><td><%= time(c.leftAt) %></td><td><%= fmt(c.minutes) %> min</td>
            <td><strong><%= fmt(c.size) %></strong><div class="logins"><%= c.logins.slice(0, 20).join(', ') %><%= c.logins.length > 20 ? ` and ${c.logins.length - 20} more` : '' %></div></td></tr>
        <% }) %>
    </table>
    <% } %>
    <% } else { %>
    <div class="note">Not assessed: there are no per-minute chatter lists for this channel in the window.</div>
    <% } %>

    <% if (r.known && r.known.profile && r.known.profile.listed) { const kp = r.known.profile; %>
    <h2 id="sec-known">Known-bot accounts</h2>
    <div class="grid">
        <div class="stat"><div class="k">On the list</div><div class="v"><%= fmt(kp.listed) %></div></div>
        <div class="stat"><div class="k">Removed by Twitch since flagged</div><div class="v"><%= fmt(kp.removedSinceListed) %></div></div>
        <div class="stat"><div class="k">No stream history found</div><div class="v"><%= fmt(kp.neverStreamed) %><span class="small muted"> / <%= fmt(kp.streamChecked) %> checked</span></div></div>
        <div class="stat"><div class="k">No bio · default avatar</div><div class="v"><%= fmt(kp.noBio) %> · <%= fmt(kp.defaultAvatar) %></div></div>
    </div>
    <% const pc = kp.compare || {}; const pctOf = (n, d) => d ? Math.round(n / d * 100) + '%' : '—'; %>
    <table>
        <tr><th></th><th>Accounts</th><th>No bio</th><th>No stream history</th><th>Default avatar</th></tr>
        <tr><td>Silent accounts on the list</td><td class="num"><%= fmt(kp.listed) %></td><td class="num"><%= pctOf(kp.noBio, kp.listed) %></td><td class="num"><%= pctOf(kp.neverStreamed, kp.streamChecked) %></td><td class="num"><%= pctOf(kp.defaultAvatar, kp.listed) %></td></tr>
        <% if (pc.count) { %><tr><td>Silent accounts not on the list</td><td class="num"><%= fmt(pc.count) %></td><td class="num"><%= pctOf(pc.noBio, pc.count) %></td><td class="num"><%= pctOf(pc.neverStreamed, pc.count) %></td><td class="num"><%= pctOf(pc.defaultAvatar, pc.count) %></td></tr><% } %>
    </table>
    <% if (r.audience.seen) { const au = r.audience; %>
    <div class="note">Across everyone seen in this channel, by chat lists or by messages: <%= fmt(au.listed) %> of <%= fmt(au.seen) %> accounts are on the list<%= au.checked < au.seen ? ` (${fmt(au.seen - au.checked)} not checked)` : '' %>. <%= fmt(au.chatted) %> accounts have sent messages, service bots included, and <%= fmt(au.listedChatted) %> of those <%= au.listedChatted === 1 ? 'is' : 'are' %> on the list.</div>
    <% } %>
    <% if (!printMode) { %><div class="meta"><a href="<%= base %>/known-bots?days=<%= r.days %>">See every listed account by creation date, with lookup and report links</a></div><% } %>
    <div class="note">Public profile facts for the silent accounts on CommanderRoot's list, rechecked weekly. "Removed" means Twitch no longer returns the account (suspended or deleted; Twitch does not say which) after we flagged it.
        These are context and do not count toward a verdict: many real lurkers never stream or write a bio. Twitch does not expose last login, watch history or follows for other people's accounts.</div>
    <% } %>

    <h2 id="sec-ages">Account ages</h2>
    <% if (r.ages) { const a = r.ages; %>
    <div class="grid">
        <div class="stat"><div class="k">Silent accounts checked</div><div class="v"><%= fmt(a.silentLookedUp) %></div></div>
        <div class="stat"><div class="k">Largest <%= r.thresholds.creationClusterDays %>-day batch</div><div class="v"><%= fmt(a.silentCluster.count) %> (<%= pct(a.silentClusterShare) %>)</div></div>
        <div class="stat"><div class="k">Created in last 30 days</div><div class="v"><%= fmt(a.silentUnder30d) %></div></div>
        <div class="stat"><div class="k">No longer on Twitch</div><div class="v"><%= fmt(a.silentGone) %></div></div>
    </div>
    <div class="note">
        <% if (a.silentCluster.count) { %>The largest batch of silent accounts was created between <%= day(a.silentCluster.from) %> and <%= day(a.silentCluster.to) %>. <% } %>
        For comparison, among <%= fmt(a.chatterLookedUp) %> accounts that did chat, the largest <%= r.thresholds.creationClusterDays %>-day batch is <%= pct(a.chatterClusterShare) %>.
        <% if (a.otherChannelsTracked) { %><%= fmt(a.clusterSeenElsewhere) %> of the batch also appear in the <%= fmt(a.otherChannelsTracked) %> other channel<%= a.otherChannelsTracked === 1 ? '' : 's' %> we track chat lists for<%= a.clusterSeenElsewhere ? ', which points to a lurker network that idles across many channels rather than one aimed at this channel' : '' %>.<% } %>
        Automated accounts in chat do not, by themselves, mean the viewer count is inflated: see the viewer assessment above.
        Accounts "no longer on Twitch" were deleted or suspended after they appeared; Twitch suspends bot accounts in waves, but this is shown for context and is not part of the verdict.
    </div>
    <% } else { %>
    <div class="note">Not assessed: <%= r.presence ? 'no silent long-present accounts to check.' : 'no per-minute chatter lists in this window.' %></div>
    <% } %>

    <h2 id="sec-legit">Chat legitimacy</h2>
    <% const c = r.chat; %>
    <% if (r.coverage.chatSampling && c.messages) { %>
    <div class="grid">
        <div class="stat"><div class="k">Messages</div><div class="v"><%= fmt(c.messages) %></div></div>
        <div class="stat"><div class="k">From service bots</div><div class="v"><%= fmt(c.botMessages) %></div></div>
        <div class="stat"><div class="k">People who chatted</div><div class="v"><%= fmt(c.chatters) %></div></div>
        <div class="stat"><div class="k">Top 5 chatters' share</div><div class="v"><%= pct(c.topFiveShare) %></div></div>
    </div>
    <div class="note">Sampled chat covers <%= day(c.firstMessageAt) %> onward. Service bots are channel tools like Nightbot and StreamElements, not the known-bot list. <%= fmt(c.oneMessageChatters) %> people sent exactly one message. <%= fmt(c.linkMessages) %> non-bot messages contained a link.
        <% if (c.copyPasteBursts.length) { %><%= fmt(c.copyPasteBursts.length) %> copy-paste burst<%= c.copyPasteBursts.length === 1 ? '' : 's' %> (the same text from 3+ accounts within 2 minutes), listed below. These are often emote chains or hype messages, so they are context, not part of the verdict.<% } else { %>No copy-paste bursts (the same text from 3+ accounts within 2 minutes).<% } %></div>
    <% if (c.copyPasteBursts.length) { %>
    <table>
        <tr><th>When</th><th>Text</th><th>Accounts</th></tr>
        <% c.copyPasteBursts.forEach(b => { %><tr><td><%= time(b.at) %></td><td><%= b.text %></td><td><%= fmt(b.accounts) %></td></tr><% }) %>
    </table>
    <% } %>
    <% } else { %>
    <div class="note">Not assessed: chat message sampling is <%= r.coverage.chatSampling ? 'on but recorded no messages in this window' : 'switched off for this channel (Admin → Chat sampling)' %>.</div>
    <% } %>

    <h2 id="sec-anomalies">Detected anomalies</h2>
    <% const an = r.anomalies; %>
    <% if (an.alerts.length) { %>
    <table>
        <tr><th>When</th><th>Type</th><th>Severity</th><th>Status</th><th>Evidence</th></tr>
        <% an.alerts.slice(0, 25).forEach(al => { %>
        <tr><td><%= time(al.at) %></td><td><%= String(al.type).replace(/_/g, ' ') %></td><td><%= al.severity %></td><td><%= al.status %></td>
            <td><%= al.interpretation || '—' %><% if (al.note) { %><div class="small muted"><%= al.note %></div><% } %>
                <% if (al.legacyCount) { %><div class="small muted">Counted by an earlier version of this detector, which could count one person more than once.</div><% } %>
                <% if (!printMode && al.target) { const msgs = (locals.alertMessages || {})[al.id] || []; %>
                <details class="alert-msgs">
                    <summary>Chat around this alert (<%= msgs.length %>)</summary>
                    <% if (msgs.length) { %>
                    <ul><% msgs.forEach(m => { %><li><span class="muted"><%= time(m.at) %></span> <strong><%= m.login %></strong>: <%= m.text %></li><% }) %></ul>
                    <% } else { %>
                    <div class="small muted">No captured messages for this alert. Chat message sampling may have been off.</div>
                    <% } %>
                </details>
                <% } %>
                <% if (!printMode && al.status === 'open') { %>
                <div class="alert-actions">
                    <form method="post" action="/manage/<%= guildId %>/twitch-analytics/anomaly/<%= al.id %>/false-positive?next=integrity&days=<%= days %>"><button type="submit">False alarm</button></form>
                    <form method="post" action="/manage/<%= guildId %>/twitch-analytics/anomaly/<%= al.id %>/resolve?next=integrity&days=<%= days %>"><button type="submit">Real, handled</button></form>
                </div>
                <% } %></td></tr>
        <% }) %>
    </table>
    <% } else { %>
    <div class="note">No anomaly alerts in this window.</div>
    <% } %>
    <div class="small muted" style="margin-top: 6px;"><%= fmt(an.excludedFalsePositives) %> alert<%= an.excludedFalsePositives === 1 ? '' : 's' %> marked as false positives <%= an.excludedFalsePositives === 1 ? 'was' : 'were' %> excluded.</div>

    <h2>Method and limits</h2>
    <ul class="small">
        <li>Every number comes from CertiFried's own records of this channel: per-minute viewer counts and chatter lists, Twitch event notifications, and Twitch's public account data.</li>
        <li>Usernames are never used as evidence, however generated they look.</li>
        <li>Indicators D and E use CommanderRoot's known-bot list (twitch-tools.rootonline.de). Accounts are looked up individually and the result is cached for <%= 7 %> days; they are the only indicators that rely on a third-party classification.</li>
        <li>Logged-out viewers count toward the viewer number but are invisible in chatter lists, so chatter-based measures describe logged-in accounts only.</li>
        <li>Viewer jumps from causes Twitch does not report to us (front-page features, external links, embeds) cannot be told apart from injected viewers; indicator C allows for raids and shoutouts only, and skips the first <%= r.thresholds.jumpIgnoreStartMinutes %> minutes of each stream.</li>
        <li>Twitch gives a viewer total, never a list of viewers, so no account can be proven to be a viewer. Indicator E infers it from the total and the chat list moving together.</li>
        <li>An indicator that could not be assessed is shown as such and does not count toward the verdict.</li>
        <li>This report states measurable indicators, not intent. Third parties can send bot viewers to a channel without the streamer's involvement.</li>
    </ul>

    <% const acc = r.accounts || [];
       const dur = (m) => m >= 60 ? `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, '0')}m` : `${m}m`;
       const stamp = (d) => d ? `${stampFmt.format(new Date(d))} <span class="muted">${abbr(d)}</span>` : '—';
       const edge = (on, sign) => on ? `<span class="muted" title="${sign === '≤' ? 'Our chatter data starts here; the account may have been present earlier' : 'Our chatter data stops here; the account may have stayed later'}">${sign}</span> ` : '';
       const batch = acc.filter(a => a.inBatch);
       // Chip colour per finding: red = list/batch/cohort/removal, amber = empty-profile facts, grey = neutral context.
       const chipCls = { listed: 'met listed', batch: 'met', cohort: 'met', removed: 'met', new: 'warn', neverLive: 'warn', defaultPic: 'warn', noBio: 'warn', silent: 'na', elsewhere: 'na' };
       const chips = (a) => (a.flags || []).length ? `<div class="chips">${a.flags.map(f => `<span class="tag ${chipCls[f.key] || 'na'}">${f.label}${f.key === 'removed' && a.goneAt ? ' ' + stampFmt.format(new Date(a.goneAt)).slice(0, 10) : ''}</span>`).join('')}</div>` : '';
       const profile = (a) => a.streamed !== true ? '' : a.lastVodAt ? `last streamed ${stampFmt.format(new Date(a.lastVodAt)).slice(0, 10)}` : ({ partner: 'Twitch Partner', affiliate: 'Twitch Affiliate', clip: 'has stream clips', highlight: 'has highlights', 'recorded here': 'streamed (recorded here)' })[a.streamEvidence] || 'has streamed';
       const counted = (a) => (a.flags || []).filter(f => f.key !== 'silent' && f.key !== 'elsewhere').length;
       // Two rows per account: the measurements, then its findings across the full width.
       const accRow = (a, i) => { const cls = `${a.onKnownList === true ? 'listed' : ''}`, dl = a.onKnownList === true ? 1 : 0;
           return `<tr class="${cls} main" data-listed="${dl}"><td class="small muted">${i + 1}</td><td><a class="acct" href="https://www.twitch.tv/${a.login}" target="_blank" rel="noopener">${a.login}</a>${profile(a) ? `<div class="prof">${profile(a)}</div>` : ''}</td><td class="num">${stamp(a.created)}</td><td class="num">${dur(a.minutes)}</td><td class="num">${a.streams}</td><td class="num small">${edge(a.firstAtEdge, '≤')}${stamp(a.firstSeen)}</td><td class="num small">${edge(a.lastAtEdge, '≥')}${stamp(a.lastSeen)}</td><td class="num"><strong>${counted(a)}</strong></td></tr>`
                + `<tr class="${cls} chiprow" data-listed="${dl}"><td></td><td colspan="7">${chips(a)}</td></tr>`; };
       const accHead = () => `<tr><th style="width: 30px;">#</th><th>Account and findings</th><th>Created</th><th>In chat</th><th title="Streams of this channel the account sat in">Streams present</th><th>First seen</th><th>Last seen</th><th title="Red and amber findings">Flags</th></tr>`;
       // Main list: listed accounts first, then by number of findings, then oldest-created first.
       const ranked = acc.slice().sort((a, b) => (b.onKnownList === true) - (a.onKnownList === true) || counted(b) - counted(a)
                        || (a.created ? new Date(a.created).getTime() : Infinity) - (b.created ? new Date(b.created).getTime() : Infinity));
       const nListed = acc.filter(a => a.onKnownList === true).length;
       const filterBar = (id) => printMode ? '' : `<div class="filters" data-table="${id}"><button type="button" class="on" data-f="">All</button><button type="button" data-f="1">Found on CommanderRoot's bot list</button><button type="button" data-f="0">Not on the list</button></div>`;
    %>
    <% if (acc.length) { %>
    <div class="appendix" id="sec-accounts">
    <h1 style="margin-top: 36px;">Appendix: account-by-account audit</h1>
    <div class="meta">Every account that sat in chat for <%= r.thresholds.silentMinMinutes %>+ minutes in one stretch without ever sending a message in the window. Service bots such as Nightbot are excluded. Times are in <%= zone %>; "In chat" is total time present across all streams; "Streams present" counts this channel's streams the account sat in.<% if (!printMode) { %> <a href="<%= base %>.csv?days=<%= r.days %>">Download as CSV</a><% } %></div>
    <% const wins = (r.presence && r.presence.captureWindows) || []; if (wins.length) { %>
    <div class="note"><strong>When we have chatter data:</strong> <%= wins.map(w => `${time(w.start)} to ${time(w.end)}`).join(' · ') %>.
        Outside these stretches nobody can be seen in chat, so a first-seen time marked ≤ is only where our data starts (the account may have been there earlier), and a last-seen time marked ≥ is only where it stops. Many accounts sharing those times is expected and is not evidence they arrived or left together.</div>
    <% } %>
    <div class="note">Being on these lists is a measurement, not a finding about any one account. A batch or cohort is suspicious as a group; an individual account in it can still be a real person who lurks.</div>
    <div class="small" style="margin-top: 10px;"><strong>What the flags mean</strong></div>
    <div class="legend">
        <div><span class="tag met listed">Found on CommanderRoot's bot list</span> on the known-bot list (twitch-tools.rootonline.de); row highlighted</div>
        <div><span class="tag met">Created in the bulk batch</span> inside the largest <%= r.thresholds.creationClusterDays %>-day creation cluster (indicator B)</div>
        <div><span class="tag met">Joined and left with cohort N</span> arrived and left in the same minute as <%= r.thresholds.cohortMinSize %>+ others (indicator A)</div>
        <div><span class="tag met">No longer on Twitch</span> suspended or deleted after appearing; date when we noticed</div>
        <div><span class="tag warn">Created … before we first saw it</span> account under 30 days old when it showed up</div>
        <div><span class="tag warn">No stream history found</span> Twitch has no past broadcasts, highlights or clips for the account, and our live check (every 10 minutes) has not seen it live. Twitch does not publish when an account last streamed, and deletes past broadcasts after 7 to 60 days, so this does not prove it never streamed. Not shown for Affiliates, Partners or channels we have recorded live.</div>
        <div><span class="tag warn">Default profile picture</span> never set an avatar</div>
        <div><span class="tag warn">No bio</span> empty profile description</div>
        <div><span class="tag na">0 messages</span> never chatted in this channel in the window</div>
        <div><span class="tag na">Also in N other tracked channels</span> also sat in other channels CertiFried tracks</div>
    </div>
    <div class="small muted" style="margin-top: 4px;">"Flags" counts the red and amber findings. Profile facts (picture, bio, streams) are public Twitch data rechecked weekly; Twitch exposes no last-login, watch or follow history for other people's accounts.</div>

    <% if (batch.length) { %>
    <h2>Indicator B: accounts in the creation batch (<%= fmt(batch.length) %>)</h2>
    <div class="small muted">Created between <%- stamp(r.ages.silentCluster.from) %> and <%- stamp(r.ages.silentCluster.to) %>, sorted by creation time. Accounts created minutes apart are the strongest sign of a batch.</div>
    <%- filterBar('t-batch') %>
    <table class="accts" id="t-batch"><thead><%- accHead() %></thead><tbody><% batch.forEach((a, i) => { %><%- accRow(a, i) %><% }) %></tbody></table>
    <% } %>

    <% if (r.presence && r.presence.cohorts.length) { %>
    <h2>Indicator A: synchronized cohorts (<%= fmt(r.presence.cohorts.length) %>)</h2>
    <% r.presence.cohorts.forEach((c, ci) => { %>
    <div class="small" style="margin-top: 8px;"><strong>Cohort <%= ci + 1 %></strong> · <%= fmt(c.size) %> accounts joined <%= time(c.joinedAt) %>, left <%= time(c.leftAt) %> (<%= dur(c.minutes) %>)</div>
    <div class="logins"><%= c.logins.slice().sort().join(', ') %></div>
    <% }) %>
    <% } %>

    <h2>All silent accounts (<%= fmt(acc.length) %><%= nListed ? `, ${fmt(nListed)} on CommanderRoot's bot list` : '' %>)</h2>
    <div class="small muted">Accounts on CommanderRoot's bot list first, then by number of flags, then by creation date. Accounts beyond the lookup cap or not returned by Twitch show no creation date.</div>
    <%- filterBar('t-all') %>
    <table class="accts" id="t-all"><thead><%- accHead() %></thead><tbody><% ranked.forEach((a, i) => { %><%- accRow(a, i) %><% }) %></tbody></table>
    </div>
    <% } %>
    <% if (!printMode) { %>
    <script>
        document.querySelectorAll('.filters').forEach(function (bar) {
            bar.addEventListener('click', function (e) {
                var b = e.target.closest('button'); if (!b) return;
                bar.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
                var f = b.getAttribute('data-f');
                document.getElementById(bar.getAttribute('data-table')).querySelectorAll('tbody tr').forEach(function (tr) {
                    tr.style.display = !f || tr.getAttribute('data-listed') === f ? '' : 'none';
                });
            });
        });
    </script>
    <% } %>
    <div class="small muted" style="margin-top: 18px;">Generated by CertiFried · broadcaster id <%= r.bid %></div>
</div>
<% if (!printMode) { %><%- include('partials/site-footer') %><% } %>
</body>
</html>
