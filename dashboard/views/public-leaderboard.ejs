<!DOCTYPE html>
<html lang="en" data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>">
<head>
<%
    const _guild = (typeof guild !== 'undefined' && guild) ? guild : null;
    const _users = (typeof users !== 'undefined' && Array.isArray(users)) ? users : [];
    const _pg = (typeof pagination !== 'undefined' && pagination) ? pagination : null;
    const _err = (typeof error !== 'undefined' && error) ? error : null;
    const _title = _guild ? _guild.name + ' leaderboard · CertiFried' : 'Leaderboard not found · CertiFried';
%>
<%- include('partials/site-head', { title: _title, description: _guild ? 'Level and XP leaderboard for the ' + _guild.name + ' Discord server.' : 'Server level leaderboard.', path: _guild ? '/lb/' + _guild.id : null, noindex: !_guild }) %>
    <style>
        .lb-guild { display: flex; align-items: center; gap: var(--cf-4); }
        .lb-guild h1 { margin: 0; }
        .lb-guild .cfs-meta { margin-top: 4px; }
        .lb-who { min-width: 0; }
        .lb .lb-rank-col { width: 56px; }
        .lb-guild img { width: 56px; height: 56px; border-radius: 14px; flex: none; background: var(--cf-surface-2); }
        .lb-table-wrap { position: relative; overflow-x: auto; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .lb { width: 100%; border-collapse: collapse; font-size: var(--cf-text-sm); }
        .lb th { padding: 9px 14px; font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-3); text-align: left; border-bottom: 1px solid var(--cf-border); white-space: nowrap; }
        .lb td { padding: 10px 14px; border-bottom: 1px solid var(--cf-border); vertical-align: middle; }
        .lb tbody tr:last-child td { border-bottom: 0; }
        .lb .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .lb-rank { display: inline-flex; align-items: center; justify-content: center; min-width: 28px; height: 28px; padding: 0 6px; border-radius: 999px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--cf-text-2); background: var(--cf-surface-2); }
        .lb-rank.top { color: var(--cf-on-accent); background: var(--cf-accent); }
        .lb-member { display: flex; align-items: center; gap: var(--cf-3); min-width: 0; }
        .lb-member img { width: 32px; height: 32px; border-radius: 50%; flex: none; }
        .lb-name { display: block; font-weight: 500; color: var(--cf-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 28ch; }
        .lb-handle { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .lb-bar { width: 120px; height: 6px; margin-left: auto; border-radius: 999px; background: var(--cf-surface-3); overflow: hidden; }
        .lb-bar span { display: block; height: 100%; background: var(--cf-accent); }
        .lb-sub { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .lb-pager { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 4px; margin-top: var(--cf-5); }
        .lb-pager a, .lb-pager span { min-width: 40px; height: 40px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--cf-radius); font-size: var(--cf-text-sm); text-decoration: none; color: var(--cf-text-2); border: 1px solid var(--cf-border); background: var(--cf-surface); }
        .lb-pager a:hover { color: var(--cf-text); border-color: var(--cf-border-strong); }
        .lb-pager [aria-current="page"] { color: var(--cf-on-accent); background: var(--cf-accent); border-color: var(--cf-accent); font-weight: 600; }
        .lb-pager .gap { border: 0; background: none; min-width: 0; padding: 0 4px; }
        .lb-count { margin-top: var(--cf-3); text-align: center; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        @media (max-width: 640px) { .lb .hide-sm { display: none; } .lb-name { max-width: 16ch; } .lb td, .lb th { padding-left: 10px; padding-right: 10px; } }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', user: locals.user || null, returnTo: _guild ? '/lb/' + _guild.id : '/' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main">
        <% if (!_guild) { %>
            <div class="cfs-rows"><div class="cfs-empty">
                <h1 class="cfs-h2">Leaderboard not found</h1>
                <p><%= _err || 'This server could not be found.' %></p>
            </div></div>
        <% } else { %>
            <div class="cfs-pagehead">
                <div class="lb-guild">
                    <img src="<%= _guild.icon ? 'https://cdn.discordapp.com/icons/' + _guild.id + '/' + _guild.icon + '.png?size=128' : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" width="56" height="56">
                    <div>
                        <span class="cfs-eyebrow">Level leaderboard</span>
                        <h1><%= _guild.name %></h1>
                        <p class="cfs-meta"><%= Number(_guild.memberCount || 0).toLocaleString('en-US') %> members</p>
                    </div>
                </div>
            </div>

            <% if (_err) { %>
                <div class="cfs-rows"><div class="cfs-empty"><p><%= _err %></p></div></div>
            <% } else if (!_users.length) { %>
                <div class="cfs-rows"><div class="cfs-empty"><h2>No one is ranked yet</h2><p>Members earn XP by chatting in the server.</p></div></div>
            <% } else { %>
                <div class="lb-table-wrap">
                    <table class="lb">
                        <thead>
                            <tr>
                                <th scope="col" class="lb-rank-col">Rank</th>
                                <th scope="col">Member</th>
                                <th scope="col" class="num">Level</th>
                                <th scope="col" class="num hide-sm">Progress to next level</th>
                                <th scope="col" class="num">Total XP</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% _users.forEach(function (u) { %>
                            <tr>
                                <td><span class="lb-rank<%= u.rank <= 3 ? ' top' : '' %>"><%= u.rank %></span></td>
                                <td>
                                    <div class="lb-member">
                                        <img src="<%= u.avatarURL %>" alt="" width="32" height="32" loading="lazy" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                                        <span class="lb-who">
                                            <span class="lb-name"><%= u.displayName %></span>
                                            <% if (u.username && u.username !== u.displayName) { %><span class="lb-handle">@<%= u.username %></span><% } %>
                                        </span>
                                    </div>
                                </td>
                                <td class="num"><%= u.level %></td>
                                <td class="num hide-sm">
                                    <div class="lb-bar" role="img" aria-label="<%= u.xpProgress %>% of the way to level <%= u.level + 1 %>"><span style="width: <%= Math.max(0, Math.min(100, Number(u.xpProgress) || 0)) %>%"></span></div>
                                    <div class="lb-sub"><%= Number(u.xp).toLocaleString('en-US') %> / <%= Number(u.xpForNext).toLocaleString('en-US') %></div>
                                </td>
                                <td class="num"><%= Number(u.totalXP).toLocaleString('en-US') %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <% if (_pg && _pg.totalPages > 1) { const base = '/lb/' + _guild.id + '?page='; %>
                <nav class="lb-pager" aria-label="Pages">
                    <% if (_pg.page > 1) { %><a href="<%= base + (_pg.page - 1) %>" rel="prev">Previous</a><% } %>
                    <% for (let p = 1; p <= _pg.totalPages; p++) { %>
                        <% if (p === _pg.page) { %><span aria-current="page"><%= p %></span>
                        <% } else if (Math.abs(p - _pg.page) <= 2 || p === 1 || p === _pg.totalPages) { %><a href="<%= base + p %>"><%= p %></a>
                        <% } else if (Math.abs(p - _pg.page) === 3) { %><span class="gap" aria-hidden="true">&hellip;</span><% } %>
                    <% } %>
                    <% if (_pg.page < _pg.totalPages) { %><a href="<%= base + (_pg.page + 1) %>" rel="next">Next</a><% } %>
                </nav>
                <% } %>
                <% if (_pg) { %>
                <p class="lb-count">Showing <%= (_pg.page - 1) * _pg.limit + 1 %>&ndash;<%= Math.min(_pg.page * _pg.limit, _pg.total) %> of <%= Number(_pg.total).toLocaleString('en-US') %> ranked members. Members who used <code class="cfs-code">/privacy opt-out</code> are not shown.</p>
                <% } %>
            <% } %>
        <% } %>
    </main>
<%- include('partials/site-footer') %>
</body>
</html>
