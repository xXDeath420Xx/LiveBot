<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <%- include('partials/cards-page-css') %>
    <style>
        .wrap { max-width: 1040px; margin: 0 auto; padding: 24px 20px 32px; }
        .page-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
        .page-head .count { color: var(--cf-text-3); font-weight: 500; margin-left: 6px; }
        .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 12px; }

        .card-item { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); overflow: hidden; transition: border-color .15s; display: flex; flex-direction: column; min-width: 0; }
        .card-item:hover { border-color: var(--cf-border-strong); }
        .card-cover { height: 112px; background: var(--cf-surface-2); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
        .card-cover img { width: 100%; height: 100%; object-fit: cover; }
        .card-cover .placeholder-icon { font-size: 2rem; color: var(--cf-text-3); opacity: .5; }
        .cover-tags { position: absolute; top: 8px; left: 8px; right: 8px; display: flex; justify-content: space-between; gap: 6px; }
        .tag { border-radius: var(--cf-radius-sm); padding: 2px 7px; font-size: var(--cf-text-xs); font-weight: 500; background: rgb(0 0 0 / .7); color: #fff; }
        .tag.active { color: #6ee7a8; } .tag.delivered { color: #c4c4ff; } .tag.frozen { color: #fca5a5; } .tag.scheduled { color: #fcd34d; }

        .card-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
        .card-body h2 { font-size: var(--cf-text-md); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-body .recipient { color: var(--cf-text-3); font-size: var(--cf-text-sm); }
        .card-stats { display: flex; gap: 12px; flex-wrap: wrap; margin: 6px 0 10px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .card-stats i { margin-right: 3px; }
        .card-actions { display: flex; gap: 6px; margin-top: auto; flex-wrap: wrap; }
        .card-actions .push { margin-left: auto; }
        .sign-cta { margin-top: 8px; }

        .empty-state { text-align: center; padding: 48px 20px; background: var(--cf-surface); border: 1px dashed var(--cf-border); border-radius: var(--cf-radius-lg); }
        .empty-state h2 { font-size: var(--cf-text-lg); font-weight: 600; margin-bottom: 4px; }
        .empty-state p { color: var(--cf-text-3); margin: 0 auto 16px; max-width: 420px; font-size: var(--cf-text-sm); }

        .share-modal { display: none; position: fixed; inset: 0; background: rgb(0 0 0 / .6); z-index: 1100; align-items: center; justify-content: center; padding: 16px; }
        .share-modal.active { display: flex; }
        .share-modal-content { position: relative; background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-lg); padding: 20px; max-width: 460px; width: 100%; box-shadow: var(--cf-shadow-pop, none); }
        .share-modal-content h2 { margin-bottom: 12px; font-size: var(--cf-text-lg); font-weight: 600; }
        .share-link-box { display: flex; gap: 8px; margin-bottom: 12px; }
        .share-link-box input { flex: 1; min-width: 0; font-family: var(--cf-mono); font-size: var(--cf-text-sm); }
        .share-options { display: flex; gap: 6px; flex-wrap: wrap; }
        .close-modal { position: absolute; top: 12px; right: 12px; background: none; border: 0; color: var(--cf-text-3); cursor: pointer; padding: 4px; line-height: 0; border-radius: var(--cf-radius); }
        .close-modal:hover { color: var(--cf-text); background: var(--cf-surface-2); }
        .close-modal svg { width: 18px; height: 18px; }

        .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); padding: 10px 14px; border-radius: var(--cf-radius-lg); font-size: var(--cf-text-sm); font-weight: 500; display: none; z-index: 1200; background: var(--cf-surface); color: var(--cf-text); border: 1px solid var(--cf-border-strong); box-shadow: var(--cf-shadow-pop, none); }
        .toast.show { display: block; }
        .toast.error { border-color: var(--cf-danger); color: var(--cf-danger); }
    </style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'My Cards | CertiFried' }) %>
</head>
<body>
    <%- include('partials/site-header', { user, active: 'cards', returnTo: '/cards/my-cards' }) %>
    <%- include('partials/section-tabs', { label: 'Group cards', active: 'mine', tabs: [['cards', '/cards', 'Overview'], ['create', '/cards/create', 'Create a card'], ['mine', '/cards/my-cards', 'My cards']] }) %>

    <main class="wrap" id="main-content">
        <div class="page-head">
            <div>
                <h1>My cards<% if (cards.length) { %><span class="count"><%= cards.length %></span><% } %></h1>
                <p>
                    <% if (user) { %>
                        Cards you made on Discord or on this site.
                    <% } else { %>
                        Cards made in this browser. <a href="/auth/discord?returnTo=/cards/my-cards">Log in with Discord</a> to see them on every device.
                    <% } %>
                </p>
            </div>
            <% if (cards.length) { %><a href="/cards/create" class="btn btn-primary">Create a card</a><% } %>
        </div>

        <% if (cards.length === 0) { %>
            <div class="empty-state">
                <h2>No cards yet</h2>
                <p>Make a card for any occasion and share the link so people can sign it.</p>
                <a href="/cards/create" class="btn btn-primary">Create a card</a>
            </div>
        <% } else { %>
            <div class="cards-grid">
                <% cards.forEach(card => { %>
                    <%
                        const typeLabel = card.card_type === 'greeting_card' ? 'Greeting card' : card.card_type === 'one_person' ? 'One person' : 'Group board';
                        const statusLabel = card.is_frozen ? 'Frozen' : card.deliver_at && !card.is_posted ? 'Scheduled' : card.is_posted ? 'Delivered' : 'Open';
                        const statusClass = card.is_frozen ? 'frozen' : card.deliver_at && !card.is_posted ? 'scheduled' : card.is_posted ? 'delivered' : 'active';
                        const slug = card.slug || card.share_token;
                        const coverImg = card.ai_cover_url || card.card_background_url || card.board_bg_image_url;
                        const occIcons = { birthday: 'cake-candles', wedding: 'ring', anniversary: 'ring', farewell: 'hand', 'thank-you': 'heart', baby: 'baby', graduation: 'graduation-cap', holidays: 'snowflake', condolence: 'dove' };
                    %>
                    <article class="card-item">
                        <div class="card-cover">
                            <% if (coverImg) { %>
                                <img src="<%= coverImg %>" alt="" loading="lazy">
                            <% } else { %>
                                <i class="fas fa-<%= occIcons[card.occasion] || 'envelope-open-text' %> placeholder-icon" aria-hidden="true"></i>
                            <% } %>
                            <div class="cover-tags"><span class="tag"><%= typeLabel %></span><span class="tag <%= statusClass %>"><%= statusLabel %></span></div>
                        </div>
                        <div class="card-body">
                            <h2 title="<%= card.card_name || 'Untitled card' %>"><%= card.card_name || 'Untitled card' %></h2>
                            <div class="recipient">
                                <% if (card.recipient_name) { %>For <%= card.recipient_name %><% } %>
                                <% if (card.occasion) { %> · <%= card.occasion.replace(/-/g, ' ').replace(/^\w/, l => l.toUpperCase()) %><% } %>
                            </div>
                            <div class="card-stats">
                                <span><i class="fas fa-pen-nib" aria-hidden="true"></i><%= card.sig_count || 0 %> message<%= (card.sig_count || 0) !== 1 ? 's' : '' %></span>
                                <% if (card.password_hash) { %><span><i class="fas fa-lock" aria-hidden="true"></i>Password</span><% } %>
                                <% if (card.background_music_url) { %><span><i class="fas fa-music" aria-hidden="true"></i>Music</span><% } %>
                                <% if (card.deliver_at && !card.is_posted) { %><span><i class="fas fa-clock" aria-hidden="true"></i><time datetime="<%= new Date(card.deliver_at).toISOString() %>" data-local-date><%= new Date(card.deliver_at).toISOString().slice(0, 10) %></time></span><% } %>
                            </div>
                            <div class="card-actions" data-slug="<%= slug %>" data-name="<%= card.card_name || 'Card' %>">
                                <a href="/card/<%= slug %>" class="btn btn-secondary btn-sm">View</a>
                                <a href="/card/<%= slug %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                                <button type="button" class="btn btn-secondary btn-sm" data-act="share">Share</button>
                                <button type="button" class="btn btn-danger btn-sm push" data-act="delete" aria-label="Delete <%= card.card_name || 'card' %>">Delete</button>
                            </div>
                            <% if (card.card_type === 'one_person' && (card.sig_count || 0) === 0 && !card.is_frozen) { %>
                            <a href="/card/<%= slug %>" class="btn btn-primary btn-sm sign-cta">Write your message</a>
                            <% } %>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } %>
    </main>

    <div class="share-modal" id="shareModal" onclick="if(event.target===this)this.classList.remove('active')">
        <div class="share-modal-content" role="dialog" aria-modal="true" aria-labelledby="share-title">
            <button type="button" class="close-modal" aria-label="Close" onclick="document.getElementById('shareModal').classList.remove('active')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
            <h2 id="share-title">Share the signing link</h2>
            <div class="share-link-box">
                <input type="text" class="form-control" id="shareLinkInput" readonly aria-label="Card link">
                <button type="button" class="btn btn-primary" onclick="copyShareLink()">Copy</button>
            </div>
            <div class="share-options">
                <a id="shareWhatsApp" href="#" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp</a>
                <a id="shareTelegram" href="#" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><i class="fab fa-telegram" aria-hidden="true"></i> Telegram</a>
                <a id="shareEmail" href="#" class="btn btn-secondary btn-sm"><i class="fas fa-envelope" aria-hidden="true"></i> Email</a>
                <a id="shareTwitter" href="#" target="_blank" rel="noopener" class="btn btn-secondary btn-sm"><i class="fab fa-x-twitter" aria-hidden="true"></i> X</a>
            </div>
        </div>
    </div>

    <div class="toast" id="toast" role="status"></div>

    <%- include('partials/site-footer') %>

    <script>
    // Card actions read the card from data-* (titles may contain quotes).
    document.querySelectorAll('.card-actions').forEach(row => {
        row.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-act]');
            if (!btn) return;
            if (btn.dataset.act === 'share') shareCard(row.dataset.slug, row.dataset.name);
            if (btn.dataset.act === 'delete') deleteCard(row.dataset.slug, row.dataset.name);
        });
    });
    document.querySelectorAll('time[data-local-date]').forEach(t => {
        const d = new Date(t.getAttribute('datetime'));
        if (!isNaN(d)) t.textContent = d.toLocaleDateString();
    });
    function shareCard(slug, name) {
        const url = window.location.origin + '/card/' + slug;
        document.getElementById('shareLinkInput').value = url;
        const encoded = encodeURIComponent(url);
        const text = encodeURIComponent('Sign ' + name + '!');
        document.getElementById('shareWhatsApp').href = 'https://wa.me/?text=' + text + '%20' + encoded;
        document.getElementById('shareTelegram').href = 'https://t.me/share/url?url=' + encoded + '&text=' + text;
        document.getElementById('shareEmail').href = 'mailto:?subject=' + text + '&body=' + encoded;
        document.getElementById('shareTwitter').href = 'https://twitter.com/intent/tweet?text=' + text + '%20' + encoded;
        document.getElementById('shareModal').classList.add('active');
    }
    function copyShareLink() {
        const input = document.getElementById('shareLinkInput');
        input.select();
        navigator.clipboard.writeText(input.value).then(() => {
            const btn = input.nextElementSibling;
            btn.textContent = 'Copied';
            setTimeout(() => btn.textContent = 'Copy', 2000);
        });
    }
    function deleteCard(slug, name) {
        if (!confirm('Delete "' + name + '" and all its signatures? This cannot be undone.')) return;
        fetch('/card/' + encodeURIComponent(slug), { method: 'DELETE' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('Card deleted', false);
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.error || 'Could not delete the card.', true);
                }
            })
            .catch(() => showToast('Could not reach the server. Try again.', true));
    }
    function showToast(msg, isError) {
        const t = document.getElementById('toast');
        if (!t) return;
        t.textContent = msg;
        t.className = 'toast show ' + (isError ? 'error' : 'success');
        setTimeout(() => t.className = 'toast', 3000);
    }
    </script>
</body>
</html>
