<%- include('partials/modern-header', {
    pageTitle: event.name + ' - My Schedules',
    additionalCSS: []
}) %>

<style>
.editor-page {
    min-height: 100vh;
    background: var(--color-dark-800);
    padding-bottom: var(--spacing-12);
}

.editor-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-6);
}

/* Breadcrumb */
.breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-4);
    font-size: var(--font-size-sm);
}

.breadcrumb a {
    color: var(--color-primary-400);
    text-decoration: none;
}

.breadcrumb a:hover {
    text-decoration: underline;
}

.breadcrumb span {
    color: var(--color-text-muted);
}

/* Event Header */
.event-header {
    background: var(--gradient-primary);
    padding: var(--spacing-6);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-4);
}

.event-header h1 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
}

.event-header-actions {
    display: flex;
    gap: var(--spacing-3);
}

/* Tabs */
.tabs {
    display: flex;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-6);
    border-bottom: 1px solid var(--color-dark-400);
    padding-bottom: var(--spacing-2);
}

.tab {
    padding: var(--spacing-2) var(--spacing-4);
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.tab:hover {
    color: var(--color-text-primary);
    background: var(--color-dark-600);
}

.tab.active {
    color: var(--color-text-primary);
    background: var(--color-dark-700);
    border-bottom: 2px solid var(--color-primary-500);
}

/* Content Sections */
.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
}

/* Schedule Card */
.schedule-card {
    background: var(--color-dark-700);
    border: 1px solid var(--color-dark-400);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-4);
    overflow: hidden;
}

.schedule-card-header {
    background: var(--color-dark-600);
    padding: var(--spacing-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

.schedule-card-header:hover {
    background: var(--color-dark-500);
}

.schedule-card-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
}

.schedule-card-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
}

.schedule-card-actions {
    display: flex;
    gap: var(--spacing-2);
}

.schedule-card-body {
    padding: var(--spacing-4);
    display: none;
}

.schedule-card-body.expanded {
    display: block;
}

/* Runs Table */
.runs-table {
    width: 100%;
    border-collapse: collapse;
}

.runs-table th {
    padding: var(--spacing-3);
    text-align: left;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    background: var(--color-dark-600);
    border-bottom: 1px solid var(--color-dark-400);
}

.runs-table td {
    padding: var(--spacing-3);
    border-bottom: 1px solid var(--color-dark-400);
    vertical-align: middle;
}

.runs-table tr:hover td {
    background: var(--color-dark-600);
}

.runs-table tr.status-running {
    background: rgba(67, 181, 129, 0.1);
}

.runs-table tr.status-completed {
    opacity: 0.6;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    border: none;
}

.btn-sm {
    padding: var(--spacing-1) var(--spacing-2);
    font-size: var(--font-size-xs);
}

.btn-primary { background: var(--color-primary-500); color: white; }
.btn-primary:hover { background: var(--color-primary-600); }
.btn-secondary { background: var(--color-dark-500); color: var(--color-text-secondary); }
.btn-secondary:hover { background: var(--color-dark-400); color: var(--color-text-primary); }
.btn-success { background: var(--color-success); color: white; }
.btn-success:hover { background: var(--color-success-dark); }
.btn-danger { background: var(--color-danger); color: white; }
.btn-danger:hover { background: var(--color-danger-dark); }
.btn-outline { background: transparent; border: 1px solid var(--color-dark-400); color: var(--color-text-secondary); }
.btn-outline:hover { border-color: var(--color-primary-500); color: var(--color-text-primary); }

/* Status Badge */
.status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
}

.status-pending { background: var(--color-dark-500); color: var(--color-text-muted); }
.status-running { background: var(--color-success); color: white; }
.status-completed { background: var(--color-primary-500); color: white; }
.status-skipped { background: var(--color-warning); color: black; }

/* Empty State */
.empty-state {
    text-align: center;
    padding: var(--spacing-10);
    color: var(--color-text-muted);
}

.empty-state i {
    font-size: 3rem;
    margin-bottom: var(--spacing-4);
    color: var(--color-dark-400);
}

/* Modal */
.custom-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 9999;
    align-items: center;
    justify-content: center;
}

.custom-modal.active { display: flex !important; }

.modal-content {
    background: var(--color-dark-700);
    border: 1px solid var(--color-dark-400);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    padding: var(--spacing-5);
    border-bottom: 1px solid var(--color-dark-400);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h3 {
    margin: 0;
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
}

.modal-close {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: var(--font-size-xl);
    cursor: pointer;
}

.modal-body { padding: var(--spacing-5); }
.modal-footer {
    padding: var(--spacing-5);
    border-top: 1px solid var(--color-dark-400);
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-3);
}

.form-group { margin-bottom: var(--spacing-4); }
.form-label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
}
.form-control {
    width: 100%;
    padding: var(--spacing-3);
    background: var(--color-dark-600);
    border: 1px solid var(--color-dark-400);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
}
.form-control:focus {
    outline: none;
    border-color: var(--color-primary-500);
}
.form-help {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--spacing-1);
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
}
</style>

<div class="editor-page">
    <div class="editor-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <a href="/my-schedules"><i class="fas fa-home"></i> My Schedules</a>
            <span>/</span>
            <span><%= event.name %></span>
        </nav>

        <!-- Event Header -->
        <div class="event-header">
            <h1><i class="fas fa-calendar-alt"></i> <%= event.name %></h1>
            <div class="event-header-actions">
                <a href="/schedule/<%= event.slug %>" target="_blank" class="btn btn-outline">
                    <i class="fas fa-external-link-alt"></i> View Public
                </a>
                <button class="btn btn-primary" onclick="showAddScheduleModal()">
                    <i class="fas fa-plus"></i> Add Schedule
                </button>
            </div>
        </div>

        <!-- Schedules -->
        <div id="schedules-container">
            <% if (schedules && schedules.length > 0) { %>
                <% schedules.forEach(schedule => { %>
                    <div class="schedule-card" data-schedule-id="<%= schedule.id %>">
                        <div class="schedule-card-header" onclick="toggleSchedule(<%= schedule.id %>)">
                            <div>
                                <div class="schedule-card-title">
                                    <i class="fas fa-chevron-right" id="chevron-<%= schedule.id %>"></i>
                                    <%= schedule.name %>
                                </div>
                                <div class="schedule-card-meta">
                                    <% if (schedule.start_time) { %>
                                        <i class="fas fa-clock"></i> <%= new Date(schedule.start_time).toLocaleString() %>
                                    <% } else { %>
                                        <i class="fas fa-clock"></i> No start time set
                                    <% } %>
                                </div>
                            </div>
                            <div class="schedule-card-actions" onclick="event.stopPropagation()">
                                <button class="btn btn-sm btn-primary" onclick="showAddRunModal(<%= schedule.id %>)">
                                    <i class="fas fa-plus"></i> Add Run
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteSchedule(<%= schedule.id %>)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="schedule-card-body" id="schedule-body-<%= schedule.id %>">
                            <div id="runs-<%= schedule.id %>">
                                <div class="empty-state">
                                    <i class="fas fa-running"></i>
                                    <p>Loading runs...</p>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-calendar-day"></i>
                    <h3>No Schedules Yet</h3>
                    <p>Add schedules to organize your event by day or category.</p>
                    <button class="btn btn-primary" onclick="showAddScheduleModal()">
                        <i class="fas fa-plus"></i> Add First Schedule
                    </button>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Add Schedule Modal -->
<div class="custom-modal" id="addScheduleModal">
    <div class="modal-content" style="max-width: 700px;">
        <div class="modal-header">
            <h3>Create a New Schedule</h3>
            <button class="modal-close" onclick="hideModal('addScheduleModal')">&times;</button>
        </div>
        <form id="addScheduleForm" action="javascript:void(0)" onsubmit="return handleAddSchedule(event)">
            <div class="modal-body">
                <h4 style="color: var(--color-text-muted); margin-bottom: var(--spacing-4); border-bottom: 1px solid var(--color-dark-400); padding-bottom: var(--spacing-2);">Schedule Information</h4>
                <div class="form-group">
                    <label class="form-label">Belongs to</label>
                    <input type="text" class="form-control" value="<%= event.name %>" disabled style="opacity: 0.7;">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="name" required placeholder="Main Schedule">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Slug</label>
                        <div style="display: flex; align-items: center;">
                            <span style="background: var(--color-dark-500); padding: var(--spacing-3); border-radius: var(--radius-md) 0 0 var(--radius-md); border: 1px solid var(--color-dark-400); border-right: none; color: var(--color-text-muted); font-size: var(--font-size-xs);">/<%= event.slug %>/</span>
                            <input type="text" class="form-control" name="slug" required placeholder="schedule" pattern="[a-z0-9\-]+" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Website</label>
                    <input type="url" class="form-control" name="website" placeholder="https://yoursite.com">
                    <div class="form-help">Leave empty to use event's website<% if (event.website_url) { %> (<%= event.website_url %>)<% } %></div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Twitch Stream</label>
                        <div style="display: flex; align-items: center;">
                            <span style="background: var(--color-dark-500); padding: var(--spacing-3); border-radius: var(--radius-md) 0 0 var(--radius-md); border: 1px solid var(--color-dark-400); border-right: none; color: var(--color-text-muted);">twitch.tv/</span>
                            <input type="text" class="form-control" name="twitchChannel" placeholder="<%= event.twitch_channel || 'channel' %>" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                        </div>
                        <div class="form-help">Leave empty to use event's stream</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Twitter Account</label>
                        <div style="display: flex; align-items: center;">
                            <span style="background: var(--color-dark-500); padding: var(--spacing-3); border-radius: var(--radius-md) 0 0 var(--radius-md); border: 1px solid var(--color-dark-400); border-right: none; color: var(--color-text-muted);">@</span>
                            <input type="text" class="form-control" name="twitter" placeholder="username" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                        </div>
                        <div class="form-help">Leave empty to use event's account</div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Timezone</label>
                        <select class="form-control" name="timezone" id="scheduleTimezone">
                            <option value="UTC">UTC</option>
                            <option value="America/New_York">Eastern Time (ET)</option>
                            <option value="America/Chicago">Central Time (CT)</option>
                            <option value="America/Denver">Mountain Time (MT)</option>
                            <option value="America/Los_Angeles">Pacific Time (PT)</option>
                            <option value="Europe/London">London (GMT/BST)</option>
                            <option value="Europe/Paris">Central European (CET)</option>
                            <option value="Europe/Berlin">Berlin (CET)</option>
                            <option value="Asia/Tokyo">Tokyo (JST)</option>
                            <option value="Australia/Sydney">Sydney (AEST)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Start</label>
                        <input type="datetime-local" class="form-control" name="startTime">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Setup Time</label>
                        <input type="text" class="form-control" name="setupTime" placeholder="5m" pattern="[0-9]+[hms]?(\s*[0-9]+[hms]?)*">
                        <div class="form-help">Added between all items. E.g. "5min" or "5m 30s"</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Theme</label>
                        <select class="form-control" name="theme">
                            <option value="default">Default</option>
                            <option value="dark">Dark</option>
                            <option value="light">Light</option>
                            <option value="gdq">GDQ Style</option>
                            <option value="esa">ESA Style</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Secret</label>
                        <input type="text" class="form-control" name="secret" placeholder="Optional edit key">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Hidden Column Secret</label>
                        <input type="text" class="form-control" name="hiddenSecret" placeholder="Optional view key">
                        <div class="form-help">Required to view hidden columns</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hideModal('addScheduleModal')">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Create Schedule</button>
            </div>
        </form>
    </div>
</div>

<!-- Add Run Modal -->
<div class="custom-modal" id="addRunModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Add Run</h3>
            <button class="modal-close" onclick="hideModal('addRunModal')">&times;</button>
        </div>
        <form id="addRunForm" action="javascript:void(0)" onsubmit="return handleAddRun(event)">
            <input type="hidden" name="scheduleId" id="runScheduleId">
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Game Name</label>
                        <input type="text" class="form-control" name="gameName" required placeholder="Super Mario 64">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Category</label>
                        <input type="text" class="form-control" name="category" placeholder="120 Star">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Runner(s)</label>
                    <input type="text" class="form-control" name="runners" placeholder="Runner1, Runner2">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Estimate (H:MM:SS)</label>
                        <input type="text" class="form-control" name="estimate" placeholder="1:45:00" pattern="[0-9]+:[0-5][0-9]:[0-5][0-9]">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Setup Time (H:MM:SS)</label>
                        <input type="text" class="form-control" name="setup" placeholder="0:10:00" pattern="[0-9]+:[0-5][0-9]:[0-5][0-9]">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" name="notes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="hideModal('addRunModal')">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Run</button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/modern-footer') %>

<script>
const eventId = <%= event.id %>;

function showAddScheduleModal() {
    document.getElementById('addScheduleForm').reset();
    document.getElementById('addScheduleModal').classList.add('active');
}

function showAddRunModal(scheduleId) {
    document.getElementById('addRunForm').reset();
    document.getElementById('runScheduleId').value = scheduleId;
    document.getElementById('addRunModal').classList.add('active');
}

function hideModal(modalId) {
    document.getElementById(modalId).classList.remove('active');
}

function toggleSchedule(scheduleId) {
    const body = document.getElementById(`schedule-body-${scheduleId}`);
    const chevron = document.getElementById(`chevron-${scheduleId}`);

    if (body.classList.contains('expanded')) {
        body.classList.remove('expanded');
        chevron.style.transform = 'rotate(0deg)';
    } else {
        body.classList.add('expanded');
        chevron.style.transform = 'rotate(90deg)';
        loadRuns(scheduleId);
    }
}

async function loadRuns(scheduleId) {
    try {
        const response = await fetch(`/api/my-schedules/schedules/${scheduleId}/items`);
        const data = await response.json();

        const container = document.getElementById(`runs-${scheduleId}`);

        if (data.items && data.items.length > 0) {
            let html = `
                <table class="runs-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Game</th>
                            <th>Runner(s)</th>
                            <th>Estimate</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            data.items.forEach((item, index) => {
                html += `
                    <tr class="status-${item.status || 'pending'}">
                        <td>${index + 1}</td>
                        <td>
                            <strong>${escapeHtml(item.game_name)}</strong>
                            ${item.category ? `<br><small style="color: var(--color-text-muted);">${escapeHtml(item.category)}</small>` : ''}
                        </td>
                        <td>${escapeHtml(item.runners || '-')}</td>
                        <td style="font-family: var(--font-family-mono);">${formatTime(item.estimate_seconds)}</td>
                        <td><span class="status-badge status-${item.status || 'pending'}">${item.status || 'pending'}</span></td>
                        <td>
                            <div style="display: flex; gap: 4px;">
                                ${item.status !== 'running' && item.status !== 'completed' ?
                                    `<button class="btn btn-sm btn-success" onclick="setRunStatus(${item.id}, 'running', ${scheduleId})"><i class="fas fa-play"></i></button>` : ''}
                                ${item.status === 'running' ?
                                    `<button class="btn btn-sm btn-primary" onclick="setRunStatus(${item.id}, 'completed', ${scheduleId})"><i class="fas fa-check"></i></button>` : ''}
                                <button class="btn btn-sm btn-danger" onclick="deleteRun(${item.id}, ${scheduleId})"><i class="fas fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            html += '</tbody></table>';
            container.innerHTML = html;
        } else {
            container.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-running"></i>
                    <p>No runs yet. Add your first run!</p>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading runs:', error);
    }
}

function handleAddSchedule(e) {
    if (e) e.preventDefault();
    const form = document.getElementById('addScheduleForm');
    const formData = new FormData(form);

    const payload = {
        name: formData.get('name'),
        slug: formData.get('slug'),
        website: formData.get('website') || null,
        twitchChannel: formData.get('twitchChannel') || null,
        twitter: formData.get('twitter') || null,
        timezone: formData.get('timezone') || 'UTC',
        startTime: formData.get('startTime') || null,
        setupTime: formData.get('setupTime') || null,
        theme: formData.get('theme') || 'default',
        secret: formData.get('secret') || null,
        hiddenSecret: formData.get('hiddenSecret') || null
    };

    fetch(`/api/my-schedules/events/${eventId}/schedules`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Failed to add schedule');
        }
    })
    .catch(error => {
        console.error('Error adding schedule:', error);
        alert('Failed to add schedule');
    });

    return false;
}

async function deleteSchedule(scheduleId) {
    if (!confirm('Delete this schedule and all its runs?')) return;

    try {
        const response = await fetch(`/api/my-schedules/schedules/${scheduleId}`, { method: 'DELETE' });
        const data = await response.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.error || 'Failed to delete schedule');
        }
    } catch (error) {
        console.error('Error deleting schedule:', error);
        alert('Failed to delete schedule');
    }
}

function handleAddRun(e) {
    if (e) e.preventDefault();
    const form = document.getElementById('addRunForm');
    const formData = new FormData(form);
    const scheduleId = formData.get('scheduleId');

    const payload = {
        gameName: formData.get('gameName'),
        category: formData.get('category'),
        runners: formData.get('runners'),
        estimateSeconds: parseTime(formData.get('estimate')),
        setupSeconds: parseTime(formData.get('setup')),
        notes: formData.get('notes')
    };

    console.log('Adding run:', payload, 'to schedule:', scheduleId);

    fetch(`/api/my-schedules/schedules/${scheduleId}/items`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(data => {
        console.log('Add run response:', data);
        if (data.success) {
            hideModal('addRunModal');
            loadRuns(scheduleId);
        } else {
            alert(data.error || 'Failed to add run');
        }
    })
    .catch(error => {
        console.error('Error adding run:', error);
        alert('Failed to add run');
    });

    return false;
}

async function setRunStatus(itemId, status, scheduleId) {
    try {
        const response = await fetch(`/api/my-schedules/items/${itemId}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
