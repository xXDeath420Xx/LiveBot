<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<style>
    .game-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0 8px; gap: 12px; flex-wrap: wrap; }
    .game-header h1 { font-size: var(--cf-text-xl); font-weight: 600; letter-spacing: -0.01em; }
    .game-header .game-id { color: var(--cf-text-3); font-family: var(--cf-mono); font-size: var(--cf-text-sm); font-weight: 400; margin-left: 8px; }

    #status { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: 999px; font-size: var(--cf-text-sm); color: var(--cf-text-2); max-width: 100%; }
    #status::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--cf-text-3); flex: none; }
    #status.is-live::before { background: var(--cf-success); }
    #status.is-warn::before { background: var(--cf-warning); }

    .meta-row { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0 16px; }

    .banner { padding: 10px 14px; border-radius: var(--cf-radius-lg); margin-bottom: 12px; font-size: var(--cf-text-sm); border: 1px solid var(--cf-border); background: var(--cf-surface); }
    .czar-banner { border-color: color-mix(in srgb, var(--cf-warning) 45%, transparent); background: color-mix(in srgb, var(--cf-warning) 10%, var(--cf-surface)); font-weight: 500; text-align: center; }
    .spectator-banner { border-color: color-mix(in srgb, var(--cf-info) 40%, transparent); background: color-mix(in srgb, var(--cf-info) 8%, var(--cf-surface)); }
    .guest-banner { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .guest-banner .acts { display: flex; gap: 8px; flex-wrap: wrap; }
    .countdown-banner { border-color: color-mix(in srgb, var(--cf-danger) 45%, transparent); background: color-mix(in srgb, var(--cf-danger) 10%, var(--cf-surface)); text-align: center; font-weight: 600; display: none; }

    /* Turn timer: hidden until a round with a time limit starts */
    .timer-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
    .turn-timer { display: none; align-items: center; gap: 8px; padding: 4px 4px 4px 10px; background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: 999px; font-size: var(--cf-text-sm); }
    .turn-timer.show { display: inline-flex; }
    .turn-timer .phase-pill { color: var(--cf-text-2); }
    .turn-timer .time-left { font-family: var(--cf-mono); font-variant-numeric: tabular-nums; padding: 2px 8px; border-radius: 999px; background: var(--cf-surface-2); }
    .turn-timer.warning .time-left { background: color-mix(in srgb, var(--cf-warning) 18%, transparent); color: var(--cf-warning); }
    .turn-timer.danger .time-left { background: color-mix(in srgb, var(--cf-danger) 18%, transparent); color: var(--cf-danger); }

    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; padding-bottom: 72px; }
    @media (max-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr); } }

    .panel-title { font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text-2); margin-bottom: 8px; }

    /* Scoreboard */
    .scoreboard { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 14px 16px; margin-bottom: 16px; }
    .scoreboard ul { list-style: none; }
    .scoreboard li { display: flex; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--cf-border); font-size: var(--cf-text-md); min-width: 0; }
    .scoreboard li:last-child { border-bottom: none; }
    .scoreboard li strong { font-weight: 500; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .scoreboard .tag { font-size: var(--cf-text-xs); padding: 1px 6px; border-radius: var(--cf-radius-sm); background: var(--cf-surface-2); color: var(--cf-text-2); border: 1px solid var(--cf-border); flex: none; }
    .scoreboard .tag.czar { color: var(--cf-warning); border-color: color-mix(in srgb, var(--cf-warning) 40%, transparent); }
    .scoreboard .tag.done { color: var(--cf-success); border-color: color-mix(in srgb, var(--cf-success) 40%, transparent); }
    .scoreboard .points { margin-left: auto; font-weight: 600; font-variant-numeric: tabular-nums; flex: none; }
    .scoreboard .kick-btn { flex: none; background: none; border: 1px solid transparent; color: var(--cf-text-3); cursor: pointer; padding: 2px 6px; border-radius: var(--cf-radius-sm); font: inherit; font-size: var(--cf-text-xs); }
    .scoreboard .kick-btn:hover { color: var(--cf-danger); border-color: color-mix(in srgb, var(--cf-danger) 40%, transparent); }
    #lobby-controls { display: flex; gap: 8px; margin-top: 12px; align-items: center; flex-wrap: wrap; }
    #start-hint { color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .host-controls { display: flex; gap: 8px; align-items: center; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--cf-border); }
    .host-pill { font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-right: auto; }

    /* Black card (the game's own card art: stays black on every theme) */
    .black-card-wrap { padding: 4px 0 16px; }
    .black-card {
        /* theme: fixed (CAH card face: black by design) */ 
        background: #000; color: #fff; padding: 28px 22px 40px;
        border-radius: 14px; font-size: 1.4rem; line-height: 1.4; font-weight: 700;
        min-height: 160px; border: 1px solid #2a2a2a;
        display: flex; align-items: center; justify-content: center; text-align: center;
        position: relative; overflow-wrap: anywhere;
    }
    .black-card .pick-badge { position: absolute; bottom: 12px; right: 14px; background: #fff; color: #000; font-size: 0.72rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
    @media (max-width: 600px) { .black-card { font-size: 1.15rem; padding: 22px 16px 36px; min-height: 130px; } }

    /* Hand grid */
    .hand-section .panel-title, .judging-section .panel-title { margin: 8px 0 10px; }
    .hand { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
    @media (max-width: 420px) { .hand { grid-template-columns: 1fr 1fr; } }
    .white-card {
        background: #f5f5f0; color: #111; padding: 12px;
        border-radius: 10px; cursor: pointer; user-select: none;
        min-height: 80px; font-size: 0.92rem; font-weight: 500; line-height: 1.35;
        border: 2px solid transparent; overflow-wrap: anywhere;
        transition: border-color 0.15s, box-shadow 0.15s;
        position: relative;
        display: flex; flex-direction: column; align-items: flex-start;
    }
    .white-card:hover { box-shadow: 0 4px 14px rgb(0 0 0 / 0.3); }
    .white-card:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 2px; }
    .white-card.selected { border-color: var(--cf-accent); box-shadow: 0 0 0 3px var(--cf-accent-soft); }
    .white-card.blank { background: #ecebe4; font-style: italic; color: #444; border-style: dashed; border-color: #b8b6aa; }
    .white-card.blank.selected { border-style: solid; border-color: var(--cf-accent); }
    .white-card .order-badge { position: absolute; top: 6px; right: 8px; background: var(--cf-accent); color: var(--cf-on-accent); border-radius: 50%; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; font-style: normal; }

    .hand-actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
    #btn-burn-hand { display: none; }

    /* Submissions reveal */
    .submissions .white-card { animation: cardFlip 0.35s ease-out backwards; cursor: default; }
    @keyframes cardFlip { from { transform: rotateY(90deg); opacity: 0; } to { transform: rotateY(0); opacity: 1; } }
    .submissions .white-card:nth-child(2) { animation-delay: 0.08s; }
    .submissions .white-card:nth-child(3) { animation-delay: 0.16s; }
    .submissions .white-card:nth-child(4) { animation-delay: 0.24s; }
    .submissions .white-card:nth-child(5) { animation-delay: 0.32s; }
    .submissions .white-card:nth-child(6) { animation-delay: 0.40s; }

    /* Confetti */
    #confetti-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 9999; display: none; }
    #confetti-canvas.firing { display: block; }

    .judging-section { margin-top: 16px; }
    .judging-hint { color: var(--cf-text-3); font-size: var(--cf-text-sm); margin: -4px 0 10px; }
    .submissions { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; }
    .submissions .white-card { font-size: 0.94rem; padding: 14px; gap: 10px; }
    .submissions .sub-text { flex: 1; }
    .submissions:not(.spectate) .sub-text { cursor: pointer; }
    .submissions .sub-num { /* theme: fixed (number chip on the white CAH card) */ display: inline-block; background: #111; color: #fff; font-size: 0.7rem; font-weight: 700; padding: 1px 7px; border-radius: 999px; margin-right: 6px; font-style: normal; }
    .sub-reactions { display: flex; gap: 4px; flex-wrap: wrap; }
    .react-btn { display: inline-flex; align-items: center; gap: 3px; padding: 2px 6px; border-radius: 999px; border: 1px solid #d6d4ca; background: #fff; cursor: pointer; font-size: 0.85rem; line-height: 1.4; color: #333; }
    .react-btn:hover { border-color: #999; }
    .react-btn.mine { border-color: #111; background: #e9e8e1; }
    .react-btn .count { font-size: 0.72rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .react-btn .count:empty { display: none; }

    /* Chat panel */
    .chat-panel { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 14px; display: flex; flex-direction: column; height: fit-content; max-height: 600px; min-height: 360px; }
    .chat-messages { flex: 1; overflow-y: auto; min-height: 200px; max-height: 420px; padding: 6px 8px; background: var(--cf-inset); border-radius: var(--cf-radius); font-size: var(--cf-text-sm); border: 1px solid var(--cf-border); }
    .chat-msg { padding: 6px 2px; border-bottom: 1px solid var(--cf-border); }
    .chat-msg:last-child { border-bottom: none; }
    .chat-msg .from { font-weight: 600; color: var(--cf-text); }
    .chat-msg.spectator .from { color: var(--cf-text-3); font-weight: 500; }
    .chat-msg .time { color: var(--cf-text-3); font-size: var(--cf-text-xs); margin-left: 6px; }
    .chat-msg .body { color: var(--cf-text); margin-top: 2px; overflow-wrap: anywhere; line-height: 1.4; }
    .chat-input { display: flex; gap: 6px; margin-top: 8px; }
    .chat-input input { flex: 1; min-width: 0; }
    .chat-empty { color: var(--cf-text-3); text-align: center; padding: 16px 0; font-size: var(--cf-text-sm); }

    /* Dialogs (blank card, guest name) */
    .modal-bg { position: fixed; inset: 0; background: rgb(0 0 0 / 0.6); display: none; align-items: center; justify-content: center; z-index: 1100; padding: 16px; }
    .modal { background: var(--cf-surface); padding: 20px; border-radius: var(--cf-radius-lg); max-width: 480px; width: 100%; border: 1px solid var(--cf-border-strong); box-shadow: var(--cf-shadow-pop, 0 16px 48px rgb(0 0 0 / .45)); }
    .modal h3 { font-size: var(--cf-text-lg); font-weight: 600; margin-bottom: 4px; }
    .modal p { color: var(--cf-text-2); font-size: var(--cf-text-sm); margin-bottom: 12px; }
    .modal input[type=text], .modal textarea { width: 100%; }
    .modal textarea { min-height: 80px; }
    .modal .form-error { color: var(--cf-danger); font-size: var(--cf-text-sm); margin-top: 8px; display: none; }
    .modal-actions { margin-top: 16px; display: flex; gap: 8px; justify-content: flex-end; }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'CAH — Game ' + (game.id.slice(0, 8)) + ' — CertiFried MultiTool', description: 'Cards Against Humanity on CertiFried MultiTool: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'game' }) %>
<%- include('components/cah-breadcrumbs', { crumbs: [{ href: '/cah', label: 'Lobbies' }, { label: 'Game ' + game.id.slice(0, 8) }] }) %>

<main class="container" id="main-content">
    <div class="game-header">
        <h1>Cards Against Humanity<span class="game-id"><%= game.id.slice(0, 8) %></span></h1>
        <div id="status" role="status" aria-live="polite">Connecting…</div>
    </div>

    <% if (typeof user === 'undefined' || !user) { %>
        <div class="banner spectator-banner guest-banner" id="guest-banner">
            <span id="guest-banner-text">You are watching. Pick a name to join the game.</span>
            <div class="acts">
                <button type="button" class="btn btn-primary btn-sm" onclick="guestPickName()">Pick a name</button>
                <a href="/auth/discord?returnTo=/cah/<%= game.id %>" class="btn btn-outline btn-sm">Log in with Discord</a>
            </div>
        </div>
    <% } %>

    <!-- Guest username prompt (also on the game page so anonymous users can join from here) -->
    <div class="modal-bg" id="guest-modal">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="guest-modal-title">
            <h3 id="guest-modal-title">Pick a name to play</h3>
            <p>Other players see this name in the game.</p>
            <label class="form-label" for="guest-username">Your name</label>
            <input id="guest-username" class="form-input" type="text" maxlength="24" minlength="2" placeholder="e.g. Bean Goblin" autocomplete="off" onkeydown="if(event.key==='Enter')submitGuestName()">
            <div id="guest-error" class="form-error" role="alert"></div>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" onclick="document.getElementById('guest-modal').style.display='none'">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitGuestName()">Join game</button>
            </div>
        </div>
    </div>
    <div id="spectator-banner" class="banner spectator-banner" style="display:none;">You are watching this game. You can join the next one from the lobby list.</div>
    <div class="timer-row">
        <div class="turn-timer" id="turn-timer" aria-live="off">
            <span class="phase-pill" id="phase-pill">Round</span>
            <span class="time-left" id="time-left">--:--</span>
        </div>
    </div>
    <div id="countdown-banner" class="banner countdown-banner" role="alert"><span id="countdown-text">10 seconds left to act.</span></div>

    <% const czarLabels = { rotate: 'Czar rotates', random: 'Random czar', previous_winner: 'Last winner is czar' }; %>
    <div class="meta-row">
        <span class="pill pill-purple"><%= game.settings.pointsToWin %> points to win</span>
        <span class="pill">Up to <%= game.settings.maxRounds %> rounds</span>
        <span class="pill"><%= czarLabels[game.settings.czarRotation] || game.settings.czarRotation %></span>
        <% if (game.settings.timeoutEnabled) { %><span class="pill"><%= game.settings.timeoutSeconds %>s per turn</span><% } %>
        <% if (game.settings.blankCardCount > 0) { %><span class="pill pill-amber"><%= game.settings.blankCardCount %> blank cards</span><% } %>
        <% if (game.settings.randoCount > 0) { %><span class="pill"><%= game.settings.randoCount %> AI player<%= game.settings.randoCount === 1 ? '' : 's' %></span><% } %>
        <% if (game.settings.nsfw) { %><span class="pill pill-red">NSFW</span><% } %>
    </div>

    <div class="layout">
        <div>
            <section class="scoreboard" aria-labelledby="players-title">
                <h2 class="panel-title" id="players-title">Players</h2>
                <ul id="player-list"></ul>
                <div id="lobby-controls" style="display:none;">
                    <button type="button" class="btn btn-primary btn-sm" id="btn-join">Join game</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btn-start" style="display:none;">Start game</button>
                    <span id="start-hint" style="display:none;"></span>
                    <button type="button" class="btn btn-ghost btn-sm" id="btn-copy-link">Copy invite link</button>
                </div>
                <div class="host-controls" id="host-controls" style="display:none;">
                    <span class="host-pill">You are the host</span>
                    <button type="button" class="btn btn-danger btn-sm" id="btn-end" onclick="confirmEnd()">End game</button>
                </div>
            </section>

            <div id="czar-banner" class="banner czar-banner" style="display:none;">You are the Card Czar this round. Wait for everyone to submit, then pick the funniest answer.</div>

            <div class="black-card-wrap">
                <div class="black-card cf-keep-dark" id="black-card">Waiting for game to start…</div>
            </div>

            <section class="hand-section" id="hand-section" aria-labelledby="hand-title">
                <h2 class="panel-title" id="hand-title">Your hand</h2>
                <div id="hand" class="hand"></div>
                <div class="hand-actions">
                    <button type="button" class="btn btn-primary" id="btn-submit" style="display:none;">Submit selected cards</button>
                    <button type="button" class="btn btn-ghost btn-sm" id="btn-burn-hand" onclick="confirmBurnHand()" title="Costs 1 point">New hand (costs 1 point)</button>
                </div>
            </section>

            <section class="judging-section" id="judging-section" style="display:none;" aria-labelledby="subs-title">
                <h2 class="panel-title" id="subs-title">Submissions</h2>
                <p class="judging-hint" id="judging-hint"></p>
                <div id="submissions" class="submissions"></div>
            </section>
        </div>

        <aside class="chat-panel" aria-labelledby="chat-title">
            <h2 class="panel-title" id="chat-title">Game chat</h2>
            <div id="chat-messages" class="chat-messages" aria-live="polite">
                <div class="chat-empty">No messages yet.</div>
            </div>
            <div class="chat-input">
                <input id="chat-input" class="form-input" type="text" maxlength="500" placeholder="Message" aria-label="Chat message">
                <button type="button" class="btn btn-primary btn-sm" id="chat-send">Send</button>
            </div>
        </aside>
    </div>
</main>

<div class="modal-bg" id="blank-modal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="blank-modal-title">
        <h3 id="blank-modal-title">Write your blank card</h3>
        <p>Any answer you like, up to 200 characters.</p>
        <textarea id="blank-text" class="form-textarea" maxlength="200" placeholder="Your answer" aria-label="Your answer"></textarea>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="cancelBlank()">Cancel</button>
            <button type="button" class="btn btn-primary" id="blank-confirm">Use this answer</button>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const GAME_ID = <%- JSON.stringify(game.id) %>;
    let ME = <%- JSON.stringify(user?.id || null) %>;
    let IS_GUEST = ME === null;

    // Anonymous users can become guests on this page too — if they pick a name,
    // reload picks up the session and they're now a player.
    function guestPickName() {
        document.getElementById('guest-error').style.display = 'none';
        document.getElementById('guest-modal').style.display = 'flex';
        setTimeout(() => document.getElementById('guest-username')?.focus(), 50);
    }
    async function submitGuestName() {
        const username = document.getElementById('guest-username').value.trim();
        const err = document.getElementById('guest-error');
        err.style.display = 'none';
        if (username.length < 2 || username.length > 24) { err.textContent = 'Name must be 2–24 characters.'; err.style.display = 'block'; return; }
        const r = await cfetch('/cah/guest/identity', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username }) });
        const d = await r.json();
        if (!d.ok) { err.textContent = d.message || d.reason; err.style.display = 'block'; return; }
        // Reload so socket.io picks up the new session identity. Cleaner than
        // trying to hot-swap ME mid-connection.
        location.reload();
    }
    const INITIAL = <%- JSON.stringify(game) %>;

    const socket = io({ withCredentials: true });
    let myHand = [];
    let blackCard = INITIAL.blackCard || null;
    let selectedIds = [];
    let pendingBlankIdx = null;
    let blankTexts = {};
    let isCzar = false;
    let isHost = INITIAL.hostUserId === ME;
    let inLobby = INITIAL.state === 'LOBBY';
    // Randos are added at startGame() time, not visible in players list yet.
    // Use the setting to know what the effective player count will be.
    const PENDING_RANDOS = Math.min(3, INITIAL.settings.randoCount || 0);

    const $ = (id) => document.getElementById(id);
    const setStatus = (s, tone) => {
        const st = $('status');
        st.textContent = s;
        st.classList.toggle('is-live', tone === 'live');
        st.classList.toggle('is-warn', tone === 'warn');
    };
    const STATE_LABELS = { LOBBY: 'Waiting in the lobby', SUBMITTING: 'Players are picking cards', JUDGING: 'The czar is judging', ROUND_END: 'Round over', GAME_END: 'Game over', ABANDONED: 'Game cancelled' };
    // Latest known names, so events that only carry user ids can show a name.
    const NAMES = {};
    function rememberNames(players) { (players || []).forEach(p => { if (p && p.userId) NAMES[p.userId] = p.displayName; }); }
    const nameOf = (id) => id === ME ? 'You' : (NAMES[id] || 'A player');

    function el(tag, props = {}, ...children) {
        const e = document.createElement(tag);
        for (const [k, v] of Object.entries(props)) {
            if (k === 'class') e.className = v;
            else if (k === 'dataset') Object.assign(e.dataset, v);
            else if (k === 'on') Object.assign(e, v);
            else if (k === 'style') Object.assign(e.style, v);
            else e.setAttribute(k, v);
        }
        for (const c of children) {
            if (c == null || c === false) continue;
            e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
        }
        return e;
    }

    function renderPlayers(players) {
        rememberNames(players);
        const ul = $('player-list');
        ul.replaceChildren(...players.map(p => {
            const children = [
                el('strong', {}, p.displayName + (p.userId === ME ? ' (you)' : '')),
                p.isCzar ? el('span', { class: 'tag czar' }, 'Czar') : null,
                p.platform === 'rando' ? el('span', { class: 'tag' }, 'AI') : null,
                p.hasSubmitted ? el('span', { class: 'tag done' }, 'Played') : null,
                el('span', { class: 'points' }, `${p.points} pt${p.points === 1 ? '' : 's'}`)
            ];
            // Host gets a kick button per non-self, non-rando player (randos can't be kicked usefully — game would re-add them)
            if (isHost && p.userId !== ME && p.platform !== 'rando') {
                children.push(el('button', {
                    class: 'kick-btn',
                    type: 'button',
                    title: 'Remove ' + p.displayName + ' from the game',
                    'aria-label': 'Remove ' + p.displayName,
                    on: { onclick: (ev) => { ev.preventDefault(); ev.stopPropagation(); kickPlayer(p.userId, p.displayName); } }
                }, 'Remove'));
            }
            return el('li', {}, ...children);
        }));
        const haveMe = players.some(p => p.userId === ME);
        const humanCount = players.filter(p => p.platform !== 'rando').length;
        const effectiveTotal = humanCount + PENDING_RANDOS;
        $('lobby-controls').style.display = inLobby ? 'flex' : 'none';
        $('btn-join').style.display = (inLobby && !haveMe) ? 'inline-flex' : 'none';
        const canStart = inLobby && isHost && humanCount >= 1 && effectiveTotal >= 3;
        $('btn-start').style.display = canStart ? 'inline-flex' : 'none';
        $('btn-start').textContent = `Start game (${humanCount} player${humanCount === 1 ? '' : 's'}${PENDING_RANDOS ? ' + ' + PENDING_RANDOS + ' AI' : ''})`;
        const hint = $('start-hint');
        if (hint) {
            if (inLobby && isHost && !canStart) {
                const need = 3 - effectiveTotal;
                hint.textContent = `${need} more player${need === 1 ? '' : 's'} needed to start. Share the invite link, or host a new game with AI players.`;
                hint.style.display = 'inline-block';
            } else {
                hint.style.display = 'none';
            }
        }
        $('spectator-banner').style.display = (!inLobby && !haveMe && !$('guest-banner')) ? 'block' : 'none';
        // Host controls visible to the host at every stage — they need the
        // cancel/end button in the lobby too, not just mid-game.
        $('host-controls').style.display = isHost ? 'flex' : 'none';
        const endBtn = $('btn-end');
        if (endBtn) endBtn.textContent = inLobby ? 'Cancel lobby' : 'End game';
    }

    function renderBlack(bc) {
        blackCard = bc;
        const wrap = $('black-card');
        wrap.replaceChildren();
        wrap.appendChild(document.createTextNode(bc ? bc.text.replace(/_____/g, '_______') : 'Waiting for the game to start…'));
        if (bc && bc.pick) wrap.appendChild(el('span', { class: 'pick-badge' }, `Pick ${bc.pick}`));
    }

    function renderHand() {
        const wrap = $('hand');
        if (isCzar || !myHand.length) { wrap.replaceChildren(); $('btn-submit').style.display = 'none'; return; }
        const pick = blackCard?.pick || 1;
        wrap.replaceChildren(...myHand.map(c => {
            const sel = selectedIds.includes(c.id);
            const order = selectedIds.indexOf(c.id);
            const text = c.isBlank ? (sel && blankTexts[c.id] ? blankTexts[c.id] : 'Blank card: tap to write your own') : c.text;
            const node = el('div', {
                class: `white-card${sel ? ' selected' : ''}${c.isBlank ? ' blank' : ''}`,
                role: 'button',
                tabindex: '0',
                'aria-pressed': sel ? 'true' : 'false',
                dataset: { id: String(c.id) },
                on: { onclick: () => toggleCard(c.id), onkeydown: (ev) => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggleCard(c.id); } } }
            }, text);
            if (sel && pick > 1) node.appendChild(el('span', { class: 'order-badge' }, String(order + 1)));
            return node;
        }));
        const btn = $('btn-submit');
        btn.disabled = selectedIds.length !== pick;
        btn.textContent = selectedIds.length === pick ? `Submit ${pick} card${pick === 1 ? '' : 's'}` : `Submit (${selectedIds.length}/${pick})`;
        btn.style.display = 'inline-flex';
        // Show "Burn hand" only when actively in SUBMITTING and we have a hand and ace rule is on
        const burnBtn = $('btn-burn-hand');
        if (burnBtn) burnBtn.style.display = (myHand.length > 0) ? 'inline-flex' : 'none';
    }
    function confirmBurnHand() {
        if (!confirm('Discard your current hand for a fresh 10 cards? Costs 1 point.')) return;
        socket.emit('cah:burn', { gameId: GAME_ID });
    }

    function toggleCard(id) {
        const i = selectedIds.indexOf(id);
        if (i >= 0) { selectedIds.splice(i, 1); delete blankTexts[id]; }
        else if (selectedIds.length < (blackCard?.pick || 1)) {
            if (id < 0) {
                pendingBlankIdx = id;
                $('blank-modal').style.display = 'flex';
                $('blank-text').value = '';
                $('blank-text').focus();
                return;
            }
            selectedIds.push(id);
        }
        renderHand();
    }

    function cancelBlank() { pendingBlankIdx = null; $('blank-modal').style.display = 'none'; }
    $('blank-confirm').onclick = () => {
        const txt = $('blank-text').value.trim();
        if (!txt || pendingBlankIdx === null) return;
        blankTexts[pendingBlankIdx] = txt;
        selectedIds.push(pendingBlankIdx);
        pendingBlankIdx = null;
        $('blank-modal').style.display = 'none';
        renderHand();
    };

    $('btn-submit').onclick = () => {
        const picks = selectedIds.map(id => id < 0 ? { id, text: blankTexts[id] } : id);
        socket.emit('cah:submit', { gameId: GAME_ID, picks });
    };
    $('btn-join').onclick = () => doJoin();
    function doJoin(password) {
        socket.emit('cah:joinPlayer', { gameId: GAME_ID, password });
    }
    $('btn-start').onclick = () => socket.emit('cah:start', { gameId: GAME_ID });

    // Reaction emoji are game content (players vote with them), not decoration.
    const REACTIONS = ['👍', '😂', '🤢', '🔥', '💀'];
    let myReactions = {};   // submissionId -> emoji
    let allTallies = {};    // submissionId -> { emoji: count }

    function renderJudging(submissions) {
        const wrap = $('submissions');
        wrap.classList.toggle('spectate', !isCzar);
        myReactions = {}; allTallies = {};
        currentSubmissions = submissions;
        wrap.replaceChildren(...submissions.map((s, i) => {
            const text = s.cards.map(c => c.text).join(' / ');
            const textRow = el('div', { class: 'sub-text' },
                el('span', { class: 'sub-num' }, String(i + 1)),
                document.createTextNode(text)
            );
            const reactRow = el('div', { class: 'sub-reactions', dataset: { sid: String(s.submissionId) } });
            REACTIONS.forEach(emoji => {
                const btn = el('button', {
                    class: 'react-btn',
                    type: 'button',
                    dataset: { emoji },
                    on: { onclick: (ev) => { ev.stopPropagation(); sendReaction(s.submissionId, emoji); } }
                }, emoji, el('span', { class: 'count' }, ''));
                reactRow.appendChild(btn);
            });
            const node = el('div', { class: 'white-card', dataset: { sid: String(s.submissionId) } }, textRow, reactRow);
            if (isCzar) {
                // Click on the text area picks the winner; reaction buttons are separate (stopPropagation above)
                textRow.style.cursor = 'pointer';
                textRow.onclick = () => socket.emit('cah:judge', { gameId: GAME_ID, submissionId: s.submissionId });
            }
            return node;
        }));
        $('judging-hint').textContent = isCzar ? 'Tap the funniest answer to award the point.' : 'React to the answers while the czar decides.';
        $('judging-section').style.display = 'block';
    }

    let currentSubmissions = [];
    function sendReaction(submissionId, emoji) {
        // Optimistic local toggle so the UI feels snappy
        const was = myReactions[submissionId];
        if (was === emoji) delete myReactions[submissionId];
        else myReactions[submissionId] = emoji;
        socket.emit('cah:react', { gameId: GAME_ID, submissionId, emoji });
    }

    function applyTallies(tallies) {
        allTallies = tallies || {};
        document.querySelectorAll('.sub-reactions').forEach(row => {
            const sid = parseInt(row.dataset.sid, 10);
            const subTally = allTallies[sid] || {};
            row.querySelectorAll('.react-btn').forEach(btn => {
                const emoji = btn.dataset.emoji;
                const count = subTally[emoji] || 0;
                btn.querySelector('.count').textContent = count > 0 ? String(count) : '';
                btn.classList.toggle('mine', myReactions[sid] === emoji);
            });
        });
    }

    socket.on('cah:reactionUpdated', (p) => applyTallies(p.tallies));

    socket.on('connect', () => {
        setStatus('Connected, joining the game…', 'live');
        socket.emit('cah:joinGame', { gameId: GAME_ID });
    });

    socket.on('cah:state', (s) => {
        inLobby = s.state === 'LOBBY';
        isCzar = s.czarUserId === ME;
        renderPlayers(s.players);
        renderBlack(s.blackCard);
        renderHand();   // re-check isCzar — fixes "czar sees their hand" when joining mid-round
        $('czar-banner').style.display = isCzar && s.state === 'SUBMITTING' ? 'block' : 'none';
        setStatus(`${STATE_LABELS[s.state] || s.state}${s.round ? ' · Round ' + s.round : ''}`, 'live');
    });
    socket.on('disconnect', () => setStatus('Connection lost, reconnecting…', 'warn'));
    socket.on('cah:playerJoined', (p) => renderPlayers(p.players));
    socket.on('cah:playerLeft',   (p) => renderPlayers(p.players));
    socket.on('cah:gameStarted',  () => { inLobby = false; selectedIds = []; blankTexts = {}; $('judging-section').style.display = 'none'; });
    socket.on('cah:roundStarted', (p) => {
        inLobby = false; selectedIds = []; blankTexts = {};
        isCzar = p.czarUserId === ME;
        renderBlack(p.blackCard); renderPlayers(p.players); renderHand();
        $('czar-banner').style.display = isCzar ? 'block' : 'none';
        $('judging-section').style.display = 'none';
        setStatus(`Round ${p.round} · ${isCzar ? 'You are the czar' : 'Pick ' + p.blackCard.pick}`, 'live');
        // 0 means the host turned the turn time limit off.
        startTurnTimer(p.timeoutSeconds || 0, 'SUBMIT');
    });
    socket.on('cah:hand', (p) => { myHand = p.hand; renderHand(); });
    socket.on('cah:cardsSubmitted', (p) => {
        setStatus(`${p.submittedCount} of ${p.expectedCount} played`, 'live');
        if (p.players) renderPlayers(p.players);
    });
    socket.on('cah:judgingStarted', (p) => {
        selectedIds = []; renderJudging(p.submissions);
        setStatus(isCzar ? 'Pick the winner' : 'The czar is judging…', 'live');
        startTurnTimer(p.timeoutSeconds || 0, 'JUDGE');
    });
    socket.on('cah:roundWon', (p) => {
        if (p.scores) renderPlayers(p.scores);
        const who = nameOf(p.winnerUserId);
        const cards = (p.winningCards || []).map(c => c.text).join(' / ');
        setStatus(`${who} won round ${p.round}${cards ? ': ' + cards : ''}`, 'live');
        stopTurnTimer();
    });
    socket.on('cah:gameEnded', (p) => {
        stopTurnTimer();
        if (p.finalScores) renderPlayers(p.finalScores);
        if (p.cancelled) {
            setStatus('The host cancelled this game.', 'warn');
            // Pull the host controls + lobby buttons since the game is over
            inLobby = false; isHost = false;
            $('lobby-controls').style.display = 'none';
            $('host-controls').style.display = 'none';
            return;
        }
        const winners = (p.winnerUserIds || []).map(nameOf);
        setStatus(winners.length ? `Game over. Winner${winners.length > 1 ? 's' : ''}: ${winners.join(', ')}` : 'Game over.', 'live');
        if ((p.winnerUserIds || []).includes(ME)) fireConfetti();
        inLobby = false;
        $('lobby-controls').style.display = 'none';
    });
    socket.on('cah:submitAck', () => { selectedIds = []; renderHand(); });
    socket.on('cah:error', (e) => {
        if (e.needsPassword || e.reason === 'wrong_password') {
            const pw = window.prompt(e.reason === 'wrong_password' ? 'Wrong password. Try again:' : 'This lobby has a password. Enter it to join:');
            if (pw) doJoin(pw);
            return;
        }
        // Friendlier text for common reasons
        const reasons = {
            need_3_players: e.neededMore ? `Need ${e.neededMore} more player(s) to start.` : 'Need at least 3 players to start.',
            need_host: 'A host must join before the game can start.',
            not_host: 'Only the host can do that.',
            insufficient_cards: 'Not enough cards for the selected packs + players. Pick more decks.',
            already_joined: "You're already in this game.",
            no_such_game: 'This game no longer exists.',
            auth_required: 'Pick a name or log in to join.',
            cant_kick_self: 'You cannot remove yourself. Use End game instead.',
            game_full: 'This game is full.',
            game_in_progress: 'This game has already started.',
            not_in_game: 'You are not playing in this game.',
            not_czar: 'Only the czar picks the winner.',
            blank_needs_text: 'Write something on the blank card first.',
            duplicate_cards: 'You picked the same card twice.',
            start_threw: `Start failed: ${e.message || 'unknown error'}`,
            czar_cannot_submit: "You're the Card Czar this round — you'll pick the winner after others submit.",
            not_submitting: 'Not in submission phase right now.',
            already_submitted: "You've already submitted this round.",
            wrong_pick_count: 'Wrong number of cards selected.',
            card_not_in_hand: 'Card not in your hand.'
        };
        setStatus(reasons[e.reason] || ('Something went wrong (' + e.reason + ')'), 'warn');
    });
    socket.on('cah:hostTransferred', (p) => { isHost = p.newHostUserId === ME; setStatus(p.newHostUserId === ME ? 'You are now the host.' : `${nameOf(p.newHostUserId)} is now the host.`, 'live'); });

    // ─── Always-visible turn timer ──────────────────────────────────
    // Ticks every second. Server gave us `timeoutSeconds` at round/judging
    // start (0 = no limit, timer stays hidden). Amber at 30s, red at 10s.
    let turnTimerInterval = null;
    function startTurnTimer(totalSeconds, phase) {
        stopTurnTimer();
        if (!totalSeconds || totalSeconds <= 0) return;
        const wrap = $('turn-timer');
        const timeEl = $('time-left');
        const phaseEl = $('phase-pill');
        let remaining = totalSeconds;
        wrap.classList.remove('warning', 'danger');
        wrap.classList.add('show');
        phaseEl.textContent = phase === 'JUDGE' ? 'Judging' : 'Picking cards';
        const render = () => {
            const m = Math.floor(remaining / 60);
            const s = Math.max(0, remaining % 60);
            timeEl.textContent = `${m}:${String(s).padStart(2, '0')}`;
            wrap.classList.toggle('danger', remaining <= 10);
            wrap.classList.toggle('warning', remaining > 10 && remaining <= 30);
        };
        render();
        turnTimerInterval = setInterval(() => {
            remaining--;
            if (remaining < 0) { stopTurnTimer(); return; }
            render();
        }, 1000);
    }
    function stopTurnTimer() {
        if (turnTimerInterval) { clearInterval(turnTimerInterval); turnTimerInterval = null; }
        $('turn-timer').classList.remove('show', 'warning', 'danger');
    }

    // ─── Host-only actions ──────────────────────────────────────────
    function confirmEnd() {
        const msg = inLobby
            ? 'Cancel this lobby? Players will be kicked out and the game removed.'
            : 'End this game for everyone? Final scores will be recorded.';
        if (!confirm(msg)) return;
        socket.emit('cah:hostEnd', { gameId: GAME_ID });
    }
    function kickPlayer(userId, name) {
        if (!confirm(`Kick ${name} from the game?`)) return;
        socket.emit('cah:hostKick', { gameId: GAME_ID, targetUserId: userId });
    }

    // Countdown (existing 10s-warning banner — kept for the explicit warning)
    const cdBanner = $('countdown-banner'); const cdText = $('countdown-text'); let cdTimer = null;
    socket.on('cah:timeoutWarning', (p) => {
        if (isCzar && p.phase === 'JUDGING') showCountdown(p.secondsLeft);
        else if (!isCzar && p.phase === 'SUBMITTING' && !selectedIds.length) showCountdown(p.secondsLeft);
    });
    function showCountdown(secs) {
        if (cdTimer) clearInterval(cdTimer);
        cdBanner.style.display = 'block';
        let n = secs;
        cdText.textContent = n + ' seconds left to play.';
        cdTimer = setInterval(() => {
            n--;
            if (n <= 0) { clearInterval(cdTimer); cdBanner.style.display = 'none'; }
            else cdText.textContent = n + ' seconds left to play.';
        }, 1000);
    }
    ['cah:roundStarted', 'cah:judgingStarted', 'cah:gameEnded'].forEach(ev =>
        socket.on(ev, () => { if (cdTimer) clearInterval(cdTimer); cdBanner.style.display = 'none'; })
    );

    // Chat
    const chatMessages = $('chat-messages'); const chatInput = $('chat-input');
    let chatHasMsgs = false;
    function appendChat({ from, isPlayer, text, ts }) {
        if (!chatHasMsgs) { chatMessages.replaceChildren(); chatHasMsgs = true; }
        const wasNearBottom = chatMessages.scrollHeight - chatMessages.scrollTop - chatMessages.clientHeight < 80;
        const msg = el('div', { class: 'chat-msg' + (isPlayer ? '' : ' spectator') },
            el('span', { class: 'from' }, from),
            el('span', { class: 'time' }, new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })),
            el('div', { class: 'body' }, text)
        );
        chatMessages.appendChild(msg);
        if (wasNearBottom) chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    socket.on('cah:chat', appendChat);
    function sendChat() {
        const text = chatInput.value.trim();
        if (!text) return;
        socket.emit('cah:chat:send', { gameId: GAME_ID, text });
        chatInput.value = '';
    }
    $('chat-send').onclick = sendChat;
    chatInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendChat(); });

    renderPlayers(INITIAL.players);
    renderBlack(blackCard);

    // Invite link: copies this game's address.
    $('btn-copy-link').onclick = async () => {
        const btn = $('btn-copy-link');
        try { await navigator.clipboard.writeText(location.origin + '/cah/' + GAME_ID); btn.textContent = 'Link copied'; }
        catch (_) { window.prompt('Copy this link:', location.origin + '/cah/' + GAME_ID); }
        setTimeout(() => { btn.textContent = 'Copy invite link'; }, 2000);
    };

    // ─── Confetti (tiny pure-canvas implementation) ──────────────────
    function fireConfetti() {
        const canvas = document.getElementById('confetti-canvas');
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        canvas.classList.add('firing');
        const ctx = canvas.getContext('2d');
        const colors = ['#ffffff', '#23f56b', '#fbbf24', '#ec4899', '#60a5fa', '#ef4444'];
        const pieces = Array.from({ length: 120 }, () => ({
            x: window.innerWidth / 2, y: window.innerHeight / 3,
            vx: (Math.random() - 0.5) * 12, vy: (Math.random() - 1) * 14 - 6,
            rot: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.3,
            size: 6 + Math.random() * 6, color: colors[Math.floor(Math.random() * colors.length)]
        }));
        const start = Date.now();
        function tick() {
            const t = Date.now() - start;
            if (t > 3500) { canvas.classList.remove('firing'); return; }
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (const p of pieces) {
                p.vy += 0.4;   // gravity
                p.x += p.vx; p.y += p.vy; p.rot += p.vr;
                ctx.save();
                ctx.translate(p.x, p.y); ctx.rotate(p.rot);
                ctx.fillStyle = p.color;
                ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
                ctx.restore();
            }
            requestAnimationFrame(tick);
        }
        tick();
    }
</script>
<canvas id="confetti-canvas"></canvas>
<%- include('partials/site-footer') %>
</body>
</html>
