<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>OBS Overlay — <%= broadcaster.login %></title>
    <meta http-equiv="refresh" content="30">
    <style>
        html, body { margin: 0; padding: 0; background: transparent !important; color: #fff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; overflow: hidden; }
        .wrap { padding: 1.5rem; }
        .stat { background: rgba(0, 0, 0, 0.55); border-left: 3px solid #9146ff; padding: 0.5rem 0.9rem; border-radius: 4px; backdrop-filter: blur(2px); margin-bottom: 0.75rem; max-width: 400px; }
        .stat .label { font-size: 0.6rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.08em; }
        .stat .value { font-size: 1.8rem; font-weight: 700; line-height: 1.1; text-shadow: 0 2px 8px rgba(0,0,0,0.9); }
        .stat.live { border-left-color: #ec4899; }
        .stat.goal { border-left-color: #e2b23a; }
        .stat.charity { border-left-color: #ec4899; }
        .goal-bar { height: 3px; background: rgba(255,255,255,0.15); margin-top: 0.3rem; border-radius: 2px; overflow: hidden; }
        .goal-bar .fill { height: 100%; background: linear-gradient(90deg, #4ade80, #86efac); transition: width 0.5s; }
        /* Ticker variant */
        .ticker { display: flex; align-items: center; height: 60px; max-width: 100vw; overflow: hidden; }
        .ticker-item { background: rgba(0, 0, 0, 0.7); border-radius: 4px; padding: 0.5rem 0.9rem; margin-right: 1rem; white-space: nowrap; backdrop-filter: blur(2px); }
        .ticker-item .label { font-size: 0.6rem; color: rgba(255,255,255,0.6); text-transform: uppercase; }
        .ticker-item .name { font-size: 1.1rem; font-weight: 600; }
        /* Hype train bar variant */
        .hype-container { background: rgba(0, 0, 0, 0.7); border-radius: 8px; padding: 0.8rem 1.1rem; max-width: 500px; backdrop-filter: blur(2px); border: 1px solid rgba(236, 72, 153, 0.4); }
        .hype-container .label { font-size: 0.72rem; color: rgba(255,255,255,0.75); text-transform: uppercase; margin-bottom: 0.3rem; }
        .hype-container .lvl { font-size: 1.5rem; font-weight: 700; }
        .hype-container .pbar { height: 10px; background: rgba(255,255,255,0.15); border-radius: 5px; overflow: hidden; margin-top: 0.5rem; }
        .hype-container .pbar .fill { height: 100%; background: linear-gradient(90deg, #ec4899, #f9a8d4); }
        /* Chat velocity variant */
        .chat-meter { background: rgba(0, 0, 0, 0.7); border-radius: 8px; padding: 0.7rem 1rem; max-width: 300px; backdrop-filter: blur(2px); display: flex; align-items: center; gap: 0.8rem; border-left: 3px solid #22d3ee; }
        .chat-meter .bars { display: flex; gap: 2px; align-items: flex-end; height: 32px; }
        .chat-meter .bars .bar { width: 4px; background: #22d3ee; border-radius: 1px; }
        .chat-meter .num { font-size: 1.4rem; font-weight: 700; }
        .chat-meter .num small { font-size: 0.6rem; color: rgba(255,255,255,0.5); }
        /* Charity thermometer variant */
        .therm { background: rgba(0, 0, 0, 0.7); border-radius: 10px; padding: 1rem 1.2rem; max-width: 400px; backdrop-filter: blur(2px); border: 1px solid rgba(236, 72, 153, 0.4); }
        .therm .label { font-size: 0.7rem; color: rgba(255,255,255,0.75); text-transform: uppercase; }
        .therm .cause { font-size: 1.1rem; font-weight: 700; margin-top: 0.3rem; }
        .therm .amt { font-size: 1.8rem; font-weight: 700; color: #ec4899; margin-top: 0.3rem; }
        .therm .pbar { height: 8px; background: rgba(255,255,255,0.15); border-radius: 4px; overflow: hidden; margin-top: 0.5rem; }
        .therm .pbar .fill { height: 100%; background: linear-gradient(90deg, #ec4899, #f9a8d4); }
    </style>
</head>
<body>
<% const fmt = n => Number(n || 0).toLocaleString(); const money = (a) => { if (!a) return '0'; const dp = Number.isFinite(Number(a.decimal_places)) ? Number(a.decimal_places) : 2; const v = Number(a.value || 0) / Math.pow(10, dp); try { return new Intl.NumberFormat('en-US', { style: 'currency', currency: String(a.currency || 'USD').toUpperCase(), maximumFractionDigits: 0 }).format(v); } catch (e) { return '$' + Math.round(v).toLocaleString('en-US'); } }; %>
<div class="wrap">
    <% if (layout === 'stats' || !layout) { %>
        <%
            // Default: stacked stats widget (live viewers, followers, subs, goals, charity)
        %>
        <% if (liveStream) { %>
        <div class="stat live"><div class="label">Live viewers</div><div class="value"><%= fmt(liveStream.viewer_count) %></div></div>
        <% } %>
        <% if (summary.follower_count != null) { %>
        <div class="stat"><div class="label">Followers</div><div class="value"><%= fmt(summary.follower_count) %></div></div>
        <% } %>
        <% if (summary.subscriber_count != null) { %>
        <div class="stat"><div class="label">Active subscribers</div><div class="value"><%= fmt(summary.subscriber_count) %></div></div>
        <% } %>
        <% if (activeGoals && activeGoals.length) { %>
        <% activeGoals.slice(0, 2).forEach(g => { const pct = g.target_amount ? Math.min(100, 100 * (g.current_amount || 0) / g.target_amount) : 0; %>
        <div class="stat goal">
            <div class="label"><%= g.description || g.goal_type || 'Goal' %></div>
            <div class="value" style="font-size: 1.2rem;"><%= fmt(g.current_amount) %> / <%= fmt(g.target_amount) %></div>
            <div class="goal-bar"><div class="fill" style="width: <%= pct.toFixed(1) %>%"></div></div>
        </div>
        <% }) %>
        <% } %>
        <% if (charity && charity.charity_name) { %>
        <div class="stat charity">
            <div class="label">💝 <%= charity.charity_name %></div>
            <div class="value" style="font-size: 1.2rem;"><%= money(charity.current_amount) %> / <%= money(charity.target_amount) %></div>
            <div class="goal-bar"><div class="fill" style="width: <%= Math.min(100, 100 * (charity.current_amount?.value || 0) / Math.max(1, charity.target_amount?.value || 1)).toFixed(1) %>%"></div></div>
        </div>
        <% } %>

    <% } else if (layout === 'ticker') { %>
        <!-- Recent follower ticker — scrolling horizontal strip of latest followers -->
        <div class="ticker">
            <% (recentFollowers || []).slice(0, 10).forEach(f => { %>
            <div class="ticker-item">
                <div class="label">New follow</div>
                <div class="name">💜 <%= f.name %></div>
            </div>
            <% }) %>
            <% if (!(recentFollowers && recentFollowers.length)) { %>
            <div class="ticker-item" style="opacity: 0.5;"><div class="label">—</div><div class="name">No recent follows</div></div>
            <% } %>
        </div>

    <% } else if (layout === 'hype') { %>
        <!-- Hype train progress bar — only renders when a hype train is live or recent -->
        <% if (hypeTrain) { const prog = hypeTrain.goal ? Math.min(100, 100 * (hypeTrain.progress || 0) / hypeTrain.goal) : 0; %>
        <div class="hype-container">
            <div class="label">Hype train · level <%= hypeTrain.level %></div>
            <div class="lvl"><%= fmt(hypeTrain.progress) %> / <%= fmt(hypeTrain.goal) %></div>
            <div class="pbar"><div class="fill" style="width: <%= prog.toFixed(1) %>%"></div></div>
        </div>
        <% } else { %>
        <div style="opacity: 0;">no hype</div>
        <% } %>

    <% } else if (layout === 'chat') { %>
        <!-- Chat velocity meter — current chat rate (msgs/min) -->
        <%
            const avgRate = chatVelocity.length ? (chatVelocity[chatVelocity.length - 1]?.msgs || 0) : 0;
            // Build 20 bars representing recent minutes.
            const bars = chatVelocity.slice(-20);
            const maxBar = bars.reduce((m, p) => Math.max(m, p.msgs || 0), 1);
        %>
        <div class="chat-meter">
            <div class="bars">
                <% for (const p of bars) { const h = Math.max(2, 32 * ((p.msgs || 0) / maxBar)); %>
                <div class="bar" style="height: <%= h %>px;"></div>
                <% } %>
            </div>
            <div class="num"><%= fmt(avgRate) %><small>/min</small></div>
        </div>

    <% } else if (layout === 'ai-copy') { %>
        <!-- AI-generated overlay caption, regenerated on each 30s refresh -->
        <% if (aiCaption) { %>
        <div class="stat" style="border-left-color: #22d3ee;">
            <div class="label">🤖 Live caption</div>
            <div class="value" style="font-size: 1.3rem; line-height: 1.3;"><%= aiCaption %></div>
        </div>
        <% } %>

    <% } else if (layout === 'charity') { %>
        <!-- Charity thermometer — big visual push toward a target -->
        <% if (charity && charity.charity_name) { const pct = Math.min(100, 100 * (charity.current_amount?.value || 0) / Math.max(1, charity.target_amount?.value || 1)); %>
        <div class="therm">
            <div class="label">💝 Charity campaign</div>
            <div class="cause"><%= charity.charity_name %></div>
            <div class="amt"><%= money(charity.current_amount) %></div>
            <div class="pbar"><div class="fill" style="width: <%= pct.toFixed(1) %>%"></div></div>
            <div style="font-size: 0.75rem; color: rgba(255,255,255,0.6); margin-top: 0.3rem;">of <%= money(charity.target_amount) %> goal · <%= pct.toFixed(0) %>%</div>
        </div>
        <% } %>
    <% } %>
</div>
</body>
</html>
