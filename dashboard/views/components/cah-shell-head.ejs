<%# CAH-specific head pieces (page header, pills, the feedback dialog) on top of the design-system
    tokens. Each CAH page includes this first in <head> and partials/site-head.ejs last, which
    brings the meta tags, the csrf-token meta (read by the cfetch() wrapper), the theme scripts,
    /css/cf-ui.css and /css/cf-site.css. %>
<link rel="apple-touch-icon" href="/images/CertiFried.png">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
        background: var(--cf-bg, var(--bg-primary));
        color: var(--cf-text, var(--text-primary));
        line-height: 1.55;
        min-height: 100vh;
    }
    a { color: var(--cf-accent-fg); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .btn:hover, .cfs-header a:hover, .cf-section-tabs a:hover, .lobby-card:hover, .pack-tile:hover { text-decoration: none; }

    .container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
    @media (max-width: 600px) { .container { padding: 0 16px; } }

    /* Breadcrumbs (sub-pages) */
    .breadcrumbs { display: flex; align-items: center; gap: 6px; padding-top: 16px; color: var(--cf-text-3); font-size: var(--cf-text-sm); flex-wrap: wrap; }
    .breadcrumbs a { color: var(--cf-text-2); }
    .breadcrumbs .sep { opacity: 0.5; }
    .breadcrumbs .current { color: var(--cf-text); font-weight: 500; }

    /* Feedback button + dialog */
    .feedback-fab {
        position: fixed; bottom: 16px; right: 16px; z-index: 90;
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 999px; cursor: pointer;
        background: var(--cf-surface-2); color: var(--cf-text);
        border: 1px solid var(--cf-border-strong); box-shadow: var(--cf-shadow-pop, 0 8px 24px rgb(0 0 0 / .35));
        font: 500 var(--cf-text-sm)/1.2 var(--cf-font);
    }
    .feedback-fab:hover { background: var(--cf-surface-3); }
    .feedback-fab svg { width: 15px; height: 15px; }
    .feedback-mask { position: fixed; inset: 0; background: rgb(0 0 0 / 0.6); display: none; align-items: center; justify-content: center; z-index: 1100; padding: 16px; }
    .feedback-mask.open { display: flex; }
    .feedback-modal { background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-lg); max-width: 480px; width: 100%; padding: 20px; }
    .feedback-modal h3 { font-size: var(--cf-text-lg); font-weight: 600; margin-bottom: 4px; }
    .feedback-modal p { color: var(--cf-text-2); font-size: var(--cf-text-sm); margin-bottom: 12px; }
    .feedback-modal textarea { width: 100%; min-height: 110px; }
    .feedback-modal .acts { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
    .feedback-error { color: var(--cf-danger); font-size: var(--cf-text-sm); margin-top: 8px; display: none; }
    .feedback-toast {
        position: fixed; bottom: 64px; right: 16px; z-index: 95; display: none;
        padding: 10px 14px; border-radius: var(--cf-radius-lg); font-size: var(--cf-text-sm); font-weight: 500;
        background: var(--cf-surface); color: var(--cf-text); border: 1px solid var(--cf-border-strong); box-shadow: var(--cf-shadow-pop, none);
    }
    .feedback-toast.show { display: block; }
    @media (max-width: 600px) { .feedback-fab .fab-label { display: none; } .feedback-fab { padding: 10px; } }

    /* Buttons: cf-ui.css styles .btn / .btn-primary / .btn-danger. These map the
       CAH-only variants onto it. */
    .btn { cursor: pointer; font-family: inherit; }
    .btn.btn-outline { --bs-btn-bg: var(--cf-surface-2); --bs-btn-border-color: var(--cf-border-strong); }
    .btn.btn-ghost { --bs-btn-bg: transparent; --bs-btn-border-color: transparent; --bs-btn-hover-bg: var(--cf-surface-2); --bs-btn-hover-border-color: transparent; color: var(--cf-text-2); }
    .btn.btn-ghost:hover { color: var(--cf-text); }

    /* Panels */
    .card { padding: 20px; }
    .card-title { font-size: var(--cf-text-lg); font-weight: 600; margin-bottom: 6px; }
    .card-subtle { color: var(--cf-text-2); font-size: var(--cf-text-sm); }

    /* Form elements */
    .form-group { margin-bottom: 14px; }
    .form-label { display: block; margin-bottom: 6px; }
    .form-input, .form-select, .form-textarea { width: 100%; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }
    .form-check { display: flex; align-items: center; gap: 8px; padding: 6px 0; cursor: pointer; }
    .form-check input[type=checkbox] { accent-color: var(--cf-accent); width: 16px; height: 16px; cursor: pointer; }

    /* Pills */
    .pill {
        display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px;
        background: var(--cf-surface-2); color: var(--cf-text-2); font-size: var(--cf-text-xs); font-weight: 500;
        border: 1px solid var(--cf-border); white-space: nowrap;
    }
    .pill-purple { background: var(--cf-accent-soft); color: var(--cf-accent-fg); border-color: color-mix(in srgb, var(--cf-accent) 35%, transparent); }
    .pill-green { background: color-mix(in srgb, var(--cf-success) 14%, transparent); color: var(--cf-success); border-color: color-mix(in srgb, var(--cf-success) 35%, transparent); }
    .pill-red { background: color-mix(in srgb, var(--cf-danger) 14%, transparent); color: var(--cf-danger); border-color: color-mix(in srgb, var(--cf-danger) 35%, transparent); }
    .pill-amber { background: color-mix(in srgb, var(--cf-warning) 14%, transparent); color: var(--cf-warning); border-color: color-mix(in srgb, var(--cf-warning) 35%, transparent); }

    /* Page header */
    .page-header { padding: 28px 0 20px; }
    .page-header h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; }
    .page-header .subtitle { color: var(--cf-text-3); margin-top: 4px; font-size: var(--cf-text-md); }

    /* Inline status line */
    .toast { padding: 8px 12px; background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); font-size: var(--cf-text-sm); color: var(--cf-text-2); }
    .toast.ok { color: var(--cf-success); border-color: color-mix(in srgb, var(--cf-success) 35%, transparent); }
    .toast.err { color: var(--cf-danger); border-color: color-mix(in srgb, var(--cf-danger) 35%, transparent); }
</style>
<script>
    // Shared fetch wrapper: attaches the CSRF token to every non-GET request.
    // Every CAH page uses this in place of bare fetch() so the dashboard's
    // csrfProtection middleware doesn't 403 us.
    window.cfetch = function(url, options = {}) {
        const method = (options.method || 'GET').toUpperCase();
        const needsCsrf = method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS';
        const headers = { ...(options.headers || {}) };
        if (needsCsrf) {
            const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
            if (token) headers['x-csrf-token'] = token;
        }
        return fetch(url, { ...options, headers, credentials: 'same-origin' });
    };
</script>
