<%# CAH header: the shared site header (partials/site-header.ejs, styled by
    /css/cf-site.css) plus the CAH section tabs. Pass { user, page } where page is one of
    'lobbies','my-decks','packs','history','leaderboard','game','config'. %>
<%
const cahPage = (typeof page !== 'undefined') ? page : '';
const cahUser = (typeof user !== 'undefined' && user) ? user : null;
%>
<%- include('../partials/site-header', { user: cahUser, active: 'cah', returnTo: '/cah' }) %>
<%- include('../partials/section-tabs', { label: 'Cards Against Humanity', active: cahPage, tabs: [
    ['lobbies', '/cah', 'Lobbies'],
    ['my-decks', '/cah/my-decks', 'My decks'],
    ['packs', '/cah/packs', 'Card packs'],
    ['history', '/cah/my-history', 'My games'],
    ['leaderboard', '/cah/leaderboard', 'Leaderboard']
] }) %>

<%# Feedback button on every CAH page. Opens a dialog, POSTs to /cah/feedback,
    which relays to a Discord webhook (admin-configurable). The route needs a
    Discord login, so guests don't get the button. %>
<% if (cahUser) { %>
<button class="feedback-fab" type="button" id="cah-feedback-open" aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span class="fab-label">Feedback</span>
</button>
<div class="feedback-mask" id="feedback-mask">
    <div class="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="feedback-title">
        <h3 id="feedback-title">Send feedback or report a bug</h3>
        <p>Say what broke or what could be better. It goes to the developers' channel.</p>
        <label class="form-label" for="feedback-text">Message</label>
        <textarea id="feedback-text" class="form-textarea" placeholder="What happened, and what were you doing?" maxlength="2000"></textarea>
        <div class="feedback-error" id="feedback-error" role="alert"></div>
        <div class="acts">
            <button class="btn btn-ghost" type="button" id="feedback-cancel">Cancel</button>
            <button class="btn btn-primary" type="button" id="feedback-send">Send</button>
        </div>
    </div>
</div>
<div class="feedback-toast" id="feedback-toast" role="status" aria-live="polite">Thanks, it has been sent.</div>
<% } %>
<script>
(function () {
    // Log-in links come back to the CAH page they were clicked on (a game, a deck…).
    document.querySelectorAll('a[href^="/auth/discord?returnTo="]').forEach(function (a) {
        a.href = '/auth/discord?returnTo=' + encodeURIComponent(location.pathname + location.search);
    });

    var mask = document.getElementById('feedback-mask');
    if (!mask) return;
    var text = document.getElementById('feedback-text');
    var errEl = document.getElementById('feedback-error');
    function openFb() { mask.classList.add('open'); errEl.style.display = 'none'; setTimeout(function () { text.focus(); }, 30); }
    function closeFb() { mask.classList.remove('open'); }
    document.getElementById('cah-feedback-open').addEventListener('click', openFb);
    document.getElementById('feedback-cancel').addEventListener('click', closeFb);
    mask.addEventListener('click', function (e) { if (e.target === mask) closeFb(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && mask.classList.contains('open')) closeFb(); });
    var sendBtn = document.getElementById('feedback-send');
    sendBtn.addEventListener('click', async function () {
        var msg = text.value.trim();
        if (!msg) { errEl.textContent = 'Write a message first.'; errEl.style.display = 'block'; return; }
        sendBtn.disabled = true;
        try {
            var res = await cfetch('/cah/feedback', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: msg, page: location.pathname, ua: navigator.userAgent })
            });
            var data = await res.json().catch(function () { return {}; });
            if (res.ok && !res.redirected && data.ok === true) {
                closeFb();
                text.value = '';
                var t = document.getElementById('feedback-toast');
                t.classList.add('show');
                setTimeout(function () { t.classList.remove('show'); }, 3500);
            } else {
                errEl.textContent = data.reason === 'rate_limited' ? 'You have sent a lot of feedback recently. Try again later.' : 'Could not send it. Try again in a moment.';
                errEl.style.display = 'block';
            }
        } catch (_) {
            errEl.textContent = 'Could not send it. Check your connection and try again.';
            errEl.style.display = 'block';
        } finally {
            sendBtn.disabled = false;
        }
    });
})();
</script>
