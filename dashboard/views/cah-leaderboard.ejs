<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<style>
    .hero { padding: 24px 0 16px; }
    .hero h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; }
    .hero p { color: var(--cf-text-3); margin-top: 4px; font-size: var(--cf-text-md); }
    .hero code { background: var(--cf-surface-2); padding: 1px 6px; border-radius: var(--cf-radius-sm); font-size: 0.85em; }

    .panel { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); min-width: 0; }
    .panel-head { padding: 12px 16px; border-bottom: 1px solid var(--cf-border); font-size: var(--cf-text-md); font-weight: 600; }
    .panel-body { padding: 12px 16px; }

    .leaderboard-table { width: 100%; border-collapse: collapse; }
    .leaderboard-table th { padding: 8px 16px; text-align: left; color: var(--cf-text-3); font-size: var(--cf-text-xs); font-weight: 500; border-bottom: 1px solid var(--cf-border); white-space: nowrap; }
    .leaderboard-table td { padding: 10px 16px; border-bottom: 1px solid var(--cf-border); font-size: var(--cf-text-sm); font-variant-numeric: tabular-nums; }
    .leaderboard-table tr:last-child td { border-bottom: none; }
    .leaderboard-table tbody tr:hover td { background: var(--cf-surface-2); }
    .leaderboard-table .num { text-align: right; }
    .rank { width: 56px; color: var(--cf-text-3); font-weight: 600; }
    .rank-badge { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; font-size: var(--cf-text-xs); font-weight: 700; background: var(--cf-surface-2); color: var(--cf-text-2); }
    .rank-1 .rank-badge { background: color-mix(in srgb, #d4a514 22%, transparent); color: #d4a514; }
    .rank-2 .rank-badge { background: color-mix(in srgb, #9aa3ad 22%, transparent); color: #9aa3ad; }
    .rank-3 .rank-badge { background: color-mix(in srgb, #b8733a 22%, transparent); color: #b8733a; }
    /* Light and Sand: the medal colours as text, darkened toward the ink so they read on their own tint. */
    :root:is([data-theme="light"], [data-theme="sand"]) .rank-1 .rank-badge { color: color-mix(in srgb, #d4a514 55%, var(--cf-text)); }
    :root:is([data-theme="light"], [data-theme="sand"]) .rank-2 .rank-badge { color: color-mix(in srgb, #9aa3ad 55%, var(--cf-text)); }
    :root:is([data-theme="light"], [data-theme="sand"]) .rank-3 .rank-badge { color: color-mix(in srgb, #b8733a 55%, var(--cf-text)); }
    .player-name { font-weight: 500; overflow-wrap: anywhere; }
    .wins { font-weight: 600; }
    .winrate { color: var(--cf-text-2); }
    @media (max-width: 560px) {
        .leaderboard-table .opt-col { display: none; }
        .leaderboard-table th, .leaderboard-table td { padding-left: 10px; padding-right: 10px; }
    }
    .empty-state { text-align: center; padding: 40px 16px; color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .empty-state strong { display: block; color: var(--cf-text); font-size: var(--cf-text-md); margin-bottom: 4px; }

    .layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 20px; padding-bottom: 72px; }
    @media (max-width: 900px) { .layout { grid-template-columns: minmax(0, 1fr); } }

    .recent-list { display: flex; flex-direction: column; gap: 8px; list-style: none; }
    .recent-item { padding: 10px 12px; background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); font-size: var(--cf-text-sm); display: flex; flex-direction: column; gap: 2px; }
    .recent-item .winners-line { color: var(--cf-text); font-weight: 500; overflow-wrap: anywhere; }
    .recent-item .winners-line .none { color: var(--cf-text-3); font-weight: 400; }
    .recent-item .sub { color: var(--cf-text-3); font-size: var(--cf-text-xs); }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Leaderboard · Cards Against Humanity · CertiFried', description: 'Cards Against Humanity on CertiFried: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'leaderboard' }) %>

<main class="container" id="main-content">
    <section class="hero">
        <h1>Leaderboard</h1>
        <p>
            <% if (typeof guildScope !== 'undefined' && guildScope) { %>
                Games played in server <code><%= guildScope %></code>. <a href="/cah/leaderboard">Show all servers</a>
            <% } else { %>
                Top 100 players by wins across all finished games.
            <% } %>
        </p>
    </section>

    <div class="layout">
        <section class="panel" aria-labelledby="lb-title">
            <h2 class="panel-head" id="lb-title">Players<% if (ranked && ranked.length) { %> <span style="color: var(--cf-text-3); font-weight: 500;"><%= ranked.length %></span><% } %></h2>
            <% if (ranked && ranked.length > 0) { %>
                <table class="leaderboard-table">
                    <thead>
                        <tr>
                            <th class="rank" scope="col">Rank</th>
                            <th scope="col">Player</th>
                            <th class="num" scope="col">Wins</th>
                            <th class="num opt-col" scope="col">Games</th>
                            <th class="num opt-col" scope="col">Points</th>
                            <th class="num" scope="col">Win rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% ranked.forEach((p, i) => { %>
                            <tr>
                                <td class="rank rank-<%= i+1 %>"><span class="rank-badge"><%= i+1 %></span></td>
                                <td class="player-name"><%= p.displayName %></td>
                                <td class="num wins"><%= p.wins %></td>
                                <td class="num opt-col"><%= p.games %></td>
                                <td class="num opt-col"><%= p.totalPoints %></td>
                                <td class="num winrate"><%= p.games > 0 ? Math.round(100 * p.wins / p.games) + '%' : '—' %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="empty-state">
                    <strong>No finished games yet</strong>
                    Wins show up here as soon as a game ends. <a href="/cah">Find a game</a>
                </div>
            <% } %>
        </section>

        <aside class="panel" aria-labelledby="recent-title">
            <h2 class="panel-head" id="recent-title">Recent games</h2>
            <div class="panel-body">
            <% if (recent && recent.length > 0) { %>
                <ul class="recent-list">
                    <% recent.forEach(g => { %>
                        <li class="recent-item">
                            <div class="winners-line">
                                <% if (!g.winners || g.winners.length === 0) { %>
                                    <span class="none">No winner recorded</span>
                                <% } else { %>
                                    Won by <%= g.winners.map(w => w.displayName).join(', ') %>
                                <% } %>
                            </div>
                            <span class="sub">
                                <% if (g.endedAt) { %><time datetime="<%= new Date(g.endedAt).toISOString() %>" data-local-time><%= new Date(g.endedAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time><% } else { %>In progress<% } %>
                                · game <%= g.id.slice(0, 8) %>
                            </span>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <div class="empty-state" style="padding: 16px;">No games yet.</div>
            <% } %>
            </div>
        </aside>
    </div>
</main>
<script>
    // Show finish times in the viewer's own time zone.
    document.querySelectorAll('time[data-local-time]').forEach(t => {
        const d = new Date(t.getAttribute('datetime'));
        if (!isNaN(d)) t.textContent = d.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
    });
</script>
<%- include('partials/site-footer') %>
</body>
</html>