<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>4:20 World Clock — OBS overlay</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    /* Transparent by default so OBS composites it over your scene.
       Add ?bg=dark for a solid panel, or ?bg=<hex> for a custom color. */
    html,body{background:transparent;width:100%;height:100%;overflow:hidden}
    body{font-family:'Inter',system-ui,sans-serif;color:var(--ink,#f1f0f6);display:flex;align-items:center;justify-content:center}
    .ftt{
      --accent:#7dfc4f;--accent2:#7c84ff;--ink:#f1f0f6;--muted:#b9b4d0;
      width:100%;max-width:640px;margin:1rem;padding:1.4rem 1.6rem;border-radius:22px;text-align:center;
      background:var(--panel,transparent);border:var(--panelBorder,none);
      text-shadow:0 2px 8px rgba(0,0,0,.55); /* readable over any scene when transparent */
    }
    body.solid .ftt{text-shadow:none}
    .ftt-head{display:flex;align-items:center;justify-content:center;gap:.5rem;font-size:.8rem;color:var(--muted);margin-bottom:.9rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700}
    .ftt-head b{color:var(--accent);font-family:'Space Grotesk',sans-serif;font-weight:700}
    .ftt-leaf{font-size:1.05rem}
    .ftt-now{font-size:1.1rem;line-height:1.45;margin-bottom:.85rem;min-height:1.5rem}
    .ftt-now .place{font-family:'Space Grotesk',sans-serif;font-weight:700;color:var(--ink)}
    .ftt-now.lit{color:#bfffb2}
    .ftt-now.lit .place{color:#e2ffd9}
    .ftt-clock{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(2.6rem,9vw,4.2rem);letter-spacing:.02em;line-height:1;background:linear-gradient(100deg,var(--accent),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
    .ftt-sub{color:var(--muted);font-size:.86rem;margin-top:.5rem}
    .ftt-sub b{color:#dfe1ff}
    .ftt-ticker{display:flex;flex-wrap:wrap;justify-content:center;gap:.4rem .55rem;margin-top:1.1rem}
    .ftt-ticker .chip{font-size:.72rem;color:var(--muted);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:.25rem .65rem;white-space:nowrap}
    .ftt-ticker .chip b{color:#dfe1ff;font-weight:600}
    body.noticker .ftt-ticker{display:none}
    @keyframes fttpulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
    .ftt.islit .ftt-clock{animation:fttpulse 1.5s ease-in-out infinite}
  </style>
</head>
<body>
  <div class="ftt" id="ftt">
    <div class="ftt-head"><span class="ftt-leaf">🍃</span> Where in the world is it <b>4:20</b>?</div>
    <div class="ftt-now" id="ftt-now">Syncing the globe…</div>
    <div class="ftt-clock" id="ftt-clock">--:--:--</div>
    <div class="ftt-sub" id="ftt-sub">until the next 4:20</div>
    <div class="ftt-ticker" id="ftt-ticker"></div>
  </div>

  <script>
  (function () {
    // ---- Query-string options (so you can tune it from the OBS URL) ----
    //   ?bg=dark            solid dark panel instead of transparent
    //   ?bg=112233          custom hex panel background
    //   ?accent=ff8800      main gradient/leaf color
    //   ?ticker=0           hide the upcoming-zones row
    //   ?scale=1.4          zoom the whole widget (default 1)
    var q = new URLSearchParams(location.search);
    var root = document.getElementById('ftt');
    var bg = (q.get('bg') || '').toLowerCase();
    if (bg && bg !== 'transparent' && bg !== 'none') {
      document.body.classList.add('solid');
      var color = bg === 'dark' ? 'rgba(12,11,20,.82)' : ('#' + bg.replace(/[^0-9a-f]/gi, ''));
      root.style.setProperty('--panel', color);
      root.style.setProperty('--panelBorder', '1px solid rgba(255,255,255,.10)');
    }
    if (q.get('accent')) root.style.setProperty('--accent', '#' + q.get('accent').replace(/[^0-9a-f]/gi, ''));
    if (q.get('accent2')) root.style.setProperty('--accent2', '#' + q.get('accent2').replace(/[^0-9a-f]/gi, ''));
    if (q.get('ticker') === '0' || q.get('ticker') === 'false') document.body.classList.add('noticker');
    var scale = parseFloat(q.get('scale'));
    if (scale && scale > 0) root.style.transform = 'scale(' + scale + ')';

    // ---- Zones spanning (almost) every UTC offset. IANA names => Intl
    //      handles DST for us; we just read each zone's real clock per second.
    var ZONES = [
      { tz: 'Pacific/Kiritimati',   label: 'Kiritimati, Kiribati',     flag: '🇰🇮' },
      { tz: 'Pacific/Auckland',     label: 'Auckland, New Zealand',    flag: '🇳🇿' },
      { tz: 'Pacific/Chatham',      label: 'Chatham Islands',          flag: '🇳🇿' },
      { tz: 'Australia/Sydney',     label: 'Sydney, Australia',        flag: '🇦🇺' },
      { tz: 'Australia/Adelaide',   label: 'Adelaide, Australia',      flag: '🇦🇺' },
      { tz: 'Asia/Tokyo',           label: 'Tokyo, Japan',             flag: '🇯🇵' },
      { tz: 'Asia/Seoul',           label: 'Seoul, South Korea',       flag: '🇰🇷' },
      { tz: 'Australia/Eucla',      label: 'Eucla, Australia',         flag: '🇦🇺' },
      { tz: 'Asia/Shanghai',        label: 'Shanghai, China',          flag: '🇨🇳' },
      { tz: 'Asia/Singapore',       label: 'Singapore',                flag: '🇸🇬' },
      { tz: 'Asia/Bangkok',         label: 'Bangkok, Thailand',        flag: '🇹🇭' },
      { tz: 'Asia/Yangon',          label: 'Yangon, Myanmar',          flag: '🇲🇲' },
      { tz: 'Asia/Dhaka',           label: 'Dhaka, Bangladesh',        flag: '🇧🇩' },
      { tz: 'Asia/Kathmandu',       label: 'Kathmandu, Nepal',         flag: '🇳🇵' },
      { tz: 'Asia/Kolkata',         label: 'Mumbai, India',            flag: '🇮🇳' },
      { tz: 'Asia/Karachi',         label: 'Karachi, Pakistan',        flag: '🇵🇰' },
      { tz: 'Asia/Kabul',           label: 'Kabul, Afghanistan',       flag: '🇦🇫' },
      { tz: 'Asia/Dubai',           label: 'Dubai, UAE',               flag: '🇦🇪' },
      { tz: 'Asia/Tehran',          label: 'Tehran, Iran',             flag: '🇮🇷' },
      { tz: 'Europe/Moscow',        label: 'Moscow, Russia',           flag: '🇷🇺' },
      { tz: 'Africa/Nairobi',       label: 'Nairobi, Kenya',           flag: '🇰🇪' },
      { tz: 'Europe/Athens',        label: 'Athens, Greece',           flag: '🇬🇷' },
      { tz: 'Europe/Paris',         label: 'Paris, France',            flag: '🇫🇷' },
      { tz: 'Europe/London',        label: 'London, UK',               flag: '🇬🇧' },
      { tz: 'Atlantic/Cape_Verde',  label: 'Cape Verde',               flag: '🇨🇻' },
      { tz: 'America/Noronha',      label: 'Fernando de Noronha',      flag: '🇧🇷' },
      { tz: 'America/Sao_Paulo',    label: 'São Paulo, Brazil',        flag: '🇧🇷' },
      { tz: 'America/St_Johns',     label: "St. John's, Canada",       flag: '🇨🇦' },
      { tz: 'America/New_York',     label: 'New York, USA',            flag: '🇺🇸' },
      { tz: 'America/Chicago',      label: 'Chicago, USA',             flag: '🇺🇸' },
      { tz: 'America/Denver',       label: 'Denver, USA',              flag: '🇺🇸' },
      { tz: 'America/Los_Angeles',  label: 'Los Angeles, USA',         flag: '🇺🇸' },
      { tz: 'America/Anchorage',    label: 'Anchorage, USA',           flag: '🇺🇸' },
      { tz: 'Pacific/Marquesas',    label: 'Marquesas Islands',        flag: '🇵🇫' },
      { tz: 'Pacific/Honolulu',     label: 'Honolulu, Hawaii',         flag: '🇺🇸' },
      { tz: 'Pacific/Pago_Pago',    label: 'Pago Pago, Samoa',         flag: '🇦🇸' },
      { tz: 'Pacific/Niue',         label: 'Niue',                     flag: '🇳🇺' }
    ];

    var AM = 4 * 3600 + 20 * 60;   // 04:20:00
    var PM = 16 * 3600 + 20 * 60;  // 16:20:00
    var DAY = 86400;
    var fmtCache = {};

    function fmt(tz) {
      if (!fmtCache[tz]) {
        fmtCache[tz] = new Intl.DateTimeFormat('en-US', {
          timeZone: tz, hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit'
        });
      }
      return fmtCache[tz];
    }
    function secondsOfDay(tz, now) {
      var parts = fmt(tz).formatToParts(now), h = 0, m = 0, s = 0;
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        if (p.type === 'hour') h = parseInt(p.value, 10);
        else if (p.type === 'minute') m = parseInt(p.value, 10);
        else if (p.type === 'second') s = parseInt(p.value, 10);
      }
      if (h === 24) h = 0;
      return h * 3600 + m * 60 + s;
    }
    function litNow(sod) {
      if (sod >= AM && sod < AM + 60) return 'AM';
      if (sod >= PM && sod < PM + 60) return 'PM';
      return null;
    }
    function nextEntry(sod) {
      var dAM = (AM - sod + DAY) % DAY, dPM = (PM - sod + DAY) % DAY;
      return dAM <= dPM ? { secs: dAM, ap: 'AM' } : { secs: dPM, ap: 'PM' };
    }
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function hhmmss(t) {
      return pad(Math.floor(t / 3600)) + ':' + pad(Math.floor((t % 3600) / 60)) + ':' + pad(t % 60);
    }
    function localClock(tz, now) {
      var sod = secondsOfDay(tz, now), h = Math.floor(sod / 3600), m = Math.floor((sod % 3600) / 60);
      var ap = h < 12 ? 'AM' : 'PM', h12 = h % 12; if (h12 === 0) h12 = 12;
      return h12 + ':' + pad(m) + ' ' + ap;
    }

    var elNow = document.getElementById('ftt-now');
    var elClock = document.getElementById('ftt-clock');
    var elSub = document.getElementById('ftt-sub');
    var elTicker = document.getElementById('ftt-ticker');

    function tick() {
      var now = new Date(), lit = [], upcoming = [];
      for (var i = 0; i < ZONES.length; i++) {
        var z = ZONES[i], sod;
        try { sod = secondsOfDay(z.tz, now); } catch (e) { continue; }
        var l = litNow(sod);
        if (l) lit.push({ z: z, ap: l });
        var ne = nextEntry(sod);
        upcoming.push({ z: z, secs: ne.secs, ap: ne.ap });
      }
      upcoming.sort(function (a, b) { return a.secs - b.secs; });
      var target = null;
      for (var j = 0; j < upcoming.length; j++) { if (upcoming[j].secs > 0) { target = upcoming[j]; break; } }
      if (!target) target = upcoming[0];

      if (lit.length) {
        root.classList.add('islit');
        elNow.classList.add('lit');
        var names = lit.map(function (x) {
          return '<span class="place">' + x.z.flag + ' ' + x.z.label + '</span> (4:20 ' + x.ap + ')';
        });
        var lead = lit.length === 1 ? "🔥 It's <b>4:20</b> right now in " : '🔥 <b>4:20</b> right now in ';
        elNow.innerHTML = lead + names.join(' · ');
      } else {
        root.classList.remove('islit');
        elNow.classList.remove('lit');
        elNow.innerHTML = 'Next up: <span class="place">' + target.z.flag + ' ' + target.z.label +
          '</span> — local time ' + localClock(target.z.tz, now);
      }
      elClock.textContent = hhmmss(target.secs);
      elSub.innerHTML = 'until 4:20 ' + target.ap + ' in <b>' + target.z.flag + ' ' + target.z.label + '</b>';

      var chips = '';
      for (var k = 0; k < upcoming.length && k < 6; k++) {
        var u = upcoming[k];
        chips += '<span class="chip">' + u.z.flag + ' <b>' + u.z.label.split(',')[0] + '</b> ' + hhmmss(u.secs) + '</span>';
      }
      elTicker.innerHTML = chips;
    }
    tick();
    setInterval(tick, 1000);
  })();
  </script>
</body>
</html>
