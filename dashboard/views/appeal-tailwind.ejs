<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: 'Appeal a global ban · CertiFried', description: 'Appeal a CertiFried global ban: see why your account is on the shared ban list and ask for a review.', path: '/appeal', noindex: true }) %>
    <script src="/js/csrf.js"></script>
    <style>
        /* Shared by /appeal and /report: a narrow form page on the site frame. */
        .gb-panel { padding: var(--cf-5); margin-bottom: var(--cf-4); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .gb-panel > h2 { margin: 0 0 var(--cf-2); font-size: var(--cf-text-lg); font-weight: 600; color: var(--cf-text); }
        .gb-panel > p { margin: 0 0 var(--cf-3); font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); }
        .gb-panel > p:last-child { margin-bottom: 0; }
        .gb-state { display: flex; align-items: center; gap: var(--cf-2); margin-bottom: var(--cf-2); }
        .gb-state h2 { margin: 0; font-size: var(--cf-text-lg); font-weight: 600; }
        .gb-field { margin-bottom: var(--cf-4); }
        .gb-field .form-label { display: block; margin-bottom: 6px; }
        .gb-field .form-input, .gb-field .form-select, .gb-field .form-textarea { width: 100%; min-height: 40px; }
        .gb-field .form-textarea { min-height: 140px; resize: vertical; }
        .gb-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--cf-3); }
        @media (max-width: 520px) { .gb-row { grid-template-columns: minmax(0, 1fr); } }
        .gb-hint { margin: 6px 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .gb-count { margin: 4px 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); text-align: right; font-variant-numeric: tabular-nums; }
        .gb-count.is-short { color: var(--cf-warning); }
        .gb-req { color: var(--cf-text-3); font-weight: 400; }
        .gb-alert { margin-bottom: var(--cf-4); padding: var(--cf-3) var(--cf-4); font-size: var(--cf-text-sm); border-radius: var(--cf-radius-lg); border: 1px solid var(--cf-border); background: var(--cf-surface); }
        .gb-alert[hidden] { display: none; }
        .gb-alert.is-ok { color: var(--cf-success); border-color: color-mix(in srgb, var(--cf-success) 40%, var(--cf-border)); }
        .gb-alert.is-bad { color: var(--cf-danger); border-color: color-mix(in srgb, var(--cf-danger) 40%, var(--cf-border)); }
        .gb-details { margin: var(--cf-3) 0 0; padding: 0; }
        .gb-details > div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--cf-3); padding: var(--cf-2) 0; border-top: 1px solid var(--cf-border); }
        .gb-details dt { font-size: var(--cf-text-sm); color: var(--cf-text-3); }
        .gb-details dd { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text); overflow-wrap: anywhere; white-space: pre-wrap; }
        @media (max-width: 520px) { .gb-details > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
        .gb-response { margin-top: var(--cf-3); padding: var(--cf-3) var(--cf-4); background: var(--cf-inset); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); }
        .gb-response h3 { margin: 0 0 4px; font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
        .gb-response p { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); white-space: pre-wrap; overflow-wrap: anywhere; }
        .gb-loading { padding: var(--cf-8) 0; text-align: center; color: var(--cf-text-3); }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', user: locals.user || null, returnTo: '/appeal' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main cfs-main--narrow">
        <div class="cfs-pagehead">
            <h1>Appeal a global ban</h1>
            <p class="cfs-lede">If your account is on CertiFried's shared ban list and you think that is a mistake, ask for a review here.</p>
        </div>

        <% if (!user) { %>
        <section class="gb-panel" aria-labelledby="gb-login-h">
            <h2 id="gb-login-h">Log in to appeal</h2>
            <p>Log in with the Discord account that was banned, so we can find its ban record. You do not need to be in any server.</p>
            <a href="/auth/discord?returnTo=/appeal" class="btn btn-primary">Log in with Discord</a>
        </section>
        <section class="gb-panel" aria-labelledby="gb-dm-h">
            <h2 id="gb-dm-h">Appeal by direct message</h2>
            <p>You can also send the bot a direct message with your reason (at least 20 characters). It replies with the number of your appeal.</p>
        </section>
        <% } else { %>
        <div id="loadingState" class="gb-loading" role="status">Checking your ban status…</div>
        <div id="alertBox" class="gb-alert" role="alert" hidden></div>

        <section id="noBanState" class="gb-panel" hidden aria-labelledby="gb-none-h">
            <div class="gb-state"><span class="cfs-dot cfs-dot--ok" aria-hidden="true"></span><h2 id="gb-none-h">No active global ban</h2></div>
            <p>Your account is not on the global ban list, so there is nothing to appeal.</p>
            <a href="/dashboard" class="btn btn-secondary">Go to the dashboard</a>
        </section>

        <div id="pendingState" hidden>
            <section class="gb-panel" aria-labelledby="gb-pending-h">
                <div class="gb-state"><span class="cfs-dot cfs-dot--warn" aria-hidden="true"></span><h2 id="gb-pending-h">Your appeal is waiting for review</h2></div>
                <p>You will get a direct message when a reviewer decides, and the decision will show on this page.</p>
                <div id="appealDetails"></div>
            </section>
        </div>

        <div id="deniedState" hidden>
            <section class="gb-panel" aria-labelledby="gb-denied-h">
                <div class="gb-state"><span class="cfs-dot cfs-dot--bad" aria-hidden="true"></span><h2 id="gb-denied-h">Your last appeal was denied</h2></div>
                <p>You can send a new appeal below.</p>
                <div id="deniedDetails"></div>
            </section>
        </div>

        <div id="bannedState" hidden>
            <section class="gb-panel" aria-labelledby="gb-ban-h">
                <div class="gb-state"><span class="cfs-dot cfs-dot--bad" aria-hidden="true"></span><h2 id="gb-ban-h">Your account is on the global ban list</h2></div>
                <p>Servers that use the global ban list may ban or block this account.</p>
                <dl class="gb-details" id="banDetails"></dl>
            </section>

            <section class="gb-panel" aria-labelledby="gb-form-h">
                <h2 id="gb-form-h">Send an appeal</h2>
                <p>Say why the ban should be reversed. Specific appeals are easier to approve.</p>
                <form id="appealForm" novalidate>
                    <div class="gb-field">
                        <label class="form-label" for="appealReason">Reason <span class="gb-req">(required, 20 to 2,000 characters)</span></label>
                        <textarea class="form-textarea" id="appealReason" name="reason" minlength="20" maxlength="2000" required aria-describedby="reasonCount"></textarea>
                        <p class="gb-count" id="reasonCount">0 / 2000</p>
                    </div>
                    <div class="gb-field">
                        <label class="form-label" for="appealEvidence">Evidence <span class="gb-req">(optional)</span></label>
                        <input class="form-input" id="appealEvidence" name="evidence" type="text" maxlength="1000" aria-describedby="evidenceHint">
                        <p class="gb-hint" id="evidenceHint">Links to screenshots or anything else that supports your appeal.</p>
                    </div>
                    <button type="submit" class="btn btn-primary" id="submitBtn">Send appeal</button>
                </form>
            </section>
        </div>
        <% } %>
    </main>

<%- include('partials/site-footer') %>
<% if (user) { %>
<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    var alertBox = $('alertBox');

    function showAlert(message, ok) {
        alertBox.textContent = message;
        alertBox.className = 'gb-alert ' + (ok ? 'is-ok' : 'is-bad');
        alertBox.hidden = false;
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    function hideAlert() { alertBox.hidden = true; }

    function formatDate(value) {
        if (!value) return 'Unknown';
        var d = new Date(value);
        return isNaN(d) ? 'Unknown' : d.toLocaleString(undefined, { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }
    var STATUS = { pending: 'Waiting for review', under_review: 'Being reviewed', denied: 'Denied', approved: 'Approved' };
    function words(s) { s = String(s || '').replace(/_/g, ' '); return s ? s.charAt(0).toUpperCase() + s.slice(1) : 'Unknown'; }

    // Every value from the server is added as text, never as HTML: ban reasons can come from
    // other people's reports.
    function row(list, label, value) {
        var wrap = document.createElement('div');
        var dt = document.createElement('dt'); dt.textContent = label;
        var dd = document.createElement('dd'); dd.textContent = value;
        wrap.append(dt, dd);
        list.append(wrap);
    }

    function renderBanDetails(entry) {
        var dl = $('banDetails');
        dl.replaceChildren();
        row(dl, 'Entry', '#' + entry.id);
        row(dl, 'Severity', words(entry.severity));
        row(dl, 'Category', words(entry.category));
        row(dl, 'Added', formatDate(entry.created_at));
        if (entry.reason) row(dl, 'Reason', entry.reason);
    }

    function renderAppealDetails(appeal, containerId) {
        var box = $(containerId);
        box.replaceChildren();
        var dl = document.createElement('dl');
        dl.className = 'gb-details';
        row(dl, 'Appeal', '#' + appeal.id);
        row(dl, 'Status', STATUS[appeal.status] || words(appeal.status));
        row(dl, 'Sent', formatDate(appeal.created_at));
        row(dl, 'Your reason', appeal.reason || '');
        box.append(dl);
        if (appeal.reviewer_response) {
            var r = document.createElement('div'); r.className = 'gb-response';
            var h = document.createElement('h3'); h.textContent = 'Reviewer response' + (appeal.reviewed_at ? ', ' + formatDate(appeal.reviewed_at) : '');
            var p = document.createElement('p'); p.textContent = appeal.reviewer_response;
            r.append(h, p);
            box.append(r);
        }
    }

    async function loadStatus() {
        try {
            var res = await fetch('/api/appeal/status', { headers: { Accept: 'application/json' } });
            var data = await res.json();
            $('loadingState').hidden = true;
            if (!data.success) { showAlert(data.message || 'Could not load your ban status.', false); return; }
            var entry = data.activeEntry, appeals = data.appeals || [];
            if (!entry) { $('noBanState').hidden = false; return; }
            var pending = appeals.find(function (a) { return a.status === 'pending' || a.status === 'under_review'; });
            if (pending) { renderAppealDetails(pending, 'appealDetails'); $('pendingState').hidden = false; return; }
            var denied = appeals.find(function (a) { return a.status === 'denied'; });
            if (denied) { renderAppealDetails(denied, 'deniedDetails'); $('deniedState').hidden = false; }
            renderBanDetails(entry);
            $('bannedState').hidden = false;
        } catch (err) {
            $('loadingState').hidden = true;
            showAlert('Could not reach the server. Try again in a minute.', false);
        }
    }

    var reason = $('appealReason'), count = $('reasonCount');
    if (reason) reason.addEventListener('input', function () {
        var n = reason.value.length;
        count.textContent = n + ' / 2000';
        count.className = 'gb-count' + (n > 0 && n < 20 ? ' is-short' : '');
    });

    var form = $('appealForm');
    if (form) form.addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();
        var text = reason.value.trim();
        var evidence = $('appealEvidence').value.trim() || null;
        if (text.length < 20) { showAlert('Your reason must be at least 20 characters.', false); reason.focus(); return; }
        var btn = $('submitBtn');
        btn.disabled = true; btn.textContent = 'Sending…';
        try {
            var res = await fetch('/api/appeal', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason: text, evidence: evidence }) });
            var data = await res.json();
            if (data.success) {
                showAlert('Appeal #' + data.appealId + ' sent. A reviewer will look at it.', true);
                setTimeout(function () { location.reload(); }, 1500);
                return;
            }
            showAlert(data.message || 'Could not send the appeal.', false);
        } catch (err) {
            showAlert('Could not reach the server. Try again in a minute.', false);
        }
        btn.disabled = false; btn.textContent = 'Send appeal';
    });

    loadStatus();
})();
</script>
<% } %>
</body>
</html>
