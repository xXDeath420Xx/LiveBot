<%# Modern Manage Page - Uses Tailwind CSS %>

<div class="flex min-h-screen">
    <!-- Sidebar -->
    <%- include('../partials/manageSidebar', { guild: guild, activeSection: section || 'overview' }) %>

    <!-- Main Content -->
    <div class="flex-1 p-6 lg:p-8">
        <!-- Page Header -->
        <div class="page-header">
            <div>
                <h1 class="page-title"><%= sectionTitle || 'Server Overview' %></h1>
                <p class="page-subtitle"><%= sectionDescription || 'Manage your server settings' %></p>
            </div>

            <div class="flex items-center gap-3">
                <% if (locals.showSaveButton) { %>
                <button type="submit" form="settings-form" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Changes
                </button>
                <% } %>
            </div>
        </div>

        <!-- Dynamic Section Content -->
        <div class="space-y-6">
            <% if (!section || section === 'overview') { %>
                <!-- Overview Section -->
                <div class="stats-grid">
                    <%- include('../components/cards/statCard', {
                        title: 'Total Members',
                        value: guild.memberCount || 0,
                        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
                        color: 'primary',
                        dataStat: 'total-members'
                    }) %>

                    <%- include('../components/cards/statCard', {
                        title: 'Online Now',
                        value: analyticsData?.onlineMembers || 0,
                        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/></svg>',
                        color: 'success',
                        dataStat: 'online-members'
                    }) %>

                    <%- include('../components/cards/statCard', {
                        title: 'Messages (30d)',
                        value: analyticsData?.totalMessages || 0,
                        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>',
                        color: 'primary'
                    }) %>

                    <%- include('../components/cards/statCard', {
                        title: 'Live Streams',
                        value: totalLiveStreams || 0,
                        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
                        color: 'danger'
                    }) %>
                </div>

                <!-- Quick Actions -->
                <div class="card">
                    <h3 class="text-lg font-semibold text-white mb-4">Quick Actions</h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <a href="/manage/<%= guild.id %>?section=moderation" class="btn btn-secondary justify-start">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            Moderation
                        </a>
                        <a href="/manage/<%= guild.id %>?section=welcome" class="btn btn-secondary justify-start">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/>
                            </svg>
                            Welcome
                        </a>
                        <a href="/manage/<%= guild.id %>?section=leveling" class="btn btn-secondary justify-start">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                            </svg>
                            Leveling
                        </a>
                        <a href="/manage/<%= guild.id %>?section=tickets" class="btn btn-secondary justify-start">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                            </svg>
                            Tickets
                        </a>
                    </div>
                </div>

                <!-- Feature Overview -->
                <div>
                    <h3 class="text-lg font-semibold text-white mb-4">Feature Status</h3>
                    <div class="feature-grid">
                        <%- include('../components/cards/featureCard', {
                            title: 'Moderation',
                            description: 'Manage warnings, bans, and automod settings',
                            icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
                            enabled: true,
                            href: '/manage/' + guild.id + '?section=moderation'
                        }) %>

                        <%- include('../components/cards/featureCard', {
                            title: 'Leveling System',
                            description: 'XP rewards and level-up notifications',
                            icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>',
                            enabled: levelingConfig?.enabled || false,
                            href: '/manage/' + guild.id + '?section=leveling'
                        }) %>

                        <%- include('../components/cards/featureCard', {
                            title: 'Welcome Messages',
                            description: 'Greet new members with custom messages',
                            icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/></svg>',
                            enabled: welcomeSettings?.enabled || false,
                            href: '/manage/' + guild.id + '?section=welcome'
                        }) %>

                        <%- include('../components/cards/featureCard', {
                            title: 'Starboard',
                            description: 'Highlight the best messages',
                            icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>',
                            enabled: starboardConfig?.enabled || false,
                            href: '/manage/' + guild.id + '?section=starboard'
                        }) %>

                        <%- include('../components/cards/featureCard', {
                            title: 'Ticket System',
                            description: 'Support ticket management',
                            icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>',
                            enabled: ticketPanels?.length > 0 || false,
                            href: '/manage/' + guild.id + '?section=tickets',
                            stats: [{ label: 'Panels', value: ticketPanels?.length || 0 }]
                        }) %>

                        <%- include('../components/cards/featureCard', {
                            title: 'Reaction Roles',
                            description: 'Self-assignable roles via reactions',
                            icon: '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>',
                            enabled: reactionRolePanels?.length > 0 || false,
                            href: '/manage/' + guild.id + '?section=reaction-roles',
                            stats: [{ label: 'Panels', value: reactionRolePanels?.length || 0 }]
                        }) %>
                    </div>
                </div>

            <% } else { %>
                <!-- Dynamic Section Partial (Tailwind Version) -->
                <% try { %>
                    <%- include(`../partials/manage-new/${section}`, {
                        guild: guild,
                        guildId: guild.id,
                        roles: allRoles,
                        channels: allChannels,
                        user: user
                    }) %>
                <% } catch (e) { %>
                    <div class="card">
                        <div class="empty-state">
                            <svg class="empty-state-icon mx-auto text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                            </svg>
                            <p class="empty-state-title">Section Not Found</p>
                            <p class="empty-state-text">The section "<%= section %>" could not be loaded.</p>
                        </div>
                    </div>
                <% } %>
            <% } %>
        </div>
    </div>
</div>

<script>
    // Initialize socket connection for this guild
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof dashboardSocket !== 'undefined') {
            dashboardSocket.joinGuild('<%= guild.id %>');
        }
    });
</script>
