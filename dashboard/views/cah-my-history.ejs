<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<style>
    .hero { padding: 24px 0 16px; }
    .hero h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; }
    .hero p { color: var(--cf-text-3); margin-top: 4px; font-size: var(--cf-text-md); }

    .history-list { display: flex; flex-direction: column; gap: 8px; padding-bottom: 72px; list-style: none; }
    .history-row {
        background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg);
        padding: 14px 16px;
        display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center;
        transition: border-color 0.15s;
    }
    .history-row:hover { border-color: var(--cf-border-strong); }
    .history-row.won { box-shadow: inset 3px 0 0 var(--cf-success); }
    .history-row .meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .history-row .who { font-size: var(--cf-text-md); overflow-wrap: anywhere; }
    .history-row .who .vs { color: var(--cf-text-3); }
    .history-row .when { color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .history-row .when code { font-family: var(--cf-mono); font-size: 0.9em; }
    .history-row .badges { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 2px; }
    .history-row .actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
    .history-row .you-status { font-weight: 600; font-size: var(--cf-text-sm); }
    .history-row.won .you-status { color: var(--cf-success); }
    .history-row.lost .you-status { color: var(--cf-text-2); }
    @media (max-width: 520px) {
        .history-row { grid-template-columns: minmax(0, 1fr); }
        .history-row .actions { flex-direction: row; align-items: center; justify-content: space-between; }
    }
    .empty { padding: 32px 20px; text-align: center; color: var(--cf-text-3); background: var(--cf-surface); border: 1px dashed var(--cf-border); border-radius: var(--cf-radius-lg); font-size: var(--cf-text-sm); }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'My games · Cards Against Humanity · CertiFried', description: 'Cards Against Humanity on CertiFried: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'history' }) %>
<%- include('components/cah-breadcrumbs', { crumbs: [{ href: '/cah', label: 'CAH' }, { label: 'My games' }] }) %>

<main class="container" id="main-content">
    <section class="hero">
        <h1>My games</h1>
        <p>Your last <%= games.length %> game<%= games.length === 1 ? '' : 's' %>, hosted or played. Games still running can be reopened.</p>
    </section>

    <% if (!games || games.length === 0) { %>
        <div class="empty">You haven't played yet. <a href="/cah">Host or join a game</a></div>
    <% } else { %>
        <ul class="history-list">
            <% games.forEach(g => {
                const ended = g.state === 'GAME_END' || g.state === 'ABANDONED';
                const result = g.iWon ? 'won' : (g.state === 'GAME_END' ? 'lost' : 'open');
                const playerName = (p) => p.displayName || ('Player ' + String(p.userId).slice(-4));
                const otherPlayers = (g.players || []).filter(p => p.userId !== user.id && !String(p.userId).startsWith('rando:'));
                const winnerNames = (g.winnerUserIds || []).map(id => { const p = (g.players || []).find(x => x.userId === id); return id === user.id ? 'you' : (p ? playerName(p) : 'a player'); });
            %>
                <li class="history-row <%= result %>">
                    <div class="meta">
                        <div class="who">
                            <span class="vs">With</span> <%= otherPlayers.length === 0 ? 'AI players only' : otherPlayers.map(playerName).join(', ') %>
                        </div>
                        <div class="when">
                            <% if (g.endedAt) { %><time datetime="<%= new Date(g.endedAt).toISOString() %>" data-local-time><%= new Date(g.endedAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC</time><% } else { %><%= ended ? 'Ended' : 'In progress' %><% } %>
                            · game <code><%= g.id.slice(0, 8) %></code>
                        </div>
                        <div class="badges">
                            <% if (g.state === 'GAME_END') { %>
                                <% if (!g.iWon && winnerNames.length) { %><span class="pill">Won by <%= winnerNames.join(', ') %></span><% } %>
                            <% } else if (g.state === 'ABANDONED') { %>
                                <span class="pill">Cancelled</span>
                            <% } else { %>
                                <span class="pill pill-amber">In progress</span>
                            <% } %>
                            <span class="pill"><%= g.myPoints %> point<%= g.myPoints === 1 ? '' : 's' %></span>
                        </div>
                    </div>
                    <div class="actions">
                        <span class="you-status"><%= g.iWon ? 'You won' : (g.state === 'GAME_END' ? 'You lost' : (g.state === 'ABANDONED' ? 'Cancelled' : 'Running')) %></span>
                        <% if (!ended) { %><a href="/cah/<%= g.id %>" class="btn btn-outline btn-sm">Open game</a><% } %>
                    </div>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>
<script>
    document.querySelectorAll('time[data-local-time]').forEach(t => {
        const d = new Date(t.getAttribute('datetime'));
        if (!isNaN(d)) t.textContent = d.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
    });
</script>
<%- include('partials/site-footer') %>
</body>
</html>