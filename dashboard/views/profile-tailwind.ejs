<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0b0f11;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.5);
            --accent-purple: #a78bfa;
            --accent-blue: #60a5fa;
            --accent-cyan: #22d3ee;
            --accent-green: #34d399;
            --accent-red: #f87171;
        }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: var(--bg-primary); color: var(--text-primary); min-height: 100vh; line-height: 1.6; }
        .bg-effects { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: hidden; }
        .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.3; animation: float 20s ease-in-out infinite; }
        .orb-1 { width: clamp(300px, 40vw, 500px); height: clamp(300px, 40vw, 500px); background: var(--cf-accent); top: -10%; right: -10%; }
        .orb-2 { width: clamp(250px, 35vw, 450px); height: clamp(250px, 35vw, 450px); background: var(--cf-accent); bottom: 10%; left: -10%; animation-delay: -10s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(20px, 20px) scale(1.02); } }
        .container { width: 100%; max-width: 1000px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }
        main { position: relative; z-index: 1; padding: 2rem 0 4rem; }
        .page-header { margin-bottom: 2rem; }
        .page-header h1 { font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 800; background: linear-gradient(135deg, var(--text-primary), var(--accent-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.5rem; }
        .page-header p { color: var(--text-secondary); font-size: 0.95rem; }
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        .profile-card { background: var(--bg-card); border: 1px solid var(--border-color); border-left: 3px solid var(--accent-purple); border-radius: 4px 20px 20px 4px; padding: 2rem; margin-bottom: 2rem; animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
        .profile-header { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 1.5rem; }
        .profile-avatar { width: 120px; height: 120px; border-radius: 20px; border: 3px solid var(--border-color); object-fit: cover; flex-shrink: 0; }
        .profile-info { flex: 1; min-width: 200px; }
        .profile-name { font-size: 1.75rem; font-weight: 700; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
        .profile-name .discriminator { color: var(--text-muted); font-weight: 500; }
        .profile-meta { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; font-size: 0.85rem; color: var(--text-muted); }
        .profile-meta span { display: flex; align-items: center; gap: 0.4rem; }
        .profile-meta svg { width: 16px; height: 16px; }
        .profile-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; border: none; cursor: pointer; font-family: inherit; }
        .btn svg { width: 16px; height: 16px; }
        .btn-primary { background: var(--cf-accent); color: var(--cf-on-accent); }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px color-mix(in srgb, var(--accent-purple) 30%, transparent); }
        .btn-secondary { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); }
        .btn-secondary:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .btn-danger { background: color-mix(in srgb, var(--cf-danger) 15%, transparent); border: 1px solid color-mix(in srgb, var(--cf-danger) 30%, transparent); color: var(--cf-danger-ink); }
        .btn-danger:hover { background: var(--cf-danger); color: #fff; }
        .section-title { font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; text-align: center; transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1); position: relative; overflow: hidden; animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--stat-color, var(--accent-purple)), color-mix(in srgb, var(--stat-color, var(--accent-purple)) 30%, transparent)); opacity: 0; transition: opacity 0.3s; }
        .stat-card:hover { transform: translateY(-3px); border-color: var(--border-color); box-shadow: 0 8px 24px color-mix(in srgb, var(--stat-color, var(--accent-purple)) 8%, rgba(0,0,0,0.2)); }
        .stat-card:hover::before { opacity: 1; }
        .stat-card:hover .stat-icon { transform: scale(1.1); }
        .stat-card:nth-child(1) { animation-delay: 0.05s; }
        .stat-card:nth-child(2) { animation-delay: 0.1s; }
        .stat-card:nth-child(3) { animation-delay: 0.15s; }
        .stat-icon { width: 48px; height: 48px; margin: 0 auto 1rem; border-radius: 12px; display: flex; align-items: center; justify-content: center; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
        .stat-icon svg { width: 24px; height: 24px; }
        .stat-value { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.25rem; }
        .stat-label { font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
        .stat-sublabel { font-size: 0.75rem; color: var(--text-muted); }
        .stat-purple { --stat-color: var(--accent-purple); }
        .stat-purple .stat-icon { background: var(--bg-card-hover); color: var(--accent-purple); }
        .stat-amber { --stat-color: var(--cf-warning); }
        .stat-amber .stat-icon { background: color-mix(in srgb, var(--cf-warning) 15%, transparent); color: var(--cf-warning-ink); }
        .stat-cyan { --stat-color: var(--accent-cyan); }
        .stat-cyan .stat-icon { background: color-mix(in srgb, var(--cf-info) 15%, transparent); color: var(--cf-info-ink); }
        .info-card { background: var(--bg-card); border: 1px solid var(--border-color); border-left: 3px solid var(--accent-cyan); border-radius: 4px 16px 16px 4px; overflow: hidden; margin-bottom: 2rem; animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: 0.2s; }
        .info-row { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-color); }
        .info-row:last-child { border-bottom: none; }
        .info-label { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.25rem; }
        .info-value { font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
        .info-value.mono { font-family: 'SF Mono', monospace; }
        .info-badge { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.6rem; border-radius: 50px; font-size: 0.7rem; font-weight: 600; }
        .info-badge.green { background: color-mix(in srgb, var(--cf-success) 15%, transparent); color: var(--cf-success-ink); }
        .info-badge.muted { background: var(--bg-card-hover); color: var(--text-muted); }
        .info-badge svg { width: 12px; height: 12px; }
        .copy-btn { padding: 0.4rem 0.75rem; font-size: 0.75rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 6px; cursor: pointer; font-family: inherit; transition: all 0.2s; }
        .copy-btn:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .servers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.75rem; }
        .server-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; background: var(--cf-inset); border: 1px solid var(--border-color); border-radius: 12px; text-decoration: none; transition: all 0.2s; }
        .server-item:hover { border-color: var(--accent-purple); background: var(--bg-card-hover); }
        .server-item img { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; }
        .server-item .name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .view-all-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 10px; font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: all 0.2s; margin-top: 1rem; }
        .view-all-btn:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .empty-servers { text-align: center; padding: 2rem; }
        .empty-servers svg { width: 48px; height: 48px; color: var(--text-muted); margin-bottom: 0.75rem; }
        .empty-servers p { color: var(--text-muted); }
        .danger-zone { background: var(--bg-card); border: 1px solid color-mix(in srgb, var(--cf-danger) 30%, transparent); border-radius: 16px; padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
        .danger-info h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.25rem; }
        .danger-info p { font-size: 0.85rem; color: var(--text-muted); }
        /* Mobile Menu Button */
        /* Mobile Menu Dropdown */
        @media (max-width: 768px) {
            .profile-header { flex-direction: column; align-items: center; text-align: center; }
            .profile-meta { justify-content: center; }
            .profile-actions { justify-content: center; }
            .danger-zone { flex-direction: column; text-align: center; }
        }
    </style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Profile · CertiFried', description: 'Your CertiFried profile. View and manage your settings.', noindex: true }) %>
</head>
<body>
    <div class="bg-effects"><div class="orb orb-1"></div><div class="orb orb-2"></div></div>

    <%- include('partials/site-header', { user: locals.user || null }) %>

    <main id="main-content" tabindex="-1">
        <div class="container">
            <div class="page-header">
                <h1>User Profile</h1>
                <p>View and manage your Discord account information</p>
            </div>

            <!-- Profile Card -->
            <div class="profile-card">
                <div class="profile-header">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="<%= user.username %>" class="profile-avatar">
                    <div class="profile-info">
                        <div class="profile-name">
                            <%= user.username %>
                            <% if (user.discriminator && user.discriminator !== '0') { %>
                            <span class="discriminator">#<%= user.discriminator %></span>
                            <% } %>
                        </div>
                        <div class="profile-meta">
                            <span>
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
                                <%= user.id %>
                            </span>
                            <% if (user.email) { %>
                            <span>
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                <%= user.email %>
                            </span>
                            <% } %>
                        </div>
                        <div class="profile-actions">
                            <a href="https://discord.com/users/<%= user.id %>" target="_blank" class="btn btn-primary">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
                                View on Discord
                            </a>
                            <a href="/settings" class="btn btn-secondary">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                Settings
                            </a>
                            <a href="/buymeacoffee" class="btn btn-secondary">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8h14a4 4 0 010 8h-1M3 8v8a4 4 0 004 4h6a4 4 0 004-4M3 8V6a2 2 0 012-2h10a2 2 0 012 2v2M8 1v2M11 1v2"/></svg>
                                Buy Me a Coffee
                            </a>
                            <a href="/stream-team" class="btn btn-secondary">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                Stream Team
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Statistics -->
            <h2 class="section-title">Account Statistics</h2>
            <div class="stats-grid">
                <div class="stat-card stat-purple">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg></div>
                    <div class="stat-value"><%= totalGuilds %></div>
                    <div class="stat-label">Servers</div>
                    <div class="stat-sublabel">Servers you can manage</div>
                </div>
                <div class="stat-card stat-amber">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg></div>
                    <div class="stat-value"><%= totalStreamers %></div>
                    <div class="stat-label">Streamers</div>
                    <div class="stat-sublabel">Tracked in those servers</div>
                </div>
                <div class="stat-card stat-cyan">
                    <div class="stat-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
                    <div class="stat-value"><%= totalMembers.toLocaleString() %></div>
                    <div class="stat-label">Total Reach</div>
                    <div class="stat-sublabel">Members of those servers the main bot is in</div>
                </div>
            </div>

            <!-- Account Information -->
            <h2 class="section-title">Account Information</h2>
            <div class="info-card">
                <div class="info-row">
                    <div>
                        <div class="info-label">Username</div>
                        <div class="info-value"><%= user.username %><% if (user.discriminator && user.discriminator !== '0') { %>#<%= user.discriminator %><% } %></div>
                    </div>
                    <span class="info-badge muted"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>Managed by Discord</span>
                </div>
                <div class="info-row">
                    <div>
                        <div class="info-label">User ID</div>
                        <div class="info-value mono"><%= user.id %></div>
                    </div>
                    <button onclick="navigator.clipboard.writeText('<%= user.id %>'); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 2000)" class="copy-btn">Copy</button>
                </div>
                <% if (user.email) { %>
                <div class="info-row">
                    <div>
                        <div class="info-label">Email</div>
                        <div class="info-value"><%= user.email %></div>
                    </div>
                    <span class="info-badge muted"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>Managed by Discord</span>
                </div>
                <% } %>
                <div class="info-row">
                    <div>
                        <div class="info-label">Account Type</div>
                        <div class="info-value">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
                            Discord OAuth
                        </div>
                    </div>
                    <span class="info-badge green"><span style="width:6px;height:6px;background:var(--accent-green);border-radius:50%;"></span>Connected</span>
                </div>
            </div>

            <!-- Your Servers -->
            <h2 class="section-title">Your Servers</h2>
            <div class="info-card" style="padding: 1.25rem;">
                <% if (guilds && guilds.length > 0) { %>
                <div class="servers-grid">
                    <% guilds.slice(0, 8).forEach(guild => { %>
                    <a href="/manage/<%= guild.id %>" class="server-item">
                        <img src="<%= guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="<%= guild.name %>">
                        <span class="name"><%= guild.name %></span>
                    </a>
                    <% }); %>
                </div>
                <% if (guilds.length > 8) { %>
                <div style="text-align: center;">
                    <a href="/dashboard" class="view-all-btn">View All Servers (<%= guilds.length %>)</a>
                </div>
                <% } %>
                <% } else { %>
                <div class="empty-servers">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/></svg>
                    <p>No servers found</p>
                </div>
                <% } %>
            </div>

            <!-- Danger Zone -->
            <h2 class="section-title" style="color: var(--accent-red);">Danger Zone</h2>
            <div class="danger-zone">
                <div class="danger-info">
                    <h3>Disconnect Account</h3>
                    <p>Logout from the dashboard. You can sign back in anytime.</p>
                </div>
                <a href="/logout" class="btn btn-danger">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Logout
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/site-footer') %>

    <script>
    </script>
</body>
</html>
