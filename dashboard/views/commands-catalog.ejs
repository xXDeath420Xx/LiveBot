<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: 'Commands · CertiFried', description: 'Every CertiFried slash command and text command with its subcommands, options, aliases and the permissions it needs. Built from the commands the bot is running now.', path: '/commands' }) %>
    <style>
        .cc-run { margin: 0 0 var(--cf-6); padding: var(--cf-4) var(--cf-5); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .cc-run h2 { margin: 0 0 var(--cf-3); font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text-2); }
        .cc-prefixes { display: flex; flex-wrap: wrap; gap: var(--cf-2); }
        .cc-pfx, .cc-shorts code, .cc-run-form { font-family: var(--cf-mono); color: var(--cf-text); background: var(--cf-inset); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-sm); }
        .cc-pfx { padding: 3px 8px; font-size: var(--cf-text-sm); }
        .cc-run p { margin: var(--cf-3) 0 0; font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); max-width: 80ch; }
        .cc-run code, .cc-modal-body code { font-family: var(--cf-mono); font-size: 0.92em; color: var(--cf-text); }

        .cc-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin: 0 0 var(--cf-6); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); overflow: hidden; }
        .cc-stats .cfs-stat { border-left: 0; box-shadow: -1px 0 0 var(--cf-border), 0 -1px 0 var(--cf-border); }

        .cc-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--cf-3); align-items: center; margin: 0 0 var(--cf-3); }
        @media (max-width: 720px) { .cc-controls { grid-template-columns: minmax(0, 1fr); } }
        .cc-search { width: 100%; min-height: 40px; padding: 8px 12px; font: inherit; font-size: var(--cf-text-md); color: var(--cf-text); background: var(--cf-inset); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius); }
        .cc-search::placeholder { color: var(--cf-text-3); opacity: 1; }
        .cc-search:focus { outline: none; border-color: var(--cf-accent); box-shadow: 0 0 0 3px var(--cf-accent-soft); }
        .cc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
        .cc-cats { margin: 0 0 var(--cf-5); }
        .cc-chip { display: inline-flex; align-items: center; min-height: 32px; padding: 0 12px; font: inherit; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-2); background: transparent; border: 1px solid var(--cf-border); border-radius: 999px; cursor: pointer; }
        .cc-chip:hover { color: var(--cf-text); border-color: var(--cf-border-strong); }
        .cc-chip[aria-pressed="true"] { color: var(--cf-text); background: var(--cf-surface-3); border-color: var(--cf-border-strong); }
        .cc-count { margin: 0 0 var(--cf-3); font-size: var(--cf-text-sm); color: var(--cf-text-3); }

        .cc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: var(--cf-3); }
        .cc-card { display: flex; flex-direction: column; gap: 6px; width: 100%; padding: var(--cf-4); text-align: left; font: inherit; color: var(--cf-text); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); cursor: pointer; }
        .cc-card:hover { border-color: var(--cf-border-strong); }
        .cc-name { display: block; font-family: var(--cf-mono); font-size: var(--cf-text-md); font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
        .cc-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: var(--cf-text-sm); line-height: 1.5; color: var(--cf-text-2); }
        .cc-shorts, .cc-meta { display: flex; flex-wrap: wrap; gap: 4px; }
        .cc-meta { margin-top: auto; padding-top: 4px; }
        .cc-shorts code { padding: 1px 6px; font-size: var(--cf-text-xs); }
        .cc-tag { display: inline-flex; align-items: center; padding: 1px 7px; font-size: var(--cf-text-xs); font-weight: 500; color: var(--cf-text-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-sm); }
        .cc-tag--gate { color: var(--cf-warning); border-color: color-mix(in srgb, var(--cf-warning) 40%, var(--cf-border)); }
        .cc-tag--off { color: var(--cf-danger); border-color: color-mix(in srgb, var(--cf-danger) 40%, var(--cf-border)); }

        /* Command details (a dialog) */
        .cc-backdrop { position: fixed; inset: 0; z-index: 1100; display: none; align-items: flex-start; justify-content: center; padding: 4vh var(--cf-4); overflow-y: auto; background: rgb(0 0 0 / 0.7); }
        .cc-backdrop.is-open { display: flex; }
        .cc-modal { width: min(760px, 100%); background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-lg); box-shadow: var(--cf-shadow-pop); }
        .cc-modal-head { position: sticky; top: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: var(--cf-4); padding: var(--cf-4) var(--cf-5); background: var(--cf-surface); border-bottom: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg) var(--cf-radius-lg) 0 0; }
        .cc-modal-head h2 { margin: 0; font-family: var(--cf-mono); font-size: var(--cf-text-lg); font-weight: 600; overflow-wrap: anywhere; }
        .cc-modal-head p { margin: 4px 0 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
        .cc-close { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; padding: 0; font-size: 1.5rem; line-height: 1; color: var(--cf-text-2); background: transparent; border: 1px solid var(--cf-border); border-radius: var(--cf-radius); cursor: pointer; }
        .cc-close:hover { color: var(--cf-text); background: var(--cf-surface-2); }
        .cc-modal-body { padding: var(--cf-4) var(--cf-5) var(--cf-6); }
        .cc-sec + .cc-sec { margin-top: var(--cf-5); }
        .cc-sec h3 { margin: 0 0 var(--cf-2); font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
        .cc-path { margin-bottom: var(--cf-2); padding: var(--cf-3); background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); }
        .cc-path-name { font-family: var(--cf-mono); font-size: var(--cf-text-sm); font-weight: 600; overflow-wrap: anywhere; }
        .cc-path-desc { margin-top: 2px; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
        .cc-opts { display: grid; gap: 2px; margin-top: var(--cf-2); }
        .cc-opt { font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-2); overflow-wrap: anywhere; }
        .cc-opt b { font-weight: 600; color: var(--cf-text); }
        .cc-req { color: var(--cf-warning); }
        .cc-why { margin-top: var(--cf-2); font-size: var(--cf-text-xs); color: var(--cf-warning); }
        .cc-off { margin-top: var(--cf-2); font-size: var(--cf-text-sm); color: var(--cf-danger); }
        .cc-runs { display: flex; flex-wrap: wrap; gap: 4px; margin-top: var(--cf-2); }
        .cc-run-form { padding: 4px 8px; font-size: var(--cf-text-xs); cursor: pointer; }
        .cc-run-form:hover { border-color: var(--cf-border-strong); }
        .cc-kv { font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); }
        .cc-kv b { color: var(--cf-text); font-weight: 600; }
        .cc-card:focus-visible, .cc-chip:focus-visible, .cc-close:focus-visible, .cc-run-form:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 2px; }
        @media (max-width: 600px) {
            .cc-chip { min-height: 40px; }
            .cc-run-form { padding: 10px; }
        }
    </style>
</head>
<body class="cfs-body">
    <%- include('partials/site-header', { user: locals.user || null, navActive: 'commands', returnTo: '/commands' }) %>

    <main class="cfs-main cfs-main--wide" id="main-content" tabindex="-1">
        <div class="cfs-pagehead">
            <h1>Commands</h1>
            <p class="cfs-lede">Every command the bot is running now, with its subcommands, options and aliases. Search by name, description, alias or option name.</p>
        </div>

        <section class="cc-run" aria-labelledby="cc-run-h">
            <h2 id="cc-run-h">How to run a command</h2>
            <div class="cc-prefixes">
                <span class="cc-pfx">/command</span>
                <% catalog.prefixes.forEach(p => { %><span class="cc-pfx"><%= p %>command</span><% }) %>
                <span class="cc-pfx"><%= catalog.mentionForm %> command</span>
            </div>
            <p>
                Commands marked <b>text command</b> are not in Discord's / menu: type them as a normal message,
                for example <code>/joke</code>. Slash commands also work from chat with any prefix above<% if (catalog.stats.slashOnly) { %>, except the paths marked slash-only<% } %>; attach any file a command asks for to the same message.
                Server admins can change the prefixes, turn chat commands off, or add their own aliases in the
                dashboard's Command Center. Permissions are checked the same way for both: Discord checks
                <code>/</code> commands, and the bot checks chat commands itself.
            </p>
        </section>

        <div class="cc-stats">
            <div class="cfs-stat"><b><%= catalog.stats.topLevel ?? catalog.stats.commands %></b><span>slash commands<% if (catalog.stats.serverOnly) { %>, plus <%= catalog.stats.serverOnly %> in some servers<% } %></span></div>
            <% if (catalog.stats.textCommands) { %><div class="cfs-stat"><b><%= catalog.stats.textCommands %></b><span>text commands</span></div><% } %>
            <div class="cfs-stat"><b><%= catalog.stats.paths %></b><span>subcommands and paths</span></div>
            <div class="cfs-stat"><b><%= catalog.stats.gated %></b><span>need a permission</span></div>
            <% if (catalog.stats.slashOnly) { %><div class="cfs-stat"><b><%= catalog.stats.slashOnly %></b><span>slash-only paths</span></div><% } %>
        </div>

        <div class="cc-controls">
            <div>
                <label for="q" class="visually-hidden">Search commands</label>
                <input type="search" id="q" class="cc-search" placeholder="Search commands, aliases, options" autocomplete="off">
            </div>
            <div class="cc-chips" role="group" aria-label="Filters">
                <button type="button" class="cc-chip" data-filter="gated" aria-pressed="false">Needs a permission</button>
                <% if (catalog.stats.slashOnly) { %><button type="button" class="cc-chip" data-filter="slashOnly" aria-pressed="false">Slash-only</button><% } %>
                <button type="button" class="cc-chip" data-filter="aliasable" aria-pressed="false">Can have an alias</button>
            </div>
        </div>

        <div class="cc-chips cc-cats" id="cats" role="group" aria-label="Category">
            <button type="button" class="cc-chip" data-cat="all" aria-pressed="true">All</button>
            <% categories.forEach(c => { %><button type="button" class="cc-chip" data-cat="<%= c %>" aria-pressed="false"><%= c.charAt(0).toUpperCase() + c.slice(1) %></button><% }) %>
        </div>

        <p class="cc-count" id="count" aria-live="polite"></p>
        <div class="cc-grid" id="grid"></div>
        <div class="cfs-rows" id="empty" hidden><div class="cfs-empty"><p>No command matches that search.</p></div></div>
    </main>

    <div class="cc-backdrop" id="backdrop">
        <div class="cc-modal" role="dialog" aria-modal="true" aria-labelledby="mTitle" aria-describedby="mDesc">
            <div class="cc-modal-head">
                <div>
                    <h2 id="mTitle"></h2>
                    <p id="mDesc"></p>
                </div>
                <button type="button" class="cc-close" id="mClose" aria-label="Close">&times;</button>
            </div>
            <div class="cc-modal-body" id="mBody"></div>
        </div>
    </div>

    <%- include('partials/site-footer') %>

<script>
(function () {
  // Every `<` is escaped so a command description cannot emit a closing script tag and break out.
  const CATALOG = <%- JSON.stringify(catalog).replace(/</g, '\\u003c') %>;
  const CMDS = CATALOG.commands;
  const PREFIXES = CATALOG.prefixes;
  const MENTION = CATALOG.mentionForm;

  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

  // The name a member types: the slash path (`/fun owoify` for a moved command), or the chat form for an alias
  // that is no longer a slash command (core/command-mounts.js).
  // A text command (slash/text split) shows what members type as a message: "/owo".
  const cmdLabel = c => c.slash ? '/' + c.slash : (c.text || (c.slash === null ? PREFIXES[0] + c.name : '/' + c.name));

  // Subcommands that are still registered but no longer do their job, as [path regex, note]. Empty since
  // H-650: the Reddit feed subcommands, /community automeme and /arcade cfx were removed from the command
  // definitions (core/retired-commands.js answers them), so the catalog no longer lists them at all.
  const RETIRED = [];
  const retiredNote = (p) => (RETIRED.find(([re]) => re.test(p.path)) || [])[1] || null;
  const cmdRetired = (c) => c.paths.length > 0 && c.paths.every(p => retiredNote(p));

  // Pre-flatten everything a search should hit, so filtering is a single string test.
  for (const c of CMDS) {
    c._hay = [
      c.name, c.slash ?? '', c.description, c.category,
      ...c.builtinAliases,
      ...c.paths.flatMap(p => [p.path, p.description, ...p.shortcuts, ...p.options.map(o => o.name + ' ' + o.choices.join(' '))]),
      c.gated ? 'gated permission' : '',
      c.paths.some(p => p.slashOnly) ? 'slash-only slashonly' : '',
      c.opensModal ? 'modal' : '',
      c.type === 'text' ? 'text command' : '',
      ...c.paths.map(p => p.text || ''),
      // `owoh` is a real, typed form — searching for it must find /owo.
      ...(c.naturalPrefix ? c.naturalPrefix.forms.flatMap(f => f.forms.map(x => c.naturalPrefix.prefix + x)) : []),
    ].join(' ').toLowerCase();
  }

  let cat = 'all';
  const filters = new Set();

  function tags(c) {
    const t = [`<span class="cc-tag">${esc(c.category)}</span>`];
    if (c.adminOnly) t.push('<span class="cc-tag cc-tag--gate">admin only</span>');
    else if (c.gated) t.push(`<span class="cc-tag cc-tag--gate">${esc(c.permissions[0] || 'needs a permission')}</span>`);
    if (cmdRetired(c)) t.push('<span class="cc-tag cc-tag--off">not available</span>');
    if (c.serverOnly && c.slash) t.push('<span class="cc-tag">some servers only</span>');
    if (c.type === 'text') t.push('<span class="cc-tag">text command</span>');
    else if (c.type === 'mixed') t.push('<span class="cc-tag">slash and text</span>');
    if (c.paths.some(p => p.slashOnly)) t.push('<span class="cc-tag">slash-only paths</span>');
    if (c.opensModal) t.push('<span class="cc-tag">opens a form</span>');
    if (c.builtinAliases.length) t.push(`<span class="cc-tag">${c.builtinAliases.length} alias${c.builtinAliases.length>1?'es':''}</span>`);
    if (c.paths.length > 1) t.push(`<span class="cc-tag">${c.paths.length} subcommands</span>`);
    return t.join('');
  }

  function render() {
    const q = $('q').value.trim().toLowerCase();
    const list = CMDS.filter(c => {
      if (cat !== 'all' && c.category !== cat) return false;
      if (filters.has('gated') && !c.gated) return false;
      if (filters.has('slashOnly') && !c.paths.some(p => p.slashOnly)) return false;
      if (filters.has('aliasable') && !c.aliasable) return false;
      return !q || c._hay.includes(q);
    });

    $('empty').hidden = list.length > 0;
    $('count').textContent = list.length === CMDS.length ? `${CMDS.length} commands` : `${list.length} of ${CMDS.length} commands`;
    $('grid').innerHTML = list.map((c) => {
      // Short chat forms are the whole point of the bridge — show them on the face of the card.
      const shorts = [...new Set(c.paths.flatMap(p => p.shortcuts))]
        .sort((a, b) => a.length - b.length || a.localeCompare(b)).slice(0, 4);
      const shortLine = shorts.length
        ? `<span class="cc-shorts">${shorts.map(s => `<code>${esc(PREFIXES[0] + s)}</code>`).join('')}</span>` : '';

      return `<button type="button" class="cc-card" data-i="${CMDS.indexOf(c)}" aria-haspopup="dialog">
        <span class="cc-name">${esc(cmdLabel(c))}</span>
        <span class="cc-desc">${esc(c.description)}</span>
        ${shortLine}
        <span class="cc-meta">${tags(c)}</span>
      </button>`;
    }).join('');
  }

  /** The shortest way to type a path from chat. `music play` has the shortcut `p`, so use it. */
  const shortestName = (p) => p.shortcuts.length
    ? [...p.shortcuts].sort((a, b) => a.length - b.length || a.localeCompare(b))[0]
    : p.path;

  function runForms(p) {
    const name = shortestName(p);
    // Moved commands have a different slash path (core/command-mounts.js); dropped aliases have none.
    // A text command's "/" form is typed as a message; "/" is not repeated in the prefix list below.
    const forms = p.slash ? [`/${p.slash}`] : p.text ? [p.text] : p.slash === null ? [] : [`/${p.path}`];
    if (!p.slashOnly) {
      for (const pf of PREFIXES) forms.push(`${pf}${name}`);
      forms.push(`${MENTION} ${name}`);
    }
    return forms.map(f => `<button type="button" class="cc-run-form" data-copy="${esc(f)}" title="Copy">${esc(f)}</button>`).join('');
  }

  function pathHtml(p) {
    const opts = p.options.map(o => {
      const bits = [o.type];
      if (o.choices.length) bits.push('one of: ' + o.choices.join(' | '));
      if (o.min != null || o.max != null) bits.push(`${o.min ?? '−∞'}…${o.max ?? '∞'}`);
      return `<div class="cc-opt">&lt;<b>${esc(o.name)}</b>&gt; ${o.required ? '<span class="cc-req">required</span>' : 'optional'}: ${esc(bits.join(', '))}</div>`;
    }).join('');

    const name = shortestName(p);
    const others = p.shortcuts.filter(s => s !== name);
    // The full path always works too, but it is the long way round — say so quietly.
    const longWay = name !== p.path
      ? `<div class="cc-kv">Also works: ${[...others, p.path].map(s => `<code>${esc(PREFIXES[0] + s)}</code>`).join(', ')}</div>`
      : '';
    const off = retiredNote(p);

    return `<div class="cc-path">
      <div class="cc-path-name">${p.slash ? '/' + esc(p.slash) : p.text ? esc(p.text) + ' <span class="cc-tag">text</span>' : p.slash === null ? esc(PREFIXES[0] + p.path) : '/' + esc(p.path)}</div>
      ${p.description ? `<div class="cc-path-desc">${esc(p.description)}</div>` : ''}
      ${off ? `<div class="cc-off">${esc(off)}</div>` : ''}
      ${opts ? `<div class="cc-opts">${opts}</div>` : ''}
      <div class="cc-runs">${runForms(p)}</div>
      ${p.slashOnly ? `<div class="cc-why">Slash-only: ${esc(p.slashOnlyReasons.join('; '))}</div>` : ''}
      ${longWay}
    </div>`;
  }

  let opener = null;
  function open(c, from) {
    opener = from || document.activeElement;
    $('mTitle').textContent = cmdLabel(c);
    $('mDesc').textContent = c.description;

    const perms = c.adminOnly
      ? 'Restricted to <b>Administrators</b> by default. Server owners can change this in Discord under Server Settings, Integrations.'
      : c.gated
        ? `Requires <b>${c.permissions.map(esc).join('</b>, <b>')}</b>. Discord checks it for <code>/</code>; the bot checks it for chat commands.`
        : 'Anyone can run this.';

    const aliasNote = c.aliasable
      ? `Server admins can add their own alias for it, or for one of its subcommands such as <code>${esc(c.paths[c.paths.length-1].path)}</code>, in the dashboard's Command Center.`
      : 'This command cannot have a custom alias: none of its paths can run from chat.';

    $('mBody').innerHTML = `
      <div class="cc-sec">
        <h3>Permissions</h3>
        <div class="cc-kv">${perms}</div>
        ${c.serverOnly && c.slash ? '<div class="cc-kv">In Discord\'s <code>/</code> menu only in the servers it has been turned on for.</div>' : ''}
        ${c.opensModal ? '<div class="cc-why">At least one subcommand opens a pop-up form. Discord can only open a form from a <code>/</code> command, never from a chat message.</div>' : ''}
      </div>

      <div class="cc-sec">
        <h3>Aliases</h3>
        <div class="cc-kv">
          ${c.builtinAliases.length ? `Built in: ${c.builtinAliases.map(a => `<b>${esc(PREFIXES[0]+a)}</b>`).join(', ')}<br>` : ''}
          ${aliasNote}
        </div>
      </div>

      ${c.naturalPrefix ? `
      <div class="cc-sec">
        <h3>Natural chat prefix</h3>
        <div class="cc-kv">${esc(c.naturalPrefix.note)}</div>
        ${c.naturalPrefix.forms.map(f => `
          <div class="cc-path">
            <div class="cc-runs">
              ${f.forms.map(x => `<button type="button" class="cc-run-form" data-copy="${esc(c.naturalPrefix.prefix + x)}" title="Copy">${esc(c.naturalPrefix.prefix + x)}</button>`).join('')}
            </div>
            <div class="cc-path-desc">runs <code>/${esc(c.slash ?? c.name)} ${esc(f.sub)}</code></div>
          </div>`).join('')}
      </div>` : ''}

      <div class="cc-sec">
        <h3>${c.paths.length > 1 ? `${c.paths.length} subcommands` : 'Usage'}</h3>
        ${c.paths.map(pathHtml).join('')}
      </div>`;

    $('backdrop').classList.add('is-open');
    document.body.style.overflow = 'hidden';
    $('mClose').focus();
  }

  function close() {
    if (!$('backdrop').classList.contains('is-open')) return;
    $('backdrop').classList.remove('is-open');
    document.body.style.overflow = '';
    if (opener && document.contains(opener)) opener.focus();
  }

  $('grid').addEventListener('click', (e) => {
    const card = e.target.closest('.cc-card');
    if (card) open(CMDS[Number(card.dataset.i)], card);
  });
  $('mClose').addEventListener('click', close);
  $('backdrop').addEventListener('click', (e) => { if (e.target === $('backdrop')) close(); });
  document.addEventListener('keydown', (e) => {
    if (!$('backdrop').classList.contains('is-open')) return;
    if (e.key === 'Escape') { close(); return; }
    // Keep Tab inside the dialog while it is open.
    if (e.key === 'Tab') {
      const f = [...$('backdrop').querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])')];
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  $('mBody').addEventListener('click', (e) => {
    const c = e.target.closest('[data-copy]');
    if (!c) return;
    navigator.clipboard?.writeText(c.dataset.copy);
    const was = c.textContent; c.textContent = 'Copied'; setTimeout(() => { c.textContent = was; }, 900);
  });

  $('q').addEventListener('input', render);
  $('cats').addEventListener('click', (e) => {
    const b = e.target.closest('[data-cat]');
    if (!b) return;
    cat = b.dataset.cat;
    $('cats').querySelectorAll('.cc-chip').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    render();
  });
  document.querySelectorAll('[data-filter]').forEach(b => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    filters.has(f) ? filters.delete(f) : filters.add(f);
    b.setAttribute('aria-pressed', String(filters.has(f)));
    render();
  }));

  // Deep link: /commands#music opens that command.
  render();
  if (location.hash) {
    const c = CMDS.find(x => x.name === decodeURIComponent(location.hash.slice(1)));
    if (c) open(c);
  }
})();
</script>
</body>
</html>
