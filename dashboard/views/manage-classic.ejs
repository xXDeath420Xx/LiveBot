<!DOCTYPE html>
<%#
  The "Classic" site style (user_preferences.site_style = 'classic', or ?style=classic):
  the manage page as it looked before the 2026-10-13 redesign. This file is the
  pre-redesign manage-tailwind.ejs, restored as it was, plus a few small additions:
    1. data-style on <html>, and NO cf-ui.css / cf-manage.css (they carry the new look);
    2. the --cf-* design tokens newer partials use, mapped onto this page's own palette;
    3. a "Style" switch in the server header so the viewer can go back to Cards / Compact;
    4. a "More pages" category for any page in core/manage-nav.js that the original
       categories below do not list, so every page stays reachable;
    5. page partials are included through the dashboard view engine, which (because this
       page renders with classicCss: true) swaps the redesign's re-tinted CSS in each
       partial back to its original purple rules (dashboard/utils/classic-style.js).
  Same route, same locals and the same pageMap as manage-tailwind.ejs (server.js picks
  the template from res.locals.uiStyle). Covered by tests/manage-classic.test.js.
%>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
    <script>
    // Anti-flash: the theme is on <html> before first paint.
    // Signed in, the server rendered the theme saved in Settings: that value is the
    // authority (Dark included) and is copied to storage. Signed out, the choice
    // made with the footer's theme switch is read from storage; with none, Dark.
    (function () {
        try {
            var d = document.documentElement, saved = <%= locals.userPrefs ? 'true' : 'false' %>;
            var t = localStorage.getItem('ui-theme');
            var n = localStorage.getItem('ui-density');
            if (saved) {
                localStorage.setItem('ui-theme', d.getAttribute('data-theme') || 'dark');
                localStorage.setItem('ui-density', d.getAttribute('data-density') || 'comfortable');
            } else {
                if (t && /^[a-z]{3,12}$/.test(t)) d.setAttribute('data-theme', t);
                if (n && /^[a-z]{3,12}$/.test(n)) d.setAttribute('data-density', n);
            }
        } catch (e) { /* private mode / storage disabled — server value stands */ }
    })();
    </script>
    <!-- Auto theme (core/user-preferences.js AUTO_THEME_SCRIPT): follow the OS light/dark setting. Dark Reader: the site has its own themes. -->
    <script>(function(){var d=document.documentElement,m=window.matchMedia?matchMedia('(prefers-color-scheme: light)'):null;function a(){if(d.getAttribute('data-theme')==='auto'||d.getAttribute('data-theme-mode')==='auto'){d.setAttribute('data-theme-mode','auto');d.setAttribute('data-theme',m&&m.matches?'light':'dark');}}a();if(m&&m.addEventListener)m.addEventListener('change',a);})();</script>
    <meta name="darkreader-lock">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Manage <%= guild.name %> with CertiFried MultiTool">
    <meta name="theme-color" content="#a78bfa">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title>Manage <%= guild.name %> - CertiFried MultiTool</title>
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --bg-primary: #0b0f11;
            --bg-secondary: #0f1316;
            --bg-card: rgba(255, 255, 255, 0.03);
            --bg-card-hover: rgba(255, 255, 255, 0.06);
            --border-color: rgba(255, 255, 255, 0.08);
            --text-primary: #ffffff;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --text-muted: rgba(255, 255, 255, 0.5);
            --accent-purple: #a78bfa;
            --accent-blue: #60a5fa;
            --accent-green: #23f56b;
            --accent-cyan: #22d3ee;
            --accent-yellow: #fbbf24;
            --accent-red: #f87171;
            --accent-orange: #fb923c;
            --accent-pink: #f472b6;

            /* Extended color palette for partials */
            --color-dark-400: rgba(255, 255, 255, 0.1);
            --color-dark-500: #1a1d21;
            --color-dark-600: #14171a;
            --color-dark-700: #0f1214;
            --color-dark-800: #0b0d0f;
            --color-text-primary: #ffffff;
            --color-text-secondary: rgba(255, 255, 255, 0.7);
            --color-text-muted: rgba(255, 255, 255, 0.5);
            --color-primary-400: #a78bfa;
            --color-primary-500: #8b5cf6;
            --color-accent-purple: #a78bfa;
            --color-accent-green: #23f56b;
            --color-success: #23f56b;
            --color-danger: #f87171;
            --color-warning: #fbbf24;

            /* Spacing */
            --spacing-1: 0.25rem;
            --spacing-2: 0.5rem;
            --spacing-3: 0.75rem;
            --spacing-4: 1rem;
            --spacing-5: 1.25rem;
            --spacing-6: 1.5rem;
            --spacing-8: 2rem;
            --spacing-10: 2.5rem;
            --spacing-12: 3rem;

            /* Typography */
            --font-size-xs: 0.75rem;
            --font-size-sm: 0.875rem;
            --font-size-base: 1rem;
            --font-size-lg: 1.125rem;
            --font-size-xl: 1.25rem;
            --font-size-2xl: 1.5rem;
            --font-weight-normal: 400;
            --font-weight-medium: 500;
            --font-weight-semibold: 600;
            --font-weight-bold: 700;

            /* Border radius */
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;
            --radius-xl: 18px;
        }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            line-height: 1.6;
        }

        /* Background Effects */
        .bg-effects { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: hidden; }
        .orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.2; animation: float 25s ease-in-out infinite; }
        .orb-1 { width: 500px; height: 500px; background: linear-gradient(135deg, #7c3aed, var(--clx-violet, #a78bfa)); top: -15%; right: -10%; }
        .orb-2 { width: 400px; height: 400px; background: linear-gradient(135deg, var(--clx-blue, #3b82f6), var(--clx-blue, #60a5fa)); bottom: -15%; left: -10%; animation-delay: -12s; }
        @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, 30px) scale(1.05); } }

        .container { width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2rem); }

        /* Navbar */
        .navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; padding: 1rem 0; background: var(--clx-surface, rgba(11, 15, 17, 0.9)); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-color); }
        .navbar-content { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .navbar-brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-primary); font-weight: 700; font-size: 1.1rem; }
        .navbar-logo { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-purple); }
        .navbar-links { display: flex; align-items: center; gap: 1.5rem; }
        .navbar-links a { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
        .navbar-links a:hover, .navbar-links a.active { color: var(--text-primary); }
        .user-menu-container { position: relative; }
        .user-menu { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 50px; cursor: pointer; transition: all 0.2s; }
        .user-menu:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); }
        .user-avatar { width: 28px; height: 28px; border-radius: 50%; }
        .user-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
        .user-menu-chevron { font-size: 0.7rem; color: var(--text-muted); transition: transform 0.2s; }
        .user-menu-container.open .user-menu-chevron { transform: rotate(180deg); }

        /* User Dropdown */
        .user-dropdown { position: absolute; top: calc(100% + 8px); right: 0; min-width: 220px; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: all 0.2s ease; z-index: 1001; overflow: hidden; }
        .user-menu-container.open .user-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-header { padding: 1rem; border-bottom: 1px solid var(--border-color); }
        .dropdown-user-info { font-size: 0.8rem; color: var(--text-muted); }
        .dropdown-divider { height: 1px; background: var(--border-color); margin: 0.5rem 0; }
        .dropdown-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: all 0.15s; }
        .dropdown-item:hover { background: var(--bg-card-hover); color: var(--text-primary); }
        .dropdown-item i { width: 18px; text-align: center; }
        .dropdown-item.text-warning { color: var(--accent-yellow); }
        .dropdown-item.text-warning:hover { background: color-mix(in srgb, var(--clx-yellow, #fbbf24) 10%, transparent); }
        .dropdown-item.text-danger { color: var(--accent-red); }
        .dropdown-item.text-danger:hover { background: color-mix(in srgb, var(--clx-red, #f87171) 10%, transparent); }

        /* Main Content */
        main { position: relative; z-index: 1; padding: 100px 0 4rem; min-height: 100vh; }

        /* Server Header */
        .server-header { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border-color); }
        .server-icon-wrap { position: relative; }
        .server-icon { width: 72px; height: 72px; border-radius: 16px; object-fit: cover; border: 3px solid var(--border-color); transition: border-color 0.3s; }
        .server-icon:hover { border-color: var(--accent-purple); }
        .server-status { position: absolute; bottom: -4px; right: -4px; width: 22px; height: 22px; background: var(--accent-green); border-radius: 50%; border: 3px solid var(--bg-primary); }
        .server-info { flex: 1; min-width: 200px; }
        .server-name { font-size: 1.75rem; font-weight: 800; margin-bottom: 0.25rem; }
        .server-meta { display: flex; flex-wrap: wrap; gap: 1.5rem; color: var(--text-secondary); font-size: 0.9rem; }
        .server-meta-item { display: flex; align-items: center; gap: 0.5rem; }
        .server-meta-item i { color: var(--accent-purple); width: 16px; }
        .server-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
        .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.25rem; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); text-decoration: none; border-radius: 12px; font-weight: 600; font-size: 0.9rem; transition: all 0.2s; }
        .btn-back:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); color: var(--text-primary); }
        .btn-back i { font-size: 0.85rem; }

        /* Breadcrumb */
        .breadcrumb-nav { margin-bottom: 2rem; }
        .breadcrumb { display: flex; align-items: center; gap: 0.5rem; list-style: none; padding: 0; margin: 0; }
        .breadcrumb-item { display: flex; align-items: center; gap: 0.5rem; }
        .breadcrumb-item a { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
        .breadcrumb-item a:hover { color: var(--accent-purple); }
        .breadcrumb-item.active { color: var(--text-primary); font-weight: 600; font-size: 0.9rem; }
        .breadcrumb-sep { color: var(--text-muted); }

        /* Animations */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes sectionReveal {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Module Grid */
        .modules-section {
            margin-bottom: 1.75rem;
            background: color-mix(in srgb, var(--clx-white, #ffffff) 1.2%, transparent);
            border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 4%, transparent);
            border-left: 3px solid var(--card-accent, #a78bfa);
            border-radius: 4px 16px 16px 4px;
            padding: 1.5rem 1.5rem 1.25rem;
            position: relative;
            animation: sectionReveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
            transition: background 0.3s ease;
        }
        .modules-section:nth-child(1) { animation-delay: 0s; }
        .modules-section:nth-child(2) { animation-delay: 0.06s; }
        .modules-section:nth-child(3) { animation-delay: 0.12s; }
        .modules-section:nth-child(4) { animation-delay: 0.18s; }
        .modules-section:nth-child(5) { animation-delay: 0.24s; }
        .modules-section:nth-child(6) { animation-delay: 0.30s; }
        .modules-section:nth-child(7) { animation-delay: 0.36s; }
        .modules-section:nth-child(8) { animation-delay: 0.42s; }
        .modules-section:nth-child(9) { animation-delay: 0.48s; }
        .modules-section:hover {
            background: color-mix(in srgb, var(--clx-white, #ffffff) 2%, transparent);
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
            padding-bottom: 0.875rem;
            border-bottom: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 5%, transparent);
        }
        .section-header-text {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        .section-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            box-shadow: 0 4px 14px color-mix(in srgb, var(--card-accent, #a78bfa) 25%, transparent);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .section-toggle:hover .section-icon {
            transform: scale(1.08);
        }
        .section-title {
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--card-accent, var(--text-primary));
            text-transform: uppercase;
            letter-spacing: 0.08em;
            line-height: 1;
        }
        .section-desc {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 400;
            letter-spacing: 0;
            text-transform: none;
        }
        .section-count {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--card-accent, var(--text-muted));
            background: color-mix(in srgb, var(--card-accent, #a78bfa) 10%, transparent);
            padding: 0.2rem 0.55rem;
            border-radius: 50px;
            margin-left: 0.5rem;
            border: 1px solid color-mix(in srgb, var(--card-accent, #a78bfa) 15%, transparent);
        }

        /* ------------------------------------------------------------------
           Per-user layout (migration 185 + core/user-preferences.js).

           Grid is the default and is identical to what shipped before, so
           anyone who never opens settings sees no change at all.

           NOTE ON SELECTORS: the card markup is
               a.module-card > div.module-header > (div.module-icon, div > .module-title + .module-desc)
           An earlier version of this block targeted .module-card-icon /
           .module-card-title / .module-card-desc — names that exist nowhere in
           this file. The result was that list mode applied only `display:grid`
           and crammed the whole card into a 32px column, and cozy mode applied
           nothing at all. Selectors below are checked against the real markup.
           ------------------------------------------------------------------ */

        /* ---- LIST: dense single-column rows ---- */
        [data-layout="list"] .module-grid {
            display: flex !important;
            flex-direction: column;
            gap: 4px;
        }
        [data-layout="list"] .module-card {
            padding: 0.6rem 0.85rem !important;
            border-radius: 10px;
            animation: none !important;   /* the entry stagger reads as jitter in a dense list */
        }
        [data-layout="list"] .module-header {
            gap: 0.7rem;
        }
        [data-layout="list"] .module-icon {
            width: 30px !important;
            height: 30px !important;
            border-radius: 8px !important;
            font-size: 0.82rem !important;
        }
        [data-layout="list"] .module-title {
            font-size: 0.9rem !important;
            margin: 0 !important;
        }
        /* The title carries it at this density; keeping the description would
           defeat the point of the mode. */
        [data-layout="list"] .module-desc { display: none !important; }
        /* Any decorative extras a card carries (badges, arrows, glow overlays)
           would break the single-line rhythm. */
        [data-layout="list"] .module-card::before,
        [data-layout="list"] .module-card::after { display: none !important; }

        /* ---- COZY: fewer, larger cards, description kept ---- */
        [data-layout="cozy"] .module-grid {
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)) !important;
        }
        [data-layout="cozy"] .module-card { padding: 1.6rem !important; }
        [data-layout="cozy"] .module-icon {
            width: 50px !important;
            height: 50px !important;
            font-size: 1.25rem !important;
        }
        [data-layout="cozy"] .module-title { font-size: 1.08rem !important; }
        [data-layout="cozy"] .module-desc {
            font-size: 0.9rem !important;
            line-height: 1.55 !important;
            /* Grid clamps the description to one line; cozy exists to show it. */
            white-space: normal !important;
            overflow: visible !important;
            display: block !important;
            -webkit-line-clamp: unset !important;
        }

        /* Compact density tightens whichever layout is active. */
        [data-compact="1"] .module-card { padding: 0.55rem 0.75rem !important; }
        [data-compact="1"] .module-grid { gap: 0.5rem; }

        /* Pinned shortcuts */
        .pinned-row { margin-bottom: 1.25rem; }
        .pinned-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem; }
        .pinned-items { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .pinned-item { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.75rem; border-radius: 999px; background: var(--bg-secondary, #0f1316); border: 1px solid var(--border-color); color: var(--text-primary); text-decoration: none; font-size: 0.82rem; font-weight: 600; }
        .pinned-item:hover { border-color: var(--accent-purple, #a78bfa); }

        .layout-toggle { display: flex; gap: 2px; background: var(--bg-secondary, #0f1316); border: 1px solid var(--border-color); border-radius: 8px; padding: 2px; flex: none; }
        .layout-toggle button { border: 0; background: transparent; color: var(--text-muted); padding: 0.35rem 0.6rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
        .layout-toggle button.is-on { background: var(--accent-purple, #a78bfa); color: #0b0f11; }

        .module-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1rem;
        }

        .module-card {
            display: block;
            background: color-mix(in srgb, var(--clx-white, #ffffff) 2%, transparent);
            border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
            border-radius: 14px;
            padding: 1.35rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        /* Staggered card entrance — up to 16 cards per section */
        .module-grid .module-card:nth-child(1) { animation-delay: 0.04s; }
        .module-grid .module-card:nth-child(2) { animation-delay: 0.08s; }
        .module-grid .module-card:nth-child(3) { animation-delay: 0.12s; }
        .module-grid .module-card:nth-child(4) { animation-delay: 0.16s; }
        .module-grid .module-card:nth-child(5) { animation-delay: 0.20s; }
        .module-grid .module-card:nth-child(6) { animation-delay: 0.24s; }
        .module-grid .module-card:nth-child(7) { animation-delay: 0.28s; }
        .module-grid .module-card:nth-child(8) { animation-delay: 0.32s; }
        .module-grid .module-card:nth-child(9) { animation-delay: 0.36s; }
        .module-grid .module-card:nth-child(10) { animation-delay: 0.40s; }
        .module-grid .module-card:nth-child(11) { animation-delay: 0.44s; }
        .module-grid .module-card:nth-child(12) { animation-delay: 0.48s; }
        .module-grid .module-card:nth-child(13) { animation-delay: 0.52s; }
        .module-grid .module-card:nth-child(14) { animation-delay: 0.56s; }
        .module-grid .module-card:nth-child(15) { animation-delay: 0.60s; }

        .module-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--card-gradient, linear-gradient(90deg, var(--card-accent, #a78bfa), var(--card-accent-end, #a78bfa)));
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .module-card::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at top left, color-mix(in srgb, var(--card-accent, #a78bfa) 5%, transparent), transparent 60%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .module-card:hover {
            border-color: color-mix(in srgb, var(--card-accent, #a78bfa) 35%, transparent);
            transform: translateY(-3px);
            box-shadow: 0 12px 32px color-mix(in srgb, var(--card-accent, #a78bfa) 8%, rgba(0,0,0,0.25));
            background: color-mix(in srgb, var(--clx-white, #ffffff) 3.5%, transparent);
        }
        .module-card:hover::before { opacity: 1; }
        .module-card:hover::after { opacity: 1; }
        .module-card:hover .module-icon {
            transform: scale(1.1);
            box-shadow: 0 4px 16px color-mix(in srgb, var(--card-accent, #a78bfa) 20%, transparent);
        }
        .module-card:hover .module-title {
            color: var(--card-accent, var(--text-primary));
        }

        .module-header { display: flex; align-items: center; gap: 0.875rem; }
        .module-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            flex-shrink: 0;
            border: 1px solid color-mix(in srgb, var(--card-accent, #a78bfa) 15%, transparent);
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .module-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 0.2rem;
            transition: color 0.3s ease;
        }
        .module-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.45; }
        .module-badge { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.2rem 0.5rem; background: color-mix(in srgb, var(--clx-green, #23f56b) 15%, transparent); color: var(--accent-green); border-radius: 50px; font-size: 0.65rem; font-weight: 600; margin-top: 0.5rem; }
        .module-badge i { font-size: 0.5rem; }

        /* Feature status dot */
        .module-status {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: color-mix(in srgb, var(--clx-white, #ffffff) 15%, transparent);
            transition: all 0.3s ease;
            z-index: 2;
        }
        .module-status.active {
            background: var(--clx-green, #23f56b);
            box-shadow: 0 0 8px color-mix(in srgb, var(--clx-green, #23f56b) 40%, transparent);
        }
        .module-status.active::after {
            content: '';
            position: absolute;
            top: -2px; left: -2px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 1px solid color-mix(in srgb, var(--clx-green, #23f56b) 25%, transparent);
            animation: statusPulse 2s ease-in-out infinite;
        }
        @keyframes statusPulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.4); opacity: 0; }
        }

        /* Search & Filter */
        .overview-search-wrap { margin-bottom: 1.75rem; }
        .overview-search { position: relative; margin-bottom: 0.875rem; }
        .overview-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem; }
        .overview-search input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            background: color-mix(in srgb, var(--clx-white, #ffffff) 2%, transparent);
            border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
            border-radius: 12px;
            color: var(--clx-ink, #ffffff);
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .overview-search input:focus {
            outline: none;
            border-color: var(--accent-purple);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--clx-violet, #a78bfa) 12%, transparent), 0 4px 16px color-mix(in srgb, var(--clx-violet, #a78bfa) 8%, transparent);
            background: color-mix(in srgb, var(--clx-white, #ffffff) 3.5%, transparent);
        }
        .overview-search input:focus + .search-shortcut { opacity: 0; }
        .overview-search input::placeholder { color: var(--text-muted); }
        .category-tabs {
            display: flex;
            gap: 0.25rem;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            padding: 4px;
            background: color-mix(in srgb, var(--clx-white, #ffffff) 2%, transparent);
            border-radius: 10px;
            border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 4%, transparent);
        }
        .category-tab {
            padding: 0.5rem 0.875rem;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
            border-radius: 7px;
            white-space: nowrap;
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
            font-family: inherit;
            position: relative;
        }
        .category-tab .tab-count {
            font-size: 0.6rem;
            font-weight: 700;
            opacity: 0.5;
            margin-left: 0.25rem;
        }
        .category-tab:hover {
            color: var(--text-primary);
            background: color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
        }
        .category-tab.active {
            color: var(--tab-accent, var(--clx-violet, var(--accent-purple)));
            background: color-mix(in srgb, var(--tab-accent, var(--accent-purple)) 12%, transparent);
            box-shadow: 0 1px 8px color-mix(in srgb, var(--tab-accent, var(--accent-purple)) 12%, transparent);
        }
        .category-tab.active .tab-count {
            opacity: 0.8;
        }

        /* Section collapse */
        .section-toggle { cursor: pointer; user-select: none; position: relative; }
        .section-chevron {
            margin-left: auto;
            font-size: 0.7rem;
            color: var(--text-muted);
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
        }
        .section-toggle:hover .section-chevron {
            background: color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
            color: var(--text-primary);
        }
        .modules-section.collapsed .module-grid {
            display: none;
        }
        .modules-section.collapsed .section-chevron { transform: rotate(-90deg); }
        .modules-section.collapsed {
            padding-bottom: 1rem;
        }
        .modules-section.collapsed .section-header {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
        .module-card.search-hidden { display: none !important; }
        .modules-section.search-hidden { display: none !important; }

        /* Color classes for modules — each with unique gradient */
        .purple { --card-accent: var(--clx-violet, #a78bfa); --card-accent-end: var(--clx-violet, #c4b5fd); --card-gradient: linear-gradient(90deg, var(--clx-violet, #8b5cf6), var(--clx-violet, #c4b5fd)); }
        .purple .module-icon, .purple .section-icon { background: color-mix(in srgb, var(--clx-violet, #a78bfa) 15%, transparent); color: var(--clx-violet, #a78bfa); }

        .blue { --card-accent: var(--clx-blue, #60a5fa); --card-accent-end: var(--clx-blue, #93c5fd); --card-gradient: linear-gradient(90deg, var(--clx-blue, #3b82f6), var(--clx-blue, #93c5fd)); }
        .blue .module-icon, .blue .section-icon { background: color-mix(in srgb, var(--clx-blue, #60a5fa) 15%, transparent); color: var(--clx-blue, #60a5fa); }

        .green { --card-accent: var(--clx-green, #23f56b); --card-accent-end: var(--clx-green, #86efac); --card-gradient: linear-gradient(90deg, var(--clx-green, #22c55e), var(--clx-green, #86efac)); }
        .green .module-icon, .green .section-icon { background: color-mix(in srgb, var(--clx-green, #23f56b) 15%, transparent); color: var(--clx-green, #23f56b); }

        .cyan { --card-accent: var(--clx-cyan, #22d3ee); --card-accent-end: var(--clx-cyan, #67e8f9); --card-gradient: linear-gradient(90deg, var(--clx-cyan, #06b6d4), var(--clx-cyan, #67e8f9)); }
        .cyan .module-icon, .cyan .section-icon { background: color-mix(in srgb, var(--clx-cyan, #22d3ee) 15%, transparent); color: var(--clx-cyan, #22d3ee); }

        .yellow { --card-accent: var(--clx-yellow, #fbbf24); --card-accent-end: var(--clx-yellow, #fde68a); --card-gradient: linear-gradient(90deg, var(--clx-orange, #f59e0b), var(--clx-yellow, #fde68a)); }
        .yellow .module-icon, .yellow .section-icon { background: color-mix(in srgb, var(--clx-yellow, #fbbf24) 15%, transparent); color: var(--clx-yellow, #fbbf24); }

        .red { --card-accent: var(--clx-red, #f87171); --card-accent-end: var(--clx-red, #fca5a5); --card-gradient: linear-gradient(90deg, var(--clx-red, #ef4444), var(--clx-red, #fca5a5)); }
        .red .module-icon, .red .section-icon { background: color-mix(in srgb, var(--clx-red, #f87171) 15%, transparent); color: var(--clx-red, #f87171); }

        .orange { --card-accent: var(--clx-orange, #fb923c); --card-accent-end: var(--clx-orange, #fdba74); --card-gradient: linear-gradient(90deg, var(--clx-orange, #f97316), var(--clx-orange, #fdba74)); }
        .orange .module-icon, .orange .section-icon { background: color-mix(in srgb, var(--clx-orange, #fb923c) 15%, transparent); color: var(--clx-orange, #fb923c); }

        .pink { --card-accent: var(--clx-pink, #f472b6); --card-accent-end: var(--clx-pink, #f9a8d4); --card-gradient: linear-gradient(90deg, var(--clx-pink, #ec4899), var(--clx-pink, #f9a8d4)); }
        .pink .module-icon, .pink .section-icon { background: color-mix(in srgb, var(--clx-pink, #f472b6) 15%, transparent); color: var(--clx-pink, #f472b6); }

        .indigo { --card-accent: var(--clx-indigo, #818cf8); --card-accent-end: var(--clx-indigo, #a5b4fc); --card-gradient: linear-gradient(90deg, var(--clx-indigo, #6366f1), var(--clx-indigo, #a5b4fc)); }
        .indigo .module-icon, .indigo .section-icon { background: color-mix(in srgb, var(--clx-indigo, #818cf8) 15%, transparent); color: var(--clx-indigo, #818cf8); }

        .teal { --card-accent: var(--clx-teal, #2dd4bf); --card-accent-end: var(--clx-teal, #5eead4); --card-gradient: linear-gradient(90deg, var(--clx-teal, #14b8a6), var(--clx-teal, #5eead4)); }
        .teal .module-icon, .teal .section-icon { background: color-mix(in srgb, var(--clx-teal, #2dd4bf) 15%, transparent); color: var(--clx-teal, #2dd4bf); }

        /* Quick Stats */
        .quick-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card {
            background: color-mix(in srgb, var(--clx-white, #ffffff) 2%, transparent);
            border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
            border-left: 3px solid var(--stat-accent, var(--accent-purple));
            border-radius: 4px 14px 14px 4px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        }
        .stat-card:nth-child(1) { animation-delay: 0.05s; }
        .stat-card:nth-child(2) { animation-delay: 0.1s; }
        .stat-card:nth-child(3) { animation-delay: 0.15s; }
        .stat-card:nth-child(4) { animation-delay: 0.2s; }
        .stat-card::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(ellipse at left, color-mix(in srgb, var(--stat-accent, #a78bfa) 5%, transparent), transparent 60%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }
        .stat-card:hover {
            border-color: color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px color-mix(in srgb, var(--stat-accent, #a78bfa) 8%, rgba(0,0,0,0.2));
        }
        .stat-card:hover::after { opacity: 1; }
        .stat-card:hover .stat-icon { transform: scale(1.08); }
        .stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            box-shadow: 0 4px 12px color-mix(in srgb, var(--stat-accent, #a78bfa) 20%, transparent);
        }
        .stat-value { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }

        .stat-purple { --stat-accent: var(--clx-violet, #a78bfa); }
        .stat-purple .stat-icon { background: color-mix(in srgb, var(--clx-violet, #a78bfa) 15%, transparent); color: var(--clx-violet, #a78bfa); }
        .stat-cyan { --stat-accent: var(--clx-cyan, #22d3ee); }
        .stat-cyan .stat-icon { background: color-mix(in srgb, var(--clx-cyan, #22d3ee) 15%, transparent); color: var(--clx-cyan, #22d3ee); }
        .stat-green { --stat-accent: var(--clx-green, #23f56b); }
        .stat-green .stat-icon { background: color-mix(in srgb, var(--clx-green, #23f56b) 15%, transparent); color: var(--clx-green, #23f56b); }
        .stat-red { --stat-accent: var(--clx-red, #f87171); }
        .stat-red .stat-icon { background: color-mix(in srgb, var(--clx-red, #f87171) 15%, transparent); color: var(--clx-red, #f87171); }

        /* Recently Visited */
        .recent-visited {
            margin-bottom: 1.75rem;
            animation: fadeInUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
            animation-delay: 0.1s;
        }
        .recent-visited-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .recent-visited-label i { font-size: 0.65rem; }
        .recent-visited-grid {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding-bottom: 4px;
            -webkit-overflow-scrolling: touch;
        }
        .recent-chip {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            background: color-mix(in srgb, var(--clx-white, #ffffff) 3%, transparent);
            border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
            border-radius: 10px;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
            flex-shrink: 0;
        }
        .recent-chip:hover {
            background: color-mix(in srgb, var(--clx-white, #ffffff) 6%, transparent);
            border-color: color-mix(in srgb, var(--clx-violet, #a78bfa) 30%, transparent);
            transform: translateY(-1px);
        }
        .recent-chip i {
            font-size: 0.75rem;
            color: var(--accent-purple);
            width: 14px;
            text-align: center;
        }
        .recent-chip span {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-secondary);
        }
        .recent-chip:hover span { color: var(--text-primary); }

        /* Card Components for Partials */
        .card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; backdrop-filter: blur(10px); }
        .card-hover { transition: all 0.3s; }
        .card-hover:hover { border-color: var(--accent-purple); transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); }
        .card-body { padding: 1.5rem; }
        .card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color); }
        .card-footer { padding: 1.25rem 1.5rem; border-top: 1px solid var(--border-color); }

        /* Grid System */
        .grid { display: grid; }
        .grid-cols-1 { grid-template-columns: repeat(1, 1fr); }
        .grid-cols-2 { grid-template-columns: repeat(2, 1fr); }
        .grid-cols-3 { grid-template-columns: repeat(3, 1fr); }
        .grid-cols-4 { grid-template-columns: repeat(4, 1fr); }
        @media (max-width: 768px) {
            .grid-cols-2, .grid-cols-3, .grid-cols-4 { grid-template-columns: 1fr; }
        }

        /* Page Section Styles */
        .page-section { margin-bottom: 2rem; }
        .page-section-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
        .page-section-title { display: flex; align-items: center; gap: 0.75rem; font-size: 1.25rem; font-weight: 700; color: var(--text-primary); }
        .page-section-title i { color: var(--accent-purple); }
        .page-section-subtitle { font-size: 0.9rem; color: var(--text-muted); margin-top: 0.25rem; }

        /* Stat Cards for Partials */
        .stat-card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
        .stat-card-item { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 1rem; text-align: center; }
        .stat-card-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
        .stat-card-value { font-size: 1.5rem; font-weight: 800; color: var(--text-primary); }
        .stat-card-value.primary { color: var(--accent-purple); }
        .stat-card-value.purple { color: var(--accent-purple); }
        .stat-card-value.success { color: var(--accent-green); }
        .stat-card-value.danger { color: var(--accent-red); }

        /* Table Styles */
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th { background: var(--bg-secondary); padding: 1rem; text-align: left; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-color); }
        .data-table td { padding: 1rem; border-bottom: 1px solid var(--border-color); color: var(--text-secondary); }
        .data-table tr:hover td { background: color-mix(in srgb, var(--clx-white, #ffffff) 2%, transparent); }
        .data-table tr:last-child td { border-bottom: none; }

        /* Page Content Area */
        .page-content { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 2rem; }

        /* Form styles */
        .manage-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem; backdrop-filter: blur(10px); }
        .manage-card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
        .manage-card-title { font-size: 1.125rem; font-weight: 700; }

        .form-label { font-size: 0.875rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.5rem; display: block; }
        .form-control, .form-select, .form-input, .form-textarea { background: color-mix(in srgb, var(--clx-white, #ffffff) 5%, transparent); border: 1px solid var(--border-color); color: var(--clx-ink, #ffffff) !important; border-radius: 10px; padding: 0.625rem 0.875rem; font-size: 0.875rem; transition: all 0.2s; }
        .form-control:focus, .form-select:focus, .form-input:focus, .form-textarea:focus { background: color-mix(in srgb, var(--clx-white, #ffffff) 8%, transparent); border-color: var(--accent-purple); box-shadow: 0 0 0 3px color-mix(in srgb, var(--clx-violet, #a78bfa) 10%, transparent); outline: none; }
        .form-control::placeholder, .form-input::placeholder, .form-textarea::placeholder { color: var(--text-muted); }
        /* Global input text fix — ensure ALL inputs have white text on dark backgrounds */
        input, select, textarea { color: var(--clx-ink, #ffffff) !important; }
        input[type="text"], input[type="number"], input[type="password"], input[type="email"], input[type="url"], input[type="search"], input[type="tel"],
        textarea, select { background-color: color-mix(in srgb, var(--clx-white, #ffffff) 5%, transparent); }
        input::placeholder, textarea::placeholder { color: var(--clx-ink-3, rgba(255, 255, 255, 0.35)) !important; }
        .form-select option { background: var(--bg-primary); color: var(--text-primary); }
        .form-select option:checked, .form-select option:active { background: var(--accent-purple); color: #fff; }
        .form-select[multiple] option:checked { background: linear-gradient(0deg, var(--accent-purple) 0%, var(--accent-purple) 100%); color: #fff; }
        .form-check-input { background-color: color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent); border-color: var(--border-color); }
        .form-check-input:checked { background-color: var(--accent-purple); border-color: var(--accent-purple); }

        /* Button styles */
        .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border-radius: 10px; font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; font-family: inherit; }
        .btn i { font-size: 0.85rem; }
        .btn-primary { background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue)); color: white; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 15px color-mix(in srgb, var(--clx-violet, #a78bfa) 30%, transparent); color: white; }
        .btn-secondary { background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-primary); }
        .btn-secondary:hover { background: var(--bg-card-hover); border-color: var(--accent-purple); color: var(--text-primary); }
        .btn-danger { background: color-mix(in srgb, var(--clx-red, #f87171) 15%, transparent); border: 1px solid color-mix(in srgb, var(--clx-red, #f87171) 30%, transparent); color: var(--accent-red); }
        .btn-danger:hover { background: color-mix(in srgb, var(--clx-red, #f87171) 25%, transparent); }
        .btn-success { background: color-mix(in srgb, var(--clx-green, #23f56b) 15%, transparent); border: 1px solid color-mix(in srgb, var(--clx-green, #23f56b) 30%, transparent); color: var(--accent-green); }
        .btn-success:hover { background: color-mix(in srgb, var(--clx-green, #23f56b) 25%, transparent); }

        /* Table styles */
        .table { --bs-table-bg: transparent; --bs-table-color: var(--text-primary); --bs-table-border-color: var(--border-color); }
        .table th { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); border-bottom-width: 1px; }
        .table td { font-size: 0.875rem; vertical-align: middle; border-bottom: 1px solid var(--border-color); }
