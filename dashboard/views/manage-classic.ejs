        .page-content .text-secondary { color: var(--text-secondary) !important; }

        /* Alert styles */
        .alert { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; color: var(--text-primary); }
        .alert-success { background: color-mix(in srgb, var(--clx-green, #23f56b) 10%, transparent); border-color: color-mix(in srgb, var(--clx-green, #23f56b) 30%, transparent); }
        .alert-warning { background: color-mix(in srgb, var(--clx-yellow, #fbbf24) 10%, transparent); border-color: color-mix(in srgb, var(--clx-yellow, #fbbf24) 30%, transparent); }
        .alert-danger { background: color-mix(in srgb, var(--clx-red, #f87171) 10%, transparent); border-color: color-mix(in srgb, var(--clx-red, #f87171) 30%, transparent); }
        .alert-info { background: color-mix(in srgb, var(--clx-blue, #60a5fa) 10%, transparent); border-color: color-mix(in srgb, var(--clx-blue, #60a5fa) 30%, transparent); }

        /* Toggle switch */
        .toggle-switch { position: relative; width: 44px; height: 24px; cursor: pointer; }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider { position: absolute; inset: 0; background: color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent); border-radius: 24px; transition: all 0.3s; }
        .toggle-slider::before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; top: 3px; background: white; border-radius: 50%; transition: transform 0.3s; }
        .toggle-switch input:checked + .toggle-slider { background: var(--accent-purple); }
        .toggle-switch input:checked + .toggle-slider::before { transform: translateX(20px); }

        /* Empty state */
        .empty-state { text-align: center; padding: 3rem 1.5rem; color: var(--text-muted); }
