    <main id="main-content" tabindex="-1"
          data-layout="<%= (locals.userPrefs && userPrefs.dashboardLayout) || 'grid' %>"
          data-compact="<%= (locals.userPrefs && userPrefs.compactMode) ? '1' : '0' %>">
        <div class="container">
            <!-- Server Header -->
            <div class="server-header">
                <div class="server-icon-wrap">
                    <img src="<%= guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=128` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" class="server-icon" alt="<%= guild.name %>">
                    <div class="server-status"></div>
                </div>
                <div class="server-info">
                    <h1 class="server-name"><%= guild.name %></h1>
                    <div class="server-meta">
                        <span class="server-meta-item"><i class="fas fa-users"></i> <%= memberCount.toLocaleString() %> members</span>
                        <span class="server-meta-item"><i class="fas fa-video"></i> <%= streamerCount %> streamers</span>
                        <% if (liveCount > 0) { %>
                        <span class="server-meta-item" style="color: var(--accent-green);"><i class="fas fa-circle" style="font-size: 0.5rem;"></i> <%= liveCount %> live now</span>
                        <% } %>
                    </div>
                </div>
                <div class="server-actions">
                    <%
                    const _styles = (Array.isArray(locals.siteStyles) && siteStyles.length) ? siteStyles : [{ value: 'cards', label: 'Cards' }, { value: 'compact', label: 'Compact' }, { value: 'classic', label: 'Classic' }];
                    %>
                    <label class="style-switch" id="styleSwitch" title="Site style: how the dashboard looks. Saved to your account (also on Settings).">
                        <i class="fas fa-palette" aria-hidden="true"></i>
                        <span>Style</span>
                        <select id="styleSwitchSelect" aria-label="Site style">
                            <% _styles.forEach(function (s) { %><option value="<%= s.value %>"<%= s.value === 'classic' ? ' selected' : '' %>><%= s.label %></option><% }); %>
                        </select>
                        <span class="style-switch-status" id="styleSwitchStatus" role="status" aria-live="polite"></span>
                    </label>
                    <%- include('partials/manage/_server-switcher', { guild, variant: 'header', guildIconUrl: guild.icon ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.png?size=64` : 'https://cdn.discordapp.com/embed/avatars/0.png' }) %>
                </div>
            </div>

            <% if (page && page !== 'overview') { %>
            <!-- Breadcrumb for sub-pages -->
            <nav class="breadcrumb-nav">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/manage/<%= guild.id %>">Dashboard</a></li>
                    <li class="breadcrumb-sep"><i class="fas fa-chevron-right" style="font-size: 0.7rem; color: var(--text-muted);"></i></li>
                    <li class="breadcrumb-item active"><%= pageTitles[page] || page %></li>
                </ol>
            </nav>

            <!-- Page Content -->
            <div class="page-content">
                <%
                const streamingData = { guild, consolidatedStreamers, teamSubscriptions, twitchScheduleSyncs: typeof twitchScheduleSyncs !== 'undefined' ? twitchScheduleSyncs : [], scheduleTemplates: typeof scheduleTemplates !== 'undefined' ? scheduleTemplates : [], autoTrackConfigs: typeof autoTrackConfigs !== 'undefined' ? autoTrackConfigs : [], streamEndedSubs: typeof streamEndedSubs !== 'undefined' ? streamEndedSubs : [], settings, channels, roles, twitchRoleSyncConfig: typeof twitchRoleSyncConfig !== 'undefined' ? twitchRoleSyncConfig : null, twitchRoleSyncMembers: typeof twitchRoleSyncMembers !== 'undefined' ? twitchRoleSyncMembers : [] };
                const pageMap = {
                    // The streaming partial serves several pages. `tab` says which of its tabs
                    // the page opens on — without it every one of them lands on 'streamers'.
                    'streaming': { partial: 'streaming', tab: 'streamers', data: streamingData },
                    'streamers': { partial: 'streaming', tab: 'streamers', data: streamingData },
                    'teams': { partial: 'streaming', tab: 'teams', data: streamingData },
                    'role-sync': { partial: 'streaming', tab: 'role-sync', data: streamingData },
                    'appearance': { partial: 'appearance', data: { guild, settings, customBotInfo: typeof customBotInfo !== 'undefined' ? customBotInfo : null } },
                    'core': { partial: 'core', data: { guild, settings, roles, prefixConfig } },
                    'welcome': { partial: 'welcome', data: { guild, settings: welcomeSettings, channels } },
                    'reaction-roles': { partial: 'reaction-roles', data: { guild, panels: reactionRolePanels, roles, channels } },
                    'starboard': { partial: 'starboard', data: { guild, settings: starboardConfig, channels } },
                    'leveling': { partial: 'leveling', data: { guild, settings, rewards: roleRewards, roles, channels } },
                    'giveaways': { partial: 'giveaways', data: { guild, giveaways, channels } },
                    'polls': { partial: 'polls', data: { guild, polls, channels } },
                    'suggestions': { partial: 'suggestions', data: { guild, suggestions, suggestionConfig, suggestionStats, suggestionTags, suggestionFilters: locals.suggestionFilters || {}, channels, roles } },
                    'music': { partial: 'music', data: { guild, musicConfig: typeof musicConfig !== 'undefined' ? musicConfig : {}, availableDJVoices: typeof availableDJVoices !== 'undefined' ? availableDJVoices : [], roles, channels, voiceChannels } },
                    'soundboard': { partial: 'soundboard', data: { guild } },
                    'birthday': { partial: 'birthday', data: { guild, birthdays: typeof birthdayUsers !== 'undefined' ? birthdayUsers : [], birthdayStats: typeof birthdayStats !== 'undefined' ? birthdayStats : {}, birthdayConfig: typeof birthdayConfig !== 'undefined' ? birthdayConfig : {}, birthdayCards: typeof birthdayCards !== 'undefined' ? birthdayCards : [], channels, roles } },
                    'weather': { partial: 'weather', data: { guild, weatherStats, weatherConfig: typeof weatherConfig !== 'undefined' ? weatherConfig : {}, channels } },
                    'economy': { partial: 'economy', data: { guild, economyConfig, shopItems, economyStats, topUsers, roles } },
                    'owo':     { partial: 'critters', data: { guild } },
                    'games': { partial: 'games', data: { guild, triviaQuestions, hangmanWords, countingChannels, gameStats } },
                    'gambling': { partial: 'gambling', data: { guild, gamblingConfig, gamblingHistory, gamblingStats, topGamblers } },
                    'trading': { partial: 'trading', data: { guild, activeTrades, tradeHistory, tradeStats } },
                    'rpg': { partial: 'rpg', data: { guild, rpgStats, characters: rpgCharacters || [], quests: [] } },
                    'moderation': { partial: 'moderation', data: { guild, settings: moderationConfig, infractions: recentInfractions, escalationRules: escalationRules, channels, roles, banAvailable: locals.banCommandAvailable !== false } },
                    'automod': { partial: 'automod', data: { guild, automodRules: automodRules, heatConfig } },
                    'rejoin': { partial: 'rejoin', data: { guild, rejoin: typeof rejoin !== 'undefined' ? rejoin : null, channels } },
                    'holidays': { partial: 'holidays', data: { guild, channels, holidays: typeof holidays !== 'undefined' ? holidays : [], holidayAutoChannels: typeof holidayAutoChannels !== 'undefined' ? holidayAutoChannels : [] } },
                    'network-intel': { partial: 'network-intel', data: { guild, pendingReports: typeof pendingReports !== 'undefined' ? pendingReports : [], recentReports: typeof recentReports !== 'undefined' ? recentReports : [], blacklistEntries: typeof blacklistEntries !== 'undefined' ? blacklistEntries : [], networkStats: typeof networkStats !== 'undefined' ? networkStats : {} } },
                    'security': { partial: 'security', data: { guild, joinGate: joinGateConfig, antiRaid: antiRaidConfig, antiNuke: antiNukeConfig, quarantine: quarantineConfig, roles, channels } },
                    'advanced-protection': { partial: 'advanced-protection', data: { guild, raidConfig: typeof raidConfig !== 'undefined' ? raidConfig : null, selfbotConfig: typeof selfbotConfig !== 'undefined' ? selfbotConfig : null, adaptiveSpamConfig: typeof adaptiveSpamConfig !== 'undefined' ? adaptiveSpamConfig : null, raidIncidents: typeof raidIncidents !== 'undefined' ? raidIncidents : [], selfbotDetections: typeof selfbotDetections !== 'undefined' ? selfbotDetections : [], channels, roles } },
                    'quarantine': { partial: 'quarantine', data: { guild, quarantineConfig, quarantinedUsers: (locals.quarantinedUsers || []), roles } },
                    'mass': { partial: 'mass', data: { guild, roles, channels } },
                    'stat-roles': { partial: 'stat-roles', data: { guild, statroles: statroleConfigs, statroleConfigs, statroleGrantCounts: locals.statroleGrantCounts || {}, roles } },
                    'logging': { partial: 'logging', data: { guild, settings: logConfig, auditLogs: typeof auditLogs !== 'undefined' ? auditLogs : [], channels, channelSettingsMap: typeof channelSettingsMap !== 'undefined' ? channelSettingsMap : new Map() } },
                    'action-log': { partial: 'action-log', data: { guild, actionLogs: typeof actionLogs !== 'undefined' ? actionLogs : [] } },
                    'analytics': { partial: 'analytics', data: { guild, serverStats: typeof serverStats !== 'undefined' ? serverStats : [] } },
                    'feeds': { partial: 'feeds', data: { guild, guildId: guild.id, redditFeeds, youtubeFeeds, twitterFeeds, blueskyFeeds: (locals.blueskyFeeds || []), channels } },
                    'twitch-schedules': { partial: 'streaming', tab: 'schedules', data: streamingData },
                    'schedule-calendar': { partial: 'schedule-calendar', data: { guild, syncs: typeof twitchScheduleSyncs !== 'undefined' ? twitchScheduleSyncs : [] } },
                    'announcements': { partial: 'streaming', tab: 'appearance', data: streamingData },
                    'utilities': { partial: 'utilities', data: { guild, settings, autoPublisher: autoPublisherConfig, autoroles: autorolesConfig, tempChannels: tempChannelConfig, roles, channels, categories } },
                    'custom-commands': { partial: 'custom-commands', data: { guild, commands: customCommands, roles } },
                    'announce': { partial: 'announce', data: { guild, channels, roles } },
                    'custom-embeds': { partial: 'custom-embeds', data: { guild, customEmbeds: typeof customEmbeds !== 'undefined' ? customEmbeds : [], channels, roles } },
                    'auto-purge': { partial: 'auto-purge', data: { guild, purgeConfigs: typeof purgeConfigs !== 'undefined' ? purgeConfigs : [], channels } },
                    'smart-purge': { partial: 'smart-purge', data: { guild, purgeRules: typeof purgeRules !== 'undefined' ? purgeRules : [], channels, roles } },
                    'commands': { partial: 'commands', data: { guild, commands: typeof commandSettings !== 'undefined' ? commandSettings : [], commandRestrictions: typeof commandRestrictions !== 'undefined' ? commandRestrictions : {}, guildId: guild.id, prefixConfig: typeof prefixConfig !== 'undefined' ? prefixConfig : {}, prefixAliases: typeof prefixAliases !== 'undefined' ? prefixAliases : [] } },
                    // Fully API-driven: needs nothing but the guild.
                    'command-center': { partial: 'command-center', data: { guild } },
                    'initialize': { partial: 'initialize', data: { guild, channels } },
                    'takeover': { partial: 'takeover', data: { guild, channels } },
                    'kofi': { partial: 'kofi', data: { guild, channels, roles } },
                    'counting': { partial: 'counting', data: { guild, channels } },
                    'channel-access': { partial: 'channel-access', data: { guild, channels, roles } },
                    'link-filter': { partial: 'link-filter', data: { guild, channels, linkConfig: typeof linkConfig !== 'undefined' ? linkConfig : null, linkDomains: typeof linkDomains !== 'undefined' ? linkDomains : [], linkQueue: typeof linkQueue !== 'undefined' ? linkQueue : [], linkRemovals: typeof linkRemovals !== 'undefined' ? linkRemovals : [], linkDefaults: typeof linkDefaults !== 'undefined' ? linkDefaults : { social: [], media: [], blocked: [], monetisation: [] } } },
                    'commission-filter': { partial: 'commission-filter', data: { guild, channels, commissionConfig: typeof commissionConfig !== 'undefined' ? commissionConfig : null, commissionGroups: typeof commissionGroups !== 'undefined' ? commissionGroups : [], commissionGlobalStats: typeof commissionGlobalStats !== 'undefined' ? commissionGlobalStats : { enabledCount: 0, totalRemoved: 0 }, commissionRemovals: typeof commissionRemovals !== 'undefined' ? commissionRemovals : [], commissionPending: typeof commissionPending !== 'undefined' ? commissionPending : [], commissionExemptions: typeof commissionExemptions !== 'undefined' ? commissionExemptions : [], commissionSignals: typeof commissionSignals !== 'undefined' ? commissionSignals : [] } },
                    'minigames': { partial: 'minigames', data: { guild, channels } },
                    'forms': { partial: 'forms', data: { guild, forms: typeof forms !== 'undefined' ? forms : [], channels, botName: (typeof customBotInfo !== 'undefined' && customBotInfo && customBotInfo.bot_name) ? customBotInfo.bot_name : 'CertiFried Utility', guildMembers: typeof guildMembers !== 'undefined' ? guildMembers : [], viewerId: (typeof user !== 'undefined' && user) ? user.id : null, viewerName: (typeof user !== 'undefined' && user) ? (user.global_name || user.username) : null } },
                    'tickets': { partial: 'tickets', data: { guild, ticketConfig, forms: typeof ticketFormsList !== 'undefined' ? ticketFormsList : [], categories, roles } },
                    'modmail': { partial: 'modmail', data: { guild, channels, roles, categories, modmailConfig: locals.modmailConfig || {}, modmailStats: locals.modmailStats || {}, modmailThreads: locals.modmailThreads || [], modmailHistory: locals.modmailHistory || [], modmailBlockedUsers: locals.modmailBlockedUsers || [] } },
                    'backups': { partial: 'backups', data: { guild, backups: typeof backups !== 'undefined' ? backups : [] } },
                    'permissions': { partial: 'permissions', data: { guild, permissionOverrides: typeof permissionOverrides !== 'undefined' ? permissionOverrides : [], roles, channels } },
                    'reminders': { partial: 'reminders', data: { guild, reminders: typeof reminders !== 'undefined' ? reminders : [], channels, roles } },
                    'tags': { partial: 'tags', data: { guild, tags: typeof tags !== 'undefined' ? tags : [] } },
                    'autoresponders': { partial: 'autoresponders', data: { guild, channels, roles } },
                    'csv': { partial: 'csv', data: { guild } },
                    'achievements': { partial: 'achievements', data: { guild } },
                    'serverstats': { partial: 'serverstats', data: { guild, statDisplayChannels: typeof statDisplayChannels !== 'undefined' ? statDisplayChannels : [], voiceChannels: typeof voiceChannels !== 'undefined' ? voiceChannels : [] } },
                    'emojistats': { partial: 'emojistats', data: { guild } },
                    'emoji-manager': { partial: 'emoji-manager', data: { guild } },
                    'confessions': { partial: 'confessions', data: { guild, channels } },
                    'timecapsules': { partial: 'timecapsules', data: { guild } },
                    'automemes': { partial: 'automemes', data: { guild, channels } },
                    'sticky': { partial: 'sticky', data: { guild, channels, roles } },
                    'schedule': { partial: 'schedule', data: { guild, channels } },
                    'todo': { partial: 'todo', data: { guild, channels } },
                    'bulk-roles': { partial: 'bulk-roles', data: { guild } },
                    'role-manager': { partial: 'role-manager', data: { guild } },
                    'protection-settings': { partial: 'protection-settings', data: { guild } },
                    'name-filters': { partial: 'name-filters', data: { guild } },
                    'avatar-protection': { partial: 'avatar-protection', data: { guild } },
                    'verification': { partial: 'verification', data: { guild } },
                    'message-threats': { partial: 'message-threats', data: { guild } },
                    'ai-moderation': { partial: 'ai-moderation', data: { guild } },
                    'nsfw-protection': { partial: 'nsfw-protection', data: { guild } },
                    'domain-reports': { partial: 'domain-reports', data: { guild } },
                    'activity-audit': { partial: 'activity-audit', data: { guild } },
                    'join-requests': { partial: 'join-requests', data: { guild } },
                    'self-promo': { partial: 'self-promo', data: { guild, selfPromoConfig: typeof selfPromoConfig !== 'undefined' ? selfPromoConfig : {}, channels } },
                    'community-support': { partial: 'community-support', data: { guild, communitySupportConfig: typeof communitySupportConfig !== 'undefined' ? communitySupportConfig : {}, channels } },
                    // Per-streamer Edit-on-End lives in the streamers table, so that is the landing tab.
                    'stream-ended': { partial: 'streaming', tab: 'streamers', data: streamingData },
                    'auto-track': { partial: 'streaming', tab: 'auto-track', data: streamingData },
                    'streamer-blocklist': { partial: 'streamer-blocklist', data: { guild } },
                    'global-ban': { partial: 'global-ban', data: { guild, globalBanConfig: typeof globalBanConfig !== 'undefined' ? globalBanConfig : {}, channels } },
                    'phishing': { partial: 'phishing', data: { guild, phishingConfig: typeof phishingConfig !== 'undefined' ? phishingConfig : {}, channels } },
                    'free-games': { partial: 'free-games', data: { guild, freeGamesSubs: typeof freeGamesSubs !== 'undefined' ? freeGamesSubs : [], channels, roles: typeof roles !== 'undefined' ? roles : [] } },
                    // Fully API-driven: loads watchers + the preset catalogue on mount.
                    'game-news': { partial: 'game-news', data: { guild, channels, roles } },
                    'twitch-clips': { partial: 'twitch-clips', data: { guild, channels, roles } },
                    'steam-library': { partial: 'steam-library', data: { guild, channels } },
                    'digimon': { partial: 'digimon', data: { guild, channels } },
                    'digimon-odds': { partial: 'digimon-odds', data: { guild } },
                    'digimon-quiz': { partial: 'digimon-quiz', data: { guild } },
                    'tiktok': { partial: 'tiktok', data: { guild, tiktokSubs: typeof tiktokSubs !== 'undefined' ? tiktokSubs : [], tiktokConfig: typeof tiktokConfig !== 'undefined' ? tiktokConfig : {}, recentVideos: typeof recentTiktokVideos !== 'undefined' ? recentTiktokVideos : [], channels, roles } },
                    'stat-displays': { partial: 'stat-displays', data: { guild, statDisplayChannels: typeof statDisplayChannels !== 'undefined' ? statDisplayChannels : [], voiceChannels: typeof voiceChannels !== 'undefined' ? voiceChannels : [], roles } },
                    'throne': { partial: 'throne', data: { guild, channels, throneNotifications: typeof throneNotifications !== 'undefined' ? throneNotifications : [], throneGuildConfig: typeof throneGuildConfig !== 'undefined' ? throneGuildConfig : null, throneSettings: typeof throneSettings !== 'undefined' ? throneSettings : null } },
                    'event-schedule': { partial: 'event-schedule', data: { guild, channels } },
                    'language': { partial: 'language', data: { guild, locales: typeof availableLocaleMeta !== 'undefined' ? availableLocaleMeta : [], guildLocale: typeof guildLocale !== 'undefined' ? guildLocale : null } },
                    'theme': { partial: 'theme', data: { guild, theme: typeof guildTheme !== 'undefined' ? guildTheme : {}, defaultTheme: typeof defaultTheme !== 'undefined' ? defaultTheme : {} } },
                    'catalog': { partial: 'catalog', data: { guild, catalog: typeof featureCatalog !== 'undefined' ? featureCatalog : new Map() } },
                    // Pages added to manage-tailwind.ejs after the classic copy (same partials and data).
                    'discord-native': { partial: 'discord-native', data: { guild } },
                    'messages': { partial: 'bot-messages', data: typeof botMessagesData !== 'undefined' ? botMessagesData : {} },
                    'scheduled-messages': { partial: 'scheduled-messages', data: { guild } },
                    'channel-post-rules': { partial: 'channel-post-rules', data: { guild, channels, roles } },
                    'cfx': { partial: 'greenhouse', data: { guild } },
                    'greenhouse': { partial: 'greenhouse', data: { guild } },
                };

                // Every feature declared in core/feature-config-spec.js gets a page for free.
                // Generated rather than listed so a new spec entry cannot be added without its
                // page existing — the class of gap this whole exercise was fixing.
                if (typeof featureConfigKeys !== 'undefined' && Array.isArray(featureConfigKeys)) {
                    featureConfigKeys.forEach(function(key) {
                        if (!pageMap[key]) {
                            pageMap[key] = {
                                partial: 'feature-config',
                                data: { guild, channels, roles, voiceChannels, featureKey: key },
                            };
                        }
                    });
                }

                const activePage = pageMap[page];
                if (activePage) {
                %>
                    <!--
                      Seed the channel/role lookups before the partial's own script runs, so any
                      partial can call Discord.channel(id) without re-serialising the guild.
                    -->
                    <script>
                        // Which tab this page opens on, for partials that serve more than one page.
                        window.MANAGE_PAGE = <%- JSON.stringify(page) %>;
                        window.MANAGE_PAGE_TAB = <%- JSON.stringify(activePage.tab || null) %>;
                        Discord.init({
                            guildId: '<%= guild.id %>',
                            channels: <%- JSON.stringify((channels || []).map(c => ({ id: c.id, name: c.name }))) %>,
                            voiceChannels: <%- JSON.stringify((voiceChannels || []).map(c => ({ id: c.id, name: c.name }))) %>,
                            categories: <%- JSON.stringify((categories || []).map(c => ({ id: c.id, name: c.name }))) %>,
                            roles: <%- JSON.stringify((roles || []).map(r => ({ id: r.id, name: r.name, color: r.color }))) %>
                        });
                    </script>
                    <%- include('partials/kit/_help', { help: locals.pageHelp || null }) %>
                    <%- include(`partials/manage/${activePage.partial}`, activePage.data) %>
                <% } %>
            </div>
            <%- include('partials/manage/_related-pages', { guild, related: locals.relatedPages || [] }) %>

            <% } else { %>
            <!-- Overview Dashboard with Module Grid -->
            <%
            // Feature status indicators — derive from existing data
            // Use try/catch per field to handle any undefined variables gracefully
            function safeCheck(fn) { try { return !!fn(); } catch(e) { return false; } }
            const featureStatus = {
                'streamers': safeCheck(() => consolidatedStreamers && consolidatedStreamers.length > 0),
                'twitch-schedules': safeCheck(() => twitchScheduleSyncs && twitchScheduleSyncs.length > 0),
                'tiktok': safeCheck(() => tiktokSubs && tiktokSubs.length > 0),
                'welcome': safeCheck(() => welcomeSettings && (welcomeSettings.enabled || welcomeSettings.join_channel_id)),
                'reaction-roles': safeCheck(() => reactionRolePanels && reactionRolePanels.length > 0),
                'starboard': safeCheck(() => starboardConfig && (starboardConfig.enabled || starboardConfig.channel_id)),
                'leveling': safeCheck(() => settings && settings.leveling_enabled),
                'giveaways': safeCheck(() => giveaways && giveaways.length > 0),
                'suggestions': safeCheck(() => suggestionConfig && suggestionConfig.channel_id),
                'music': safeCheck(() => musicConfig && musicConfig.enabled !== false),
                'moderation': safeCheck(() => moderationConfig && (moderationConfig.mod_role_id || moderationConfig.mute_role_id)),
                'automod': safeCheck(() => automodRules && automodRules.length > 0),
                'security': safeCheck(() => (joinGateConfig && joinGateConfig.enabled) || (antiRaidConfig && antiRaidConfig.enabled) || (antiNukeConfig && antiNukeConfig.enabled)),
                'advanced-protection': safeCheck(() => antiRaidConfig && antiRaidConfig.enabled),
                'verification': safeCheck(() => joinGateConfig && (joinGateConfig.enabled || joinGateConfig.prune_enabled || joinGateConfig.inactive_never_enabled || joinGateConfig.inactive_quiet_enabled)),
                'rejoin': safeCheck(() => joinGateConfig && joinGateConfig.rejoin_limit_enabled),
                'phishing': safeCheck(() => phishingConfig && phishingConfig.enabled),
                'global-ban': safeCheck(() => globalBanConfig && globalBanConfig.enabled),
                'logging': safeCheck(() => logConfig && logConfig.log_channel_id),
                'auto-purge': safeCheck(() => purgeConfigs && purgeConfigs.length > 0),
                'smart-purge': safeCheck(() => purgeRules && purgeRules.length > 0),
                'self-promo': safeCheck(() => selfPromoConfig && selfPromoConfig.channel_id),
                'feeds': safeCheck(() => socialFeeds && socialFeeds.length > 0),
                'birthday': safeCheck(() => settings && settings.birthday_channel_id),
                'economy': safeCheck(() => settings && settings.economy_enabled),
                'custom-commands': safeCheck(() => prefixConfig && prefixConfig.enabled),
            };
            %>

            <!-- Quick Stats -->
            <div class="quick-stats">
                <div class="stat-card stat-purple">
                    <div class="stat-icon"><i class="fas fa-video"></i></div>
                    <div>
                        <div class="stat-value"><%= streamerCount %></div>
                        <div class="stat-label">Streamers</div>
                    </div>
                </div>
                <div class="stat-card stat-green">
                    <div class="stat-icon"><i class="fas fa-circle"></i></div>
                    <div>
                        <div class="stat-value"><%= liveCount %></div>
                        <div class="stat-label">Live Now</div>
                    </div>
                </div>
                <div class="stat-card stat-cyan">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <div>
                        <div class="stat-value"><%= memberCount.toLocaleString() %></div>
                        <div class="stat-label">Members</div>
                    </div>
                </div>
                <div class="stat-card stat-red">
                    <div class="stat-icon"><i class="fas fa-user-friends"></i></div>
                    <div>
                        <div class="stat-value"><%= teamSubscriptions.length %></div>
                        <div class="stat-label">Teams</div>
                    </div>
                </div>
            </div>

            <% if (!locals.checklistHidden) { %><%- include('partials/manage/_setup-checklist', { guild }) %><% } %>

            <!-- Support Banner -->
            <a href="https://certifriedmultitool.com/donate" target="_blank" class="support-banner">
                <div class="support-banner-glow"></div>
                <div class="support-banner-content">
                    <div class="support-banner-icon"><i class="fas fa-heart"></i></div>
                    <div class="support-banner-text">
                        <div class="support-banner-title">Support CertiFried MultiTool</div>
                        <div class="support-banner-desc">Help keep the bot running and fund new features</div>
                    </div>
                    <div class="support-banner-cta">
                        <span>Donate</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <!-- Server Transfer Banner (shown when both default + custom bot are present) -->
            <div id="transferBanner" style="display:none; margin-bottom: 16px;">
                <div style="background: linear-gradient(135deg, color-mix(in srgb, var(--clx-violet, #7c3aed) 15%, transparent), color-mix(in srgb, var(--clx-red, #ef4444) 10%, transparent)); border: 1px solid color-mix(in srgb, var(--clx-violet, #7c3aed) 30%, transparent); border-radius: 12px; padding: 20px; position: relative; overflow: hidden;">
                    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                        <div style="flex-shrink: 0; width: 48px; height: 48px; background: color-mix(in srgb, var(--clx-violet, #7c3aed) 20%, transparent); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-exchange-alt" style="font-size: 1.2rem; color: var(--clx-violet, #a78bfa);"></i>
                        </div>
                        <div style="flex: 1; min-width: 200px;">
                            <div style="font-size: 1rem; font-weight: 700; color: var(--clx-ink, #fff);">Transfer Server to Custom Bot</div>
                            <div style="font-size: 0.8rem; color: var(--clx-ink-3, rgba(255,255,255,0.5)); margin-top: 2px;" id="transferDesc">Migrate all panels, embeds, and interactive content to your custom bot</div>
                        </div>
                        <div style="display: flex; gap: 8px; flex-shrink: 0;">
                            <button id="transferPreviewBtn" onclick="previewTransfer()" style="background: #7c3aed; color: #fff; border: none; border-radius: 8px; padding: 10px 20px; cursor: pointer; font-weight: 600; font-size: 0.85rem; transition: all 0.2s;">
                                <i class="fas fa-eye" style="margin-right: 6px;"></i>Preview
                            </button>
                        </div>
                    </div>
                    <div id="transferPreview" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent);">
                        <div id="transferCounts" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 8px; margin-bottom: 16px;"></div>
                        <div style="background: color-mix(in srgb, var(--clx-red, #ef4444) 10%, transparent); border: 1px solid color-mix(in srgb, var(--clx-red, #ef4444) 20%, transparent); border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; font-size: 0.8rem; color: var(--clx-red, #fca5a5);">
                            <i class="fas fa-exclamation-triangle" style="margin-right: 6px;"></i>
                            <strong>Warning:</strong> Active giveaway entries (reactions) cannot be transferred. The default bot will leave the server after transfer.
                        </div>
                        <div style="display: flex; gap: 8px; justify-content: flex-end;">
                            <button onclick="document.getElementById('transferPreview').style.display='none'" style="background: color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent); color: var(--clx-ink, #d1d5db); border: none; border-radius: 8px; padding: 8px 16px; cursor: pointer; font-size: 0.85rem;">Cancel</button>
                            <button id="transferStartBtn" onclick="confirmTransfer()" style="background: var(--clx-red, #ef4444); color: #fff; border: none; border-radius: 8px; padding: 8px 16px; cursor: pointer; font-weight: 600; font-size: 0.85rem;">
                                <i class="fas fa-rocket" style="margin-right: 6px;"></i>Start Transfer
                            </button>
                        </div>
                    </div>
                    <div id="transferProgress" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent);">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                            <div style="width: 16px; height: 16px; border: 2px solid color-mix(in srgb, var(--clx-violet, #a78bfa) 30%, transparent); border-top-color: var(--clx-violet, #a78bfa); border-radius: 50%; animation: xferspin 0.8s linear infinite;"></div>
                            <span id="transferStep" style="color: var(--clx-violet, #a78bfa); font-weight: 600; font-size: 0.85rem;">Starting...</span>
                        </div>
                        <div id="transferItemProgress" style="font-size: 0.8rem; color: var(--clx-ink-3, rgba(255,255,255,0.5));"></div>
                        <div id="transferErrors" style="display: none; margin-top: 8px; font-size: 0.8rem; color: var(--clx-red, #fca5a5);"></div>
                        <button onclick="abortXfer()" id="transferAbortBtn" style="margin-top: 12px; background: color-mix(in srgb, var(--clx-red, #ef4444) 20%, transparent); color: var(--clx-red, #f87171); border: 1px solid color-mix(in srgb, var(--clx-red, #ef4444) 30%, transparent); border-radius: 8px; padding: 6px 14px; cursor: pointer; font-size: 0.8rem;">Abort</button>
                    </div>
                    <div id="transferComplete" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent); text-align: center;">
                        <i class="fas fa-check-circle" style="font-size: 2rem; color: var(--clx-green, #22c55e); margin-bottom: 8px;"></i>
                        <div style="color: var(--clx-ink, #fff); font-weight: 700; font-size: 1rem;">Transfer Complete!</div>
                        <div id="transferSummary" style="color: var(--clx-ink-3, rgba(255,255,255,0.5)); font-size: 0.85rem; margin-top: 4px;"></div>
                    </div>
                </div>
            </div>
            <style>@keyframes xferspin { to { transform: rotate(360deg); } }</style>
            <script>
            (function() {
                var gid = '<%= guild.id %>';
                var cBotId = null;
                fetch('/api/guilds/' + gid + '/custom-bot/').then(function(r){return r.json()}).then(function(d){
                    if (d.hasCustomBot && d.bot && d.bot.bot_id && d.defaultBotPresent) {
                        // Custom bot is assigned — check which direction transfer goes
                        // The "current" bot serving this guild is the custom bot
                        // If default bot is also present, offer transfer TO custom (default→custom)
                        // OR transfer BACK to default (custom→default)
                        cBotId = d.bot.bot_id;
                        var banner = document.getElementById('transferBanner');
                        var desc = document.getElementById('transferDesc');
                        var previewBtn = document.getElementById('transferPreviewBtn');
                        banner.style.display = 'block';

                        // Check if the bot serving the guild is the custom bot (guild_bot_mapping exists)
                        // If so, the default bot is the "extra" one — offer reverse transfer
                        // We know mapping exists because hasCustomBot=true
                        // Add both directions as buttons
                        desc.textContent = 'Transfer content between CertiFried Utility and ' + (d.bot.bot_name || 'your custom bot');
                        previewBtn.style.display = 'none';

                        var btnContainer = previewBtn.parentElement;
                        var toCustomBtn = document.createElement('button');
                        toCustomBtn.style.cssText = 'background:#7c3aed;color:#fff;border:none;border-radius:8px;padding:10px 16px;cursor:pointer;font-weight:600;font-size:0.82rem;';
                        toCustomBtn.textContent = 'Transfer to ' + (d.bot.bot_name || 'Custom Bot');
                        toCustomBtn.onclick = function() { xferDirection = 'to-custom'; previewTransfer(); };
                        btnContainer.appendChild(toCustomBtn);

                        var toDefaultBtn = document.createElement('button');
                        toDefaultBtn.style.cssText = 'background:color-mix(in srgb, var(--clx-white, #ffffff) 10%, transparent);color:var(--clx-ink, #d1d5db);border:1px solid color-mix(in srgb, var(--clx-white, #ffffff) 15%, transparent);border-radius:8px;padding:10px 16px;cursor:pointer;font-weight:600;font-size:0.82rem;';
                        toDefaultBtn.textContent = 'Transfer to CertiFried Utility';
                        toDefaultBtn.onclick = function() { xferDirection = 'to-default'; previewTransfer(); };
                        btnContainer.appendChild(toDefaultBtn);
                    }
                }).catch(function(){});

                var xferDirection = 'to-custom'; // or 'to-default'

                window.previewTransfer = async function() {
                    if (!cBotId) return;
                    var body = xferDirection === 'to-default'
                        ? { toBotId: 'default', fromBotId: cBotId }
                        : { toBotId: cBotId };
                    try {
                        var r = await fetch('/api/guilds/'+gid+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
                        var d = await r.json();
                        if (!d.success) { alert(d.error||'Validation failed'); return; }
                        var c = d.counts, el = document.getElementById('transferCounts');
                        var labels = {reactionPanels:'Reaction Panels',ticketPanels:'Ticket Panels',customEmbeds:'Custom Embeds',activeGiveaways:'Giveaways',activePolls:'Polls',stickyMessages:'Sticky Messages',musicPanels:'Music Panels'};
                        while(el.firstChild) el.removeChild(el.firstChild);
                        for (var k in labels) {
                            if (c[k]>0) {
                                var div=document.createElement('div');
                                div.style.cssText='background:color-mix(in srgb, var(--clx-white, #ffffff) 5%, transparent);border:1px solid color-mix(in srgb, var(--clx-white, #ffffff) 8%, transparent);border-radius:8px;padding:8px 12px;text-align:center;';
                                var n=document.createElement('div');n.style.cssText='font-size:1.2rem;font-weight:700;color:var(--clx-violet, #a78bfa);';n.textContent=c[k];
                                var l=document.createElement('div');l.style.cssText='font-size:0.7rem;color:var(--clx-ink-3, rgba(255,255,255,0.4));';l.textContent=labels[k];
                                div.appendChild(n);div.appendChild(l);el.appendChild(div);
                            }
                        }
                        var tot=document.createElement('div');tot.style.cssText='background:color-mix(in srgb, var(--clx-white, #ffffff) 5%, transparent);border:1px solid color-mix(in srgb, var(--clx-white, #ffffff) 8%, transparent);border-radius:8px;padding:8px 12px;text-align:center;';
                        var tn=document.createElement('div');tn.style.cssText='font-size:1.2rem;font-weight:700;color:var(--clx-ink, #fff);';tn.textContent=c.total;
                        var tl=document.createElement('div');tl.style.cssText='font-size:0.7rem;color:var(--clx-ink-3, rgba(255,255,255,0.4));';tl.textContent='Total';
                        tot.appendChild(tn);tot.appendChild(tl);el.appendChild(tot);
                        document.getElementById('transferPreview').style.display='block';
                    } catch(e){alert(e.message)}
                };

                window.confirmTransfer = async function() {
                    var dirLabel = xferDirection === 'to-default' ? 'Transfer ALL content back to CertiFried Utility and remove the custom bot?' : 'Transfer ALL content to the custom bot and remove CertiFried Utility?';
                    if (!cBotId||!confirm(dirLabel + ' This cannot be undone.')) return;
                    document.getElementById('transferPreview').style.display='none';
                    document.getElementById('transferProgress').style.display='block';
                    try {
                        var body = xferDirection === 'to-default'
                            ? {toBotId:'default',fromBotId:cBotId,confirmed:true}
                            : {toBotId:cBotId,confirmed:true};
                        var r=await fetch('/api/guilds/'+gid+'/transfer',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
                        var d=await r.json();
                        if(!d.success){alert(d.error);return;}
                        pollXfer();
                    }catch(e){alert(e.message)}
                };

                function pollXfer() {
                    var iv=setInterval(async function(){
                        try{
                            var r=await fetch('/api/guilds/'+gid+'/transfer/status');
                            var d=await r.json();
                            var p=d.active?d:{};
                            if(!d.active&&d.transfer&&d.transfer.progress){try{p=typeof d.transfer.progress==='string'?JSON.parse(d.transfer.progress):d.transfer.progress;}catch(e){p={};}}
                            var step=p.step||(d.transfer?d.transfer.status:null)||'starting...';
                            document.getElementById('transferStep').textContent=step;
                            var items=p.items||{};
                            var prog=document.getElementById('transferItemProgress');
                            while(prog.firstChild)prog.removeChild(prog.firstChild);
                            for(var k in items){
                                var row=document.createElement('div');
                                row.textContent=k+': '+(items[k].done||0)+'/'+(items[k].total||0)+(items[k].errors>0?' ('+items[k].errors+' errors)':'');
                                prog.appendChild(row);
                            }
                            var errs=p.errors||[];
                            if(errs.length>0){
                                var errEl=document.getElementById('transferErrors');
                                errEl.style.display='block';
                                while(errEl.firstChild)errEl.removeChild(errEl.firstChild);
                                errs.forEach(function(e){var div=document.createElement('div');div.textContent='⚠ '+e;errEl.appendChild(div);});
                            }
                            if(step==='completed'||step==='failed'||step==='aborted'){
                                clearInterval(iv);
                                document.getElementById('transferProgress').style.display='none';
                                if(step==='completed'){
                                    document.getElementById('transferComplete').style.display='block';
                                    document.getElementById('transferSummary').textContent='All content migrated. Default bot has left the server.';
                                }else{
                                    document.getElementById('transferStep').textContent=step==='failed'?'Failed: '+(p.error||'Unknown'):' Aborted';
                                    document.getElementById('transferProgress').style.display='block';
                                    document.getElementById('transferAbortBtn').style.display='none';
                                }
                            }
                        }catch(e){}
                    },2000);
                }

                window.abortXfer = async function(){
                    if(!confirm('Abort? Already-transferred content stays with the new bot.'))return;
                    fetch('/api/guilds/'+gid+'/transfer/abort',{method:'POST'});
                };
            })();
            </script>

