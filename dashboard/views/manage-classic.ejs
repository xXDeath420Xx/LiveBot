                            </div>
                        </div>
                    </a>
                    <a href="/manage/<%= guild.id %>?page=takeover" class="module-card purple" data-tags="takeover migrate replace scan audit bots retire remove mee6 carl dyno parity">
                        <div class="module-header">
                            <div class="module-icon"><i class="fas fa-crosshairs"></i></div>
                            <div>
                                <div class="module-title">Analyze &amp; Take Over</div>
                                <div class="module-desc">Scan the server, replace other bots, retire them</div>
                            </div>
                        </div>
                    </a>
                    <a href="/manage/<%= guild.id %>?page=appearance" class="module-card purple" data-tags="nickname avatar color embed custom bot instance token branding">
                        <div class="module-header">
                            <div class="module-icon"><i class="fas fa-paint-brush"></i></div>
                            <div>
                                <div class="module-title">Appearance</div>
                                <div class="module-desc">Bot identity, embed colors, custom bot instance</div>
                            </div>
                        </div>
                    </a>
                    <a href="/manage/<%= guild.id %>?page=catalog" class="module-card purple" data-tags="catalog features browse discover everything all what can this bot do">
                        <div class="module-header">
                            <div class="module-icon"><i class="fas fa-compass"></i></div>
