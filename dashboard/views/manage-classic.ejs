        /* Badge styles */
        .badge { font-weight: 500; padding: 0.375rem 0.625rem; border-radius: 6px; font-size: 0.75rem; }
        .badge.bg-primary { background: color-mix(in srgb, var(--clx-violet, #a78bfa) 20%, transparent) !important; color: var(--accent-purple); }
        .badge.bg-success { background: color-mix(in srgb, var(--clx-green, #23f56b) 20%, transparent) !important; color: var(--accent-green); }
        .badge.bg-warning { background: color-mix(in srgb, var(--clx-yellow, #fbbf24) 20%, transparent) !important; color: var(--accent-yellow); }
        .badge.bg-danger { background: color-mix(in srgb, var(--clx-red, #f87171) 20%, transparent) !important; color: var(--accent-red); }
        .badge.bg-secondary { background: var(--bg-card) !important; color: var(--text-secondary); }

