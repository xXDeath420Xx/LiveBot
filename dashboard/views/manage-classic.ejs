            <%
            // Generated feature cards, grouped into the same sections as the hand-written ones.
            // A card whose category is not a real section heading falls through to "More
            // Features" at the very bottom, which makes a mistyped category visible instead of
            // silently dropping the card.
            const genByCategory = {};
            const genUncategorised = [];
            if (typeof featureConfigSpecs !== 'undefined') {
                const KNOWN = ['Core','Streaming & Content','Community','Economy & Games',
                               'Moderation & Security','Analytics & Logging',
                               'Automation & Scheduling','Server Tools'];
                Object.entries(featureConfigSpecs).forEach(function(entry) {
                    const spec = entry[1];
                    if (spec.category && KNOWN.indexOf(spec.category) !== -1) {
                        (genByCategory[spec.category] = genByCategory[spec.category] || []).push(entry);
                    } else {
                        genUncategorised.push(entry);
                    }
                });
                Object.keys(genByCategory).forEach(function(k) {
                    genByCategory[k].sort(function(a, b) { return a[1].label.localeCompare(b[1].label); });
                });
                genUncategorised.sort(function(a, b) { return a[1].label.localeCompare(b[1].label); });
            }
            // Pages added since this layout was designed (core/manage-nav.js lists every page)
            // that no card above covers: filed under the closest original category, styled
            // exactly like the generated cards, so nothing is unreachable from the overview.
            const CLASSIC_HAND_PAGES = new Set(["achievements", "action-log", "activity-audit", "advanced-protection", "ai-moderation", "analytics", "announce", "appearance", "auto-purge", "automemes", "automod", "autoresponders", "avatar-protection", "backups", "birthday", "bulk-roles", "catalog", "channel-access", "command-center", "commands", "commission-filter", "community-support", "confessions", "core", "counting", "csv", "custom-commands", "custom-embeds", "domain-reports", "economy", "emoji-manager", "emojistats", "event-schedule", "feeds", "forms", "free-games", "gambling", "game-news", "games", "giveaways", "global-ban", "initialize", "join-requests", "kofi", "language", "leveling", "link-filter", "logging", "mass", "message-threats", "minigames", "moderation", "music", "name-filters", "nsfw-protection", "owo", "permissions", "phishing", "polls", "protection-settings", "quarantine", "reaction-roles", "rejoin", "reminders", "role-manager", "rpg", "schedule", "security", "self-promo", "serverstats", "smart-purge", "soundboard", "starboard", "stat-displays", "stat-roles", "steam-library", "digimon", "digimon-odds", "digimon-quiz", "sticky", "streamers", "suggestions", "tags", "takeover", "theme", "throne", "tickets", "tiktok", "timecapsules", "todo", "trading", "twitch-clips", "twitch-schedules", "utilities", "verification", "weather", "welcome"]);
            const CLASSIC_SECTION_CATEGORY = {
                setup: 'Core', protection: 'Moderation & Security', moderation: 'Moderation & Security',
                joining: 'Community', roles: 'Server Tools', engagement: 'Community', events: 'Community',
                games: 'Economy & Games', economy: 'Economy & Games', gamenews: 'Economy & Games',
                streams: 'Streaming & Content', creators: 'Streaming & Content', media: 'Community',
                replies: 'Server Tools', automation: 'Automation & Scheduling', logging: 'Analytics & Logging',
                support: 'Server Tools',
            };
            const CLASSIC_CATEGORY_COLOUR = {
                'Core': 'purple', 'Streaming & Content': 'indigo', 'Community': 'cyan', 'Economy & Games': 'yellow',
                'Moderation & Security': 'red', 'Analytics & Logging': 'blue', 'Automation & Scheduling': 'orange', 'Server Tools': 'teal',
            };
            const classicGenerated = new Set(typeof featureConfigSpecs !== 'undefined' ? Object.keys(featureConfigSpecs) : []);
            (Array.isArray(locals.manageNav) ? manageNav : []).forEach(function (section) {
                (section.items || []).forEach(function (it) {
                    if (!it || !it.page || CLASSIC_HAND_PAGES.has(it.page) || classicGenerated.has(it.page)) return;
                    const cat = CLASSIC_SECTION_CATEGORY[section.key] || 'Server Tools';
                    classicGenerated.add(it.page);
                    (genByCategory[cat] = genByCategory[cat] || []).push([it.page, {
                        label: it.title || it.page, blurb: it.desc || '', icon: '', iconPack: it.icon || 'fas fa-puzzle-piece',
                        colour: CLASSIC_CATEGORY_COLOUR[cat], commands: it.tags ? [String(it.tags)] : [],  // commands feed the search tags
                    }]);
                });
            });
            const genCount = function(cat) { return (genByCategory[cat] || []).length; };
            %>

