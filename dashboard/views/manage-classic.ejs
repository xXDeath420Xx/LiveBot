<style id="classic-fixes">
    /* Classic: the move/hide arrows only show while arranging (the old page showed them always). */
    .cf-manage:not([data-arranging="1"]) .section-controls,
    #main-content:not([data-arranging="1"]) .section-controls { display: none !important; }
    .section-controls .section-ctl { background: color-mix(in srgb, var(--clx-violet, #8b5cf6) 15%, transparent); border: 1px solid color-mix(in srgb, var(--clx-violet, #8b5cf6) 35%, transparent); color: var(--clx-violet, #c4b5fd);
        border-radius: 6px; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; margin-right: 4px; }
    .arrange-btn { background: color-mix(in srgb, var(--clx-white, #ffffff) 4%, transparent); border: 1px solid color-mix(in srgb, var(--clx-white, #ffffff) 12%, transparent); color: inherit; border-radius: 8px;
        padding: 6px 12px; font-size: .85rem; display: inline-flex; gap: 6px; align-items: center; margin: 8px 0; cursor: pointer; }
    .arrange-btn[aria-pressed="true"] { background: color-mix(in srgb, var(--clx-violet, #8b5cf6) 25%, transparent); border-color: color-mix(in srgb, var(--clx-violet, #8b5cf6) 60%, transparent); }

    /* Readability (wave 17). The category tabs and the layout buttons were --text-muted at 0.78rem
       with half-opacity counts: nearly invisible on the dark themes. */
    .category-tab { color: var(--text-secondary); font-size: 0.8125rem; }
    .category-tab .tab-count { opacity: 0.8; font-size: 0.68rem; }
    .category-tab:hover { color: var(--text-primary); background: var(--bg-card-hover); }
    .layout-toggle button { color: var(--text-secondary); }
    .layout-toggle button:hover { color: var(--text-primary); }
    .arrange-btn { color: var(--text-primary); border-color: var(--border-strong, rgba(255,255,255,.16)); }
    /* Filled buttons on the named dark themes: their accents are pale (mint, sky, lilac...), so
       white text on them read at under 2:1. Dark text reads at 8:1 or better on every one. */
    :root:is([data-theme="slate"], [data-theme="midnight"], [data-theme="ocean"], [data-theme="forest"], [data-theme="plum"], [data-theme="ember"], [data-theme="amoled"], [data-theme="contrast"]) .page-content .btn-primary,
    :root:is([data-theme="slate"], [data-theme="midnight"], [data-theme="ocean"], [data-theme="forest"], [data-theme="plum"], [data-theme="ember"], [data-theme="amoled"], [data-theme="contrast"]) .page-content .btn-primary * { color: #0b0f11 !important; }
    .page-content .btn-warning, .page-content .btn-warning * { color: #1a1300 !important; }
    /* Light and Sand: the header bar, the style switch and the search box were drawn for dark only. */
    :root[data-theme="light"] .navbar, :root[data-theme="sand"] .navbar { background: color-mix(in srgb, var(--bg-secondary) 92%, transparent) !important; }
    :root[data-theme="light"] .style-switch select, :root[data-theme="sand"] .style-switch select { color: var(--text-primary) !important; background-color: var(--bg-secondary) !important; }
    :root[data-theme="light"] .overview-search input, :root[data-theme="sand"] .overview-search input { color: var(--text-primary); background: var(--bg-secondary); border-color: rgba(15, 18, 22, 0.14); }
    :root[data-theme="light"] .category-tabs, :root[data-theme="sand"] .category-tabs { background: rgba(15, 18, 22, 0.03); border-color: rgba(15, 18, 22, 0.08); }
    :root[data-theme="light"] .arrange-btn, :root[data-theme="sand"] .arrange-btn { background: var(--bg-secondary); border-color: rgba(15, 18, 22, 0.16); }

    /* Server switcher in the header, settings search results and the ?field= highlight. */
    .server-actions .cf-switcher--header { min-width: 240px; max-width: 340px; }
    .cf-switcher--header .cf-switcher-btn { padding: 0.5rem 0.75rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; }
    .cf-switcher--header .cf-switcher-btn:hover, .cf-switcher--header .cf-switcher-btn[aria-expanded="true"] { border-color: var(--accent-purple); }
    @media (max-width: 768px) { .server-actions .cf-switcher--header { width: 100%; max-width: none; } }
    .cf-field-results { margin: 0 0 1.25rem; padding: 0.5rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; }
    .cf-field-results[hidden] { display: none; }
    .cf-field-results-head { padding: 0.25rem 0.5rem 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
    .cf-field-results-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 2px 0.5rem; }
    .cf-field-hit { display: flex; align-items: center; gap: 0.75rem; min-height: 42px; padding: 6px 0.5rem; border-radius: 10px; color: var(--text-primary); text-decoration: none; }
    .cf-field-hit:hover, .cf-field-hit:focus-visible { background: var(--bg-card-hover); color: var(--text-primary); }
    .cf-field-hit > i { width: 16px; text-align: center; font-size: 0.8rem; color: var(--accent-purple); }
    .cf-field-hit-text { display: flex; flex-direction: column; min-width: 0; }
    .cf-field-hit-label { font-size: 0.875rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cf-field-hit-page { font-size: 0.75rem; color: var(--text-muted); }
    @keyframes cf-field-flash { 0%, 60% { box-shadow: 0 0 0 2px var(--accent-purple), 0 0 0 8px color-mix(in srgb, var(--clx-violet, #8b5cf6) 18%, transparent); } 100% { box-shadow: 0 0 0 0 transparent; } }
    .cf-field-flash { border-radius: 10px; animation: cf-field-flash 2.6s ease both; }
    @media (prefers-reduced-motion: reduce) { .cf-field-flash { animation: none; box-shadow: 0 0 0 2px var(--accent-purple); } }
</style>
