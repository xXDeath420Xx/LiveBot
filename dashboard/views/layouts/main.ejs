<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'Dashboard' %> - CertiFried Utility</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/output.css">

    <!-- Legacy CSS (for gradual migration) -->
    <link rel="stylesheet" href="/css/styles.css">

    <!-- Socket.io -->
    <script src="/socket.io/socket.io.js"></script>

    <% if (locals.headScripts) { %>
        <%- locals.headScripts %>
    <% } %>
</head>
<body class="bg-dark-700 text-white min-h-screen">
    <% if (locals.showTopbar !== false) { %>
    <!-- Top Navigation Bar -->
    <header class="fixed top-0 left-0 right-0 h-16 bg-dark-800 border-b border-dark-400 z-50">
        <div class="h-full px-4 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-3">
                <img src="/images/logo.png" alt="CertiFried Utility" class="h-8 w-8" onerror="this.style.display='none'">
                <span class="font-bold text-lg hidden sm:block">CertiFried Utility</span>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-6">
                <a href="/dashboard" class="text-gray-400 hover:text-white transition-colors">Dashboard</a>
                <a href="https://docs.certifriedmultitool.com" target="_blank" class="text-gray-400 hover:text-white transition-colors">Docs</a>
                <a href="https://discord.com/invite/mJfbDgWA7z" target="_blank" class="text-gray-400 hover:text-white transition-colors">Support</a>
            </nav>

            <!-- User Menu -->
            <div class="flex items-center gap-4">
                <% if (locals.user) { %>
                    <% if (locals.user.isSuperAdmin) { %>
                    <a href="/super-admin" class="text-accent-yellow hover:text-accent-yellow/80 transition-colors" title="Super Admin">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                        </svg>
                    </a>
                    <% } %>

                    <% if (locals.user.canCreateBots) { %>
                    <a href="/bot-management" class="text-primary-400 hover:text-primary-300 transition-colors" title="Bot Management">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </a>
                    <% } %>

                    <div class="dropdown relative" data-dropdown>
                        <button data-dropdown-trigger class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-dark-600 transition-colors">
                            <img
                                src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.webp?size=32"
                                alt="<%= user.username %>"
                                class="w-8 h-8 rounded-full"
                                onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'"
                            >
                            <span class="hidden sm:block text-sm font-medium"><%= user.username %></span>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>

                        <div data-dropdown-menu class="dropdown-menu hidden">
                            <a href="/profile" class="dropdown-item">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                Profile
                            </a>
                            <a href="/servers" class="dropdown-item">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                </svg>
                                My Servers
                            </a>
                            <% if (user.isSuperAdmin) { %>
                            <hr class="my-1 border-dark-400">
                            <a href="/super-admin" class="dropdown-item text-amber-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                                Super Admin
                            </a>
                            <a href="/bot-management" class="dropdown-item text-amber-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                Bot Management
                            </a>
                            <% } %>
                            <hr class="my-1 border-dark-400">
                            <a href="/logout" class="dropdown-item text-accent-red">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                </svg>
                                Logout
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="btn btn-primary">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                        </svg>
                        Login with Discord
                    </a>
                <% } %>
            </div>
        </div>
    </header>
    <% } %>

    <!-- Main Content -->
    <main class="<%= locals.showTopbar !== false ? 'pt-16' : '' %>">
        <%- body %>
    </main>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2"></div>

    <!-- Scripts -->
    <script src="/js/components/toast.js"></script>
    <script src="/js/components/forms.js"></script>
    <script src="/js/components/botSwitcher.js"></script>
    <script src="/js/socket.js"></script>
    <script src="/js/app.js"></script>

    <% if (locals.scripts) { %>
        <%- locals.scripts %>
    <% } %>
</body>
</html>
