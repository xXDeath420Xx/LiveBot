<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('partials/site-head', { title: 'Report a user · CertiFried', description: 'Report a Discord account for CertiFried\'s shared global ban list. Moderators from the servers that use the list review each report.', path: '/report', noindex: true }) %>
    <script src="/js/csrf.js"></script>
    <style>
        /* Shared by /appeal and /report: a narrow form page on the site frame. */
        .gb-panel { padding: var(--cf-5); margin-bottom: var(--cf-4); background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); }
        .gb-panel > h2 { margin: 0 0 var(--cf-2); font-size: var(--cf-text-lg); font-weight: 600; color: var(--cf-text); }
        .gb-panel > p { margin: 0 0 var(--cf-3); font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); }
        .gb-panel > p:last-child { margin-bottom: 0; }
        .gb-state { display: flex; align-items: center; gap: var(--cf-2); margin-bottom: var(--cf-2); }
        .gb-state h2 { margin: 0; font-size: var(--cf-text-lg); font-weight: 600; }
        .gb-field { margin-bottom: var(--cf-4); }
        .gb-field .form-label { display: block; margin-bottom: 6px; }
        .gb-field .form-input, .gb-field .form-select, .gb-field .form-textarea { width: 100%; min-height: 40px; }
        .gb-field .form-textarea { min-height: 140px; resize: vertical; }
        .gb-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--cf-3); }
        @media (max-width: 520px) { .gb-row { grid-template-columns: minmax(0, 1fr); } }
        .gb-hint { margin: 6px 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .gb-count { margin: 4px 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); text-align: right; font-variant-numeric: tabular-nums; }
        .gb-count.is-short { color: var(--cf-warning); }
        .gb-req { color: var(--cf-text-3); font-weight: 400; }
        .gb-alert { margin-bottom: var(--cf-4); padding: var(--cf-3) var(--cf-4); font-size: var(--cf-text-sm); border-radius: var(--cf-radius-lg); border: 1px solid var(--cf-border); background: var(--cf-surface); }
        .gb-alert[hidden] { display: none; }
        .gb-alert.is-ok { color: var(--cf-success); border-color: color-mix(in srgb, var(--cf-success) 40%, var(--cf-border)); }
        .gb-alert.is-bad { color: var(--cf-danger); border-color: color-mix(in srgb, var(--cf-danger) 40%, var(--cf-border)); }
        .gb-details { margin: var(--cf-3) 0 0; padding: 0; }
        .gb-details > div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: var(--cf-3); padding: var(--cf-2) 0; border-top: 1px solid var(--cf-border); }
        .gb-details dt { font-size: var(--cf-text-sm); color: var(--cf-text-3); }
        .gb-details dd { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text); overflow-wrap: anywhere; white-space: pre-wrap; }
        @media (max-width: 520px) { .gb-details > div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
        .gb-response { margin-top: var(--cf-3); padding: var(--cf-3) var(--cf-4); background: var(--cf-inset); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); }
        .gb-response h3 { margin: 0 0 4px; font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
        .gb-response p { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); white-space: pre-wrap; overflow-wrap: anywhere; }
        .gb-loading { padding: var(--cf-8) 0; text-align: center; color: var(--cf-text-3); }
    </style>
</head>
<body class="cfs-body">
<%- include('partials/site-header', { active: '', user: locals.user || null, returnTo: '/report' }) %>
    <main id="main-content" tabindex="-1" class="cfs-main cfs-main--narrow">
        <div class="cfs-pagehead">
            <h1>Report a user</h1>
            <p class="cfs-lede">Report a Discord account for the global ban list that CertiFried servers share: scammers, raiders, spam bots and similar.</p>
        </div>

        <% if (!user) { %>
        <section class="gb-panel" aria-labelledby="gb-login-h">
            <h2 id="gb-login-h">Log in to report</h2>
            <p>Reports need a Discord login, so we know who sent each one and can stop abuse.</p>
            <a href="/auth/discord?returnTo=/report" class="btn btn-primary">Log in with Discord</a>
        </section>
        <% } else { %>
        <div id="alertBox" class="gb-alert" role="alert" hidden></div>

        <section id="formState" class="gb-panel" aria-labelledby="gb-form-h">
            <h2 id="gb-form-h">Send a report</h2>
            <form id="reportForm" novalidate>
                <div class="gb-field">
                    <label class="form-label" for="targetUserId">Discord user ID <span class="gb-req">(required)</span></label>
                    <input class="form-input" id="targetUserId" name="target_user_id" type="text" inputmode="numeric" autocomplete="off" pattern="\d{17,20}" required aria-describedby="targetHint">
                    <p class="gb-hint" id="targetHint">In Discord, turn on Developer Mode (Settings, Advanced), then right-click the user and choose Copy User ID. It is 17 to 20 digits.</p>
                </div>
                <div class="gb-row">
                    <div class="gb-field">
                        <label class="form-label" for="category">Category</label>
                        <select class="form-select" id="category" name="category">
                            <option value="scam">Scam</option>
                            <option value="phishing">Phishing</option>
                            <option value="spam">Spam</option>
                            <option value="raid">Raid</option>
                            <option value="harassment">Harassment</option>
                            <option value="selfbot">Self-bot</option>
                            <option value="mass_dm">Mass DMs</option>
                            <option value="impersonation">Impersonation</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="gb-field">
                        <label class="form-label" for="severity">Severity</label>
                        <select class="form-select" id="severity" name="severity">
                            <option value="low">Low</option>
                            <option value="medium" selected>Medium</option>
                            <option value="high">High</option>
                            <option value="critical">Critical</option>
                        </select>
                    </div>
                </div>
                <div class="gb-field">
                    <label class="form-label" for="reason">What happened <span class="gb-req">(required, 20 to 2,000 characters)</span></label>
                    <textarea class="form-textarea" id="reason" name="reason" minlength="20" maxlength="2000" required aria-describedby="reasonCount"></textarea>
                    <p class="gb-count" id="reasonCount">0 / 2000</p>
                </div>
                <div class="gb-field">
                    <label class="form-label" for="evidence">Evidence <span class="gb-req">(optional)</span></label>
                    <input class="form-input" id="evidence" name="evidence" type="text" maxlength="1000" aria-describedby="evidenceHint">
                    <p class="gb-hint" id="evidenceHint">Links to screenshots or messages that show what happened.</p>
                </div>
                <button type="submit" class="btn btn-primary" id="submitBtn">Send report</button>
            </form>
        </section>

        <section id="submittedState" class="gb-panel" hidden aria-labelledby="gb-done-h">
            <div class="gb-state"><span class="cfs-dot cfs-dot--ok" aria-hidden="true"></span><h2 id="gb-done-h">Report <span id="reportIdDisplay"></span> sent</h2></div>
            <p>Moderators will review it. You cannot report the same account again while this report is open.</p>
            <button type="button" class="btn btn-secondary" id="againBtn">Report someone else</button>
        </section>
        <% } %>

        <section class="gb-panel" aria-labelledby="gb-how-h">
            <h2 id="gb-how-h">What happens next</h2>
            <p>Moderators from the servers that use the global ban list vote on each report. Once enough of them approve it, from at least two different servers, the account is added to the list, and each of those servers acts on it as its own settings say (ban, kick or alert).</p>
            <p>If you are on the list and think it is a mistake, you can <a href="/appeal">appeal</a>.</p>
        </section>
    </main>

<%- include('partials/site-footer') %>
<% if (user) { %>
<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    var alertBox = $('alertBox');
    function showAlert(message, ok) {
        alertBox.textContent = message;
        alertBox.className = 'gb-alert ' + (ok ? 'is-ok' : 'is-bad');
        alertBox.hidden = false;
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    function hideAlert() { alertBox.hidden = true; }

    var reason = $('reason'), count = $('reasonCount');
    reason.addEventListener('input', function () {
        var n = reason.value.length;
        count.textContent = n + ' / 2000';
        count.className = 'gb-count' + (n > 0 && n < 20 ? ' is-short' : '');
    });

    $('reportForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        hideAlert();
        var target = $('targetUserId').value.trim();
        var text = reason.value.trim();
        if (!/^\d{17,20}$/.test(target)) { showAlert('Enter a Discord user ID: 17 to 20 digits.', false); $('targetUserId').focus(); return; }
        if (text.length < 20) { showAlert('Describe what happened in at least 20 characters.', false); reason.focus(); return; }
        var btn = $('submitBtn');
        btn.disabled = true; btn.textContent = 'Sending…';
        try {
            var res = await fetch('/api/report', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ target_user_id: target, category: $('category').value, severity: $('severity').value, reason: text, evidence: $('evidence').value.trim() || null })
            });
            var data = await res.json();
            if (data.success) {
                $('formState').hidden = true;
                $('reportIdDisplay').textContent = '#' + data.reportId;
                $('submittedState').hidden = false;
                $('againBtn').focus();
            } else {
                showAlert(data.message || 'Could not send the report.', false);
            }
        } catch (err) {
            showAlert('Could not reach the server. Try again in a minute.', false);
        }
        btn.disabled = false; btn.textContent = 'Send report';
    });

    $('againBtn').addEventListener('click', function () {
        $('reportForm').reset();
        count.textContent = '0 / 2000'; count.className = 'gb-count';
        $('submittedState').hidden = true;
        $('formState').hidden = false;
        hideAlert();
        $('targetUserId').focus();
    });
})();
</script>
<% } %>
</body>
</html>
