<%#
  The docs search box (/docs, /docs/guides, /docs/search). A plain GET form to /docs/search, so it works
  without JavaScript; with it, /js/cf-docs-search.js loads the index (/docs/search.json) on first use and
  lists matches under the box as you type. Keyboard: "/" focuses the box, Up/Down move through the list,
  Enter opens the highlighted result (or the full results page), Escape closes the list.
  Locals: q (optional, the current query), autofocus (optional).
%>
<% const _dsq = typeof q === 'string' ? q : ''; %>
<form class="cf-dsearch" action="/docs/search" method="get" role="search" aria-label="Search the documentation" data-docs-search>
    <label class="cf-dsearch-label" for="cfDocsQ">Search guides, docs and commands</label>
    <div class="cf-dsearch-row">
        <svg class="cf-dsearch-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <input class="cf-dsearch-input" id="cfDocsQ" type="search" name="q" value="<%= _dsq %>" maxlength="120" autocomplete="off" spellcheck="false"
            placeholder="Search, for example: welcome card, anti-nuke, /level rank" aria-describedby="cfDocsHint"<% if (locals.autofocus) { %> autofocus<% } %>>
        <kbd class="cf-dsearch-kbd" aria-hidden="true">/</kbd>
        <button class="cf-dsearch-go" type="submit">Search</button>
    </div>
    <p class="cf-dsearch-hint" id="cfDocsHint">Press / to search from anywhere on this page. Use the arrow keys to move through the results.</p>
    <div class="cf-dsearch-pop" hidden>
        <ul class="cf-dsearch-list" id="cfDocsList" role="listbox" aria-label="Search results"></ul>
        <p class="cf-dsearch-status" role="status" aria-live="polite"></p>
    </div>
</form>
<style>
    .cf-dsearch { position: relative; margin: 0 0 var(--cf-6, 24px); max-width: 720px; }
    .cf-dsearch-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cf-dsearch-hint { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cf-dsearch-row { display: flex; align-items: center; gap: var(--cf-2, 8px); padding: 0 6px 0 12px; min-height: 44px;
        background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius, 8px); }
    .cf-dsearch-row:focus-within { border-color: var(--cf-accent); box-shadow: 0 0 0 3px var(--cf-accent-soft, transparent); }
    .cf-dsearch-icon { flex: none; color: var(--cf-text-3); }
    .cf-dsearch-input { flex: 1; min-width: 0; height: 40px; padding: 0; font: inherit; font-size: var(--cf-text-md, 15px); color: var(--cf-text);
        background: transparent; border: 0; outline: 0; }
    .cf-dsearch .cf-dsearch-input, .cf-dsearch .cf-dsearch-input:focus { border: 0; outline: none; box-shadow: none; background: transparent; min-height: 0; }
    /* The row draws the focus ring (:focus-within above), so the input does not draw a second one inside it. */
    .cf-dsearch .cf-dsearch-input:focus-visible { outline: none !important; }
    .cf-dsearch-input::placeholder { color: var(--cf-text-3); }
    .cf-dsearch-input::-webkit-search-cancel-button { cursor: pointer; }
    .cf-dsearch-kbd { padding: 1px 7px; font: 500 12px var(--cf-mono, monospace); color: var(--cf-text-3); border: 1px solid var(--cf-border-strong); border-radius: 4px; }
    .cf-dsearch-go { height: 32px; padding: 0 12px; font: inherit; font-size: var(--cf-text-sm, 14px); font-weight: 500; color: var(--cf-text);
        background: var(--cf-surface-2); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-sm, 6px); cursor: pointer; }
    .cf-dsearch-go:hover { background: var(--cf-surface-3, var(--cf-surface-2)); }
    .cf-dsearch-go:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 2px; }
    .cf-dsearch.is-live .cf-dsearch-go { display: none; }
    .cf-dsearch-pop { position: absolute; z-index: 30; left: 0; right: 0; top: calc(100% + 6px); max-height: min(70vh, 520px); overflow: auto;
        background: var(--cf-surface); border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-lg, 12px); box-shadow: 0 12px 32px rgba(0, 0, 0, .28); }
    .cf-dsearch-pop[hidden] { display: none; }
    .cf-dsearch-list { list-style: none; margin: 0; padding: 6px; }
    .cf-dsearch-list li { margin: 0; }
    .cf-dsearch-opt { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; padding: 8px 10px; border-radius: var(--cf-radius, 8px); color: inherit; text-decoration: none; }
    .cf-dsearch-opt[aria-selected="true"], .cf-dsearch-opt:hover { background: var(--cf-surface-2); }
    .cf-dsearch-opt[aria-selected="true"] { outline: 1px solid var(--cf-accent-line, var(--cf-border-strong)); }
    .cf-dsearch-kind { grid-row: span 2; align-self: start; margin-top: 2px; padding: 1px 6px; font-size: 11px; font-weight: 600; letter-spacing: .02em;
        color: var(--cf-text-2); border: 1px solid var(--cf-border); border-radius: 4px; white-space: nowrap; }
    .cf-dsearch-t { font-size: var(--cf-text-sm, 14px); font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
    .cf-dsearch-s { font-size: var(--cf-text-xs, 13px); color: var(--cf-text-3); line-height: 1.45; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .cf-dsearch-all .cf-dsearch-opt { display: block; font-size: var(--cf-text-sm, 14px); color: var(--cf-accent-fg, var(--cf-text)); }
    .cf-dsearch-status { margin: 0; padding: 0 16px 10px; font-size: var(--cf-text-xs, 13px); color: var(--cf-text-3); }
    .cf-dsearch-status:empty { display: none; }
    @media (max-width: 600px) { .cf-dsearch-kbd { display: none; } }
</style>
<script type="module" src="/js/cf-docs-search.js"></script>
