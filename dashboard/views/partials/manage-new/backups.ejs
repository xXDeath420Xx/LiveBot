<%# Server Backups - Tailwind Version %>

<div class="space-y-6">
    <!-- Stats -->
    <% if (locals.backups && backups.length > 0) { %>
        <div class="grid grid-cols-3 gap-4">
            <%- include('../../components/cards/statCard', {
                title: 'Total Backups',
                value: backups.length,
                icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>',
                color: 'primary'
            }) %>
            <% const latest = backups.sort((a, b) => new Date(b.created_at) - new Date(a.created_at))[0]; %>
            <%- include('../../components/cards/statCard', {
                title: 'Latest Backup',
                value: new Date(latest.created_at).toLocaleDateString(),
                icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
                color: 'info'
            }) %>
            <%- include('../../components/cards/statCard', {
                title: 'Status',
                value: 'Protected',
                icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>',
                color: 'success'
            }) %>
        </div>
    <% } %>

    <!-- Create Backup -->
    <div class="card">
        <div class="flex items-center gap-3 mb-6">
            <div class="p-3 bg-gradient-to-br from-primary-500 to-primary-600 rounded-lg">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">Create New Backup</h3>
                <p class="text-sm text-gray-400">Create a snapshot of your server's current configuration</p>
            </div>
        </div>

        <form id="create-backup-form">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end mb-4">
                <div class="form-group md:col-span-2">
                    <label class="form-label">Snapshot Name</label>
                    <input type="text" name="snapshot_name" class="form-input w-full" required placeholder="e.g., Pre-raid setup, Before event, Initial config">
                    <p class="form-hint">Choose a descriptive name to easily identify this backup later</p>
                </div>
                <button type="submit" class="btn btn-primary w-full">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                    </svg>
                    Create Backup
                </button>
            </div>

            <div class="p-3 bg-gradient-to-r from-primary-500/10 to-primary-500/5 border border-primary-500/30 rounded-lg">
                <div class="flex gap-3">
                    <svg class="w-5 h-5 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-sm text-gray-300">Backups include: roles, channels, categories, permissions, and basic settings. Messages and user data are not included.</p>
                </div>
            </div>
        </form>
    </div>

    <!-- Backups List -->
    <% if (locals.backups && backups.length > 0) { %>
        <div class="card">
            <h3 class="text-lg font-semibold text-white mb-4">Existing Backups</h3>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-dark-400">
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Snapshot</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Created</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Age</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-dark-400">
                        <% backups.sort((a, b) => new Date(b.created_at) - new Date(a.created_at)).forEach(backup => {
                            const createdDate = new Date(backup.created_at);
                            const now = new Date();
                            const diffDays = Math.floor((now - createdDate) / (1000 * 60 * 60 * 24));
                            const ageText = diffDays === 0 ? 'Today' : diffDays === 1 ? '1 day ago' : `${diffDays} days ago`;
                        %>
                            <tr class="hover:bg-dark-600 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-dark-700 border-2 border-primary-500 rounded-lg flex items-center justify-center">
                                            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="font-semibold text-white"><%= backup.snapshot_name %></div>
                                            <div class="text-xs text-gray-500">ID: <%= backup.id %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="text-sm text-gray-400"><%= createdDate.toLocaleDateString() %></div>
                                    <div class="text-xs text-gray-500"><%= createdDate.toLocaleTimeString() %></div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-dark-400 text-gray-300"><%= ageText %></span>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button onclick="restoreBackup('<%= backup.id %>')" class="btn btn-secondary btn-sm">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                            </svg>
                                            Restore
                                        </button>
                                        <button onclick="deleteBackup('<%= backup.id %>')" class="btn btn-danger btn-sm">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Warning Banner -->
        <div class="p-4 bg-gradient-to-r from-accent-red/10 to-accent-red/5 border border-accent-red/30 rounded-lg">
            <div class="flex gap-3">
                <svg class="w-5 h-5 text-accent-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <div class="font-semibold text-white mb-1">Important: Restore with Caution</div>
                    <p class="text-sm text-gray-300">Restoring a backup will <strong class="text-accent-red">overwrite your current server configuration</strong>. This includes roles, channels, and permissions. This action cannot be undone. Consider creating a new backup of your current state before restoring.</p>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="card text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-dark-600 flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/>
                </svg>
            </div>
            <h4 class="text-lg font-semibold text-white mb-2">No Backups Created</h4>
            <p class="text-gray-400">Create your first backup to protect your server configuration</p>
        </div>
    <% } %>
</div>

<script>
document.getElementById('create-backup-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/backups', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ snapshot_name: formData.get('snapshot_name') })
        });
        if (response.ok) {
            showToast('success', 'Backup created successfully');
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to create backup'); }
});

async function restoreBackup(id) {
    if (!confirm('Are you sure you want to restore this backup? This will overwrite current server settings!')) return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/backups/${id}/restore`, { method: 'POST' });
        if (response.ok) {
            showToast('success', 'Backup restored successfully');
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to restore backup'); }
}

async function deleteBackup(id) {
    if (!confirm('Are you sure you want to delete this backup? This action cannot be undone.')) return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/backups/${id}`, { method: 'DELETE' });
        if (response.ok) {
            showToast('success', 'Backup deleted');
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to delete backup'); }
}
</script>
