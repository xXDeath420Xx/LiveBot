<%# Mass Actions - Tailwind Version %>

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Total Members',
            value: guild.memberCount || 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Total Roles',
            value: roles ? roles.length : 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>',
            color: 'info'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Text Channels',
            value: Array.from(channels.values()).filter(c => c.type === 0).length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>',
            color: 'warning'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Server Boost',
            value: 'Tier ' + (guild.premiumTier || 0),
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
            color: 'success'
        }) %>
    </div>

    <!-- Mass Member Actions -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Mass Member Actions
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Mass Role Assignment -->
            <div class="p-4 bg-dark-700 rounded-lg border border-dark-400">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-primary-500 flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-white">Assign Role to Members</h4>
                        <p class="text-sm text-gray-400">Add a role to multiple users at once</p>
                    </div>
                </div>
                <form id="mass-assign-form" class="space-y-3">
                    <div class="form-group">
                        <label class="form-label">Role to Assign</label>
                        <%- include('../../components/forms/roleSelect', {
                            name: 'roleId',
                            roles: roles,
                            selected: null,
                            placeholder: 'Select a role'
                        }) %>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Target Members (User IDs)</label>
                        <textarea name="userIds" class="form-input w-full h-20 font-mono text-sm resize-y" placeholder="123456789012345678, 234567890123456789" required></textarea>
                        <p class="form-hint">Enter user IDs separated by commas</p>
                    </div>
                    <button type="submit" class="btn btn-primary w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        Assign Role
                    </button>
                </form>
            </div>

            <!-- Mass Role Removal -->
            <div class="p-4 bg-dark-700 rounded-lg border border-dark-400">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-accent-red flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"/>
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-white">Remove Role from Members</h4>
                        <p class="text-sm text-gray-400">Remove a role from multiple users at once</p>
                    </div>
                </div>
                <form id="mass-remove-form" class="space-y-3">
                    <div class="form-group">
                        <label class="form-label">Role to Remove</label>
                        <%- include('../../components/forms/roleSelect', {
                            name: 'roleId',
                            roles: roles,
                            selected: null,
                            placeholder: 'Select a role'
                        }) %>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Target Members (User IDs)</label>
                        <textarea name="userIds" class="form-input w-full h-20 font-mono text-sm resize-y" placeholder="123456789012345678, 234567890123456789" required></textarea>
                        <p class="form-hint">Enter user IDs separated by commas</p>
                    </div>
                    <button type="submit" class="btn btn-danger w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"/>
                        </svg>
                        Remove Role
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Mass Moderation Actions (Danger Zone) -->
    <div class="card border-accent-red/50">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            Mass Moderation Actions
        </h3>

        <div class="p-4 bg-accent-red/10 rounded-lg border-l-4 border-accent-red mb-4">
            <p class="font-semibold text-white mb-1">Danger Zone</p>
            <p class="text-sm text-gray-300">These actions cannot be undone. Use with extreme caution and ensure you have the correct user IDs.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Mass Kick -->
            <div class="p-4 bg-dark-700 rounded-lg border border-dark-500">
                <h4 class="font-semibold text-white mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Mass Kick
                </h4>
                <form id="mass-kick-form" class="space-y-3">
                    <div class="form-group">
                        <label class="form-label">User IDs to Kick</label>
                        <textarea name="userIds" class="form-input w-full h-20 font-mono text-sm resize-y" placeholder="123456789012345678, 234567890123456789" required></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Reason</label>
                        <input type="text" name="reason" class="form-input w-full" placeholder="Mass moderation action" required>
                    </div>
                    <button type="submit" class="btn btn-danger w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                        Kick Members
                    </button>
                </form>
            </div>

            <!-- Mass Ban -->
            <div class="p-4 bg-dark-700 rounded-lg border border-accent-red">
                <h4 class="font-semibold text-white mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                    </svg>
                    Mass Ban
                </h4>
                <form id="mass-ban-form" class="space-y-3">
                    <div class="form-group">
                        <label class="form-label">User IDs to Ban</label>
                        <textarea name="userIds" class="form-input w-full h-20 font-mono text-sm resize-y" placeholder="123456789012345678, 234567890123456789" required></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Reason</label>
                        <input type="text" name="reason" class="form-input w-full" placeholder="Mass moderation action" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Delete Message History</label>
                        <select name="deleteMessageDays" class="form-input w-full">
                            <option value="0">Don't delete messages</option>
                            <option value="1">1 day</option>
                            <option value="7" selected>7 days</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-danger w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                        </svg>
                        Ban Members
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Tips -->
    <div class="card bg-gradient-to-r from-accent-yellow/10 to-accent-yellow/5 border-accent-yellow/30">
        <h4 class="font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Tips for Mass Actions
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <p class="font-semibold text-primary-400 mb-2">Getting User IDs</p>
                <ul class="text-sm text-gray-300 space-y-1 list-disc list-inside">
                    <li>Enable Developer Mode in Discord Settings</li>
                    <li>Right-click a user and select "Copy User ID"</li>
                    <li>Separate multiple IDs with commas</li>
                </ul>
            </div>
            <div>
                <p class="font-semibold text-accent-green mb-2">Best Practices</p>
                <ul class="text-sm text-gray-300 space-y-1 list-disc list-inside">
                    <li>Double-check user IDs before mass actions</li>
                    <li>Test with a small batch first</li>
                    <li>Document reasons for moderation actions</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
function getFormData(form) {
    const formData = new FormData(form);
    return Object.fromEntries(formData);
}

function cleanUserIds(value) {
    return value.split(',').map(id => id.trim()).filter(id => id.length > 0);
}

document.getElementById('mass-assign-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = getFormData(this);
    const userIds = cleanUserIds(data.userIds);

    if (userIds.length === 0) {
        showToast('error', 'Please enter at least one user ID');
        return;
    }

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/mass/assign-role', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roleId: data.roleId, userIds })
        });

        if (response.ok) {
            const result = await response.json();
            showToast('success', `Role assigned to ${result.affected || userIds.length} users`);
            this.reset();
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to assign role');
    }
});

document.getElementById('mass-remove-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = getFormData(this);
    const userIds = cleanUserIds(data.userIds);

    if (userIds.length === 0) {
        showToast('error', 'Please enter at least one user ID');
        return;
    }

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/mass/remove-role', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roleId: data.roleId, userIds })
        });

        if (response.ok) {
            const result = await response.json();
            showToast('success', `Role removed from ${result.affected || userIds.length} users`);
            this.reset();
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to remove role');
    }
});

document.getElementById('mass-kick-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = getFormData(this);
    const userIds = cleanUserIds(data.userIds);

    if (userIds.length === 0) {
        showToast('error', 'Please enter at least one user ID');
        return;
    }

    if (!confirm(`Are you sure you want to kick ${userIds.length} member(s)? This action cannot be undone!`)) {
        return;
    }

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/mass/kick', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userIds, reason: data.reason })
        });

        if (response.ok) {
            const result = await response.json();
            showToast('success', `Kicked ${result.affected || userIds.length} members`);
            this.reset();
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to kick members');
    }
});

document.getElementById('mass-ban-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = getFormData(this);
    const userIds = cleanUserIds(data.userIds);

    if (userIds.length === 0) {
        showToast('error', 'Please enter at least one user ID');
        return;
    }

    if (!confirm(`Are you sure you want to BAN ${userIds.length} member(s)? This is a PERMANENT action!`)) {
        return;
    }

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/mass/ban', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userIds, reason: data.reason, deleteMessageDays: parseInt(data.deleteMessageDays) })
        });

        if (response.ok) {
            const result = await response.json();
            showToast('success', `Banned ${result.affected || userIds.length} members`);
            this.reset();
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to ban members');
    }
});
</script>
