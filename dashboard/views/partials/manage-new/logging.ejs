<%# Event Logging Settings - Tailwind Version %>

<%
const currentSettings = locals.settings || {};
const enabledLogs = JSON.parse(currentSettings.enabled_logs || '[]');
const categoryChannels = JSON.parse(currentSettings.log_categories || '{}');
const logCategories = [
    // Core Message Events
    { key: 'messageDelete', label: 'Message Deletions', icon: '💬', category: 'Messages' },
    { key: 'messageUpdate', label: 'Message Edits', icon: '✏️', category: 'Messages' },

    // Member Events
    { key: 'memberUpdate', label: 'Member Updates', icon: '👤', category: 'Members' },
    { key: 'memberLeave', label: 'Member Leave', icon: '👋', category: 'Members' },
    { key: 'memberKick', label: 'Member Kicks', icon: '🚪', category: 'Members' },

    // Voice Events
    { key: 'voiceUpdate', label: 'Voice Activity', icon: '🔊', category: 'Voice' },

    // Channel Events
    { key: 'channelCreate', label: 'Channel Created', icon: '➕', category: 'Channels' },
    { key: 'channelDelete', label: 'Channel Deleted', icon: '➖', category: 'Channels' },
    { key: 'channelUpdate', label: 'Channel Updated', icon: '🔧', category: 'Channels' },

    // Moderation Events
    { key: 'ban', label: 'Member Bans', icon: '🔨', category: 'Moderation' },
    { key: 'unban', label: 'Member Unbans', icon: '🔓', category: 'Moderation' },
    { key: 'moderation', label: 'Mod Actions', icon: '⚖️', category: 'Moderation' },

    // Role Events
    { key: 'roleCreate', label: 'Role Created', icon: '🎭', category: 'Roles' },
    { key: 'roleDelete', label: 'Role Deleted', icon: '❌', category: 'Roles' },
    { key: 'roleUpdate', label: 'Role Updated', icon: '🎨', category: 'Roles' },

    // Bot Feature Events
    { key: 'tickets', label: 'Ticket Events', icon: '🎫', category: 'Bot Features' },
    { key: 'xp', label: 'Level Up Events', icon: '⭐', category: 'Bot Features' },
    { key: 'giveaway', label: 'Giveaway Events', icon: '🎉', category: 'Bot Features' },
    { key: 'starboard', label: 'Starboard Posts', icon: '⭐', category: 'Bot Features' },
    { key: 'http', label: 'Dashboard Actions', icon: '🌐', category: 'Bot Features' }
];
%>

<div class="space-y-6">
    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Enabled Categories',
            value: enabledLogs.length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'primary'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Available Types',
            value: logCategories.length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>',
            color: 'info'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Channel Overrides',
            value: Object.keys(categoryChannels).filter(k => categoryChannels[k]).length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>',
            color: 'warning'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Default Channel',
            value: currentSettings.log_channel_id ? 'Set' : 'Not Set',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>',
            color: currentSettings.log_channel_id ? 'success' : 'danger'
        }) %>
    </div>

    <!-- Log Configuration -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Log Configuration</h3>
                <p class="text-sm text-gray-400">Set a default channel and enable specific event categories</p>
            </div>
        </div>

        <form id="logging-form" action="/api/guilds/<%= guildId %>/logging/config" method="PUT" data-track-changes>
            <!-- Default Channel -->
            <div class="form-group mb-6">
                <label class="form-label">Default Log Channel</label>
                <%- include('../../components/forms/channelSelect', {
                    name: 'log_channel_id',
                    channels: Array.from(channels.values()),
                    selected: currentSettings.log_channel_id,
                    placeholder: 'Select default log channel'
                }) %>
                <p class="form-hint">Events without channel overrides will be logged here</p>
            </div>

            <!-- Event Categories Table -->
            <div class="overflow-x-auto border border-dark-400 rounded-lg">
                <table class="data-table w-full">
                    <thead>
                        <tr>
                            <th class="w-1/3">Log Category</th>
                            <th class="w-24 text-center">Enable</th>
                            <th>Channel Override</th>
                        </tr>
                    </thead>
                    <tbody>
                        <%
                        const categories = [...new Set(logCategories.map(c => c.category))];
                        categories.forEach(category => {
                            const catItems = logCategories.filter(c => c.category === category);
                        %>
                            <tr class="bg-dark-600">
                                <td colspan="3" class="py-2 px-4">
                                    <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider"><%= category %></span>
                                </td>
                            </tr>
                            <% catItems.forEach(cat => { %>
                                <tr>
                                    <td>
                                        <label for="log-<%= cat.key %>" class="flex items-center gap-2 cursor-pointer">
                                            <span class="text-lg"><%= cat.icon %></span>
                                            <span class="text-white"><%= cat.label %></span>
                                        </label>
                                    </td>
                                    <td class="text-center">
                                        <%- include('../../components/forms/toggle', {
                                            name: 'enabled_logs',
                                            id: 'log-' + cat.key,
                                            value: cat.key,
                                            checked: enabledLogs.includes(cat.key),
                                            size: 'sm'
                                        }) %>
                                    </td>
                                    <td>
                                        <select name="log_categories[<%= cat.key %>]" class="form-input w-full text-sm">
                                            <option value="">Use Default</option>
                                            <% Array.from(channels.values()).forEach(channel => { %>
                                                <option value="<%= channel.id %>" <%= categoryChannels[cat.key] === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
                                            <% }); %>
                                        </select>
                                    </td>
                                </tr>
                            <% }); %>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Configuration
                </button>
            </div>
        </form>
    </div>

    <!-- Quick Toggle All -->
    <div class="card">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-lg font-semibold text-white">Quick Actions</h3>
                <p class="text-sm text-gray-400">Quickly enable or disable all log categories</p>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="button" class="btn btn-success" onclick="toggleAllLogs(true)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Enable All
            </button>
            <button type="button" class="btn btn-danger" onclick="toggleAllLogs(false)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Disable All
            </button>
            <button type="button" class="btn btn-secondary" onclick="resetChannelOverrides()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Reset Overrides
            </button>
        </div>
    </div>

    <!-- How It Works -->
    <div class="card bg-gradient-to-r from-primary-500/10 to-accent-green/10 border-primary-500/30">
        <div class="flex gap-4">
            <div class="flex-shrink-0">
                <div class="w-12 h-12 rounded-lg bg-primary-500/20 flex items-center justify-center">
                    <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                </div>
            </div>
            <div>
                <h4 class="font-semibold text-white mb-2">How Logging Works</h4>
                <ul class="text-sm text-gray-300 space-y-1.5">
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">1.</span>
                        Set a default log channel for all events
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">2.</span>
                        Enable specific event categories you want to track
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">3.</span>
                        Optionally route specific categories to different channels
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">4.</span>
                        Events are logged in rich embeds with full details
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
// Form submission
document.getElementById('logging-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const data = {
        log_channel_id: formData.get('log_channel_id'),
        enabled_logs: [],
        log_categories: {}
    };

    // Collect enabled logs
    formData.getAll('enabled_logs').forEach(key => {
        if (key) data.enabled_logs.push(key);
    });

    // Collect category channels
    for (const [key, value] of formData.entries()) {
        if (key.startsWith('log_categories[')) {
            const catKey = key.match(/\[(.+)\]/)?.[1];
            if (catKey && value) {
                data.log_categories[catKey] = value;
            }
        }
    }

    try {
        const response = await fetch(this.action, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', 'Log configuration saved');
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save configuration');
    }
});

function toggleAllLogs(enable) {
    document.querySelectorAll('[name="enabled_logs"]').forEach(input => {
        input.checked = enable;
    });
    showToast('info', enable ? 'All categories enabled' : 'All categories disabled');
}

function resetChannelOverrides() {
    document.querySelectorAll('[name^="log_categories"]').forEach(select => {
        select.value = '';
    });
    showToast('info', 'Channel overrides reset to default');
}
</script>
