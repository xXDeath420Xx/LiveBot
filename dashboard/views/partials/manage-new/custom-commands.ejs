<%# Custom Commands - Tailwind Version %>

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Total Commands',
            value: (locals.commands || []).length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Command Prefix',
            value: '!',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>',
            color: 'info'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Status',
            value: 'Active',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'success'
        }) %>
    </div>

    <!-- Create Command -->
    <div class="card">
        <div class="flex items-center gap-3 mb-6">
            <div class="p-3 bg-gradient-to-br from-primary-500 to-primary-600 rounded-lg">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">Create New Command</h3>
                <p class="text-sm text-gray-400">Build a custom command with a trigger and response</p>
            </div>
        </div>

        <form id="create-command-form">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div class="form-group">
                    <label class="form-label">Command Name</label>
                    <div class="flex">
                        <span class="flex items-center px-3 bg-dark-700 border border-r-0 border-dark-400 rounded-l-lg text-gray-400 font-bold">!</span>
                        <input type="text" name="command_name" class="form-input w-full rounded-l-none" required pattern="^\S+$" placeholder="mycommand">
                    </div>
                    <p class="form-hint">No spaces allowed</p>
                </div>
                <div class="form-group md:col-span-2">
                    <label class="form-label">Response Message</label>
                    <textarea name="response" class="form-input w-full h-[46px] resize-y" required placeholder="Enter the response message..."></textarea>
                    <p class="form-hint">The message the bot will send</p>
                </div>
            </div>

            <div class="p-3 bg-gradient-to-r from-primary-500/10 to-primary-500/5 border border-primary-500/30 rounded-lg mb-4">
                <div class="flex gap-3">
                    <svg class="w-5 h-5 text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <p class="text-sm text-gray-300">Users will type <code class="bg-dark-700 px-1.5 py-0.5 rounded text-primary-400">!commandname</code> and the bot will respond with your custom message</p>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Create Command
            </button>
        </form>
    </div>

    <!-- Commands List -->
    <% if (locals.commands && commands.length > 0) { %>
        <div class="card">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-white">Existing Commands</h3>
                <div class="relative">
                    <input type="text" id="commandSearch" class="form-input pl-10 w-64" placeholder="Search commands...">
                    <svg class="w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-dark-400">
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider w-48">Command</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Response</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider w-32">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="commandsTableBody" class="divide-y divide-dark-400">
                        <% commands.forEach(command => { %>
                            <tr class="hover:bg-dark-600 transition-colors command-row" data-command-name="<%= command.command_name.toLowerCase() %>" data-response="<%= command.response.toLowerCase() %>">
                                <td class="py-3 px-4">
                                    <code class="px-2 py-1 bg-dark-700 rounded font-mono text-primary-400 font-bold">!<%= command.command_name %></code>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="text-gray-400 truncate max-w-lg"><%= command.response %></div>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button onclick="editCommand('<%= command.command_name %>', `<%= command.response.replace(/`/g, '\\`').replace(/\$/g, '\\$') %>`)" class="p-2 text-gray-400 hover:text-primary-400 hover:bg-dark-700 rounded-lg transition-colors" title="Edit">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>
                                        <button onclick="deleteCommand('<%= command.command_name %>')" class="p-2 text-gray-400 hover:text-accent-red hover:bg-dark-700 rounded-lg transition-colors" title="Delete">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } else { %>
        <div class="card text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-dark-600 flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
            </div>
            <h4 class="text-lg font-semibold text-white mb-2">No Custom Commands</h4>
            <p class="text-gray-400">Create your first custom command to get started</p>
        </div>
    <% } %>
</div>

<!-- Edit Command Modal -->
<div id="edit-command-modal" class="modal-overlay hidden">
    <div class="modal-container max-w-md">
        <div class="modal-header">
            <h3 class="text-lg font-semibold text-white">Edit Command</h3>
            <button onclick="closeEditModal()" class="text-gray-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="edit-command-form">
            <input type="hidden" id="editCommandNameHidden" name="old_command_name">
            <div class="modal-body space-y-4">
                <div class="form-group">
                    <label class="form-label">Command Name</label>
                    <div class="flex">
                        <span class="flex items-center px-3 bg-dark-700 border border-r-0 border-dark-400 rounded-l-lg text-gray-400 font-bold">!</span>
                        <input type="text" id="editCommandName" name="command_name" class="form-input w-full rounded-l-none" required pattern="^\S+$">
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Response Message</label>
                    <textarea id="editCommandResponse" name="response" class="form-input w-full h-24 resize-y" required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeEditModal()" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
// Search functionality
document.getElementById('commandSearch')?.addEventListener('input', function(e) {
    const query = e.target.value.toLowerCase();
    document.querySelectorAll('.command-row').forEach(row => {
        const commandName = row.dataset.commandName;
        const response = row.dataset.response;
        row.style.display = (commandName.includes(query) || response.includes(query)) ? '' : 'none';
    });
});

// Create command
document.getElementById('create-command-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = {
        command_name: formData.get('command_name'),
        response: formData.get('response')
    };

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/custom-commands', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (response.ok) {
            showToast('success', 'Command created');
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to create command'); }
});

// Edit modal functions
function editCommand(commandName, response) {
    document.getElementById('editCommandNameHidden').value = commandName;
    document.getElementById('editCommandName').value = commandName;
    document.getElementById('editCommandResponse').value = response;
    document.getElementById('edit-command-modal').classList.remove('hidden');
}

function closeEditModal() {
    document.getElementById('edit-command-modal').classList.add('hidden');
}

// Edit command submit
document.getElementById('edit-command-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = {
        old_command_name: formData.get('old_command_name'),
        command_name: formData.get('command_name'),
        response: formData.get('response')
    };

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/custom-commands', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (response.ok) {
            showToast('success', 'Command updated');
            closeEditModal();
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to update command'); }
});

// Delete command
async function deleteCommand(commandName) {
    if (!confirm('Delete this command?')) return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/custom-commands/${encodeURIComponent(commandName)}`, { method: 'DELETE' });
        if (response.ok) {
            showToast('success', 'Command deleted');
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to delete command'); }
}
</script>
