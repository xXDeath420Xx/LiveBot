<%# Core Settings - Tailwind Version %>

<div class="space-y-6">
    <!-- Core Settings Card -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Core Settings</h3>
                <p class="text-sm text-gray-400">Configure essential bot settings for this server</p>
            </div>
        </div>

        <form id="core-settings-form" action="/api/guilds/<%= guildId %>/settings/core" method="PUT" data-track-changes>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Timezone -->
                <div class="form-group">
                    <label class="form-label">Timezone</label>
                    <select name="timezone" class="form-input w-full">
                        <% const timezones = ["UTC-12", "UTC-11", "UTC-10", "UTC-9", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC-2", "UTC-1", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+4", "UTC+5", "UTC+6", "UTC+7", "UTC+8", "UTC+9", "UTC+10", "UTC+11", "UTC+12"]; %>
                        <% timezones.forEach(tz => { %>
                            <option value="<%= tz %>" <%= (locals.settings?.timezone === tz) ? 'selected' : '' %>><%= tz %></option>
                        <% }); %>
                    </select>
                    <p class="form-hint">Used for scheduled messages and time displays</p>
                </div>

                <!-- Live Role -->
                <div class="form-group">
                    <label class="form-label">Live Streaming Role</label>
                    <%- include('../../components/forms/roleSelect', {
                        name: 'live_role_id',
                        roles: Array.from(roles.values()),
                        selected: locals.settings?.live_role_id,
                        placeholder: 'None (disabled)'
                    }) %>
                    <p class="form-hint">Automatically given when members go live</p>
                </div>

                <!-- Bot Prefix -->
                <div class="form-group">
                    <label class="form-label">Legacy Prefix</label>
                    <input type="text" name="prefix" class="form-input w-32" value="<%= locals.settings?.prefix || '!' %>" maxlength="5">
                    <p class="form-hint">For legacy text commands (slash commands recommended)</p>
                </div>

                <!-- Language -->
                <div class="form-group">
                    <label class="form-label">Bot Language</label>
                    <select name="language" class="form-input w-full">
                        <option value="en" <%= (locals.settings?.language === 'en') ? 'selected' : '' %>>English</option>
                        <option value="es" <%= (locals.settings?.language === 'es') ? 'selected' : '' %>>Spanish</option>
                        <option value="fr" <%= (locals.settings?.language === 'fr') ? 'selected' : '' %>>French</option>
                        <option value="de" <%= (locals.settings?.language === 'de') ? 'selected' : '' %>>German</option>
                        <option value="pt" <%= (locals.settings?.language === 'pt') ? 'selected' : '' %>>Portuguese</option>
                    </select>
                    <p class="form-hint">Bot response language (where available)</p>
                </div>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Settings
                </button>
            </div>
        </form>
    </div>

    <!-- Command Permissions -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Admin & Moderator Roles</h3>
                <p class="text-sm text-gray-400">Configure which roles can use bot commands</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="form-group">
                <label class="form-label">Admin Roles</label>
                <%- include('../../components/forms/roleSelect', {
                    name: 'admin_roles',
                    roles: Array.from(roles.values()),
                    selected: locals.settings?.admin_roles || [],
                    multiple: true,
                    placeholder: 'Select admin roles'
                }) %>
                <p class="form-hint">Full access to all bot commands</p>
            </div>

            <div class="form-group">
                <label class="form-label">Moderator Roles</label>
                <%- include('../../components/forms/roleSelect', {
                    name: 'mod_roles',
                    roles: Array.from(roles.values()),
                    selected: locals.settings?.mod_roles || [],
                    multiple: true,
                    placeholder: 'Select moderator roles'
                }) %>
                <p class="form-hint">Access to moderation commands</p>
            </div>
        </div>

        <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
            <button type="button" class="btn btn-primary" onclick="saveRolePermissions()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Save Roles
            </button>
        </div>
    </div>

    <!-- Disabled Features -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Feature Toggles</h3>
                <p class="text-sm text-gray-400">Enable or disable specific bot features</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-primary-500/10 rounded-lg">
                        <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Moderation</p>
                        <p class="text-xs text-gray-500">Moderation commands</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'feature_moderation',
                    checked: locals.featureToggles?.moderation !== false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-green/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Leveling</p>
                        <p class="text-xs text-gray-500">XP and level system</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'feature_leveling',
                    checked: locals.featureToggles?.leveling !== false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-yellow/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Economy</p>
                        <p class="text-xs text-gray-500">Currency and shop</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'feature_economy',
                    checked: locals.featureToggles?.economy !== false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-purple/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Music</p>
                        <p class="text-xs text-gray-500">Music commands</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'feature_music',
                    checked: locals.featureToggles?.music !== false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-red/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Fun Commands</p>
                        <p class="text-xs text-gray-500">Games and fun</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'feature_fun',
                    checked: locals.featureToggles?.fun !== false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-primary-500/10 rounded-lg">
                        <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Tickets</p>
                        <p class="text-xs text-gray-500">Support tickets</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'feature_tickets',
                    checked: locals.featureToggles?.tickets !== false,
                    size: 'sm'
                }) %>
            </div>
        </div>

        <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
            <button type="button" class="btn btn-primary" onclick="saveFeatureToggles()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Save Feature Toggles
            </button>
        </div>
    </div>

    <!-- Server Info -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Server Information</h3>
                <p class="text-sm text-gray-400">View server details and bot connection status</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-4 bg-dark-700 rounded-lg">
                <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Server ID</p>
                <p class="font-mono text-white text-sm"><%= guildId %></p>
            </div>
            <div class="p-4 bg-dark-700 rounded-lg">
                <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Bot Joined</p>
                <p class="text-white text-sm"><%= locals.guild?.joinedAt ? new Date(locals.guild.joinedAt).toLocaleDateString() : 'Unknown' %></p>
            </div>
            <div class="p-4 bg-dark-700 rounded-lg">
                <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Bot Status</p>
                <span class="badge badge-success">Connected</span>
            </div>
        </div>
    </div>
</div>

<script>
// Core settings form submission
document.getElementById('core-settings-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const data = {};
    formData.forEach((value, key) => {
        if (value) data[key] = value;
    });

    try {
        const response = await fetch(this.action, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', 'Core settings saved');
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save settings');
    }
});

async function saveRolePermissions() {
    const adminRoles = Array.from(document.querySelector('[name="admin_roles"]')?.selectedOptions || []).map(o => o.value);
    const modRoles = Array.from(document.querySelector('[name="mod_roles"]')?.selectedOptions || []).map(o => o.value);

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/settings/roles', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ admin_roles: adminRoles, mod_roles: modRoles })
        });

        if (response.ok) {
            showToast('success', 'Role permissions saved');
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save role permissions');
    }
}

async function saveFeatureToggles() {
    const features = {};
    document.querySelectorAll('[name^="feature_"]').forEach(toggle => {
        const feature = toggle.name.replace('feature_', '');
        features[feature] = toggle.checked;
    });

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/settings/features', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(features)
        });

        if (response.ok) {
            showToast('success', 'Feature toggles saved');
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save feature toggles');
    }
}
</script>
