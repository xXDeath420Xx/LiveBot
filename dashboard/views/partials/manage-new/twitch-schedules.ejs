<%# Twitch Schedules - Tailwind Version %>

<%
const syncs = twitchScheduleSyncs || [];
const twitchStreamers = consolidatedStreamers ? consolidatedStreamers.filter(s => s.platforms?.includes('twitch')) : [];
%>

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Active Syncs',
            value: syncs.length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Twitch Streamers',
            value: twitchStreamers.length,
            icon: '<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg>',
            color: 'purple'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Channels Used',
            value: new Set(syncs.map(s => s.channel_id)).size,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>',
            color: 'info'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Auto-Update',
            value: 'Enabled',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'success'
        }) %>
    </div>

    <!-- Add Schedule Sync -->
    <div class="card">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2 bg-purple-500/10 rounded-lg">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">Add Schedule Sync</h3>
                <p class="text-sm text-gray-400">Sync a Twitch streamer's schedule to automatically post updates</p>
            </div>
        </div>

        <form id="add-sync-form" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-group">
                    <label class="form-label">Twitch Streamer</label>
                    <select name="streamerId" class="form-input w-full" required>
                        <option value="">Select streamer</option>
                        <% twitchStreamers.forEach(streamer => { %>
                            <% const twitchSub = streamer.subscriptions?.find(sub => sub.platform === 'twitch'); %>
                            <% if (twitchSub) { %>
                                <option value="<%= twitchSub.streamer_id %>"><%= streamer.name %></option>
                            <% } %>
                        <% }) %>
                    </select>
                    <p class="form-hint">Must be a Twitch streamer</p>
                </div>
                <div class="form-group">
                    <label class="form-label">Post Schedule In</label>
                    <%- include('../../components/forms/channelSelect', {
                        name: 'channelId',
                        channels: channels,
                        selected: null,
                        placeholder: 'Select channel...'
                    }) %>
                    <p class="form-hint">Where to post schedule updates</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="form-group">
                    <label class="form-label">Update Interval (minutes)</label>
                    <input name="syncIntervalMinutes" type="number" class="form-input w-full" min="15" max="10080" value="360">
                    <p class="form-hint">How often to check for changes. 15 – 10080 (1 week). Default: 360 (6 hr).</p>
                </div>
                <div class="form-group">
                    <label class="form-label">Weekly Fresh Post</label>
                    <label class="flex items-center gap-2 mt-2 cursor-pointer">
                        <input name="weeklyRefresh" type="checkbox" class="w-4 h-4 rounded">
                        <span class="text-sm text-gray-300">Delete old embed + post new every 7 days</span>
                    </label>
                    <p class="form-hint">When off, the bot edits the existing embed in place.</p>
                </div>
                <div class="form-group flex items-end">
                    <button type="submit" class="btn btn-primary w-full">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Create Sync
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Active Schedule Syncs -->
    <div class="card">
        <div class="flex items-center gap-3 mb-4">
            <div class="p-2 bg-primary-500/10 rounded-lg">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">Active Schedule Syncs</h3>
                <p class="text-sm text-gray-400">Manage your configured schedule synchronizations</p>
            </div>
        </div>

        <% if (syncs.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b border-dark-400">
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Streamer</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Channel</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Interval</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Mode</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">View</th>
                            <th class="text-left py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Last Sync</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-dark-400">
                        <% syncs.forEach(sync => { %>
                            <% const streamer = consolidatedStreamers?.find(s => s.subscriptions?.some(sub => sub.streamer_id === sync.streamer_id)); %>
                            <% const channelId = sync.discord_channel_id || sync.channel_id; %>
                            <% const channel = channels.find(c => c.id === channelId); %>
                            <% const intervalMin = sync.sync_interval_minutes || 360; %>
                            <% const intervalLabel = intervalMin >= 60 ? (intervalMin / 60) + ' hr' : intervalMin + ' min'; %>
                            <% const streamerName = streamer ? streamer.name : (sync.username || 'Unknown Streamer'); %>
                            <tr class="hover:bg-dark-600 transition-colors" data-sync-id="<%= sync.id %>">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-purple-500/20 flex items-center justify-center">
                                            <svg class="w-4 h-4 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
                                            </svg>
                                        </div>
                                        <span class="font-medium text-white"><%= streamerName %></span>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2">
                                        <span class="text-gray-400">#</span>
                                        <span class="text-gray-300"><%= channel ? channel.name : 'Unknown Channel' %></span>
                                    </div>
                                </td>
                                <td class="py-3 px-4 text-sm text-gray-300"><%= intervalLabel %></td>
                                <td class="py-3 px-4">
                                    <% if (sync.weekly_refresh) { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-purple-500/15 text-purple-300">Weekly fresh</span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-500/15 text-gray-400">Edit in place</span>
                                    <% } %>
                                </td>
                                <td class="py-3 px-4">
                                    <% const viewMode = sync.view_mode === 'weekly' ? 'weekly' : 'monthly'; %>
                                    <% if (viewMode === 'weekly') { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-blue-500/15 text-blue-300">Weekly</span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-amber-500/15 text-amber-300">Monthly</span>
                                    <% } %>
                                </td>
                                <td class="py-3 px-4 text-sm text-gray-500">
                                    <%= sync.last_synced ? new Date(sync.last_synced).toLocaleString() : 'Never' %>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="inline-flex gap-2">
                                        <button onclick="openEditSyncModal('<%= sync.id %>', <%= intervalMin %>, <%= sync.weekly_refresh ? 'true' : 'false' %>, '<%= viewMode %>')" class="btn btn-ghost btn-sm" title="Edit settings">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>
                                        <button onclick="forceSync('<%= sync.id %>')" class="btn btn-ghost btn-sm" title="Force sync now">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                            </svg>
                                        </button>
                                        <button onclick="deleteSync('<%= sync.id %>')" class="btn btn-danger btn-sm" title="Remove">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-12">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-dark-600 flex items-center justify-center">
                    <svg class="w-8 h-8 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
                    </svg>
                </div>
                <h4 class="text-lg font-semibold text-white mb-2">No Schedule Syncs</h4>
                <p class="text-gray-400">Create a schedule sync to automatically post Twitch stream schedules</p>
            </div>
        <% } %>
    </div>

    <!-- How It Works -->
    <div class="card bg-gradient-to-r from-purple-500/10 to-purple-500/5 border-purple-500/30">
        <h4 class="font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            How Schedule Syncs Work
        </h4>
        <ul class="text-sm text-gray-300 space-y-2">
            <li class="flex items-start gap-2">
                <span class="text-purple-400">1.</span>
                The bot fetches the streamer's Twitch schedule automatically
            </li>
            <li class="flex items-start gap-2">
                <span class="text-purple-400">2.</span>
                When the schedule changes, an embed is posted to your channel
            </li>
            <li class="flex items-start gap-2">
                <span class="text-purple-400">3.</span>
                Each sync runs on its own configurable interval (15 min – 1 week)
            </li>
            <li class="flex items-start gap-2">
                <span class="text-purple-400">4.</span>
                Enable "Weekly Fresh Post" to delete the old embed and post a new one every 7 days
            </li>
            <li class="flex items-start gap-2">
                <span class="text-purple-400">5.</span>
                Great for keeping your community informed about upcoming streams!
            </li>
        </ul>
    </div>
</div>

<!-- Edit Sync Modal -->
<div id="edit-sync-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60">
    <div class="card max-w-md w-full mx-4">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-white">Edit Schedule Sync</h3>
            <button onclick="closeEditSyncModal()" class="text-gray-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <form id="edit-sync-form" class="space-y-4">
            <input type="hidden" name="syncId">
            <div class="form-group">
                <label class="form-label">Update Interval (minutes)</label>
                <input name="syncIntervalMinutes" type="number" class="form-input w-full" min="15" max="10080">
                <p class="form-hint">15 – 10080 (1 week). Default: 360 (6 hr).</p>
            </div>
            <div class="form-group">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input name="weeklyRefresh" type="checkbox" class="w-4 h-4 rounded">
                    <span class="text-sm text-gray-300">Weekly Fresh Post (delete old + post new every 7 days)</span>
                </label>
            </div>
            <div class="form-group">
                <label class="form-label">Calendar View</label>
                <select name="viewMode" class="form-input w-full">
                    <option value="monthly">Monthly — full month grid</option>
                    <option value="weekly">Weekly — 7-day view</option>
                </select>
                <p class="form-hint">Times are always rendered in this server's configured timezone.</p>
            </div>
            <div class="flex gap-2 justify-end">
                <button type="button" onclick="closeEditSyncModal()" class="btn btn-ghost">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<script>
document.getElementById('add-sync-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);

    const data = {
        streamerId: formData.get('streamerId'),
        channelId: formData.get('channelId'),
        syncIntervalMinutes: parseInt(formData.get('syncIntervalMinutes'), 10) || 360,
        weeklyRefresh: formData.get('weeklyRefresh') === 'on'
    };

    if (!data.streamerId || !data.channelId) {
        showToast('error', 'Please select both a streamer and channel');
        return;
    }

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/twitch-schedules/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', 'Schedule sync created');
            location.reload();
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to create schedule sync');
    }
});

async function deleteSync(syncId) {
    if (!confirm('Remove this schedule sync?')) return;

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/twitch-schedules/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ syncId })
        });

        if (response.ok) {
            showToast('success', 'Schedule sync removed');
            location.reload();
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to remove schedule sync');
    }
}

function openEditSyncModal(syncId, intervalMinutes, weeklyRefresh, viewMode) {
    const modal = document.getElementById('edit-sync-modal');
    const form = document.getElementById('edit-sync-form');
    form.elements.syncId.value = syncId;
    form.elements.syncIntervalMinutes.value = intervalMinutes;
    form.elements.weeklyRefresh.checked = !!weeklyRefresh;
    form.elements.viewMode.value = viewMode === 'weekly' ? 'weekly' : 'monthly';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeEditSyncModal() {
    const modal = document.getElementById('edit-sync-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

document.getElementById('edit-sync-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const form = e.target;
    const syncId = form.elements.syncId.value;
    const data = {
        syncIntervalMinutes: parseInt(form.elements.syncIntervalMinutes.value, 10) || 360,
        weeklyRefresh: form.elements.weeklyRefresh.checked,
        viewMode: form.elements.viewMode.value === 'weekly' ? 'weekly' : 'monthly'
    };
    try {
        const response = await fetch('/api/guilds/<%= guildId %>/twitch-schedules/' + encodeURIComponent(syncId), {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (response.ok) {
            showToast('success', 'Schedule sync updated');
            location.reload();
        } else {
            throw new Error('Failed');
        }
    } catch {
        showToast('error', 'Failed to update schedule sync');
    }
});

async function forceSync(syncId) {
    try {
        const response = await fetch('/api/guilds/<%= guildId %>/twitch-schedules/' + encodeURIComponent(syncId) + '/force-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            showToast('success', 'Sync triggered — give it a few seconds to post');
        } else {
            throw new Error('Failed');
        }
    } catch {
        showToast('error', 'Failed to trigger sync');
    }
}
</script>
