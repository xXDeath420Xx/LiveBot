<%# Streamers Settings - Tailwind Version %>

<%
const totalStreamers = (locals.twitchStreamers?.length || 0) + (locals.youtubeStreamers?.length || 0);
const liveCount = locals.liveStreams?.length || 0;
%>

<div class="space-y-6">
    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Total Streamers',
            value: totalStreamers,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
            color: 'primary'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Twitch',
            value: locals.twitchStreamers?.length || 0,
            icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/></svg>',
            color: 'info'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'YouTube',
            value: locals.youtubeStreamers?.length || 0,
            icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
            color: 'danger'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Live Now',
            value: liveCount,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/></svg>',
            color: liveCount > 0 ? 'success' : 'secondary'
        }) %>
    </div>

    <!-- Stream Notifications Config -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Stream Notifications</h3>
                <p class="text-sm text-gray-400">Configure where live stream alerts are sent</p>
            </div>
            <%- include('../../components/forms/toggle', {
                name: 'stream_notifications_enabled',
                id: 'stream_notifications_enabled',
                checked: locals.streamConfig?.enabled !== false,
                label: 'Enable Notifications',
                size: 'md'
            }) %>
        </div>

        <form id="stream-config-form" action="/api/guilds/<%= guildId %>/streaming/config" method="PUT">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                    <label class="form-label">Notification Channel</label>
                    <%- include('../../components/forms/channelSelect', {
                        name: 'announcement_channel_id',
                        channels: Array.from(channels.values()),
                        selected: locals.streamConfig?.channel_id,
                        placeholder: 'Select notification channel'
                    }) %>
                </div>

                <div class="form-group">
                    <label class="form-label">Ping Role (Optional)</label>
                    <%- include('../../components/forms/roleSelect', {
                        name: 'live_role_id',
                        roles: Array.from(roles.values()),
                        selected: locals.streamConfig?.ping_role_id,
                        placeholder: 'No ping'
                    }) %>
                </div>
            </div>

            <div class="form-group mt-4">
                <label class="form-label">Custom Message</label>
                <textarea name="stream_message" class="form-input w-full h-20 resize-none" placeholder="{user} is now live on {platform}! {title}"><%= locals.streamConfig?.message || '' %></textarea>
                <p class="form-hint">Variables: {user}, {platform}, {title}, {url}, {game}</p>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Config
                </button>
            </div>
        </form>
    </div>

    <!-- Twitch Streamers -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-[#9146FF]/20 rounded-lg">
                    <svg class="w-5 h-5 text-[#9146FF]" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">Twitch Streamers</h3>
                    <p class="text-sm text-gray-400">Track Twitch channels for live alerts</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary btn-sm" onclick="openAddStreamerModal('twitch')">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Twitch
            </button>
        </div>

        <% if (locals.twitchStreamers && locals.twitchStreamers.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% locals.twitchStreamers.forEach(streamer => { %>
                    <div class="flex items-center justify-between p-3 bg-dark-700 rounded-lg" data-streamer-id="<%= streamer.id %>">
                        <div class="flex items-center gap-3">
                            <img src="<%= streamer.profile_image || 'https://static-cdn.jtvnw.net/jtv_user_pictures/twitch-profile_image-default-70px-70px.png' %>" alt="" class="w-10 h-10 rounded-full">
                            <div>
                                <p class="font-medium text-white"><%= streamer.display_name || streamer.username %></p>
                                <p class="text-xs text-gray-500">twitch.tv/<%= streamer.username %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <% if (locals.liveStreams?.find(s => s.streamer_id === streamer.id)) { %>
                                <span class="badge badge-danger animate-pulse">LIVE</span>
                            <% } %>
                            <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-accent-red" onclick="removeStreamer(<%= streamer.id %>, 'twitch')">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-8 text-gray-500">
                <p class="text-sm">No Twitch streamers added yet</p>
            </div>
        <% } %>
    </div>

    <!-- YouTube Channels -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-[#FF0000]/20 rounded-lg">
                    <svg class="w-5 h-5 text-[#FF0000]" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">YouTube Channels</h3>
                    <p class="text-sm text-gray-400">Track YouTube channels for upload/live alerts</p>
                </div>
            </div>
            <button type="button" class="btn btn-danger btn-sm" onclick="openAddStreamerModal('youtube')">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add YouTube
            </button>
        </div>

        <% if (locals.youtubeStreamers && locals.youtubeStreamers.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% locals.youtubeStreamers.forEach(channel => { %>
                    <div class="flex items-center justify-between p-3 bg-dark-700 rounded-lg" data-channel-id="<%= channel.id %>">
                        <div class="flex items-center gap-3">
                            <img src="<%= channel.thumbnail || 'https://www.gstatic.com/youtube/img/branding/youtubelogo/svg/youtubelogo.svg' %>" alt="" class="w-10 h-10 rounded-full">
                            <div>
                                <p class="font-medium text-white"><%= channel.channel_name %></p>
                                <p class="text-xs text-gray-500">youtube.com/<%= channel.channel_id %></p>
                            </div>
                        </div>
                        <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-accent-red" onclick="removeStreamer(<%= channel.id %>, 'youtube')">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-8 text-gray-500">
                <p class="text-sm">No YouTube channels added yet</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Add Streamer Modal -->
<div id="add-streamer-modal" class="modal hidden">
    <div class="modal-overlay" onclick="closeAddStreamerModal()"></div>
    <div class="modal-content max-w-md">
        <div class="modal-header">
            <h3 class="modal-title" id="add-streamer-title">Add Streamer</h3>
            <button type="button" class="modal-close" onclick="closeAddStreamerModal()">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="add-streamer-form" class="modal-body space-y-4">
            <input type="hidden" name="platform" id="streamer-platform">

            <div class="form-group">
                <label class="form-label" id="username-label">Username</label>
                <input type="text" name="username" id="streamer-username" class="form-input w-full" placeholder="Enter username" required>
                <p class="form-hint" id="username-hint">Enter the Twitch username</p>
            </div>
        </form>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeAddStreamerModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="addStreamer()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Streamer
            </button>
        </div>
    </div>
</div>

<script>
let currentPlatform = 'twitch';

// Stream config form
document.getElementById('stream-config-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const data = {};
    formData.forEach((value, key) => {
        if (value) data[key] = value;
    });

    try {
        const response = await fetch(this.action, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', 'Stream config saved');
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save config');
    }
});

function openAddStreamerModal(platform) {
    currentPlatform = platform;
    document.getElementById('streamer-platform').value = platform;

    if (platform === 'twitch') {
        document.getElementById('add-streamer-title').textContent = 'Add Twitch Streamer';
        document.getElementById('username-label').textContent = 'Twitch Username';
        document.getElementById('username-hint').textContent = 'Enter the Twitch username (e.g., ninja)';
    } else {
        document.getElementById('add-streamer-title').textContent = 'Add YouTube Channel';
        document.getElementById('username-label').textContent = 'Channel ID or URL';
        document.getElementById('username-hint').textContent = 'Enter YouTube channel ID or URL';
    }

    document.getElementById('add-streamer-form').reset();
    document.getElementById('streamer-platform').value = platform;
    document.getElementById('add-streamer-modal').classList.remove('hidden');
}

function closeAddStreamerModal() {
    document.getElementById('add-streamer-modal').classList.add('hidden');
}

async function addStreamer() {
    const form = document.getElementById('add-streamer-form');
    const username = document.getElementById('streamer-username').value.trim();

    if (!username) {
        showToast('error', 'Please enter a username');
        return;
    }

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/streaming/${currentPlatform}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username })
        });

        if (response.ok) {
            showToast('success', 'Streamer added');
            closeAddStreamerModal();
            location.reload();
        } else {
            const err = await response.json();
            throw new Error(err.error || 'Failed to add');
        }
    } catch (error) {
        showToast('error', error.message);
    }
}

async function removeStreamer(streamerId, platform) {
    if (!confirm('Remove this streamer?')) return;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/streaming/${platform}/${streamerId}`, {
            method: 'DELETE'
        });

        if (response.ok) {
            showToast('success', 'Streamer removed');
            document.querySelector(`[data-streamer-id="${streamerId}"]`)?.remove();
            document.querySelector(`[data-channel-id="${streamerId}"]`)?.remove();
        } else {
            throw new Error('Failed to remove');
        }
    } catch (error) {
        showToast('error', 'Failed to remove streamer');
    }
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeAddStreamerModal();
});
</script>
