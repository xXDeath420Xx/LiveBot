<%# Dashboard Search - Tailwind Version %>

<div class="space-y-6">
    <!-- Header -->
    <div class="card">
        <div class="flex items-center gap-3">
            <div class="p-2 bg-primary-500/10 rounded-lg">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">Dashboard Search</h3>
                <p class="text-sm text-gray-400">Search across bot settings, user data, infractions, and log entries</p>
            </div>
        </div>
    </div>

    <!-- Search Form -->
    <div class="card">
        <div class="form-group mb-4">
            <label class="form-label">Search Query</label>
            <div class="relative">
                <svg class="w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="text" id="dashboard-search-input" class="form-input w-full pl-10" placeholder="Enter your search query (user ID, setting name, command, etc.)">
            </div>
            <p class="form-hint">Search across settings, users, roles, commands, and logs</p>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">Search Categories</label>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <label class="flex items-center gap-2 p-3 bg-dark-700 rounded-lg cursor-pointer border-2 border-transparent has-[:checked]:border-primary-500 transition-colors">
                    <input type="checkbox" id="search-settings" value="settings" checked class="form-checkbox">
                    <div>
                        <span class="text-sm font-semibold text-white flex items-center gap-1">
                            <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            </svg>
                            Settings
                        </span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-3 bg-dark-700 rounded-lg cursor-pointer border-2 border-transparent has-[:checked]:border-accent-green transition-colors">
                    <input type="checkbox" id="search-users" value="users" checked class="form-checkbox">
                    <div>
                        <span class="text-sm font-semibold text-white flex items-center gap-1">
                            <svg class="w-4 h-4 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            Users/Roles
                        </span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-3 bg-dark-700 rounded-lg cursor-pointer border-2 border-transparent has-[:checked]:border-accent-yellow transition-colors">
                    <input type="checkbox" id="search-logs" value="logs" checked class="form-checkbox">
                    <div>
                        <span class="text-sm font-semibold text-white flex items-center gap-1">
                            <svg class="w-4 h-4 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            Logs
                        </span>
                    </div>
                </label>

                <label class="flex items-center gap-2 p-3 bg-dark-700 rounded-lg cursor-pointer border-2 border-transparent has-[:checked]:border-accent-red transition-colors">
                    <input type="checkbox" id="search-infractions" value="infractions" checked class="form-checkbox">
                    <div>
                        <span class="text-sm font-semibold text-white flex items-center gap-1">
                            <svg class="w-4 h-4 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                            Infractions
                        </span>
                    </div>
                </label>
            </div>
        </div>

        <button type="button" id="run-dashboard-search" class="btn btn-primary w-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Search Dashboard
        </button>
    </div>

    <!-- Search Tips -->
    <div id="search-tips" class="card">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-lg bg-primary-500 flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
            </div>
            <div>
                <h4 class="font-semibold text-white">Search Tips</h4>
                <p class="text-sm text-gray-400">Get the most out of dashboard search</p>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="p-3 bg-dark-700 rounded-lg">
                <p class="font-semibold text-white text-sm mb-1 flex items-center gap-1">
                    <svg class="w-3 h-3 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    User Searches
                </p>
                <p class="text-xs text-gray-400">Search by Discord ID, username, or role name</p>
            </div>

            <div class="p-3 bg-dark-700 rounded-lg">
                <p class="font-semibold text-white text-sm mb-1 flex items-center gap-1">
                    <svg class="w-3 h-3 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35"/>
                    </svg>
                    Settings
                </p>
                <p class="text-xs text-gray-400">Find configuration values by feature name</p>
            </div>

            <div class="p-3 bg-dark-700 rounded-lg">
                <p class="font-semibold text-white text-sm mb-1 flex items-center gap-1">
                    <svg class="w-3 h-3 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Logs & History
                </p>
                <p class="text-xs text-gray-400">Search action logs and audit events</p>
            </div>

            <div class="p-3 bg-dark-700 rounded-lg">
                <p class="font-semibold text-white text-sm mb-1 flex items-center gap-1">
                    <svg class="w-3 h-3 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    Moderation
                </p>
                <p class="text-xs text-gray-400">Look up warnings, kicks, bans, and mutes</p>
            </div>
        </div>
    </div>

    <!-- Search Results -->
    <div id="dashboard-search-results"></div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('dashboard-search-input');
    const searchButton = document.getElementById('run-dashboard-search');
    const searchResultsDiv = document.getElementById('dashboard-search-results');
    const searchTips = document.getElementById('search-tips');

    searchButton.addEventListener('click', async function() {
        const query = searchInput.value.trim();
        if (!query) {
            showToast('error', 'Please enter a search query');
            return;
        }

        const categories = [];
        if (document.getElementById('search-settings').checked) categories.push('settings');
        if (document.getElementById('search-users').checked) categories.push('users');
        if (document.getElementById('search-logs').checked) categories.push('logs');
        if (document.getElementById('search-infractions').checked) categories.push('infractions');

        if (categories.length === 0) {
            showToast('warning', 'Please select at least one category');
            return;
        }

        searchTips.classList.add('hidden');
        searchResultsDiv.innerHTML = `
            <div class="card">
                <div class="text-center py-8">
                    <div class="inline-block w-8 h-8 border-4 border-dark-400 border-t-primary-400 rounded-full animate-spin"></div>
                    <p class="mt-4 text-gray-400">Searching...</p>
                </div>
            </div>
        `;

        try {
            const response = await fetch(`/api/guilds/<%= guildId %>/search?q=${encodeURIComponent(query)}&categories=${categories.join(',')}`);
            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || 'Search failed');
            }

            renderSearchResults(data);
        } catch (error) {
            searchResultsDiv.innerHTML = `
                <div class="card border-accent-red">
                    <p class="text-accent-red font-semibold">Error: ${error.message}</p>
                </div>
            `;
        }
    });

    function renderSearchResults(results) {
        if (!results || results.length === 0) {
            searchResultsDiv.innerHTML = `
                <div class="card">
                    <div class="text-center py-12">
                        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-dark-600 flex items-center justify-center">
                            <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                        </div>
                        <h4 class="text-lg font-semibold text-white mb-2">No Results Found</h4>
                        <p class="text-gray-400">Try adjusting your search query or selecting different categories</p>
                    </div>
                </div>
            `;
            return;
        }

        const categoryColors = {
            settings: 'primary',
            users: 'success',
            logs: 'warning',
            infractions: 'danger'
        };

        let html = `
            <div class="card">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                        <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        Search Results
                    </h3>
                    <span class="px-2 py-1 text-xs font-medium rounded-full bg-primary-500/20 text-primary-400">${results.length} results</span>
                </div>
                <div class="space-y-3">
        `;

        results.forEach(item => {
            html += `
                <div class="p-4 bg-dark-700 rounded-lg border border-dark-400 hover:border-primary-400 transition-colors">
                    <div class="flex items-start gap-3">
                        <div class="flex-grow">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-${categoryColors[item.type] || 'gray'}-500/20 text-${categoryColors[item.type] || 'gray'}-400 capitalize">${item.type}</span>
                            </div>
                            <h4 class="font-semibold text-white mb-1">${item.title || 'Result'}</h4>
                            <p class="text-sm text-gray-400">${item.description || 'No description available'}</p>
                            ${item.link ? `
                                <a href="${item.link}" class="inline-flex items-center gap-1 mt-2 text-sm text-primary-400 hover:text-primary-300">
                                    View <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                </a>
                            ` : ''}
                        </div>
                    </div>
                </div>
            `;
        });

        html += `</div></div>`;
        searchResultsDiv.innerHTML = html;
    }

    searchInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            searchButton.click();
        }
    });
});
</script>
