<%# Add Streamer Modal - Tailwind Version %>

<div id="add-streamer-modal" class="modal-overlay hidden">
    <div class="modal-container max-w-2xl">
        <form id="add-streamer-form">
            <div class="modal-header">
                <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                    </svg>
                    Add New Streamer
                </h3>
                <button type="button" onclick="closeAddStreamerModal()" class="text-gray-400 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div class="modal-body space-y-6 max-h-[70vh] overflow-y-auto">
                <!-- Basic Information -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label flex items-center gap-2">
                            <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                            </svg>
                            Platform
                        </label>
                        <select name="platform" class="form-input w-full" required>
                            <option value="twitch">Twitch</option>
                            <option value="youtube">YouTube</option>
                            <option value="kick">Kick</option>
                            <option value="tiktok">TikTok</option>
                            <option value="trovo">Trovo</option>
                            <option value="facebook">Facebook Gaming</option>
                            <option value="instagram">Instagram</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label flex items-center gap-2">
                            <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Username/Channel ID
                        </label>
                        <input type="text" name="username" class="form-input w-full" placeholder="Enter streamer username" required>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label flex items-center gap-2">
                        <svg class="w-4 h-4 text-primary-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/>
                        </svg>
                        Link Discord User (Optional)
                    </label>
                    <input type="text" name="discord_user_id" class="form-input w-full" placeholder="Discord User ID (e.g., 123456789012345678)">
                </div>

                <hr class="border-dark-400">

                <!-- Announcement Settings -->
                <div>
                    <h4 class="text-base font-semibold text-white mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
                        </svg>
                        Announcement Settings
                    </h4>
                    <p class="text-sm text-gray-400 mb-4">Configure how and where stream announcements will be posted</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Announcement Channel</label>
                            <select name="announcement_channel_id" class="form-input w-full">
                                <option value="">-- Use Server Default --</option>
                                <% channels.forEach(c => { %>
                                    <option value="<%= c.id %>"># <%= c.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Display Name Override</label>
                            <input type="text" name="override_nickname" class="form-input w-full" placeholder="Leave blank to use their username">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Custom Announcement Message</label>
                        <textarea name="custom_message" class="form-input w-full" rows="3" placeholder="Hey @everyone! {streamer} just went live playing {game}! Check it out at {url}"></textarea>
                        <p class="form-hint">Variables: {streamer}, {game}, {title}, {url}</p>
                    </div>

                    <div class="p-4 bg-dark-700 rounded-lg">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" name="keep_summary" class="toggle-input">
                            <span class="text-sm text-gray-300">Keep announcement after stream ends (don't delete/edit message)</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="closeAddStreamerModal()" class="btn btn-secondary">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Streamer
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openAddStreamerModal() {
    document.getElementById('add-streamer-form').reset();
    document.getElementById('add-streamer-modal').classList.remove('hidden');
}

function closeAddStreamerModal() {
    document.getElementById('add-streamer-modal').classList.add('hidden');
}

document.getElementById('add-streamer-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);

    const data = {
        platform: formData.get('platform'),
        username: formData.get('username'),
        discord_user_id: formData.get('discord_user_id'),
        announcement_channel_id: formData.get('announcement_channel_id'),
        override_nickname: formData.get('override_nickname'),
        custom_message: formData.get('custom_message'),
        keep_summary: formData.get('keep_summary') === 'on'
    };

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/streamers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', 'Streamer added successfully');
            closeAddStreamerModal();
            location.reload();
        } else {
            const result = await response.json();
            throw new Error(result.error || 'Failed to add streamer');
        }
    } catch (error) {
        showToast('error', error.message);
    }
});

// Close modal on background click
document.getElementById('add-streamer-modal')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeAddStreamerModal();
    }
});
</script>
