<%# Live Announcements - Tailwind Version %>

<%
const announcementSettings = settings || {};
const defaultMessage = announcementSettings.announcement_message || '{streamer} is now live on {platform}! {url}';
const channelId = announcementSettings.announcement_channel_id || '';
const liveRoleId = announcementSettings.live_role_id || '';
%>

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Status',
            value: channelId ? 'Enabled' : 'Disabled',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="' + (channelId ? 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' : 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z') + '"/></svg>',
            color: channelId ? 'success' : 'secondary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Channel',
            value: channelId ? '#' + (Array.from(channels.values()).find(c => c.id === channelId)?.name || 'Unknown') : 'Not Set',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Live Role',
            value: liveRoleId ? (roles.find(r => r.id === liveRoleId)?.name || 'Unknown') : 'Not Set',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>',
            color: liveRoleId ? 'info' : 'secondary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Message Length',
            value: defaultMessage.length + ' chars',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>',
            color: 'warning'
        }) %>
    </div>

    <!-- Configuration -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
            </svg>
            Announcement Settings
        </h3>
        <p class="text-gray-400 mb-6">Configure where and how live notifications are sent</p>

        <form id="announcements-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Left Column -->
                <div class="space-y-4">
                    <div class="form-group">
                        <label class="form-label">Announcement Channel</label>
                        <%- include('../../components/forms/channelSelect', {
                            name: 'announcement_channel_id',
                            channels: Array.from(channels.values()).filter(c => c.type === 0),
                            selected: channelId,
                            placeholder: 'Disabled'
                        }) %>
                        <p class="form-hint">Channel where live announcements will be posted</p>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Live Role</label>
                        <%- include('../../components/forms/roleSelect', {
                            name: 'live_role_id',
                            roles: roles,
                            selected: liveRoleId,
                            placeholder: 'No Role'
                        }) %>
                        <p class="form-hint">Role automatically assigned to Discord users when they go live</p>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Custom Message Template</label>
                        <textarea name="announcement_message" id="announcement-message" class="form-input w-full h-32 font-mono text-sm resize-y" placeholder="Enter your custom announcement message"><%= defaultMessage %></textarea>
                        <p class="form-hint">Customize the message sent when streamers go live</p>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="space-y-4">
                    <!-- Variables Reference -->
                    <div class="p-4 bg-dark-700 rounded-lg border border-dark-400">
                        <h4 class="font-semibold text-white mb-3 flex items-center gap-2">
                            <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                            </svg>
                            Available Variables
                        </h4>
                        <div class="space-y-2">
                            <div class="flex justify-between items-center p-2 bg-dark-600 rounded text-sm">
                                <code class="text-primary-400">{streamer}</code>
                                <span class="text-gray-400 text-xs">Streamer's name</span>
                            </div>
                            <div class="flex justify-between items-center p-2 bg-dark-600 rounded text-sm">
                                <code class="text-primary-400">{platform}</code>
                                <span class="text-gray-400 text-xs">Platform name</span>
                            </div>
                            <div class="flex justify-between items-center p-2 bg-dark-600 rounded text-sm">
                                <code class="text-primary-400">{game}</code>
                                <span class="text-gray-400 text-xs">Game/category</span>
                            </div>
                            <div class="flex justify-between items-center p-2 bg-dark-600 rounded text-sm">
                                <code class="text-primary-400">{url}</code>
                                <span class="text-gray-400 text-xs">Stream URL</span>
                            </div>
                            <div class="flex justify-between items-center p-2 bg-dark-600 rounded text-sm">
                                <code class="text-primary-400">{title}</code>
                                <span class="text-gray-400 text-xs">Stream title</span>
                            </div>
                            <div class="flex justify-between items-center p-2 bg-dark-600 rounded text-sm">
                                <code class="text-primary-400">{everyone}</code>
                                <span class="text-gray-400 text-xs">@everyone ping</span>
                            </div>
                        </div>
                    </div>

                    <!-- Live Preview -->
                    <div class="p-4 bg-dark-700 rounded-lg border border-dark-400">
                        <h4 class="font-semibold text-white mb-2 flex items-center gap-2">
                            <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                            Preview
                        </h4>
                        <div class="p-3 bg-dark-600 rounded border-l-3 border-primary-500">
                            <p id="message-preview" class="text-sm text-gray-300 font-mono"></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Announcement Settings
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function updatePreview() {
    const messageInput = document.getElementById('announcement-message');
    const preview = document.getElementById('message-preview');

    if (messageInput && preview) {
        let message = messageInput.value || '{streamer} is now live on {platform}! {url}';
        message = message
            .replace(/\{streamer\}/g, 'ExampleStreamer')
            .replace(/\{platform\}/g, 'Twitch')
            .replace(/\{game\}/g, 'Minecraft')
            .replace(/\{url\}/g, 'https://twitch.tv/example')
            .replace(/\{title\}/g, 'Awesome Stream!')
            .replace(/\{everyone\}/g, '@everyone');

        preview.textContent = message || 'Preview will appear here...';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const messageInput = document.getElementById('announcement-message');
    if (messageInput) {
        messageInput.addEventListener('input', updatePreview);
        updatePreview();
    }
});

document.getElementById('announcements-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/announcements', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(formData))
        });

        if (response.ok) {
            showToast('success', 'Announcement settings saved');
        } else {
            throw new Error('Failed');
        }
    } catch (error) {
        showToast('error', 'Failed to save settings');
    }
});
</script>
