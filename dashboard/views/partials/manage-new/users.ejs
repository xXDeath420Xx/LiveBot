<%# User Management - Tailwind Version %>

<div class="space-y-6">
    <!-- Header with Bulk Actions -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="p-2 bg-primary-500/10 rounded-lg">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-bold text-white">User Management</h2>
                <p class="text-sm text-gray-400">View and manage individual user data for XP, reputation, and economy</p>
            </div>
        </div>
        <button onclick="openBulkActionsModal()" class="btn btn-danger">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            Bulk Actions
        </button>
    </div>

    <!-- User Search -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Search User
        </h3>

        <div class="space-y-4">
            <div class="form-group">
                <label class="form-label">Select User</label>
                <select id="userSelect" class="form-input w-full">
                    <option value="">Choose a user...</option>
                    <% if (typeof guildMembers !== 'undefined' && guildMembers) { %>
                        <% guildMembers.forEach(member => { %>
                            <option value="<%= member.id %>" data-avatar="<%= member.avatar || '' %>" data-username="<%= member.username %>">
                                <%= member.username %><%= member.discriminator && member.discriminator !== '0' ? '#' + member.discriminator : '' %>
                            </option>
                        <% }); %>
                    <% } %>
                </select>
                <p class="form-hint">Select a server member to view and manage their data</p>
            </div>

            <div class="flex gap-3">
                <button id="loadUserBtn" class="btn btn-primary flex-1" disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Load User Data
                </button>
                <button id="clearSelectionBtn" class="btn btn-secondary flex-1" disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                    Clear Selection
                </button>
            </div>

            <!-- Selected User Preview -->
            <div id="userPreview" class="hidden pt-4 border-t border-dark-400">
                <div class="flex items-center gap-4">
                    <div id="userAvatar" class="w-16 h-16 rounded-full bg-dark-600 flex items-center justify-center border-2 border-primary-500 overflow-hidden">
                        <svg class="w-8 h-8 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                    </div>
                    <div>
                        <p id="userName" class="text-xl font-bold text-white"></p>
                        <p id="userId" class="text-sm text-gray-500 font-mono"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Data Container (hidden by default) -->
    <div id="userDataContainer" class="hidden space-y-6">
        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="p-4 bg-dark-600 rounded-lg border border-dark-400">
                <p class="text-xs text-gray-500 mb-1">Level</p>
                <p id="overviewLevel" class="text-2xl font-bold text-primary-400">0</p>
            </div>
            <div class="p-4 bg-dark-600 rounded-lg border border-dark-400">
                <p class="text-xs text-gray-500 mb-1">XP</p>
                <p id="overviewXP" class="text-2xl font-bold text-purple-400">0</p>
            </div>
            <div class="p-4 bg-dark-600 rounded-lg border border-dark-400">
                <p class="text-xs text-gray-500 mb-1">Reputation</p>
                <p id="overviewReputation" class="text-2xl font-bold text-accent-yellow">0</p>
            </div>
            <div class="p-4 bg-dark-600 rounded-lg border border-dark-400">
                <p class="text-xs text-gray-500 mb-1">Net Worth</p>
                <p id="overviewNetWorth" class="text-2xl font-bold text-accent-green">0</p>
            </div>
        </div>

        <!-- XP & Leveling -->
        <div class="card">
            <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
                XP & Leveling
            </h3>

            <div class="grid grid-cols-2 gap-4 mb-6">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Current Level</p>
                    <p id="currentLevel" class="text-3xl font-bold text-primary-400">0</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500 mb-1">Total XP</p>
                    <p id="currentXP" class="text-3xl font-bold text-purple-400">0</p>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="mb-4">
                <div class="flex justify-between text-xs text-gray-500 mb-2">
                    <span>Progress to Level <span id="nextLevel">1</span></span>
                    <span><span id="progressXP">0</span> / <span id="requiredXP">100</span> XP</span>
                </div>
                <div class="h-6 bg-dark-700 rounded-full overflow-hidden">
                    <div id="xpProgressBar" class="h-full bg-gradient-to-r from-primary-500 to-purple-500 rounded-full transition-all duration-300 flex items-center justify-center text-xs font-bold text-white" style="width: 0%">
                        0%
                    </div>
                </div>
            </div>

            <div class="flex gap-2 mb-6">
                <span class="px-2 py-1 text-xs rounded-full bg-primary-500/20 text-primary-400">
                    <span id="totalMessages">0</span> messages
                </span>
                <span class="px-2 py-1 text-xs rounded-full bg-purple-500/20 text-purple-400">
                    <span id="voiceMinutes">0</span> voice minutes
                </span>
            </div>

            <form id="xpManagementForm" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Set XP</label>
                        <input type="number" id="setXPInput" class="form-input w-full" min="0" placeholder="Enter XP amount">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Set Level</label>
                        <input type="number" id="setLevelInput" class="form-input w-full" min="0" placeholder="Enter level">
                    </div>
                </div>
                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Update XP/Level
                    </button>
                    <button type="button" onclick="resetUserXP()" class="btn btn-danger">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Reset XP
                    </button>
                </div>
            </form>
        </div>

        <!-- Reputation -->
        <div class="card">
            <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
                Reputation
            </h3>

            <div class="grid grid-cols-3 gap-4 mb-6">
                <div class="p-4 bg-dark-700 rounded-lg text-center">
                    <p class="text-xs text-gray-500 mb-1">Total</p>
                    <p id="totalReputation" class="text-2xl font-bold text-accent-yellow">0</p>
                </div>
                <div class="p-4 bg-dark-700 rounded-lg text-center">
                    <p class="text-xs text-gray-500 mb-1">Given</p>
                    <p id="reputationGiven" class="text-xl font-semibold text-primary-400">0</p>
                </div>
                <div class="p-4 bg-dark-700 rounded-lg text-center">
                    <p class="text-xs text-gray-500 mb-1">Received</p>
                    <p id="reputationReceived" class="text-xl font-semibold text-accent-green">0</p>
                </div>
            </div>

            <form id="reputationManagementForm" class="space-y-4">
                <div class="form-group">
                    <label class="form-label">Set Reputation</label>
                    <input type="number" id="setReputationInput" class="form-input w-full" placeholder="Enter reputation amount">
                    <p class="form-hint">Can be negative</p>
                </div>
                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">Update Reputation</button>
                    <button type="button" onclick="resetUserReputation()" class="btn btn-danger">Reset Reputation</button>
                </div>
            </form>
        </div>

        <!-- Economy -->
        <div class="card">
            <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Economy
            </h3>

            <div class="grid grid-cols-3 gap-4 mb-6">
                <div class="p-4 bg-dark-700 rounded-lg text-center">
                    <p class="text-xs text-gray-500 mb-1">Wallet</p>
                    <p id="walletBalance" class="text-2xl font-bold text-accent-yellow">0</p>
                </div>
                <div class="p-4 bg-dark-700 rounded-lg text-center">
                    <p class="text-xs text-gray-500 mb-1">Bank</p>
                    <p id="bankBalance" class="text-2xl font-bold text-primary-400">0</p>
                </div>
                <div class="p-4 bg-dark-700 rounded-lg text-center">
                    <p class="text-xs text-gray-500 mb-1">Net Worth</p>
                    <p id="netWorth" class="text-2xl font-bold text-accent-green">0</p>
                </div>
            </div>

            <form id="economyManagementForm" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Amount</label>
                        <input type="number" id="currencyAmount" class="form-input w-full" placeholder="Enter amount (negative to remove)">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Target</label>
                        <select id="currencyTarget" class="form-input w-full">
                            <option value="wallet">Wallet</option>
                            <option value="bank">Bank</option>
                        </select>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button type="submit" class="btn btn-primary">Update Balance</button>
                    <button type="button" onclick="resetUserEconomy()" class="btn btn-danger">Reset Economy</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Actions Modal -->
<div id="bulk-actions-modal" class="modal-overlay hidden">
    <div class="modal-container max-w-md">
        <div class="modal-header">
            <h3 class="text-lg font-semibold text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                Bulk Actions - Use with Caution
            </h3>
            <button onclick="closeBulkActionsModal()" class="text-gray-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="p-4 bg-accent-red/10 rounded-lg border border-accent-red/30 mb-4">
                <p class="text-sm text-gray-300">
                    <strong class="text-accent-red">Warning:</strong> These actions affect ALL users and cannot be undone.
                </p>
            </div>

            <div class="space-y-3">
                <button onclick="bulkResetXP()" class="btn btn-danger w-full justify-start">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                    </svg>
                    Reset All Users XP
                </button>
                <button onclick="bulkResetReputation()" class="btn btn-danger w-full justify-start">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                    Reset All Users Reputation
                </button>
                <button onclick="bulkResetEconomy()" class="btn btn-danger w-full justify-start">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Reset All Users Economy
                </button>
                <button onclick="exportUserData()" class="btn btn-primary w-full justify-start">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Export All User Data to CSV
                </button>
            </div>
        </div>
        <div class="modal-footer">
            <button onclick="closeBulkActionsModal()" class="btn btn-secondary">Close</button>
        </div>
    </div>
</div>

<script>
let selectedUserId = null;

document.addEventListener('DOMContentLoaded', () => {
    const userSelect = document.getElementById('userSelect');
    const loadUserBtn = document.getElementById('loadUserBtn');
    const clearSelectionBtn = document.getElementById('clearSelectionBtn');

    userSelect.addEventListener('change', function() {
        if (this.value) {
            selectedUserId = this.value;
            loadUserBtn.disabled = false;
            clearSelectionBtn.disabled = false;
            updateUserPreview(this.options[this.selectedIndex]);
        } else {
            selectedUserId = null;
            loadUserBtn.disabled = true;
            clearSelectionBtn.disabled = true;
            document.getElementById('userPreview').classList.add('hidden');
        }
    });

    loadUserBtn.addEventListener('click', () => loadUserData(selectedUserId));

    clearSelectionBtn.addEventListener('click', () => {
        userSelect.value = '';
        selectedUserId = null;
        loadUserBtn.disabled = true;
        clearSelectionBtn.disabled = true;
        document.getElementById('userPreview').classList.add('hidden');
        document.getElementById('userDataContainer').classList.add('hidden');
    });
});

function updateUserPreview(option) {
    const preview = document.getElementById('userPreview');
    const avatar = document.getElementById('userAvatar');

    document.getElementById('userName').textContent = option.dataset.username;
    document.getElementById('userId').textContent = `ID: ${option.value}`;

    if (option.dataset.avatar) {
        avatar.innerHTML = `<img src="https://cdn.discordapp.com/avatars/${option.value}/${option.dataset.avatar}.png" class="w-full h-full object-cover" alt="Avatar">`;
    }

    preview.classList.remove('hidden');
}

async function loadUserData(userId) {
    if (!userId) return;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/users/${userId}/data`);
        const data = await response.json();

        if (response.ok) {
            populateUserData(data);
            document.getElementById('userDataContainer').classList.remove('hidden');
            showToast('success', 'User data loaded');
        } else {
            throw new Error(data.message || 'Failed to load');
        }
    } catch (error) {
        showToast('error', 'Failed to load user data');
    }
}

function populateUserData(data) {
    // Overview
    document.getElementById('overviewLevel').textContent = data.xp?.level || 0;
    document.getElementById('overviewXP').textContent = (data.xp?.xp || 0).toLocaleString();
    document.getElementById('overviewReputation').textContent = (data.reputation?.reputation || 0).toLocaleString();
    document.getElementById('overviewNetWorth').textContent = ((data.economy?.wallet || 0) + (data.economy?.bank || 0)).toLocaleString();

    // XP
    const level = data.xp?.level || 0;
    const xp = data.xp?.xp || 0;
    const nextLevel = level + 1;
    const requiredXP = Math.floor(100 * Math.pow(nextLevel, 1.5));
    const progressXP = xp % requiredXP;
    const progress = (progressXP / requiredXP) * 100;

    document.getElementById('currentLevel').textContent = level;
    document.getElementById('currentXP').textContent = xp.toLocaleString();
    document.getElementById('nextLevel').textContent = nextLevel;
    document.getElementById('progressXP').textContent = progressXP.toLocaleString();
    document.getElementById('requiredXP').textContent = requiredXP.toLocaleString();
    document.getElementById('xpProgressBar').style.width = `${progress}%`;
    document.getElementById('xpProgressBar').textContent = `${Math.round(progress)}%`;
    document.getElementById('totalMessages').textContent = (data.xp?.messages || 0).toLocaleString();
    document.getElementById('voiceMinutes').textContent = (data.xp?.voice_minutes || 0).toLocaleString();

    // Reputation
    document.getElementById('totalReputation').textContent = (data.reputation?.reputation || 0).toLocaleString();
    document.getElementById('reputationGiven').textContent = (data.reputation?.given || 0).toLocaleString();
    document.getElementById('reputationReceived').textContent = (data.reputation?.received || 0).toLocaleString();

    // Economy
    const wallet = data.economy?.wallet || 0;
    const bank = data.economy?.bank || 0;
    document.getElementById('walletBalance').textContent = wallet.toLocaleString();
    document.getElementById('bankBalance').textContent = bank.toLocaleString();
    document.getElementById('netWorth').textContent = (wallet + bank).toLocaleString();
}

// Form handlers
document.getElementById('xpManagementForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!selectedUserId) return;

    const xp = document.getElementById('setXPInput').value;
    const level = document.getElementById('setLevelInput').value;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/users/${selectedUserId}/xp`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ xp: xp ? parseInt(xp) : null, level: level ? parseInt(level) : null })
        });

        if (response.ok) {
            showToast('success', 'XP updated');
            loadUserData(selectedUserId);
        } else throw new Error('Failed');
    } catch (error) {
        showToast('error', 'Failed to update XP');
    }
});

document.getElementById('reputationManagementForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!selectedUserId) return;

    const reputation = document.getElementById('setReputationInput').value;
    if (!reputation) return showToast('error', 'Enter a value');

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/users/${selectedUserId}/reputation`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reputation: parseInt(reputation) })
        });

        if (response.ok) {
            showToast('success', 'Reputation updated');
            loadUserData(selectedUserId);
        } else throw new Error('Failed');
    } catch (error) {
        showToast('error', 'Failed to update reputation');
    }
});

document.getElementById('economyManagementForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!selectedUserId) return;

    const amount = document.getElementById('currencyAmount').value;
    const target = document.getElementById('currencyTarget').value;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/users/${selectedUserId}/economy`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount: parseInt(amount), target })
        });

        if (response.ok) {
            showToast('success', 'Balance updated');
            loadUserData(selectedUserId);
        } else throw new Error('Failed');
    } catch (error) {
        showToast('error', 'Failed to update balance');
    }
});

async function resetUserXP() {
    if (!selectedUserId || !confirm('Reset XP for this user?')) return;
    try {
        await fetch(`/api/guilds/<%= guildId %>/users/${selectedUserId}/xp/reset`, { method: 'POST' });
        showToast('success', 'XP reset');
        loadUserData(selectedUserId);
    } catch (error) {
        showToast('error', 'Failed to reset XP');
    }
}

async function resetUserReputation() {
    if (!selectedUserId || !confirm('Reset reputation for this user?')) return;
    try {
        await fetch(`/api/guilds/<%= guildId %>/users/${selectedUserId}/reputation/reset`, { method: 'POST' });
        showToast('success', 'Reputation reset');
        loadUserData(selectedUserId);
    } catch (error) {
        showToast('error', 'Failed to reset reputation');
    }
}

async function resetUserEconomy() {
    if (!selectedUserId || !confirm('Reset economy for this user?')) return;
    try {
        await fetch(`/api/guilds/<%= guildId %>/users/${selectedUserId}/economy/reset`, { method: 'POST' });
        showToast('success', 'Economy reset');
        loadUserData(selectedUserId);
    } catch (error) {
        showToast('error', 'Failed to reset economy');
    }
}

function openBulkActionsModal() {
    document.getElementById('bulk-actions-modal').classList.remove('hidden');
}

function closeBulkActionsModal() {
    document.getElementById('bulk-actions-modal').classList.add('hidden');
}

async function bulkResetXP() {
    if (prompt('Type "CONFIRM" to reset ALL users XP:') !== 'CONFIRM') return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/bulk/xp/reset`, { method: 'POST' });
        const data = await response.json();
        showToast('success', `Reset XP for ${data.count} users`);
        closeBulkActionsModal();
    } catch (error) {
        showToast('error', 'Failed to bulk reset XP');
    }
}

async function bulkResetReputation() {
    if (prompt('Type "CONFIRM" to reset ALL users reputation:') !== 'CONFIRM') return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/bulk/reputation/reset`, { method: 'POST' });
        const data = await response.json();
        showToast('success', `Reset reputation for ${data.count} users`);
        closeBulkActionsModal();
    } catch (error) {
        showToast('error', 'Failed to bulk reset reputation');
    }
}

async function bulkResetEconomy() {
    if (prompt('Type "CONFIRM" to reset ALL users economy:') !== 'CONFIRM') return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/bulk/economy/reset`, { method: 'POST' });
        const data = await response.json();
        showToast('success', `Reset economy for ${data.count} users`);
        closeBulkActionsModal();
    } catch (error) {
        showToast('error', 'Failed to bulk reset economy');
    }
}

async function exportUserData() {
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/bulk/export`);
        const blob = await response.blob();

        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `user-data-<%= guildId %>-${Date.now()}.csv`;
        a.click();
        window.URL.revokeObjectURL(url);

        showToast('success', 'User data exported');
        closeBulkActionsModal();
    } catch (error) {
        showToast('error', 'Failed to export user data');
    }
}
</script>
