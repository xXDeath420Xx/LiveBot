<%# Time Capsules - Tailwind Version %>

<div class="space-y-6">
    <!-- Header -->
    <div class="card">
        <div class="flex items-center gap-3">
            <div class="p-2 bg-primary-500/10 rounded-lg">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">Time Capsules</h3>
                <p class="text-sm text-gray-400">View scheduled time capsules for this server</p>
            </div>
        </div>
    </div>

    <!-- Upcoming Time Capsules -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Upcoming Time Capsules
        </h3>
        <div id="upcoming-capsules" class="space-y-4">
            <div class="text-center py-8 text-gray-400">Loading...</div>
        </div>
    </div>

    <!-- Recently Revealed -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
            </svg>
            Recently Revealed
        </h3>
        <div id="revealed-capsules" class="space-y-4">
            <div class="text-center py-8 text-gray-400">Loading...</div>
        </div>
    </div>

    <!-- How It Works -->
    <div class="card bg-gradient-to-r from-primary-500/10 to-primary-500/5 border-primary-500/30">
        <div class="flex gap-4">
            <div class="flex-shrink-0">
                <div class="w-12 h-12 rounded-lg bg-primary-500/20 flex items-center justify-center text-2xl">
                    ⏰
                </div>
            </div>
            <div>
                <h4 class="font-semibold text-white mb-2">How Time Capsules Work</h4>
                <ul class="text-sm text-gray-300 space-y-1.5">
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">1.</span>
                        Users create capsules with <code class="bg-dark-700 px-1.5 py-0.5 rounded text-primary-400">/timecapsule</code>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">2.</span>
                        Messages are sealed until the reveal date
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-primary-400">3.</span>
                        On the reveal date, the capsule is opened and the message is shared
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
function formatCountdown(revealDate) {
    const now = new Date();
    const reveal = new Date(revealDate);
    const diff = reveal - now;

    if (diff <= 0) return 'Ready to reveal';

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

    if (days > 0) return `${days}d ${hours}h remaining`;
    if (hours > 0) return `${hours}h ${minutes}m remaining`;
    return `${minutes}m remaining`;
}

async function loadTimeCapsules() {
    try {
        const response = await fetch('/api/guilds/<%= guildId %>/timecapsules');
        const data = await response.json();

        const upcomingEl = document.getElementById('upcoming-capsules');
        const revealedEl = document.getElementById('revealed-capsules');

        if (!data.capsules || data.capsules.length === 0) {
            upcomingEl.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-dark-600 flex items-center justify-center text-2xl">📭</div>
                    <p class="text-gray-400">No upcoming time capsules</p>
                </div>
            `;
            revealedEl.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-dark-600 flex items-center justify-center text-2xl">📦</div>
                    <p class="text-gray-400">No revealed capsules yet</p>
                </div>
            `;
            return;
        }

        const now = new Date();
        const upcoming = data.capsules.filter(c => !c.revealed && new Date(c.reveal_date) > now);
        const revealed = data.capsules.filter(c => c.revealed);

        // Upcoming capsules
        if (upcoming.length > 0) {
            upcomingEl.innerHTML = upcoming.map(capsule => {
                const revealDate = new Date(capsule.reveal_date);
                const createdDate = new Date(capsule.created_at);

                return `
                    <div class="p-4 bg-dark-700 rounded-lg border-l-4 border-accent-yellow">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <span class="text-xl">📧</span>
                                <span class="font-semibold text-white">Time Capsule #${capsule.id}</span>
                            </div>
                            <span class="px-2 py-1 text-xs font-medium rounded-full bg-accent-yellow text-black">PENDING</span>
                        </div>
                        <div class="p-3 bg-dark-600 rounded-lg mb-3 italic text-gray-300">"${escapeHtml(capsule.message)}"</div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-xs text-gray-400">
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                User ${capsule.user_id.substring(0, 8)}...
                            </div>
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                Created ${createdDate.toLocaleDateString()}
                            </div>
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Reveals ${revealDate.toLocaleDateString()}
                            </div>
                            <div class="flex items-center gap-1 text-primary-400 font-medium countdown">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                ${formatCountdown(capsule.reveal_date)}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } else {
            upcomingEl.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-dark-600 flex items-center justify-center text-2xl">📭</div>
                    <p class="text-gray-400">No upcoming time capsules</p>
                </div>
            `;
        }

        // Revealed capsules
        if (revealed.length > 0) {
            revealedEl.innerHTML = revealed.map(capsule => {
                const revealDate = new Date(capsule.reveal_date);
                const createdDate = new Date(capsule.created_at);

                return `
                    <div class="p-4 bg-dark-700 rounded-lg border-l-4 border-accent-green opacity-80">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-2">
                                <span class="text-xl">📦</span>
                                <span class="font-semibold text-white">Time Capsule #${capsule.id}</span>
                            </div>
                            <span class="px-2 py-1 text-xs font-medium rounded-full bg-accent-green text-white">REVEALED</span>
                        </div>
                        <div class="p-3 bg-dark-600 rounded-lg mb-3 italic text-gray-300">"${escapeHtml(capsule.message)}"</div>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-xs text-gray-400">
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                User ${capsule.user_id.substring(0, 8)}...
                            </div>
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                Created ${createdDate.toLocaleDateString()}
                            </div>
                            <div class="flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Revealed ${revealDate.toLocaleDateString()}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } else {
            revealedEl.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-dark-600 flex items-center justify-center text-2xl">📦</div>
                    <p class="text-gray-400">No revealed capsules yet</p>
                </div>
            `;
        }

    } catch (error) {
        console.error('Error loading time capsules:', error);
        document.getElementById('upcoming-capsules').innerHTML = '<div class="text-center py-8 text-accent-red">Error loading data</div>';
    }
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

loadTimeCapsules();

// Refresh countdown every minute
setInterval(() => {
    document.querySelectorAll('.countdown').forEach(el => {
        // Re-fetch would be better but this updates the visual
        loadTimeCapsules();
    });
}, 60000);
</script>
