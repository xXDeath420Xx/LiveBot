<%# Moderation Settings - Tailwind Version %>

<div class="space-y-6">
    <!-- Moderation Config Card -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Moderation Settings</h3>
                <p class="text-sm text-gray-400">Configure moderation logging and actions</p>
            </div>
            <%- include('../../components/forms/toggle', {
                name: 'mod_enabled',
                id: 'mod_enabled',
                checked: locals.modConfig?.enabled || false,
                label: 'Enable Moderation',
                size: 'md'
            }) %>
        </div>

        <form id="moderation-form" action="/api/guilds/<%= guildId %>/moderation/config" method="PUT" data-track-changes>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Mod Log Channel -->
                <div class="form-group">
                    <label class="form-label">Moderation Log Channel</label>
                    <%- include('../../components/forms/channelSelect', {
                        name: 'mod_log_channel_id',
                        channels: Array.from(channels.values()),
                        selected: locals.modConfig?.mod_log_channel_id,
                        placeholder: 'Select a channel for mod logs'
                    }) %>
                    <p class="form-hint">All moderation actions will be logged here</p>
                </div>

                <!-- Mute Role -->
                <div class="form-group">
                    <label class="form-label">Mute Role</label>
                    <%- include('../../components/forms/roleSelect', {
                        name: 'mute_role_id',
                        roles: Array.from(roles.values()),
                        selected: locals.modConfig?.mute_role_id,
                        placeholder: 'Select the mute role'
                    }) %>
                    <p class="form-hint">Role applied to muted members</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <!-- Auto Delete Commands -->
                <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                    <div>
                        <p class="font-medium text-white">Auto Delete Commands</p>
                        <p class="text-sm text-gray-400">Delete mod command messages after execution</p>
                    </div>
                    <%- include('../../components/forms/toggle', {
                        name: 'auto_delete_commands',
                        checked: locals.modConfig?.auto_delete_commands || false,
                        size: 'sm'
                    }) %>
                </div>

                <!-- DM on Action -->
                <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                    <div>
                        <p class="font-medium text-white">DM on Action</p>
                        <p class="text-sm text-gray-400">Send DM to users when action is taken</p>
                    </div>
                    <%- include('../../components/forms/toggle', {
                        name: 'dm_on_action',
                        checked: locals.modConfig?.dm_on_action !== false,
                        size: 'sm'
                    }) %>
                </div>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Settings
                </button>
            </div>
        </form>
    </div>

    <!-- Recent Infractions -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Recent Infractions</h3>
                <p class="text-sm text-gray-400">Latest moderation actions in your server</p>
            </div>
            <a href="/manage/<%= guildId %>?section=infractions" class="btn btn-secondary btn-sm">
                View All
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="data-table w-full">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Action</th>
                        <th>Reason</th>
                        <th>Moderator</th>
                        <th>Date</th>
                        <th class="w-20"></th>
                    </tr>
                </thead>
                <tbody>
                    <% if (locals.infractions && locals.infractions.length > 0) { %>
                        <% locals.infractions.slice(0, 10).forEach(inf => { %>
                        <tr>
                            <td>
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-full bg-dark-500 flex items-center justify-center">
                                        <span class="text-xs"><%= (inf.username || 'U').charAt(0) %></span>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-white"><%= inf.username || 'Unknown' %></p>
                                        <p class="text-xs text-gray-500"><%= inf.user_id %></p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <% const actionColors = {
                                    'warn': 'badge-warning',
                                    'mute': 'badge-info',
                                    'kick': 'badge-warning',
                                    'ban': 'badge-danger',
                                    'timeout': 'badge-info'
                                }; %>
                                <span class="badge <%= actionColors[inf.action] || 'badge-info' %>">
                                    <%= inf.action.toUpperCase() %>
                                </span>
                            </td>
                            <td class="max-w-xs truncate text-sm text-gray-400">
                                <%= inf.reason || 'No reason provided' %>
                            </td>
                            <td class="text-sm text-gray-400">
                                <%= inf.moderator_name || 'System' %>
                            </td>
                            <td class="text-sm text-gray-500">
                                <%= new Date(inf.timestamp).toLocaleDateString() %>
                            </td>
                            <td>
                                <button
                                    type="button"
                                    class="p-1.5 rounded hover:bg-dark-400 text-gray-400 hover:text-accent-red transition-colors"
                                    title="Delete"
                                    onclick="deleteInfraction(<%= inf.id %>)"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-8">
                                <div class="empty-state">
                                    <svg class="empty-state-icon mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    <p class="empty-state-title">No Infractions</p>
                                    <p class="empty-state-text">Your server has no moderation history yet</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- AutoMod Quick Settings -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">AutoMod Quick Settings</h3>
                <p class="text-sm text-gray-400">Enable automatic moderation features</p>
            </div>
            <a href="/manage/<%= guildId %>?section=automod" class="text-primary-400 hover:text-primary-300 text-sm transition-colors">
                Advanced Settings →
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-red/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Anti-Spam</p>
                        <p class="text-xs text-gray-500">Block repeated messages</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'anti_spam',
                    checked: locals.automodConfig?.anti_spam || false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-primary-500/10 rounded-lg">
                        <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Anti-Links</p>
                        <p class="text-xs text-gray-500">Block external links</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'anti_links',
                    checked: locals.automodConfig?.anti_links || false,
                    size: 'sm'
                }) %>
            </div>

            <div class="flex items-center justify-between p-4 bg-dark-700 rounded-lg">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-accent-purple/10 rounded-lg">
                        <svg class="w-5 h-5 text-accent-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-medium text-white">Anti-Invites</p>
                        <p class="text-xs text-gray-500">Block Discord invites</p>
                    </div>
                </div>
                <%- include('../../components/forms/toggle', {
                    name: 'anti_invites',
                    checked: locals.automodConfig?.anti_invites || false,
                    size: 'sm'
                }) %>
            </div>
        </div>
    </div>
</div>

<script>
async function deleteInfraction(id) {
    if (!confirm('Are you sure you want to delete this infraction?')) return;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/moderation/infractions/${id}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            showToast('success', 'Infraction deleted');
            location.reload();
        } else {
            throw new Error('Failed to delete');
        }
    } catch (error) {
        showToast('error', 'Failed to delete infraction');
    }
}

// Form submission handler
document.getElementById('moderation-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const data = {};
    formData.forEach((value, key) => {
        data[key] = value === 'on' ? true : value;
    });

    try {
        const response = await fetch(this.action, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', 'Moderation settings saved');
            this.dataset.changed = 'false';
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save settings');
    }
});
</script>
