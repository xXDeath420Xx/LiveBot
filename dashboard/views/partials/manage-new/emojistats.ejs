<%# Emoji Statistics - Tailwind Version %>

<div class="space-y-6">
    <!-- Header with Period Selector -->
    <div class="card">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-accent-yellow/10 rounded-lg">
                    <svg class="w-5 h-5 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">Emoji Statistics</h3>
                    <p class="text-sm text-gray-400">Track emoji usage across your server</p>
                </div>
            </div>
            <select id="emoji-period-select" class="form-input w-40" onchange="loadEmojiStats()">
                <option value="7d">Last 7 Days</option>
                <option value="30d">Last 30 Days</option>
                <option value="90d">Last 90 Days</option>
            </select>
        </div>
    </div>

    <!-- Stats Summary -->
    <div id="emoji-summary" class="grid grid-cols-3 gap-4">
        <div class="card text-center py-4">
            <div id="stat-total-uses" class="text-3xl font-bold text-accent-yellow mb-1">-</div>
            <div class="text-sm text-gray-400">Total Emoji Uses</div>
        </div>
        <div class="card text-center py-4">
            <div id="stat-unique-emojis" class="text-3xl font-bold text-primary-400 mb-1">-</div>
            <div class="text-sm text-gray-400">Unique Emojis</div>
        </div>
        <div class="card text-center py-4">
            <div id="stat-active-users" class="text-3xl font-bold text-accent-green mb-1">-</div>
            <div class="text-sm text-gray-400">Active Users</div>
        </div>
    </div>

    <!-- Most Used Emojis -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-yellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
            </svg>
            Most Used Emojis
        </h3>
        <div id="top-emojis" class="space-y-2">
            <div class="text-center py-8 text-gray-400">Loading...</div>
        </div>
    </div>

    <!-- Top Emoji Users -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Top Emoji Users
        </h3>
        <div id="top-emoji-users" class="space-y-2">
            <div class="text-center py-8 text-gray-400">Loading...</div>
        </div>
    </div>

    <!-- Emoji Trends -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
            Daily Emoji Usage
        </h3>
        <div id="emoji-trends" class="space-y-2">
            <div class="text-center py-8 text-gray-400">Loading...</div>
        </div>
    </div>
</div>

<script>
async function loadEmojiStats() {
    const period = document.getElementById('emoji-period-select').value;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/emojistats?period=${period}`);
        const data = await response.json();

        // Update summary stats
        const totalUses = data.topEmojis?.reduce((sum, e) => sum + e.use_count, 0) || 0;
        document.getElementById('stat-total-uses').textContent = totalUses.toLocaleString();
        document.getElementById('stat-unique-emojis').textContent = data.topEmojis?.length || 0;
        document.getElementById('stat-active-users').textContent = data.topUsers?.length || 0;

        // Top emojis
        const emojisEl = document.getElementById('top-emojis');
        if (data.topEmojis && data.topEmojis.length > 0) {
            const maxCount = Math.max(...data.topEmojis.map(e => e.use_count));
            emojisEl.innerHTML = data.topEmojis.slice(0, 10).map((emoji, index) => `
                <div class="flex items-center justify-between p-3 bg-dark-700 rounded-lg hover:bg-dark-600 transition-colors">
                    <div class="flex items-center gap-3">
                        <span class="text-lg font-bold ${index < 3 ? 'text-accent-yellow' : 'text-gray-500'} w-8">
                            ${index === 0 ? '1st' : index === 1 ? '2nd' : index === 2 ? '3rd' : '#' + (index + 1)}
                        </span>
                        <span class="text-2xl">${emoji.emoji}</span>
                        <span class="text-gray-400">${emoji.emoji_name || 'Unknown'}</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-32 h-2 bg-dark-500 rounded-full overflow-hidden">
                            <div class="h-full bg-accent-yellow rounded-full" style="width: ${(emoji.use_count / maxCount) * 100}%"></div>
                        </div>
                        <span class="text-primary-400 font-semibold w-24 text-right">${emoji.use_count.toLocaleString()} uses</span>
                    </div>
                </div>
            `).join('');
        } else {
            emojisEl.innerHTML = `
                <div class="text-center py-8">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-dark-600 flex items-center justify-center text-2xl">:)</div>
                    <p class="text-gray-400">No emoji data available</p>
                </div>
            `;
        }

        // Top emoji users
        const usersEl = document.getElementById('top-emoji-users');
        if (data.topUsers && data.topUsers.length > 0) {
            usersEl.innerHTML = data.topUsers.slice(0, 10).map((user, index) => `
                <div class="flex items-center justify-between p-3 bg-dark-700 rounded-lg hover:bg-dark-600 transition-colors">
                    <div class="flex items-center gap-3">
                        <span class="text-lg font-bold ${index < 3 ? 'text-primary-400' : 'text-gray-500'} w-8">
                            ${index === 0 ? '1st' : index === 1 ? '2nd' : index === 2 ? '3rd' : '#' + (index + 1)}
                        </span>
                        <code class="text-sm text-gray-400">${user.user_id}</code>
                    </div>
                    <span class="text-accent-green font-semibold">${user.total_emoji_uses.toLocaleString()} emojis</span>
                </div>
            `).join('');
        } else {
            usersEl.innerHTML = `
                <div class="text-center py-8">
                    <p class="text-gray-400">No user data available</p>
                </div>
            `;
        }

        // Emoji trends
        const trendsEl = document.getElementById('emoji-trends');
        if (data.trends && data.trends.length > 0) {
            const maxCount = Math.max(...data.trends.map(t => t.count));
            trendsEl.innerHTML = data.trends.map(trend => `
                <div class="p-3 bg-dark-700 rounded-lg">
                    <div class="flex justify-between mb-2">
                        <span class="text-gray-400">${new Date(trend.date).toLocaleDateString()}</span>
                        <span class="text-primary-400 font-semibold">${trend.count.toLocaleString()} emojis</span>
                    </div>
                    <div class="h-2 bg-dark-500 rounded-full overflow-hidden">
                        <div class="h-full bg-primary-500 rounded-full transition-all duration-300" style="width: ${(trend.count / maxCount) * 100}%"></div>
                    </div>
                </div>
            `).join('');
        } else {
            trendsEl.innerHTML = `
                <div class="text-center py-8">
                    <p class="text-gray-400">No trend data available</p>
                </div>
            `;
        }

    } catch (error) {
        console.error('Error loading emoji stats:', error);
        document.getElementById('top-emojis').innerHTML = '<div class="text-center py-8 text-accent-red">Error loading data</div>';
    }
}

loadEmojiStats();
</script>
