<%# Fourthwall Integration - Tailwind Version %>

<div class="space-y-6">

    <!-- Connected shops -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Connected shops</h3>
                <p class="text-sm text-gray-400">Fourthwall shops posting real-time order, donation, membership, and giveaway alerts to this server.</p>
            </div>
        </div>

        <div id="fw-connections-wrap">
            <div class="text-center text-gray-400 py-8">Loading…</div>
        </div>
    </div>

    <!-- Add shop -->
    <div class="card">
        <div class="mb-4">
            <h3 class="text-lg font-semibold text-white">Add shop</h3>
            <p class="text-sm text-gray-400">Connect a Fourthwall shop using its API credentials.</p>
        </div>

        <form id="fw-add-form" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Shop handle</label>
                    <input name="handle" required pattern="[a-zA-Z0-9-]{1,100}"
                           placeholder="my-shop-handle"
                           class="input w-full">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">Storefront token <span class="text-gray-500">(optional)</span></label>
                    <input name="storefrontToken"
                           placeholder="Leave blank if not needed"
                           class="input w-full">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">API username</label>
                    <input name="apiUser" required autocomplete="off"
                           placeholder="API username"
                           class="input w-full">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-1">API password</label>
                    <input type="password" name="apiPass" required autocomplete="new-password"
                           placeholder="API password"
                           class="input w-full">
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button type="submit" class="btn btn-primary">Connect shop</button>
                <span id="fw-add-status" class="text-sm"></span>
            </div>
        </form>
    </div>

    <!-- Privacy & defaults -->
    <div class="card">
        <div class="mb-4">
            <h3 class="text-lg font-semibold text-white">Privacy &amp; defaults</h3>
            <p class="text-sm text-gray-400">Control what customer data appears in announcements and set a fallback channel.</p>
        </div>

        <form id="fw-config-form" class="space-y-4">
            <div class="space-y-3">
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="show_customer_names" class="rounded border-gray-600 bg-gray-700 text-accent-primary">
                    <span class="text-sm text-gray-300">Show real customer names in announcements</span>
                </label>
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="show_amounts" class="rounded border-gray-600 bg-gray-700 text-accent-primary">
                    <span class="text-sm text-gray-300">Show monetary amounts in announcements</span>
                </label>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Default channel ID <span class="text-gray-500">(fallback when no per-category channel is set)</span></label>
                <input name="default_channel_id" pattern="\d{17,20}"
                       placeholder="e.g. 1234567890123456789"
                       class="input w-full md:w-72">
            </div>
            <div class="flex items-center gap-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <span id="fw-config-status" class="text-sm"></span>
            </div>
        </form>
    </div>

</div>

<script>
(function () {
    const guildId = '<%= guildId %>';
    const base = '/api/guilds/' + guildId + '/fourthwall';

    // ── helpers ──────────────────────────────────────────────
    function el(tag, cls) {
        const e = document.createElement(tag);
        if (cls) e.className = cls;
        return e;
    }
    function td(text, cls) {
        const c = el('td', cls);
        c.textContent = (text == null || text === '') ? '—' : String(text);
        return c;
    }
    function setStatus(id, msg, ok) {
        const s = document.getElementById(id);
        if (!s) return;
        s.textContent = msg;
        s.className = 'text-sm ' + (ok === false ? 'text-red-400' : ok ? 'text-green-400' : 'text-gray-400');
    }

    // ── render connections ────────────────────────────────────
    async function renderConnections() {
        const wrap = document.getElementById('fw-connections-wrap');
        if (!wrap) return;

        let data;
        try {
            data = await fetch(base + '/connections').then(r => r.json());
        } catch (e) {
            wrap.textContent = 'Failed to load connections.';
            return;
        }

        const conns = data.connections || [];

        if (conns.length === 0) {
            const empty = el('div', 'text-center text-gray-500 py-10');
            const svg = el('div', 'text-4xl mb-3 opacity-30');
            svg.textContent = '🛒';
            const p = el('p', 'text-sm');
            p.textContent = 'No shops connected yet. Add one below.';
            empty.appendChild(svg);
            empty.appendChild(p);
            while (wrap.firstChild) wrap.removeChild(wrap.firstChild);
            wrap.appendChild(empty);
            return;
        }

        const tableWrap = el('div', 'overflow-x-auto');
        const tbl = el('table', 'data-table w-full');
        const thead = el('thead');
        const headerRow = el('tr');
        for (const h of ['Handle', 'Shop name', 'Last event', 'Connected', '']) {
            const th = el('th');
            th.textContent = h;
            headerRow.appendChild(th);
        }
        thead.appendChild(headerRow);
        tbl.appendChild(thead);

        const tbody = el('tbody');
        for (const c of conns) {
            const tr = el('tr');
            tr.appendChild(td(c.shop_handle));
            tr.appendChild(td(c.shop_name));
            tr.appendChild(td(c.last_event_at ? new Date(c.last_event_at).toLocaleString() : null));
            tr.appendChild(td(c.connected_at ? new Date(c.connected_at).toLocaleString() : null));

            const actTd = el('td', 'text-right');
            const btn = el('button', 'btn btn-danger-sm text-xs');
            btn.textContent = 'Disconnect';
            const connId = c.id;
            btn.onclick = async () => {
                if (!confirm('Disconnect ' + c.shop_handle + '? Webhook registrations will be removed.')) return;
                btn.disabled = true;
                btn.textContent = 'Removing…';
                try {
                    const r = await fetch(base + '/connections/' + connId, { method: 'DELETE' }).then(x => x.json());
                    if (r.ok) {
                        renderConnections();
                    } else {
                        btn.disabled = false;
                        btn.textContent = 'Disconnect';
                        alert('Error: ' + (r.error || 'unknown'));
                    }
                } catch (e) {
                    btn.disabled = false;
                    btn.textContent = 'Disconnect';
                    alert('Request failed');
                }
            };
            actTd.appendChild(btn);
            tr.appendChild(actTd);
            tbody.appendChild(tr);
        }
        tbl.appendChild(tbody);
        tableWrap.appendChild(tbl);
        while (wrap.firstChild) wrap.removeChild(wrap.firstChild);
        wrap.appendChild(tableWrap);
    }

    // ── add shop form ─────────────────────────────────────────
    document.getElementById('fw-add-form').onsubmit = async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const body = Object.fromEntries(fd.entries());
        setStatus('fw-add-status', 'Connecting…');
        try {
            const r = await fetch(base + '/connections', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(x => x.json());
            if (r.ok) {
                setStatus('fw-add-status', 'Connected (' + (r.registeredEvents || 0) + ' webhook(s) registered).', true);
                e.target.reset();
                renderConnections();
            } else {
                setStatus('fw-add-status', 'Error: ' + (r.error || 'unknown'), false);
            }
        } catch (err) {
            setStatus('fw-add-status', 'Request failed', false);
        }
    };

    // ── config form ───────────────────────────────────────────
    async function loadConfig() {
        try {
            const data = await fetch(base + '/config').then(r => r.json());
            const cfg = data.config || {};
            const form = document.getElementById('fw-config-form');
            if (!form) return;
            form.querySelector('[name=show_customer_names]').checked = !!cfg.show_customer_names;
            form.querySelector('[name=show_amounts]').checked = !!cfg.show_amounts;
            form.querySelector('[name=default_channel_id]').value = cfg.default_channel_id || '';
        } catch (e) {
            // non-fatal — user can still save
        }
    }

    document.getElementById('fw-config-form').onsubmit = async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const body = {
            show_customer_names: fd.get('show_customer_names') ? 1 : 0,
            show_amounts: fd.get('show_amounts') ? 1 : 0,
            default_channel_id: fd.get('default_channel_id') || null
        };
        setStatus('fw-config-status', 'Saving…');
        try {
            const r = await fetch(base + '/config', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(x => x.json());
            if (r.ok) {
                setStatus('fw-config-status', 'Saved.', true);
            } else {
                setStatus('fw-config-status', 'Error: ' + (r.error || 'unknown'), false);
            }
        } catch (err) {
            setStatus('fw-config-status', 'Request failed', false);
        }
    };

    // ── init ──────────────────────────────────────────────────
    renderConnections();
    loadConfig();
}());
</script>
