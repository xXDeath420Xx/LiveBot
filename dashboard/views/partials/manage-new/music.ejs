<%# Music System - Tailwind Version %>

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Songs Played',
            value: locals.musicStats?.total_songs || 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Total Playtime',
            value: locals.musicStats?.total_playtime || '0h',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'success'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Active Playlists',
            value: locals.musicStats?.playlists || 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>',
            color: 'info'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Status',
            value: locals.musicConfig?.enabled ? 'Enabled' : 'Disabled',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: locals.musicConfig?.enabled ? 'success' : 'secondary'
        }) %>
    </div>

    <!-- General Settings -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-primary-500/10 rounded-lg">
                    <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">General Music Settings</h3>
                    <p class="text-sm text-gray-400">Configure basic music functionality</p>
                </div>
            </div>
            <%- include('../../components/forms/toggle', {
                name: 'music_enabled',
                id: 'music_enabled',
                checked: locals.musicConfig?.enabled || false,
                label: 'Enable Music',
                size: 'md'
            }) %>
        </div>

        <form id="music-form" action="/api/guilds/<%= guildId %>/music/config" method="PUT">
            <div class="form-group">
                <label class="form-label">DJ Role</label>
                <%- include('../../components/forms/roleSelect', {
                    name: 'dj_role_id',
                    roles: Array.from(roles.values()),
                    selected: locals.musicConfig?.dj_role_id,
                    placeholder: 'No DJ role required'
                }) %>
                <p class="form-hint">Users with this role can bypass music command restrictions</p>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save General Settings
                </button>
            </div>
        </form>
    </div>

    <!-- AI DJ Settings -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-purple-500/10 rounded-lg">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">AI DJ</h3>
                    <p class="text-sm text-gray-400">Bot announces tracks like a radio DJ</p>
                </div>
            </div>
            <%- include('../../components/forms/toggle', {
                name: 'dj_enabled',
                id: 'dj_enabled',
                checked: locals.musicConfig?.dj_enabled || false,
                label: 'Enable AI DJ',
                size: 'md'
            }) %>
        </div>

        <form id="dj-form" action="/api/guilds/<%= guildId %>/music/dj" method="PUT">
            <div class="form-group">
                <label class="form-label">DJ Voice</label>
                <select name="dj_voice" class="form-input w-full md:w-1/2">
                    <% if (locals.availableDJVoices && availableDJVoices.length > 0) { %>
                        <% const voicesByCategory = {};
                           availableDJVoices.forEach(voice => {
                               if (!voicesByCategory[voice.category]) voicesByCategory[voice.category] = [];
                               voicesByCategory[voice.category].push(voice);
                           });
                        %>
                        <% Object.keys(voicesByCategory).sort().forEach(category => { %>
                            <optgroup label="<%= category %>">
                                <% voicesByCategory[category].forEach(voice => { %>
                                    <option value="<%= voice.value %>" <%= locals.musicConfig?.dj_voice === voice.value ? 'selected' : '' %>><%= voice.label %></option>
                                <% }) %>
                            </optgroup>
                        <% }) %>
                    <% } else { %>
                        <option value="female">Female (Default)</option>
                        <option value="male">Male (Default)</option>
                    <% } %>
                </select>
                <p class="form-hint">Choose the voice personality for your AI DJ</p>
            </div>

            <div class="flex items-center gap-4 mt-4">
                <button type="button" id="preview-voice-btn" class="btn btn-secondary" onclick="previewVoice()">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
                    </svg>
                    Preview Voice
                </button>
                <span id="preview-status" class="text-sm text-gray-400"></span>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">Save DJ Settings</button>
            </div>
        </form>
    </div>

    <!-- Advanced Features -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4">Advanced Features</h3>
        <form id="advanced-form" action="/api/guilds/<%= guildId %>/music/advanced" method="PUT">
            <div class="space-y-4">
                <!-- 24/7 Mode -->
                <div class="p-4 bg-dark-700 rounded-lg">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="twenty_four_seven" id="twenty_four_seven" class="form-checkbox" <%= locals.musicConfig?.twenty_four_seven ? 'checked' : '' %>>
                        <div>
                            <span class="text-white font-medium flex items-center gap-2">
                                <span class="text-primary-400">∞</span> 24/7 Mode
                            </span>
                            <p class="text-xs text-gray-500">Bot stays in voice channel even when queue is empty</p>
                        </div>
                    </label>
                </div>

                <!-- Autoplay -->
                <div class="p-4 bg-dark-700 rounded-lg">
                    <label class="flex items-center gap-3 cursor-pointer mb-3">
                        <input type="checkbox" name="autoplay_enabled" id="autoplay_enabled" class="form-checkbox" <%= locals.musicConfig?.autoplay_enabled ? 'checked' : '' %>>
                        <div>
                            <span class="text-white font-medium flex items-center gap-2">
                                <span class="text-accent-green">🔀</span> Autoplay
                            </span>
                            <p class="text-xs text-gray-500">Automatically play similar songs when queue ends</p>
                        </div>
                    </label>
                    <div class="ml-8">
                        <label class="form-label">Autoplay Source</label>
                        <select name="autoplay_source" class="form-input w-48">
                            <option value="youtube" <%= locals.musicConfig?.autoplay_source === 'youtube' ? 'selected' : '' %>>YouTube (Similar)</option>
                            <option value="ai" <%= locals.musicConfig?.autoplay_source === 'ai' ? 'selected' : '' %>>AI Recommendations</option>
                        </select>
                    </div>
                </div>

                <!-- Song Request Channel -->
                <div class="p-4 bg-dark-700 rounded-lg">
                    <label class="form-label flex items-center gap-2">
                        <span class="text-info">#</span> Song Request Channel
                    </label>
                    <%- include('../../components/forms/channelSelect', {
                        name: 'request_channel_id',
                        channels: Array.from(channels.values()),
                        selected: locals.musicConfig?.request_channel_id,
                        placeholder: 'Disabled'
                    }) %>
                    <p class="form-hint">Any message in this channel will be treated as a song request</p>
                </div>

                <!-- Vote Skip -->
                <div class="p-4 bg-dark-700 rounded-lg">
                    <label class="flex items-center gap-3 cursor-pointer mb-3">
                        <input type="checkbox" name="vote_skip_enabled" id="vote_skip_enabled" class="form-checkbox" <%= locals.musicConfig?.vote_skip_enabled ? 'checked' : '' %>>
                        <div>
                            <span class="text-white font-medium flex items-center gap-2">
                                <span class="text-accent-yellow">🗳️</span> Vote Skip
                            </span>
                            <p class="text-xs text-gray-500">Require votes from listeners to skip songs</p>
                        </div>
                    </label>
                    <div class="ml-8">
                        <label class="form-label">Skip Threshold (%)</label>
                        <input type="number" name="vote_skip_percentage" class="form-input w-24" value="<%= locals.musicConfig?.vote_skip_percentage || 50 %>" min="1" max="100">
                        <p class="form-hint">Percentage of listeners required to skip</p>
                    </div>
                </div>
            </div>

            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">Save Advanced Settings</button>
            </div>
        </form>
    </div>

    <!-- Playlist Settings -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4">Playlist Settings</h3>
        <form id="playlist-form" action="/api/guilds/<%= guildId %>/music/playlists" method="PUT">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="form-group">
                    <label class="form-label">Max Playlists Per User</label>
                    <input type="number" name="max_playlists_per_user" class="form-input w-full" value="<%= locals.musicConfig?.max_playlists_per_user || 10 %>" min="1" max="50">
                </div>
                <div class="form-group">
                    <label class="form-label">Max Songs Per Playlist</label>
                    <input type="number" name="max_songs_per_playlist" class="form-input w-full" value="<%= locals.musicConfig?.max_songs_per_playlist || 100 %>" min="10" max="1000">
                </div>
            </div>
            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">Save Playlist Settings</button>
            </div>
        </form>
    </div>

    <!-- Audio Filters -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-2">Audio Filters</h3>
        <p class="text-sm text-gray-400 mb-4">Select which audio filters are available for use</p>
        <form id="filters-form" action="/api/guilds/<%= guildId %>/music/filters" method="PUT">
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
                <% const availableFilters = ['bassboost', '8D', 'vaporwave', 'nightcore', 'phaser', 'tremolo', 'vibrato', 'reverse', 'treble', 'normalizer', 'surrounding', 'pulsator', 'subboost', 'karaoke', 'flanger', 'gate', 'haas', 'mcompand']; %>
                <% availableFilters.forEach(filter => { %>
                    <label class="flex items-center gap-2 p-2 bg-dark-700 rounded-lg cursor-pointer hover:bg-dark-600 transition-colors">
                        <input type="checkbox" name="filters" value="<%= filter %>" class="form-checkbox" <%= (locals.musicConfig?.enabled_filters && musicConfig.enabled_filters.includes(filter)) ? 'checked' : '' %>>
                        <span class="text-sm text-gray-300 capitalize"><%= filter %></span>
                    </label>
                <% }) %>
            </div>
            <div class="flex justify-end mt-6 pt-6 border-t border-dark-400">
                <button type="submit" class="btn btn-primary">Save Filter Settings</button>
            </div>
        </form>
    </div>
</div>

<script>
let currentAudio = null;

function previewVoice() {
    const voiceSelect = document.querySelector('select[name="dj_voice"]');
    const selectedVoice = voiceSelect.value;
    const statusSpan = document.getElementById('preview-status');
    const previewBtn = document.getElementById('preview-voice-btn');

    if (!selectedVoice) {
        statusSpan.textContent = '⚠️ Select a voice first';
        return;
    }

    if (currentAudio) { currentAudio.pause(); currentAudio = null; }
    previewBtn.disabled = true;
    statusSpan.textContent = '⏳ Loading...';

    fetch(`/api/voice-preview/${selectedVoice}`)
        .then(res => res.ok ? res.blob() : Promise.reject())
        .then(blob => {
            const url = URL.createObjectURL(blob);
            currentAudio = new Audio(url);
            currentAudio.onplay = () => { statusSpan.textContent = '🔊 Playing...'; };
            currentAudio.onended = () => { statusSpan.textContent = ''; previewBtn.disabled = false; currentAudio = null; };
            currentAudio.onerror = () => { statusSpan.textContent = '❌ Error'; previewBtn.disabled = false; };
            currentAudio.play().catch(() => { statusSpan.textContent = '❌ Playback error'; previewBtn.disabled = false; });
        })
        .catch(() => { statusSpan.textContent = '❌ Failed'; previewBtn.disabled = false; });
}

async function submitForm(form, action) {
    const formData = new FormData(form);
    const data = {};
    formData.forEach((value, key) => {
        if (key === 'filters') {
            if (!data.filters) data.filters = [];
            data.filters.push(value);
        } else {
            data[key] = value;
        }
    });

    // Handle checkboxes
    form.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        if (cb.name !== 'filters') data[cb.name] = cb.checked;
    });

    try {
        const response = await fetch(action, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        if (response.ok) showToast('success', 'Settings saved');
        else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to save settings'); }
}

document.getElementById('music-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const data = {
        enabled: document.getElementById('music_enabled').checked,
        dj_role_id: new FormData(this).get('dj_role_id') || null
    };
    fetch(this.action, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(r => r.ok ? showToast('success', 'Saved') : Promise.reject())
        .catch(() => showToast('error', 'Failed'));
});

document.getElementById('dj-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const data = {
        dj_enabled: document.getElementById('dj_enabled').checked,
        dj_voice: new FormData(this).get('dj_voice')
    };
    fetch(this.action, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(r => r.ok ? showToast('success', 'Saved') : Promise.reject())
        .catch(() => showToast('error', 'Failed'));
});

document.getElementById('advanced-form')?.addEventListener('submit', function(e) { e.preventDefault(); submitForm(this, this.action); });
document.getElementById('playlist-form')?.addEventListener('submit', function(e) { e.preventDefault(); submitForm(this, this.action); });
document.getElementById('filters-form')?.addEventListener('submit', function(e) { e.preventDefault(); submitForm(this, this.action); });
</script>
