<%# Ticket System Settings - Tailwind Version %>

<div class="space-y-6">
    <!-- Ticket Panels Overview -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Ticket Panels</h3>
                <p class="text-sm text-gray-400">Create customizable ticket panels for different support categories</p>
            </div>
            <button type="button" class="btn btn-primary" onclick="openPanelModal()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                New Panel
            </button>
        </div>

        <% if (locals.ticketPanels && locals.ticketPanels.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% locals.ticketPanels.forEach(panel => { %>
                    <div class="p-4 bg-dark-700 rounded-lg border border-dark-400 hover:border-primary-500 transition-colors" data-panel-id="<%= panel.panel_id %>">
                        <div class="flex items-start justify-between mb-3">
                            <div>
                                <h4 class="font-semibold text-white"><%= panel.panel_name %></h4>
                                <% if (panel.panel_message_id) { %>
                                    <span class="badge badge-success text-xs mt-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        Deployed
                                    </span>
                                <% } else { %>
                                    <span class="badge badge-warning text-xs mt-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        Not Deployed
                                    </span>
                                <% } %>
                            </div>
                            <div class="flex gap-1">
                                <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-white transition-colors" title="Edit" onclick="editPanel(<%= panel.panel_id %>)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-primary-400 transition-colors" title="Deploy" onclick="deployPanel(<%= panel.panel_id %>)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                    </svg>
                                </button>
                                <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-accent-red transition-colors" title="Delete" onclick="deletePanel(<%= panel.panel_id %>)">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Panel Preview -->
                        <div class="p-3 bg-dark-600 rounded border-l-4 mb-3" style="border-color: <%= panel.embed_color || '#a78bfa' %>;">
                            <p class="font-medium text-sm" style="color: <%= panel.embed_color || '#a78bfa' %>;"><%= panel.embed_title || 'Support Ticket' %></p>
                            <p class="text-xs text-gray-400 mt-1 line-clamp-2"><%= panel.embed_description || 'Click the button below to create a ticket.' %></p>
                            <div class="mt-2 inline-flex items-center gap-1 px-2 py-1 bg-primary-500 rounded text-xs text-white">
                                <% if (panel.button_emoji) { %><span><%= panel.button_emoji %></span><% } %>
                                <span><%= panel.button_text || 'Create Ticket' %></span>
                            </div>
                        </div>

                        <!-- Panel Details -->
                        <div class="text-xs text-gray-500 space-y-1">
                            <%
                                const category = Array.from(categories?.values() || []).find(c => c.id === panel.ticket_category_id);
                                const supportRole = Array.from(roles.values()).find(r => r.id === panel.support_role_id);
                            %>
                            <div class="flex items-center gap-2">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                                </svg>
                                <span><%= category?.name || 'No category' %></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                                <span><%= supportRole?.name || 'No support role' %></span>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <svg class="empty-state-icon mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                </svg>
                <p class="empty-state-title">No Ticket Panels</p>
                <p class="empty-state-text">Create your first ticket panel to get started</p>
                <button type="button" class="btn btn-primary mt-4" onclick="openPanelModal()">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Create First Panel
                </button>
            </div>
        <% } %>
    </div>

    <!-- Ticket Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Total Tickets',
            value: locals.ticketStats?.total || 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>',
            color: 'primary'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Open Tickets',
            value: locals.ticketStats?.open || 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>',
            color: 'success'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Avg Response',
            value: locals.ticketStats?.avgResponseTime || '0m',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'warning'
        }) %>

        <%- include('../../components/cards/statCard', {
            title: 'Resolved Today',
            value: locals.ticketStats?.resolvedToday || 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'info'
        }) %>
    </div>

    <!-- Active Tickets -->
    <div class="card">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold text-white">Active Tickets</h3>
                <p class="text-sm text-gray-400">Currently open support tickets</p>
            </div>
            <div class="flex gap-2">
                <input
                    type="text"
                    id="ticket-search"
                    class="form-input w-48"
                    placeholder="Search tickets..."
                >
                <select id="ticket-status-filter" class="form-input w-32">
                    <option value="">All Status</option>
                    <option value="open">Open</option>
                    <option value="claimed">Claimed</option>
                    <option value="pending">Pending</option>
                </select>
            </div>
        </div>

        <% if (locals.activeTickets && locals.activeTickets.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="data-table w-full">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>User</th>
                            <th>Status</th>
                            <th>Assigned</th>
                            <th>Created</th>
                            <th class="w-24"></th>
                        </tr>
                    </thead>
                    <tbody id="tickets-table-body">
                        <% locals.activeTickets.forEach(ticket => { %>
                            <tr class="ticket-row" data-ticket-id="<%= ticket.ticket_id %>" data-status="<%= ticket.status %>">
                                <td>
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                                        </svg>
                                        <span class="font-medium text-primary-400">#<%= ticket.ticket_id %></span>
                                    </div>
                                </td>
                                <td>
                                    <div class="flex items-center gap-2">
                                        <img src="<%= ticket.user_avatar || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="" class="w-6 h-6 rounded-full">
                                        <span class="text-white"><%= ticket.user_name || 'Unknown' %></span>
                                    </div>
                                </td>
                                <td>
                                    <% const statusColors = {
                                        'open': 'badge-info',
                                        'claimed': 'badge-warning',
                                        'pending': 'badge-warning',
                                        'resolved': 'badge-success'
                                    }; %>
                                    <span class="badge <%= statusColors[ticket.status] || 'badge-info' %>">
                                        <%= ticket.status?.toUpperCase() %>
                                    </span>
                                </td>
                                <td>
                                    <% if (ticket.claimed_by) { %>
                                        <span class="text-sm text-white"><%= ticket.assignee_name %></span>
                                    <% } else { %>
                                        <span class="text-sm text-gray-500">Unassigned</span>
                                    <% } %>
                                </td>
                                <td class="text-sm text-gray-400">
                                    <%= new Date(ticket.created_at).toLocaleDateString() %>
                                </td>
                                <td>
                                    <div class="flex gap-1">
                                        <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-white" title="View" onclick="viewTicket(<%= ticket.ticket_id %>)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                            </svg>
                                        </button>
                                        <button type="button" class="p-1.5 rounded hover:bg-dark-500 text-gray-400 hover:text-accent-red" title="Close" onclick="closeTicket(<%= ticket.ticket_id %>)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <svg class="empty-state-icon mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
                <p class="empty-state-title">No Active Tickets</p>
                <p class="empty-state-text">All caught up! No open tickets at the moment.</p>
            </div>
        <% } %>
    </div>

    <!-- How It Works -->
    <div class="card bg-gradient-to-r from-primary-500/10 to-accent-purple/10 border-primary-500/30">
        <div class="flex gap-4">
            <div class="flex-shrink-0">
                <div class="w-12 h-12 rounded-lg bg-primary-500/20 flex items-center justify-center">
                    <svg class="w-6 h-6 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
            </div>
            <div>
                <h4 class="font-semibold text-white mb-2">How Tickets Work</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-300">
                    <div class="flex items-start gap-2">
                        <span class="text-primary-400 font-bold">1.</span>
                        <span>Users click the ticket button in the panel channel</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="text-primary-400 font-bold">2.</span>
                        <span>Bot creates a private channel in the ticket category</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="text-primary-400 font-bold">3.</span>
                        <span>Support team and user can communicate privately</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="text-primary-400 font-bold">4.</span>
                        <span>Transcripts are saved when tickets are closed</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Panel Modal -->
<div id="panel-modal" class="modal hidden">
    <div class="modal-overlay" onclick="closePanelModal()"></div>
    <div class="modal-content max-w-2xl">
        <div class="modal-header">
            <h3 class="modal-title" id="panel-modal-title">Create Ticket Panel</h3>
            <button type="button" class="modal-close" onclick="closePanelModal()">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="panel-form" class="modal-body space-y-6">
            <input type="hidden" name="panel_id" id="panel_id">

            <!-- Basic Settings -->
            <div>
                <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Basic Settings</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Panel Name *</label>
                        <input type="text" name="panel_name" id="panel_name" class="form-input w-full" placeholder="e.g., General Support" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Panel Channel</label>
                        <%- include('../../components/forms/channelSelect', {
                            name: 'panel_channel_id',
                            id: 'panel_channel_id',
                            channels: Array.from(channels.values()),
                            placeholder: 'Select channel for panel'
                        }) %>
                    </div>
                </div>
            </div>

            <!-- Embed Customization -->
            <div>
                <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Embed Customization</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Embed Title</label>
                        <input type="text" name="embed_title" id="embed_title" class="form-input w-full" placeholder="Support Ticket" value="Support Ticket">
                    </div>
                    <div class="form-group">
                        <%- include('../../components/forms/colorPicker', {
                            name: 'embed_color',
                            id: 'embed_color',
                            label: 'Embed Color',
                            value: '#a78bfa'
                        }) %>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Embed Description</label>
                    <textarea name="embed_description" id="embed_description" class="form-input w-full h-20 resize-none" placeholder="Click the button below to create a support ticket.">Click the button below to create a support ticket. Our team will assist you shortly!</textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Button Text</label>
                        <input type="text" name="button_text" id="button_text" class="form-input w-full" placeholder="Create Ticket" value="Create Ticket">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Button Emoji</label>
                        <input type="text" name="button_emoji" id="button_emoji" class="form-input w-full" placeholder="🎫">
                    </div>
                </div>
            </div>

            <!-- Ticket Settings -->
            <div>
                <h4 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Ticket Settings</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Ticket Category *</label>
                        <select name="ticket_category_id" id="ticket_category_id" class="form-input w-full" required>
                            <option value="">Select category...</option>
                            <% Array.from(categories?.values() || []).forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Support Role *</label>
                        <%- include('../../components/forms/roleSelect', {
                            name: 'support_role_id',
                            id: 'support_role_id',
                            roles: Array.from(roles.values()),
                            placeholder: 'Select support role'
                        }) %>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="form-group">
                        <label class="form-label">Log Channel</label>
                        <%- include('../../components/forms/channelSelect', {
                            name: 'log_channel_id',
                            id: 'log_channel_id',
                            channels: Array.from(channels.values()),
                            placeholder: 'Select log channel (optional)'
                        }) %>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ticket Name Format</label>
                        <input type="text" name="ticket_name_format" id="ticket_name_format" class="form-input w-full" placeholder="ticket-{username}" value="ticket-{username}">
                        <p class="form-hint">Variables: {username}, {number}, {id}</p>
                    </div>
                </div>
                <div class="flex items-center justify-between p-3 bg-dark-700 rounded-lg mt-4">
                    <div>
                        <p class="font-medium text-white text-sm">Save Transcripts</p>
                        <p class="text-xs text-gray-500">Save ticket conversations when closed</p>
                    </div>
                    <%- include('../../components/forms/toggle', {
                        name: 'save_transcripts',
                        id: 'save_transcripts',
                        checked: true,
                        size: 'sm'
                    }) %>
                </div>
            </div>
        </form>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closePanelModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="savePanel()">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Save Panel
            </button>
        </div>
    </div>
</div>

<script>
let currentEditingPanelId = null;

// Search and filter
document.getElementById('ticket-search')?.addEventListener('input', filterTickets);
document.getElementById('ticket-status-filter')?.addEventListener('change', filterTickets);

function filterTickets() {
    const search = document.getElementById('ticket-search')?.value.toLowerCase() || '';
    const status = document.getElementById('ticket-status-filter')?.value || '';

    document.querySelectorAll('.ticket-row').forEach(row => {
        const ticketId = row.dataset.ticketId;
        const rowStatus = row.dataset.status;
        const text = row.textContent.toLowerCase();

        const matchesSearch = text.includes(search) || ticketId.includes(search);
        const matchesStatus = !status || rowStatus === status;

        row.style.display = matchesSearch && matchesStatus ? '' : 'none';
    });
}

// Panel modal functions
function openPanelModal() {
    currentEditingPanelId = null;
    document.getElementById('panel-modal-title').textContent = 'Create Ticket Panel';
    document.getElementById('panel-form').reset();
    document.getElementById('panel-modal').classList.remove('hidden');
}

function closePanelModal() {
    document.getElementById('panel-modal').classList.add('hidden');
    currentEditingPanelId = null;
}

async function editPanel(panelId) {
    currentEditingPanelId = panelId;
    document.getElementById('panel-modal-title').textContent = 'Edit Ticket Panel';

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/tickets/panels/${panelId}`);
        const data = await response.json();

        if (data.success && data.panel) {
            const panel = data.panel;
            document.getElementById('panel_id').value = panelId;
            document.getElementById('panel_name').value = panel.panel_name || '';
            document.getElementById('panel_channel_id').value = panel.panel_channel_id || '';
            document.getElementById('embed_title').value = panel.embed_title || '';
            document.getElementById('embed_description').value = panel.embed_description || '';
            document.getElementById('embed_color').value = panel.embed_color || '#a78bfa';
            document.getElementById('button_text').value = panel.button_text || '';
            document.getElementById('button_emoji').value = panel.button_emoji || '';
            document.getElementById('ticket_category_id').value = panel.ticket_category_id || '';
            document.getElementById('support_role_id').value = panel.support_role_id || '';
            document.getElementById('log_channel_id').value = panel.log_channel_id || '';
            document.getElementById('ticket_name_format').value = panel.ticket_name_format || '';
            document.getElementById('save_transcripts').checked = panel.save_transcripts !== 0;

            document.getElementById('panel-modal').classList.remove('hidden');
        }
    } catch (error) {
        showToast('error', 'Failed to load panel data');
    }
}

async function savePanel() {
    const form = document.getElementById('panel-form');
    const formData = new FormData(form);
    const data = {};

    formData.forEach((value, key) => {
        if (value === 'on') data[key] = true;
        else if (value) data[key] = value;
    });

    if (!data.panel_name || !data.ticket_category_id || !data.support_role_id) {
        showToast('error', 'Please fill in all required fields');
        return;
    }

    try {
        const url = currentEditingPanelId
            ? `/api/guilds/<%= guildId %>/tickets/panels/${currentEditingPanelId}`
            : `/api/guilds/<%= guildId %>/tickets/panels`;

        const response = await fetch(url, {
            method: currentEditingPanelId ? 'PATCH' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (response.ok) {
            showToast('success', currentEditingPanelId ? 'Panel updated' : 'Panel created');
            closePanelModal();
            location.reload();
        } else {
            throw new Error('Failed to save');
        }
    } catch (error) {
        showToast('error', 'Failed to save panel');
    }
}

async function deployPanel(panelId) {
    if (!confirm('Deploy this panel to its configured channel?')) return;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/tickets/panels/${panelId}/deploy`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            showToast('success', 'Panel deployed successfully');
            location.reload();
        } else {
            const data = await response.json();
            throw new Error(data.error || 'Failed to deploy');
        }
    } catch (error) {
        showToast('error', error.message);
    }
}

async function deletePanel(panelId) {
    if (!confirm('Are you sure you want to delete this panel?')) return;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/tickets/panels/${panelId}`, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            showToast('success', 'Panel deleted');
            document.querySelector(`[data-panel-id="${panelId}"]`)?.remove();
        } else {
            throw new Error('Failed to delete');
        }
    } catch (error) {
        showToast('error', 'Failed to delete panel');
    }
}

async function viewTicket(ticketId) {
    // Open ticket in Discord or show details modal
    showToast('info', `Opening ticket #${ticketId}...`);
}

async function closeTicket(ticketId) {
    if (!confirm('Are you sure you want to close this ticket?')) return;

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/tickets/${ticketId}/close`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        if (response.ok) {
            showToast('success', 'Ticket closed');
            document.querySelector(`[data-ticket-id="${ticketId}"]`)?.remove();
        } else {
            throw new Error('Failed to close');
        }
    } catch (error) {
        showToast('error', 'Failed to close ticket');
    }
}

// Close modal on escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closePanelModal();
    }
});
</script>
