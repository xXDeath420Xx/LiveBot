<%# Team Subscriptions - Tailwind Version %>

<div class="space-y-6">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Team Subscriptions',
            value: (teamSubscriptions || []).length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Total Streamers',
            value: (teamSubscriptions || []).reduce((sum, t) => sum + (t.member_count || 0), 0),
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
            color: 'info'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Live Now',
            value: 0,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"/></svg>',
            color: 'success'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Status',
            value: 'Active',
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
            color: 'warning'
        }) %>
    </div>

    <!-- Add Team -->
    <div class="card">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-purple-500/10 rounded-lg">
                    <svg class="w-5 h-5 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">Team Subscriptions</h3>
                    <p class="text-sm text-gray-400">Subscribe to Twitch teams for automatic member tracking</p>
                </div>
            </div>
            <button onclick="openAddTeamModal()" class="btn btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Team
            </button>
        </div>
    </div>

    <!-- Team List -->
    <% if (teamSubscriptions && teamSubscriptions.length > 0) { %>
        <div class="grid gap-4">
            <% teamSubscriptions.forEach(team => { %>
                <div class="card">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-lg font-semibold text-white"><%= team.team_name %></h4>
                                <p class="text-sm text-gray-400">Twitch Team Subscription</p>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick='editTeam(<%= JSON.stringify(team) %>)' class="btn btn-secondary btn-sm">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                                Settings
                            </button>
                            <button onclick="deleteTeam('<%= team.id %>')" class="btn btn-danger btn-sm">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-3 bg-dark-700 rounded-lg border border-dark-400">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                                </svg>
                                <span class="text-xs text-gray-500">Announcement Channel</span>
                            </div>
                            <div class="font-semibold text-white">
                                <% const channel = channels.find(c => c.id === team.announcement_channel_id); %>
                                <%= channel ? '#' + channel.name : 'Default' %>
                            </div>
                        </div>

                        <div class="p-3 bg-dark-700 rounded-lg border border-dark-400">
                            <div class="flex items-center gap-2 mb-1">
                                <svg class="w-4 h-4 text-accent-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <span class="text-xs text-gray-500">Live Role</span>
                            </div>
                            <div class="font-semibold text-white">
                                <% const role = roles.find(r => r.id === team.live_role_id); %>
                                <%= role ? '@' + role.name : 'None' %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="card text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-dark-600 flex items-center justify-center">
                <svg class="w-8 h-8 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
                </svg>
            </div>
            <h4 class="text-lg font-semibold text-white mb-2">No Team Subscriptions</h4>
            <p class="text-gray-400 mb-4">Subscribe to Twitch teams to automatically track all team members</p>
            <button onclick="openAddTeamModal()" class="btn btn-primary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add First Team
            </button>
        </div>
    <% } %>

    <!-- Info Card -->
    <div class="card bg-gradient-to-r from-purple-500/10 to-purple-500/5 border-purple-500/30">
        <div class="flex gap-4">
            <div class="flex-shrink-0">
                <div class="w-12 h-12 rounded-lg bg-purple-500/20 flex items-center justify-center">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
            </div>
            <div>
                <h4 class="font-semibold text-white mb-2">How Team Subscriptions Work</h4>
                <ul class="text-sm text-gray-300 space-y-1.5">
                    <li class="flex items-start gap-2">
                        <span class="text-purple-400">1.</span>
                        Subscribe to a Twitch team by entering the team name
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-purple-400">2.</span>
                        The bot automatically tracks all team members
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-purple-400">3.</span>
                        When a team member goes live, announcements are posted
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-purple-400">4.</span>
                        New team members are automatically added
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Add Team Modal -->
<div id="add-team-modal" class="modal-overlay hidden">
    <div class="modal-container max-w-md">
        <div class="modal-header">
            <h3 class="text-lg font-semibold text-white">Add Team Subscription</h3>
            <button onclick="closeAddTeamModal()" class="text-gray-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="add-team-form">
            <div class="modal-body space-y-4">
                <div class="form-group">
                    <label class="form-label">Twitch Team Name</label>
                    <input type="text" name="team_name" class="form-input w-full" required placeholder="e.g., team-liquid">
                    <p class="form-hint">The team name from the Twitch URL (twitch.tv/team/team-name)</p>
                </div>

                <div class="form-group">
                    <label class="form-label">Announcement Channel</label>
                    <%- include('../../components/forms/channelSelect', {
                        name: 'announcement_channel_id',
                        channels: Array.from(channels.values()),
                        selected: null,
                        placeholder: 'Use default stream channel'
                    }) %>
                </div>

                <div class="form-group">
                    <label class="form-label">Live Role (optional)</label>
                    <%- include('../../components/forms/roleSelect', {
                        name: 'live_role_id',
                        roles: Array.from(roles.values()),
                        selected: null,
                        placeholder: 'No live role'
                    }) %>
                    <p class="form-hint">Role given to team members when they go live</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeAddTeamModal()" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary">Add Team</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Team Modal -->
<div id="edit-team-modal" class="modal-overlay hidden">
    <div class="modal-container max-w-md">
        <div class="modal-header">
            <h3 class="text-lg font-semibold text-white">Edit Team: <span id="edit-team-name"></span></h3>
            <button onclick="closeEditTeamModal()" class="text-gray-400 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <form id="edit-team-form">
            <input type="hidden" name="team_id" id="edit-team-id">
            <div class="modal-body space-y-4">
                <div class="form-group">
                    <label class="form-label">Announcement Channel</label>
                    <%- include('../../components/forms/channelSelect', {
                        name: 'announcement_channel_id',
                        id: 'edit-team-channel',
                        channels: Array.from(channels.values()),
                        selected: null,
                        placeholder: 'Use default stream channel'
                    }) %>
                </div>

                <div class="form-group">
                    <label class="form-label">Live Role (optional)</label>
                    <%- include('../../components/forms/roleSelect', {
                        name: 'live_role_id',
                        id: 'edit-team-role',
                        roles: Array.from(roles.values()),
                        selected: null,
                        placeholder: 'No live role'
                    }) %>
                </div>

                <div class="form-group">
                    <label class="form-label">Webhook Name (optional)</label>
                    <input type="text" name="webhook_name" id="edit-team-webhook-name" class="form-input w-full" placeholder="Custom webhook name">
                </div>

                <div class="form-group">
                    <label class="form-label">Webhook Avatar URL (optional)</label>
                    <input type="url" name="webhook_avatar_url" id="edit-team-webhook-avatar" class="form-input w-full" placeholder="https://...">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeEditTeamModal()" class="btn btn-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
function openAddTeamModal() {
    document.getElementById('add-team-form').reset();
    document.getElementById('add-team-modal').classList.remove('hidden');
}

function closeAddTeamModal() {
    document.getElementById('add-team-modal').classList.add('hidden');
}

function editTeam(team) {
    document.getElementById('edit-team-name').textContent = team.team_name;
    document.getElementById('edit-team-id').value = team.id;
    document.getElementById('edit-team-channel').value = team.announcement_channel_id || '';
    document.getElementById('edit-team-role').value = team.live_role_id || '';
    document.getElementById('edit-team-webhook-name').value = team.webhook_name || '';
    document.getElementById('edit-team-webhook-avatar').value = team.webhook_avatar_url || '';
    document.getElementById('edit-team-modal').classList.remove('hidden');
}

function closeEditTeamModal() {
    document.getElementById('edit-team-modal').classList.add('hidden');
}

document.getElementById('add-team-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/teams', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(formData))
        });
        if (response.ok) {
            showToast('success', 'Team subscription added');
            closeAddTeamModal();
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to add team'); }
});

document.getElementById('edit-team-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const teamId = formData.get('team_id');

    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/teams/${teamId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(formData))
        });
        if (response.ok) {
            showToast('success', 'Team settings updated');
            closeEditTeamModal();
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to update team'); }
});

async function deleteTeam(id) {
    if (!confirm('Are you sure? This will remove all associated streamers.')) return;
    try {
        const response = await fetch(`/api/guilds/<%= guildId %>/teams/${id}`, { method: 'DELETE' });
        if (response.ok) {
            showToast('success', 'Team removed');
            location.reload();
        } else throw new Error('Failed');
    } catch (e) { showToast('error', 'Failed to remove team'); }
}
</script>
