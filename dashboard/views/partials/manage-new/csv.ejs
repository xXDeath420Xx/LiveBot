<%# CSV Import/Export - Tailwind Version %>

<div class="space-y-6">
    <!-- Header -->
    <div class="card">
        <div class="flex items-center gap-3">
            <div class="p-2 bg-primary-500/10 rounded-lg">
                <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-lg font-semibold text-white">CSV Import/Export</h3>
                <p class="text-sm text-gray-400">Mass manage streamers using CSV files for bulk operations</p>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4">
        <%- include('../../components/cards/statCard', {
            title: 'Current Streamers',
            value: (consolidatedStreamers || []).length,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
            color: 'primary'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Platforms Tracked',
            value: new Set((consolidatedStreamers || []).flatMap(s => s.platforms || [])).size,
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>',
            color: 'info'
        }) %>
        <%- include('../../components/cards/statCard', {
            title: 'Total Subscriptions',
            value: (consolidatedStreamers || []).reduce((sum, s) => sum + (s.subscriptions?.length || 0), 0),
            icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>',
            color: 'success'
        }) %>
    </div>

    <!-- Import/Export Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Import Section -->
        <div class="card">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-lg bg-primary-500 flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                </div>
                <div>
                    <h4 class="font-semibold text-white">Import Streamers</h4>
                    <p class="text-sm text-gray-400">Add or update streamers in bulk</p>
                </div>
            </div>

            <div class="p-3 bg-dark-700 rounded-lg mb-4">
                <p class="text-xs font-semibold text-gray-400 mb-1">CSV Format</p>
                <p class="text-sm text-gray-300 mb-1">Required: <code class="text-primary-400">platform</code>, <code class="text-primary-400">username</code></p>
                <p class="text-sm text-gray-300">Optional: <code class="text-primary-400">discord_user_id</code>, <code class="text-primary-400">announcement_channel_id</code></p>
            </div>

            <form id="import-form" enctype="multipart/form-data">
                <div class="form-group mb-4">
                    <label class="form-label">Upload CSV File</label>
                    <input type="file" name="csvFile" id="csvFile" accept=".csv" class="form-input w-full" required>
                    <p class="form-hint">Select a CSV file containing streamer data</p>
                </div>

                <button type="submit" class="btn btn-primary w-full">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                    </svg>
                    Import CSV
                </button>
            </form>

            <div class="mt-4 p-3 bg-dark-700 rounded-lg border-l-3 border-accent-yellow">
                <p class="text-xs font-semibold text-accent-yellow mb-1">Important</p>
                <p class="text-sm text-gray-300">Importing will add new streamers and update existing ones. Existing subscriptions will not be removed.</p>
            </div>
        </div>

        <!-- Export Section -->
        <div class="card">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-lg bg-accent-green flex items-center justify-center">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                    </svg>
                </div>
                <div>
                    <h4 class="font-semibold text-white">Export Streamers</h4>
                    <p class="text-sm text-gray-400">Download all streamer data</p>
                </div>
            </div>

            <div class="p-3 bg-dark-700 rounded-lg mb-4">
                <p class="text-xs font-semibold text-gray-400 mb-2">Export Includes</p>
                <ul class="text-sm text-gray-300 space-y-1 list-disc list-inside">
                    <li>Streamer usernames and platforms</li>
                    <li>Announcement channel settings</li>
                    <li>Discord user linkage (if set)</li>
                    <li>Custom messages and settings</li>
                </ul>
            </div>

            <a href="/api/guilds/<%= guildId %>/streamers/export" class="btn btn-success w-full text-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                Export as CSV
            </a>

            <div class="mt-4 p-3 bg-dark-700 rounded-lg border-l-3 border-primary-500">
                <p class="text-xs font-semibold text-primary-400 mb-1">Use Cases</p>
                <p class="text-sm text-gray-300">Export data for backups, transferring to another server, or bulk editing in a spreadsheet.</p>
            </div>
        </div>
    </div>

    <!-- CSV Template -->
    <div class="card">
        <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            CSV Template Example
        </h3>
        <p class="text-gray-400 mb-4">Use this format for your CSV imports</p>

        <div class="p-4 bg-dark-700 rounded-lg overflow-x-auto mb-4">
            <pre class="text-sm text-gray-300 font-mono">platform,username,discord_user_id,announcement_channel_id
twitch,example_streamer,123456789012345678,987654321098765432
youtube,AnotherStreamer,,987654321098765432
kick,cool_gamer,456789012345678901,
twitch,pro_player,789012345678901234,123456789012345678</pre>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-3 bg-dark-700 rounded-lg">
                <p class="text-xs font-semibold text-gray-400 mb-2">Supported Platforms</p>
                <div class="flex flex-wrap gap-2">
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #9146FF; color: white;">Twitch</span>
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #FF0000; color: white;">YouTube</span>
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #53FC18; color: black;">Kick</span>
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #000000; color: white;">TikTok</span>
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #1BC981; color: white;">Trovo</span>
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #1877F2; color: white;">Facebook</span>
                    <span class="px-2 py-1 text-xs font-medium rounded" style="background: #E4405F; color: white;">Instagram</span>
                </div>
            </div>
            <div class="p-3 bg-dark-700 rounded-lg">
                <p class="text-xs font-semibold text-gray-400 mb-2">Tips</p>
                <ul class="text-sm text-gray-300 space-y-1 list-disc list-inside">
                    <li>Leave optional fields empty (but keep commas)</li>
                    <li>Use Discord IDs, not usernames</li>
                    <li>Platform names are case-insensitive</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('csvFile')?.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file && !file.name.endsWith('.csv')) {
        showToast('error', 'Please select a CSV file (.csv extension)');
        e.target.value = '';
    }
});

document.getElementById('import-form')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const formData = new FormData(this);
    const fileInput = document.getElementById('csvFile');

    if (!fileInput.files[0]) {
        showToast('error', 'Please select a CSV file');
        return;
    }

    try {
        const response = await fetch('/api/guilds/<%= guildId %>/streamers/import', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (response.ok) {
            showToast('success', `Imported ${data.imported || 0} streamers, updated ${data.updated || 0}`);
            fileInput.value = '';
        } else {
            throw new Error(data.error || 'Import failed');
        }
    } catch (error) {
        showToast('error', error.message || 'Failed to import CSV');
    }
});
</script>
