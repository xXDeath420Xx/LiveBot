<%#
  Time capsules: the capsules members seal with /notes timecapsule create (time_capsules). The counts and
  both lists load from GET /manage/:guildId/timecapsules; DELETE /manage/:guildId/timecapsules/:id
  removes a capsule that has not been posted yet (dashboard/routes/features/content-management.js).
  jobs/time-capsule-scheduler.js posts each one in its channel, checking hourly. Built on the
  settings-row kit (cf-settings.css); every list row is built with createElement/textContent.
%>
<style>
    .tc-lists .capsule-content {
        margin: 0; padding: var(--cf-3) var(--cf-4); overflow-wrap: anywhere; white-space: pre-wrap;
        font-size: var(--cf-text-sm); line-height: 1.55; color: var(--cf-text-2);
        background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius);
        max-height: 12rem; overflow-y: auto;
    }
    .tc-lists .capsule-countdown { font-weight: 600; color: var(--cf-text-2); font-variant-numeric: tabular-nums; }
    .tc-lists .tc-count { margin-left: 4px; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
</style>

<div class="page-section" id="cfk-tc-page" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-hourglass-half"></i>
                <span>Time capsules</span>
            </div>
            <div class="page-section-subtitle">What members have sealed in this server, and when each one opens.</div>
        </div>
    </div>

    <dl class="cf-kpis" id="capsules-stats" aria-label="Time capsules at a glance">
        <div class="cf-kpi"><dt>Total</dt><dd class="cf-kpi-value" id="stat-total">-</dd></div>
        <div class="cf-kpi"><dt>Waiting to open</dt><dd class="cf-kpi-value" id="stat-upcoming">-</dd></div>
        <div class="cf-kpi"><dt>Opened</dt><dd class="cf-kpi-value" id="stat-revealed">-</dd></div>
    </dl>

    <section class="cf-section tc-lists" aria-labelledby="tc-upcoming-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tc-upcoming-title">Waiting to open <span class="tc-count" id="cfk-tc-upcoming-count"></span></h2>
                <p class="cf-section-desc">Members seal one with <code>/notes timecapsule create</code>. It is posted in the channel it was made in when its date arrives (checked every hour). Delete one to stop it being posted.</p>
            </div>
            <div class="cf-section-actions">
                <label class="cf-search" id="cfk-tc-search-head" hidden>
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" class="form-control" id="cfk-tc-search" placeholder="Search capsules" aria-label="Search capsules" autocomplete="off">
                </label>
            </div>
        </header>
        <div class="cf-rows">
            <div id="upcoming-capsules">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading time capsules', text: null }) %>
            </div>
        </div>
    </section>

    <section class="cf-section tc-lists" aria-labelledby="tc-revealed-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tc-revealed-title">Recently opened <span class="tc-count" id="cfk-tc-revealed-count"></span></h2>
                <p class="cf-section-desc">Capsules that have already been posted.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="revealed-capsules">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading opened capsules', text: null }) %>
            </div>
        </div>
    </section>
</div>

<script>
(function () {
    var page = document.getElementById('cfk-tc-page');
    if (!page) return;
    var base = '/manage/' + encodeURIComponent(page.getAttribute('data-guild-id')) + '/timecapsules';
    var capsules = [];

    function formatCountdown(revealDate) {
        var diff = new Date(revealDate) - new Date();
        if (diff <= 0) return 'Opens within the hour';
        var days = Math.floor(diff / 86400000);
        var hours = Math.floor((diff % 86400000) / 3600000);
        var minutes = Math.floor((diff % 3600000) / 60000);
        if (days > 0) return days + 'd ' + hours + 'h left';
        if (hours > 0) return hours + 'h ' + minutes + 'm left';
        return minutes + 'm left';
    }
    function when(d) {
        return new Date(d).toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function tcEl(tag, cls, text) {
        var n = document.createElement(tag);
        if (cls) n.className = cls;
        if (text != null) n.textContent = text;
        return n;
    }
    function tcState(kind, title, text) {
        var box = tcEl('div', 'cf-state' + (kind === 'error' ? ' cf-state--error' : ''));
        if (kind === 'error') box.setAttribute('role', 'alert');
        box.append(tcEl('p', 'cf-state-title', title));
        if (text) box.append(tcEl('p', 'cf-state-text', text));
        return box;
    }

    function tcItem(capsule, isRevealed) {
        var item = tcEl('div', 'capsule-item cf-list-item cf-list-item--multi' + (isRevealed ? ' revealed' : ''));
        if (!isRevealed) item.setAttribute('data-reveal', capsule.reveal_date);
        var main = tcEl('div', 'cf-list-main');
        var title = tcEl('p', 'cf-list-title');
        var who = capsule.creator_name || ('Member ' + String(capsule.creator_id || '').slice(-4));
        title.append(tcEl('span', null, who),
            tcEl('span', isRevealed ? 'cf-pill is-ok' : 'cf-pill is-warn', isRevealed ? 'Opened' : 'Sealed'));
        var meta = tcEl('p', 'cf-list-meta');
        meta.append(tcEl('span', null, capsule.channel_name ? '#' + capsule.channel_name : 'Channel deleted'),
            tcEl('span', null, 'Sealed ' + when(capsule.created_at)),
            tcEl('span', null, (isRevealed ? 'Opened ' : 'Opens ') + when(isRevealed && capsule.revealed_at ? capsule.revealed_at : capsule.reveal_date)));
        if (!isRevealed) meta.append(tcEl('span', 'capsule-countdown', formatCountdown(capsule.reveal_date)));
        main.append(title, meta, tcEl('div', 'capsule-content', capsule.message_content || ''));
        item.append(main);
        if (!isRevealed) {
            var actions = tcEl('div', 'cf-list-actions');
            var del = tcEl('button', 'btn btn-sm btn-danger', 'Delete');
            del.type = 'button';
            del.addEventListener('click', function () { remove(capsule, del); });
            actions.append(del);
            item.append(actions);
        }
        return item;
    }

    function matches(c, q) {
        if (!q) return true;
        return [c.creator_name, c.channel_name, c.message_content].join(' ').toLowerCase().indexOf(q) !== -1;
    }

    function render() {
        var upcomingEl = document.getElementById('upcoming-capsules');
        var revealedEl = document.getElementById('revealed-capsules');
        var searchHead = document.getElementById('cfk-tc-search-head');
        var upcoming = capsules.filter(function (c) { return !c.revealed; })
            .sort(function (a, b) { return new Date(a.reveal_date) - new Date(b.reveal_date); });
        var revealed = capsules.filter(function (c) { return c.revealed; });

        document.getElementById('stat-total').textContent = capsules.length;
        document.getElementById('stat-upcoming').textContent = upcoming.length;
        document.getElementById('stat-revealed').textContent = revealed.length;
        document.getElementById('cfk-tc-upcoming-count').textContent = upcoming.length || '';
        document.getElementById('cfk-tc-revealed-count').textContent = revealed.length || '';
        searchHead.hidden = upcoming.length <= 15;
        var q = searchHead.hidden ? '' : document.getElementById('cfk-tc-search').value.trim().toLowerCase();
        var shown = upcoming.filter(function (c) { return matches(c, q); });

        upcomingEl.replaceChildren.apply(upcomingEl, shown.length ? shown.map(function (c) { return tcItem(c, false); })
            : [upcoming.length ? tcState('empty', 'No capsules match', 'Try other words.')
                : tcState('empty', 'No sealed capsules', 'Members create one with /notes timecapsule create.')]);
        revealedEl.replaceChildren.apply(revealedEl, revealed.length ? revealed.map(function (c) { return tcItem(c, true); })
            : [tcState('empty', 'Nothing opened yet', 'Capsules show here once they have been posted.')]);
    }

    async function remove(capsule, btn) {
        if (!confirm('Delete this capsule? It will not be posted, and this cannot be undone.')) return;
        btn.disabled = true;
        try {
            var res = await fetch(base + '/' + encodeURIComponent(capsule.id), { method: 'DELETE', credentials: 'same-origin', headers: { Accept: 'application/json' } });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok) throw new Error(data.error || ('Request failed (' + res.status + ')'));
            capsules = capsules.filter(function (c) { return c.id !== capsule.id; });
            render();
            if (window.showToast) window.showToast('Capsule deleted', 'success');
        } catch (err) {
            btn.disabled = false;
            if (window.showToast) window.showToast(err.message, 'error'); else alert(err.message);
        }
    }

    async function loadTimeCapsules() {
        try {
            var response = await fetch(base, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
            var data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Request failed');
            capsules = Array.isArray(data.capsules) ? data.capsules : [];
            render();
        } catch (error) {
            console.error('Error loading time capsules:', error);
            document.getElementById('upcoming-capsules').replaceChildren(tcState('error', 'Could not load time capsules', 'Refresh the page to try again.'));
            document.getElementById('revealed-capsules').replaceChildren(tcState('error', 'Could not load time capsules', 'Refresh the page to try again.'));
        }
    }

    document.getElementById('cfk-tc-search').addEventListener('input', render);
    loadTimeCapsules();

    // Refresh the countdowns every minute.
    setInterval(function () {
        document.querySelectorAll('.capsule-item[data-reveal]').forEach(function (item) {
            var countdownEl = item.querySelector('.capsule-countdown');
            if (countdownEl) countdownEl.textContent = formatCountdown(item.getAttribute('data-reveal'));
        });
    }, 60000);
})();
</script>
