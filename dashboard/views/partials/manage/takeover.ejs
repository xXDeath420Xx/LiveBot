<%# Analyze & Take Over. API-driven; needs `guild` in locals. %>
<div class="page-section" id="takeoverPage" data-guild-id="<%= guild.id %>" data-guild-name="<%= guild.name %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-crosshairs"></i>
                <span>Analyze &amp; Take Over</span>
            </div>
            <div class="page-section-subtitle">
                Read every channel, work out what each bot does, replace what we can, and retire
                the old bot only once nothing it does is left unexplained.
            </div>
        </div>
    </div>

    <div id="toError" class="alert alert-danger" hidden></div>

    <!-- Phase 1: scan -->
    <div class="to-card">
        <div class="to-head">
            <div>
                <h3 class="to-h">1 · Scan the server</h3>
                <p class="form-help">
                    Reads every channel back to its first message. Nothing is posted, edited or
                    deleted. Safe to run on a live server, and safe to interrupt — it resumes.
                </p>
            </div>
            <div class="to-actions">
                <select id="toDepth" class="form-control" style="max-width:11rem">
                    <option value="deep">Full history</option>
                    <option value="standard">Last 90 days</option>
                    <option value="quick">Quick (1k / channel)</option>
                </select>
                <button class="btn btn-primary" id="toScan">Start scan</button>
                <button class="btn btn-secondary" id="toCancel" hidden>Cancel</button>
                <button class="btn btn-secondary" id="toResume" hidden>Resume</button>
            </div>
        </div>

        <div id="toScanState" class="to-muted">Loading…</div>
        <div class="to-bar" id="toBarWrap" hidden><div class="to-bar-fill" id="toBar" style="width:0%"></div></div>
        <div id="toUnreadable"></div>
    </div>

    <!-- Phase 2: bots -->
    <div class="to-card">
        <div class="to-head">
            <div>
                <h3 class="to-h">2 · What we found</h3>
                <p class="form-help">
                    Every bot and webhook persona that has ever posted. Expand one to see the distinct
                    message shapes it shows — each must be accounted for before it can be removed.
                </p>
            </div>
            <div class="to-actions">
                <button class="btn btn-secondary" id="toAttrAll">Auto-attribute everything we recognise</button>
            </div>
        </div>
        <div id="toAttrAllResult" class="to-muted" hidden></div>
        <div id="toBots" class="to-list">Run a scan to see results.</div>
    </div>

    <!-- The recovered profile. Sits between the scan and the plan because the plan is BUILT from it:
         without a profile, the guild-specific steps are not offered at all. -->
    <div class="to-card">
        <div class="to-head">
            <div>
                <h3 class="to-h">3 · This server's profile</h3>
                <p class="form-help">
                    The things we can only learn by reading this server's own history — which streamer
                    the old bot announces, where its role panels live, what <code>!commands</code>
                    people type. Reading is safe: it posts nothing and changes nothing.
                </p>
            </div>
            <div class="to-actions">
                <button class="btn btn-secondary" id="toDerive">Read the history</button>
                <button class="btn btn-primary" id="toApprove" hidden>Approve</button>
            </div>
        </div>
        <div id="toProfile" class="to-list to-muted">Loading…</div>
    </div>

    <!-- What the owner actually wants. Sits BEFORE the parity phase on purpose: her answers should
         shape what you apply, not be discovered after you have applied it. -->
    <div class="to-card">
        <div class="to-head">
            <div>
                <h3 class="to-h">4 · What the server owner wants</h3>
                <p class="form-help">
                    Her own answers, from the questionnaire she filled in. She has no dashboard
                    account — the link below is the only way she reaches it, so treat it like a key.
                </p>
            </div>
            <div class="to-actions">
                <button class="btn btn-secondary" id="toQLink">Get her link</button>
                <button class="btn btn-secondary" id="toQRevoke" hidden>Revoke link</button>
            </div>
        </div>
        <div id="toQUrl" class="to-muted" hidden></div>
        <div id="toQ" class="to-list to-muted">Loading…</div>
    </div>

    <!-- Phase 4: parity -->
    <div class="to-card">
        <div class="to-head">
            <div>
                <h3 class="to-h">5 · Apply feature parity</h3>
                <p class="form-help">
                    Writes configuration only. It carries live values across — a counting channel
                    resumes at the exact number the old bot left off on.
                </p>
            </div>
            <div class="to-actions">
                <button class="btn btn-secondary" id="toPlan">Preview plan</button>
                <button class="btn btn-primary" id="toApply" disabled>Apply selected</button>
            </div>
        </div>

        <!-- What the owner asked for. ABOVE the steps on purpose: a plan you can work through without
             ever meeting her answers is a plan that will eventually do something she said no to. -->
        <div id="toDecisions" hidden></div>

        <!-- Readiness: the full picture around the steps. Populated by Preview plan. -->
        <div id="toReadiness" hidden>
            <div class="to-ready-grid">
                <div class="to-ready" id="toReadyHierarchy"></div>
                <div class="to-ready" id="toReadySecurity"></div>
                <div class="to-ready" id="toReadyHygiene"></div>
                <div class="to-ready" id="toReadyGaps"></div>
            </div>
        </div>

        <div id="toSteps" class="to-list to-muted">Preview a plan to see the steps.</div>
    </div>
</div>

<style>
  #takeoverPage .to-card { background:#1e2028; border:1px solid #2c2f3a; border-radius:10px; padding:1.1rem 1.25rem; margin-bottom:1rem; }
  #takeoverPage .to-h { margin:0 0 .35rem; font-size:1rem; font-weight:600; }
  #takeoverPage .to-head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  #takeoverPage .to-actions { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
  #takeoverPage .to-muted { color:#8b8f9e; font-size:.88rem; }
  #takeoverPage .to-bar { height:8px; border-radius:999px; background:#2c2f3a; margin-top:.75rem; overflow:hidden; }
  #takeoverPage .to-bar-fill { height:100%; background:linear-gradient(90deg,#5865F2,#57F287); transition:width .4s ease; }
  #takeoverPage .to-list { margin-top:.9rem; display:grid; gap:.5rem; }
  #takeoverPage .to-bot { border:1px solid #2c2f3a; border-radius:8px; background:#14161c; }
  #takeoverPage .to-bot-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.7rem .9rem; cursor:pointer; }
  #takeoverPage .to-bot-body { border-top:1px solid #2c2f3a; padding:.8rem .9rem; display:none; }
  #takeoverPage .to-bot.open .to-bot-body { display:block; }
  /* Her questionnaire. An unanswered question must read as loudly as an answered one — the gaps
     are the whole point of looking at this page. */
  #takeoverPage .to-qsum { font-size:.86rem; color:#b8bdc9; margin-bottom:.9rem; }
  #takeoverPage .to-qsec { font-size:.7rem; letter-spacing:.09em; text-transform:uppercase;
    color:#7a8291; margin:1.1rem 0 .5rem; padding-bottom:.3rem; border-bottom:1px solid #2c2f3a; }
  #takeoverPage .to-q { padding:.6rem .8rem; margin-bottom:.4rem; border-radius:7px;
    background:#191b22; border-left:3px solid #3a3f4d; }
  #takeoverPage .to-q.yes { border-left-color:#57F287; }
  #takeoverPage .to-q.no  { border-left-color:#3a3f4d; opacity:.72; }
  /* "Tell me more" is the only pick that is a job for US — it must not read as a soft maybe. */
  #takeoverPage .to-q.ask { border-left-color:#FEE75C; }
  #takeoverPage .to-qq { font-weight:600; font-size:.92rem; }
  #takeoverPage .to-qa { font-size:.9rem; color:#dfe3ea; margin-top:.15rem; }
  #takeoverPage .to-qa.waiting { color:#7a8291; font-style:italic; }
  #takeoverPage .to-qnote { margin:.45rem 0 0; padding:.4rem .7rem; border-left:2px solid #5865F2;
    background:#16181e; border-radius:0 5px 5px 0; font-size:.89rem; color:#c9cfda;
    white-space:pre-wrap; }
  #takeoverPage .to-qwhen { font-size:.72rem; color:#6b7280; margin-top:.3rem; }
  #takeoverPage .to-code { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:.8rem;
    background:#16181e; border:1px solid #2c2f3a; border-radius:5px; padding:.35rem .55rem;
    word-break:break-all; display:inline-block; max-width:100%; }
  #takeoverPage .to-copy { margin-left:.5rem; padding:.25rem .7rem; font-size:.78rem; }

  #takeoverPage .to-tag { font-size:.72rem; padding:.15rem .45rem; border-radius:999px; border:1px solid #2c2f3a; }
  #takeoverPage .to-tag.ok { color:#57F287; border-color:#2f6f4a; }
  #takeoverPage .to-tag.no { color:#ED4245; border-color:#6f2f2f; }
  #takeoverPage .to-tag.warn { color:#c9a227; border-color:#6f5f2f; }
  #takeoverPage .to-tpl { display:flex; align-items:flex-start; justify-content:space-between; gap:.8rem;
    padding:.45rem .6rem; border:1px solid #23262f; border-radius:6px; margin-bottom:.35rem; font-size:.84rem; }
  #takeoverPage .to-tpl code { color:#c9d1d9; word-break:break-word; }
  #takeoverPage .to-trig { color:#8b8f9e; font-size:.78rem; }
  #takeoverPage .to-gate { display:flex; gap:.55rem; align-items:flex-start; font-size:.86rem; padding:.2rem 0; }
  #takeoverPage .to-step { display:flex; gap:.6rem; align-items:flex-start; padding:.55rem .7rem;
    border:1px solid #2c2f3a; border-radius:8px; background:#14161c; font-size:.88rem; }
  #takeoverPage .to-retire { margin-top:.8rem; padding-top:.8rem; border-top:1px solid #2c2f3a; display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; }
  #takeoverPage .to-ready-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(15rem,1fr)); gap:.7rem; margin:.9rem 0 1.1rem; }
  #takeoverPage .to-ready { border:1px solid #2c2f3a; border-radius:8px; background:#14161c; padding:.75rem .9rem; }
  #takeoverPage .to-ready h5 { margin:0 0 .5rem; font-size:.82rem; text-transform:uppercase; letter-spacing:.03em; color:#8b8f9e; }
  #takeoverPage .to-ready .big { font-size:1.05rem; font-weight:600; }
  #takeoverPage .to-ready .good { color:#57F287; }
  #takeoverPage .to-ready .bad { color:#ED4245; }
  #takeoverPage .to-ready .warn { color:#c9a227; }
  #takeoverPage .to-ready ul { margin:.4rem 0 0; padding-left:1.05rem; font-size:.82rem; color:#c9d1d9; }
  #takeoverPage .to-ready li { margin-bottom:.2rem; }
  #takeoverPage .to-tag.rdy { color:#5865F2; border-color:#3a3f7a; }
  #takeoverPage .to-tag.seq { color:#8b93a7; border-color:#3a3f4a; }
  #takeoverPage .to-sum { padding:.8rem .9rem; border:1px solid #2c2f3a; border-radius:8px; background:#14161c; margin-bottom:.7rem; font-size:.9rem; }
  #takeoverPage .to-sum .good { color:#57F287; }
  #takeoverPage .to-sum .bad { color:#ED4245; }
  #takeoverPage .to-sum-chips { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.55rem; }
  #takeoverPage .to-sum-chip { font-size:.74rem; padding:.2rem .5rem; border-radius:999px; border:1px solid #2c2f3a; color:#c9d1d9; }
  #takeoverPage .to-sum-chip.ok { color:#57F287; border-color:#2f6f4a; }
  #takeoverPage .to-sum-chip.rdy { color:#8f9bff; border-color:#3a3f7a; }
  #takeoverPage .to-sum-chip.seq { color:#a9b1c2; border-color:#3a3f4a; }
  #takeoverPage .to-sum-chip.warn { color:#c9a227; border-color:#6f5f2f; }
  #takeoverPage .to-sum-chip.no { color:#ED4245; border-color:#6f2f2f; }
  #takeoverPage .to-step.to-st-blocked { border-color:#6f2f2f; }
  #takeoverPage .to-step.to-st-ready { border-color:#3a3f7a; }
  /* Declined: visibly stood down, not broken. It is not a failure — it is an answer. */
  #takeoverPage .to-step.to-st-declined { border-color:#3a3d47; opacity:.72; }
  #takeoverPage .to-tag.off { background:#3a3d47; color:#c9d1d9; }

  /* Her own words, wherever they appear. Quoted, warm, and never confusable with our prose. */
  #takeoverPage .to-ownernote { margin-top:.35rem; padding:.35rem .6rem; border-left:2px solid #5865F2;
    background:#1a1c24; border-radius:0 6px 6px 0; font-size:.86rem; color:#dcdfe4; font-style:italic; }

  #takeoverPage .to-sub { margin:.9rem 0 .45rem; font-size:.82rem; text-transform:uppercase;
    letter-spacing:.03em; color:#8b8f9e; font-weight:600; }
  #takeoverPage .to-dec-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));
    gap:.6rem; margin:.8rem 0; }
  #takeoverPage .to-dec { border:1px solid #2c2f3a; border-radius:8px; background:#14161c; padding:.6rem .75rem; }
  #takeoverPage .to-dec-q { font-size:.78rem; color:#8b8f9e; }
  #takeoverPage .to-dec-a { font-weight:600; color:#e6e9ef; margin-top:.15rem; }
  #takeoverPage .to-dec-n { margin-top:.3rem; font-size:.83rem; color:#c9d1d9; font-style:italic; }
  #takeoverPage .to-feats { display:flex; flex-wrap:wrap; gap:.35rem; }
  #takeoverPage .to-feat { font-size:.8rem; padding:.2rem .55rem; border-radius:999px; border:1px solid #2c2f3a; }
  #takeoverPage .to-feat.yes { background:#16301f; border-color:#2c5c3c; color:#8be0a4; }
  #takeoverPage .to-feat.no  { background:#241a1a; border-color:#5c3030; color:#e0a0a0; }
  #takeoverPage .to-feat.ask { background:#2a2618; border-color:#5c5230; color:#e0cf8b; }
</style>

<script>
(function () {
  const root = document.getElementById('takeoverPage');
  if (!root) return;
  const guildId = root.dataset.guildId;
  const guildName = root.dataset.guildName;
  const api = (p) => `/api/guilds/${guildId}/takeover${p}`;
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

  let poll = null;
  let state = null;

  async function req(url, options) {
    const res = await fetch(url, { credentials:'same-origin', headers:{ 'Content-Type':'application/json' }, ...options });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
    return body;
  }
  const showError = (m) => { const el = $('toError'); if (!m) { el.hidden = true; return; } el.textContent = m; el.hidden = false; };

  function renderScan(d) {
    const s = d.scan;
    $('toScan').disabled = d.scanning;
    $('toCancel').hidden = !d.scanning;
    $('toResume').hidden = d.scanning || !s || s.status === 'complete' || s.status === 'cancelled';
    $('toBarWrap').hidden = !s;

    if (!s) { $('toScanState').textContent = 'No scan yet.'; return; }
    $('toBar').style.width = `${s.pct}%`;
    $('toScanState').innerHTML =
      `<strong>${esc(s.status)}</strong> · ${s.channels_done}/${s.channels_total} channels · ` +
      `${Number(s.messages_scanned).toLocaleString()} messages indexed` +
      (s.error ? ` · <span style="color:#ED4245">${esc(s.error)}</span>` : '');

    $('toUnreadable').innerHTML = d.unreadableChannels?.length
      ? `<div class="to-muted" style="margin-top:.6rem">⚠ ${d.unreadableChannels.length} channel(s) excluded — we cannot read their history:
           ${d.unreadableChannels.map(c => '#' + esc(c.name)).join(', ')}</div>`
      : '';
  }

  // A bot we deliberately keep is NOT a failure — it must not read like one. Only an
  // unrecognised bot (one we have never classified) deserves a warning colour.
  function botTag(b) {
    if (b.coverage === 'self') return '<span class="to-tag ok">this is our bot</span>';
    if (b.coverage === 'system') return '<span class="to-tag seq">Discord system — not a bot</span>';
    if (b.retired) return '<span class="to-tag ok">retired</span>';
    if (!b.known) return '<span class="to-tag warn">unrecognised — needs a look</span>';
    if (b.coverage === 'none') return '<span class="to-tag seq">keep — no equivalent</span>';
    if (b.coverage === 'partial') return `<span class="to-tag warn">partial: ${esc(b.feature)}</span>`;
    const via = b.kind === 'webhook' ? ' (webhook)' : !b.present ? ' (already gone)' : '';
    return `<span class="to-tag ok">we replace this — ${esc(b.feature)}${via}</span>`;
  }

  function renderBots(d) {
    const el = $('toBots');
    if (!d.bots.length) { el.textContent = d.scan ? 'No bots posted in this server.' : 'Run a scan to see results.'; return; }

    el.innerHTML = d.bots.map(b => `
      <div class="to-bot" data-bot="${esc(b.bot_id)}">
        <div class="to-bot-head" data-toggle="${esc(b.bot_id)}">
          <div>
            <strong>${esc(b.name)}</strong> ${botTag(b)}
            <div class="to-muted">${Number(b.messages).toLocaleString()} messages in ${b.channels.length} channel(s)</div>
            ${b.why ? `<div class="to-muted">${esc(b.why)}</div>` : ''}
            ${b.holdsData ? `<div class="to-tag warn" style="display:inline-block;margin-top:.3rem">holds ${esc(b.holdsData.what)}</div>` : ''}
          </div>
          <span class="to-muted">▾</span>
        </div>
        <div class="to-bot-body" data-body="${esc(b.bot_id)}"></div>
      </div>`).join('');
  }

  async function openBot(botId) {
    const body = root.querySelector(`[data-body="${botId}"]`);
    body.innerHTML = 'Loading evidence…';

    const bot = state.bots.find(b => b.bot_id === botId);
    const [tpl, gates] = await Promise.all([
      req(api(`/bots/${botId}/templates`)),
      bot.kind === 'bot' && bot.present ? req(api(`/bots/${botId}/gates`)).catch(e => ({ error: e.message })) : null,
    ]);

    const templates = tpl.templates.map(t => `
      <div class="to-tpl">
        <div>
          <code>${esc(t.sample || '(empty)')}</code>
          <div class="to-trig">×${t.occurrences}${t.triggers.length ? ' · triggered by ' + t.triggers.map(esc).join(', ') : ''}</div>
        </div>
        <label class="to-trig" style="white-space:nowrap">
          <input type="checkbox" data-attr="${t.id}" ${t.attributed ? 'checked' : ''}>
          covered${t.attributed_to ? ` (${esc(t.attributed_to)})` : ''}
        </label>
      </div>`).join('') || '<div class="to-muted">No message shapes recorded.</div>';

    const gateHtml = !gates ? '' : gates.error
      ? `<div class="to-muted">${esc(gates.error)}</div>`
      : `<h4 class="to-h" style="margin-top:1rem">Removal gates</h4>` +
        gates.gates.map(g => `
          <div class="to-gate">
            <span>${g.pass === true ? '✅' : g.pass === null ? '⏳' : '⛔'}</span>
            <span><strong>${esc(g.label)}</strong>${g.detail ? `<br><span class="to-muted">${esc(g.detail)}</span>` : ''}</span>
          </div>`).join('') +
        retireBox(gates, bot);

    body.innerHTML = `
      <div class="to-actions" style="margin-bottom:.6rem">
        <button class="btn btn-sm btn-secondary" data-auto="${botId}">Auto-attribute what we recognise</button>
        <span class="to-muted">${tpl.templates.filter(t => !t.attributed).length} unexplained</span>
      </div>
      ${templates}
      ${gateHtml}`;
  }

  function retireBox(gates, bot) {
    if (!state.isOwner) return '<div class="to-muted" style="margin-top:.6rem">Only the server owner can remove a bot.</div>';
    if (bot.retired) return '';

    const ack = bot.holdsData && !gates.gates.find(g => g.id === 'data')?.pass
      ? `<button class="btn btn-sm btn-secondary" data-ack="${bot.bot_id}">I exported ${esc(bot.holdsData.what)}</button>` : '';

    return `<div class="to-retire">
      ${ack}
      <input type="text" class="form-control" style="max-width:16rem" placeholder="Type: ${esc(guildName)}" data-confirm="${bot.bot_id}">
      <button class="btn btn-sm btn-danger" data-retire="${bot.bot_id}" ${gates.ready ? '' : 'disabled'}>
        ${gates.ready ? 'Remove this bot' : 'Blocked'}
      </button>
      <span class="to-muted" data-rstatus="${bot.bot_id}"></span>
    </div>`;
  }

  function renderReadiness(r) {
    const wrap = $('toReadiness');
    if (!r) { wrap.hidden = true; return; }
    wrap.hidden = false;

    const h = r.hierarchy || { removable: [], blocked: [] };
    const blocked = h.blocked || [];
    $('toReadyHierarchy').innerHTML =
      `<h5>Can we remove them?</h5>` +
      (blocked.length
        ? `<div class="big bad">${blocked.length} blocked</div>
           <ul>${blocked.map(b => `<li>${esc(b.name)} — tops out at <strong>${esc(b.topRole)}</strong> (${b.position}), our bot is ${h.botPosition}</li>`).join('')}</ul>
           <div class="to-muted" style="margin-top:.4rem">Raise our bot's role above theirs, or nothing can be retired.</div>`
        : `<div class="big good">✅ all ${h.removable?.length ?? 0} removable</div>
           <div class="to-muted" style="margin-top:.35rem">Our role (${h.botPosition}) is above every target bot's highest role.</div>`);

    const s = r.security || { warnings: [] };
    $('toReadySecurity').innerHTML =
      `<h5>Server security</h5>
       <div>Verification: <strong class="${(s.warnings||[]).some(w=>/Verification/.test(w))?'warn':''}">${esc(s.verification)}</strong></div>
       <div>2FA for mod: <strong class="${s.twoFactorForMod?'good':'warn'}">${s.twoFactorForMod?'required':'OFF'}</strong></div>
       <div>Explicit filter: <strong>${esc(s.explicitContentFilter)}</strong></div>` +
      ((s.warnings||[]).length ? `<ul>${s.warnings.map(w=>`<li class="warn">${esc(w)}</li>`).join('')}</ul>` : '');

    const g = r.roleHygiene || { duplicates: [], emptyRoles: 0, placeholderRoles: 0 };
    $('toReadyHygiene').innerHTML =
      `<h5>Role hygiene</h5>
       <div>Empty roles: <strong>${g.emptyRoles}</strong></div>
       <div>Unnamed "new role": <strong>${g.placeholderRoles}</strong></div>` +
      ((g.duplicates||[]).length
        ? `<div style="margin-top:.35rem">Duplicate-named roles (Carl-bot leftovers):</div>
           <ul>${g.duplicates.map(d=>`<li>${esc(d.name)} ×${d.count}</li>`).join('')}</ul>`
        : `<div class="to-muted" style="margin-top:.35rem">No duplicate-named roles.</div>`);

    const gaps = r.parityGaps || [];
    $('toReadyGaps').innerHTML =
      `<h5>Parity gaps &amp; notes</h5>` +
      (gaps.length ? `<ul>${gaps.map(x=>`<li><strong class="warn">${esc(x.feature)}</strong> — ${esc(x.detail)}</li>`).join('')}</ul>` : '') +
      ((r.notes||[]).length ? `<ul>${r.notes.map(n=>`<li class="to-muted">${esc(n)}</li>`).join('')}</ul>` : '');
  }

  // One badge class + wording per honest status. Only 'blocked' is a problem; the rest are fine.
  const STATUS_META = {
    done:          { cls:'ok',   text:'done' },
    ready:         { cls:'rdy',  text:'ready to apply' },
    sequenced:     { cls:'seq',  text:'after OwO removal' },
    deliberate:    { cls:'seq',  text:'deliberate action' },
    'needs-input': { cls:'warn', text:'needs your input' },
    'no-op':       { cls:'ok',   text:'no setup needed' },
    declined:      { cls:'off',  text:'she said no' },
    blocked:       { cls:'no',   text:'blocked' },
  };
  // The reason line comes from whichever intent field is set — not always `blocked`. `declined` goes
  // first: once she has said no, why we COULD have done it is not the interesting part.
  const stepReason = (s) => s.declined || s.blocked || s.sequenced || s.deliberate || s.needsInput || s.noop || null;

  function renderHeadline(p) {
    const c = p.summary?.counts || {};
    const order = ['done','ready','deliberate','sequenced','needs-input','no-op','declined','blocked'];
    const chips = order.filter(k => c[k]).map(k => {
      const m = STATUS_META[k];
      return `<span class="to-sum-chip ${m.cls}">${c[k]} ${esc(m.text)}</span>`;
    }).join('');
    const blocked = c.blocked || 0;
    const lead = blocked
      ? `<strong class="bad">${blocked} real blocker${blocked>1?'s':''}</strong> — everything else is done, ready, or working as intended.`
      : `<strong class="good">No blockers.</strong> Everything is done, one click away, or intentionally hand-driven.`;
    return `<div class="to-sum">${lead}<div class="to-sum-chips">${chips}</div></div>`;
  }

  /**
   * The owner's answers.
   *
   * Rendered above the steps, and the "does not want" list is given equal weight to the "wants" —
   * a takeover goes wrong by switching on something nobody asked for far more often than by
   * forgetting something they did.
   */
  function renderDecisions(d) {
    const box = $('toDecisions');
    if (!d) { box.hidden = true; return; }
    box.hidden = false;

    const pct = Math.round(((d.questions.answered + d.catalogue.answered)
      / (d.questions.total + d.catalogue.total)) * 100);
    const head = d.complete
      ? `<span class="good">Answered in full.</span>`
      : `<span class="warn">${pct}% answered</span> — ${d.questions.answered}/${d.questions.total} questions, `
        + `${d.catalogue.answered}/${d.catalogue.total} features.`;

    const rows = (d.decisions || []).map(x => `
      <div class="to-dec">
        <div class="to-dec-q">${esc(x.q)}</div>
        <div class="to-dec-a">${x.answer ? esc(x.answer) : '<span class="to-muted">—</span>'}</div>
        ${x.note ? `<div class="to-dec-n">“${esc(x.note)}”</div>` : ''}
      </div>`).join('');

    const chips = (list, cls) => list.map(c => `<span class="to-feat ${cls}">${esc(c.name)}</span>`).join('');

    box.innerHTML = `
      <div class="to-card">
        <h4 class="to-h">What she asked for</h4>
        <div class="to-muted">${head}</div>
        <div class="to-dec-grid">${rows}</div>

        ${d.spareRoleNames?.length ? `
          <h5 class="to-sub">The spare roles, in her words</h5>
          <div class="to-feats">${d.spareRoleNames.map(n => `<span class="to-feat yes">${esc(n)}</span>`).join('')}</div>` : ''}

        <h5 class="to-sub">Wants switched on <span class="to-muted">(${d.wanted.length})</span></h5>
        <div class="to-feats">${chips(d.wanted, 'yes') || '<span class="to-muted">—</span>'}</div>

        <h5 class="to-sub">Does <em>not</em> want <span class="to-muted">(${d.unwanted.length})</span></h5>
        <div class="to-feats">${chips(d.unwanted, 'no') || '<span class="to-muted">—</span>'}</div>
        <div class="to-muted">Leave these alone. Switching one on because it seemed like a nice idea is the
          exact thing she was asked in order to prevent.</div>

        ${d.needsExplaining?.length ? `
          <h5 class="to-sub">She wants these explained <span class="to-muted">(${d.needsExplaining.length})</span></h5>
          <div class="to-feats">${chips(d.needsExplaining, 'ask')}</div>
          <div class="to-muted">These are questions back to us, not answers. Answer them before assuming either way.</div>` : ''}
      </div>`;
  }

  function renderSteps(p) {
    renderDecisions(p.decisions);
    renderReadiness(p.readiness);
    const headline = renderHeadline(p);
    $('toSteps').innerHTML = headline + (p.steps.map(s => {
      const st = s.status || (s.done ? 'done' : s.blocked ? 'blocked' : 'ready');
      const m = STATUS_META[st] || STATUS_META.ready;
      const reason = stepReason(s);
      const applyable = st === 'ready';
      return `
      <div class="to-step to-st-${st}">
        <input type="checkbox" data-step="${esc(s.key)}" ${applyable ? 'checked' : 'disabled'}>
        <div>
          <strong>${esc(s.label)}</strong>
          <span class="to-tag ${m.cls}">${esc(m.text)}</span>
          ${s.replaces ? `<span class="to-muted"> — replaces ${esc(s.replaces)}</span>` : ''}
          ${s.note ? `<div class="to-muted">${esc(s.note)}</div>` : ''}
          ${reason ? `<div class="to-muted">${esc(reason)}</div>` : ''}
          ${s.ownerNote ? `<div class="to-ownernote">“${esc(s.ownerNote)}” <span class="to-muted">— the owner</span></div>` : ''}
        </div>
      </div>`;
    }).join('') || '<div class="to-muted">Nothing to do.</div>');
    $('toApply').disabled = !p.actionable.length;
  }

  /**
   * Her answers. An unanswered question is shown as loudly as an answered one — the gaps are the
   * point. A note with no chosen option is still a real answer (on the free-text questions it is the
   * ONLY possible answer), so it must never render as "not answered".
   */
  function renderQuestionnaire(d) {
    const url = $('toQUrl');
    if (d.url) {
      url.hidden = false;
      url.innerHTML = `<code class="to-code">${esc(d.url)}</code>
        <button class="btn btn-secondary to-copy" data-copy="${esc(d.url)}">Copy</button>`;
      $('toQLink').hidden = true;
      $('toQRevoke').hidden = false;
    } else {
      url.hidden = true;
      $('toQLink').hidden = false;
      $('toQRevoke').hidden = true;
    }

    const total = d.questions.length;
    let html = `<div class="to-qsum">${d.answered} of ${total} answered${
      d.answered === 0 ? ' — she has not opened it yet, or has not started' : ''}</div>`;

    let section = null;
    for (const q of d.questions) {
      if (q.section !== section) { section = q.section; html += `<div class="to-qsec">${esc(section)}</div>`; }

      const a = d.answers[q.key];
      const note = (a?.note ?? '').trim();
      const chosen = q.options.find(o => o.v === a?.value);
      const answered = !!(a?.value || note);

      html += `<div class="to-q ${answered ? 'yes' : 'no'}">`;
      html += `<div class="to-qq">${esc(q.q)}</div>`;
      if (!answered) {
        html += `<div class="to-qa waiting">waiting on her</div>`;
      } else {
        if (chosen) html += `<div class="to-qa">${esc(chosen.label)}${chosen.detail ? ` <span class="to-muted">— ${esc(chosen.detail)}</span>` : ''}</div>`;
        else if (a.value) html += `<div class="to-qa">${esc(a.value)}</div>`;
        if (note) html += `<blockquote class="to-qnote">${esc(note)}</blockquote>`;
        if (a.updatedAt) html += `<div class="to-qwhen">${new Date(a.updatedAt).toLocaleString()}</div>`;
      }
      html += '</div>';
    }

    // The feature menu. Only what she actually touched is shown — 44 untouched rows would bury the
    // handful she picked, and "she didn't pick it" is not information worth 44 lines.
    const cat = d.catalogue || [];
    const picked = cat.filter(c => d.answers[c.key]?.value);
    html += `<div class="to-qsec">Features she picked${picked.length ? '' : ' — none yet'}</div>`;

    if (picked.length) {
      const want    = picked.filter(c => d.answers[c.key].value === 'yes');
      const explain = picked.filter(c => d.answers[c.key].value === 'explain');
      const nope    = picked.filter(c => d.answers[c.key].value === 'no');

      const list = (arr, cls, lead) => arr.length
        ? `<div class="to-q ${cls}"><div class="to-qq">${lead} <span class="to-muted">(${arr.length})</span></div>
             <div class="to-qa">${arr.map(c => esc(c.name)).join(' · ')}</div></div>`
        : '';

      // "Tell me more" first: it is the only one that is a job for us right now.
      html += list(explain, 'ask',  'Wants these explained');
      html += list(want,    'yes',  'Wants these');
      html += list(nope,    'no',   'Does not want these');
    } else {
      html += `<div class="to-q no"><div class="to-qa waiting">she has not been through the menu</div></div>`;
    }

    $('toQ').innerHTML = html;
    $('toQ').classList.remove('to-muted');
  }

  const CONF = {
    certain: ['ok',  'certain'],
    likely:  ['warn','likely — worth a look'],
    guess:   ['ask', 'A GUESS — check this'],
    unknown: ['no',  'could not work it out'],
    none:    ['no',  'nothing found'],
  };

  /**
   * The recovered profile.
   *
   * The review list goes FIRST and stays loud. Derivation is genuinely good at some of this (a
   * Twitch handle in an announcement is not an inference) and genuinely bad at other parts (which
   * role a panel's 🧡 button grants is nowhere in the message). Rendering both at the same visual
   * weight would invite someone to approve a guess by reflex.
   */
  function renderProfile(d) {
    const p = d.profile;
    const btnDerive = $('toDerive');
    const btnApprove = $('toApprove');

    if (d.handVerified) {
      $('toProfile').innerHTML =
        `<div class="to-q yes"><div class="to-qq">Hand-verified profile</div>
         <div class="to-qa">This server's profile is written and checked by hand, which always beats a
         derived one — a machine cannot recover the emoji-to-role mapping. Reading the history again
         is harmless, but it will not override it.</div></div>`;
      btnApprove.hidden = true;
      return;
    }

    if (!p) {
      $('toProfile').innerHTML =
        `<div class="to-q no"><div class="to-qa waiting">No profile yet. Until there is one, the
         steps that need this server's own data — its streamer, its role panels, its custom commands
         — are not offered at all.</div></div>`;
      btnApprove.hidden = true;
      return;
    }

    const approved = p.status === 'approved';
    btnApprove.hidden = approved;
    btnDerive.textContent = 'Read it again';

    let html = `<div class="to-qsum">${approved
      ? '<b style="color:#57F287">Approved</b> — the plan can use this.'
      : '<b style="color:#FEE75C">Proposed.</b> Nothing will be written from this until you approve it.'}
      Read ${p.stats?.messagesRead ?? '?'} messages across ${p.stats?.channelsRead ?? '?'} channels.</div>`;

    // Review list first. These are the fields that will be wrong.
    if (d.review?.length) {
      html += `<div class="to-qsec">Check these before approving</div>`;
      for (const r of d.review) {
        const [cls, label] = CONF[r.confidence] ?? ['warn', r.confidence];
        html += `<div class="to-q ${cls}">
          <div class="to-qq">${esc(r.key)} <span class="to-tag ${cls === 'ask' ? 'warn' : 'seq'}">${esc(label)}</span></div>
          <div class="to-qa">${esc(r.evidence)}</div></div>`;
      }
    }

    html += `<div class="to-qsec">What it found</div>`;
    const rows = [
      ['Streamer',        p.streamers,        v => v.length ? v.map(s => `${s.platform}/${s.username}${s.pingRoleId === 'everyone' ? ' (@everyone)' : ''}`).join(', ') : '—'],
      ['Role panels',     p.panels,           v => v.length ? v.map(x => `${x.name} (${x.options.length})`).join(' · ') : '—'],
      ['Panel channel',   p.selfAssignChannel,v => v ? `<code class="to-code">${v}</code>` : '—'],
      ['Custom commands', p.customCommands,   v => v.length ? v.map(c => c.prefix + c.name).join(', ') : '—'],
      ['Birthday role',   p.birthdayRole,     v => v ? `<code class="to-code">${v}</code>` : '—'],
      ['Emoji to upload', p.platformEmoji,    v => v.length ? v.map(e => e.name).join(', ') : 'none needed'],
      ['Spare roles',     p.roleHygiene,      v => `${v.duplicates.length} empty duplicate(s), ${v.empty.length} other empty`],
    ];
    for (const [label, f, fmt] of rows) {
      if (!f) continue;
      const [cls, conf] = CONF[f.confidence] ?? ['warn', f.confidence];
      html += `<div class="to-q ${cls === 'ok' ? 'yes' : cls}">
        <div class="to-qq">${esc(label)} <span class="to-tag ${cls === 'ok' ? 'ok' : 'warn'}">${esc(conf)}</span></div>
        <div class="to-qa">${fmt(f.value)}</div>
        <div class="to-qwhen">${esc(f.evidence ?? '')}</div></div>`;
    }
    $('toProfile').innerHTML = html;
    $('toProfile').classList.remove('to-muted');
  }

  $('toDerive').addEventListener('click', async () => {
    const b = $('toDerive');
    b.disabled = true; b.textContent = 'Reading every channel…';
    try {
      await req(api('/profile/derive'), { method: 'POST' });
      renderProfile(await req(api('/profile')));
    } catch (err) { showError(err.message); }
    finally { b.disabled = false; b.textContent = 'Read it again'; }
  });

  $('toApprove').addEventListener('click', async () => {
    if (!confirm('Approve this profile? Only after this will the plan write any of it into the server. '
      + 'Check the guesses first — an unresolved panel button does nothing when clicked.')) return;
    try {
      await req(api('/profile/approve'), { method: 'POST' });
      renderProfile(await req(api('/profile')));
    } catch (err) { showError(err.message); }
  });

  async function load() {
    try {
      showError('');
      state = await req(api('/'));
      renderScan(state);
      renderBots(state);

      req(api('/profile')).then(renderProfile).catch(() => {
        $('toProfile').textContent = 'Could not load the profile.';
      });

      // Independent of the scan — her answers exist whether or not anyone has scanned anything.
      req(api('/questionnaire')).then(renderQuestionnaire).catch(() => {
        $('toQ').textContent = 'Could not load her answers.';
      });

      if (state.scanning && !poll) poll = setInterval(load, 3000);
      if (!state.scanning && poll) { clearInterval(poll); poll = null; }
    } catch (err) { showError(err.message); }
  }

  $('toQLink').addEventListener('click', async () => {
    try {
      const r = await req(api('/questionnaire/link'), { method: 'POST', body: JSON.stringify({ label: 'owner' }) });
      renderQuestionnaire(await req(api('/questionnaire')));
      void r;
    } catch (err) { showError(err.message); }
  });

  $('toQRevoke').addEventListener('click', async () => {
    if (!confirm('Revoke her link? The page stops working for her immediately. Her answers are kept.')) return;
    try {
      await req(api('/questionnaire/revoke'), { method: 'POST' });
      renderQuestionnaire(await req(api('/questionnaire')));
    } catch (err) { showError(err.message); }
  });

  root.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-copy]');
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy);
      const was = btn.textContent; btn.textContent = 'Copied';
      setTimeout(() => { btn.textContent = was; }, 1400);
    } catch { showError('Could not copy — select the link and copy it manually.'); }
  });

  $('toScan').addEventListener('click', async () => {
    if (!confirm('Read every message in every channel? This posts nothing, but can take a while.')) return;
    try { await req(api('/scan'), { method:'POST', body: JSON.stringify({ depth: $('toDepth').value }) }); await load(); }
    catch (err) { showError(err.message); }
  });
  $('toCancel').addEventListener('click', async () => { await req(api('/scan/cancel'), { method:'POST' }); await load(); });
  $('toResume').addEventListener('click', async () => {
    try { await req(api('/scan/resume'), { method:'POST' }); await load(); } catch (err) { showError(err.message); }
  });

  $('toPlan').addEventListener('click', async () => {
    try { renderSteps(await req(api('/plan'))); } catch (err) { showError(err.message); }
  });

  $('toAttrAll').addEventListener('click', async () => {
    const btn = $('toAttrAll');
    btn.disabled = true; btn.textContent = 'Attributing…';
    try {
      const r = await req(api('/auto-attribute-all'), { method: 'POST' });
      const el = $('toAttrAllResult');
      el.hidden = false;
      el.innerHTML = r.remaining
        ? `Attributed <strong>${r.matched}</strong> message shape(s). <strong>${r.remaining}</strong> still need a human — ` +
          r.results.map(x => `${esc(x.name)} (${x.remaining})`).join(', ') +
          `. Open those bots and tick the ones we cover.`
        : `Attributed <strong>${r.matched}</strong> message shape(s). <strong>Nothing left unexplained.</strong>`;
      await load();
    } catch (err) { showError(err.message); }
    finally { btn.disabled = false; btn.textContent = 'Auto-attribute everything we recognise'; }
  });

  $('toApply').addEventListener('click', async () => {
    const only = [...root.querySelectorAll('[data-step]:checked')].map(el => el.dataset.step);
    if (!only.length) return showError('Nothing selected.');
    try {
      const r = await req(api('/apply'), { method:'POST', body: JSON.stringify({ only }) });
      const applied = r.results.filter(x => x.outcome === 'applied').length;
      showError('');
      alert(`Applied ${applied} step(s).`);
      renderSteps(await req(api('/plan')));
    } catch (err) { showError(err.message); }
  });

  root.addEventListener('click', async (e) => {
    const toggle = e.target.closest('[data-toggle]');
    if (toggle) {
      const card = toggle.closest('.to-bot');
      card.classList.toggle('open');
      if (card.classList.contains('open')) await openBot(toggle.dataset.toggle).catch(err => showError(err.message));
      return;
    }

    const auto = e.target.closest('[data-auto]');
    if (auto) {
      try { const r = await req(api(`/bots/${auto.dataset.auto}/auto-attribute`), { method:'POST' });
        await openBot(auto.dataset.auto);
        if (r.remaining) showError(`${r.remaining} template(s) still need a human. Tick the ones we cover.`);
      } catch (err) { showError(err.message); }
      return;
    }

    const ack = e.target.closest('[data-ack]');
    if (ack) {
      if (!confirm('Confirm the data has been exported? This cannot be undone once the bot is removed.')) return;
      try { await req(api(`/bots/${ack.dataset.ack}/extraction-ack`), { method:'POST' }); await openBot(ack.dataset.ack); }
      catch (err) { showError(err.message); }
      return;
    }

    const rm = e.target.closest('[data-retire]');
    if (rm) {
      const botId = rm.dataset.retire;
      const confirmEl = root.querySelector(`[data-confirm="${botId}"]`);
      const status = root.querySelector(`[data-rstatus="${botId}"]`);
      if (!confirm(`Remove this bot from ${guildName}? Its stored data is gone for good.`)) return;
      rm.disabled = true;
      try {
        const r = await req(api(`/bots/${botId}/retire`), { method:'POST', body: JSON.stringify({ confirm: confirmEl.value }) });
        status.textContent = `Removed via ${r.method}.`;
        await load();
      } catch (err) { status.textContent = err.message; status.style.color = '#ED4245'; rm.disabled = false; }
    }
  });

  root.addEventListener('change', async (e) => {
    const box = e.target.closest('[data-attr]');
    if (!box) return;
    try {
      await req(api(`/templates/${box.dataset.attr}/attribute`), {
        method:'POST', body: JSON.stringify({ attributed: box.checked, feature: 'manual' }),
      });
    } catch (err) { showError(err.message); box.checked = !box.checked; }
  });

  window.addEventListener('beforeunload', () => poll && clearInterval(poll));
  load();
})();
</script>
