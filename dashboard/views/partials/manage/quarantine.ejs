<%#
  Quarantine: the quarantine role and on/off switch (POST update-quarantine), the members in
  quarantine now (POST release-quarantine) and how the /quarantine command works. Built on the
  settings-row kit (cf-settings.css, partials/kit/); ids, field names and forms are unchanged.
%>
<%
const qOn = !!(quarantineConfig && quarantineConfig.is_enabled);
const qRole = (quarantineConfig && quarantineConfig.quarantine_role_id) ? roles.find(r => r.id === quarantineConfig.quarantine_role_id) : null;
const qRoleLabel = (quarantineConfig && quarantineConfig.quarantine_role_id) ? (qRole ? qRole.name : 'Role not found') : 'Not set';
// Roles the bot cannot give: managed ones and any at or above its own highest role.
const qBotTop = (guild && guild.members && guild.members.me && guild.members.me.roles && guild.members.me.roles.highest) ? guild.members.me.roles.highest.position : null;
const qCantAssign = (r) => !!(r.managed || (qBotTop !== null && r.position >= qBotTop));
%>
<style>
    .q-user { display: flex; align-items: center; gap: var(--cf-2); min-width: 0; }
    .q-avatar { flex: none; width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--cf-border); }
    .q-avatar--blank { display: inline-flex; align-items: center; justify-content: center; background: var(--cf-surface-2); color: var(--cf-text-3); font-weight: 600; font-size: var(--cf-text-sm); }
    .q-user-text { min-width: 0; }
    .q-user-name { font-weight: 500; color: var(--cf-text); overflow-wrap: anywhere; }
    .q-user-id { display: inline-flex; align-items: center; gap: 2px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .q-reason { max-width: 20rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cf-text-2); }
    .q-muted { font-size: var(--cf-text-sm); color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    .q-cmd { margin: 0; padding: var(--cf-2) var(--cf-3); border-radius: var(--cf-radius); background: var(--cf-surface-2); border: 1px solid var(--cf-border);
        font-family: var(--cf-mono); font-size: var(--cf-text-sm); color: var(--cf-text); overflow-wrap: anywhere; white-space: pre-wrap; }
    .q-tips { margin: 0; padding-left: 1.1rem; font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); }
    @media (max-width: 640px) {
        .q-reason { max-width: none; white-space: normal; overflow-wrap: anywhere; }
    }
</style>

<div class="page-section q-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-user-lock"></i>
                <span>Quarantine</span>
            </div>
            <div class="page-section-subtitle">The holding role, who is in it now, and the commands moderators use.</div>
        </div>
    </div>

    <%- include('../kit/_kpis', { label: 'Quarantine at a glance', items: [
        { label: 'Quarantine role', value: qRoleLabel, small: true },
        { label: 'In quarantine', value: quarantinedUsers ? quarantinedUsers.length : 0 },
    ] }) %>

    <section class="cf-section" aria-labelledby="q-config-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="q-config-title">Quarantine settings</h2>
                <p class="cf-section-desc">When a member is quarantined, their roles are saved and removed (managed roles such as boosts stay) and they get the quarantine role.</p>
            </div>
        </header>
        <form class="cf-rows" action="/manage/<%= guild.id %>/update-quarantine" method="POST">
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="quarantine-enabled">Quarantine</label>
                    <p class="cf-row-desc" id="quarantine-enabled-desc">Let moderators quarantine members with <code>/admin mod quarantine</code>. Raid lockdowns set to Quarantine use the same role.</p>
                </div>
                <div class="cf-row-control">
                    <input class="cf-switch" type="checkbox" role="switch" id="quarantine-enabled" name="is_enabled" data-feature-switch aria-describedby="quarantine-enabled-desc" <%= qOn ? 'checked' : '' %>>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="quarantine-role">Quarantine role</label>
                    <p class="cf-row-desc" id="quarantine-role-desc">Give it as few permissions as possible, ideally only a quarantine channel. It must sit below the bot's highest role.</p>
                </div>
                <div class="cf-row-control">
                    <select class="form-select" id="quarantine-role" name="quarantine_role_id" required aria-describedby="quarantine-role-desc">
                        <option value="">Select a role</option>
                        <% roles.forEach(role => { const sel = !!(quarantineConfig && quarantineConfig.quarantine_role_id === role.id); const high = qCantAssign(role); %>
                            <option value="<%= role.id %>"<% if (role.hexColor && role.hexColor !== '#000000') { %> data-color="<%= role.hexColor %>"<% } %><%= sel ? ' selected' : '' %><%= (high && !sel) ? ' disabled' : '' %>><%= role.name %><%= high ? ' (above the bot)' : '' %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </section>

    <section class="cf-section" aria-labelledby="q-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="q-list-title">In quarantine now</h2>
                <p class="cf-section-desc">Releasing a member takes the quarantine role away and gives back the roles saved when they were quarantined.</p>
            </div>
            <div class="cf-section-actions"><span class="cf-pill"><%= quarantinedUsers ? quarantinedUsers.length : 0 %></span></div>
        </header>
        <div class="cf-rows">
            <% if (quarantinedUsers && quarantinedUsers.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Member</th>
                            <th scope="col">Quarantined by</th>
                            <th scope="col">Reason</th>
                            <th scope="col">Date</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% quarantinedUsers.forEach(user => { %>
                            <tr>
                                <td data-label="Member">
                                    <div class="q-user">
                                        <% if (user.avatar_url) { %>
                                            <img class="q-avatar" src="<%= user.avatar_url %>" alt="" width="32" height="32" loading="lazy">
                                        <% } else { %>
                                            <span class="q-avatar q-avatar--blank" aria-hidden="true"><%= user.username ? user.username.charAt(0).toUpperCase() : '?' %></span>
                                        <% } %>
                                        <div class="q-user-text">
                                            <div class="q-user-name"><%= user.username || 'Unknown member' %></div>
                                            <div class="q-user-id">
                                                <span class="cf-user-id"><%= user.user_id %></span><button type="button" class="cf-user-copy" title="Copy user ID" aria-label="Copy user ID"><i class="fas fa-copy" aria-hidden="true"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="Quarantined by">
                                    <div class="q-muted">
                                        <% if (user.moderator_id) { %><%- include('_user-cell', { cfUser: null, cfUserId: user.moderator_id, cfUserName: user.moderator_tag || null, cfUserSize: 'sm' }) %><% } else { %>System<% } %>
                                    </div>
                                </td>
                                <td data-label="Reason">
                                    <div class="q-reason" title="<%= user.reason || 'No reason given' %>"><%= user.reason || 'No reason given' %></div>
                                </td>
                                <td data-label="Date">
                                    <span class="q-muted"><%= user.quarantined_at ? new Date(user.quarantined_at).toLocaleDateString() : 'Unknown' %></span>
                                </td>
                                <td class="cf-cell-end">
                                    <form action="/manage/<%= guild.id %>/release-quarantine" method="POST">
                                        <input type="hidden" name="userId" value="<%= user.user_id %>">
                                        <button type="submit" class="btn btn-sm btn-secondary">Release</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No one is in quarantine', text: qOn ? 'Members quarantined with /admin mod quarantine or by a raid lockdown will be listed here.' : 'Turn quarantine on with the switch at the top of the page to start using it.', compact: false }) %>
            <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="q-usage-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="q-usage-title">Using quarantine</h2>
                <p class="cf-section-desc">Moderators run these commands in Discord.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--wide">
                <div class="cf-row-text">
                    <span class="cf-row-label">Quarantine a member</span>
                    <p class="cf-row-desc">Saves and removes their roles (except managed ones such as boosts) and gives them the quarantine role.</p>
                </div>
                <div class="cf-row-control"><code class="q-cmd">/admin mod quarantine user:@username enable:True</code></div>
            </div>
            <div class="cf-row cf-row--wide">
                <div class="cf-row-text">
                    <span class="cf-row-label">Release a member</span>
                    <p class="cf-row-desc">Removes the quarantine role and gives back the saved roles the bot can still assign. The Release button on this page does the same.</p>
                </div>
                <div class="cf-row-control"><code class="q-cmd">/admin mod quarantine user:@username enable:False</code></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <span class="cf-row-label">Good practice</span>
                </div>
                <ul class="q-tips">
                    <li>Set up a quarantine channel where quarantined members can appeal or talk to staff.</li>
                    <li>Give the quarantine role view access to that channel only.</li>
                    <li>Describe your quarantine policy in your server rules.</li>
                    <li>Use quarantine for cooling-off periods or investigations, not as a permanent punishment.</li>
                </ul>
            </div>
        </div>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.q-page .q-user-id .cf-user-copy').forEach(btn => btn.addEventListener('click', () => {
        const id = (btn.parentElement.querySelector('.cf-user-id') || {}).textContent;
        if (!navigator.clipboard || !id) return;
        navigator.clipboard.writeText(id.trim()).then(() => { if (window.showToast) showToast('User ID copied', 'success'); });
    }));
    // Confirm before releasing from quarantine
    const releaseForms = document.querySelectorAll('form[action*="release-quarantine"]');
    releaseForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            if (!confirm('Release this member from quarantine?')) {
                e.preventDefault();
            }
        });
    });
});
</script>
