<%#
  Mass actions: give or take a role from a list of members (POST mass-assign-role /
  mass-remove-role), kick or ban a list of members (POST mass-kick / mass-ban, each confirmed once with the member count),
  and the streamer subscription CSV export (GET export) and channel sync (POST import-team).
  Built on the settings-row kit (dashboard/public/css/cf-settings.css).
%>
<%
// Role pickers: the bot can only give or take roles below its own highest role (server.js checks
// role.editable), so those are shown but disabled. Voice channels are text-based in discord.js too.
const massBotTop = (guild && guild.members && guild.members.me && guild.members.me.roles && guild.members.me.roles.highest) ? guild.members.me.roles.highest.position : Infinity;
const massColor = (r) => (r && r.hexColor && r.hexColor !== '#000000') ? r.hexColor : '';
const massTextChannels = (channels || []).filter(c => !(c && typeof c.isVoiceBased === 'function' && c.isVoiceBased()));
%>
<style>
    .mass-count { font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-top: 4px; font-variant-numeric: tabular-nums; }
    .mass-count.is-bad { color: var(--cf-danger); }
    .mass-ids { font-family: var(--cf-mono); font-size: var(--cf-text-sm); resize: vertical; min-height: 5.5rem; }
    .mass-tips { margin: 0; padding-left: 1.1rem; display: grid; gap: 4px; font-size: var(--cf-text-sm); color: var(--cf-text-2); line-height: 1.5; }
    .mass-end { align-items: flex-end; }
    .mass-tips-label { margin: 0 0 var(--cf-2); font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text); }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-users-cog"></i>
                <span>Mass actions</span>
            </div>
            <div class="page-section-subtitle">Paste a list of user IDs and act on all of them at once.</div>
        </div>
    </div>

    <%- include('../kit/_kpis', { label: 'Server at a glance', items: [
        { label: 'Members', value: (guild.memberCount || 0).toLocaleString() },
        { label: 'Roles', value: roles ? roles.length : 0 },
        { label: 'Roles the bot can give', value: (roles || []).filter(r => !(typeof r.position === 'number' && r.position >= massBotTop)).length },
    ] }) %>

    <section class="cf-section" aria-labelledby="mass-assign-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mass-assign-title">Give a role to members</h2>
                <p class="cf-section-desc">Adds one role to every member in the list.</p>
            </div>
        </header>
        <form class="cf-rows" action="/manage/<%= guild.id %>/mass-assign-role" method="POST">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-mass-roleid">Role to give</label>
                </div>
                <div class="cf-row-control">
                    <select id="f-mass-roleid" class="form-select" name="roleId" required>
                        <option value="">Select a role</option>
                        <% roles.forEach(role => { const above = typeof role.position === 'number' && role.position >= massBotTop; %>
                            <option value="<%= role.id %>" data-kind="role" data-color="<%= massColor(role) %>"<%= above ? ' disabled' : '' %>><%= role.name %><%= above ? ' (above the bot)' : '' %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-mass-userids">Members</label>
                    <p class="cf-row-desc" id="f-mass-userids-desc">User IDs, separated by commas, spaces or new lines.</p>
                </div>
                <div class="cf-row-control">
                    <textarea id="f-mass-userids" class="form-control mass-ids" name="userIds" rows="3" placeholder="123456789012345678, 234567890123456789" aria-describedby="f-mass-userids-desc" required></textarea>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="submit" class="btn btn-primary">Give role</button>
            </div>
        </form>
    </section>

    <section class="cf-section" aria-labelledby="mass-remove-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mass-remove-title">Take a role from members</h2>
                <p class="cf-section-desc">Removes one role from every member in the list.</p>
            </div>
        </header>
        <form class="cf-rows" action="/manage/<%= guild.id %>/mass-remove-role" method="POST">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-mass-roleid-2">Role to take away</label>
                </div>
                <div class="cf-row-control">
                    <select id="f-mass-roleid-2" class="form-select" name="roleId" required>
                        <option value="">Select a role</option>
                        <% roles.forEach(role => { const above = typeof role.position === 'number' && role.position >= massBotTop; %>
                            <option value="<%= role.id %>" data-kind="role" data-color="<%= massColor(role) %>"<%= above ? ' disabled' : '' %>><%= role.name %><%= above ? ' (above the bot)' : '' %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-mass-userids-2">Members</label>
                    <p class="cf-row-desc" id="f-mass-userids-2-desc">User IDs, separated by commas, spaces or new lines.</p>
                </div>
                <div class="cf-row-control">
                    <textarea id="f-mass-userids-2" class="form-control mass-ids" name="userIds" rows="3" placeholder="123456789012345678, 234567890123456789" aria-describedby="f-mass-userids-2-desc" required></textarea>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="submit" class="btn btn-secondary">Take role</button>
            </div>
        </form>
    </section>

    <section class="cf-section cf-section--danger" aria-labelledby="mass-mod-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mass-mod-title">Kick or ban members</h2>
                <p class="cf-section-desc">These cannot be undone from here. You are asked to confirm, with the number of members, before anything happens.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form action="/manage/<%= guild.id %>/mass-kick" method="POST">
                <div class="cf-rows-head" id="mass-kick-head">Kick</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-userids-3">Members to kick</label>
                        <p class="cf-row-desc" id="f-mass-userids-3-desc">User IDs, separated by commas, spaces or new lines. Kicked members can rejoin with an invite.</p>
                    </div>
                    <div class="cf-row-control">
                        <textarea id="f-mass-userids-3" class="form-control mass-ids" name="userIds" rows="3" placeholder="123456789012345678, 234567890123456789" aria-describedby="f-mass-userids-3-desc" required></textarea>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-reason">Reason</label>
                        <p class="cf-row-desc">Shown in the audit log.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-mass-reason" type="text" class="form-control" name="reason" placeholder="Mass moderation action" required>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-danger">Kick members</button>
                </div>
            </form>
            <form action="/manage/<%= guild.id %>/mass-ban" method="POST">
                <div class="cf-rows-head" id="mass-ban-head">Ban</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-userids-4">Members to ban</label>
                        <p class="cf-row-desc" id="f-mass-userids-4-desc">User IDs, separated by commas, spaces or new lines. Members who have already left can be banned too.</p>
                    </div>
                    <div class="cf-row-control">
                        <textarea id="f-mass-userids-4" class="form-control mass-ids" name="userIds" rows="3" placeholder="123456789012345678, 234567890123456789" aria-describedby="f-mass-userids-4-desc" required></textarea>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-reason-2">Reason</label>
                        <p class="cf-row-desc">Shown in the audit log.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-mass-reason-2" type="text" class="form-control" name="reason" placeholder="Mass moderation action" required>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-deletemessagedays">Delete their recent messages</label>
                        <p class="cf-row-desc">How far back Discord removes their messages.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-mass-deletemessagedays" class="form-select" name="deleteMessageDays">
                            <option value="0">Don't delete messages</option>
                            <option value="1">1 day</option>
                            <option value="7" selected>7 days</option>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-danger">Ban members</button>
                </div>
            </form>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="mass-csv-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mass-csv-title">Streamer subscriptions as CSV</h2>
                <p class="cf-section-desc">Export every streamer subscription in this server, or make one channel's subscriptions match a file.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Export</span>
                    <p class="cf-row-desc">One CSV file with every subscription. Useful as a backup or to move them to another server.</p>
                </div>
                <div class="cf-row-control mass-end">
                    <a href="/manage/<%= guild.id %>/export" class="btn btn-secondary">Download CSV</a>
                </div>
            </div>
            <form action="/manage/<%= guild.id %>/import-team" method="POST" enctype="multipart/form-data">
                <div class="cf-rows-head" id="mass-import-head">Sync a channel from a file</div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-channelid">Channel</label>
                        <p class="cf-row-desc">Streamers in this channel who are not in the file are removed.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-mass-channelid" name="channelId" class="form-select" required>
                            <option value="" disabled selected>Select a channel</option>
                            <% massTextChannels.forEach(channel => { %>
                                <option value="<%= channel.id %>">#<%= channel.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-mass-csvfile">CSV file</label>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-mass-csvfile" class="form-control" type="file" name="csvfile" accept=".csv" required>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Sync from CSV</button>
                </div>
            </form>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="mass-tips-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mass-tips-title">Before you run a bulk action</h2>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div>
                    <p class="mass-tips-label">Getting user IDs</p>
                    <ul class="mass-tips">
                        <li>Turn on Developer Mode in Discord's settings (Advanced).</li>
                        <li>Right-click a member and choose Copy User ID.</li>
                        <li>Separate several IDs with commas, spaces or new lines.</li>
                        <li>The member list can give you IDs in bulk.</li>
                    </ul>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div>
                    <p class="mass-tips-label">Good practice</p>
                    <ul class="mass-tips">
                        <li>Double-check the IDs before a kick or ban.</li>
                        <li>Try a small batch first.</li>
                        <li>Export subscriptions regularly as a backup.</li>
                        <li>Give a clear reason so the audit log explains the action.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Format user ID inputs
    const userIdInputs = document.querySelectorAll('textarea[name="userIds"]');

    // The same split server.js uses (massUserIds): commas or whitespace, 17-20 digit IDs.
    const parseIds = (text) => {
        const tokens = String(text || '').split(/[\s,]+/).filter(Boolean);
        const valid = [...new Set(tokens.filter(t => /^\d{17,20}$/.test(t)))];
        return { valid, invalid: tokens.filter(t => !/^\d{17,20}$/.test(t)).length };
    };
    userIdInputs.forEach(input => {
        const note = document.createElement('div');
        note.className = 'mass-count';
        note.setAttribute('aria-live', 'polite');
        input.insertAdjacentElement('afterend', note);
        const paint = () => {
            const { valid, invalid } = parseIds(input.value);
            note.textContent = !input.value.trim() ? '' : valid.length + (valid.length === 1 ? ' member' : ' members')
                + (invalid ? ', ' + invalid + ' not a user ID (ignored)' : '');
            note.classList.toggle('is-bad', invalid > 0);
        };
        input.addEventListener('input', paint);
        input.addEventListener('blur', function() {
            // Tidy the list: one ID per comma, no stray spaces.
            const tokens = this.value.split(/[\s,]+/).filter(Boolean);
            this.value = tokens.join(', ');
            paint();
        });
    });

    // Kick and ban ask once, naming how many members (distinct IDs) the action will hit.
    const dangerForms = document.querySelectorAll('form[action*="mass-kick"], form[action*="mass-ban"]');

    dangerForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            const count = parseIds(this.querySelector('textarea[name="userIds"]').value).valid.length;
            const action = this.action.includes('mass-kick') ? 'kick' : 'ban';

            if (count === 0) {
                e.preventDefault();
                alert('Enter at least one user ID (17 to 20 digits).');
                return;
            }

            const who = `${count} member${count === 1 ? '' : 's'}`;
            const question = action === 'kick'
                ? `Kick ${who}? They can rejoin with an invite.`
                : `Ban ${who}? They stay banned until someone unbans them.`;
            if (!confirm(question)) e.preventDefault();
        });
    });

    // File upload feedback
    const fileInputs = document.querySelectorAll('input[type="file"]');

    fileInputs.forEach(input => {
        input.addEventListener('change', function() {
            if (this.files.length > 0) {
                const file = this.files[0];
                if (!file.name.endsWith('.csv')) {
                    alert('Choose a CSV file.');
                    this.value = '';
                }
            }
        });
    });
});
</script>
