<%#
  Stat displays: voice channels the bot renames to show a live number, the time or the date.
  The list is server-rendered; add (POST), edit (PATCH) and remove (DELETE) go through
  /api/guilds/:id/core/stat-displays. Built on the settings-row kit (cf-settings.css); ids,
  data attributes and handlers are unchanged.
%>
<% const sdList = typeof statDisplayChannels !== 'undefined' ? statDisplayChannels : []; %>
<% const vcList = typeof voiceChannels !== 'undefined' ? voiceChannels : []; %>
<style>
    .sd-item { flex-wrap: wrap; }
    .sd-name { display: block; font-weight: 600; color: var(--cf-text); }
    .sd-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 4px; color: var(--cf-text-3); font-size: var(--cf-text-xs); }
    .sd-meta code { overflow-wrap: anywhere; }
    .sd-edit { flex: 1 1 100%; padding-top: var(--cf-3); border-top: 1px dashed var(--cf-border); }
    .sd-edit[hidden] { display: none; }
    .sd-edit .sd-preview { margin-top: var(--cf-2); }
    .sd-edit-row { display: flex; gap: var(--cf-2); align-items: flex-end; flex-wrap: wrap; }
    .sd-edit-row .cf-field { flex: 1 1 14rem; }
    .sd-preview { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 12px; max-width: 100%;
        border-radius: var(--cf-radius); background: var(--cf-surface-2); border: 1px solid var(--cf-border);
        color: var(--cf-text); font-weight: 600; font-size: var(--cf-text-sm); overflow-wrap: anywhere; }
    .sd-preview i { color: var(--cf-text-3); font-size: 0.85em; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-tv"></i>
                <span>Stat displays</span>
            </div>
            <div class="page-section-subtitle">
                Discord lets the bot rename a channel about twice every 10 minutes, so names lag a little behind.
            </div>
        </div>
    </div>

    <section class="cf-section" aria-labelledby="sd-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="sd-list-title">Displays</h2>
                <p class="cf-section-desc"><%= sdList.length ? `${sdList.length} channel${sdList.length === 1 ? '' : 's'} kept up to date.` : 'Channels the bot keeps renamed.' %></p>
            </div>
            <div class="cf-section-actions"><span id="cfk-sd-list-status" class="cf-status-line" role="status" aria-live="polite"></span></div>
        </header>
        <div class="cf-rows">
            <% if (sdList.length > 0) { %>
            <div class="cf-list">
                <% sdList.forEach(sd => {
                    const config = sd.config ? (typeof sd.config === 'string' ? JSON.parse(sd.config) : sd.config) : {};
                    const roleInfo = sd.stat_type === 'role' && config.role_id ? (typeof roles !== 'undefined' ? roles.find(r => r.id === config.role_id) : null) : null;
                    const vc = vcList.find(v => v.id === sd.channel_id);
                    const label = sd.stat_type === 'role' ? 'Members with ' + (sd.role_name || (roleInfo ? roleInfo.name : 'a deleted role'))
                        : sd.stat_type === 'twitch_followers' ? 'Twitch followers of ' + (config.twitch_username || 'an unknown channel')
                        : ({ members: 'Total members', humans: 'Human members', bots: 'Bots', online: 'Online members', channels: 'Channel count', roles: 'Role count', boosts: 'Server boosts', time: 'Local time', date: 'Local date' })[sd.stat_type] || sd.stat_type.replace('_', ' ');
                %>
                <div class="cf-list-item sd-item">
                    <div class="cf-list-main">
                        <span class="sd-name"><%= label %></span>
                        <span class="sd-meta">
                            <% if (vc) { %><span><i class="fas fa-volume-up" aria-hidden="true"></i> <%= vc.name %></span><% } else { %><span>Channel <code><%= sd.channel_id %></code></span><% } %>
                            <span class="cf-token"><%= sd.template %></span>
                        </span>
                    </div>
                    <div class="cf-list-actions">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEditSd(<%= sd.id %>)" aria-controls="sd-edit-<%= sd.id %>" aria-expanded="false">Edit</button>
                        <button type="button" class="btn btn-danger btn-sm sd-remove-btn" data-id="<%= sd.id %>">Remove</button>
                    </div>
                    <div id="sd-edit-<%= sd.id %>" class="sd-edit" hidden>
                        <div class="sd-edit-row">
                            <div class="cf-field">
                                <label for="sd-template-<%= sd.id %>">Channel name</label>
                                <input type="text" id="sd-template-<%= sd.id %>" value="<%= sd.template %>" class="form-control sd-edit-template" maxlength="100" data-type="<%= sd.stat_type %>">
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" onclick="saveSd(<%= sd.id %>)">Save</button>
                        </div>
                        <p class="cf-field-hint">Put <code>{value}</code> where the number or text goes, for example <code>Members: {value}</code>. At most 100 characters.</p>
                        <span class="sd-preview"><i class="fas fa-volume-up" aria-hidden="true"></i><span class="sd-edit-preview"><%= String(sd.template || '').replace('{value}', '42') %></span></span>
                        <span class="cf-status-line sd-edit-status" role="status" aria-live="polite"></span>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No stat displays yet', text: 'Add one below to show a live count in a voice channel name.', id: null, boxed: false, compact: false }) %>

            <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="sd-add-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="sd-add-title">Add a display</h2>
                <p class="cf-section-desc">Choose a voice channel and what its name should show.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="sd-add-error" class="sd-error cf-notice is-bad" role="alert" hidden></div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="sd-channel">Voice channel</label>
                    <p class="cf-row-desc">Use an existing voice channel, or let the bot create one that members cannot join. The bot needs Manage Channels.</p>
                </div>
                <div class="cf-row-control">
                    <select id="sd-channel" class="form-select">
                        <option value="">Choose a voice channel</option>
                        <option value="create">Create a new channel</option>
                        <% vcList.forEach(vc => { %>
                        <option value="<%= vc.id %>"><%= vc.name %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="sd-type">What it shows</label>
                    <p class="cf-row-desc">Time reads like 7:36pm and date like Sunday, Mar 22nd, in the server's timezone. A role count is the members who have one role; Twitch shows a channel's followers.</p>
                </div>
                <div class="cf-row-control">
                    <select id="sd-type" class="form-select">
                        <optgroup label="Counts">
                            <option value="members">Total members</option>
                            <option value="humans">Human members</option>
                            <option value="bots">Bots</option>
                            <option value="online">Online members</option>
                            <option value="channels">Channel count</option>
                            <option value="roles">Role count</option>
                            <option value="boosts">Server boosts</option>
                        </optgroup>
                        <optgroup label="Role">
                            <option value="role">Members with a role</option>
                        </optgroup>
                        <optgroup label="Social">
                            <option value="twitch_followers">Twitch followers</option>
                        </optgroup>
                        <optgroup label="Date and time">
                            <option value="time">Local time</option>
                            <option value="date">Local date</option>
                        </optgroup>
                    </select>
                </div>
            </div>
            <div id="sd-role-row" hidden>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sd-role">Role to count</label>
                        <p class="cf-row-desc">The name shows how many members have this role.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="sd-role" class="form-select">
                            <option value="">Choose a role</option>
                            <% if (typeof roles !== 'undefined') { roles.forEach(role => { %>
                            <option value="<%= role.id %>"><%= role.name %></option>
                            <% }); } %>
                        </select>
                    </div>
                </div>
            </div>
            <div id="sd-twitch-row" hidden>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sd-twitch-username">Twitch channel</label>
                        <p class="cf-row-desc">The name shows this channel's follower count.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="text" id="sd-twitch-username" class="form-control" placeholder="Twitch username" maxlength="25" autocomplete="off" spellcheck="false">
                    </div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="sd-template">Channel name</label>
                    <p class="cf-row-desc">Put <code>{value}</code> where the number or text goes. At most 100 characters.</p>
                </div>
                <div class="cf-row-control">
                    <input type="text" id="sd-template" class="form-control" placeholder="Members: {value}" maxlength="100">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Preview</span>
                    <p class="cf-row-desc">How the channel will read, with a sample value.</p>
                </div>
                <div class="cf-row-control">
                    <span class="sd-preview"><i class="fas fa-volume-up" aria-hidden="true"></i><span id="sd-preview">Members: 42</span></span>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="button" id="sd-add-btn" class="btn btn-primary"><span>Add display</span></button>
            </div>
        </div>
    </section>
</div>

<script>
(function() {
    var guildId = '<%= guild.id %>';
    var typeSelect = document.getElementById('sd-type');
    var templateInput = document.getElementById('sd-template');
    var roleRow = document.getElementById('sd-role-row');
    var roleSelect = document.getElementById('sd-role');
    var twitchRow = document.getElementById('sd-twitch-row');
    var twitchInput = document.getElementById('sd-twitch-username');
    var preview = document.getElementById('sd-preview');

    var defaults = {
        members: 'Members: {value}', humans: 'Humans: {value}', bots: 'Bots: {value}',
        online: 'Online: {value}', channels: 'Channels: {value}', roles: 'Roles: {value}',
        boosts: 'Boosts: {value}', time: '🕐 | {value}', date: '📅 | {value}',
        role: '{value} Members', twitch_followers: 'Followers: {value}'
    };

    var sampleValues = {
        members: '142', humans: '128', bots: '14', online: '47', channels: '32',
        roles: '18', boosts: '6', time: '7:36pm', date: 'Sunday, Mar 22nd', role: '23',
        twitch_followers: '12,345'
    };

    function updatePreview() {
        var tmpl = templateInput.value || defaults[typeSelect.value] || '{value}';
        var sample = sampleValues[typeSelect.value] || '42';
        preview.textContent = tmpl.replace('{value}', sample);
    }

    function updateConditionalRows() {
        roleRow.hidden = typeSelect.value !== 'role';
        twitchRow.hidden = typeSelect.value !== 'twitch_followers';
    }

    typeSelect.addEventListener('change', function() {
        var val = typeSelect.value;
        if (!templateInput.value || Object.values(defaults).includes(templateInput.value)) {
            templateInput.value = defaults[val] || '';
        }
        updateConditionalRows();
        updatePreview();
    });

    templateInput.addEventListener('input', updatePreview);
    templateInput.value = defaults[typeSelect.value] || '';
    updateConditionalRows();
    updatePreview();

    // Add stat display
    var addBtn = document.getElementById('sd-add-btn');
    addBtn.addEventListener('click', function() {
        var channelId = document.getElementById('sd-channel').value;
        var statType = typeSelect.value;
        var template = templateInput.value.trim();
        var errorDiv = document.getElementById('sd-add-error');
        errorDiv.hidden = true;

        if (!channelId) { errorDiv.textContent = 'Choose a voice channel.'; errorDiv.hidden = false; return; }
        if (!template || !template.includes('{value}')) { errorDiv.textContent = 'The channel name must include {value}.'; errorDiv.hidden = false; return; }
        if (statType === 'role' && !roleSelect.value) { errorDiv.textContent = 'Choose a role to count.'; errorDiv.hidden = false; return; }
        if (statType === 'twitch_followers' && !/^[A-Za-z0-9_]{3,25}$/.test(twitchInput.value.trim())) { errorDiv.textContent = 'Enter a Twitch username: 3 to 25 letters, numbers or underscores.'; errorDiv.hidden = false; return; }
        if (template.length > 100) { errorDiv.textContent = 'Channel names can be at most 100 characters.'; errorDiv.hidden = false; return; }

        var body = { channel_id: channelId, stat_type: statType, template: template };
        if (statType === 'role') body.role_id = roleSelect.value;
        if (statType === 'twitch_followers') body.twitch_username = twitchInput.value.trim();

        addBtn.disabled = true;
        addBtn.querySelector('span').textContent = 'Adding...';

        fetch('/api/guilds/' + guildId + '/core/stat-displays', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(body)
        })
        .then(function(r) {
            if (!r.ok) {
                return r.json().then(function(d) {
                    errorDiv.textContent = d.error || 'Failed';
                    errorDiv.hidden = false;
                    addBtn.disabled = false;
                    addBtn.querySelector('span').textContent = 'Add display';
                });
            }
            window.location.reload();
        })
        .catch(function() {
            errorDiv.textContent = 'Network error';
            errorDiv.hidden = false;
            addBtn.disabled = false;
            addBtn.querySelector('span').textContent = 'Add display';
        });
    });

    function say(node, cls, text) {
        if (!node) return;
        node.className = node.className.replace(/\bis-(ok|bad|busy|warn)\b/g, '').trim() + (cls ? ' ' + cls : '');
        node.textContent = text;
    }

    // Remove (the channel itself is left alone; only the renaming stops).
    var listStatus = document.getElementById('cfk-sd-list-status');
    document.querySelectorAll('.sd-remove-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            if (!confirm('Stop renaming this channel? The channel itself is not deleted.')) return;
            btn.disabled = true;
            fetch('/api/guilds/' + guildId + '/core/stat-displays/' + btn.getAttribute('data-id'), { method: 'DELETE', credentials: 'same-origin' })
            .then(function(r) {
                if (!r.ok) return r.json().catch(function() { return {}; }).then(function(d) { throw new Error(d.error || ('HTTP ' + r.status)); });
                window.location.reload();
            })
            .catch(function(e) { say(listStatus, 'is-bad', 'Could not remove: ' + e.message); btn.disabled = false; });
        });
    });

    // Edit toggle, live preview and save
    window.toggleEditSd = function(id) {
        var box = document.getElementById('sd-edit-' + id);
        if (!box) return;
        box.hidden = !box.hidden;
        var toggle = document.querySelector('[aria-controls="sd-edit-' + id + '"]');
        if (toggle) toggle.setAttribute('aria-expanded', String(!box.hidden));
        if (!box.hidden) { var input = document.getElementById('sd-template-' + id); if (input) input.focus(); }
    };
    document.querySelectorAll('.sd-edit-template').forEach(function(input) {
        var out = input.closest('.sd-edit').querySelector('.sd-edit-preview');
        input.addEventListener('input', function() {
            out.textContent = (input.value || '{value}').replace('{value}', sampleValues[input.getAttribute('data-type')] || '42');
        });
        input.dispatchEvent(new Event('input'));
    });

    window.saveSd = function(id) {
        var input = document.getElementById('sd-template-' + id);
        var status = input.closest('.sd-edit').querySelector('.sd-edit-status');
        var template = input.value.trim();
        if (!template.includes('{value}')) { say(status, 'is-bad', 'The channel name must include {value}.'); input.focus(); return; }
        if (template.length > 100) { say(status, 'is-bad', 'Channel names can be at most 100 characters.'); input.focus(); return; }
        say(status, 'is-busy', 'Saving');
        fetch('/api/guilds/' + guildId + '/core/stat-displays/' + id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ template: template })
        })
        .then(function(resp) { return resp.json().catch(function() { return {}; }); })
        .then(function(data) {
            if (data.success) window.location.reload();
            else say(status, 'is-bad', data.error || 'Could not save');
        })
        .catch(function() { say(status, 'is-bad', 'Could not save. Check your connection.'); });
    };
})();
</script>
