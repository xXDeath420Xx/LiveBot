<%#
  Edit streamer dialog (POST edit-consolidated-streamer). The script below fills in one block per
  subscription when the dialog opens: where it posts, roles, the message with a live preview and a
  test post (POST /api/guilds/:id/streaming/test-alert), the go-live filters and the stream-end
  choice. Field names are unchanged. Everything from the database is put in with
  createElement/textContent. Delete posts to delete-subscription (a JSON call, not a nested form).
%>
<%
const esmSettings = (typeof settings !== 'undefined' && settings) || {};
const esmDefaultMsg = (esmSettings.announcement_message || '').trim() === '{streamer} is now live on {platform}! {url}' ? '' : (esmSettings.announcement_message || '');
const esmCanGive = (r) => { try { return r.editable !== false; } catch (e) { return true; } };
let esmBotName = 'Bot', esmBotAvatar = '';
try { esmBotName = guild.members.me.displayName || esmBotName; esmBotAvatar = guild.members.me.displayAvatarURL({ size: 64 }) || ''; } catch (e) { /* bot member not cached */ }
const esmData = {
    guildId: guild.id,
    channels: (channels || []).map(c => ({ id: c.id, name: c.name })),
    roles: (roles || []).map(r => ({ id: r.id, name: r.name, color: r.hexColor && r.hexColor !== '#000000' ? r.hexColor : '', assignable: esmCanGive(r) })),
    defaultMessage: esmDefaultMsg,
    defaultPersona: esmSettings.use_webhook_persona === 1,
    botName: esmBotName,
    botAvatar: esmBotAvatar,
};
%>
<style>
/* One subscription inside the dialog: a bordered group, not a card. */
#edit-streamer-modal .subscription-card { padding: var(--cf-4); margin-bottom: var(--cf-3); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface); transition: opacity var(--cf-fast) var(--cf-ease); }
#edit-streamer-modal .subscription-card.is-removing { opacity: 0; }
#edit-streamer-modal .subscription-card-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--cf-2); margin-bottom: var(--cf-3); padding-bottom: var(--cf-3); border-bottom: 1px solid var(--cf-border); }
#edit-streamer-modal .subscription-card-title { display: grid; gap: 2px; min-width: 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
#edit-streamer-modal .esm-name { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
#edit-streamer-modal .esm-meta { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
#edit-streamer-modal .esm-head-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--cf-2); }
#edit-streamer-modal .st-sub-group { margin-top: var(--cf-2); padding-top: var(--cf-3); border-top: 1px solid var(--cf-border); font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text); }
#edit-streamer-modal .st-add-platform { padding: var(--cf-4); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); }
#edit-streamer-modal .st-danger-zone { margin-top: var(--cf-5); padding: var(--cf-4); border: 1px solid color-mix(in srgb, var(--cf-danger) 45%, var(--cf-border)); border-radius: var(--cf-radius); }
#edit-streamer-modal .st-danger-zone .st-modal-section { margin-top: 0; padding-top: 0; border-top: 0; color: var(--cf-danger); }
#edit-streamer-modal .esm-preview-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2); margin-top: var(--cf-2); }
#edit-streamer-modal .esm-plat i { width: 1em; text-align: center; }
#edit-streamer-modal .esm-plat-twitch i { color: #9146ff; } #edit-streamer-modal .esm-plat-youtube i { color: #ff3b3b; } #edit-streamer-modal .esm-plat-rumble i { color: #85c742; }
#edit-streamer-modal .esm-kick { display: inline-flex; align-items: center; justify-content: center; width: 1.1em; height: 1.1em; border-radius: 3px; background: #53fc18; color: #0b0e0f; font-size: 0.7em; font-weight: 800; line-height: 1; }
#edit-streamer-modal .modal-content, #edit-streamer-form { max-height: 90vh; display: flex; flex-direction: column; }
#edit-streamer-modal .modal-header, #edit-streamer-modal .modal-footer { flex-shrink: 0; }
#edit-streamer-modal .modal-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
</style>

<div class="modal fade st-modal" id="edit-streamer-modal" tabindex="-1" aria-labelledby="editStreamerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <form id="edit-streamer-form" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title" id="editStreamerModalLabel">Edit <span id="edit-streamer-name"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="consolidated_streamer_id" id="consolidated-streamer-id">

                    <div class="mb-3">
                        <label for="discord-user-id" class="form-label">Discord member</label>
                        <input type="text" class="form-control" id="discord-user-id" name="discord_user_id" inputmode="numeric" pattern="\d{17,20}" placeholder="Discord user ID, such as 123456789012345678" aria-describedby="discord-user-id-desc">
                        <small class="form-text" id="discord-user-id-desc">Optional. The live role goes to this member, and self-promo recognises them.</small>
                    </div>

                    <h6 class="st-modal-section">Announcements</h6>
                    <p class="st-modal-desc">One block per platform account, each with its own channel, roles and message.</p>
                    <div id="subscriptions-container"></div>

                    <h6 class="st-modal-section">Add a platform</h6>
                    <p class="st-modal-desc">Announce this streamer from another platform account too.</p>
                    <div class="row g-3 st-add-platform">
                        <div class="col-md-4">
                            <label for="add-platform" class="form-label">Platform</label>
                            <select class="form-select" id="add-platform">
                                <option value="">Choose a platform</option>
                                <option value="twitch">Twitch</option>
                                <option value="youtube">YouTube</option>
                                <option value="kick">Kick</option>
                                <option value="tiktok">TikTok</option>
                                <option value="rumble">Rumble</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="add-username" class="form-label">Username</label>
                            <input type="text" class="form-control" id="add-username" maxlength="100" placeholder="Username on that platform">
                        </div>
                        <div class="col-md-4">
                            <label for="add-channel" class="form-label">Announcement channel</label>
                            <select class="form-select" id="add-channel">
                                <option value="">Server default</option>
                                <% (channels || []).forEach(channel => { %>
                                    <option value="<%= channel.id %>">#<%= channel.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                            <button type="button" class="btn btn-secondary" id="add-platform-btn">Add platform</button>
                            <span class="cf-status-line" data-esm-add-status aria-live="polite"></span>
                        </div>
                    </div>

                    <div class="st-danger-zone">
                        <h6 class="st-modal-section">Block this streamer</h6>
                        <p class="st-modal-desc">Removes all of this streamer's data and stops them being added to this server again.</p>
                        <div id="blacklist-controls"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/js/cf-msgpreview.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const editStreamerModal = document.getElementById('edit-streamer-modal');
    if (!editStreamerModal) return;

    const ESM = <%- JSON.stringify(esmData).replace(/</g, '\\u003c') %>;
    const CTX = { channels: ESM.channels, roles: ESM.roles };
    const PLATFORM = { twitch: 'Twitch', youtube: 'YouTube', kick: 'Kick', tiktok: 'TikTok', rumble: 'Rumble', trovo: 'Trovo' };
    const COLOR = { twitch: '#9146FF', youtube: '#FF0000', kick: '#52E252', tiktok: '#00f2ea' };
    const ICON = { twitch: 'fab fa-twitch', youtube: 'fab fa-youtube', tiktok: 'fab fa-tiktok', rumble: 'fas fa-play', trovo: 'fas fa-tv' };
    const subscriptionsContainer = document.getElementById('subscriptions-container');
    const blacklistControls = document.getElementById('blacklist-controls');

    // ---- small DOM helpers (all text goes in through textContent) ----
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const opt = (value, text, selected, extra = {}) => {
        const o = el('option', null, text);
        o.value = value;
        if (selected) o.selected = true;
        Object.entries(extra).forEach(([k, v]) => { if (v != null && v !== false) o.setAttribute(k, v === true ? '' : v); });
        return o;
    };
    const col = (cls) => el('div', cls);
    const label = (forId, text) => { const l = el('label', 'form-label', text); l.htmlFor = forId; return l; };
    const hint = (text, id) => { const h = el('small', 'form-text', text); if (id) h.id = id; return h; };
    const select = (id, name, options) => { const s = el('select', 'form-select'); s.id = id; s.name = name; options.forEach(o => s.appendChild(o)); return s; };
    const channelOptions = (selected, emptyText) => [opt('', emptyText, !selected), ...ESM.channels.map(c => opt(c.id, '#' + c.name, String(selected) === String(c.id)))];
    const roleOptions = (selected, { gate = false } = {}) => ESM.roles.map(r => {
        const on = String(selected) === String(r.id);
        return opt(r.id, r.name + (gate && !r.assignable ? ' (above the bot)' : ''), on,
            { 'data-kind': 'role', 'data-color': r.color || null, disabled: gate && !r.assignable && !on });
    });
    const ago = (d) => {
        if (!d) return null;
        const s = Math.max(0, Math.round((Date.now() - new Date(d).getTime()) / 1000));
        if (s < 3600) return `${Math.max(1, Math.round(s / 60))} min ago`;
        if (s < 86400) return `${Math.round(s / 3600)} h ago`;
        if (s < 86400 * 60) return `${Math.round(s / 86400)} days ago`;
        return new Date(d).toISOString().slice(0, 10);
    };
    const setStatus = (node, text, tone) => { node.textContent = text; node.className = 'cf-status-line' + (tone ? ' is-' + tone : ''); };

    // Go-live filters for one subscription (subscriptions.filter_categories / filter_title_keywords,
    // applied by core/stream-alert-filters.js).
    const buildGoLiveFilterFields = (sub, subId) => {
        const frag = document.createDocumentFragment();
        const head = col('col-12');
        head.appendChild(el('div', 'st-sub-group', 'Only announce some streams'));
        frag.appendChild(head);
        const field = (key, idPrefix, labelText, placeholder, hintText) => {
            const c = col('col-md-6');
            const input = el('input', 'form-control');
            input.type = 'text';
            input.id = `${idPrefix}-${subId}`;
            input.name = `subscriptions[${subId}][${key}]`;
            input.maxLength = 500;
            input.placeholder = placeholder;
            input.value = sub[key] || '';
            c.append(label(input.id, labelText), input, hint(hintText));
            return c;
        };
        frag.appendChild(field('filter_categories', 'sub-filter-cat', 'Categories', 'Fortnite, Just Chatting',
            'Announce only when the stream is in one of these categories, spelled as the platform shows them. Separate with commas. Leave blank for any category.'));
        frag.appendChild(field('filter_title_keywords', 'sub-filter-title', 'Title keywords', 'ranked, tournament',
            'Announce only when the title, or one of its Twitch tags, contains one of these words. Separate with commas. Leave blank for any title.'));
        const note = col('col-12');
        note.appendChild(hint('With both set, a stream has to match both. A stream that later switches to a matching category or title is announced then. The live role is given either way.'));
        frag.appendChild(note);
        return frag;
    };

    // The go-live post as Discord will show it, drawn from the fields of one block.
    const drawPreview = (card, sub, streamerName) => {
        const frame = card.querySelector('[data-esm-preview]');
        if (!frame || !window.CFMsgPreview) return;
        const subId = sub.subscription_id;
        const platform = String(sub.platform || '').toLowerCase();
        const pname = PLATFORM[platform] || sub.platform;
        const user = sub.platform_username || streamerName;
        const message = document.getElementById(`sub-message-${subId}`).value;
        const postAs = document.getElementById(`sub-post-as-${subId}`).value;
        const asStreamer = postAs === '1' || (postAs === '' && ESM.defaultPersona);
        const nick = document.getElementById(`sub-webhook-name-${subId}`).value.trim();
        const avatar = document.getElementById(`sub-webhook-avatar-${subId}`).value.trim();
        const url = { twitch: `https://twitch.tv/${user}`, kick: `https://kick.com/${user}`, tiktok: `https://tiktok.com/@${user}` }[platform] || `https://${platform}.com/${user}`;
        const vars = { username: user, streamer: user, platform: pname, url, title: 'Sample stream title', game: 'Just Chatting', description: 'Sample video description', everyone: '@everyone' };
        CFMsgPreview.render(frame, {
            username: asStreamer ? (nick || user) : ESM.botName,
            avatarUrl: asStreamer ? avatar : ESM.botAvatar,
            content: CFMsgPreview.fill(message || ESM.defaultMessage, vars),
            embeds: [{
                color: COLOR[platform] || '#36393f',
                author: { name: `${user} is LIVE on ${pname}!` },
                title: vars.title, url,
                fields: [{ name: 'Playing', value: vars.game, inline: true }, { name: 'Viewers', value: '123', inline: true }],
                thumbnail: { placeholder: '' },
                image: { placeholder: 'Live stream preview' },
                timestamp: true,
            }],
        }, CTX);
        const ping = document.getElementById(`sub-ping-${subId}`).value;
        const pingNote = card.querySelector('[data-esm-ping-note]');
        const role = ESM.roles.find(r => r.id === ping);
        pingNote.textContent = ping === 'everyone' ? 'Pings @everyone in a separate message just before the post.'
            : role ? `Pings @${role.name} in a separate message just before the post.` : '';
        pingNote.hidden = !pingNote.textContent;
    };

    const buildSubscriptionCard = (sub, streamer) => {
        const subId = sub.subscription_id;
        const platform = String(sub.platform || '').toLowerCase();
        const isTikTok = platform === 'tiktok';
        const card = el('div', 'subscription-card');
        card.id = `sub-card-${subId}`;

        // Header: platform, account, status, remove.
        const head = el('div', 'subscription-card-header');
        const title = el('div', 'subscription-card-title');
        const name = el('span', 'esm-name esm-plat esm-plat-' + platform);
        if (platform === 'kick') { const k = el('span', 'esm-kick', 'K'); k.setAttribute('aria-hidden', 'true'); name.appendChild(k); }
        else if (ICON[platform]) { const i = el('i', ICON[platform]); i.setAttribute('aria-hidden', 'true'); name.appendChild(i); }
        name.appendChild(document.createTextNode(`${PLATFORM[platform] || sub.platform} · ${sub.platform_username || streamer.name}`));
        title.appendChild(name);
        const channelName = ESM.channels.find(c => String(c.id) === String(sub.announcement_channel_id))?.name;
        title.appendChild(el('span', 'esm-meta',
            `Posts in ${channelName ? '#' + channelName : 'the server default channel'} · ${sub.last_announced_at ? 'last notified ' + ago(sub.last_announced_at) : 'not notified yet'}`));
        const actions = el('div', 'esm-head-actions');
        if (sub.is_live) actions.appendChild(el('span', 'cf-pill is-ok', 'Live now'));
        const del = el('button', 'btn btn-sm btn-danger', 'Delete');
        del.type = 'button';
        del.dataset.subId = subId;
        del.dataset.esmRemove = '';
        actions.appendChild(del);
        head.append(title, actions);
        card.appendChild(head);

        const grid = el('div', 'row g-3');
        // Where and who
        let c = col('col-md-6');
        c.append(label(`sub-channel-${subId}`, 'Announcement channel'),
            select(`sub-channel-${subId}`, `subscriptions[${subId}][announcement_channel_id]`, channelOptions(sub.announcement_channel_id, 'Server default')));
        grid.appendChild(c);
        c = col('col-md-6');
        c.append(label(`sub-role-${subId}`, 'Live role'),
            select(`sub-role-${subId}`, `subscriptions[${subId}][live_role_id]`, [opt('', 'None', !sub.live_role_id), ...roleOptions(sub.live_role_id, { gate: true })]),
            hint('Given to the linked Discord member while live.'));
        grid.appendChild(c);
        c = col('col-md-6');
        c.append(label(`sub-ping-${subId}`, 'Ping role'),
            select(`sub-ping-${subId}`, `subscriptions[${subId}][ping_role_id]`, [opt('', 'No ping', !sub.ping_role_id), opt('everyone', '@everyone', sub.ping_role_id === 'everyone'), ...roleOptions(sub.ping_role_id)]));
        grid.appendChild(c);
        c = col('col-md-6');
        c.append(label(`sub-post-as-${subId}`, 'Post as'),
            select(`sub-post-as-${subId}`, `subscriptions[${subId}][post_as_streamer]`, [
                opt('', 'Server default', sub.post_as_streamer == null),
                opt('1', 'The streamer (their name and avatar)', sub.post_as_streamer === 1),
                opt('0', 'The bot', sub.post_as_streamer === 0),
            ]),
            hint('Posting as the streamer needs Manage Webhooks in the channel.'));
        grid.appendChild(c);

        // Message, with the preview beside it
        c = col('col-lg-6');
        const msg = el('textarea', 'form-control');
        msg.id = `sub-message-${subId}`;
        msg.name = `subscriptions[${subId}][custom_message]`;
        msg.rows = 4;
        msg.maxLength = 2000;
        msg.value = sub.custom_message || '';
        msg.placeholder = ESM.defaultMessage || (isTikTok ? '{username} posted a new TikTok.' : '{username} is live: {url}');
        msg.dataset.vars = isTikTok ? 'username,title,description,url' : 'username,game,title,url,platform,everyone';
        msg.setAttribute('aria-describedby', `sub-message-hint-${subId}`);
        c.append(label(msg.id, 'Message'), msg,
            hint(ESM.defaultMessage ? 'Leave empty to use the server default message.' : 'Leave empty to post the live card on its own.', `sub-message-hint-${subId}`));
        grid.appendChild(c);
        c = col('col-lg-6');
        const frame = el('div', 'cf-mp-frame');
        frame.dataset.esmPreview = '';
        const pingNote = el('p', 'form-text');
        pingNote.dataset.esmPingNote = '';
        pingNote.hidden = true;
        const pa = el('div', 'esm-preview-actions');
        const testBtn = el('button', 'btn btn-sm btn-secondary', 'Send test');
        testBtn.type = 'button';
        testBtn.dataset.esmTest = subId;
        const testStatus = el('span', 'cf-status-line');
        testStatus.setAttribute('aria-live', 'polite');
        pa.append(testBtn, testStatus);
        const plabel = el('span', 'form-label', 'Preview');
        c.append(plabel, frame, pingNote, pa);
        grid.appendChild(c);

        // Webhook identity
        c = col('col-md-6');
        const wn = el('input', 'form-control');
        wn.type = 'text'; wn.id = `sub-webhook-name-${subId}`; wn.name = `subscriptions[${subId}][override_nickname]`;
        wn.maxLength = 80; wn.value = sub.override_nickname || ''; wn.placeholder = 'The streamer’s name';
        c.append(label(wn.id, 'Name when posting as the streamer'), wn);
        grid.appendChild(c);
        c = col('col-md-6');
        const wa = el('input', 'form-control');
        wa.type = 'url'; wa.id = `sub-webhook-avatar-${subId}`; wa.name = `subscriptions[${subId}][override_avatar_url]`;
        wa.maxLength = 500; wa.value = sub.override_avatar_url || ''; wa.placeholder = 'https://';
        c.append(label(wa.id, 'Avatar when posting as the streamer'), wa);
        grid.appendChild(c);

        // Stream end
        c = col('col-12');
        const sw = el('div', 'form-check form-switch');
        const keep = el('input', 'form-check-input');
        keep.type = 'checkbox'; keep.id = `sub-keep-${subId}`; keep.name = `subscriptions[${subId}][keep_summary]`; keep.checked = !sub.delete_on_end;
        const kl = el('label', 'form-check-label', 'Keep the announcement when the stream ends');
        kl.htmlFor = keep.id;
        sw.append(keep, kl);
        c.appendChild(sw);
        grid.appendChild(c);

        if (isTikTok) {
            c = col('col-12');
            c.appendChild(el('div', 'st-sub-group', 'TikTok video posts'));
            grid.appendChild(c);
            c = col('col-12');
            const vsw = el('div', 'form-check form-switch');
            const nv = el('input', 'form-check-input');
            nv.type = 'checkbox'; nv.id = `sub-notify-videos-${subId}`; nv.name = `subscriptions[${subId}][notify_videos]`; nv.checked = !!sub.notify_videos;
            const nvl = el('label', 'form-check-label', 'Announce new videos');
            nvl.htmlFor = nv.id;
            vsw.append(nv, nvl);
            c.append(vsw, hint('Checked every 5 minutes. Only videos from the last 24 hours are announced; older ones are recorded without a post.'));
            grid.appendChild(c);
            c = col('col-12');
            c.append(label(`sub-video-channel-${subId}`, 'Video announcement channel'),
                select(`sub-video-channel-${subId}`, `subscriptions[${subId}][video_announcement_channel_id]`, channelOptions(sub.video_announcement_channel_id, 'Not set')),
                hint('Where video posts go, separate from live announcements.'));
            grid.appendChild(c);
        } else {
            // TikTok lives report no category, so the filters are offered for the other platforms.
            grid.appendChild(buildGoLiveFilterFields(sub, subId));
        }
        card.appendChild(grid);

        const redraw = () => drawPreview(card, sub, streamer.name);
        card.addEventListener('input', redraw);
        card.addEventListener('change', redraw);
        return { card, redraw };
    };

    editStreamerModal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget || editStreamerModal._triggerButton;
        const streamerDataAttr = button?.getAttribute('data-streamer');
        if (!streamerDataAttr) return;
        let streamer;
        try { streamer = JSON.parse(streamerDataAttr); } catch (e) { return; }

        document.getElementById('edit-streamer-form').action = '/manage/<%= guild.id %>/edit-consolidated-streamer';
        document.getElementById('edit-streamer-name').textContent = streamer.name;
        document.getElementById('consolidated-streamer-id').value = streamer.id;
        document.getElementById('discord-user-id').value = streamer.discord_user_id || '';
        editStreamerModal.setAttribute('data-current-streamer', JSON.stringify(streamer));

        subscriptionsContainer.replaceChildren();
        const subs = streamer.subscriptions || [];
        if (!subs.length) {
            const st = el('div', 'cf-state cf-state--boxed');
            st.appendChild(el('p', 'cf-state-text', 'This streamer has no announcements. Add a platform below.'));
            subscriptionsContainer.appendChild(st);
        } else {
            subs.forEach(sub => {
                const { card, redraw } = buildSubscriptionCard(sub, streamer);
                subscriptionsContainer.appendChild(card);
                redraw();
            });
        }

        // Block / unblock. The button posts a form built on the spot outside the edit form, so the
        // two forms are never nested.
        blacklistControls.replaceChildren();
        const identifier = streamer.discord_user_id || streamer.name;
        const blocked = !!streamer.is_blacklisted;
        const b = el('button', blocked ? 'btn btn-secondary' : 'btn btn-danger', blocked ? 'Unblock this streamer' : 'Block this streamer');
        b.type = 'button';
        b.addEventListener('click', () => {
            if (!blocked && !confirm(`Block ${streamer.name}? All of their data in this server is removed.`)) return;
            const f = el('form');
            f.method = 'POST';
            f.action = blocked ? '/manage/<%= guild.id %>/unblacklist' : '/manage/<%= guild.id %>/blacklist';
            const hid = (n, v) => { const i = el('input'); i.type = 'hidden'; i.name = n; i.value = v; f.appendChild(i); };
            hid('identifier', identifier);
            if (blocked) hid('streamer_id', streamer.id);
            if (window.csrfToken) hid('_csrf', window.csrfToken);
            document.body.appendChild(f);
            f.submit();
        });
        blacklistControls.appendChild(b);
    });

    // Delete a subscription.
    subscriptionsContainer.addEventListener('click', async (e) => {
        const del = e.target.closest('[data-esm-remove]');
        const test = e.target.closest('[data-esm-test]');
        if (del) {
            if (!confirm('Delete this announcement? This cannot be undone.')) return;
            del.disabled = true;
            try {
                const r = await fetch('/manage/<%= guild.id %>/delete-subscription', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subscriptionId: del.dataset.subId }),
                });
                const j = await r.json().catch(() => ({}));
                if (!r.ok || j.success === false) throw new Error(j.error || `Request failed (${r.status})`);
                const card = del.closest('.subscription-card');
                card.classList.add('is-removing');
                setTimeout(() => {
                    card.remove();
                    if (!subscriptionsContainer.querySelector('.subscription-card')) {
                        const st = el('div', 'cf-state cf-state--boxed');
                        st.appendChild(el('p', 'cf-state-text', 'This streamer has no announcements left. The list updates when you close this dialog.'));
                        subscriptionsContainer.appendChild(st);
                    }
                }, 200);
                editStreamerModal.dataset.changed = '1';
            } catch (err) {
                del.disabled = false;
                alert('Could not delete it: ' + err.message);
            }
        } else if (test) {
            const subId = test.dataset.esmTest;
            const status = test.nextElementSibling;
            const channelId = document.getElementById(`sub-channel-${subId}`).value;
            test.disabled = true;
            setStatus(status, 'Sending', '');
            try {
                const msg = document.getElementById(`sub-message-${subId}`).value;
                const r = await fetch(`/api/guilds/${ESM.guildId}/streaming/test-alert`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        subscription_id: subId,
                        channel_id: channelId || undefined,
                        message: msg || ESM.defaultMessage,
                        ping_role_id: document.getElementById(`sub-ping-${subId}`).value,
                    }),
                });
                const j = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(j.error || `Request failed (${r.status})`);
                setStatus(status, `Test posted in #${j.channel}. Nobody was pinged.`, 'ok');
            } catch (err) {
                setStatus(status, err.message, 'bad');
            } finally {
                test.disabled = false;
            }
        }
    });
    editStreamerModal.addEventListener('hidden.bs.modal', () => {
        if (editStreamerModal.dataset.changed === '1') window.location.reload();
    });

    // Add a platform account to this streamer.
    document.getElementById('add-platform-btn').addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const status = editStreamerModal.querySelector('[data-esm-add-status]');
        const platform = document.getElementById('add-platform').value;
        const username = document.getElementById('add-username').value.trim();
        const channelId = document.getElementById('add-channel').value;
        if (!platform || !username) { setStatus(status, 'Choose a platform and enter a username.', 'warn'); return; }
        btn.disabled = true;
        setStatus(status, 'Adding', '');
        try {
            const response = await fetch('/manage/<%= guild.id %>/add-streamer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    platform, username,
                    discord_user_id: document.getElementById('discord-user-id').value,
                    announcement_channel_id: channelId || '',
                }),
            });
            const error = response.redirected ? new URL(response.url).searchParams.get('error') : null;
            if (error) throw new Error(error);
            if (!response.ok && !response.redirected) throw new Error(`Request failed (${response.status})`);
            setStatus(status, 'Added. Reloading.', 'ok');
            window.location.reload();
        } catch (err) {
            setStatus(status, 'Could not add it: ' + err.message, 'bad');
            btn.disabled = false;
        }
    });
});
</script>
