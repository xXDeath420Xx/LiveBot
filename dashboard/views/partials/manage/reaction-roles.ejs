<%# Reaction roles — panels members use to give themselves roles (buttons, a dropdown or reactions).
    Create (blank) and delete panels and repost them through the form routes; edit, post, the role
    mappings and template panels go through /api/guilds/:id/reaction-roles (templates create any
    missing roles first through /api/guilds/:id/bulk-roles/create). Laid out with the settings-row
    kit (cf-settings.css); every id, field name, data-* hook and handler is unchanged.
    Lists, previews and template rows are built with createElement/textContent. %>
<%
const rrPanels = reactionRolePanels || [];
const rrTypeLabel = (t) => t === 'button' ? 'Buttons' : (t === 'select_menu' ? 'Dropdown' : (t === 'reaction' ? 'Reactions' : 'Buttons'));
const rrTotalRoles = rrPanels.reduce((sum, p) => sum + (p.mappings?.length || 0), 0);
// Roles the bot cannot hand out: managed by an integration, or at/above the bot's highest role.
const rrBotTop = (guild && guild.members && guild.members.me && guild.members.me.roles && guild.members.me.roles.highest)
    ? guild.members.me.roles.highest.position : null;
const rrBlocked = (r) => !!r.managed || (typeof rrBotTop === 'number' && Number(r.position) >= rrBotTop);
const rrBotName = (guild && guild.members && guild.members.me && (guild.members.me.displayName || (guild.members.me.user && guild.members.me.user.username))) || 'CertiFried Utility';
%>
<style>
    .rr-panel-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px var(--cf-2); }
    .rr-panel-meta .rr-sep { color: var(--cf-border-strong); }
    .rr-inline-form { display: inline-flex; margin: 0; }
    .rr-toolbar { display: flex; justify-content: flex-end; margin: 0 0 var(--cf-4); }

    /* Role mappings on a panel (drawn by rrRenderMappings) */
    .rr-mapping-main { display: flex; align-items: center; gap: var(--cf-3); min-width: 0; }
    .rr-mapping-emoji {
        flex: none; display: inline-flex; align-items: center; justify-content: center; min-width: 32px; height: 32px; padding: 0 6px;
        border-radius: var(--cf-radius-sm); background: var(--cf-surface-2); border: 1px solid var(--cf-border); font-size: 1.1rem; line-height: 1;
    }
    .rr-mapping-emoji:empty { display: none; }
    .rr-mapping-role { display: block; font-weight: 500; color: var(--cf-text); overflow-wrap: anywhere; }
    .rr-mapping-hint { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); }

    /* Add a role */
    .rr-opt { font-weight: 400; color: var(--cf-text-3); }
    .rr-emoji-field { position: relative; }
    .rr-emoji-field > input { width: 100%; padding-right: 44px; cursor: pointer; }
    .emoji-picker-btn {
        position: absolute; top: 0; right: 0; bottom: 0; width: 40px; display: inline-flex; align-items: center; justify-content: center;
        border: 0; background: none; color: var(--cf-text-3); cursor: pointer; border-radius: 0 var(--cf-radius) var(--cf-radius) 0;
    }
    .emoji-picker-btn:hover { color: var(--cf-text); }
    .emoji-picker-btn:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: -2px; }
    .cf-section-foot > .rr-inline-status, .rr-bulk-actions > .rr-inline-status { margin-right: auto; }

    /* Add several at once (an expandable row of the panel) */
    .rr-bulk-help { margin: 0 0 var(--cf-3); }
    .rr-bulk-text { width: 100%; font-family: var(--cf-mono); font-size: var(--cf-text-sm); resize: vertical; }
    .rr-bulk-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: var(--cf-2); margin-top: var(--cf-3); }
    .rr-bulk-report { margin-top: var(--cf-2); font-size: var(--cf-text-sm); }
    .rr-bulk-report:empty { display: none; }
    .rr-bulk-ok { color: var(--cf-text-2); }
    .rr-bulk-ok strong { color: var(--cf-success); font-weight: 600; }
    .rr-bulk-errors { margin: var(--cf-2) 0 0; padding-left: 1.1rem; color: var(--cf-danger); }

    /* Create and edit dialogs (Bootstrap modals; labels and hints are the kit's .form-label/.form-text) */
    .rr-modal-body { display: grid; gap: var(--cf-4); }
    .rr-modal-body > .cf-notice { margin: 0; }
    .rr-field { display: flex; flex-direction: column; min-width: 0; }
    .rr-field > .form-control, .rr-field > .form-select { width: 100%; margin: 0; }
    .rr-field > input[type=color] { width: 64px; height: 36px; padding: 2px; }
    .rr-pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--cf-4); }
    .rr-tpl-pick { margin: 2px 0 4px; }

    /* Template rows in the create dialog */
    .rr-tpl-head { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-2); flex-wrap: wrap; }
    .rr-tpl-head .form-label { margin: 0; }
    .rr-tpl-rows { display: grid; gap: var(--cf-2); margin-top: var(--cf-2); }
    .rr-tpl-row { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.2fr) auto auto; gap: var(--cf-2); align-items: center; }
    .rr-tpl-row.no-style { grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.2fr) auto; }
    .rr-tpl-row > input, .rr-tpl-row > select { width: 100%; min-width: 0; margin: 0; }
    .rr-tpl-row .rr-tpl-emoji { text-align: center; }
    .rr-tpl-swatch { width: 10px; height: 10px; border-radius: 50%; background: var(--rr-swatch, transparent); }

    /* Discord-style preview of the panel message */
    .rr-pv { min-width: 0; padding: var(--cf-3) var(--cf-4); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface-2); font-size: var(--cf-text-sm); color: var(--cf-text); line-height: 1.45; overflow-wrap: anywhere; }
    .rr-pv-msg { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: var(--cf-3); }
    .rr-pv-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--cf-border-strong); }
    .rr-pv-author { display: flex; align-items: center; gap: 6px; font-weight: 600; }
    .rr-pv-app { padding: 0 4px; border-radius: 3px; font-size: 10px; font-weight: 600; line-height: 15px; color: var(--cf-on-accent); background: var(--cf-accent); }
    .rr-pv-embed { max-width: 520px; margin-top: 6px; padding: var(--cf-3); border-left: 4px solid var(--rr-pv-colour, var(--cf-accent)); border-radius: var(--cf-radius-sm); background: var(--cf-surface); }
    .rr-pv-title { font-weight: 600; margin-bottom: 4px; }
    .rr-pv-desc { white-space: pre-wrap; color: var(--cf-text-2); }
    .rr-pv-field { margin-top: 8px; }
    .rr-pv-field-name { font-size: var(--cf-text-xs); font-weight: 600; margin-bottom: 2px; }
    .rr-pv-line { color: var(--cf-text-2); }
    .rr-pv-img { margin-top: 8px; padding: var(--cf-2); border: 1px dashed var(--cf-border-strong); border-radius: var(--cf-radius-sm); text-align: center; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .rr-pv-mention { padding: 0 2px; border-radius: 3px; color: var(--cf-accent-fg); background: color-mix(in srgb, var(--cf-accent) 18%, transparent); }
    .rr-pv-controls { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; max-width: 520px; }
    .rr-pv-btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 4px; font-size: var(--cf-text-sm); font-weight: 500; color: #fff; background: #5865f2; }
    .rr-pv-btn.is-secondary { background: #4e5058; }
    .rr-pv-btn.is-success { background: #248046; }
    .rr-pv-btn.is-danger { background: #da373c; }
    .rr-pv-btn * { color: inherit; }
    :root:is([data-theme="light"], [data-theme="sand"]) .rr-pv-btn.is-secondary { background: #6d6f78; }
    .rr-pv-select { display: flex; align-items: center; justify-content: space-between; width: 100%; height: 40px; padding: 0 12px; border-radius: 4px; border: 1px solid var(--cf-border-strong); background: var(--cf-surface); color: var(--cf-text-3); }
    .rr-pv-options { width: 100%; display: grid; gap: 2px; padding: 4px; border: 1px solid var(--cf-border); border-radius: 4px; background: var(--cf-surface); }
    .rr-pv-option { display: flex; align-items: center; gap: 8px; padding: 4px 8px; }
    .rr-pv-option small { display: block; color: var(--cf-text-3); }
    .rr-pv-react { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 8px; border-radius: 8px; border: 1px solid var(--cf-border-strong); background: var(--cf-surface); font-size: var(--cf-text-xs); }
    .rr-pv-empty { color: var(--cf-text-3); font-size: var(--cf-text-xs); margin-top: 8px; }

    /* Emoji picker (the kit's .cf-modal shell, narrow) */
    .rr-emoji-dialog { --cf-modal-w: 22.5rem; }
    .emoji-grid { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 4px; }
    .emoji-item { font-size: 22px; line-height: 1; padding: 6px 0; border-radius: var(--cf-radius-sm); cursor: pointer; text-align: center; border: 0; background: none; }
    .emoji-item:hover, .emoji-item:focus-visible { background: var(--cf-surface-2); }

    @media (max-width: 640px) {
        .rr-bulk-actions .btn { flex: 1 1 auto; min-height: 44px; }
        .emoji-picker-btn { width: 44px; }
        .rr-panel .cf-section-actions { width: 100%; }
        .rr-panel .cf-section-actions > .btn, .rr-panel .cf-section-actions > .rr-inline-form { flex: 1 1 auto; }
        .rr-panel .cf-section-actions .rr-inline-form .btn { width: 100%; }
        .rr-tpl-row, .rr-tpl-row.no-style { grid-template-columns: 3.5rem minmax(0, 1fr) auto; padding-bottom: var(--cf-2); border-bottom: 1px solid var(--cf-border); }
        .rr-tpl-row > select { grid-column: 1 / -1; min-height: 44px; }
        .rr-tpl-row > input { min-height: 44px; }
        .rr-toolbar .cf-search { width: 100%; }
    }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-hand-pointer"></i>
                <span>Reaction roles</span>
            </div>
            <div class="page-section-subtitle">Buttons and dropdowns hold up to 25 roles, reactions up to 20.</div>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPanelModal">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>Create panel</span>
        </button>
    </div>

    <%# Every form on this page redirects back with ?success=/?error=, and nothing used to
        render them — a failed Repost looked exactly like a successful one. %>
    <div id="rrFlash" class="cf-notice" role="status" hidden></div>

    <% if (rrPanels.length > 0) { %>
        <dl class="cf-kpis" aria-label="Reaction roles at a glance">
            <div class="cf-kpi"><dt>Panels</dt><dd class="cf-kpi-value"><%= rrPanels.length %></dd></div>
            <div class="cf-kpi"><dt>Roles on panels</dt><dd class="cf-kpi-value" id="rrStatRoles"><%= rrTotalRoles %></dd></div>
            <div class="cf-kpi"><dt>Not posted yet</dt><dd class="cf-kpi-value"><%= rrPanels.filter(p => !p.message_id || p.message_id === 'PENDING').length %></dd></div>
        </dl>
        <%# Kept for the stats script; the average is no longer shown. %>
        <span id="rrStatAvg" hidden></span>
    <% } %>

    <% if (rrPanels.length > 15) { %>
        <div class="rr-toolbar">
            <span class="cf-search"><i class="fas fa-search" aria-hidden="true"></i><input type="search" class="form-control rr-filter" placeholder="Filter <%= rrPanels.length %> panels" aria-label="Filter panels"></span>
        </div>
    <% } %>

    <% if (rrPanels.length > 0) { %>
        <% rrPanels.forEach(panel => { const unposted = !panel.message_id || panel.message_id === 'PENDING'; const chName = (channels.find(c => c.id === panel.channel_id) || {}).name; %>
            <section class="cf-section rr-panel" aria-labelledby="rr-panel-<%= panel.id %>-title">
                <header class="cf-section-head">
                    <div>
                        <h2 class="cf-section-title" id="rr-panel-<%= panel.id %>-title"><%= panel.panel_name %></h2>
                        <p class="cf-section-desc rr-panel-meta">
                            <span><%= chName ? '#' + chName : 'Channel no longer exists' %></span>
                            <span class="rr-sep" aria-hidden="true">·</span>
                            <span><%= rrTypeLabel(panel.interaction_type) %><%= panel.panel_mode === 'unique' ? ', one role at a time' : '' %></span>
                            <% if (unposted) { %><span class="cf-pill is-warn">Not posted</span><% } else { %><span class="cf-pill is-ok">Posted</span><% } %>
                        </p>
                    </div>
                    <div class="cf-section-actions">
                        <%# Unposted means NULL (after a Repost) or the 'PENDING' sentinel (fresh panel).
                            Kept in the DOM even with zero mappings, just hidden — adding the first role
                            reveals it in place instead of needing a reload. %>
                        <% if (unposted) { %>
                            <button type="button" class="btn btn-sm btn-primary" data-post-btn="<%= panel.id %>"
                                    onclick="postPanel('<%= guild.id %>', '<%= panel.id %>', this)"
                                    <%= (panel.mappings && panel.mappings.length) ? '' : 'hidden' %>>
                                Post to Discord
                            </button>
                        <% } %>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="openEditPanel('<%= panel.id %>')">Edit</button>
                        <% if (!unposted) { %>
                        <form class="rr-inline-form" action="/manage/<%= guild.id %>/repost-rr-panel" method="POST" onsubmit="return confirm('Delete the posted message and post a fresh copy? Links to the old message stop working.');">
                            <input type="hidden" name="panelId" value="<%= panel.id %>">
                            <button type="submit" class="btn btn-sm btn-secondary" title="Delete the old message and post it again with the current roles">Repost</button>
                        </form>
                        <% } %>
                        <form class="rr-inline-form" action="/manage/<%= guild.id %>/delete-rr-panel" method="POST" onsubmit="return confirm('Delete this panel and all its role mappings?');">
                            <input type="hidden" name="panelId" value="<%= panel.id %>">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </header>

                <div class="cf-rows" data-panel-body="<%= panel.id %>">
                    <%# Rendered by rrRenderMappings(): the role list and the message preview, so adding and
                        removing roles redraws just this panel instead of reloading the whole page. %>
                    <div id="rrMappingsWrap-<%= panel.id %>">
                        <%- include('../kit/_state', { kind: 'loading', title: 'Loading roles', compact: true }) %>
                    </div>

                    <form class="rr-add-form" data-panel="<%= panel.id %>" data-type="<%= panel.interaction_type || 'reaction' %>" onsubmit="return rrAddMapping(event)">
                        <div class="cf-rows-head">Add a role</div>
                        <input type="hidden" name="panelId" value="<%= panel.id %>">
                        <div class="cf-row cf-row--stack">
                            <div class="cf-fields">
                                <div class="cf-field">
                                    <label>Emoji <% if (panel.interaction_type !== 'reaction') { %><span class="rr-opt">(optional)</span><% } %></label>
                                    <div class="rr-emoji-field">
                                        <input type="text" name="emoji_id" class="form-control emoji-input" <%= panel.interaction_type === 'reaction' ? 'required' : '' %> placeholder="Pick an emoji" readonly aria-label="Emoji">
                                        <button type="button" class="emoji-picker-btn" onclick="openEmojiPicker(this)" aria-label="Pick an emoji">
                                            <i class="fas fa-face-smile" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <span class="cf-field-hint">
                                        <% if (panel.interaction_type === 'reaction') { %>
                                            Required. The emoji members react with.
                                        <% } else if (panel.interaction_type === 'button') { %>
                                            Shown on the button before the text.
                                        <% } else { %>
                                            Shown next to the option in the dropdown.
                                        <% } %>
                                    </span>
                                </div>
                                <div class="cf-field">
                                    <label for="f-reaction-roles-role_id">Role</label>
                                    <select id="f-reaction-roles-role_id" name="role_id" class="form-select" required>
                                        <option value="">Select a role</option>
                                        <% roles.forEach(role => { const blocked = rrBlocked(role); %>
                                            <option value="<%= role.id %>"<%= blocked ? ' disabled' : '' %>><%= role.name %><%= blocked ? ' (above the bot)' : '' %></option>
                                        <% }); %>
                                    </select>
                                    <span class="cf-field-hint">Given or taken away when a member picks it.</span>
                                </div>
                                <% if (panel.interaction_type === 'button') { %>
                                <div class="cf-field">
                                    <label for="f-reaction-roles-label">Button text <span class="rr-opt">(optional)</span></label>
                                    <input id="f-reaction-roles-label" type="text" name="label" class="form-control" placeholder="Defaults to the role name" maxlength="80">
                                    <span class="cf-field-hint">Up to 80 characters.</span>
                                </div>
                                <div class="cf-field">
                                    <label for="f-reaction-roles-button_style">Button colour</label>
                                    <select id="f-reaction-roles-button_style" name="button_style" class="form-select">
                                        <option value="primary">Blue</option>
                                        <option value="secondary">Grey</option>
                                        <option value="success">Green</option>
                                        <option value="danger">Red</option>
                                    </select>
                                    <span class="cf-field-hint">Discord's four button colours.</span>
                                </div>
                                <% } else if (panel.interaction_type === 'select_menu') { %>
                                <div class="cf-field">
                                    <label for="f-reaction-roles-label-2">Option text <span class="rr-opt">(optional)</span></label>
                                    <input id="f-reaction-roles-label-2" type="text" name="label" class="form-control" placeholder="Defaults to the role name" maxlength="80">
                                    <span class="cf-field-hint">Up to 80 characters.</span>
                                </div>
                                <% } %>
                            </div>
                        </div>
                        <div class="cf-section-foot">
                            <span class="cf-status-line rr-inline-status" data-status="<%= panel.id %>" role="status"></span>
                            <button type="submit" class="btn btn-primary">Add role</button>
                        </div>
                    </form>

                    <details class="cf-expand rr-bulk" data-bulk="<%= panel.id %>">
                        <summary>Add several at once</summary>
                        <div class="cf-expand-body">
                            <p class="cf-row-desc rr-bulk-help">
                                One role per line, by name, ID or @mention. Anything after a <code>|</code> is read as a label,
                                an emoji or a button colour, in any order. Lines starting with <code>//</code> are ignored.
                            </p>
                            <textarea class="form-control rr-bulk-text" rows="6" spellcheck="false" aria-label="Roles to add, one per line"
                                      placeholder="Gaming&#10;Movie night | Movie pings | green&#10;Announcements | Ping me | blue"></textarea>
                            <div class="rr-bulk-actions">
                                <span class="cf-status-line rr-inline-status" data-bulk-status="<%= panel.id %>" role="status"></span>
                                <button type="button" class="btn btn-sm btn-secondary" onclick="rrBulkPreview('<%= panel.id %>')">Check list</button>
                                <button type="button" class="btn btn-sm btn-primary" onclick="rrBulkAdd('<%= panel.id %>')">Add all</button>
                            </div>
                            <div class="rr-bulk-report" data-bulk-report="<%= panel.id %>"></div>
                        </div>
                    </details>
                </div>
            </section>
        <% }); %>
        <div class="cf-state cf-state--boxed rr-filter-empty" hidden>
            <p class="cf-state-title">No panels match</p>
            <p class="cf-state-text">Try part of the panel or channel name.</p>
        </div>
    <% } else { %>
        <section class="cf-section" aria-labelledby="rr-panels-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="rr-panels-title">Panels</h2>
                    <p class="cf-section-desc">Each panel is one message in a channel, with the roles members can pick from it.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-state cf-state--empty">
                    <p class="cf-state-title">No reaction role panels yet</p>
                    <p class="cf-state-text">Start from a template such as name colours or pronouns, or build one from scratch.</p>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPanelModal">Create the first panel</button>
                </div>
            </div>
        </section>
    <% } %>
</div>

<!-- Create panel dialog. "Blank" posts the form as before; a template saves through the API. -->
<div class="modal fade" id="createPanelModal" tabindex="-1" aria-labelledby="rr-create-title">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rr-create-title">Create a reaction role panel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/manage/<%= guild.id %>/create-rr-panel" method="POST">
                <div class="modal-body rr-modal-body">
                    <div class="rr-field">
                        <span class="form-label">Start from</span>
                        <div class="cf-segmented rr-tpl-pick" role="group" aria-label="Start from">
                            <button type="button" class="cf-segment rr-tpl-btn" value="" aria-pressed="true">Blank</button>
                            <button type="button" class="cf-segment rr-tpl-btn" value="colours" aria-pressed="false">Name colours</button>
                            <button type="button" class="cf-segment rr-tpl-btn" value="pronouns" aria-pressed="false">Pronouns</button>
                            <button type="button" class="cf-segment rr-tpl-btn" value="notifications" aria-pressed="false">Notifications</button>
                            <button type="button" class="cf-segment rr-tpl-btn" value="regions" aria-pressed="false">Regions</button>
                        </div>
                        <span class="form-text">A template fills in the panel and its roles. Change anything before you create it.</span>
                    </div>
                    <div class="rr-field">
                        <label class="form-label" for="f-reaction-roles-panel_name">Panel name</label>
                        <input id="f-reaction-roles-panel_name" type="text" name="panel_name" class="form-control" required maxlength="256" placeholder="e.g. Notification roles">
                        <span class="form-text">The title at the top of the embed.</span>
                    </div>
                    <div class="rr-field">
                        <label class="form-label" for="f-reaction-roles-channel_id">Channel</label>
                        <select id="f-reaction-roles-channel_id" name="channel_id" class="form-select" required>
                            <option value="">Select a channel</option>
                            <% channels.forEach(c => { %>
                                <option value="<%= c.id %>">#<%= c.name %></option>
                            <% }); %>
                        </select>
                        <span class="form-text">Where the panel is posted.</span>
                    </div>
                    <div class="rr-field">
                        <label class="form-label" for="f-reaction-roles-description">Embed text <span class="rr-opt">(optional)</span></label>
                        <textarea id="f-reaction-roles-description" name="description" class="form-control" rows="4" maxlength="4096" placeholder="Pick your roles with the buttons below."></textarea>
                    </div>
                    <div class="rr-pair">
                        <div class="rr-field">
                            <label class="form-label" for="f-reaction-roles-embed_color">Embed colour</label>
                            <input id="f-reaction-roles-embed_color" type="color" name="embed_color" class="form-control" value="#a78bfa">
