<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-hand-pointer"></i>
                <span>Reaction Roles</span>
            </div>
            <div class="page-section-subtitle">
                Allow users to assign themselves roles by reacting to a message
            </div>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPanelModal">
            <i class="fas fa-plus"></i>
            <span>Create Panel</span>
        </button>
    </div>

    <!-- Stats Overview -->
    <% if (reactionRolePanels && reactionRolePanels.length > 0) { %>
        <div class="rr-stats-grid">
            <div class="rr-stat-card">
                <div class="rr-stat-label">Total Panels</div>
                <div class="rr-stat-value"><%= reactionRolePanels.length %></div>
            </div>
            <div class="rr-stat-card">
                <div class="rr-stat-label">Total Roles</div>
                <div class="rr-stat-value purple"><%= reactionRolePanels.reduce((sum, p) => sum + (p.mappings?.length || 0), 0) %></div>
            </div>
            <div class="rr-stat-card">
                <div class="rr-stat-label">Avg per Panel</div>
                <div class="rr-stat-value accent"><%= Math.round(reactionRolePanels.reduce((sum, p) => sum + (p.mappings?.length || 0), 0) / reactionRolePanels.length) %></div>
            </div>
        </div>
    <% } %>

    <!-- Panels List -->
    <% if (reactionRolePanels && reactionRolePanels.length > 0) { %>
        <div class="rr-panels-list">
            <% reactionRolePanels.forEach(panel => { %>
                <div class="rr-panel-card">
                    <div class="rr-panel-header">
                        <div>
                            <h3 class="rr-panel-title">
                                <%= panel.panel_name %>
                                <% if (panel.message_id === 'PENDING') { %>
                                    <span class="rr-pending-badge">PENDING</span>
                                <% } %>
                            </h3>
                            <div class="rr-panel-channel">
                                <i class="fas fa-hashtag"></i>
                                <%= channels.find(c => c.id === panel.channel_id)?.name || 'Unknown Channel' %>
                            </div>
                        </div>
                        <div class="rr-panel-actions">
                            <% if (panel.message_id === 'PENDING' && panel.mappings && panel.mappings.length > 0) { %>
                                <button type="button" class="btn btn-sm btn-success" onclick="postPanel('<%= guild.id %>', '<%= panel.id %>')">
                                    <i class="fas fa-paper-plane"></i>
                                    <span>Post to Discord</span>
                                </button>
                            <% } %>
                            <form action="/manage/<%= guild.id %>/delete-rr-panel" method="POST" onsubmit="return confirm('Delete this panel and all its role mappings?');">
                                <input type="hidden" name="panelId" value="<%= panel.id %>">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i>
                                    <span>Delete Panel</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="rr-panel-body">
                        <!-- Role Mappings -->
                        <% if (panel.mappings && panel.mappings.length > 0) { %>
                            <div class="rr-mappings-section">
                                <h4 class="rr-mappings-title">Role Mappings (<%= panel.mappings.length %>)</h4>
                                <div class="rr-mappings-grid">
                                    <% panel.mappings.forEach(mapping => {
                                        const role = roles.find(r => r.id === mapping.role_id);
                                    %>
                                        <div class="rr-mapping-item">
                                            <div class="rr-mapping-info">
                                                <div class="rr-mapping-emoji"><%= mapping.emoji_id %></div>
                                                <div>
                                                    <div class="rr-mapping-role"><%= role ? role.name : 'Unknown Role' %></div>
                                                    <div class="rr-mapping-hint">React to assign</div>
                                                </div>
                                            </div>
                                            <form action="/manage/<%= guild.id %>/remove-rr-mapping" method="POST" class="d-inline">
                                                <input type="hidden" name="mappingId" value="<%= mapping.id %>">
                                                <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Remove this role mapping?');">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="rr-no-mappings">
                                <i class="fas fa-info-circle"></i>
                                No role mappings added yet
                            </div>
                        <% } %>

                        <!-- Add New Role Mapping -->
                        <div class="rr-add-mapping">
                            <h4 class="rr-add-mapping-title">
                                <i class="fas fa-plus"></i>
                                Add New Role Mapping
                            </h4>
                            <form action="/manage/<%= guild.id %>/add-rr-mapping" method="POST">
                                <input type="hidden" name="panelId" value="<%= panel.id %>">
                                <div class="rr-add-mapping-grid">
                                    <div>
                                        <label class="form-label">Emoji</label>
                                        <div style="position: relative;">
                                            <input type="text" name="emoji_id" class="form-control emoji-input" required placeholder="Click to select emoji" readonly style="cursor: pointer;">
                                            <button type="button" class="emoji-picker-btn" onclick="openEmojiPicker(this)">
                                                <i class="fas fa-smile"></i>
                                            </button>
                                        </div>
                                        <div class="form-help">Click to select an emoji</div>
                                    </div>
                                    <div>
                                        <label class="form-label">Role</label>
                                        <select name="role_id" class="form-select" required>
                                            <option value="">Select role...</option>
                                            <% roles.forEach(role => { %>
                                                <option value="<%= role.id %>"><%= role.name %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-primary" style="width: 100%;">
                                            <i class="fas fa-plus"></i>
                                            <span>Add Mapping</span>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-hand-pointer"></i>
            </div>
            <div class="empty-state-title">No Reaction Role Panels</div>
            <div class="empty-state-description">
                Create a panel to allow users to self-assign roles via reactions
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPanelModal">
                <i class="fas fa-plus"></i>
                <span>Create First Panel</span>
            </button>
        </div>
    <% } %>
</div>

<!-- Create Panel Modal -->
<div class="modal fade" id="createPanelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Reaction Role Panel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/manage/<%= guild.id %>/create-rr-panel" method="POST">
                <div class="modal-body">
                    <div class="rr-form-group">
                        <label class="form-label">Panel Name</label>
                        <input type="text" name="panel_name" class="form-control" required placeholder="e.g., Server Rules">
                        <div class="form-help">Title displayed in the embed</div>
                    </div>
                    <div class="rr-form-group">
                        <label class="form-label">Channel</label>
                        <select name="channel_id" class="form-select" required>
                            <option value="">Select channel...</option>
                            <% channels.forEach(c => { %>
                                <option value="<%= c.id %>">#<%= c.name %></option>
                            <% }); %>
                        </select>
                        <div class="form-help">Where the reaction role message will be posted</div>
                    </div>
                    <div class="rr-form-group">
                        <label class="form-label">Embed Description</label>
                        <textarea name="description" class="form-control" rows="5" placeholder="React to this message to get your roles! You can write up to 4096 characters here."></textarea>
                        <div class="form-help">The main message content (supports up to 4096 characters)</div>
                    </div>
                    <div class="rr-form-group">
                        <label class="form-label">Embed Color</label>
                        <input type="color" name="embed_color" class="form-control" value="#a78bfa">
                        <div class="form-help">Color of the embed border</div>
                    </div>
                    <div class="rr-form-row">
                        <div>
                            <label class="form-label">Panel Mode</label>
                            <select name="panel_mode" class="form-select">
                                <option value="normal">Normal (Multiple Roles)</option>
                                <option value="unique">Unique (One Role Only)</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Interaction Type</label>
                            <select name="interaction_type" class="form-select">
                                <option value="button">Buttons</option>
                                <option value="select_menu">Select Menu</option>
                                <option value="reaction">Reactions</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        <span>Create Panel</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
/* Compact Reaction Roles Styles */
.rr-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 18px;
}

.rr-stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 10px;
    padding: 14px 16px;
}

.rr-stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
}

.rr-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
}

.rr-stat-value.purple { color: #a78bfa; }
.rr-stat-value.accent { color: #c084fc; }

/* Panel Cards */
.rr-panels-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.rr-panel-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 12px;
    overflow: hidden;
}

.rr-panel-header {
    background: rgba(167, 139, 250, 0.08);
    padding: 14px 16px;
    border-bottom: 1px solid rgba(167, 139, 250, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.rr-panel-title {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 4px 0;
}

.rr-pending-badge {
    display: inline-block;
    background: #fbbf24;
    color: #1a1d21;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 8px;
    vertical-align: middle;
}

.rr-panel-channel {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
}

.rr-panel-channel i { color: #a78bfa; margin-right: 4px; }

.rr-panel-actions { display: flex; gap: 8px; }

.rr-panel-body { padding: 16px; }

/* Mappings */
.rr-mappings-section { margin-bottom: 14px; }

.rr-mappings-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
}

.rr-mappings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.rr-mapping-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 10px 12px;
}

.rr-mapping-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.rr-mapping-emoji { font-size: 1.25rem; }
.rr-mapping-role { font-weight: 600; color: #ffffff; font-size: 0.85rem; }
.rr-mapping-hint { font-size: 0.7rem; color: rgba(255, 255, 255, 0.5); }

.rr-no-mappings {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 18px;
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 14px;
}

.rr-no-mappings i { margin-right: 6px; }

/* Add Mapping */
.rr-add-mapping {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 14px;
}

.rr-add-mapping-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 12px;
}

.rr-add-mapping-title i { margin-right: 6px; color: #a78bfa; }

.rr-add-mapping-grid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 10px;
    align-items: end;
}

/* Form Styles */
.rr-form-group { margin-bottom: 14px; }
.rr-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.form-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 6px;
}

.form-help {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 4px;
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 48px 24px;
}

.empty-state-icon {
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 14px;
}

.empty-state-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 8px;
}

.empty-state-description {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 20px;
}

/* Emoji Picker */
.emoji-picker-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    padding: 4px 8px;
    font-size: 1rem;
}

.emoji-picker-btn:hover { color: #a78bfa; }

.emoji-picker-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 10000;
}

.emoji-picker-modal.active { display: flex; }

.emoji-picker-content {
    background: rgba(26, 29, 33, 0.98);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 12px;
    padding: 14px;
    max-width: 360px;
    width: 90%;
    max-height: 450px;
    overflow-y: auto;
}

.emoji-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    margin-top: 10px;
}

.emoji-item {
    font-size: 22px;
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
}

.emoji-item:hover {
    background: rgba(167, 139, 250, 0.2);
}

@media (max-width: 768px) {
    .rr-stats-grid { grid-template-columns: 1fr; }
    .rr-mappings-grid { grid-template-columns: 1fr; }
    .rr-add-mapping-grid { grid-template-columns: 1fr; }
    .rr-form-row { grid-template-columns: 1fr; }
}
</style>

<!-- Emoji Picker Modal -->
<div id="emojiPickerModal" class="emoji-picker-modal" onclick="closeEmojiPicker(event)">
    <div class="emoji-picker-content" onclick="event.stopPropagation()">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <h4 style="margin: 0; color: #ffffff; font-size: 0.95rem; font-weight: 600;">Select Emoji</h4>
            <button type="button" class="btn-close" onclick="closeEmojiPicker()"></button>
        </div>
        <div class="emoji-grid" id="emojiGrid"></div>
    </div>
</div>

<script>
let currentEmojiInput = null;

// Common emojis for reaction roles
const commonEmojis = [
    '✅', '❌', '✔️', '❎', '⭕', '🔴', '🟢', '🔵', '🟡', '🟣',
    '🟠', '⚪', '⚫', '🟤', '1️⃣', '2️⃣', '3️⃣', '4️⃣', '5️⃣', '6️⃣',
    '7️⃣', '8️⃣', '9️⃣', '🔟', '🎮', '🎨', '🎵', '🎬', '⚽', '🏀',
    '🏈', '⚾', '🎾', '🏐', '🏉', '🥏', '🎱', '🏓', '🏸', '🏒',
    '👍', '👎', '👌', '✌️', '🤝', '👏', '🙌', '👋', '✋', '👊',
    '🌟', '⭐', '🌙', '☀️', '⛅', '🌈', '❤️', '💙', '💚', '💛',
    '🧡', '💜', '🖤', '🤍', '🤎', '💯', '🔥', '💧', '💨', '⚡',
    '😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣', '😊', '😇'
];

function openEmojiPicker(button) {
    currentEmojiInput = button.previousElementSibling;
    const modal = document.getElementById('emojiPickerModal');
    const grid = document.getElementById('emojiGrid');

    // Populate emoji grid
    grid.innerHTML = '';
    commonEmojis.forEach(emoji => {
        const item = document.createElement('div');
        item.className = 'emoji-item';
        item.textContent = emoji;
        item.onclick = () => selectEmoji(emoji);
        grid.appendChild(item);
    });

    modal.classList.add('active');
}

function closeEmojiPicker(event) {
    if (!event || event.target.id === 'emojiPickerModal') {
        document.getElementById('emojiPickerModal').classList.remove('active');
        currentEmojiInput = null;
    }
}

function selectEmoji(emoji) {
    if (currentEmojiInput) {
        currentEmojiInput.value = emoji;
    }
    closeEmojiPicker();
}

async function postPanel(guildId, panelId) {
    if (!confirm('Post this panel to Discord? This will create the message in the selected channel.')) {
        return;
    }

    const btn = event.target.closest('button');
    const originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Posting...';

    try {
        const response = await fetch(`/api/guilds/${guildId}/reaction-roles/${panelId}/post`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const data = await response.json();

        if (data.success) {
            alert('Panel posted successfully! Reloading page...');
            window.location.reload();
        } else {
            alert(`Error: ${data.error || 'Failed to post panel'}`);
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    } catch (error) {
        console.error('Error posting panel:', error);
        alert('Failed to post panel. Please try again.');
        btn.disabled = false;
        btn.innerHTML = originalContent;
    }
}
</script>
