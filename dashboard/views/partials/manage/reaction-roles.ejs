<!-- Emoji picker -->
<div id="emojiPickerModal" class="cf-modal" onclick="closeEmojiPicker(event)" hidden>
    <div class="cf-modal-dialog rr-emoji-dialog" role="dialog" aria-modal="true" aria-labelledby="rr-emoji-title" onclick="event.stopPropagation()">
        <header class="cf-modal-head">
            <div><h4 class="cf-modal-title" id="rr-emoji-title">Pick an emoji</h4></div>
            <button type="button" class="cf-modal-close" onclick="closeEmojiPicker()" aria-label="Close"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="cf-modal-body"><div class="emoji-grid" id="emojiGrid"></div></div>
    </div>
</div>

<script>
let currentEmojiInput = null;

// The emoji offered by the picker. These are content: the reaction a panel's members use.
const commonEmojis = [
    '✅', '❌', '✔️', '❎', '⭕', '🔴', '🟢', '🔵', '🟡', '🟣',
    '🟠', '⚪', '⚫', '🟤', '1️⃣', '2️⃣', '3️⃣', '4️⃣', '5️⃣', '6️⃣',
    '7️⃣', '8️⃣', '9️⃣', '🔟', '🎮', '🎨', '🎵', '🎬', '⚽', '🏀',
    '🏈', '⚾', '🎾', '🏐', '🏉', '🥏', '🎱', '🏓', '🏸', '🏒',
    '👍', '👎', '👌', '✌️', '🤝', '👏', '🙌', '👋', '✋', '👊',
    '🌟', '⭐', '🌙', '☀️', '⛅', '🌈', '❤️', '💙', '💚', '💛',
    '🧡', '💜', '🖤', '🤍', '🤎', '💯', '🔥', '💧', '💨', '⚡',
    '📢', '📅', '🎉', '🔔', '📊', '🌎', '🌍', '🌏', '😀', '😊'
];

function openEmojiPicker(button) {
    currentEmojiInput = button.previousElementSibling;
    const modal = document.getElementById('emojiPickerModal');
    const grid = document.getElementById('emojiGrid');
    grid.replaceChildren();
    commonEmojis.forEach(emoji => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'emoji-item';
        item.textContent = emoji;
        item.setAttribute('aria-label', emoji);
        item.onclick = () => selectEmoji(emoji);
        grid.appendChild(item);
    });
    modal.hidden = false;
    const first = grid.querySelector('button');
    if (first) first.focus();
}

function closeEmojiPicker(event) {
    if (!event || event.target.id === 'emojiPickerModal') {
        document.getElementById('emojiPickerModal').hidden = true;
        currentEmojiInput = null;
    }
}

function selectEmoji(emoji) {
    if (currentEmojiInput) {
        currentEmojiInput.value = emoji;
        currentEmojiInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
    closeEmojiPicker();
}
document.addEventListener('keydown', (e) => {
    const m = document.getElementById('emojiPickerModal');
    if (e.key === 'Escape' && m && !m.hidden) closeEmojiPicker();
});

// ── Small DOM helper: every value from the server is set as text, never parsed as HTML ──
function rrEl(tag, props, ...kids) {
    const n = document.createElement(tag);
    if (props) for (const [k, v] of Object.entries(props)) {
        if (v === null || v === undefined || v === false) continue;
        if (k === 'text') n.textContent = v;
        else if (k === 'className') n.className = v;
        else if (k === 'hidden') n.hidden = !!v;
        else if (k.startsWith('on')) n.addEventListener(k.slice(2), v);
        else if (k === 'value') n.value = v;
        else n.setAttribute(k, v === true ? '' : v);
    }
    for (const kid of kids.flat(Infinity)) if (kid !== null && kid !== undefined && kid !== false) n.appendChild(typeof kid === 'string' ? document.createTextNode(kid) : kid);
    return n;
}

// ── Redirect flash messages ──────────────────────────────────────────────────
function rrFlash(text, ok) {
    const el = document.getElementById('rrFlash');
    el.textContent = text;
    el.classList.remove('is-ok', 'is-bad', 'is-warn');
    el.classList.add(ok ? 'is-ok' : 'is-bad');
    el.hidden = false;
    el.scrollIntoView({ block: 'nearest' });
}
(function showRrFlash() {
    const params = new URLSearchParams(location.search);
    const success = params.get('success');
    const error = params.get('error');
    if (!success && !error) return;

    const TEXT = {
        panel_reposted: 'Panel reposted. The old message was deleted and a fresh one is live.',
        panel_created: 'Panel created. Check the roles below, then use Post to Discord.',
        panel_posted: 'Panel posted.',
        panel_deleted: 'Panel deleted.',
        panel_updated: 'Panel updated.',
        mapping_added: 'Role mapping added.',
        mapping_removed: 'Role mapping removed.',
        repost_failed: "Repost failed: the new message could not be posted. Check that the bot can see and send in that channel.",
        no_mappings: 'That panel has no role mappings yet, so there is nothing to post.',
        panel_not_found: 'That panel no longer exists.',
        missing_fields: 'Some required fields were missing.',
        create_failed: 'Could not create that panel.',
        emoji_required: 'Reaction panels need an emoji for each role.',
        delete_failed: 'Could not delete that panel.',
        remove_mapping_failed: 'Could not remove that mapping.',
        add_mapping_failed: 'Could not add that mapping.',
    };

    const key = success || error;
    rrFlash(TEXT[key] || (success ? 'Done.' : `Something went wrong (${key}).`), !!success);

    // Drop the params so a refresh doesn't replay a stale banner.
    params.delete('success'); params.delete('error'); params.delete('note');
    history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params : ''));
})();

// ── Page data ────────────────────────────────────────────────────────────────
const RR_GUILD_ID = '<%= guild.id %>';
const RR_BOT_NAME = <%- JSON.stringify(String(rrBotName)).replace(/</g, '\\u003c') %>;
// Roles for the template rows: `blocked` = managed or at/above the bot's highest role.
const RR_ROLES = <%- JSON.stringify((roles || []).map(r => ({ id: r.id, name: r.name, color: r.hexColor || null, blocked: rrBlocked(r) }))).replace(/</g, '\\u003c') %>;
// Panel-level fields only. Role mappings stay under each panel's add/remove controls,
// because the PUT replaces the whole mapping set when it's given one.
const RR_PANELS = <%- JSON.stringify((reactionRolePanels || []).map(p => ({
    id: p.id,
    panel_name: p.panel_name || '',
    channel_id: p.channel_id || '',
    description: p.description || '',
    embed_color: p.embed_color || '#a78bfa',
    panel_mode: p.panel_mode || 'normal',
    interaction_type: p.interaction_type || 'button',
    placeholder_text: p.placeholder_text || '',
    max_selections: p.max_selections || '',
    thumbnail_url: p.thumbnail_url || '',
    image_url: p.image_url || '',
    posted: !!(p.message_id && p.message_id !== 'PENDING'),
    // Seeds the first paint of each panel's mapping list; every later change replaces it
    // with whatever the API returns, so the two can't disagree.
    mappings: (p.mappings || []).map(m => ({
        id: m.id,
        role_id: m.role_id,
        role_name: (roles.find(r => r.id === m.role_id) || {}).name || null,
        emoji_id: m.emoji_id,
        label: m.label,
        button_style: m.button_style || 'primary'
    }))
}))).replace(/</g, '\\u003c') %>;

const RR_API = (panelId, path = '') => `/api/guilds/${RR_GUILD_ID}/reaction-roles/panels/${panelId}/mappings${path}`;
const rrRoleName = (id) => (RR_ROLES.find(r => r.id === String(id)) || {}).name || null;

async function rrRequest(url, options) {
    const res = await fetch(url, { credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, ...options });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) { const e = new Error(body.error || `Request failed (${res.status})`); e.body = body; throw e; }
    return body;
}

function rrStatus(el, message, ok = true) {
    if (!el) return;
    el.textContent = message;
    el.classList.toggle('is-bad', !ok);
    el.classList.toggle('is-ok', ok && !!message);
    if (message && ok) setTimeout(() => { if (el.textContent === message) el.textContent = ''; }, 4000);
}

// What happened to the message members actually see. Silence here is how a panel ends up
// looking correct on the dashboard and stale in Discord.
const RR_LIVE_NOTE = {
    updated: '',
    not_posted: ' (panel not posted yet)',
    message_gone: " The panel's message is gone from Discord; use Repost.",
    no_mappings: '',
    failed: " But the message in Discord could not be updated.",
};

function rrHint(type) {
    if (type === 'button') return 'Button';
    if (type === 'select_menu' || type === 'select') return 'Dropdown option';
    return 'Reaction';
}

function rrUpdateStats() {
    const total = RR_PANELS.reduce((sum, p) => sum + (p.mappings?.length || 0), 0);
    const roles = document.getElementById('rrStatRoles');
    const avg = document.getElementById('rrStatAvg');
    if (roles) roles.textContent = total;
    if (avg && RR_PANELS.length) avg.textContent = Math.round(total / RR_PANELS.length);
}

// ── Discord-style preview of a panel message ─────────────────────────────────
// Mirrors core/reaction-role-manager.js buildPanelMessage: title, colour, text, the
// "Available Roles" field, then buttons (5 per row), one dropdown, or reactions.
// rows: [{ emoji, label, role }] where role is the role's display name.
function rrPreview(panel, rows) {
    const type = panel.interaction_type || 'button';
    const colour = /^#[0-9a-f]{6}$/i.test(panel.embed_color || '') ? panel.embed_color : '#a78bfa';
    const embed = rrEl('div', { className: 'rr-pv-embed' },
        rrEl('div', { className: 'rr-pv-title', text: panel.panel_name || 'Panel name' }),
        panel.description ? rrEl('div', { className: 'rr-pv-desc', text: panel.description }) : null);
    embed.style.setProperty('--rr-pv-colour', colour);
    if (rows.length) {
        const field = rrEl('div', { className: 'rr-pv-field' }, rrEl('div', { className: 'rr-pv-field-name', text: 'Available Roles' }));
        rows.forEach(r => field.appendChild(rrEl('div', { className: 'rr-pv-line' },
            (type === 'reaction' ? (r.emoji || '▪️') + ' — ' : '▪️ '),
            rrEl('span', { className: 'rr-pv-mention', text: '@' + (r.role || 'role') }))));
        embed.appendChild(field);
    }
    if (panel.image_url) embed.appendChild(rrEl('div', { className: 'rr-pv-img', text: 'Image' }));

    let controls = null;
    if (!rows.length) {
        controls = rrEl('div', { className: 'rr-pv-empty', text: 'Roles you add show here.' });
    } else if (type === 'button') {
        controls = rrEl('div', { className: 'rr-pv-controls' }, rows.slice(0, 25).map(r =>
            rrEl('span', { className: 'rr-pv-btn' + (r.style && r.style !== 'primary' ? ' is-' + r.style : '') },
                r.emoji ? rrEl('span', { text: r.emoji }) : null, rrEl('span', { text: r.label || r.role || 'Role' }))));
    } else if (type === 'select_menu' || type === 'select') {
        controls = rrEl('div', { className: 'rr-pv-controls' },
            rrEl('div', { className: 'rr-pv-select' }, rrEl('span', { text: panel.placeholder_text || 'Choose your roles' }), rrEl('i', { className: 'fas fa-chevron-down', 'aria-hidden': 'true' })),
            rrEl('div', { className: 'rr-pv-options' }, rows.slice(0, 25).map(r => rrEl('div', { className: 'rr-pv-option' },
                r.emoji ? rrEl('span', { text: r.emoji }) : null,
                rrEl('span', null, r.label || r.role || 'Role', rrEl('small', { text: 'Get the ' + (r.role || 'role') + ' role' }))))));
    } else {
        controls = rrEl('div', { className: 'rr-pv-controls' }, rows.filter(r => r.emoji).slice(0, 20).map(r =>
            rrEl('span', { className: 'rr-pv-react' }, rrEl('span', { text: r.emoji }), rrEl('span', { text: '1' }))));
    }
    return rrEl('div', { className: 'rr-pv', 'aria-label': 'Preview of the panel message' },
        rrEl('div', { className: 'rr-pv-msg' },
            rrEl('span', { className: 'rr-pv-avatar', 'aria-hidden': 'true' }),
            rrEl('div', null,
                rrEl('div', { className: 'rr-pv-author' }, rrEl('span', { text: RR_BOT_NAME }), rrEl('span', { className: 'rr-pv-app', text: 'APP' })),
                embed, controls)));
}
const rrMappingRows = (mappings) => (mappings || []).map(m => ({
    emoji: m.emoji_id || '', label: m.label || m.role_name || rrRoleName(m.role_id) || '', role: m.role_name || rrRoleName(m.role_id) || 'deleted role', style: m.button_style || 'primary',
}));

// ── Role mappings: add, bulk add, remove — all without a page reload ─────────
function rrRenderMappings(panelId, mappings) {
    const panel = RR_PANELS.find(p => String(p.id) === String(panelId));
    if (panel) panel.mappings = mappings;

    const postBtn = document.querySelector(`[data-post-btn="${panelId}"]`);
    if (postBtn) postBtn.hidden = mappings.length === 0;
    rrUpdateStats();

    const wrap = document.getElementById(`rrMappingsWrap-${panelId}`);
    if (!wrap) return;

    if (!mappings.length) {
        wrap.replaceChildren(rrEl('div', { className: 'cf-state cf-state--empty' },
            rrEl('p', { className: 'cf-state-title', text: 'No roles on this panel yet' }),
            rrEl('p', { className: 'cf-state-text', text: 'Add one below. The panel can be posted once it has a role.' })));
        return;
    }

    const hint = rrHint(panel?.interaction_type);
    const list = rrEl('div', { className: 'cf-list' }, mappings.map(m => rrEl('div', { className: 'cf-list-item' },
        rrEl('div', { className: 'cf-list-main rr-mapping-main' },
            rrEl('span', { className: 'rr-mapping-emoji', text: m.emoji_id || '' }),
            rrEl('span', null,
                rrEl('span', { className: 'rr-mapping-role', text: m.label || m.role_name || 'Deleted role' }),
                rrEl('span', { className: 'rr-mapping-hint', text: (m.label && m.role_name ? '@' + m.role_name + ' · ' : (!m.role_name ? 'The role was deleted; remove this row · ' : '')) + hint }))),
        rrEl('div', { className: 'cf-list-actions' },
            rrEl('button', { type: 'button', className: 'btn btn-sm btn-secondary', title: 'Remove this role from the panel', text: 'Remove',
                onclick: (e) => rrRemoveMapping(panelId, m.id, e.currentTarget) })))));
    // The preview stays open across redraws once someone has opened it.
    const wasOpen = !!wrap.querySelector('details.rr-pv-details[open]');
    const details = rrEl('details', { className: 'cf-expand rr-pv-details' }, rrEl('summary', { text: 'Preview the message' }),
        rrEl('div', { className: 'cf-expand-body' }, panel ? rrPreview(panel, rrMappingRows(mappings)) : null));
    if (wasOpen) details.open = true;
    wrap.replaceChildren(rrEl('div', { className: 'cf-rows-head', text: `Roles on this panel (${mappings.length})` }), list, details);
}

async function rrAddMapping(event) {
    event.preventDefault();
    const form = event.target;
    const panelId = form.dataset.panel;
    const status = form.querySelector('[data-status]');
    const submit = form.querySelector('button[type=submit]');
    const data = new FormData(form);

    if (form.dataset.type === 'reaction' && !data.get('emoji_id')) { rrStatus(status, 'Pick an emoji first.', false); return false; }
    submit.disabled = true;
    rrStatus(status, 'Adding…');
    try {
        const body = await rrRequest(RR_API(panelId), {
            method: 'POST',
            body: JSON.stringify({
                role_id: data.get('role_id'),
                emoji_id: data.get('emoji_id') || null,
                label: data.get('label') || null,
                button_style: data.get('button_style') || 'primary',
            }),
        });
        rrRenderMappings(panelId, body.mappings);
        form.reset();
        rrStatus(status, `Added.${RR_LIVE_NOTE[body.liveMessage] ?? ''}`, body.liveMessage !== 'failed');
    } catch (err) {
        rrStatus(status, err.message, false);
    } finally {
        submit.disabled = false;
    }
    return false;
}

async function rrRemoveMapping(panelId, mappingId, button) {
    if (!confirm('Remove this role from the panel?')) return;
    button.disabled = true;
    const status = document.querySelector(`[data-status="${panelId}"]`);
    try {
        const body = await rrRequest(RR_API(panelId, `/${mappingId}`), { method: 'DELETE' });
        rrRenderMappings(panelId, body.mappings);
        rrStatus(status, `Removed.${RR_LIVE_NOTE[body.liveMessage] ?? ''}`, body.liveMessage !== 'failed');
    } catch (err) {
        button.disabled = false;
        rrStatus(status, err.message, false);
    }
}

function rrBulkReport(panelId, { added, errors }) {
    const box = document.querySelector(`[data-bulk-report="${panelId}"]`);
    if (!box) return;
    const parts = [];
    if (added && added.length) {
        parts.push(rrEl('div', { className: 'rr-bulk-ok' }, rrEl('strong', { text: `${added.length} will be added: ` }),
            added.map(a => [a.emoji_id, a.label || a.role_name].filter(Boolean).join(' ')).join(', ')));
    }
    if (errors && errors.length) {
        parts.push(rrEl('ul', { className: 'rr-bulk-errors' }, errors.map(e => rrEl('li', { text: `Line ${Number(e.line)}: ${e.error}` }))));
    }
    box.replaceChildren(...(parts.length ? parts : [rrEl('div', { className: 'rr-bulk-ok', text: 'Nothing to add.' })]));
}

async function rrBulkPreview(panelId) {
    const text = document.querySelector(`[data-bulk="${panelId}"] .rr-bulk-text`).value;
    const status = document.querySelector(`[data-bulk-status="${panelId}"]`);
    rrStatus(status, 'Checking…');
    try {
        const body = await rrRequest(RR_API(panelId, '/bulk'), {
            method: 'POST', body: JSON.stringify({ text, dryRun: true }),
        });
        rrBulkReport(panelId, { added: body.add, errors: body.errors });
        rrStatus(status, `${body.add.length} ready · ${body.used} of ${body.capacity} slots used`);
    } catch (err) {
        rrBulkReport(panelId, { added: [], errors: err.body?.errors || [] });
        rrStatus(status, err.message, false);
    }
}

async function rrBulkAdd(panelId) {
    const box = document.querySelector(`[data-bulk="${panelId}"]`);
    const text = box.querySelector('.rr-bulk-text').value;
    const status = document.querySelector(`[data-bulk-status="${panelId}"]`);
    rrStatus(status, 'Adding…');
    try {
        const body = await rrRequest(RR_API(panelId, '/bulk'), {
            method: 'POST', body: JSON.stringify({ text }),
        });
        rrRenderMappings(panelId, body.mappings);
        rrBulkReport(panelId, { added: [], errors: body.errors });
        // Only clear the box on a clean run — otherwise the rejected lines are still there to fix.
        if (!body.errors.length) box.querySelector('.rr-bulk-text').value = '';
        rrStatus(status, `Added ${body.added}.${RR_LIVE_NOTE[body.liveMessage] ?? ''}`, body.liveMessage !== 'failed');
    } catch (err) {
        rrBulkReport(panelId, { added: [], errors: err.body?.errors || [] });
        rrStatus(status, err.message, false);
    }
}

function rrPaintAll() { RR_PANELS.forEach(p => rrRenderMappings(p.id, p.mappings || [])); }
// The lists live in the DOM only after this runs, so never wait on an event that already fired.
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', rrPaintAll);
else rrPaintAll();

// Filter panels (shown when there are more than 15).
(function () {
    const input = document.querySelector('.rr-filter');
    if (!input) return;
    const empty = document.querySelector('.rr-filter-empty');
    input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        document.querySelectorAll('section.rr-panel').forEach(s => {
            const hit = !q || s.querySelector('.cf-section-head').textContent.toLowerCase().includes(q);
            s.hidden = !hit;
            if (hit) shown++;
        });
        if (empty) empty.hidden = shown > 0;
    });
})();

// ── Templates: starting points for a new panel ──────────────────────────────
// Each row's label doubles as the name of the role the bot creates when no existing role is picked.
const RR_TEMPLATES = {
    colours: {
        panel_name: 'Name colours', panel_mode: 'unique', interaction_type: 'button', embed_color: '#e91e63',
        description: 'Pick a colour for your name. Picking another one swaps it.',
        style: 'secondary', colours: true,
        rows: [['🔴', 'Red', '#e74c3c'], ['🟠', 'Orange', '#e67e22'], ['🟡', 'Yellow', '#f1c40f'], ['🟢', 'Green', '#2ecc71'],
               ['🔵', 'Blue', '#3498db'], ['🟣', 'Purple', '#9b59b6'], ['🌸', 'Pink', '#ff6fae'], ['🟤', 'Brown', '#a0522d'],
               ['⚪', 'White', '#f2f3f5'], ['⚫', 'Black', '#111214']],
    },
    pronouns: {
        panel_name: 'Pronouns', panel_mode: 'normal', interaction_type: 'button', embed_color: '#5865f2',
        description: 'Pick the pronouns you use. Pick one again to remove it.',
        style: 'secondary',
        rows: [['', 'He/him'], ['', 'She/her'], ['', 'They/them'], ['', 'Any pronouns'], ['', 'Ask my pronouns']],
    },
    notifications: {
        panel_name: 'Notifications', panel_mode: 'normal', interaction_type: 'button', embed_color: '#f1c40f',
        description: 'Choose what you want to be pinged for. Pick one again to stop.',
        style: 'primary',
        rows: [['📢', 'Announcements'], ['📅', 'Events'], ['🎉', 'Giveaways'], ['🔴', 'Going live'], ['📊', 'Polls'], ['🔔', 'Updates']],
    },
    regions: {
        panel_name: 'Regions', panel_mode: 'unique', interaction_type: 'select_menu', embed_color: '#2ecc71',
        description: 'Where are you based? It helps people find others in their time zone.',
        style: 'primary',
        rows: [['🌎', 'North America'], ['🌎', 'South America'], ['🌍', 'Europe'], ['🌍', 'Africa'], ['🌏', 'Asia'], ['🌏', 'Oceania']],
    },
};
const RR_STYLES = [['primary', 'Blue'], ['secondary', 'Grey'], ['success', 'Green'], ['danger', 'Red']];
const RR_NEW = '__new__';

(function rrCreateDialog() {
    const modal = document.getElementById('createPanelModal');
    if (!modal) return;
    const form = modal.querySelector('form');
    const f = (id) => document.getElementById(id);
    const tplBox = modal.querySelector('.rr-tpl');
    const rowsBox = modal.querySelector('.rr-tpl-rows');
    const pvSlot = modal.querySelector('.rr-create-pv');
    const status = modal.querySelector('.rr-create-status');
    const submit = modal.querySelector('.rr-create-submit');
    let tpl = null;   // the chosen template, or null for a blank panel

    const type = () => f('f-reaction-roles-interaction_type').value;

    function roleSelect(name) {
        const sel = rrEl('select', { className: 'form-select', 'aria-label': 'Role for this row' });
        const match = RR_ROLES.find(r => r.name.toLowerCase() === String(name || '').trim().toLowerCase() && !r.blocked);
        sel.appendChild(rrEl('option', { value: RR_NEW, text: 'Create "' + (name || 'new role') + '"' }));
        RR_ROLES.forEach(r => sel.appendChild(rrEl('option', { value: r.id, disabled: r.blocked, text: r.name + (r.blocked ? ' (above the bot)' : '') })));
        sel.value = match ? match.id : RR_NEW;
        return sel;
    }

    function addRow(emoji, label, colour, style) {
        const row = rrEl('div', { className: 'rr-tpl-row' + (type() === 'button' ? '' : ' no-style') });
        row._colour = colour || null;
        const emojiIn = rrEl('input', { type: 'text', className: 'form-control rr-tpl-emoji', maxlength: '64', value: emoji || '', 'aria-label': 'Emoji', placeholder: 'Emoji' });
        const labelIn = rrEl('input', { type: 'text', className: 'form-control rr-tpl-label', maxlength: '80', value: label || '', 'aria-label': 'Text and role name', placeholder: 'Text' });
        const sel = roleSelect(label);
        const styleSel = rrEl('select', { className: 'form-select rr-tpl-style', 'aria-label': 'Button colour', hidden: type() !== 'button' },
            RR_STYLES.map(([v, t]) => rrEl('option', { value: v, text: t })));
        styleSel.value = style || 'primary';
        const remove = rrEl('button', { type: 'button', className: 'btn btn-sm btn-secondary', 'aria-label': 'Remove this row', title: 'Remove this row' }, rrEl('i', { className: 'fas fa-xmark', 'aria-hidden': 'true' }));
        labelIn.addEventListener('input', () => {
            const opt = sel.querySelector(`option[value="${RR_NEW}"]`);
            if (opt) opt.textContent = 'Create "' + (labelIn.value.trim() || 'new role') + '"';
            draw();
        });
        [emojiIn, sel, styleSel].forEach(n => n.addEventListener(n.tagName === 'INPUT' ? 'input' : 'change', draw));
        remove.addEventListener('click', () => { row.remove(); draw(); });
        row.append(emojiIn, labelIn, sel, styleSel, remove);
        rowsBox.appendChild(row);
    }

    function rows() {
        return [...rowsBox.querySelectorAll('.rr-tpl-row')].map(row => {
            const [emojiIn, labelIn, sel, styleSel] = row.querySelectorAll('input, select');
            const label = labelIn.value.trim();
            return { emoji: emojiIn.value.trim(), label, roleId: sel.value, colour: row._colour, style: styleSel.value,
                role: sel.value === RR_NEW ? label : rrRoleName(sel.value) };
        });
    }

    function draw() {
        const panel = {
            panel_name: f('f-reaction-roles-panel_name').value.trim(),
            description: f('f-reaction-roles-description').value,
            embed_color: f('f-reaction-roles-embed_color').value,
            interaction_type: type(),
        };
        const isButton = type() === 'button';
        rowsBox.querySelectorAll('.rr-tpl-row').forEach(row => {
            row.classList.toggle('no-style', !isButton);
            row.querySelector('.rr-tpl-style').hidden = !isButton;
        });
        pvSlot.replaceChildren(rrPreview(panel, tpl ? rows() : []));
    }

    function choose(key) {
        tpl = RR_TEMPLATES[key] || null;
        modal.querySelectorAll('.rr-tpl-btn').forEach(b => b.setAttribute('aria-pressed', String(b.value === (key || ''))));
        rowsBox.replaceChildren();
        status.hidden = true;
        if (tpl) {
            f('f-reaction-roles-panel_name').value = tpl.panel_name;
            f('f-reaction-roles-description').value = tpl.description;
            f('f-reaction-roles-embed_color').value = tpl.embed_color;
            f('f-reaction-roles-panel_mode').value = tpl.panel_mode;
            f('f-reaction-roles-interaction_type').value = tpl.interaction_type;
            tpl.rows.forEach(([emoji, label, colour]) => addRow(emoji, label, colour, tpl.style));
        }
        tplBox.hidden = !tpl;
        draw();
    }

    modal.querySelectorAll('.rr-tpl-btn').forEach(b => b.addEventListener('click', () => choose(b.value)));
    modal.querySelector('.rr-tpl-add').addEventListener('click', () => { addRow('', '', null, tpl ? tpl.style : 'primary'); draw(); rowsBox.lastElementChild.querySelector('.rr-tpl-label').focus(); });
    ['f-reaction-roles-panel_name', 'f-reaction-roles-description', 'f-reaction-roles-embed_color'].forEach(id => f(id).addEventListener('input', draw));
    f('f-reaction-roles-interaction_type').addEventListener('change', draw);
    modal.addEventListener('show.bs.modal', draw);
    draw();

    function fail(message) {
        status.className = 'cf-notice is-bad rr-create-status';
        status.textContent = message;
        status.hidden = false;
        submit.disabled = false;
    }

    // A blank panel posts the form as before. A template creates any missing roles, then the
    // panel with all its roles, through the API.
    form.addEventListener('submit', async (e) => {
        const list = tpl ? rows() : [];
        if (!list.length) return;
        e.preventDefault();
        status.hidden = true;

        const t = type();
        if (list.some(r => !r.label)) return fail('Every row needs text. Remove the empty rows.');
        if (t === 'reaction' && list.some(r => !r.emoji)) return fail('Reaction panels need an emoji on every row.');
        if (list.length > (t === 'reaction' ? 20 : 25)) return fail(`A ${t === 'reaction' ? 'reaction' : 'button or dropdown'} panel holds at most ${t === 'reaction' ? 20 : 25} roles.`);
        const toCreate = list.filter(r => r.roleId === RR_NEW);
        if (toCreate.some(r => r.label.includes('|') || r.label.startsWith('//') || r.label.length > 100)) return fail('Role names cannot contain "|", start with "//" or be longer than 100 characters.');
        const picked = list.filter(r => r.roleId !== RR_NEW).map(r => r.roleId);
        if (new Set(picked).size !== picked.length) return fail('The same role is picked on two rows.');
        if (toCreate.length && !confirm(`Create ${toCreate.length} new role${toCreate.length === 1 ? '' : 's'} (${toCreate.map(r => r.label).join(', ')})?`)) return;

        submit.disabled = true;
        try {
            const idByName = {};
            if (toCreate.length) {
                status.className = 'cf-notice is-info rr-create-status'; status.textContent = 'Creating roles…'; status.hidden = false;
                const names = toCreate.map(r => r.label + (r.colour ? ' | ' + r.colour : '')).join('\n');
                const made = await rrRequest(`/api/guilds/${RR_GUILD_ID}/bulk-roles/create`, { method: 'POST', body: JSON.stringify({ names, preset: 'none' }) });
                (made.created || []).forEach(r => { idByName[r.name.toLowerCase()] = r.id; RR_ROLES.push({ id: r.id, name: r.name, color: r.color, blocked: false }); });
                const missing = toCreate.filter(r => !idByName[r.label.toLowerCase()]);
                if (missing.length) {
                    const why = (made.failed || []).map(x => `${x.name}: ${x.error}`).join('; ');
                    return fail(`Could not create ${missing.map(r => r.label).join(', ')}${why ? ` (${why})` : ''}. Roles that were created are kept; pick them in the rows and try again.`);
                }
            }
            status.className = 'cf-notice is-info rr-create-status'; status.textContent = 'Creating the panel…'; status.hidden = false;
            const body = {
                panel_name: f('f-reaction-roles-panel_name').value.trim(),
                channel_id: f('f-reaction-roles-channel_id').value,
                description: f('f-reaction-roles-description').value,
                embed_color: f('f-reaction-roles-embed_color').value,
                panel_mode: f('f-reaction-roles-panel_mode').value,
                interaction_type: t,
                max_selections: 0,
                mappings: list.map(r => ({
                    role_id: r.roleId === RR_NEW ? idByName[r.label.toLowerCase()] : r.roleId,
                    emoji_id: r.emoji || null,
                    // Text equal to the role name is left blank so the panel follows a later rename.
                    label: r.label && r.label !== r.role ? r.label : null,
                    button_style: t === 'button' ? r.style : 'primary',
                })),
            };
            await rrRequest(`/api/guilds/${RR_GUILD_ID}/reaction-roles/panels`, { method: 'POST', body: JSON.stringify(body) });
            location.href = `/manage/${RR_GUILD_ID}?page=reaction-roles&success=panel_created`;
        } catch (err) {
            fail(err.message);
        }
    });
})();

// ── Panel editing ────────────────────────────────────────────────────────────
function rrToggleSelectFields() {
    const isSelect = document.getElementById('rrEditType').value === 'select_menu';
    document.getElementById('rrEditSelectOnly').hidden = !isSelect;
}

function rrEditPanelValues() {
    return {
        panel_name: document.getElementById('rrEditPanelName').value.trim(),
        description: document.getElementById('rrEditDescription').value,
        embed_color: document.getElementById('rrEditColor').value,
        interaction_type: document.getElementById('rrEditType').value,
        placeholder_text: document.getElementById('rrEditPlaceholder').value,
        image_url: document.getElementById('rrEditImage').value,
    };
}
function rrDrawEditPreview() {
    const id = document.getElementById('rrEditId').value;
    const panel = RR_PANELS.find(p => String(p.id) === String(id));
    const slot = document.querySelector('#editPanelModal .rr-edit-pv');
    if (slot) slot.replaceChildren(rrPreview(rrEditPanelValues(), rrMappingRows(panel ? panel.mappings : [])));
}

function openEditPanel(panelId) {
    const panel = RR_PANELS.find(p => String(p.id) === String(panelId));
    if (!panel) return;
    document.getElementById('rrEditId').value = panel.id;
    document.getElementById('rrEditName').textContent = panel.panel_name;
    document.getElementById('rrEditPanelName').value = panel.panel_name;
    document.getElementById('rrEditChannel').value = panel.channel_id;
    document.getElementById('rrEditDescription').value = panel.description;
    document.getElementById('rrEditColor').value = /^#[0-9a-f]{6}$/i.test(panel.embed_color) ? panel.embed_color : '#a78bfa';
    document.getElementById('rrEditMode').value = panel.panel_mode;
    document.getElementById('rrEditType').value = panel.interaction_type;
    document.getElementById('rrEditPlaceholder').value = panel.placeholder_text;
    document.getElementById('rrEditMaxSelections').value = panel.max_selections;
    document.getElementById('rrEditThumbnail').value = panel.thumbnail_url;
    document.getElementById('rrEditImage').value = panel.image_url;
    document.getElementById('rrEditChannelHelp').textContent = panel.posted
        ? 'Moving a posted panel deletes the old message; you then post it fresh in the new channel.'
        : 'This panel has not been posted yet, so changing the channel just changes where it will go.';
    const status = document.getElementById('rrEditStatus');
    status.hidden = true;
    status.textContent = '';
    rrToggleSelectFields();
    rrDrawEditPreview();
    new bootstrap.Modal(document.getElementById('editPanelModal')).show();
}

document.addEventListener('DOMContentLoaded', function () {
    const typeSel = document.getElementById('rrEditType');
    if (typeSel) typeSel.addEventListener('change', () => { rrToggleSelectFields(); rrDrawEditPreview(); });
    ['rrEditPanelName', 'rrEditDescription', 'rrEditColor', 'rrEditPlaceholder', 'rrEditImage'].forEach(id => {
        const n = document.getElementById(id);
        if (n) n.addEventListener('input', rrDrawEditPreview);
    });

    const saveBtn = document.getElementById('rrEditSave');
    if (!saveBtn) return;
    saveBtn.addEventListener('click', async function () {
        const panelId = document.getElementById('rrEditId').value;
        const status = document.getElementById('rrEditStatus');
        const name = document.getElementById('rrEditPanelName').value.trim();
        if (!name) {
            status.hidden = false; status.className = 'cf-notice is-bad';
            status.textContent = 'Panel name is required.';
            return;
        }

        const maxRaw = document.getElementById('rrEditMaxSelections').value;
        const body = {
            panel_name: name,
            channel_id: document.getElementById('rrEditChannel').value,
            description: document.getElementById('rrEditDescription').value,
            embed_color: document.getElementById('rrEditColor').value,
            panel_mode: document.getElementById('rrEditMode').value,
            interaction_type: document.getElementById('rrEditType').value,
            placeholder_text: document.getElementById('rrEditPlaceholder').value,
            max_selections: maxRaw === '' ? 0 : parseInt(maxRaw, 10) || 0,
            thumbnail_url: document.getElementById('rrEditThumbnail').value,
            image_url: document.getElementById('rrEditImage').value
        };

        saveBtn.disabled = true;
        const original = saveBtn.textContent;
        saveBtn.textContent = 'Saving…';
        status.hidden = false; status.className = 'cf-notice is-info'; status.textContent = 'Saving…';

        try {
            const resp = await fetch(`/api/guilds/${RR_GUILD_ID}/reaction-roles/panels/${panelId}`, {
                method: 'PUT',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await resp.json().catch(() => ({}));
            if (!resp.ok || data.error) throw new Error(data.error || `Save failed (${resp.status})`);

            const outcomes = {
                updated: ['ok', 'Saved. The posted message was updated in place, so pins and links still work.'],
                not_posted: ['ok', 'Saved. This panel is not posted yet; use Post to Discord when you are ready.'],
                moved_needs_post: ['warn', 'Saved and moved. The old message was deleted; use Post to Discord to post it in the new channel.'],
                message_gone: ['warn', 'Saved, but the posted message no longer exists in Discord. Use Post to Discord to put it back.'],
                no_mappings: ['warn', 'Saved, but this panel has no roles yet, so there is nothing to show.'],
                failed: ['warn', 'Saved, but refreshing the posted message failed. Check the bot logs, then try Repost.']
            };
            const [cls, text] = outcomes[data.liveMessage] || ['ok', 'Saved.'];
            status.className = 'cf-notice ' + ({ ok: 'is-ok', warn: 'is-warn' }[cls] || 'is-info');
            status.textContent = text + ' Reloading…';
            setTimeout(() => window.location.reload(), 1600);
        } catch (err) {
            status.className = 'cf-notice is-bad';
            status.textContent = err.message;
        } finally {
            saveBtn.disabled = false;
            saveBtn.textContent = original;
        }
    });
});

async function postPanel(guildId, panelId, btn) {
    if (!confirm('Post this panel to Discord? This creates the message in the panel channel.')) return;
    btn = btn || document.querySelector(`[data-post-btn="${panelId}"]`);
    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Posting…';
    try {
        const response = await fetch(`/api/guilds/${guildId}/reaction-roles/${panelId}/post`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json().catch(() => ({}));
        if (data.success) {
            location.href = `/manage/${guildId}?page=reaction-roles&success=panel_posted`;
            return;
        }
        rrFlash(`Could not post the panel: ${data.error || 'unknown error'}`, false);
    } catch (error) {
        rrFlash('Could not post the panel. Check your connection and try again.', false);
    }
    btn.disabled = false;
    btn.textContent = original;
}
</script>
