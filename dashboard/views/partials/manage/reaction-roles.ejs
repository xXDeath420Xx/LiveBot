                    <div class="cf-notice rr-create-status" role="status" hidden></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rr-create-submit">Create panel</button>
                </div>
            </form>
        </div>
    </div>
</div>

