<%
// Emoji and stickers: slot usage, drawing, splitting and animating emoji, and the server's emoji
// and sticker lists with upload / edit / delete dialogs. Everything loads from the emoji-manager
// JSON API after the page renders. Built on the settings-row kit (cf-settings.css); ids and the
// page script's requests are unchanged.
%>
<style>
/* Discord's own chat backgrounds, so a preview shows the emoji as members will see it. */
.em-page { --em-chat-dark: #313338; --em-chat-light: #ffffff; }

/* Slot usage meters under the counters */
.em-kpi-value { display: block; }
.em-progress-bar { height: 4px; margin-top: var(--cf-2); border-radius: 999px; overflow: hidden; background: var(--cf-surface-3); }
.em-progress-fill { height: 100%; border-radius: inherit; background: var(--cf-accent); transition: width 0.4s var(--cf-ease); }
.em-progress-fill.warning { background: var(--cf-warning); }
.em-progress-fill.danger { background: var(--cf-danger); }

/* Tool rows */
.em-result { display: flex; gap: var(--cf-5); align-items: flex-start; flex-wrap: wrap; }
.em-result-side { flex: 1 1 16rem; min-width: 0; display: flex; flex-direction: column; gap: var(--cf-3); }
.em-result-buttons { display: flex; gap: var(--cf-2); flex-wrap: wrap; }
.em-previews { display: flex; gap: var(--cf-2); flex-wrap: wrap; }
.em-chat { display: flex; gap: var(--cf-3); align-items: center; padding: var(--cf-3); border-radius: var(--cf-radius); background: var(--em-chat-dark); }
.em-chat--light { background: var(--em-chat-light); border: 1px solid var(--cf-border); }
.em-chat img { display: block; max-width: 100%; height: auto; }
.em-sheet-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr)); gap: var(--cf-3); }
.em-sheet-cell { display: flex; flex-direction: column; align-items: center; gap: var(--cf-2); padding: var(--cf-3);
    border-radius: var(--cf-radius); background: var(--em-chat-dark); }
.em-sheet-cell img { display: block; max-width: 100%; height: auto; }
.em-sheet-cell input { width: 100%; }

/* Emoji and sticker lists */
.em-list { padding: var(--cf-4) var(--cf-5); }
.em-list > .cf-state { padding: var(--cf-6) 0; }
.em-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: var(--cf-2); }
.em-grid.sticker-grid { grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); }
.em-item { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 0;
    padding: var(--cf-3) var(--cf-2); text-align: center; border: 1px solid var(--cf-border); border-radius: var(--cf-radius);
    background: var(--cf-surface-2); }
.em-item img { width: 48px; height: 48px; object-fit: contain; }
.em-item.sticker-item img { width: 80px; height: 80px; }
.em-item-name { max-width: 100%; font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-2); line-height: 1.3; overflow-wrap: anywhere; }
.em-item-tags { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
.em-item-actions { position: absolute; top: 4px; right: 4px; display: flex; gap: 4px; }
.em-item-actions button { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; padding: 0;
    border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius-sm); background: var(--cf-surface);
    color: var(--cf-text-2); font-size: var(--cf-text-xs); cursor: pointer; }
.em-item-actions button:hover { color: var(--cf-text); border-color: var(--cf-text-3); }
.em-item-actions .em-btn-delete:hover { color: var(--cf-danger); border-color: var(--cf-danger); }
.em-item-actions button:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 1px; }
@media (hover: hover) {
    .em-item-actions { opacity: 0; transition: opacity var(--cf-fast) var(--cf-ease); }
    .em-item:hover .em-item-actions, .em-item:focus-within .em-item-actions { opacity: 1; }
}
.em-item[hidden] { display: none; }
.em-nomatch { margin: var(--cf-3) 0 0; font-size: var(--cf-text-sm); color: var(--cf-text-3); }
.em-managed-badge { position: absolute; top: 4px; left: 4px; padding: 1px 5px; border-radius: var(--cf-radius-sm);
    font-size: 10px; font-weight: 600; color: var(--cf-warning); background: color-mix(in srgb, var(--cf-warning) 14%, transparent); }

/* Dialogs (the kit's .cf-modal shell): the delete confirmation is a narrow one. */
.em-confirm { --cf-modal-w: 24rem; }
.em-confirm-text { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
.em-preview-area { display: none; text-align: center; }
.em-preview-area img { max-width: 128px; max-height: 128px; border-radius: var(--cf-radius); border: 1px solid var(--cf-border); }
.em-preview-area.sticker-preview img { max-width: 160px; max-height: 160px; }

.em-toast { position: fixed; right: var(--cf-5); bottom: var(--cf-5); z-index: 10003; max-width: min(28rem, calc(100vw - 2 * var(--cf-4)));
    padding: var(--cf-3) var(--cf-4); border: 1px solid var(--cf-border-strong); border-left: 3px solid var(--cf-text-3);
    border-radius: var(--cf-radius); background: var(--cf-surface); color: var(--cf-text); font-size: var(--cf-text-sm);
    animation: emSlideIn 0.2s var(--cf-ease); }
.em-toast.success { border-left-color: var(--cf-success); }
.em-toast.error { border-left-color: var(--cf-danger); }
@keyframes emSlideIn { from { transform: translateY(8px); opacity: 0; } to { transform: none; opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .em-toast { animation: none; } }

@media (max-width: 640px) {
    .em-list { padding: var(--cf-4); }
    .em-item-actions button { width: 32px; height: 32px; }
    .em-toast { left: var(--cf-4); right: var(--cf-4); bottom: var(--cf-4); }
}
</style>

<div class="page-section em-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-icons"></i>
                <span>Emoji and stickers</span>
            </div>
            <div class="page-section-subtitle">Tools to draw, split and animate new emoji are below the lists.</div>
        </div>
    </div>

    <dl class="cf-kpis" id="emStatsGrid" aria-label="Slots used">
        <div class="cf-kpi">
            <dt>Static emoji</dt>
            <dd class="cf-kpi-value"><span class="em-kpi-value" id="emStaticCount">-</span><div class="em-progress-bar"><div class="em-progress-fill" id="emStaticBar" style="width: 0%"></div></div></dd>
        </div>
        <div class="cf-kpi">
            <dt>Animated emoji</dt>
            <dd class="cf-kpi-value"><span class="em-kpi-value" id="emAnimatedCount">-</span><div class="em-progress-bar"><div class="em-progress-fill" id="emAnimatedBar" style="width: 0%"></div></div></dd>
        </div>
        <div class="cf-kpi">
            <dt>Stickers</dt>
            <dd class="cf-kpi-value"><span class="em-kpi-value" id="emStickerCount">-</span><div class="em-progress-bar"><div class="em-progress-fill" id="emStickerBar" style="width: 0%"></div></div></dd>
        </div>
        <div class="cf-kpi">
            <dt>Boost level</dt>
            <dd class="cf-kpi-value"><span class="em-kpi-value" id="emBoostLevel">-</span></dd>
        </div>
    </dl>

    <section class="cf-section" aria-labelledby="em-static-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="em-static-title">Static emoji <span class="cf-chip" data-em-count="emStaticGrid" hidden></span></h2>
                <p class="cf-section-desc">Point at an emoji to rename or delete it. Emoji marked App belong to an integration and cannot be changed here.</p>
            </div>
            <div class="cf-section-actions" data-em-actions="emStaticGrid">
                <button type="button" class="btn btn-secondary btn-sm" onclick="openUploadModal('emoji')">Upload emoji</button>
            </div>
        </header>
        <div class="cf-rows">
            <div class="em-list" id="emStaticGrid">
                <div class="cf-state cf-state--loading" role="status" aria-live="polite"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading emoji</p></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="em-animated-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="em-animated-title">Animated emoji <span class="cf-chip" data-em-count="emAnimatedGrid" hidden></span></h2>
                <p class="cf-section-desc">Animated emoji have their own slots, separate from static ones.</p>
            </div>
            <div class="cf-section-actions" data-em-actions="emAnimatedGrid">
                <button type="button" class="btn btn-secondary btn-sm" onclick="openUploadModal('emoji')">Upload GIF</button>
            </div>
        </header>
        <div class="cf-rows">
            <div class="em-list" id="emAnimatedGrid">
                <div class="cf-state cf-state--loading" role="status" aria-live="polite"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading emoji</p></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="em-sticker-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="em-sticker-title">Stickers <span class="cf-chip" data-em-count="emStickerGrid" hidden></span></h2>
                <p class="cf-section-desc">Point at a sticker to edit or delete it.</p>
            </div>
            <div class="cf-section-actions" data-em-actions="emStickerGrid">
                <button type="button" class="btn btn-secondary btn-sm" onclick="openUploadModal('sticker')">Upload sticker</button>
            </div>
        </header>
        <div class="cf-rows">
            <div class="em-list" id="emStickerGrid">
                <div class="cf-state cf-state--loading" role="status" aria-live="polite"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading stickers</p></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="em-draw-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="em-draw-title">Draw an emoji</h2>
                <p class="cf-section-desc">Describe it and the bot draws it as a sticker-style image, removes the background and sizes it for Discord. Add a photo to have it draw that instead, such as a pet or a plush. Nothing is added to the server until you choose to.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-fields">
                    <div class="cf-field">
                        <label for="emGenSubject">What it should show</label>
                        <input type="text" class="form-control" id="emGenSubject" maxlength="300" placeholder="a fluffy black cat with heart eyes">
                        <span class="cf-field-hint">One subject. Avoid asking for words: drawn letters come out wrong.</span>
                    </div>
                    <div class="cf-field">
                        <label for="emGenRef">Photo to work from (optional)</label>
                        <input type="file" class="form-control" id="emGenRef" accept="image/png,image/jpeg,image/webp">
                    </div>
                </div>
            </div>
            <div class="cf-row cf-row--stack" id="emGenResult" hidden>
                <div class="em-result">
                    <!-- Shown at the two sizes it will actually be seen at. -->
                    <div class="em-chat">
                        <img id="emGenBig" src="" alt="Generated emoji preview" width="128" height="128">
                        <img id="emGenSmall" src="" alt="Generated emoji at message size" width="32" height="32">
                    </div>
                    <div class="em-result-side">
                        <div class="cf-field">
                            <label for="emGenName">Emoji name</label>
                            <input type="text" class="form-control" id="emGenName" maxlength="32" placeholder="emoji_name">
                            <div class="cf-field-hint" id="emGenMeta">2-32 characters, letters, numbers, underscores only</div>
                        </div>
                        <div class="em-result-buttons">
                            <button type="button" class="btn btn-primary btn-sm" id="emGenAdd" onclick="addGeneratedEmote()">Add to the server</button>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="generateEmote()">Draw another</button>
                            <a id="emGenDownload" class="btn btn-secondary btn-sm" download="emoji.png" href="#">Save the file</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="emGenBtn" onclick="generateEmote()">Draw it</button>
                <span class="cf-status-line" id="emGenStatus" role="status"></span>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="em-sheet-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="em-sheet-title">Split an emote sheet</h2>
                <p class="cf-section-desc">Upload a sticker pack saved as one picture and each emote on it is cut out, its background removed and sized for Discord. Any layout works. Name the ones you want, then add them.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="emSheetFile">Sheet image</label>
                    <p class="cf-row-desc">PNG, JPEG or WebP, up to 12MB. The emotes need a plain background behind them.</p>
                </div>
                <div class="cf-row-control">
                    <input type="file" class="form-control" id="emSheetFile" accept="image/png,image/jpeg,image/webp">
                </div>
            </div>
            <div class="cf-row cf-row--stack" id="emSheetResult" hidden>
                <div class="em-sheet-grid" id="emSheetGrid"></div>
                <div class="em-result-buttons">
                    <button type="button" class="btn btn-primary btn-sm" id="emSheetAdd" onclick="addSheetEmotes()">Add the named ones</button>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="emSheetBtn" onclick="splitSheet()">Split the sheet</button>
                <span class="cf-status-line" id="emSheetStatus" role="status"></span>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="em-anim-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="em-anim-title">Animate an emoji</h2>
                <p class="cf-section-desc">Add a hop, shake, spin or rainbow to a still emoji. The result uses an animated slot, so no static slot is spent, and the original stays as it is.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="emAnimSource">Emoji</label>
                    <p class="cf-row-desc">One of the server's static emoji.</p>
                </div>
                <div class="cf-row-control">
                    <select id="emAnimSource" class="form-select"></select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="emAnimFile">Or an image</label>
                    <p class="cf-row-desc">Upload an image to animate instead of a server emoji.</p>
                </div>
                <div class="cf-row-control">
                    <input type="file" class="form-control" id="emAnimFile" accept="image/png,image/jpeg,image/webp">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="emAnimEffect">Effect</label>
                    <p class="cf-row-desc">How it moves.</p>
                </div>
                <div class="cf-row-control">
                    <select id="emAnimEffect" class="form-select"></select>
                </div>
            </div>
            <div class="cf-row cf-row--stack" id="emAnimResult" hidden>
                <div class="em-result">
                    <!-- Both themes, because a GIF has no soft edges and that shows -->
                    <div class="em-previews">
                        <div class="em-chat">
                            <img id="emAnimBig" src="" alt="Animated preview" width="128" height="128">
                            <img id="emAnimSmall" src="" alt="Animated preview at message size" width="32" height="32">
                        </div>
                        <div class="em-chat em-chat--light">
                            <img id="emAnimLight" src="" alt="Animated preview on a light background" width="64" height="64">
                        </div>
                    </div>
                    <div class="em-result-side">
                        <div class="cf-field">
                            <label for="emAnimName">Emoji name</label>
                            <input type="text" class="form-control" id="emAnimName" maxlength="32" placeholder="emoji_name">
                            <div class="cf-field-hint" id="emAnimMeta">2-32 characters, letters, numbers, underscores only</div>
                        </div>
                        <div class="em-result-buttons">
                            <button type="button" class="btn btn-primary btn-sm" id="emAnimAdd" onclick="addAnimatedEmoji()">Add to the server</button>
                            <a id="emAnimDownload" class="btn btn-secondary btn-sm" download="emoji.gif" href="#">Save the GIF</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="emAnimBtn" onclick="animateEmoji()">Animate</button>
                <span class="cf-status-line" id="emAnimStatus" role="status"></span>
            </div>
        </div>
    </section>
</div>

<!-- Upload dialog -->
<div class="cf-modal" id="emUploadModal" hidden>
    <div class="cf-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="emUploadTitle">
        <header class="cf-modal-head">
            <div><h3 class="cf-modal-title" id="emUploadTitle">Upload emoji</h3></div>
            <button type="button" class="cf-modal-close" onclick="closeUploadModal()" aria-label="Close"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="cf-modal-body">
            <div class="cf-dropzone" id="emDropzone">
                <input type="file" id="emFileInput" accept="image/png,image/jpeg,image/gif,image/webp" aria-label="Image file">
                <i class="fas fa-cloud-arrow-up cf-dropzone-icon" aria-hidden="true"></i>
                <span class="cf-dropzone-text">Drop an image here or click to choose one</span>
                <span class="cf-dropzone-hint" id="emDropzoneHint">PNG, JPEG, GIF, WebP &middot; Max 256KB</span>
            </div>
            <div class="em-preview-area" id="emPreviewArea">
                <img id="emPreviewImg" src="" alt="Preview">
            </div>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="emNameInput">Name</label>
                        <p class="cf-row-desc" id="emNameHint">2-32 characters, letters, numbers, underscores only</p>
                    </div>
                    <div class="cf-row-control"><input type="text" class="form-control" id="emNameInput" placeholder="emoji_name" maxlength="32"></div>
                </div>
                <!-- Sticker-only fields -->
                <div class="cf-row cf-row--stack" id="emTagsField" hidden>
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="emTagsInput">Related emoji</label>
                        <p class="cf-row-desc">Required. The name of a related default emoji, such as wave, smile or heart.</p>
                    </div>
                    <div class="cf-row-control"><input type="text" class="form-control" id="emTagsInput" placeholder="wave" maxlength="200"></div>
                </div>
                <div class="cf-row cf-row--stack" id="emDescField" hidden>
                    <div class="cf-row-text"><label class="cf-row-label" for="emDescInput">Description</label></div>
                    <div class="cf-row-control"><textarea class="form-control" id="emDescInput" placeholder="What the sticker shows" rows="2" maxlength="100"></textarea></div>
                </div>
            </div>
        </div>
        <footer class="cf-modal-foot">
            <button type="button" class="btn btn-secondary" onclick="closeUploadModal()">Cancel</button>
            <button type="button" class="btn btn-primary" id="emUploadSubmit" onclick="submitUpload()" disabled>Upload</button>
        </footer>
    </div>
</div>

<!-- Edit dialog -->
<div class="cf-modal" id="emEditModal" hidden>
    <div class="cf-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="emEditTitle">
        <header class="cf-modal-head">
            <div><h3 class="cf-modal-title" id="emEditTitle">Edit</h3></div>
            <button type="button" class="cf-modal-close" onclick="closeEditModal()" aria-label="Close"><i class="fas fa-xmark" aria-hidden="true"></i></button>
        </header>
        <div class="cf-modal-body">
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text"><label class="cf-row-label" for="emEditName">Name</label></div>
                    <div class="cf-row-control"><input type="text" class="form-control" id="emEditName" maxlength="32"></div>
                </div>
                <div class="cf-row cf-row--stack" id="emEditTagsField" hidden>
                    <div class="cf-row-text"><label class="cf-row-label" for="emEditTags">Related emoji</label></div>
                    <div class="cf-row-control"><input type="text" class="form-control" id="emEditTags" maxlength="200"></div>
                </div>
                <div class="cf-row cf-row--stack" id="emEditDescField" hidden>
                    <div class="cf-row-text"><label class="cf-row-label" for="emEditDesc">Description</label></div>
                    <div class="cf-row-control"><textarea class="form-control" id="emEditDesc" rows="2" maxlength="100"></textarea></div>
                </div>
            </div>
        </div>
        <footer class="cf-modal-foot">
            <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
            <button type="button" class="btn btn-primary" id="emEditSubmit" onclick="submitEdit()">Save</button>
        </footer>
    </div>
</div>

<!-- Delete confirmation -->
<div class="cf-modal" id="emConfirmDelete" hidden>
    <div class="cf-modal-dialog em-confirm" role="alertdialog" aria-modal="true" aria-labelledby="em-confirm-title">
        <header class="cf-modal-head">
            <div><h3 class="cf-modal-title" id="em-confirm-title">Delete <span id="emDeleteName"></span>?</h3></div>
        </header>
        <div class="cf-modal-body"><p class="em-confirm-text">This cannot be undone.</p></div>
        <footer class="cf-modal-foot">
            <button type="button" class="btn btn-secondary" onclick="closeConfirm()">Cancel</button>
            <button type="button" class="btn btn-danger" id="emConfirmBtn" onclick="confirmDelete()">Delete</button>
        </footer>
    </div>
</div>

<script>
(function() {
    const GUILD_ID = '<%= guild.id %>';
    const API_BASE = '/api/guilds/' + GUILD_ID + '/emoji-manager';

    let uploadType = 'emoji';
    let selectedFile = null;
    let editType = null;
    let editId = null;
    let deleteType = null;
    let deleteId = null;

    loadData();

    async function loadData() {
        try {
            const resp = await fetch(API_BASE, { credentials: 'include' });
            const data = await resp.json();
            if (!data.success) throw new Error(data.error);

            renderStats(data.limits);
            renderEmojis('emStaticGrid', data.emojis.static);
            fillAnimSources(data.emojis.static);
            renderEmojis('emAnimatedGrid', data.emojis.animated);
            renderStickers(data.stickers);
        } catch (err) {
            ['emStaticGrid', 'emAnimatedGrid', 'emStickerGrid'].forEach(function(id) {
                var box = document.getElementById(id);
                box.textContent = '';
                box.appendChild(stateEl('error', 'Could not load the emoji', 'The bot may be reconnecting. Reload the page to try again.'));
            });
            showToast(err.message, 'error');
        }
    }

    function renderStats(limits) {
        var staticPct = limits.emojiSlots ? Math.round(limits.staticUsed / limits.emojiSlots * 100) : 0;
        var animPct = limits.emojiSlots ? Math.round(limits.animatedUsed / limits.emojiSlots * 100) : 0;
        var stickerPct = limits.stickerSlots ? Math.round(limits.stickersUsed / limits.stickerSlots * 100) : 0;

        document.getElementById('emStaticCount').textContent = limits.staticUsed + '/' + limits.emojiSlots;
        document.getElementById('emAnimatedCount').textContent = limits.animatedUsed + '/' + limits.emojiSlots;
        document.getElementById('emStickerCount').textContent = limits.stickersUsed + '/' + limits.stickerSlots;
        document.getElementById('emBoostLevel').textContent = limits.premiumTier ? 'Level ' + limits.premiumTier : 'None';

        setBar('emStaticBar', staticPct);
        setBar('emAnimatedBar', animPct);
        setBar('emStickerBar', stickerPct);
    }

    function setBar(id, pct) {
        var bar = document.getElementById(id);
        bar.style.width = pct + '%';
        bar.className = 'em-progress-fill' + (pct >= 90 ? ' danger' : pct >= 70 ? ' warning' : '');
    }

    // Empty / error states drawn the same way as the kit's _state partial.
    function stateEl(kind, title, text) {
        var box = document.createElement('div');
        box.className = 'cf-state cf-state--' + kind;
        if (kind === 'error') box.setAttribute('role', 'alert');
        var t = document.createElement('p');
        t.className = 'cf-state-title';
        t.textContent = title;
        box.appendChild(t);
        if (text) {
            var d = document.createElement('p');
            d.className = 'cf-state-text';
            d.textContent = text;
            box.appendChild(d);
        }
        return box;
    }

    function faIcon(name) {
        var i = document.createElement('i');
        i.className = 'fas ' + name;
        i.setAttribute('aria-hidden', 'true');
        return i;
    }

    // Count beside the section title, and a name filter once a list is longer than 15.
    function listChrome(containerId, n) {
        var chip = document.querySelector('[data-em-count="' + containerId + '"]');
        if (chip) { chip.textContent = n; chip.hidden = !n; }
        var actions = document.querySelector('[data-em-actions="' + containerId + '"]');
        if (!actions) return;
        var box = actions.querySelector('.cf-search');
        if (n <= 15) { if (box) box.remove(); return; }
        if (box) return;
        box = document.createElement('label');
        box.className = 'cf-search';
        var icon = document.createElement('i');
        icon.className = 'fas fa-magnifying-glass';
        icon.setAttribute('aria-hidden', 'true');
        var input = document.createElement('input');
        input.type = 'search';
        input.className = 'form-control form-control-sm';
        input.placeholder = 'Search by name';
        input.autocomplete = 'off';
        input.setAttribute('aria-label', 'Search ' + (containerId === 'emStickerGrid' ? 'stickers' : 'emoji') + ' by name');
        input.addEventListener('input', function () { filterList(containerId, input.value); });
        box.appendChild(icon);
        box.appendChild(input);
        actions.insertBefore(box, actions.firstChild);
    }
    function filterList(containerId, q) {
        q = String(q || '').trim().toLowerCase();
        var container = document.getElementById(containerId);
        var shown = 0;
        container.querySelectorAll('.em-item').forEach(function (item) {
            var hit = !q || (item.dataset.name || '').indexOf(q) !== -1;
            item.hidden = !hit;
            if (hit) shown++;
        });
        var note = container.querySelector('.em-nomatch');
        if (!note) { note = document.createElement('p'); note.className = 'em-nomatch'; container.appendChild(note); }
        note.textContent = shown ? '' : 'Nothing matches that name.';
        note.hidden = !!shown;
    }
    function reapplyFilter(containerId) {
        var fb = document.querySelector('[data-em-actions="' + containerId + '"] .cf-search input');
        if (fb && fb.value) filterList(containerId, fb.value);
    }

    function renderEmojis(containerId, emojis) {
        listChrome(containerId, emojis.length);
        var container = document.getElementById(containerId);
        if (!emojis.length) {
            container.textContent = '';
            container.appendChild(stateEl('empty', 'No emoji yet', 'Upload one, or draw or animate one below.'));
            return;
        }
        var grid = document.createElement('div');
        grid.className = 'em-grid';
        emojis.forEach(function(e) {
            var item = document.createElement('div');
            item.className = 'em-item';
            item.title = e.name;
            item.dataset.name = String(e.name || '').toLowerCase();

            if (e.managed) {
                var badge = document.createElement('div');
                badge.className = 'em-managed-badge';
                badge.textContent = 'App';
                badge.title = 'Managed by an integration';
                item.appendChild(badge);
            }

            if (!e.managed) {
                var actions = document.createElement('div');
                actions.className = 'em-item-actions';
                var editBtn = document.createElement('button');
                editBtn.className = 'em-btn-edit';
                editBtn.title = 'Rename';
                editBtn.type = 'button';
                editBtn.setAttribute('aria-label', 'Rename :' + e.name + ':');
                editBtn.appendChild(faIcon('fa-pen'));
                editBtn.addEventListener('click', function(ev) { ev.stopPropagation(); openEditModal('emoji', e.id, e.name); });
                var delBtn = document.createElement('button');
                delBtn.className = 'em-btn-delete';
                delBtn.title = 'Delete';
                delBtn.type = 'button';
                delBtn.setAttribute('aria-label', 'Delete :' + e.name + ':');
                delBtn.appendChild(faIcon('fa-trash'));
                delBtn.addEventListener('click', function(ev) { ev.stopPropagation(); openConfirm('emoji', e.id, e.name); });
                actions.appendChild(editBtn);
                actions.appendChild(delBtn);
                item.appendChild(actions);
            }

            var img = document.createElement('img');
            img.src = e.url;
            img.alt = e.name;
            img.loading = 'lazy';
            item.appendChild(img);

            var nameEl = document.createElement('div');
            nameEl.className = 'em-item-name';
            nameEl.textContent = ':' + e.name + ':';
            item.appendChild(nameEl);

            grid.appendChild(item);
        });
        container.textContent = '';
        container.appendChild(grid);
        reapplyFilter(containerId);
    }

    function renderStickers(stickers) {
        listChrome('emStickerGrid', stickers.length);
        var container = document.getElementById('emStickerGrid');
        if (!stickers.length) {
            container.textContent = '';
            container.appendChild(stateEl('empty', 'No stickers yet', 'Upload a PNG or APNG sticker to add one.'));
            return;
        }
        var grid = document.createElement('div');
        grid.className = 'em-grid sticker-grid';
        stickers.forEach(function(s) {
            var item = document.createElement('div');
            item.className = 'em-item sticker-item';
            item.title = s.name;
            item.dataset.name = String(s.name || '').toLowerCase();

            var actions = document.createElement('div');
            actions.className = 'em-item-actions';
            var editBtn = document.createElement('button');
            editBtn.className = 'em-btn-edit';
            editBtn.title = 'Edit';
            editBtn.type = 'button';
            editBtn.setAttribute('aria-label', 'Edit ' + s.name);
            editBtn.appendChild(faIcon('fa-pen'));
            editBtn.addEventListener('click', function(ev) { ev.stopPropagation(); openEditModal('sticker', s.id, s.name, s.tags, s.description); });
            var delBtn = document.createElement('button');
            delBtn.className = 'em-btn-delete';
            delBtn.title = 'Delete';
            delBtn.type = 'button';
            delBtn.setAttribute('aria-label', 'Delete ' + s.name);
            delBtn.appendChild(faIcon('fa-trash'));
            delBtn.addEventListener('click', function(ev) { ev.stopPropagation(); openConfirm('sticker', s.id, s.name); });
            actions.appendChild(editBtn);
            actions.appendChild(delBtn);
            item.appendChild(actions);

            var img = document.createElement('img');
            img.src = s.url;
            img.alt = s.name;
            img.loading = 'lazy';
            item.appendChild(img);

            var nameEl = document.createElement('div');
            nameEl.className = 'em-item-name';
            nameEl.textContent = s.name;
            item.appendChild(nameEl);

            if (s.tags) {
                var tagsEl = document.createElement('div');
                tagsEl.className = 'em-item-tags';
                tagsEl.textContent = s.tags;
                item.appendChild(tagsEl);
            }

            grid.appendChild(item);
        });
        container.textContent = '';
        container.appendChild(grid);
        reapplyFilter('emStickerGrid');
    }

    // Upload modal
    window.openUploadModal = function(type) {
        uploadType = type;
        selectedFile = null;
        document.getElementById('emUploadTitle').textContent = type === 'sticker' ? 'Upload sticker' : 'Upload emoji';
        document.getElementById('emFileInput').accept = type === 'sticker' ? 'image/png,image/apng,image/gif' : 'image/png,image/jpeg,image/gif,image/webp';
        document.getElementById('emDropzoneHint').textContent = type === 'sticker'
            ? 'PNG, APNG or GIF \u00b7 Max 512KB \u00b7 320\u00d7320 recommended'
            : 'PNG, JPEG, GIF, WebP \u00b7 Max 256KB';
        document.getElementById('emNameHint').textContent = type === 'sticker'
            ? '2-30 characters'
            : '2-32 characters, letters, numbers, underscores only';
        document.getElementById('emNameInput').maxLength = type === 'sticker' ? 30 : 32;
        document.getElementById('emTagsField').hidden = type !== 'sticker';
        document.getElementById('emDescField').hidden = type !== 'sticker';
        document.getElementById('emPreviewArea').style.display = 'none';
        document.getElementById('emPreviewArea').className = type === 'sticker' ? 'em-preview-area sticker-preview' : 'em-preview-area';
        document.getElementById('emNameInput').value = '';
        document.getElementById('emTagsInput').value = '';
        document.getElementById('emDescInput').value = '';
        document.getElementById('emFileInput').value = '';
        document.getElementById('emUploadSubmit').disabled = true;
        document.getElementById('emUploadModal').hidden = false;
    };

    window.closeUploadModal = function() {
        document.getElementById('emUploadModal').hidden = true;
    };

    // File handling
    var dropzone = document.getElementById('emDropzone');
    var fileInput = document.getElementById('emFileInput');

    dropzone.addEventListener('dragover', function(e) { e.preventDefault(); dropzone.classList.add('is-dragover'); });
    dropzone.addEventListener('dragleave', function() { dropzone.classList.remove('is-dragover'); });
    dropzone.addEventListener('drop', function(e) {
        e.preventDefault();
        dropzone.classList.remove('is-dragover');
        if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', function() {
        if (fileInput.files.length) handleFile(fileInput.files[0]);
    });

    function handleFile(file) {
        var maxSize = uploadType === 'sticker' ? 512 * 1024 : 256 * 1024;
        if (file.size > maxSize) {
            showToast('File too large (' + Math.round(file.size / 1024) + 'KB). Max: ' + (maxSize / 1024) + 'KB', 'error');
            return;
        }
        selectedFile = file;

        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('emPreviewImg').src = e.target.result;
            document.getElementById('emPreviewArea').style.display = 'block';
        };
        reader.readAsDataURL(file);

        var nameInput = document.getElementById('emNameInput');
        if (!nameInput.value) {
            var name = file.name.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9_]/g, '_').substring(0, 32);
            if (name.length < 2) name = 'emoji_' + name;
            nameInput.value = name;
        }
        validateUploadForm();
    }

    document.getElementById('emNameInput').addEventListener('input', validateUploadForm);
    document.getElementById('emTagsInput').addEventListener('input', validateUploadForm);

    function validateUploadForm() {
        var name = document.getElementById('emNameInput').value.trim();
        var hasFile = !!selectedFile;
        var valid = hasFile && name.length >= 2;

        if (uploadType === 'emoji') {
            valid = valid && /^[a-zA-Z0-9_]{2,32}$/.test(name);
        } else {
            valid = valid && name.length <= 30 && document.getElementById('emTagsInput').value.trim().length > 0;
        }
        document.getElementById('emUploadSubmit').disabled = !valid;
    }

    window.submitUpload = async function() {
        if (!selectedFile) return;

        var btn = document.getElementById('emUploadSubmit');
        btn.disabled = true;
        btn.textContent = 'Uploading...';

        var formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('name', document.getElementById('emNameInput').value.trim());

        if (uploadType === 'sticker') {
            formData.append('tags', document.getElementById('emTagsInput').value.trim());
            formData.append('description', document.getElementById('emDescInput').value.trim());
        }

        var endpoint = uploadType === 'sticker' ? API_BASE + '/stickers' : API_BASE + '/emojis';

        try {
            var resp = await fetch(endpoint, { method: 'POST', credentials: 'include', body: formData });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Upload failed');

            showToast((uploadType === 'sticker' ? 'Sticker' : 'Emoji') + ' uploaded', 'success');
            closeUploadModal();
            loadData();
        } catch (err) {
            showToast(err.message, 'error');
            btn.disabled = false;
        }
        btn.textContent = 'Upload';
    };

    // Edit modal
    window.openEditModal = function(type, id, name, tags, description) {
        editType = type;
        editId = id;
        document.getElementById('emEditTitle').textContent = type === 'sticker' ? 'Edit sticker' : 'Rename emoji';
        document.getElementById('emEditName').value = name;
        document.getElementById('emEditTagsField').hidden = type !== 'sticker';
        document.getElementById('emEditDescField').hidden = type !== 'sticker';
        if (type === 'sticker') {
            document.getElementById('emEditTags').value = tags || '';
            document.getElementById('emEditDesc').value = description || '';
        }
        document.getElementById('emEditModal').hidden = false;
    };

    window.closeEditModal = function() {
        document.getElementById('emEditModal').hidden = true;
    };

    window.submitEdit = async function() {
        var btn = document.getElementById('emEditSubmit');
        btn.disabled = true;

        var body = { name: document.getElementById('emEditName').value.trim() };
        if (editType === 'sticker') {
            body.tags = document.getElementById('emEditTags').value.trim();
            body.description = document.getElementById('emEditDesc').value.trim();
        }

        var endpoint = editType === 'sticker'
            ? API_BASE + '/stickers/' + editId
            : API_BASE + '/emojis/' + editId;

        try {
            var resp = await fetch(endpoint, {
                method: 'PATCH',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Edit failed');

            showToast('Saved', 'success');
            closeEditModal();
            loadData();
        } catch (err) {
            showToast(err.message, 'error');
        }
        btn.disabled = false;
    };

    // Delete confirmation
    window.openConfirm = function(type, id, name) {
        deleteType = type;
        deleteId = id;
        document.getElementById('emDeleteName').textContent = name;
        document.getElementById('emConfirmDelete').hidden = false;
    };

    window.closeConfirm = function() {
        document.getElementById('emConfirmDelete').hidden = true;
    };

    window.confirmDelete = async function() {
        var btn = document.getElementById('emConfirmBtn');
        btn.disabled = true;
        btn.textContent = 'Deleting...';

        var endpoint = deleteType === 'sticker'
            ? API_BASE + '/stickers/' + deleteId
            : API_BASE + '/emojis/' + deleteId;

        try {
            var resp = await fetch(endpoint, { method: 'DELETE', credentials: 'include' });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Delete failed');

            showToast('Deleted', 'success');
            closeConfirm();
            loadData();
        } catch (err) {
            showToast(err.message, 'error');
        }
        btn.disabled = false;
        btn.textContent = 'Delete';
    };

    var generated = null;   // the PNG most recently drawn, not yet added

    window.generateEmote = async function() {
        var subject = document.getElementById('emGenSubject').value.trim();
        if (!subject) { showToast('Say what the emoji should show', 'error'); return; }

        var btn = document.getElementById('emGenBtn');
        var status = document.getElementById('emGenStatus');
        btn.disabled = true;
        status.textContent = 'Drawing… this takes about ten seconds.';

        try {
            var form = new FormData();
            form.append('subject', subject);
            var ref = document.getElementById('emGenRef').files[0];
            if (ref) form.append('reference', ref);

            var resp = await fetch(API_BASE + '/generate', {
                method: 'POST', credentials: 'include', body: form
            });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Generation failed');

            generated = data.png;
            document.getElementById('emGenBig').src = data.png;
            document.getElementById('emGenSmall').src = data.png;
            document.getElementById('emGenDownload').href = data.png;
            document.getElementById('emGenMeta').textContent =
                Math.round(data.bytes / 1024) + ' KB' +
                (data.cut ? ' · background removed' : ' · background left as it was');
            var nameBox = document.getElementById('emGenName');
            if (!nameBox.value.trim()) nameBox.value = data.suggestedName || '';
            document.getElementById('emGenResult').hidden = false;
            status.textContent = '';
        } catch (err) {
            status.textContent = '';
            showToast(err.message, 'error');
        }
        btn.disabled = false;
    };

    window.addGeneratedEmote = async function() {
        if (!generated) { showToast('Draw one first', 'error'); return; }
        var name = document.getElementById('emGenName').value.trim();
        if (!/^[a-zA-Z0-9_]{2,32}$/.test(name)) {
            showToast('Name must be 2-32 characters: letters, numbers and underscores', 'error');
            return;
        }

        var btn = document.getElementById('emGenAdd');
        btn.disabled = true;
        btn.textContent = 'Adding…';
        try {
            var resp = await fetch(API_BASE + '/emojis/generated', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name, png: generated })
            });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Could not add it');

            showToast(':' + data.emoji.name + ': added', 'success');
            document.getElementById('emGenResult').hidden = true;
            document.getElementById('emGenName').value = '';
            generated = null;
            loadData();
        } catch (err) {
            showToast(err.message, 'error');
        }
        btn.disabled = false;
        btn.textContent = 'Add to the server';
    };

    var sheetPieces = [];

    window.splitSheet = async function() {
        var file = document.getElementById('emSheetFile').files[0];
        if (!file) { showToast('Pick a sheet image first', 'error'); return; }
        var btn = document.getElementById('emSheetBtn');
        var status = document.getElementById('emSheetStatus');
        btn.disabled = true;
        status.textContent = 'Cutting…';
        try {
            var form = new FormData();
            form.append('sheet', file);
            var resp = await fetch(API_BASE + '/split-sheet', {
                method: 'POST', credentials: 'include', body: form
            });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Could not split that');

            sheetPieces = data.emotes;
            var grid = document.getElementById('emSheetGrid');
            grid.textContent = '';
            data.emotes.forEach(function(piece, i) {
                var cell = document.createElement('div');
                cell.className = 'em-sheet-cell';
                var img = document.createElement('img');
                img.src = piece.png; img.width = 96; img.height = 96; img.alt = 'Piece ' + (i + 1);
                var input = document.createElement('input');
                input.type = 'text'; input.maxLength = 32; input.placeholder = 'name it';
                input.id = 'emSheetName' + i;
                input.className = 'form-control form-control-sm';
                input.setAttribute('aria-label', 'Name for piece ' + (i + 1));
                cell.appendChild(img); cell.appendChild(input);
                grid.appendChild(cell);
            });
            document.getElementById('emSheetResult').hidden = false;
            status.textContent = data.emotes.length + ' found. Name the ones you want.';
        } catch (err) {
            status.textContent = '';
            showToast(err.message, 'error');
        }
        btn.disabled = false;
    };

    window.addSheetEmotes = async function() {
        var btn = document.getElementById('emSheetAdd');
        var wanted = [];
        sheetPieces.forEach(function(piece, i) {
            var name = (document.getElementById('emSheetName' + i) || {}).value;
            name = (name || '').trim();
            if (name) wanted.push({ name: name, png: piece.png, index: i });
        });
        if (!wanted.length) { showToast('Name at least one of them first', 'error'); return; }
        var bad = wanted.filter(function(w) { return !/^[a-zA-Z0-9_]{2,32}$/.test(w.name); });
        if (bad.length) { showToast('"' + bad[0].name + '" is not a usable name', 'error'); return; }

        btn.disabled = true;
        var added = 0, failed = [];
        for (var i = 0; i < wanted.length; i++) {
            btn.textContent = 'Adding ' + (i + 1) + ' of ' + wanted.length + '…';
            try {
                var resp = await fetch(API_BASE + '/emojis/generated', {
                    method: 'POST', credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: wanted[i].name, png: wanted[i].png })
                });
                var data = await resp.json();
                if (!resp.ok) throw new Error(data.error || 'failed');
                added++;
                var box = document.getElementById('emSheetName' + wanted[i].index);
                if (box) { box.value = ''; box.placeholder = 'added'; box.disabled = true; }
            } catch (err) {
                failed.push(wanted[i].name + ' (' + err.message + ')');
            }
            // Discord's emoji route rate-limits hard; pace the batch.
            await new Promise(function(r) { setTimeout(r, 1500); });
        }
        btn.disabled = false;
        btn.textContent = 'Add the named ones';
        showToast(added + ' added' + (failed.length ? ', ' + failed.length + ' failed: ' + failed[0] : ''),
            failed.length ? 'error' : 'success');
        loadData();
    };

    var animated = null;   // the GIF most recently made, not yet added

    async function loadEffects() {
        try {
            var resp = await fetch(API_BASE + '/effects', { credentials: 'include' });
            var data = await resp.json();
            var sel = document.getElementById('emAnimEffect');
            if (!sel) return;
            sel.textContent = '';
            (data.effects || []).forEach(function(e) {
                var opt = document.createElement('option');
                opt.value = e.id; opt.textContent = e.label;
                sel.appendChild(opt);
            });
            if (!data.available) {
                document.getElementById('emAnimBtn').disabled = true;
                document.getElementById('emAnimStatus').textContent =
                    'Animation is unavailable on this server.';
            }
        } catch (err) { /* the panel just stays empty */ }
    }
    loadEffects();

    /* Kept in step with the emoji list, so a newly added emoji can be animated
       without reloading the page. Only stills are offered: animating something
       that already moves would just re-encode its first frame. */
    function fillAnimSources(statics) {
        var sel = document.getElementById('emAnimSource');
        if (!sel) return;
        var keep = sel.value;
        sel.textContent = '';
        statics.forEach(function(e) {
            var opt = document.createElement('option');
            opt.value = e.id; opt.textContent = ':' + e.name + ':';
            sel.appendChild(opt);
        });
        if (keep) sel.value = keep;
    }

    window.animateEmoji = async function() {
        var btn = document.getElementById('emAnimBtn');
        var status = document.getElementById('emAnimStatus');
        var effect = document.getElementById('emAnimEffect').value;
        var file = document.getElementById('emAnimFile').files[0];
        var emojiId = document.getElementById('emAnimSource').value;
        if (!file && !emojiId) { showToast('Pick an emoji or upload an image', 'error'); return; }

        btn.disabled = true;
        status.textContent = 'Animating…';
        try {
            var form = new FormData();
            form.append('effect', effect);
            if (file) form.append('image', file); else form.append('emojiId', emojiId);

            var resp = await fetch(API_BASE + '/animate', {
                method: 'POST', credentials: 'include', body: form
            });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Animation failed');

            animated = data.gif;
            ['emAnimBig', 'emAnimSmall', 'emAnimLight'].forEach(function(id) {
                document.getElementById(id).src = data.gif;
            });
            document.getElementById('emAnimDownload').href = data.gif;
            document.getElementById('emAnimMeta').textContent =
                Math.round(data.bytes / 1024) + ' KB' + (data.reduced ? ' · trimmed down to fit' : '');
            var nameBox = document.getElementById('emAnimName');
            if (data.suggestedName) nameBox.value = data.suggestedName;
            document.getElementById('emAnimResult').hidden = false;
            status.textContent = '';
        } catch (err) {
            status.textContent = '';
            showToast(err.message, 'error');
        }
        btn.disabled = false;
    };

    window.addAnimatedEmoji = async function() {
        if (!animated) { showToast('Make one first', 'error'); return; }
        var name = document.getElementById('emAnimName').value.trim();
        if (!/^[a-zA-Z0-9_]{2,32}$/.test(name)) {
            showToast('Name must be 2-32 characters: letters, numbers and underscores', 'error');
            return;
        }
        var btn = document.getElementById('emAnimAdd');
        btn.disabled = true;
        btn.textContent = 'Adding…';
        try {
            var resp = await fetch(API_BASE + '/emojis/generated', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name, gif: animated })
            });
            var data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Could not add it');
            showToast(':' + data.emoji.name + ': added', 'success');
            document.getElementById('emAnimResult').hidden = true;
            animated = null;
            loadData();
        } catch (err) {
            showToast(err.message, 'error');
        }
        btn.disabled = false;
        btn.textContent = 'Add to the server';
    };

    var dialogs = { emUploadModal: function () { closeUploadModal(); }, emEditModal: function () { closeEditModal(); }, emConfirmDelete: function () { closeConfirm(); } };
    Object.keys(dialogs).forEach(function (id) {
        var m = document.getElementById(id);
        m.addEventListener('click', function (e) { if (e.target === m) dialogs[id](); });
    });
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        Object.keys(dialogs).forEach(function (id) { if (!document.getElementById(id).hidden) dialogs[id](); });
    });

    function showToast(msg, type) {
        var existing = document.querySelector('.em-toast');
        if (existing) existing.remove();
        var toast = document.createElement('div');
        toast.className = 'em-toast ' + type;
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.remove(); }, 4000);
    }
})();
</script>
