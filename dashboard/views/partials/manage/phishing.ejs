<%#
  Phishing detection: known phishing and scam links, the action taken, alerts, evidence protection
  and allowed domains. Saved as JSON (PUT /api/guilds/:id/phishing) by the script below. Built on
  the settings-row kit (cf-settings.css, partials/kit/); ids and field names are unchanged.
%>
<%
const pc = locals.phishingConfig || null;
const textChannels = locals.channels ? channels.filter(c => c.type === 0) : [];
%>
<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-fish"></i>
                <span>Phishing detection</span>
            </div>
            <div class="page-section-subtitle">What happens to the sender, who is told, and where shared evidence is allowed.</div>
        </div>
    </div>

    <form id="phishing-config-form">
        <section class="cf-section" aria-labelledby="phish-detect-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="phish-detect-title">Detection</h2>
                    <p class="cf-section-desc">What happens when someone posts a link on the phishing lists. Members on the <a href="/manage/<%= guild.id %>?page=protection-settings">Protection settings</a> allowlist are skipped, and the pause there stops every action.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="phishing_enabled">Phishing detection</label>
                        <p class="cf-row-desc" id="phishing_enabled-desc">Check every message for known phishing and scam links.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="phishing_enabled" data-feature-switch aria-describedby="phishing_enabled-desc" <%= (pc && pc.enabled) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-phishing-action">Action on detection</label>
                        <p class="cf-row-desc" id="f-phishing-action-desc">What the bot does when it finds a phishing link.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-phishing-action" name="action" class="form-select" aria-describedby="f-phishing-action-desc">
                            <option value="delete" <%= (pc && pc.action === 'delete') ? 'selected' : (!pc ? 'selected' : '') %>>Delete the message</option>
                            <option value="warn" <%= (pc && pc.action === 'warn') ? 'selected' : '' %>>Warn the member</option>
                            <option value="mute" <%= (pc && pc.action === 'mute') ? 'selected' : '' %>>Mute the member</option>
                            <option value="kick" <%= (pc && pc.action === 'kick') ? 'selected' : '' %>>Kick the member</option>
                            <option value="ban" <%= (pc && pc.action === 'ban') ? 'selected' : '' %>>Ban the member</option>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--sub" id="mute-duration-group"<%= (pc && pc.action === 'mute') ? '' : ' hidden' %>>
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-phishing-mute_duration_minutes">Mute length</label>
                        <p class="cf-row-desc" id="f-phishing-mute_duration_minutes-desc">Up to 7 days (10080 minutes).</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input id="f-phishing-mute_duration_minutes" type="number" name="mute_duration_minutes" class="form-control" min="1" max="10080" value="<%= (pc && pc.mute_duration_minutes) || 30 %>" aria-describedby="f-phishing-mute_duration_minutes-desc">
                            <span class="cf-unit">minutes</span>
                        </div>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-phishing-alert_channel_id">Alert channel</label>
                        <p class="cf-row-desc" id="f-phishing-alert_channel_id-desc">Moderators are told about each detection here.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-phishing-alert_channel_id" name="alert_channel_id" class="form-select" aria-describedby="f-phishing-alert_channel_id-desc">
                            <option value="">No alerts</option>
                            <% textChannels.forEach(c => { %>
                                <option value="<%= c.id %>" data-kind="text" <%= (pc && pc.alert_channel_id === c.id) ? 'selected' : '' %>>#<%= c.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="log_detections">Keep a detection log</label>
                        <p class="cf-row-desc" id="log_detections-desc">Record each detection in the bot's database.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="log_detections" aria-describedby="log_detections-desc" <%= (!pc || pc.log_detections !== 0) ? 'checked' : '' %>>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="phish-evidence-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="phish-evidence-title">Evidence protection</h2>
                    <p class="cf-section-desc">Stops the bot punishing members who share phishing screenshots or links as evidence.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-phishing-report_channel_id">Report and evidence channel</label>
                        <p class="cf-row-desc" id="f-phishing-report_channel_id-desc">Suspected evidence posts are removed from the channel they were posted in and forwarded here.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-phishing-report_channel_id" name="report_channel_id" class="form-select" aria-describedby="f-phishing-report_channel_id-desc">
                            <option value="">None</option>
                            <% textChannels.forEach(c => { %>
                                <option value="<%= c.id %>" data-kind="text" <%= (pc && pc.report_channel_id === c.id) ? 'selected' : '' %>>#<%= c.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-phishing-exempt_channels">Exempt channels</label>
                        <p class="cf-row-desc" id="f-phishing-exempt_channels-desc">Detection is off in these channels. Channels named like evidence, report or red-flag are skipped automatically.</p>
                    </div>
                    <div class="cf-row-control">
                        <%
                            let exemptList = [];
                            if (pc && pc.exempt_channels) {
                                try { exemptList = JSON.parse(pc.exempt_channels); } catch(e) {}
                            }
                        %>
                        <select id="f-phishing-exempt_channels" name="exempt_channels" class="form-select" multiple size="5" aria-describedby="f-phishing-exempt_channels-desc">
                            <% textChannels.forEach(c => { %>
                                <option value="<%= c.id %>" data-kind="text" <%= exemptList.includes(c.id) ? 'selected' : '' %>>#<%= c.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="phish-allow-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="phish-allow-title">Allowed domains</h2>
                    <p class="cf-section-desc">Domains that are never flagged as phishing in this server.</p>
                </div>
            </header>
            <div class="cf-rows">
                <%
                    let whitelistStr = '';
                    if (pc && pc.whitelist_domains) {
                        try { whitelistStr = JSON.parse(pc.whitelist_domains).join(', '); } catch(e) {}
                    }
                %>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-phish-whitelist">Never flag these domains</label>
                        <p class="cf-row-desc" id="cfk-phish-whitelist-desc">Separate domains with commas, for example discord.com, steamcommunity.com.</p>
                    </div>
                    <input type="text" id="cfk-phish-whitelist" name="whitelist_domains" class="form-control" value="<%= whitelistStr %>" placeholder="discord.com, steamcommunity.com" aria-describedby="cfk-phish-whitelist-desc">
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>
</div>

<script>
(function() {
    const form = document.getElementById('phishing-config-form');
    const actionSelect = form.querySelector('[name="action"]');
    const muteGroup = document.getElementById('mute-duration-group');

    actionSelect.addEventListener('change', () => {
        muteGroup.hidden = actionSelect.value !== 'mute';
    });

    const enabledBox = document.getElementById('phishing_enabled');

    async function save() {
        const exemptSelect = form.querySelector('[name="exempt_channels"]');
        const whitelistRaw = form.querySelector('[name="whitelist_domains"]').value;
        const data = {
            enabled: enabledBox.checked,
            action: actionSelect.value,
            mute_duration_minutes: parseInt(form.querySelector('[name="mute_duration_minutes"]').value) || 30,
            alert_channel_id: form.querySelector('[name="alert_channel_id"]').value || null,
            whitelist_domains: JSON.stringify(whitelistRaw.split(',').map(d => d.trim()).filter(Boolean)),
            log_detections: document.getElementById('log_detections').checked,
            exempt_channels: JSON.stringify(Array.from(exemptSelect.selectedOptions).map(o => o.value)),
            report_channel_id: form.querySelector('[name="report_channel_id"]').value || null
        };
        try {
            const res = await fetch(`/api/guilds/<%= guild.id %>/phishing`, {
                method: 'PUT',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json().catch(() => ({}));
            if (res.ok && result.success) {
                showToast('Phishing settings saved', 'success');
                return true;
            }
            showToast(result.error || 'Could not save', 'error');
        } catch (err) {
            showToast('Could not save the phishing settings', 'error');
        }
        return false;
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        await save();
    });

    // The master switch sits in the page header (data-feature-switch) and saves straight away.
    let reverting = false;
    enabledBox.addEventListener('change', async () => {
        if (reverting) return;
        if (await save()) return;
        reverting = true;
        enabledBox.checked = !enabledBox.checked;
        enabledBox.dispatchEvent(new Event('change'));
        reverting = false;
    });
})();
</script>
