<%#
  Server utilities: auto publisher (POST update-autopublisher), autoroles (POST update-autoroles) and
  temporary voice channels (POST update-tempchannels; its switch turns them off, core/temp-channel-config.js), one
  form each. Built on the settings-row kit
  (cf-settings.css); field names and ids are unchanged.
%>
<%
const apOn = !!(autoPublisherConfig && autoPublisherConfig.is_enabled);
const arOn = !!(autorolesConfig && autorolesConfig.is_enabled);
// roles_to_assign is an array, or a JSON string of one from older rows; the original matched either.
const arRaw = (autorolesConfig && autorolesConfig.roles_to_assign) || [];
const arRoles = Array.isArray(arRaw) ? arRaw : roles.filter(r => String(arRaw).includes(r.id)).map(r => r.id);
const arRole = arOn && arRoles.length ? roles.find(r => r.id === arRoles[0]) : null;
// The rest of autoroles_config (migration 419): JSON role lists and the wait. core/autoroles.js reads them.
const arList = (v) => { if (Array.isArray(v)) return v.map(String); try { const p = JSON.parse(v || '[]'); return Array.isArray(p) ? p.map(String) : []; } catch (e) { return []; } };
const arBot = arList(autorolesConfig && autorolesConfig.bot_roles);
const arReq = arList(autorolesConfig && autorolesConfig.require_roles);
const arIgn = arList(autorolesConfig && autorolesConfig.ignore_roles);
const arDelay = Math.max(0, Number(autorolesConfig && autorolesConfig.delay_minutes) || 0);
const arNames = arOn ? arRoles.map(id => (roles.find(r => r.id === id) || {}).name).filter(Boolean) : [];
// The older single-role setting on the welcome row still applies while no roles are chosen here.
const arLegacy = (typeof welcomeSettings !== 'undefined' && welcomeSettings && welcomeSettings.auto_role_id)
    ? roles.find(r => r.id === String(welcomeSettings.auto_role_id)) : null;
const arMembers = Number(guild && guild.memberCount) || 0;
const tc = tempChannels || null;
const tcOn = !!(tc && tc.creator_channel_id);
%>
<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-cog"></i>
                <span>Server utilities</span>
            </div>
            <div class="page-section-subtitle">Auto publishing, roles for new members and temporary voice channels.</div>
        </div>
    </div>

        <section class="cf-section" aria-labelledby="ut-pub-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ut-pub-title">Auto publisher</h2>
                    <p class="cf-section-desc">Publishes messages posted in announcement channels, so servers that follow them get them too.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form action="/manage/<%= guild.id %>/update-autopublisher" method="POST">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoPublisherEnabled">Publish announcements automatically</label>
                        <p class="cf-row-desc" id="autoPublisherEnabled-desc"><%= apOn ? 'On: new posts in announcement channels are published.' : 'Every message in an announcement channel is cross-posted.' %></p>
                    </div>
                    <div class="cf-row-control">
                        <input class="cf-switch" type="checkbox" role="switch" id="autoPublisherEnabled" name="is_enabled" aria-describedby="autoPublisherEnabled-desc" <%= apOn ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                </form>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="ut-roles-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ut-roles-title">Autoroles</h2>
                    <p class="cf-section-desc">Roles given to members when they join. Members who still have to accept the server rules get them once they accept.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form action="/manage/<%= guild.id %>/update-autoroles" method="POST">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autorolesEnabled">Give roles on join</label>
                        <p class="cf-row-desc" id="autorolesEnabled-desc"><% if (arNames.length) { %>On: new members get <strong><%= arNames.join(', ') %></strong>.<% } else if (arLegacy) { %>No roles chosen here, so the older welcome setting still gives new members <strong><%= arLegacy.name %></strong>. Choosing roles below replaces it.<% } else { %>New members receive the roles chosen below.<% } %></p>
                    </div>
                    <div class="cf-row-control">
                        <input class="cf-switch" type="checkbox" role="switch" id="autorolesEnabled" name="is_enabled" aria-describedby="autorolesEnabled-desc" <%= arOn ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoroleRole">Roles for new members</label>
                        <p class="cf-row-desc" id="autoroleRole-desc">Up to 10. The bot can only give roles below its own highest role; the others are marked and cannot be picked.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="autoroleRole" name="roles_to_assign" multiple size="6" aria-describedby="autoroleRole-desc">
                            <%- include('../kit/_options', { items: roles, selected: arRoles, prefix: '', kind: 'role', assign: true }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoroleBotRoles">Roles for bots</label>
                        <p class="cf-row-desc" id="autoroleBotRoles-desc">Bots that are added get these instead of the roles above. Leave empty to give bots nothing.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="autoroleBotRoles" name="bot_roles" multiple size="4" aria-describedby="autoroleBotRoles-desc">
                            <%- include('../kit/_options', { items: roles, selected: arBot, prefix: '', kind: 'role', assign: true }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoroleDelay">Wait before giving them</label>
                        <p class="cf-row-desc" id="autoroleDelay-desc">Minutes after joining, up to 10080 (7 days). 0 gives them straight away. Bots are never kept waiting.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit"><input class="form-control" type="number" id="autoroleDelay" name="delay_minutes" min="0" max="10080" step="1" value="<%= arDelay %>" aria-describedby="autoroleDelay-desc"><span class="cf-unit">minutes</span></div>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoroleRequire">Only members with one of these roles</label>
                        <p class="cf-row-desc" id="autoroleRequire-desc">Optional. When set, a member needs at least one of these first, for example a Verified role. Someone who is given one later gets the roles above then.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="autoroleRequire" name="require_roles" multiple size="4" aria-describedby="autoroleRequire-desc">
                            <%- include('../kit/_options', { items: roles, selected: arReq, prefix: '', kind: 'role' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoroleIgnore">Skip members with any of these roles</label>
                        <p class="cf-row-desc" id="autoroleIgnore-desc">Optional. Members who already hold one of these are left alone.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="autoroleIgnore" name="ignore_roles" multiple size="4" aria-describedby="autoroleIgnore-desc">
                            <%- include('../kit/_options', { items: roles, selected: arIgn, prefix: '', kind: 'role' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                </form>

                <div class="cf-rows-head" id="ut-roles-existing-head">Members who are already here</div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label" id="arBackfill-label">Give the roles to existing members</span>
                        <p class="cf-row-desc" id="arBackfill-desc">Gives the saved roles to everyone already in the server who is missing them, following the same rules. It runs in the background at about one member a second<% if (arMembers > 120) { %> (up to about <%= Math.ceil(arMembers * 1.1 / 60) %> minutes for <%= arMembers.toLocaleString() %> members)<% } %>, and you can leave this page while it does. The server owner and anyone whose top role is level with or above the bot's are never changed.</p>
                        <p class="cf-row-desc" id="arBackfill-status" role="status" aria-live="polite"></p>
                    </div>
                    <div class="cf-row-control">
                        <button type="button" class="btn btn-secondary" id="arBackfillStart" aria-describedby="arBackfill-desc">Give to existing members</button>
                        <button type="button" class="btn btn-secondary" id="arBackfillStop" hidden>Stop</button>
                    </div>
                </div>
            </div>
        </section>

<script>
(function () {
    // "Give to existing members": POST starts (or resumes) the background run, GET reports progress.
    var base = '/api/guilds/<%= guild.id %>/autoroles/backfill';
    var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    var start = document.getElementById('arBackfillStart');
    var stop = document.getElementById('arBackfillStop');
    var out = document.getElementById('arBackfill-status');
    if (!start || !out) return;
    var timer = null;

    function when(ms) { return ms ? new Date(ms).toLocaleString() : ''; }
    function counts(st) {
        return 'Checked ' + st.scanned.toLocaleString() + ' of about ' + st.total.toLocaleString() + ' members. Given: '
            + st.given.toLocaleString() + ', skipped: ' + st.skipped.toLocaleString() + ', failed: ' + st.failed.toLocaleString() + '.';
    }
    function describe(st) {
        if (st.unavailable) return 'Not available until this feature\u2019s database update has been applied.';
        if (st.running) {
            var left = '';
            if (st.scanned >= 20 && st.startedAt) {
                var perMember = (Date.now() - st.startedAt) / st.scanned;
                var mins = Math.ceil(Math.max(0, st.total - st.scanned) * perMember / 60000);
                left = mins > 1 ? ' About ' + mins + ' minutes left.' : ' Nearly done.';
            }
            return 'Running. ' + counts(st) + left;
        }
        if (st.interrupted) return 'Stopped part way when the bot restarted. ' + counts(st) + ' Resume carries on from there.';
        if (st.status === 'done') return 'Finished ' + when(st.finishedAt) + '. ' + counts(st);
        if (st.status === 'cancelled' || st.status === 'failed') return 'Stopped ' + when(st.finishedAt) + (st.note ? ': ' + st.note : '.') + ' ' + counts(st);
        return '';
    }
    function apply(st) {
        if (!st || st.success === false) return;
        start.hidden = !!st.running;
        start.disabled = !!st.unavailable;
        start.textContent = st.interrupted ? 'Resume' : 'Give to existing members';
        stop.hidden = !(st.running || st.interrupted);
        out.textContent = describe(st);
        clearTimeout(timer);
        if (st.running) timer = setTimeout(poll, 3000);
    }
    function poll() {
        fetch(base, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(apply)
            .catch(function () { clearTimeout(timer); timer = setTimeout(poll, 10000); });
    }
    function post(url) {
        return fetch(url, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-CSRF-Token': csrf },
            body: '{}'
        }).then(function (r) { return r.json().catch(function () { return { success: false, error: 'Unexpected reply (' + r.status + ').' }; }); });
    }

    start.addEventListener('click', function () {
        var resume = start.textContent === 'Resume';
        if (!resume && !window.confirm('Give the saved autoroles to every member of this server who is missing them? Unsaved changes above are not used, so save first.')) return;
        start.disabled = true;
        post(base).then(function (res) {
            start.disabled = false;
            if (!res.success) { out.textContent = res.error || 'Could not start.'; return; }
            apply(res);
        }).catch(function () { start.disabled = false; out.textContent = 'Could not reach the dashboard. Try again.'; });
    });
    stop.addEventListener('click', function () {
        stop.disabled = true;
        post(base + '/cancel').then(function (res) {
            stop.disabled = false;
            apply(res);
            // A running job finishes the member it is on before it stops.
            clearTimeout(timer); timer = setTimeout(poll, 1500);
        }).catch(function () { stop.disabled = false; });
    });
    poll();
})();
</script>

        <section class="cf-section" aria-labelledby="ut-temp-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ut-temp-title">Temporary voice channels</h2>
                    <p class="cf-section-desc">A member who joins the creator channel gets a voice channel of their own and is moved into it. It is deleted once it is empty.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form action="/manage/<%= guild.id %>/update-tempchannels" method="POST">
                <input type="hidden" name="enabled_sent" value="1">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="tempChannelsEnabled">Temporary voice channels</label>
                        <p class="cf-row-desc" id="tempChannelsEnabled-desc"><%= tcOn ? 'On. Turn this off and save to stop making new channels; this removes every creator channel, the same as /admin temp-channel disable.' : 'Off. Turn this on, choose the creator channel and category, and save.' %></p>
                    </div>
                    <div class="cf-row-control">
                        <input class="cf-switch" type="checkbox" role="switch" id="tempChannelsEnabled" name="enabled" aria-describedby="tempChannelsEnabled-desc" <%= tcOn ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="tempChannelCreator">Creator channel</label>
                        <p class="cf-row-desc">The voice channel members join to get their own.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="tempChannelCreator" name="creator_channel_id">
                            <%- include('../kit/_options', { items: voiceChannels, selected: tc ? tc.creator_channel_id : null, prefix: '', empty: 'Choose a voice channel', kind: 'voice' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="tempChannelCategory">Category</label>
                        <p class="cf-row-desc">Where the new channels are created.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="tempChannelCategory" name="category_id">
                            <%- include('../kit/_options', { items: categories, selected: tc ? tc.category_id : null, prefix: '', empty: 'Choose a category', kind: 'category' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="tempChannelName">Channel name</label>
                        <p class="cf-row-desc" id="tempChannelName-desc"><code>{username}</code> is replaced with the member's name, and <code>{number}</code> with the next free number (1, 2, 3...).</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="text" class="form-control" id="tempChannelName" name="naming_template" value="<%= tc ? tc.naming_template : '{username}\'s Channel' %>" placeholder="{username}'s Channel" maxlength="100" aria-describedby="tempChannelName-desc">
                    </div>
                </div>
                <div class="cf-section-foot">
                    <% if (tcOn) { %><span class="cf-foot-note">On: joining the creator channel makes a new channel.</span><% } %>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                </form>
                <script>
                (function () {
                    // Choosing a creator channel means "on"; the switch follows so the save does not turn it off.
                    const sw = document.getElementById('tempChannelsEnabled');
                    const creator = document.getElementById('tempChannelCreator');
                    if (sw && creator) creator.addEventListener('change', function () { if (creator.value) sw.checked = true; });
                })();
                </script>
            </div>
        </section>
</div>
