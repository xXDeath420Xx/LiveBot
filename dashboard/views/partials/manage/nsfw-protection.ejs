<%# NSFW protection — NSFW avatars and chat images, two local models (core/nsfw-protection.js): model status, settings per surface, usage vs the daily cap, test box, member scan, review queue with overturn, safe pictures, recent detections. API-driven (dashboard/routes/api/features/nsfw-protection.js); needs `guild` in locals. Laid out with the settings-row kit (cf-settings.css), like name-filters.ejs and avatar-protection.ejs; every id the script below uses is unchanged. %>
<div class="page-section" id="nsfwProtectionPage" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-eye-slash"></i>
                <span>NSFW protection</span>
            </div>
            <div class="page-section-subtitle">Two models that run on the bot's own server, so scans cost nothing.</div>
        </div>
    </div>

    <div id="npError" class="cf-notice is-bad" role="alert" hidden></div>
    <div id="npNotice" class="cf-notice is-info" role="status" hidden></div>

    <div class="cf-kpis" id="npStats" aria-label="NSFW protection at a glance">
        <div class="cf-state cf-state--loading cf-state--compact" role="status" aria-live="polite"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading...</p></div>
    </div>

    <!-- Model -->
    <section class="cf-section" id="npModelCard" aria-labelledby="np-model-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-model-title">Models</h2>
                <p class="cf-section-desc">Nothing is acted on unless both models score a picture at or above the act threshold. Anything above the review threshold goes to the review queue.</p>
            </div>
            <div class="cf-section-actions"><span id="npModelBadge" class="cf-pill">Loading</span></div>
        </header>
        <div class="cf-rows">
            <div id="npModel" class="np-out"><div class="np-muted">Loading...</div></div>
        </div>
    </section>

    <!-- Avatars -->
    <section class="cf-section" aria-labelledby="np-av-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-av-title">Avatars</h2>
                <p class="cf-section-desc">Staff and allowlisted members are never acted on. The allowlist, and the pause that holds every protection, are on <a href="/manage/<%= guild.id %>?page=protection-settings">Protection settings</a>. Avatar entries keep only Discord's own link, shown blurred.</p>
            </div>
            <div class="cf-section-actions"><span id="npAvOn" class="cf-pill"></span></div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npAvEnabled">Check avatars</label>
                    <p class="cf-row-desc">On join and on every avatar or server-avatar change.</p>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="npAvEnabled"></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npAvAction">When both models agree</label>
                    <p class="cf-row-desc">Log only sends the member to the review queue. Flag gives the "Flagged Avatar" role from <a href="/manage/<%= guild.id %>?page=avatar-protection">Avatar protection</a>, taken off again when they change to a clean avatar.</p>
                </div>
                <div class="cf-row-control"><select id="npAvAction" class="form-select"></select></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npAvAct">Act threshold</label>
                    <p class="cf-row-desc">Both models must score the avatar at or above this.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range"><input type="range" id="npAvAct" min="0.80" max="0.99" step="0.01"><span class="cf-range-value" id="npAvActVal"></span></div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npAvReview">Review threshold</label>
                    <p class="cf-row-desc">At or above this, the avatar goes to the review queue.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range"><input type="range" id="npAvReview" min="0.30" max="0.99" step="0.01"><span class="cf-range-value" id="npAvReviewVal"></span></div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npAvCap">Daily avatar scan limit</label>
                    <p class="cf-row-desc">From 10 to 50000. Protects the server's CPU; resets at midnight UTC.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit"><input id="npAvCap" type="number" min="10" max="50000" class="form-control"><span class="cf-unit">scans</span></div>
                </div>
            </div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npAvDm">Tell kicked or banned members why by DM</label>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="npAvDm"></div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="npAvSave"><span>Save avatar settings</span></button>
            </div>
        </div>
    </section>

    <!-- Chat images -->
    <section class="cf-section" aria-labelledby="np-im-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-im-title">Chat images</h2>
                <p class="cf-section-desc">Up to 4 images per message. Age-restricted channels and channels on the <a href="/manage/<%= guild.id %>?page=message-threats">Message threats</a> ignore list are skipped. Only the scores are kept, never the image.</p>
            </div>
            <div class="cf-section-actions"><span id="npImOn" class="cf-pill"></span></div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImEnabled">Check images posted in chat</label>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="npImEnabled"></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImAction">Action for chat images</label>
                    <p class="cf-row-desc">Alert posts a card with a jump link to the Message threats card channel; the image is never re-posted. Delete removes the message; delete and timeout also times the member out.</p>
                </div>
                <div class="cf-row-control"><select id="npImAction" class="form-select"></select></div>
            </div>
            <div class="cf-row cf-row--sub">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImTimeout">Timeout length</label>
                    <p class="cf-row-desc">Used by delete and timeout.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit"><input id="npImTimeout" type="number" min="1" max="40320" class="form-control"><span class="cf-unit">minutes</span></div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImAct">Image act threshold</label>
                    <p class="cf-row-desc">Both models must score the image at or above this.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range"><input type="range" id="npImAct" min="0.80" max="0.99" step="0.01"><span class="cf-range-value" id="npImActVal"></span></div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImReview">Image review threshold</label>
                    <p class="cf-row-desc">At or above this, the image goes to the review queue.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range"><input type="range" id="npImReview" min="0.30" max="0.99" step="0.01"><span class="cf-range-value" id="npImReviewVal"></span></div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImCap">Daily image scan limit</label>
                    <p class="cf-row-desc">Once reached, images are not scanned until midnight UTC.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit"><input id="npImCap" type="number" min="10" max="50000" class="form-control"><span class="cf-unit">scans</span></div>
                </div>
            </div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npImAlerts">Alert cards for borderline images</label>
                    <p class="cf-row-desc">Also post an alert card for images in the review band.</p>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="npImAlerts"></div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="npImSave"><span>Save chat-image settings</span></button>
            </div>
        </div>
    </section>

    <!-- Test -->
    <section class="cf-section" aria-labelledby="np-test-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-test-title">Test a member or an image</h2>
                <p class="cf-section-desc">Scores are shown and nothing is stored or acted on. Use it to choose thresholds.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npTestFind">Member</label>
                    <p class="cf-row-desc">Their avatar and server avatar are both scored.</p>
                </div>
                <div class="cf-row-control">
                    <div class="np-inline">
                        <input id="npTestFind" class="form-control" maxlength="64" placeholder="Name, @mention or ID">
                        <button type="button" class="btn btn-secondary" id="npTestFindBtn"><span>Find</span></button>
                    </div>
                </div>
            </div>
            <div id="npTestFindResults" class="np-list"></div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="npTestFile">Image</label>
                    <p class="cf-row-desc">PNG, JPEG, WebP or GIF.</p>
                </div>
                <div class="cf-row-control">
                    <div class="np-inline">
                        <input type="file" id="npTestFile" class="form-control" accept="image/png,image/jpeg,image/webp,image/gif">
                        <button type="button" class="btn btn-secondary" id="npTestFileBtn"><span>Test image</span></button>
                    </div>
                </div>
            </div>
            <div id="npTestResult" class="np-out" role="status" aria-live="polite"></div>
        </div>
    </section>

    <!-- Scan -->
    <section class="cf-section" aria-labelledby="np-scan-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-scan-title">Scan everyone already here</h2>
                <p class="cf-section-desc">Checks every member's avatar in the background. It never acts: everything it finds goes to the review queue. It counts against the daily avatar limit and stops when the limit is reached; run it again tomorrow to carry on.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <p id="npScanState" class="np-scan-state" role="status" aria-live="polite">No scan run since the last restart.</p>
                <div class="np-progress" id="npProgressWrap" hidden><div class="np-progress-bar" id="npProgress"></div></div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="npScanBtn"><span>Start scan</span></button>
            </div>
        </div>
    </section>

    <!-- Review queue -->
    <section class="cf-section" aria-labelledby="np-review-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-review-title">NSFW review queue</h2>
                <p class="cf-section-desc">
                    Waiting: borderline finds and log-only matches. Not NSFW remembers the picture as safe. Acted on: what the bot did automatically;
                    Overturn unbans, lifts the timeout or takes the flag off, and remembers the picture as safe (a kick or a deleted message cannot
                    be undone). Avatars are blurred: click one to see it.
                </p>
            </div>
            <div class="cf-section-actions"><span id="npQueueCount" class="cf-pill"></span></div>
        </header>
        <div class="cf-rows">
            <div class="np-bar">
                <div class="cf-segmented np-tabs" id="npTabs" role="group" aria-label="Status"></div>
                <div class="cf-segmented np-tabs" id="npKinds" role="group" aria-label="Kind"></div>
            </div>
            <div class="np-bar" id="npBulk">
                <label class="cf-choice np-select-all" for="npSelectAll"><input type="checkbox" id="npSelectAll"> <span>Select all</span></label>
                <span class="np-muted" id="npSelCount">0 selected</span>
                <span class="np-actions">
                    <button type="button" class="btn btn-sm btn-danger" data-bulk="ban">Ban</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bulk="kick">Kick</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bulk="safe">Not NSFW</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bulk="skip">Skip</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bulk="overturn">Overturn</button>
                </span>
            </div>
            <div id="npReviews" class="np-reviews"></div>
        </div>
    </section>

    <!-- Usage -->
    <section class="cf-section" aria-labelledby="np-usage-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-usage-title">Scans per day</h2>
                <p class="cf-section-desc">The last 14 days, with hits and skipped scans.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="npUsage" class="np-out"></div>
        </div>
    </section>

    <!-- Recent -->
    <section class="cf-section" aria-labelledby="np-recent-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-recent-title">Recent detections</h2>
                <p class="cf-section-desc">What the checks found most recently, and what was done.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="npRecent" class="np-list"></div>
        </div>
    </section>

    <!-- Safe -->
    <section class="cf-section" aria-labelledby="np-safe-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="np-safe-title">Pictures remembered as safe</h2>
                <p class="cf-section-desc">Added when you mark an entry Not NSFW or overturn an action. Only a fingerprint is kept, never the picture. Forget one to have it checked again.</p>
            </div>
            <div class="cf-section-actions"><span id="npSafeCount" class="cf-pill"></span></div>
        </header>
        <div class="cf-rows">
            <div id="npSafe" class="np-list"></div>
        </div>
    </section>
</div>

<style>
  /* Pieces the script draws (tabs, lists, review rows, usage bars, test output), on the kit's tokens. */
  #nsfwProtectionPage .cf-kpis .cf-state { grid-column: 1 / -1; }
  /* A tab bar the script has not filled is hidden by :has(), which the kit's panel dividers cannot see. */
  #nsfwProtectionPage .cf-rows { overflow: clip; }
  #nsfwProtectionPage .cf-rows > .np-bar:first-child:has(> .np-tabs:empty) + * { border-top-color: transparent; }
  #nsfwProtectionPage .cf-kpis:empty { display: none; }
  #nsfwProtectionPage .cf-kpi-value.np-ok { color: var(--cf-success); }
  #nsfwProtectionPage .cf-kpi-value.np-hit { color: var(--cf-danger); }
  #nsfwProtectionPage .cf-pill:empty { display: none; }
  #nsfwProtectionPage .np-muted { color: var(--cf-text-3); font-size: var(--cf-text-sm); }
  #nsfwProtectionPage .np-hit { color: var(--cf-danger); }
  #nsfwProtectionPage .np-ok { color: var(--cf-success); }
  #nsfwProtectionPage .np-mid { color: var(--cf-warning); }
  #nsfwProtectionPage .np-warn { color: var(--cf-warning); font-size: var(--cf-text-sm); }
  #nsfwProtectionPage .np-inline { display: flex; flex-wrap: wrap; gap: var(--cf-2); align-items: center; }
  #nsfwProtectionPage .np-inline > input, #nsfwProtectionPage .np-inline > select { flex: 1 1 10rem; min-width: 0; width: auto; margin: 0; }

  /* Toolbars above a list: segmented tabs, bulk actions. */
  #nsfwProtectionPage .np-bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2) var(--cf-4); padding: var(--cf-3) var(--cf-5); }
  #nsfwProtectionPage .np-bar[hidden], #nsfwProtectionPage .np-bar:not(#npBulk):has(> .np-tabs:empty) { display: none; }
  #nsfwProtectionPage .np-actions { display: inline-flex; flex-wrap: wrap; gap: var(--cf-1); align-items: center; }
  #nsfwProtectionPage .np-bar .np-actions { margin-left: auto; }
  #nsfwProtectionPage .np-select-all { min-height: 0; }

  /* Lists of members and entries. */
  #nsfwProtectionPage .np-list { max-height: 26rem; overflow-y: auto; }
  #nsfwProtectionPage .np-list:empty, #nsfwProtectionPage .np-out:empty, #nsfwProtectionPage .np-reviews:empty { display: none; }
  #nsfwProtectionPage .np-item { display: flex; align-items: center; flex-wrap: wrap; gap: var(--cf-2) var(--cf-3); font-size: var(--cf-text-sm); color: var(--cf-text); min-width: 0; }
  #nsfwProtectionPage .np-list > .np-item { padding: var(--cf-2) var(--cf-5); }
  #nsfwProtectionPage .np-list > .np-item + .np-item { border-top: 1px solid var(--cf-border); }
  #nsfwProtectionPage .np-item > .fas { width: 28px; text-align: center; color: var(--cf-text-3); }
  #nsfwProtectionPage .np-grow { flex: 1 1 12rem; min-width: 0; overflow-wrap: anywhere; }
  #nsfwProtectionPage .np-sub { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
  #nsfwProtectionPage .np-scan-state { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
  #nsfwProtectionPage .np-progress { height: 6px; background: var(--cf-surface-3); border-radius: 999px; overflow: hidden; }
  #nsfwProtectionPage .np-progress[hidden] { display: none; }
  #nsfwProtectionPage .np-progress-bar { height: 100%; width: 0; background: var(--cf-accent); transition: width 0.4s; }

  /* Model status, test output and usage: padded blocks inside the panel. */
  #nsfwProtectionPage .np-out { display: grid; gap: var(--cf-2); padding: var(--cf-4) var(--cf-5); font-size: var(--cf-text-sm); min-width: 0; overflow-wrap: anywhere; }
  #nsfwProtectionPage .np-out .np-item + .np-item { border-top: 1px solid var(--cf-border); padding-top: var(--cf-2); }
  #nsfwProtectionPage .np-model { display: flex; align-items: center; flex-wrap: wrap; gap: var(--cf-2); color: var(--cf-text-2); }

  /* Review entries: blurred picture, scores and details, decisions. */
  #nsfwProtectionPage .np-rev { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; gap: var(--cf-3) var(--cf-4); align-items: center; padding: var(--cf-3) var(--cf-5); }
  #nsfwProtectionPage .np-rev + .np-rev { border-top: 1px solid var(--cf-border); }
  #nsfwProtectionPage .np-rev .np-check { width: 16px; height: 16px; accent-color: var(--cf-accent); }
  #nsfwProtectionPage .np-rev .np-grow { display: grid; gap: 2px; font-size: var(--cf-text-sm); }
  #nsfwProtectionPage .np-blur { width: 64px; height: 64px; border-radius: var(--cf-radius); object-fit: cover; background: var(--cf-surface-3); filter: blur(14px); cursor: pointer; transition: filter 0.2s; }
  #nsfwProtectionPage .np-blur.shown { filter: none; }
  #nsfwProtectionPage .np-noimg { width: 64px; height: 64px; border-radius: var(--cf-radius); background: var(--cf-surface-3); display: flex; align-items: center; justify-content: center; color: var(--cf-text-3); font-size: 1.2rem; }
  #nsfwProtectionPage .np-rev-actions { display: flex; flex-wrap: wrap; gap: var(--cf-1); justify-content: flex-end; }

  /* Usage bars: avatar scans in the accent, image scans in the info tone. */
  #nsfwProtectionPage .np-legend { display: flex; flex-wrap: wrap; gap: var(--cf-4); font-size: var(--cf-text-xs); color: var(--cf-text-3); }
  #nsfwProtectionPage .np-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
  #nsfwProtectionPage .np-dot.a, #nsfwProtectionPage .np-bar-track .a { background: var(--cf-accent); }
  #nsfwProtectionPage .np-dot.i, #nsfwProtectionPage .np-bar-track .i { background: var(--cf-info); }
  #nsfwProtectionPage .np-bars { display: grid; gap: 6px; }
  #nsfwProtectionPage .np-bar-row { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) 9rem; gap: var(--cf-3); align-items: center; font-size: var(--cf-text-xs); font-variant-numeric: tabular-nums; }
  #nsfwProtectionPage .np-bar-track { height: 8px; background: var(--cf-surface-3); border-radius: 999px; overflow: hidden; display: flex; }
  #nsfwProtectionPage .np-bar-track span { display: block; height: 100%; }

  @media (max-width: 800px) {
    #nsfwProtectionPage .np-rev { grid-template-columns: auto auto minmax(0, 1fr); }
    #nsfwProtectionPage .np-rev .np-rev-actions { grid-column: 1 / -1; justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    #nsfwProtectionPage .np-inline > input[type="file"] { flex-basis: 100%; }
    #nsfwProtectionPage .np-bar, #nsfwProtectionPage .np-list > .np-item, #nsfwProtectionPage .np-out, #nsfwProtectionPage .np-rev { padding-left: var(--cf-4); padding-right: var(--cf-4); }
    #nsfwProtectionPage .np-bar .np-actions { margin-left: 0; }
    #nsfwProtectionPage .np-bar-row { grid-template-columns: 3rem minmax(0, 1fr); }
    #nsfwProtectionPage .np-bar-row > :last-child { grid-column: 2; }
    #nsfwProtectionPage .np-blur, #nsfwProtectionPage .np-noimg { width: 52px; height: 52px; }
  }
</style>

<script>
(function () {
  const root = document.getElementById('nsfwProtectionPage');
  if (!root) return;
  const guildId = root.dataset.guildId;
  const api = (p) => `/api/guilds/${guildId}/nsfw-protection${p}`;
  const $ = (id) => document.getElementById(id);
  const AV_LABEL = { log: 'Log only and review', flag: 'Flag with role', kick: 'Kick', ban: 'Ban' };
  const IM_LABEL = { alert: 'Alert staff', delete: 'Delete', timeout: 'Delete and timeout' };
  const AV_PERM = { flag: 'flag', kick: 'kick', ban: 'ban' };
  const IM_PERM = { delete: 'delete', timeout: 'timeout' };
  const STATUS_WORD = { pending: 'Waiting', actioned: 'Acted on', failed: 'Could not act', safe: 'Not NSFW', overturned: 'Overturned',
    banned: 'Banned (review)', kicked: 'Kicked (review)', skipped: 'Skipped', gone: 'Gone' };
  const TABS = [['open', 'Open'], ['pending', 'Waiting'], ['actioned', 'Acted on'], ['overturned', 'Overturned'], ['safe', 'Not NSFW'], ['all', 'All']];
  const KINDS = [['all', 'Avatars and images'], ['avatar', 'Avatars'], ['image', 'Chat images']];
  let state = null;
  let tab = 'open';
  let kind = 'all';
  let rows = [];
  const selected = new Map();   // `${surface}:${id}` -> { surface, id }
  let scanTimer = null;

