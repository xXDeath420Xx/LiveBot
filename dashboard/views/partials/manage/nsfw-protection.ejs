      $('npSafeCount').textContent = String(safe.length);
      $('npSafe').replaceChildren(...(safe.length ? safe.map(s => el('div', { class: 'np-item' },
        el('span', { class: 'np-grow' }, el('span', { text: `#${s.id} ${s.label || ''}` }), el('span', { class: 'np-sub', text: when(s.created_at) })),
        el('button', { type: 'button', class: 'btn btn-sm btn-secondary', disabled: !can(), onclick: () => {
          if (!confirm('Forget this picture? It will be checked again the next time it appears.')) return;
          act(() => req(api(`/safe/${s.id}`), { method: 'DELETE' }), 'Forgotten.').then(loadSafe);
        } }, 'Forget'))) : [stateBox('None yet', 'Pictures you mark Not NSFW are remembered here.')]));
    } catch (err) { $('npSafe').replaceChildren(stateBox('Could not load safe pictures', err.message, 'error')); }
  }

  async function load() {
    try {
      state = await req(api('/'));
      renderModel(); renderStats(); renderSettings(); renderUsage(); renderScan(state.scan);
      await Promise.all([loadReviews(), loadRecent(), loadSafe()]);
    } catch (err) {
      showError(err.message);
      if (!state) {
        $('npStats').replaceChildren(stateBox('Could not load NSFW protection', 'Reload the page to try again.', 'error', true));
        $('npModelBadge').textContent = 'Unknown';
        $('npModel').replaceChildren(el('div', { class: 'np-muted', text: 'Model status not loaded.' }));
        for (const id of ['npReviews', 'npRecent', 'npSafe']) $(id).replaceChildren(stateBox('Not loaded', null, 'empty', true));
        $('npUsage').replaceChildren(el('div', { class: 'np-muted', text: 'Not loaded.' }));
      }
    }
  }
  load();
})();
</script>
