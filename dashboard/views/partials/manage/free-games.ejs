<%#
  Free game alerts: subscriptions that post free games from Steam, Epic Games, GOG and Prime Gaming
  to a channel. Everything goes through /api/guilds/:id/free-games (add, edit, pause, filters, send a
  test post, remove). Built on the settings-row kit (cf-settings.css); ids and field names are unchanged.
  Script-built parts use createElement/textContent.
%>
<%
const fgSubs = typeof freeGamesSubs !== 'undefined' ? freeGamesSubs : [];
const fgText = (channels || []).filter(c => c.type === 0 || c.type === 5);
const fgRoleName = (id) => { const r = (roles || []).find(x => x.id === id); return r ? r.name : null; };
const fgChannelName = (id) => { const c = (channels || []).find(x => x.id === id); return c ? c.name : null; };
// Must stay in step with SUBSCRIPTION_TOGGLES in dashboard/routes/api/features/free-games.js.
const fgGroups = [
    ['Offers', [['notify_free', 'Free to keep'], ['notify_weekend', 'Free weekend'], ['notify_dlc', 'DLC'], ['notify_prime', 'Prime'], ['notify_gamepass', 'Game Pass']]],
    ['Stores', [['filter_steam', 'Steam'], ['filter_epic', 'Epic Games'], ['filter_gog', 'GOG'], ['filter_prime', 'Prime Gaming']]],
    ['Platforms', [['filter_windows', 'Windows'], ['filter_mac', 'macOS'], ['filter_linux', 'Linux']]],
];
%>
<%- include('_game-kit') %>
<style>
    #fg-toggle-groups label.cf-row { margin: 0; cursor: pointer; }
    .fg-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; }
    .fg-two > .cf-rows-col { min-width: 0; }
    .fg-two > .gk-preview-wrap { border-left: 1px solid var(--cf-border); }
    @media (max-width: 960px) { .fg-two { grid-template-columns: minmax(0, 1fr); } .fg-two > .gk-preview-wrap { border-left: 0; border-top: 1px solid var(--cf-border); } }
    .fg-two .cf-row { grid-template-columns: minmax(0, 1fr); }
</style>

<div class="page-section" id="freeGamesPage" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-gift"></i>
                <span>Free game alerts</span>
            </div>
            <div class="page-section-subtitle">One subscription per channel, each with its own stores and offer types.</div>
        </div>
    </div>

    <div id="fg-status" class="cf-notice" role="status" aria-live="polite" hidden></div>

    <section class="cf-section" aria-labelledby="fg-add-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="fg-add-title">Add a subscription</h2>
                <p class="cf-section-desc">It starts with free-to-keep games from every store; change that afterwards with Filters.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="fg-two">
                <form id="fg-add-form" class="cf-rows-col">
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-free-games-channel_id">Channel</label>
                            <p class="cf-row-desc" id="f-free-games-channel_id-desc">Where free games are posted.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-free-games-channel_id" class="form-select" name="channel_id" required aria-describedby="f-free-games-channel_id-desc">
                                <option value="">Choose a channel</option>
                                <% fgText.forEach(function(ch) { %>
                                    <option value="<%= ch.id %>" data-kind="text">#<%= ch.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-free-games-mention_role_id">Role to mention</label>
                            <p class="cf-row-desc" id="f-free-games-mention_role_id-desc">Optional. Pinged with each new free game.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-free-games-mention_role_id" class="form-select" name="mention_role_id" aria-describedby="f-free-games-mention_role_id-desc">
                                <option value="">No mention</option>
                                <% (roles || []).forEach(function(role) { %>
                                    <option value="<%= role.id %>" data-kind="role">@<%= role.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-free-games-custom_message">Message text</label>
                            <p class="cf-row-desc" id="f-free-games-custom_message-desc">Optional, up to 200 characters, above each alert. Leave empty for "Free Game Alert!".</p>
                        </div>
                        <div class="cf-row-control">
                            <input id="f-free-games-custom_message" type="text" class="form-control" name="custom_message" placeholder="🎮 **Free Game Alert!**" maxlength="200" aria-describedby="f-free-games-custom_message-desc">
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Add subscription</button>
                    </div>
                </form>
                <div class="gk-preview-wrap">
                    <div class="gk-preview">
                        <p class="gk-preview-label">Preview</p>
                        <div class="cf-dc" data-fg-preview="add" aria-label="Preview of a free game alert"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="fg-subs-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="fg-subs-title">Subscriptions <span class="gk-cmd-count"><%= fgSubs.length || '' %></span></h2>
                <p class="cf-section-desc">Send test posts the newest free game the bot has seen to that channel, without pinging anyone.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% if (fgSubs.length === 0) { %>
                <%- include('../kit/_state', { kind: 'empty', title: 'No subscriptions yet', text: 'Add one above to start posting free games.', id: null, boxed: false, compact: false }) %>
            <% } else { %>
            <div class="cf-list" id="fg-subs-list">
                <% fgSubs.forEach(function(sub) {
                    const role = sub.mention_role_id ? (fgRoleName(sub.mention_role_id) || 'a deleted role') : null;
                    const chName = fgChannelName(sub.discord_channel_id);
                %>
                <div class="cf-list-item cf-list-item--multi fg-sub fg-sub-card" data-sub-id="<%= sub.id %>">
                    <div class="cf-list-main">
                        <p class="cf-list-title">#<%= chName || 'deleted-channel' %>
                            <span class="cf-pill <%= sub.is_enabled ? 'is-ok' : '' %>"><%= sub.is_enabled ? 'On' : 'Paused' %></span>
                            <% if (!chName) { %><span class="cf-pill is-bad">Channel missing</span><% } %>
                        </p>
                        <p class="cf-list-meta">
                            <span><%= role ? 'Mentions @' + role : 'No mention' %></span>
                            <span><%= sub.custom_message ? 'Message: ' + sub.custom_message : 'Standard message' %></span>
                        </p>
                        <div class="cf-chips">
                            <% fgGroups.forEach(function(g) { g[1].filter(function(t) { return sub[t[0]]; }).forEach(function(t) { %><span class="cf-chip"><%= t[1] %></span><% }); }); %>
                        </div>
                        <span class="cf-status-line" data-fg-line="<%= sub.id %>" role="status" aria-live="polite"></span>
                    </div>
                    <div class="cf-list-actions">
                        <button class="btn btn-sm btn-secondary" type="button" data-fg-act="test" data-sub="<%= sub.id %>"<%= chName ? '' : ' disabled' %>>Send test</button>
                        <button class="btn btn-sm btn-secondary" type="button" data-fg-act="edit" data-sub="<%= sub.id %>">Edit</button>
                        <button class="btn btn-sm btn-secondary" type="button" data-fg-act="filters" data-sub="<%= sub.id %>">Filters</button>
                        <button class="btn btn-sm btn-secondary" type="button" data-fg-act="toggle" data-sub="<%= sub.id %>" data-on="<%= sub.is_enabled ? '1' : '0' %>"><%= sub.is_enabled ? 'Pause' : 'Resume' %></button>
                        <button class="btn btn-sm btn-danger" type="button" data-fg-act="delete" data-sub="<%= sub.id %>">Remove</button>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </section>

    <%- include('_game-commands', { gkCommands: [{ cmd: 'alerts', groups: ['freegames'] }, { cmd: 'deals' }] }) %>
</div>

<!-- Edit subscription -->
<div class="modal fade" id="fgEditModal" tabindex="-1" aria-labelledby="fgEditModal-title">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fgEditModal-title">Edit subscription</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="fg-edit-id">
                <div class="mb-3">
                    <label class="form-label" for="fg-edit-channel">Channel</label>
                    <select id="fg-edit-channel" class="form-select" data-no-savebar>
                        <% fgText.forEach(function(ch) { %><option value="<%= ch.id %>" data-kind="text">#<%= ch.name %></option><% }); %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="fg-edit-role">Role to mention</label>
                    <select id="fg-edit-role" class="form-select" data-no-savebar>
                        <option value="">No mention</option>
                        <% (roles || []).forEach(function(role) { %><option value="<%= role.id %>" data-kind="role">@<%= role.name %></option><% }); %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="fg-edit-message">Message text</label>
                    <input id="fg-edit-message" type="text" class="form-control" maxlength="200" placeholder="🎮 **Free Game Alert!**" data-no-savebar>
                    <div class="form-text">Leave empty for "Free Game Alert!".</div>
                </div>
                <p class="gk-preview-label">Preview</p>
                <div class="cf-dc" data-fg-preview="edit" aria-label="Preview of a free game alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="fg-edit-save">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Filters Modal -->
<div class="modal fade" id="fgFiltersModal" tabindex="-1" aria-labelledby="fgFiltersModal-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fgFiltersModal-title">Filters</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="fg-filters-form">
                    <input type="hidden" name="sub_id" id="fg-filter-sub-id">
                    <%# Drawn from /api/guilds/:id/free-games/toggles, which is derived from the subscription schema. %>
                    <div id="fg-toggle-groups">
                        <%- include('../kit/_state', { kind: 'loading', title: 'Loading filters', text: null, id: null, boxed: false, compact: true }) %>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="fg-filters-save">Save filters</button>
            </div>
        </div>
    </div>
</div>

<%# The bot's name line for the script-drawn previews. %>
<template id="fg-author"><%- include('_gk-author') %></template>

<script>
(function () {
    var root = document.getElementById('freeGamesPage');
    if (!root) return;
    var fgGuildId = root.getAttribute('data-guild-id');
    var fgApi = '/api/guilds/' + fgGuildId + '/free-games';
    var fgSubsData = <%- JSON.stringify(fgSubs).replace(/</g, '\\u003c') %>;
    var $ = function (id) { return document.getElementById(id); };

    function h(tag, props) {
        var n = document.createElement(tag);
        var p = props || {};
        if (p.className) n.className = p.className;
        if (p.text !== undefined) n.textContent = String(p.text);
        Object.keys(p.attrs || {}).forEach(function (k) { if (p.attrs[k] !== false && p.attrs[k] != null) n.setAttribute(k, p.attrs[k] === true ? '' : p.attrs[k]); });
        for (var i = 2; i < arguments.length; i++) if (arguments[i] != null) n.append(arguments[i]);
        return n;
    }

    function fgStatus(msg, type) {
        var el = $('fg-status');
        el.textContent = msg;
        el.className = 'cf-notice ' + (type === 'error' ? 'is-bad' : 'is-ok');
        el.hidden = false;
        clearTimeout(el._fgTimer);
        el._fgTimer = setTimeout(function () { el.hidden = true; }, 4000);
    }
    async function call(url, method, body) {
        var res = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok || !data.success) throw new Error(data.error || 'Request failed (' + res.status + ')');
        return data;
    }

    // ── Preview: the same content and embed core/free-games-manager.js posts, with a sample game.
    function drawPreview(box, roleId, message) {
        box.replaceChildren();
        box.appendChild($('fg-author').content.cloneNode(true));
        var content = (roleId ? '<@&' + roleId + '> ' : '') + (message && message.trim() ? message.trim() : '🎮 **Free Game Alert!**');
        var text = h('div', { className: 'cf-dc-text' });
        GK.fill(text, content);
        var links = h('div', { className: 'cf-dc-field is-wide' }, h('span', { className: 'cf-dc-link', text: 'Open in browser ↗' }), '    ', h('span', { className: 'cf-dc-link', text: 'Open in Epic Games Launcher ↗' }));
        var price = h('div', { className: 'cf-dc-field is-wide' });
        GK.fill(price, '~~$19.99~~ **Free** until 2026-11-25');
        var embed = h('div', { className: 'cf-dc-embed' },
            h('div', { className: 'cf-dc-title is-link', text: 'Sample Game' }),
            h('div', { className: 'cf-dc-desc', text: 'A short description of the game from its store page.' }),
            h('div', { className: 'cf-dc-fields' }, price, links),
            h('div', { className: 'cf-dc-image is-blank', text: 'Game art' }),
            h('div', { className: 'cf-dc-footer', text: 'via freestuffbot.xyz • Epic Games' }));
        embed.style.setProperty('--cf-dc-bar', '#0078F2');
        box.append(text, embed);
    }
    function drawAdd() { drawPreview(document.querySelector('[data-fg-preview="add"]'), $('f-free-games-mention_role_id').value, $('f-free-games-custom_message').value); }
    function drawEdit() { drawPreview(document.querySelector('[data-fg-preview="edit"]'), $('fg-edit-role').value, $('fg-edit-message').value); }
    $('fg-add-form').addEventListener('input', drawAdd);
    $('fg-add-form').addEventListener('change', drawAdd);
    ['fg-edit-role', 'fg-edit-message'].forEach(function (id) { $(id).addEventListener('input', drawEdit); $(id).addEventListener('change', drawEdit); });
    drawAdd();

    // ── Add
    $('fg-add-form').addEventListener('submit', async function (e) {
        e.preventDefault();
        var form = new FormData(this);
        if (!form.get('channel_id')) { fgStatus('Choose a channel first.', 'error'); return; }
        try {
            await call(fgApi, 'POST', {
                channel_id: form.get('channel_id'),
                mention_role_id: form.get('mention_role_id') || null,
                custom_message: form.get('custom_message') || null
            });
            fgStatus('Subscription added.', 'success');
            setTimeout(function () { location.reload(); }, 500);
        } catch (err) { fgStatus(err.message, 'error'); }
    });

    // ── Filters
    var fgToggleDefs = null;
    var FG_GROUP_TITLES = { kinds: 'Offers', stores: 'Stores', platforms: 'Platforms' };
    async function fgLoadToggleDefs() {
        if (fgToggleDefs) return fgToggleDefs;
        var res = await fetch(fgApi + '/toggles');
        var data = await res.json();
        fgToggleDefs = data.toggles;
        return fgToggleDefs;
    }
    function fgRenderToggles(defs, sub) {
        var rows = h('div', { className: 'cf-rows' });
        Object.keys(defs).forEach(function (group) {
            rows.append(h('div', { className: 'cf-rows-head', text: FG_GROUP_TITLES[group] || group }));
            defs[group].forEach(function (t) {
                rows.append(h('label', { className: 'cf-row cf-row--switch fg-toggle' },
                    h('span', { className: 'cf-row-text' }, h('span', { className: 'cf-row-label', text: t[1] }), t[2] ? h('span', { className: 'cf-row-desc', text: t[2] }) : null),
                    h('span', { className: 'cf-row-control' }, h('input', { className: 'cf-switch', attrs: { type: 'checkbox', role: 'switch', 'data-col': t[0], checked: !!sub[t[0]] } }))));
            });
        });
        return rows;
    }
    async function fgEditFilters(subId) {
        var sub = fgSubsData.find(function (s) { return String(s.id) === String(subId); });
        if (!sub) return;
        $('fg-filter-sub-id').value = subId;
        var container = $('fg-toggle-groups');
        try {
            container.replaceChildren(fgRenderToggles(await fgLoadToggleDefs(), sub));
        } catch (err) {
            container.replaceChildren(h('div', { className: 'cf-state cf-state--error cf-state--compact', attrs: { role: 'alert' }, text: 'Could not load the filters: ' + err.message }));
        }
        new bootstrap.Modal($('fgFiltersModal')).show();
    }
    $('fg-filters-save').addEventListener('click', async function () {
        var payload = {};
        document.querySelectorAll('#fg-toggle-groups .fg-toggle input[data-col]').forEach(function (cb) { payload[cb.getAttribute('data-col')] = cb.checked; });
        try {
            await call(fgApi + '/' + $('fg-filter-sub-id').value + '/filters', 'PUT', payload);
            bootstrap.Modal.getInstance($('fgFiltersModal')).hide();
            fgStatus('Filters saved.', 'success');
            setTimeout(function () { location.reload(); }, 500);
        } catch (err) { fgStatus(err.message, 'error'); }
    });

    // ── Edit channel, role and message
    function fgEdit(subId) {
        var sub = fgSubsData.find(function (s) { return String(s.id) === String(subId); });
        if (!sub) return;
        $('fg-edit-id').value = subId;
        $('fg-edit-channel').value = sub.discord_channel_id || '';
        $('fg-edit-role').value = sub.mention_role_id || '';
        $('fg-edit-message').value = sub.custom_message || '';
        drawEdit();
        new bootstrap.Modal($('fgEditModal')).show();
    }
    $('fg-edit-save').addEventListener('click', async function () {
        try {
            await call(fgApi + '/' + $('fg-edit-id').value, 'PATCH', {
                channel_id: $('fg-edit-channel').value,
                mention_role_id: $('fg-edit-role').value || null,
                custom_message: $('fg-edit-message').value
            });
            bootstrap.Modal.getInstance($('fgEditModal')).hide();
            fgStatus('Subscription updated.', 'success');
            setTimeout(function () { location.reload(); }, 500);
        } catch (err) { fgStatus(err.message, 'error'); }
    });

    // ── Row actions
    root.addEventListener('click', async function (e) {
        var btn = e.target.closest('[data-fg-act]');
        if (!btn) return;
        var id = btn.getAttribute('data-sub');
        var act = btn.getAttribute('data-fg-act');
        if (act === 'filters') return fgEditFilters(id);
        if (act === 'edit') return fgEdit(id);
        if (act === 'delete') {
            if (!confirm('Remove this free game subscription?')) return;
            try {
                await call(fgApi + '/' + id, 'DELETE');
                fgStatus('Subscription removed.', 'success');
                var card = root.querySelector('.fg-sub-card[data-sub-id="' + id + '"]');
                if (card) card.remove();
            } catch (err) { fgStatus(err.message, 'error'); }
            return;
        }
        if (act === 'toggle') {
            var enable = btn.getAttribute('data-on') !== '1';
            try {
                await call(fgApi + '/' + id, 'PATCH', { is_enabled: enable });
                fgStatus(enable ? 'Resumed.' : 'Paused.', 'success');
                setTimeout(function () { location.reload(); }, 500);
            } catch (err) { fgStatus(err.message, 'error'); }
            return;
        }
        if (act === 'test') {
            var line = root.querySelector('[data-fg-line="' + id + '"]');
            btn.disabled = true;
            line.className = 'cf-status-line is-busy';
            line.textContent = 'Posting…';
            try {
                var r = await call(fgApi + '/' + id + '/test', 'POST');
                line.className = 'cf-status-line is-ok';
                line.textContent = 'Posted "' + (r.title || 'a free game') + '" to #' + (r.channel || 'the channel') + '.';
            } catch (err) {
                line.className = 'cf-status-line is-bad';
                line.textContent = err.message;
            }
            btn.disabled = false;
        }
    });
})();
</script>
