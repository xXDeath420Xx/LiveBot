<%#
  RPG: the D&D-style RPG. The play channel (POST rpg/channel, the same setting as /rpg settings channel),
  the top players, the classes and the full command list. Built on the settings-row kit.
%>
<%
const rpgText = (locals.channels || []).filter(c => c.type === 0 || c.type === 5);
const rpgChannel = locals.rpgChannelId || '';
const rpgClasses = [
    ['Barbarian', 'd12', 'Primal rage and devastating attacks'],
    ['Bard', 'd8', 'Magical music and inspiration'],
    ['Cleric', 'd8', 'Divine magic and healing'],
    ['Druid', 'd8', 'Nature magic and wild shape'],
    ['Fighter', 'd10', 'Martial combat mastery'],
    ['Monk', 'd8', 'Ki-powered martial arts'],
    ['Paladin', 'd10', 'Holy warrior with divine smite'],
    ['Ranger', 'd10', 'Wilderness expert and hunter'],
    ['Rogue', 'd8', 'Stealth and sneak attack'],
    ['Sorcerer', 'd6', 'Innate magical bloodline'],
    ['Warlock', 'd8', 'Otherworldly patron pact'],
    ['Wizard', 'd6', 'Scholarly arcane magic'],
];
%>
<%- include('_game-kit') %>
<style>
    .rpg-class { font-weight: 500; color: var(--cf-text); }
    .rpg-num { font-weight: 600; color: var(--cf-text); font-variant-numeric: tabular-nums; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-dragon"></i>
                <span>RPG</span>
            </div>
            <div class="page-section-subtitle">D&amp;D 5e rules, played with <code>/rpg</code>.</div>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="RPG at a glance">
        <div class="cf-kpi"><dt>Characters</dt><dd class="cf-kpi-value"><%= Number(rpgStats?.totalCharacters || 0).toLocaleString() %></dd></div>
        <div class="cf-kpi"><dt>Active players</dt><dd class="cf-kpi-value"><%= Number(rpgStats?.activePlayers || 0).toLocaleString() %></dd></div>
        <div class="cf-kpi"><dt>Quests completed</dt><dd class="cf-kpi-value"><%= Number(rpgStats?.questsCompleted || 0).toLocaleString() %></dd></div>
        <div class="cf-kpi"><dt>Battles fought</dt><dd class="cf-kpi-value"><%= Number(rpgStats?.battlesFought || 0).toLocaleString() %></dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="rpg-settings-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="rpg-settings-title">Play channel</h2>
                <p class="cf-section-desc"><code>/rpg</code> commands (typed as a message) work in every channel. Chatting with the story by replying to it only works here.</p>
            </div>
        </header>
        <form action="/manage/<%= guild.id %>/rpg/channel" method="POST">
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-rpg-channel_id">RPG channel</label>
                        <p class="cf-row-desc">Where replies and mentions are read as in-game actions. With no channel, that is off everywhere. Same as <code>/rpg settings channel</code>.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-rpg-channel_id" class="form-select" name="channel_id">
                            <option value="">No channel (chat play off)</option>
                            <% rpgText.forEach(c => { %><option value="<%= c.id %>" data-kind="text"<%= String(c.id) === String(rpgChannel) ? ' selected' : '' %>>#<%= c.name %></option><% }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </form>
    </section>

    <section class="cf-section" aria-labelledby="rpg-top-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="rpg-top-title">Top players</h2>
                <p class="cf-section-desc">The highest-level characters in this server.</p>
            </div>
        </header>
        <div class="cf-rows">
        <% if (rpgStats && rpgStats.topPlayers && rpgStats.topPlayers.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Character</th>
                            <th scope="col">Class</th>
                            <th scope="col" class="cf-cell-end">Level</th>
                            <th scope="col" class="cf-cell-end">Experience</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rpgStats.topPlayers.forEach((player, index) => { %>
                            <tr>
                                <td data-label="Rank"><span class="rpg-num"><%= index + 1 %></span></td>
                                <td data-label="Character"><span class="rpg-class"><%= player.character_name %></span></td>
                                <td data-label="Class"><span class="cf-pill"><%= player.class %></span></td>
                                <td data-label="Level" class="cf-cell-end"><span class="rpg-num"><%= player.level %></span></td>
                                <td data-label="Experience" class="cf-cell-end"><span class="rpg-num"><%= Number(player.experience || 0).toLocaleString() %></span></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No players yet', text: 'Members start with /rpg character create in Discord.', id: null, boxed: false, compact: false }) %>
        <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="rpg-classes-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="rpg-classes-title">Classes <span class="gk-cmd-count"><%= rpgClasses.length %></span></h2>
                <p class="cf-section-desc">A character takes one at creation, or brings it in from a D&amp;D Beyond PDF by sending <code>/rpg character import</code> with the PDF attached.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr><th scope="col">Class</th><th scope="col">Hit die</th><th scope="col">Plays as</th></tr>
                    </thead>
                    <tbody>
                        <% rpgClasses.forEach(c => { %>
                        <tr>
                            <td data-label="Class"><span class="rpg-class"><%= c[0] %></span></td>
                            <td data-label="Hit die"><span class="cf-token"><%= c[1] %></span></td>
                            <td data-label="Plays as" class="cf-cell-muted"><%= c[2] %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <%- include('_game-commands', { gkCommands: [{ cmd: 'rpg' }], gkCmdNote: 'Typed as a message starting with /rpg; they are not in the / menu. Open a group to see its commands.' }) %>
</div>
