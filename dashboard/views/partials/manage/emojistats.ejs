<%#
  Emoji stats: usage over the chosen period, loaded from GET /manage/:id/emojistats?period=
  (dashboard/routes/features/statistics.js): totals for the whole period with the period before,
  the 20 most used emoji, the 10 members who use the most, use by day, and the server's own emoji
  nobody used. Read-only. Built on the settings-row kit (cf-settings.css); ids and the period
  select's handler are unchanged. Lists are built with createElement/textContent.
%>
<style>
    .es-rank { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 28px; height: 28px;
        border-radius: var(--cf-radius-sm); background: var(--cf-surface-2); border: 1px solid var(--cf-border);
        color: var(--cf-text-2); font-size: var(--cf-text-xs); font-weight: 600; font-variant-numeric: tabular-nums; }
    .es-rank.is-top { color: var(--cf-accent-fg); border-color: var(--cf-accent-line); background: var(--cf-accent-soft); }
    .es-who { display: flex; align-items: center; gap: var(--cf-3); min-width: 0; }
    .es-emoji { display: inline-flex; align-items: center; justify-content: center; width: 28px; font-size: 1.5rem; line-height: 1; flex: none; }
    .es-emoji-img { display: block; width: 28px; height: 28px; object-fit: contain; }
    .es-name { font-weight: 500; color: var(--cf-text); overflow-wrap: anywhere; }
    .es-sub { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); font-family: var(--cf-mono); }
    .es-count { flex: none; color: var(--cf-text-2); font-size: var(--cf-text-sm); font-variant-numeric: tabular-nums; }
    .es-count b { color: var(--cf-text); font-weight: 600; }
    .es-share { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); text-align: right; }
    .es-trend { display: grid; grid-template-columns: minmax(7rem, 9rem) minmax(0, 1fr) auto; align-items: center; gap: var(--cf-4);
        padding: var(--cf-3) var(--cf-5); font-size: var(--cf-text-sm); }
    .es-trend + .es-trend { border-top: 1px solid var(--cf-border); }
    .es-trend-date { color: var(--cf-text-2); }
    .es-bar { height: 6px; border-radius: 999px; background: var(--cf-surface-3); overflow: hidden; }
    .es-fill { height: 100%; border-radius: inherit; background: var(--cf-accent); transition: width 0.4s var(--cf-ease); }
    .es-unused { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr)); gap: var(--cf-2); padding: var(--cf-4) var(--cf-5); }
    .es-unused-item { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 6px 8px; border: 1px solid var(--cf-border);
        border-radius: var(--cf-radius); background: var(--cf-surface-2); font-size: var(--cf-text-xs); color: var(--cf-text-2); }
    .es-unused-item span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cf-kpi .es-delta { display: block; margin-top: 2px; font-size: var(--cf-text-xs); font-weight: 400; color: var(--cf-text-3); letter-spacing: 0; }
    .cf-kpi .es-delta.is-up { color: var(--cf-success); }
    .cf-kpi .es-delta.is-down { color: var(--cf-danger); }
    #emoji-period-select { width: auto; min-width: 10rem; }
    @media (max-width: 640px) {
        .cf-rows .cf-list-item.es-item { flex-direction: row; align-items: center; }
        .es-trend { grid-template-columns: minmax(0, 1fr) auto; padding: var(--cf-3) var(--cf-4); }
        .es-trend .es-bar { grid-column: 1 / -1; grid-row: 2; }
        .es-unused { padding: var(--cf-3) var(--cf-4); }
        #emoji-period-select { width: 100%; min-height: 44px; }
    }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-smile"></i>
                <span>Emoji stats</span>
            </div>
            <div class="page-section-subtitle">
                Use by emoji, by member and by day.
            </div>
        </div>
    </div>

    <section class="cf-section" aria-labelledby="es-overview-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="es-overview-title">Overview</h2>
                <p class="cf-section-desc">Totals for the period you choose, against the same number of days before it. Counts emoji typed in messages; reactions are not counted.</p>
            </div>
            <div class="cf-section-actions">
                <label class="visually-hidden" for="emoji-period-select">Period</label>
                <select id="emoji-period-select" class="form-select" onchange="loadEmojiStats()">
                    <option value="7d">Last 7 days</option>
                    <option value="30d">Last 30 days</option>
                    <option value="90d">Last 90 days</option>
                </select>
            </div>
        </header>
        <dl class="cf-kpis" aria-label="Emoji use at a glance">
            <div class="cf-kpi"><dt>Total uses</dt><dd class="cf-kpi-value" id="stat-total-uses">-</dd></div>
            <div class="cf-kpi"><dt>Different emoji</dt><dd class="cf-kpi-value" id="stat-unique-emojis">-</dd></div>
            <div class="cf-kpi"><dt>Members using emoji</dt><dd class="cf-kpi-value" id="stat-active-users">-</dd></div>
            <div class="cf-kpi"><dt>Uses per day</dt><dd class="cf-kpi-value" id="stat-daily-avg">-</dd></div>
        </dl>
    </section>

    <section class="cf-section" aria-labelledby="es-top-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="es-top-title">Most used emoji</h2>
                <p class="cf-section-desc">The top 20, with each one's share of all uses.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="top-emojis">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading emoji', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="es-users-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="es-users-title">Top emoji users</h2>
                <p class="cf-section-desc">The 10 members who used the most emoji in the period.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="top-emoji-users">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading members', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="cfk-es-unused-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="cfk-es-unused-title">Not used in this period</h2>
                <p class="cf-section-desc" id="cfk-es-unused-desc">Your server's own emoji that nobody used. Candidates to replace when you run out of slots.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="cfk-es-unused-rows">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="es-trends-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="es-trends-title">Use by day</h2>
                <p class="cf-section-desc">Emoji used on each day, newest first, against the busiest day.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="emoji-trends">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading daily use', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>
</div>

<script>
// Small DOM helper: el('span', 'cls', 'text' | [children]).
function esEl(tag, cls, content) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (Array.isArray(content)) content.filter((c) => c != null && c !== false).forEach((c) => n.append(c));
    else if (content != null) n.textContent = String(content);
    return n;
}
function esState(title, text, kind) {
    const box = esEl('div', `cf-state cf-state--${kind || 'empty'}`, [esEl('p', 'cf-state-title', title), text ? esEl('p', 'cf-state-text', text) : null]);
    if (kind === 'error') box.setAttribute('role', 'alert');
    return box;
}
function esCount(n, unit) {
    return esEl('span', 'es-count', [esEl('b', null, (Number(n) || 0).toLocaleString()), unit ? ` ${unit}` : null]);
}
function esImg(id, name, animated) {
    const img = esEl('img', 'es-emoji-img');
    img.src = `https://cdn.discordapp.com/emojis/${id}.${animated ? 'gif' : 'webp'}?size=48`;
    img.alt = name || 'custom emoji';
    img.width = 28; img.height = 28; img.loading = 'lazy';
    return img;
}
// Custom emoji come back as their id: show the image. A standard emoji is the character itself.
function esEmoji(emoji) {
    if (emoji.is_custom && /^\d{15,22}$/.test(String(emoji.emoji))) return esEl('span', 'es-emoji', [esImg(emoji.emoji, emoji.emoji_name)]);
    return esEl('span', 'es-emoji', String(emoji.emoji || emoji.emoji_name || ''));
}
function esRank(i) {
    return esEl('span', `es-rank${i < 3 ? ' is-top' : ''}`, i + 1);
}
// KPI value with a "vs the days before" line under it.
function esKpi(id, value, prev, days) {
    const dd = document.getElementById(id);
    dd.textContent = (Number(value) || 0).toLocaleString();
    if (prev == null) return;
    const v = Number(value) || 0, p = Number(prev) || 0, diff = v - p;
    const pct = p ? Math.round(diff / p * 100) : null;
    const note = esEl('span', 'es-delta', diff === 0 ? `Same as the ${days} days before`
        : `${pct == null ? (diff > 0 ? '+' : '') + diff.toLocaleString() : (pct > 0 ? '+' : '') + pct + '%'} vs the ${days} days before`);
    if (diff) note.classList.add(diff > 0 ? 'is-up' : 'is-down');
    dd.appendChild(note);
}

async function loadEmojiStats() {
    const period = document.getElementById('emoji-period-select').value;
    const show = (id, node) => document.getElementById(id).replaceChildren(node);

    try {
        const response = await fetch(`/manage/<%= guild.id %>/emojistats?period=${encodeURIComponent(period)}`, { credentials: 'same-origin' });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || ('HTTP ' + response.status));

        const days = data.days || (period === '30d' ? 30 : period === '90d' ? 90 : 7);
        // Whole-period totals (the lists are capped at 20 emoji and 10 members); older responses fall back to the lists.
        const t = data.totals || {
            total_uses: (data.topEmojis || []).reduce((sum, e) => sum + Number(e.use_count || 0), 0),
            unique_emojis: (data.topEmojis || []).length,
            active_users: (data.topUsers || []).length,
        };
        const p = data.prevTotals || null;
        esKpi('stat-total-uses', t.total_uses, p && p.total_uses, days);
        esKpi('stat-unique-emojis', t.unique_emojis, p && p.unique_emojis, days);
        esKpi('stat-active-users', t.active_users, p && p.active_users, days);
        esKpi('stat-daily-avg', Math.round((Number(t.total_uses) || 0) / days), p ? Math.round((Number(p.total_uses) || 0) / days) : null, days);

        const total = Number(t.total_uses) || 0;
        if (data.topEmojis && data.topEmojis.length > 0) {
            show('top-emojis', esEl('div', 'cf-list', data.topEmojis.map((emoji, index) => esEl('div', 'cf-list-item es-item', [
                esEl('div', 'es-who', [esRank(index), esEmoji(emoji), esEl('span', 'es-name', emoji.is_custom ? (':' + (emoji.emoji_name || 'emoji') + ':') : 'Standard emoji')]),
                esEl('span', null, [esCount(emoji.use_count, 'uses'), total ? esEl('span', 'es-share', Math.round(Number(emoji.use_count) / total * 1000) / 10 + '%') : null]),
            ]))));
        } else {
            show('top-emojis', esState('No emoji used yet', 'Nothing was recorded for this period.'));
        }

        if (data.topUsers && data.topUsers.length > 0) {
            show('top-emoji-users', esEl('div', 'cf-list', data.topUsers.map((user, index) => esEl('div', 'cf-list-item es-item', [
                esEl('div', 'es-who', [esRank(index), esEl('span', 'es-name', [user.username || 'Member who left', user.username ? null : esEl('span', 'es-sub', user.user_id)])]),
                esCount(user.total_emoji_uses, 'emoji'),
            ]))));
        } else {
            show('top-emoji-users', esState('No members yet', 'Nobody used emoji in this period.'));
        }

        // The server's own emoji with no use in the period (null when the bot cannot see the server).
        if (Array.isArray(data.unusedEmojis)) {
            if (data.unusedEmojis.length) {
                show('cfk-es-unused-rows', esEl('div', 'es-unused', data.unusedEmojis.map((e) => {
                    const item = esEl('div', 'es-unused-item', [esImg(e.id, e.name, e.animated), esEl('span', null, ':' + e.name + ':')]);
                    item.title = ':' + e.name + ':';
                    return item;
                })));
            } else {
                show('cfk-es-unused-rows', esState('Every server emoji was used', 'Or the server has no emoji of its own.'));
            }
        } else {
            show('cfk-es-unused-rows', esState('Not available right now', 'The bot could not read this server’s emoji list.'));
        }

        if (data.trends && data.trends.length > 0) {
            const trends = data.trends.slice().reverse();
            const maxCount = Math.max(...trends.map(t2 => Number(t2.count) || 0));
            const wrap = esEl('div', null, trends.map((trend) => {
                const fill = esEl('div', 'es-fill');
                fill.style.width = `${maxCount > 0 ? (Number(trend.count) / maxCount) * 100 : 0}%`;
                const bar = esEl('div', 'es-bar', [fill]);
                bar.setAttribute('aria-hidden', 'true');
                return esEl('div', 'es-trend', [
                    esEl('span', 'es-trend-date', new Date(trend.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' })),
                    bar,
                    esCount(trend.count),
                ]);
            }));
            show('emoji-trends', wrap);
        } else {
            show('emoji-trends', esState('No daily figures yet', 'Nothing was recorded for this period.'));
        }
    } catch (error) {
        console.error('Error loading emoji stats:', error);
        ['top-emojis', 'top-emoji-users', 'cfk-es-unused-rows', 'emoji-trends'].forEach((id) => show(id, esState('Could not load emoji stats', 'Refresh the page to try again.', 'error')));
    }
}

loadEmojiStats();
</script>
