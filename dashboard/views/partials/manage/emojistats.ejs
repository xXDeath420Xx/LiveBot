<style>
/* Emoji Stats Page Styles */
.emoji-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
}

.emoji-stat-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 14px;
    padding: 24px 20px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.emoji-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.emoji-stat-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(167, 139, 250, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(167, 139, 250, 0.2);
}

.emoji-stat-card:hover::before {
    opacity: 1;
}

.emoji-stat-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    font-weight: 500;
}

.emoji-stat-value {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #a78bfa 0%, #c4b5fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Section Cards */
.emoji-section-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 24px;
}

.emoji-section-header {
    background: rgba(167, 139, 250, 0.08);
    padding: 20px 24px;
    border-bottom: 1px solid rgba(167, 139, 250, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.emoji-section-header h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
}

.emoji-section-header i {
    font-size: 1.25rem;
    color: #a78bfa;
}

.emoji-section-body {
    padding: 24px;
}

/* Period Select */
.emoji-period-select {
    padding: 10px 16px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 10px;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.emoji-period-select:hover {
    border-color: rgba(167, 139, 250, 0.5);
    background: rgba(0, 0, 0, 0.4);
}

.emoji-period-select:focus {
    outline: none;
    border-color: #a78bfa;
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.15);
}

.emoji-period-select option {
    background: #1a1d21;
    color: #ffffff;
}

/* Emoji Entry */
.emoji-entry {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-bottom: 12px;
    transition: all 0.2s ease;
}

.emoji-entry:hover {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(167, 139, 250, 0.3);
    transform: translateX(4px);
}

.emoji-entry:last-child {
    margin-bottom: 0;
}

.emoji-rank {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.2), rgba(96, 165, 250, 0.2));
    border: 2px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.85rem;
    color: #a78bfa;
}

.emoji-rank.gold {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(245, 158, 11, 0.2));
    border-color: rgba(251, 191, 36, 0.4);
    color: #fbbf24;
}

.emoji-rank.silver {
    background: linear-gradient(135deg, rgba(156, 163, 175, 0.2), rgba(107, 114, 128, 0.2));
    border-color: rgba(156, 163, 175, 0.4);
    color: #9ca3af;
}

.emoji-rank.bronze {
    background: linear-gradient(135deg, rgba(217, 119, 6, 0.2), rgba(180, 83, 9, 0.2));
    border-color: rgba(217, 119, 6, 0.4);
    color: #d97706;
}

.emoji-info {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
}

.emoji-display {
    font-size: 2rem;
    line-height: 1;
}

.emoji-name {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
}

.emoji-count {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(167, 139, 250, 0.15);
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 8px;
    color: #a78bfa;
    font-weight: 700;
    font-size: 0.9rem;
}

/* User Entry */
.user-entry {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-bottom: 12px;
    transition: all 0.2s ease;
}

.user-entry:hover {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(167, 139, 250, 0.3);
}

.user-entry:last-child {
    margin-bottom: 0;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 16px;
}

.user-avatar {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.3), rgba(96, 165, 250, 0.3));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(167, 139, 250, 0.3);
}

.user-avatar i {
    font-size: 1rem;
    color: #a78bfa;
}

.user-id {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    font-family: 'Courier New', monospace;
}

/* Trend Item */
.trend-item {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 12px;
    transition: all 0.2s ease;
}

.trend-item:hover {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(167, 139, 250, 0.3);
}

.trend-item:last-child {
    margin-bottom: 0;
}

.trend-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.trend-date {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
}

.trend-date i {
    color: #a78bfa;
}

.trend-count {
    font-weight: 700;
    color: #a78bfa;
    font-size: 0.9rem;
}

.trend-bar {
    background: rgba(255, 255, 255, 0.1);
    height: 8px;
    border-radius: 4px;
    overflow: hidden;
}

.trend-fill {
    background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease;
}

/* Loading State */
.emoji-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    color: rgba(255, 255, 255, 0.6);
}

.emoji-loading i {
    font-size: 2rem;
    color: #a78bfa;
    margin-bottom: 16px;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Empty State */
.emoji-empty {
    text-align: center;
    padding: 40px 20px;
    color: rgba(255, 255, 255, 0.5);
}

.emoji-empty i {
    font-size: 2.5rem;
    color: rgba(167, 139, 250, 0.3);
    margin-bottom: 16px;
}

.emoji-empty-title {
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
}

@media (max-width: 768px) {
    .emoji-section-header {
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
    }

    .emoji-entry,
    .user-entry {
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
    }

    .emoji-count {
        width: 100%;
        justify-content: center;
    }
}
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-smile"></i>
                <span>Emoji Statistics</span>
            </div>
            <div class="page-section-subtitle">
                Track emoji usage patterns across your server
            </div>
        </div>
        <select id="emoji-period-select" class="emoji-period-select" onchange="loadEmojiStats()">
            <option value="7d">Last 7 Days</option>
            <option value="30d">Last 30 Days</option>
            <option value="90d">Last 90 Days</option>
        </select>
    </div>

    <!-- Stats Overview -->
    <div class="emoji-stats-grid">
        <div class="emoji-stat-card">
            <div class="emoji-stat-label">Total Uses</div>
            <div class="emoji-stat-value" id="stat-total-uses">-</div>
        </div>
        <div class="emoji-stat-card">
            <div class="emoji-stat-label">Unique Emojis</div>
            <div class="emoji-stat-value" id="stat-unique-emojis">-</div>
        </div>
        <div class="emoji-stat-card">
            <div class="emoji-stat-label">Active Users</div>
            <div class="emoji-stat-value" id="stat-active-users">-</div>
        </div>
        <div class="emoji-stat-card">
            <div class="emoji-stat-label">Daily Average</div>
            <div class="emoji-stat-value" id="stat-daily-avg">-</div>
        </div>
    </div>

    <!-- Top Emojis Section -->
    <div class="emoji-section-card">
        <div class="emoji-section-header">
            <h3>
                <i class="fas fa-trophy"></i>
                Most Used Emojis
            </h3>
        </div>
        <div class="emoji-section-body" id="top-emojis">
            <div class="emoji-loading">
                <i class="fas fa-spinner"></i>
                <span>Loading emoji data...</span>
            </div>
        </div>
    </div>

    <!-- Top Users Section -->
    <div class="emoji-section-card">
        <div class="emoji-section-header">
            <h3>
                <i class="fas fa-users"></i>
                Top Emoji Users
            </h3>
        </div>
        <div class="emoji-section-body" id="top-emoji-users">
            <div class="emoji-loading">
                <i class="fas fa-spinner"></i>
                <span>Loading user data...</span>
            </div>
        </div>
    </div>

    <!-- Emoji Trends Section -->
    <div class="emoji-section-card">
        <div class="emoji-section-header">
            <h3>
                <i class="fas fa-chart-line"></i>
                Usage Trends
            </h3>
        </div>
        <div class="emoji-section-body" id="emoji-trends">
            <div class="emoji-loading">
                <i class="fas fa-spinner"></i>
                <span>Loading trend data...</span>
            </div>
        </div>
    </div>
</div>

<script>
async function loadEmojiStats() {
    const period = document.getElementById('emoji-period-select').value;

    try {
        const response = await fetch(`/manage/<%= guild.id %>/emojistats?period=${period}`);
        const data = await response.json();

        // Update stats
        const totalUses = data.topEmojis?.reduce((sum, e) => sum + e.use_count, 0) || 0;
        document.getElementById('stat-total-uses').textContent = totalUses.toLocaleString();
        document.getElementById('stat-unique-emojis').textContent = data.topEmojis?.length || 0;
        document.getElementById('stat-active-users').textContent = data.topUsers?.length || 0;

        const days = period === '7d' ? 7 : period === '30d' ? 30 : 90;
        document.getElementById('stat-daily-avg').textContent = Math.round(totalUses / days).toLocaleString();

        // Top emojis
        if (data.topEmojis && data.topEmojis.length > 0) {
            const emojisHtml = data.topEmojis.map((emoji, index) => {
                let rankClass = '';
                if (index === 0) rankClass = 'gold';
                else if (index === 1) rankClass = 'silver';
                else if (index === 2) rankClass = 'bronze';

                return `
                    <div class="emoji-entry">
                        <div class="emoji-info">
                            <div class="emoji-rank ${rankClass}">${index + 1}</div>
                            <span class="emoji-display">${emoji.emoji}</span>
                            <span class="emoji-name">${emoji.emoji_name || 'Unknown Emoji'}</span>
                        </div>
                        <div class="emoji-count">
                            <i class="fas fa-fire"></i>
                            ${emoji.use_count.toLocaleString()} uses
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('top-emojis').innerHTML = emojisHtml;
        } else {
            document.getElementById('top-emojis').innerHTML = `
                <div class="emoji-empty">
                    <i class="fas fa-smile-wink"></i>
                    <div class="emoji-empty-title">No Emoji Data</div>
                    <p>No emoji usage recorded for this period</p>
                </div>
            `;
        }

        // Top emoji users
        if (data.topUsers && data.topUsers.length > 0) {
            const usersHtml = data.topUsers.map((user, index) => {
                let rankClass = '';
                if (index === 0) rankClass = 'gold';
                else if (index === 1) rankClass = 'silver';
                else if (index === 2) rankClass = 'bronze';

                return `
                    <div class="user-entry">
                        <div class="user-info">
                            <div class="emoji-rank ${rankClass}">${index + 1}</div>
                            <div class="user-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div>
                                <div class="emoji-name">User</div>
                                <div class="user-id">${user.user_id}</div>
                            </div>
                        </div>
                        <div class="emoji-count">
                            <i class="fas fa-smile"></i>
                            ${user.total_emoji_uses.toLocaleString()} emojis
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('top-emoji-users').innerHTML = usersHtml;
        } else {
            document.getElementById('top-emoji-users').innerHTML = `
                <div class="emoji-empty">
                    <i class="fas fa-users"></i>
                    <div class="emoji-empty-title">No User Data</div>
                    <p>No user emoji data available for this period</p>
                </div>
            `;
        }

        // Emoji trends
        if (data.trends && data.trends.length > 0) {
            const maxCount = Math.max(...data.trends.map(t => t.count));
            const trendsHtml = data.trends.map(trend => {
                const percentage = maxCount > 0 ? (trend.count / maxCount) * 100 : 0;
                return `
                    <div class="trend-item">
                        <div class="trend-header">
                            <div class="trend-date">
                                <i class="fas fa-calendar-day"></i>
                                ${new Date(trend.date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}
                            </div>
                            <div class="trend-count">${trend.count.toLocaleString()} emojis</div>
                        </div>
                        <div class="trend-bar">
                            <div class="trend-fill" style="width: ${percentage}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('emoji-trends').innerHTML = trendsHtml;
        } else {
            document.getElementById('emoji-trends').innerHTML = `
                <div class="emoji-empty">
                    <i class="fas fa-chart-line"></i>
                    <div class="emoji-empty-title">No Trend Data</div>
                    <p>No trend data available for this period</p>
                </div>
            `;
        }

    } catch (error) {
        console.error('Error loading emoji stats:', error);
        document.getElementById('top-emojis').innerHTML = `
            <div class="emoji-empty">
                <i class="fas fa-exclamation-triangle" style="color: #f87171;"></i>
                <div class="emoji-empty-title">Error Loading Data</div>
                <p>Please try refreshing the page</p>
            </div>
        `;
    }
}

loadEmojiStats();
</script>
