<%#
  Auto-responses: an editor (create, or edit one from the list) with a Discord-style preview, and the
  list, all through the JSON API (dashboard/routes/api/features/autoresponders.js: GET/POST /,
  PUT /:id, PUT /:id/toggle, DELETE /:id). The bot side is core/auto-response-manager.js: text,
  embed or reaction replies, match modes, channel and role limits, cooldowns. Built on the
  settings-row kit (cf-settings.css); the original field names and ids are kept.
%>
<%
const arText = (Array.isArray(channels) ? channels : []).filter(c => c.type === 0 || c.type === 5);
const arRoles = (Array.isArray(roles) ? roles : []).slice().sort((a, b) => (b.position || 0) - (a.position || 0));
const arBotName = (guild && guild.members && guild.members.me && guild.members.me.displayName) || 'CertiFried Utility';
const arSample = {
    server: guild ? guild.name : 'Your server',
    members: (guild && guild.memberCount) ? guild.memberCount : 120,
    channel: arText.length ? arText[0].name : 'general',
    channels: Object.fromEntries(arText.map(c => [c.id, c.name])),
};
%>
<script src="/js/cf-msgpreview.js"></script>
<style>
    #cfk-ar-page .ar-count { margin-left: 6px; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    #cfk-ar-page .ar-search { width: 18rem; max-width: 100%; }
    #cfk-ar-page .cf-rows .cf-expand[open] > summary { border-bottom: 1px solid var(--cf-border); }
    #cfk-ar-page .cf-rows .cf-expand > summary > span { display: flex; flex-wrap: wrap; gap: 2px 10px; align-items: baseline; }
    #cfk-ar-page .ar-muted { color: var(--cf-text-3); font-weight: 400; font-size: var(--cf-text-xs); }
    #cfk-ar-page .ar-pv { padding: var(--cf-4) var(--cf-5); display: grid; gap: var(--cf-2); }
    #cfk-ar-page .ar-pv-label { font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
    #cfk-ar-page .ar-pv-trigger { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    #cfk-ar-page .ar-reacts { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 10px; background: #313338; border-radius: 8px; }
    #cfk-ar-page .ar-react { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 8px; background: #2b2d31; border: 1px solid #5865f2; color: #dbdee1; font-size: 14px; }
    /* Light and Sand: Discord's light theme. */
    :root:is([data-theme="light"], [data-theme="sand"]) #cfk-ar-page .ar-reacts { background: #ffffff; box-shadow: inset 0 0 0 1px #e3e5e8; }
    :root:is([data-theme="light"], [data-theme="sand"]) #cfk-ar-page .ar-react { background: rgba(88, 101, 242, 0.12); color: #313338; }
    :root:is([data-theme="light"], [data-theme="sand"]) #cfk-ar-page .ar-react * { color: #313338; }
    #cfk-ar-page .cf-rows table.cf-table td.ar-trigger { font-weight: 600; max-width: 14rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #cfk-ar-page .cf-rows table.cf-table td.ar-response { color: var(--cf-text-2); max-width: 20rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #cfk-ar-page .cf-rows table.cf-table td.ar-uses { color: var(--cf-text-2); font-variant-numeric: tabular-nums; }
    #cfk-ar-page .cf-rows table.cf-table tr.is-off td:not(.cf-cell-end) { opacity: .6; }
    #cfk-ar-page .cf-rows table.cf-table tr.is-editing td { background: var(--cf-accent-soft); }
    #cfk-ar-page .ar-actions { white-space: nowrap; }
    #cfk-ar-page .ar-actions .btn + .btn { margin-left: var(--cf-2); }
    #cfk-ar-page .ar-pills { display: inline-flex; flex-wrap: wrap; gap: 4px; }
    @media (max-width: 640px) {
        #cfk-ar-page .cf-rows table.cf-table td.ar-trigger, #cfk-ar-page .cf-rows table.cf-table td.ar-response { max-width: none; white-space: normal; overflow-wrap: anywhere; }
        #cfk-ar-page .ar-pv { padding: var(--cf-4); }
    }
</style>

<div class="page-section" id="cfk-ar-page" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-robot"></i>
                <span>Auto-responses</span>
            </div>
            <div class="page-section-subtitle">Match modes, limits, cooldowns, and text, embed or reaction replies.</div>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="Auto-responses at a glance">
        <div class="cf-kpi"><dt>Auto-responses</dt><dd class="cf-kpi-value" id="ar-stat-total">-</dd></div>
        <div class="cf-kpi"><dt>Switched on</dt><dd class="cf-kpi-value" id="ar-stat-active">-</dd></div>
        <div class="cf-kpi"><dt>Times triggered</dt><dd class="cf-kpi-value" id="ar-stat-triggers">-</dd></div>
    </dl>

    <form id="ar-create-form" novalidate>
        <section class="cf-section" aria-labelledby="ar-new-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ar-new-title">New auto-response</h2>
                    <p class="cf-section-desc" id="ar-new-desc">A trigger, how it is matched, and what the bot does.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-sm btn-secondary" id="cfk-ar-cancel" hidden>Cancel edit</button>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-autoresponders-trigger_text">Trigger</label>
                        <p class="cf-row-desc">The text that sets it off.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-autoresponders-trigger_text" type="text" name="trigger_text" class="form-control" required maxlength="500" placeholder="hello" data-no-fieldkit>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-autoresponders-match_type">Match</label>
                        <p class="cf-row-desc" id="ar-match-desc">How the trigger is compared with each message.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-autoresponders-match_type" name="match_type" class="form-select" aria-describedby="ar-match-desc">
                            <option value="contains">Message contains it</option>
                            <option value="exact">Whole message is exactly it</option>
                            <option value="starts_with">Message starts with it</option>
                            <option value="ends_with">Message ends with it</option>
                            <option value="wildcard">Wildcard (* any text, ? one character)</option>
                            <option value="regex">Regular expression</option>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label" id="cfk-ar-type-label">Reply with</span>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-segmented" role="group" aria-labelledby="cfk-cfk-ar-type-label" id="cfk-ar-type">
                            <button type="button" data-type="text" aria-pressed="true">Text</button>
                            <button type="button" data-type="embed" aria-pressed="false">Embed</button>
                            <button type="button" data-type="react" aria-pressed="false">Reactions</button>
                        </div>
                    </div>
                </div>
                <div class="cf-row cf-row--stack" data-for-type="text">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-autoresponders-response_text">Reply</label>
                        <p class="cf-row-desc" id="f-autoresponders-response_text-desc">Variables: {user} (mention), {username}, {displayname}, {server}, {channel}, {membercount}, and <code>{#channel-name}</code> for a channel link.</p>
                    </div>
                    <div class="cf-row-control">
                        <textarea id="f-autoresponders-response_text" name="response_text" class="form-control" rows="3" maxlength="2000" placeholder="Welcome, {user}." aria-describedby="f-autoresponders-response_text-desc" data-vars="user,username,displayname,server,channel,membercount"></textarea>
                    </div>
                </div>
                <div class="cf-row cf-row--stack" data-for-type="embed" hidden>
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="ar-embed-title">Title</label>
                            <input type="text" id="ar-embed-title" class="form-control" maxlength="256" placeholder="Welcome" data-vars="user,username,displayname,server,channel,membercount">
                        </div>
                        <div class="cf-field">
                            <label for="cfk-ar-embed-color">Colour</label>
                            <input type="color" id="cfk-ar-embed-color" class="form-control form-control-color ar-color" value="#5865f2">
                        </div>
                    </div>
                    <div class="cf-field">
                        <label for="ar-embed-desc">Description</label>
                        <textarea id="ar-embed-desc" class="form-control" rows="3" maxlength="4096" placeholder="Glad you are here, {displayname}." data-vars="user,username,displayname,server,channel,membercount"></textarea>
                    </div>
                </div>
                <div class="cf-row" data-for-type="react" hidden>
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-ar-reactions">Emoji</label>
                        <p class="cf-row-desc">Separated by spaces, up to 20. Server emoji as <code>name:id</code>. Nothing is posted; the bot reacts to the message.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="text" id="cfk-ar-reactions" class="form-control" maxlength="400" placeholder="Paste emoji here" data-no-fieldkit>
                    </div>
                </div>
                <div class="cf-row cf-row--switch" data-for-type="text embed">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-ar-reply">Reply to the message</label>
                        <p class="cf-row-desc">Sent as a reply to the member's message instead of a plain message.</p>
                    </div>
                    <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="cfk-ar-reply" name="reply_to_user" checked></div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-ar-delete">Delete the trigger message</label>
                        <p class="cf-row-desc">The member's message is removed once the bot has answered.</p>
                    </div>
                    <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="cfk-ar-delete" name="delete_trigger"></div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-ar-case">Case sensitive</label>
                        <p class="cf-row-desc">"Hello" and "hello" count as different.</p>
                    </div>
                    <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="cfk-ar-case" name="case_sensitive"></div>
                </div>

                <details class="cf-expand" id="cfk-ar-cooldown">
                    <summary><span>Cooldown <span class="ar-muted" id="cfk-ar-cooldown-sum">None</span></span></summary>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-autoresponders-cooldown_seconds">Wait before it can fire again</label>
                            <p class="cf-row-desc">Up to 86400 seconds (a day). 0 for none.</p>
                        </div>
                        <div class="cf-row-control">
                            <div class="cf-input-unit">
                                <input id="f-autoresponders-cooldown_seconds" type="number" name="cooldown_seconds" class="form-control" value="0" min="0" max="86400">
                                <span class="cf-unit">seconds</span>
                            </div>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-ar-per-user">Per member</label>
                            <p class="cf-row-desc">Each member has their own cooldown.</p>
                        </div>
                        <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="cfk-ar-per-user" name="cooldown_per_user" checked></div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-ar-per-channel">Per channel</label>
                            <p class="cf-row-desc">Each channel has its own cooldown. With both off, one cooldown covers everyone.</p>
                        </div>
                        <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="cfk-ar-per-channel"></div>
                    </div>
                </details>

                <details class="ar-advanced cf-expand" id="cfk-ar-limits">
                    <summary><span>Channel and role limits <span class="ar-muted" id="cfk-ar-limits-sum">Everyone, every channel</span></span></summary>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-autoresponders-allowed_channels">Only in these channels</label>
                            <p class="cf-row-desc">Leave empty for every channel.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-autoresponders-allowed_channels" name="allowed_channels" class="form-select" multiple>
                                <%- include('../kit/_pick-options', { items: arText, kind: 'text', only: 'text' }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-autoresponders-blocked_channels">Never in these channels</label>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-autoresponders-blocked_channels" name="blocked_channels" class="form-select" multiple>
                                <%- include('../kit/_pick-options', { items: arText, kind: 'text', only: 'text' }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-autoresponders-allowed_roles">Only for these roles</label>
                            <p class="cf-row-desc">Leave empty for everyone.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-autoresponders-allowed_roles" name="allowed_roles" class="form-select" multiple>
                                <%- include('../kit/_pick-options', { items: arRoles, kind: 'role' }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-ar-all-roles">Member needs all of them</label>
                            <p class="cf-row-desc">Off: any one of the roles above is enough.</p>
                        </div>
                        <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="cfk-ar-all-roles"></div>
                    </div>
                    <div class="cf-row cf-row--wide">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-autoresponders-blocked_roles">Never for these roles</label>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-autoresponders-blocked_roles" name="blocked_roles" class="form-select" multiple>
                                <%- include('../kit/_pick-options', { items: arRoles, kind: 'role' }) %>
                            </select>
                        </div>
                    </div>
                </details>

                <div class="ar-pv" aria-live="polite">
                    <span class="ar-pv-label">Preview</span>
                    <span class="ar-pv-trigger" id="cfk-ar-pv-trigger"></span>
                    <div id="cfk-ar-pv"></div>
                </div>

                <div class="cf-section-foot">
                    <span class="cf-foot-note cf-status-line" id="cfk-ar-status" role="status"></span>
                    <button type="submit" class="btn btn-primary" id="cfk-ar-submit">Create</button>
                </div>
            </div>
        </section>
    </form>

    <section class="cf-section" aria-labelledby="ar-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ar-list-title">Auto-responses <span class="ar-count" id="cfk-ar-count"></span></h2>
                <p class="cf-section-desc">Switch one off to keep it without it firing.</p>
            </div>
            <div class="cf-section-actions" id="cfk-ar-search-wrap" hidden>
                <input type="search" id="ar-search" class="form-control ar-search" placeholder="Search triggers and replies" aria-label="Search auto-responses">
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Trigger</th>
                            <th scope="col">Match</th>
                            <th scope="col">Reply</th>
                            <th scope="col">Uses</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody id="ar-table-body"></tbody>
                </table>
            </div>
            <div class="cf-state cf-state--loading" id="cfk-ar-loading" role="status"><span class="cf-spinner" aria-hidden="true"></span><p class="cf-state-title">Loading</p></div>
            <div class="cf-state" id="ar-empty" hidden>
                <p class="cf-state-title">No auto-responses yet</p>
                <p class="cf-state-text">Create one above. Try a trigger like "where do i" with a reply pointing at your FAQ channel.</p>
            </div>
            <div class="cf-state cf-state--compact" id="cfk-ar-nomatch" hidden><p class="cf-state-text">Nothing matches that search.</p></div>
            <div class="cf-state cf-state--error" id="ar-error" role="alert" hidden><p class="cf-state-title">Could not load the auto-responses</p><p class="cf-state-text" id="cfk-ar-error-text"></p></div>
        </div>
    </section>
</div>

<script>
(function () {
    const root = document.getElementById('cfk-ar-page');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    const GUILD_ID = root.dataset.guildId;
    const API = '/api/guilds/' + GUILD_ID + '/autoresponders';
    const SAMPLE = <%- JSON.stringify(arSample).replace(/</g, '\\u003c') %>;
    const BOT_NAME = <%- JSON.stringify(String(arBotName)).replace(/</g, '\\u003c') %>;
    const MATCH_LABELS = { contains: 'contains', exact: 'exact', starts_with: 'starts with', ends_with: 'ends with', wildcard: 'wildcard', regex: 'regex' };
    const toast = (m, k) => (window.showToast ? window.showToast(m, k) : alert(m));
    const $ = (id) => document.getElementById(id);
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };

    const form = $('ar-create-form');
    const tbody = $('ar-table-body');
    const search = $('ar-search');
    const f = (name) => form.querySelector('[name="' + name + '"]');
    let allData = [];
    let editingId = null;
    let type = 'text';

    // ── Reply type ──
    function setType(next) {
        type = ['text', 'embed', 'react'].includes(next) ? next : 'text';
        $('cfk-ar-type').querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.type === type)));
        form.querySelectorAll('[data-for-type]').forEach(row => { row.hidden = !row.dataset.forType.split(' ').includes(type); });
        preview();
    }
    $('cfk-ar-type').addEventListener('click', (e) => { const b = e.target.closest('button[data-type]'); if (b) setType(b.dataset.type); });

    // ── Multi-selects ──
    const selected = (name) => [...f(name).selectedOptions].map(o => o.value);
    function setSelected(name, ids) {
        const want = new Set((ids || []).map(String));
        const s = f(name);
        for (const o of s.options) o.selected = want.has(o.value);
        s.dispatchEvent(new Event('change', { bubbles: true }));
    }
    const parse = (raw) => { if (Array.isArray(raw)) return raw; try { const v = JSON.parse(raw || '[]'); return Array.isArray(v) ? v : []; } catch { return []; } };

    function summaries() {
        const secs = parseInt(f('cooldown_seconds').value, 10) || 0;
        const scope = f('cooldown_per_user').checked ? ($('cfk-ar-per-channel').checked ? 'per member and channel' : 'per member')
            : $('cfk-ar-per-channel').checked ? 'per channel' : 'for everyone';
        $('cfk-ar-cooldown-sum').textContent = secs ? `${secs} s, ${scope}` : 'None';
        const ch = selected('allowed_channels').length, bch = selected('blocked_channels').length;
        const r = selected('allowed_roles').length, br = selected('blocked_roles').length;
        const parts = [];
        parts.push(r ? `${r} role${r === 1 ? '' : 's'}` : 'Everyone');
        if (br) parts.push(`${br} role${br === 1 ? '' : 's'} left out`);
        parts.push(ch ? `${ch} channel${ch === 1 ? '' : 's'}` : 'every channel');
        if (bch) parts.push(`${bch} channel${bch === 1 ? '' : 's'} left out`);
        $('cfk-ar-limits-sum').textContent = parts.join(', ');
    }

    // ── Preview (/js/cf-msgpreview.js) ──
    const vars = {
        user: '@' + 'Kestrel', username: 'kestrel', displayname: 'Kestrel', server: SAMPLE.server,
        channel: '#' + SAMPLE.channel, membercount: String(SAMPLE.members),
    };
    function fillChannels(text) {
        return String(text || '').replace(/\{#([^}]+)\}/g, (all, name) => '#' + name);
    }
    function reactionList() {
        return $('cfk-ar-reactions').value.split(/\s+/).map(s => s.trim()).filter(Boolean).slice(0, 20);
    }
    function preview() {
        const trig = f('trigger_text').value.trim();
        $('cfk-ar-pv-trigger').textContent = trig ? `When someone writes a message that ${MATCH_LABELS[f('match_type').value] === 'exact' ? 'is exactly' : MATCH_LABELS[f('match_type').value]} "${trig}":` : 'Type a trigger to see when this fires.';
        const box = $('cfk-ar-pv');
        if (type === 'react') {
            const list = reactionList();
            const wrap = el('div', 'ar-reacts');
            if (!list.length) wrap.appendChild(el('span', 'ar-muted', 'Add emoji to react with.'));
            list.forEach(e => { const r = el('span', 'ar-react'); r.appendChild(document.createTextNode(e.replace(/^<?a?:?([\w~]+):\d+>?$/, ':$1:'))); r.appendChild(el('span', null, '1')); wrap.appendChild(r); });
            box.replaceChildren(wrap);
            return;
        }
        if (!window.cfDiscordPreview) return;
        const opts = { botName: BOT_NAME, vars, names: { channels: SAMPLE.channels }, emptyText: 'Write a reply to see it here.' };
        if (type === 'embed') {
            opts.embeds = [{ color: $('cfk-ar-embed-color').value, title: fillChannels($('ar-embed-title').value), description: fillChannels($('ar-embed-desc').value) }];
        } else {
            opts.content = fillChannels(f('response_text').value);
        }
        window.cfDiscordPreview.render(box, opts);
    }
    form.addEventListener('input', () => { summaries(); preview(); });
    form.addEventListener('change', () => { summaries(); preview(); });

    // ── Editor ──
    function setStatus(text, kind) {
        const s = $('cfk-ar-status');
        s.textContent = text || '';
        s.className = 'cf-foot-note cf-status-line' + (kind ? ' is-' + kind : '');
    }
    function resetEditor() {
        editingId = null;
        form.reset();
        f('reply_to_user').checked = true;
        f('cooldown_per_user').checked = true;
        $('ar-embed-title').value = ''; $('ar-embed-desc').value = ''; $('cfk-ar-embed-color').value = '#5865f2'; $('cfk-ar-reactions').value = '';
        ['allowed_channels', 'blocked_channels', 'allowed_roles', 'blocked_roles'].forEach(n => setSelected(n, []));
        $('cfk-ar-cooldown').open = false; $('cfk-ar-limits').open = false;
        $('ar-new-title').textContent = 'New auto-response';
        $('ar-new-desc').textContent = 'A trigger, how it is matched, and what the bot does.';
        $('cfk-ar-submit').textContent = 'Create';
        $('cfk-ar-cancel').hidden = true;
        tbody.querySelectorAll('tr.is-editing').forEach(r => r.classList.remove('is-editing'));
        setType('text');
        summaries();
    }
    function startEdit(ar) {
        resetEditor();
        editingId = ar.id;
        f('trigger_text').value = ar.trigger_text || '';
        f('match_type').value = ar.match_type || 'contains';
        f('response_text').value = ar.response_text || '';
        let embed = {};
        try { embed = ar.embed_json ? JSON.parse(ar.embed_json) : {}; } catch { embed = {}; }
        $('ar-embed-title').value = embed.title || '';
        $('ar-embed-desc').value = embed.description || '';
        $('cfk-ar-embed-color').value = Number.isInteger(embed.color) ? '#' + embed.color.toString(16).padStart(6, '0') : '#5865f2';
        $('cfk-ar-reactions').value = parse(ar.reactions).join(' ');
        f('reply_to_user').checked = !!ar.reply_to_user;
        f('delete_trigger').checked = !!ar.delete_trigger;
        f('case_sensitive').checked = !!ar.case_sensitive;
        f('cooldown_seconds').value = ar.cooldown_seconds || 0;
        f('cooldown_per_user').checked = !!ar.cooldown_per_user;
        $('cfk-ar-per-channel').checked = !!ar.cooldown_per_channel;
        $('cfk-ar-all-roles').checked = !!ar.require_all_roles;
        setSelected('allowed_channels', parse(ar.allowed_channels));
        setSelected('blocked_channels', parse(ar.blocked_channels));
        setSelected('allowed_roles', parse(ar.allowed_roles));
        setSelected('blocked_roles', parse(ar.blocked_roles));
        $('cfk-ar-cooldown').open = (ar.cooldown_seconds || 0) > 0;
        $('cfk-ar-limits').open = ['allowed_channels', 'blocked_channels', 'allowed_roles', 'blocked_roles'].some(k => parse(ar[k]).length);
        $('ar-new-title').textContent = 'Edit auto-response';
        $('ar-new-desc').textContent = 'Change it, check the preview, then save.';
        $('cfk-ar-submit').textContent = 'Save changes';
        $('cfk-ar-cancel').hidden = false;
        const row = tbody.querySelector(`tr[data-id="${CSS.escape(String(ar.id))}"]`);
        if (row) row.classList.add('is-editing');
        setType(ar.response_type || 'text');
        summaries();
        setStatus('');
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        f('trigger_text').focus({ preventScroll: true });
    }
    $('cfk-ar-cancel').addEventListener('click', () => { resetEditor(); setStatus(''); preview(); });

    function payload() {
        const hex = $('cfk-ar-embed-color').value;
        return {
            trigger_text: f('trigger_text').value,
            match_type: f('match_type').value,
            response_type: type,
            response_text: f('response_text').value,
            embed_json: type === 'embed' ? JSON.stringify({ title: $('ar-embed-title').value, description: $('ar-embed-desc').value, color: parseInt(hex.slice(1), 16) }) : null,
            reactions: type === 'react' ? reactionList() : null,
            case_sensitive: f('case_sensitive').checked,
            delete_trigger: f('delete_trigger').checked,
            reply_to_user: f('reply_to_user').checked,
            cooldown_seconds: Math.max(0, Math.min(86400, parseInt(f('cooldown_seconds').value, 10) || 0)),
            cooldown_per_user: f('cooldown_per_user').checked,
            cooldown_per_channel: $('cfk-ar-per-channel').checked,
            require_all_roles: $('cfk-ar-all-roles').checked,
            allowed_channels: selected('allowed_channels'),
            blocked_channels: selected('blocked_channels'),
            allowed_roles: selected('allowed_roles'),
            blocked_roles: selected('blocked_roles'),
        };
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = payload();
        if (!data.trigger_text.trim()) { setStatus('Type a trigger first.', 'bad'); f('trigger_text').focus(); return; }
        if (type === 'text' && !data.response_text.trim()) { setStatus('Write the reply first.', 'bad'); f('response_text').focus(); return; }
        if (type === 'embed' && !$('ar-embed-title').value.trim() && !$('ar-embed-desc').value.trim()) { setStatus('Give the embed a title or a description.', 'bad'); return; }
        if (type === 'react' && !data.reactions.length) { setStatus('Add at least one emoji.', 'bad'); $('cfk-ar-reactions').focus(); return; }
        const btn = $('cfk-ar-submit');
        btn.disabled = true;
        setStatus('Saving…', 'busy');
        try {
            const res = await fetch(editingId ? `${API}/${encodeURIComponent(editingId)}` : API, {
                method: editingId ? 'PUT' : 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data),
            });
            const result = await res.json().catch(() => ({}));
            if (!res.ok || !result.success) throw new Error(result.error || `Request failed (${res.status})`);
            const was = editingId;
            resetEditor();
            preview();
            setStatus(was ? 'Saved.' : 'Created.', 'ok');
            load();
        } catch (err) {
            setStatus(err.message, 'bad');
        } finally {
            btn.disabled = false;
        }
    });

    // ── List ──
    function replySummary(ar) {
        if (ar.response_type === 'react') return 'Reacts ' + parse(ar.reactions).join(' ');
        if (ar.response_type === 'embed') {
            try { const e = JSON.parse(ar.embed_json || '{}'); return 'Embed: ' + (e.title || e.description || ''); } catch { return 'Embed'; }
        }
        return ar.response_text || '';
    }
    function render(items) {
        tbody.replaceChildren();
        $('cfk-ar-nomatch').hidden = !!items.length || !allData.length;
        items.forEach((ar) => {
            const tr = el('tr');
            tr.dataset.id = ar.id;
            if (!ar.enabled) tr.classList.add('is-off');
            if (String(ar.id) === String(editingId)) tr.classList.add('is-editing');
            const t = el('td', 'ar-trigger', ar.trigger_text); t.dataset.label = 'Trigger'; t.title = ar.trigger_text;
            const m = el('td'); m.dataset.label = 'Match';
            const pills = el('span', 'ar-pills');
            pills.appendChild(el('span', 'cf-pill', MATCH_LABELS[ar.match_type] || ar.match_type));
            if (!ar.enabled) pills.appendChild(el('span', 'cf-pill is-bad', 'Off'));
            m.appendChild(pills);
            const r = el('td', 'ar-response', replySummary(ar)); r.dataset.label = 'Reply'; r.title = replySummary(ar);
            const u = el('td', 'ar-uses', Number(ar.use_count || 0).toLocaleString('en-US')); u.dataset.label = 'Uses';
            const a = el('td', 'cf-cell-end ar-actions');
            const edit = el('button', 'btn btn-sm btn-secondary', 'Edit'); edit.type = 'button';
            edit.addEventListener('click', () => startEdit(ar));
            const tog = el('button', 'btn btn-sm btn-secondary', ar.enabled ? 'Turn off' : 'Turn on'); tog.type = 'button';
            tog.addEventListener('click', () => toggle(ar.id, tog));
            const del = el('button', 'btn btn-sm btn-danger', 'Delete'); del.type = 'button';
            del.setAttribute('aria-label', 'Delete auto-response ' + ar.trigger_text);
            del.addEventListener('click', () => { if (confirm('Delete the auto-response for "' + ar.trigger_text + '"?')) remove(ar.id); });
            a.append(edit, tog, del);
            tr.append(t, m, r, u, a);
            tbody.appendChild(tr);
        });
    }
    function applySearch() {
        const q = search.value.trim().toLowerCase();
        render(!q ? allData : allData.filter(ar => (ar.trigger_text || '').toLowerCase().includes(q) || replySummary(ar).toLowerCase().includes(q)));
    }
    async function load() {
        try {
            const res = await fetch(API, { credentials: 'same-origin' });
            const data = await res.json();
            if (!res.ok || !data.success) throw new Error(data.error || 'Request failed');
            allData = data.autoresponders || [];
            $('ar-stat-total').textContent = allData.length;
            $('ar-stat-active').textContent = allData.filter(a => a.enabled).length;
            $('ar-stat-triggers').textContent = Number(data.totalTriggers || 0).toLocaleString('en-US');
            $('cfk-ar-count').textContent = allData.length;
            $('cfk-ar-loading').hidden = true;
            $('ar-error').hidden = true;
            $('ar-empty').hidden = allData.length > 0;
            $('cfk-ar-search-wrap').hidden = allData.length <= 15;
            applySearch();
        } catch (err) {
            $('cfk-ar-loading').hidden = true;
            $('ar-error').hidden = false;
            $('cfk-ar-error-text').textContent = err.message + '. Refresh the page to try again.';
        }
    }
    async function toggle(id, btn) {
        btn.disabled = true;
        try {
            const res = await fetch(`${API}/${encodeURIComponent(id)}/toggle`, { method: 'PUT', credentials: 'same-origin' });
            const data = await res.json().catch(() => ({}));
            if (!data.success) throw new Error(data.error || 'Could not change it');
            load();
        } catch (err) { toast(err.message, 'error'); btn.disabled = false; }
    }
    async function remove(id) {
        try {
            const res = await fetch(`${API}/${encodeURIComponent(id)}`, { method: 'DELETE', credentials: 'same-origin' });
            const data = await res.json().catch(() => ({}));
            if (!data.success) throw new Error(data.error || 'Could not delete it');
            if (String(id) === String(editingId)) resetEditor();
            toast('Deleted.', 'success');
            load();
        } catch (err) { toast(err.message, 'error'); }
    }
    search.addEventListener('input', applySearch);

    summaries();
    setType('text');
    load();
})();
</script>
