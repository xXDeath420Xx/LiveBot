<%#
  Suggestions: counts, settings (POST suggestions/config), tags (create / update / delete), the
  filter (GET back to this page) and the suggestion list with its review actions (approve, reject,
  implement, delete, add / remove a tag). Built on the settings-row kit (cf-settings.css); ids,
  field names and routes unchanged.
%>
<%
    // Tags + filters are loaded by the 'suggestions' page loader (dashboard/services/manage-sections.js);
    // without it these fall back to empty so the page still renders.
    const tagList = (typeof suggestionTags !== 'undefined' && Array.isArray(suggestionTags)) ? suggestionTags : [];
    const filters = locals.suggestionFilters || {};
    const curStatus = filters.status || '';
    const curTag = filters.tagId ? String(filters.tagId) : '';
    const curSort = filters.sort || 'newest';
    const tagLabel = (t) => ((t.tag_emoji && t.tag_emoji !== '?️') ? t.tag_emoji + ' ' : '') + t.tag_name;
    const safeColor = (c) => (/^#[0-9a-fA-F]{6}$/.test(c || '') ? c : '#3498db');
    const sgStatus = {
        pending: ['Pending', 'is-warn'], under_review: ['Under review', 'is-info'], approved: ['Approved', 'is-ok'],
        implemented: ['Implemented', 'is-accent'], rejected: ['Rejected', 'is-bad'], duplicate: ['Duplicate', ''],
    };
%>
<style>
    .sg-inline { display: flex; align-items: center; gap: var(--cf-2); flex-wrap: wrap; margin: 0; }
    .sg-inline .form-control, .sg-inline .form-select { width: auto; }
    .sg-input-sm { width: 11rem !important; max-width: 100%; }
    .sg-input-xs { width: 6.5rem !important; }
    .sg-color { width: 38px; height: 34px; padding: 2px; border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius); background: transparent; cursor: pointer; flex: none; }
    .sg-tag-row { display: flex; align-items: center; gap: var(--cf-3); flex-wrap: wrap; }
    .sg-tag-row .sg-count { font-size: var(--cf-text-xs); color: var(--cf-text-3); min-width: 6rem; }
    .sg-tags { margin-bottom: 4px; }
    .sg-tags form { display: inline; margin: 0; }
    .sg-text { white-space: pre-wrap; overflow-wrap: anywhere; color: var(--cf-text); max-width: 32rem; }
    .sg-reply { margin-top: 4px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .sg-votes { display: flex; gap: var(--cf-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .sg-votes .up { color: var(--cf-success); }
    .sg-votes .down { color: var(--cf-danger); }
    .sg-actions { display: flex; gap: var(--cf-2); justify-content: flex-end; flex-wrap: wrap; }
    .sg-actions form { display: inline; margin: 0; }
    .sg-filter-foot { display: flex; align-items: flex-end; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-lightbulb"></i>
                <span>Suggestions</span>
            </div>
<div class="page-section-subtitle">Settings, tags and the suggestion queue.</div>
        </div>
    </div>

    <%- include('../kit/_kpis', { items: [
        { label: 'Pending', value: suggestionStats?.pending || 0 },
        { label: 'Approved', value: suggestionStats?.approved || 0 },
        { label: 'Implemented', value: suggestionStats?.implemented || 0 },
        { label: 'Rejected or duplicate', value: suggestionStats?.rejected || 0 },
    ], label: 'Suggestions at a glance' }) %>

    <form action="/manage/<%= guild.id %>/suggestions/config" method="POST">
        <input type="hidden" name="suggestions_form_v2" value="1">
        <section class="cf-section" aria-labelledby="sg-config-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sg-config-title">Settings</h2>
                    <p class="cf-section-desc">Where suggestions are posted and who reviews them.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="suggestionsEnabled">Suggestions</label>
                        <p class="cf-row-desc" id="suggestionsEnabled-desc">Members can post suggestions with <code>/engage suggest submit</code>.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="suggestionsEnabled" name="enabled" data-feature-switch aria-describedby="suggestionsEnabled-desc" <%= suggestionConfig?.enabled ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-suggestions-suggestion_channel_id">Suggestions channel</label>
                        <p class="cf-row-desc">Where suggestions are posted for voting.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-suggestions-suggestion_channel_id" class="form-select" name="suggestion_channel_id">
                            <%- include('../kit/_pick-options', { items: channels, selected: (suggestionConfig && suggestionConfig.suggestions_channel_id) || null, kind: 'channel', only: 'text', empty: 'Choose a channel' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="allowAnonymous">Anonymous suggestions</label>
                        <p class="cf-row-desc" id="allowAnonymous-desc">Members can set <code>anonymous: True</code> on <code>/engage suggest submit</code> to leave their name off the suggestion.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="allowAnonymous" name="allow_anonymous" aria-describedby="allowAnonymous-desc" <%= suggestionConfig?.allow_anonymous ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="approvalRequired">Require staff approval</label>
                        <p class="cf-row-desc" id="approvalRequired-desc">New suggestions wait for staff. Only approved ones are posted in the suggestions channel for voting.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="approvalRequired" name="approval_required" aria-describedby="approvalRequired-desc" <%= suggestionConfig?.require_approval ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-suggestions-staff_review_channel_id">Staff review channel</label>
                        <p class="cf-row-desc">Each new suggestion is posted here with Approve and Reject buttons. Without one, approve them below or with <code>/engage suggest approve</code>.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-suggestions-staff_review_channel_id" class="form-select" name="staff_review_channel_id">
                            <%- include('../kit/_pick-options', { items: channels, selected: (suggestionConfig && suggestionConfig.staff_review_channel_id) || null, kind: 'channel', only: 'text', empty: 'None' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-suggestions-staff_role_id">Staff role</label>
                        <p class="cf-row-desc">Members with this role can approve, reject and tag suggestions and mark them implemented, as members with Manage Server can.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-suggestions-staff_role_id" class="form-select" name="staff_role_id">
                            <%- include('../kit/_pick-options', { items: roles, selected: (suggestionConfig && suggestionConfig.approved_role_id) || null, kind: 'role', empty: 'None' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <section class="cf-section" aria-labelledby="sg-tags-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="sg-tags-title">Tags</h2>
                <p class="cf-section-desc">Labels such as bug, feature or UI. Staff tag suggestions here or with <code>/engage suggest tag</code>; tags show on the suggestion's message and as matching forum tags. Up to 25 tags, and 5 on one suggestion.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% if (tagList.length > 0) { %>
            <div class="cf-list">
                <% tagList.forEach(tag => { const color = safeColor(tag.tag_color); %>
                <div class="cf-list-item">
                    <div class="cf-list-main sg-tag-row">
                        <span class="cf-chip" style="--cf-chip: <%= color %>"><%= tagLabel(tag) %></span>
                        <span class="sg-count"><%= Number(tag.usage_count || 0) %> suggestion(s)</span>
                    </div>
                    <div class="cf-list-actions sg-inline">
                        <form action="/manage/<%= guild.id %>/suggestions/tags/<%= tag.id %>/update" method="POST" class="sg-inline">
                            <input type="text" name="tag_name" value="<%= tag.tag_name %>" maxlength="50" class="form-control form-control-sm sg-input-sm" aria-label="Tag name">
                            <input type="color" name="tag_color" value="<%= color %>" class="sg-color" aria-label="Tag colour">
                            <input type="text" name="tag_emoji" value="<%= (tag.tag_emoji && tag.tag_emoji !== '?️') ? tag.tag_emoji : '' %>" maxlength="64" placeholder="Emoji" class="form-control form-control-sm sg-input-xs" aria-label="Tag emoji">
                            <button type="submit" class="btn btn-sm btn-secondary">Save</button>
                        </form>
                        <form action="/manage/<%= guild.id %>/suggestions/tags/<%= tag.id %>/delete" method="POST" class="sg-inline">
                            <button type="submit" class="btn btn-sm btn-danger" title="Delete tag" onclick="return confirm('Delete this tag? It is removed from every suggestion that has it.')">Delete</button>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No tags yet', text: 'Add one below.', id: null, boxed: false, compact: true }) %>
            <% } %>
            <div class="cf-rows-head" id="sg-addtag-head">Add a tag</div>
            <div class="cf-row cf-row--stack">
                <form action="/manage/<%= guild.id %>/suggestions/tags/create" method="POST" class="sg-inline">
                    <input type="text" name="tag_name" maxlength="50" required placeholder="Tag name" class="form-control sg-input-sm" aria-label="New tag name">
                    <input type="color" name="tag_color" value="#3498db" class="sg-color" aria-label="New tag colour">
                    <input type="text" name="tag_emoji" maxlength="64" placeholder="Emoji" class="form-control sg-input-xs" aria-label="New tag emoji">
                    <button type="submit" class="btn btn-primary">Add tag</button>
                </form>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="sg-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="sg-list-title">Suggestions</h2>
                <p class="cf-section-desc">Approve or reject pending suggestions, mark approved ones as implemented, and tag them.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form method="GET" action="/manage/<%= guild.id %>">
                <input type="hidden" name="page" value="suggestions">
                <div class="cf-row cf-row--stack">
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="f-suggestions-status">Status</label>
                            <select id="f-suggestions-status" class="form-select" name="status">
                                <% [['', 'All'], ['pending', 'Pending'], ['under_review', 'Under review'], ['approved', 'Approved'], ['implemented', 'Implemented'], ['rejected', 'Rejected'], ['duplicate', 'Duplicate']].forEach(([value, label]) => { %>
                                    <option value="<%= value %>" <%= curStatus === value ? 'selected' : '' %>><%= label %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="cf-field">
                            <label for="f-suggestions-tag">Tag</label>
                            <select id="f-suggestions-tag" class="form-select" name="tag">
                                <option value="">All</option>
                                <% tagList.forEach(tag => { %>
                                    <option value="<%= tag.id %>" <%= curTag === String(tag.id) ? 'selected' : '' %>><%= tagLabel(tag) %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="cf-field">
                            <label for="f-suggestions-sort">Sort by</label>
                            <select id="f-suggestions-sort" class="form-select" name="sort">
                                <% [['newest', 'Newest first'], ['oldest', 'Oldest first'], ['most_voted', 'Most votes']].forEach(([value, label]) => { %>
                                    <option value="<%= value %>" <%= curSort === value ? 'selected' : '' %>><%= label %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="cf-field sg-filter-foot">
                            <button type="submit" class="btn btn-secondary">Filter</button>
                        </div>
                    </div>
                </div>
            </form>

            <% if (suggestions && suggestions.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Suggestion</th>
                            <th scope="col">Author</th>
                            <th scope="col">Status</th>
                            <th scope="col">Tags</th>
                            <th scope="col">Votes</th>
                            <th scope="col">Posted</th>
                            <th scope="col" class="cf-cell-end"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% suggestions.forEach(suggestion => {
                            const sid = suggestion.id ?? suggestion.suggestion_id;
                            const text = suggestion.suggestion_text ?? suggestion.content ?? '';
                            const upvotes = Number(suggestion.upvotes) || 0;
                            const downvotes = Number(suggestion.downvotes) || 0;
                            const rowTags = Array.isArray(suggestion.tags) ? suggestion.tags : [];
                            const assignable = tagList.filter(t => !rowTags.some(rt => String(rt.id) === String(t.id)));
                            const st = sgStatus[suggestion.status];
                        %>
                        <tr>
                            <td data-label="ID" class="cf-cell-muted">#<%= sid %></td>
                            <td data-label="Suggestion">
                                <div class="sg-text"><%= text.substring(0, 160) %><%= text.length > 160 ? '…' : '' %></div>
                                <% if (suggestion.staff_response) { %>
                                    <div class="sg-reply">Staff reply: <%= String(suggestion.staff_response).substring(0, 120) %></div>
                                <% } %>
                            </td>
                            <td data-label="Author">
                                <% if (suggestion.is_anonymous) { %>
                                    <span class="cf-cell-muted">Anonymous</span>
                                <% } else if (suggestion.author_name) { %>
                                    <%- include('_user-cell', { cfUser: null, cfUserId: suggestion.user_id, cfUserName: suggestion.author_name }) %>
                                <% } else { %>
                                    <%- include('_user-cell', { cfUser: null, cfUserId: suggestion.user_id ?? suggestion.author_id, cfUserName: null }) %>
                                <% } %>
                            </td>
                            <td data-label="Status"><% if (st) { %><span class="cf-pill <%= st[1] %>"><%= st[0] %></span><% } %></td>
                            <td data-label="Tags">
                                <div>
                                    <div class="cf-chips sg-tags">
                                        <% rowTags.forEach(tag => { const color = safeColor(tag.tag_color); %>
                                            <form action="/manage/<%= guild.id %>/suggestions/<%= sid %>/tags/<%= tag.id %>/remove" method="POST">
                                                <button type="submit" class="cf-chip" style="--cf-chip: <%= color %>" title="Remove this tag" aria-label="Remove the tag <%= tagLabel(tag) %>">
                                                    <%= tagLabel(tag) %> <i class="fas fa-times" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        <% }); %>
                                    </div>
                                    <% if (assignable.length > 0 && rowTags.length < 5) { %>
                                        <form action="/manage/<%= guild.id %>/suggestions/<%= sid %>/tags" method="POST" class="sg-inline">
                                            <select name="tag_id" class="form-select form-select-sm sg-input-xs" aria-label="Add tag to suggestion <%= sid %>">
                                                <% assignable.forEach(tag => { %>
                                                    <option value="<%= tag.id %>"><%= tagLabel(tag) %></option>
                                                <% }); %>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-secondary" title="Add tag">Add</button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                            <td data-label="Votes">
                                <span class="sg-votes"><span class="up" title="Upvotes">+<%= upvotes %></span><span class="down" title="Downvotes">-<%= downvotes %></span></span>
                            </td>
                            <td data-label="Posted" class="cf-cell-muted"><%= suggestion.created_at ? new Date(suggestion.created_at).toLocaleDateString() : '' %></td>
                            <td class="cf-cell-end">
                                <div class="sg-actions">
                                    <% if (suggestion.status === 'pending' || suggestion.status === 'under_review') { %>
                                        <form action="/manage/<%= guild.id %>/suggestions/approve" method="POST">
                                            <input type="hidden" name="suggestion_id" value="<%= sid %>">
                                            <button type="submit" class="btn btn-sm btn-primary">Approve</button>
                                        </form>
                                        <form action="/manage/<%= guild.id %>/suggestions/reject" method="POST">
                                            <input type="hidden" name="suggestion_id" value="<%= sid %>">
                                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                        </form>
                                    <% } %>
                                    <% if (suggestion.status === 'approved') { %>
                                        <form action="/manage/<%= guild.id %>/suggestions/implement" method="POST">
                                            <input type="hidden" name="suggestion_id" value="<%= sid %>">
                                            <button type="submit" class="btn btn-sm btn-primary">Mark implemented</button>
                                        </form>
                                    <% } %>
                                    <form action="/manage/<%= guild.id %>/suggestions/delete" method="POST">
                                        <input type="hidden" name="suggestion_id" value="<%= sid %>">
                                        <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Delete this suggestion?')">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else if (curStatus || curTag) { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No suggestions match these filters', text: null, id: null, boxed: false, compact: false }) %>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No suggestions yet', text: 'Switch suggestions on and choose a suggestions channel to start collecting them.', id: null, boxed: false, compact: false }) %>
            <% } %>
        </div>
    </section>
</div>
<script>
// The staff review channel only matters while approval is required.
(function () {
    const on = document.getElementById('approvalRequired');
    const sel = document.getElementById('f-suggestions-staff_review_channel_id');
    const row = sel && sel.closest('.cf-row');
    if (!on || !row) return;
    const sync = () => { row.hidden = !on.checked; };
    on.addEventListener('change', sync);
    sync();
})();
</script>
