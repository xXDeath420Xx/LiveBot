<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-history"></i>
                <span>Action Log</span>
            </div>
            <div class="page-section-subtitle">
                Detailed history of all server events and moderation actions
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3" style="margin-bottom: 1.5rem;">
        <div style="background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); border-left: 3px solid var(--accent-purple, #a78bfa); border-radius: 4px 12px 12px 4px;">
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Total Events</div>
            <div id="al-total" style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">-</div>
        </div>
        <div style="background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); border-left: 3px solid var(--accent-blue, #60a5fa); border-radius: 4px 12px 12px 4px;">
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Event Types</div>
            <div id="al-types" style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">-</div>
        </div>
        <div style="background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); border-left: 3px solid var(--accent-green, #23f56b); border-radius: 4px 12px 12px 4px;">
            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Page</div>
            <div id="al-page" style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">-</div>
        </div>
    </div>

    <!-- Filters -->
    <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
        <select id="al-type-filter" class="form-select" style="max-width: 240px; font-size: 0.85rem;">
            <option value="">All Event Types</option>
        </select>
        <input type="text" id="al-user-filter" class="form-control" placeholder="Filter by User ID..." style="max-width: 220px; font-size: 0.85rem;">
        <button onclick="loadAuditLogs(1)" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1rem;">
            <i class="fas fa-search"></i> Filter
        </button>
    </div>

    <!-- Log Table -->
    <div style="overflow-x: auto; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
        <table class="data-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="padding: 0.75rem 1rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;">Event</th>
                    <th style="padding: 0.75rem 1rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;">Action</th>
                    <th style="padding: 0.75rem 1rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;">User</th>
                    <th style="padding: 0.75rem 1rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;">Target</th>
                    <th style="padding: 0.75rem 1rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;">Details</th>
                    <th style="padding: 0.75rem 1rem; font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;">When</th>
                </tr>
            </thead>
            <tbody id="al-body">
                <tr><td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-muted);">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
        <button id="al-prev" onclick="loadAuditLogs(currentPage - 1)" class="btn btn-secondary" style="font-size: 0.8rem;" disabled>
            <i class="fas fa-chevron-left"></i> Previous
        </button>
        <span id="al-page-info" style="font-size: 0.8rem; color: var(--text-muted);"></span>
        <button id="al-next" onclick="loadAuditLogs(currentPage + 1)" class="btn btn-secondary" style="font-size: 0.8rem;">
            Next <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</div>

<script>
(function() {
    var GUILD_ID = '<%= guild.id %>';
    var currentPage = 1;
    var totalPages = 1;
    window.currentPage = currentPage;

    loadAuditLogs(1);

    window.loadAuditLogs = async function(page) {
        if (page < 1) return;
        currentPage = page;
        window.currentPage = page;

        var typeFilter = document.getElementById('al-type-filter').value;
        var userFilter = document.getElementById('al-user-filter').value.trim();

        var url = '/manage/' + GUILD_ID + '/audit-logs?page=' + page + '&limit=50';
        if (typeFilter) url += '&type=' + encodeURIComponent(typeFilter);
        if (userFilter) url += '&user=' + encodeURIComponent(userFilter);

        try {
            var resp = await fetch(url, { credentials: 'include' });
            var data = await resp.json();

            document.getElementById('al-total').textContent = data.total.toLocaleString();
            document.getElementById('al-types').textContent = data.eventTypes.length;
            document.getElementById('al-page').textContent = data.page + '/' + data.totalPages;
            totalPages = data.totalPages;

            // Populate type filter on first load
            var select = document.getElementById('al-type-filter');
            if (select.options.length <= 1 && data.eventTypes.length) {
                data.eventTypes.forEach(function(t) {
                    var opt = document.createElement('option');
                    opt.value = t; opt.textContent = t.replace(/_/g, ' ');
                    select.appendChild(opt);
                });
            }

            renderLogs(data.logs);

            document.getElementById('al-prev').disabled = page <= 1;
            document.getElementById('al-next').disabled = page >= totalPages;
            document.getElementById('al-page-info').textContent = 'Page ' + page + ' of ' + totalPages + ' (' + data.total + ' events)';
        } catch (err) {
            document.getElementById('al-body').textContent = '';
            var tr = document.createElement('tr');
            var td = document.createElement('td');
            td.colSpan = 6;
            td.style.cssText = 'text-align:center;padding:2rem;color:var(--accent-red)';
            td.textContent = 'Error loading logs: ' + err.message;
            tr.appendChild(td);
            document.getElementById('al-body').appendChild(tr);
        }
    };

    var eventColors = {
        'MEMBER_BAN_ADD': '#ef4444', 'MEMBER_BAN_REMOVE': '#23f56b', 'MEMBER_KICK': '#fb923c',
        'MEMBER_ROLES_ADDED': '#a78bfa', 'MEMBER_ROLES_REMOVED': '#f87171',
        'MEMBER_JOIN': '#22d3ee', 'MEMBER_LEAVE': '#6b7280',
        'MESSAGE_DELETE': '#fbbf24', 'MESSAGE_UPDATE': '#60a5fa',
        'CHANNEL_CREATE': '#23f56b', 'CHANNEL_DELETE': '#f87171', 'CHANNEL_UPDATE': '#60a5fa',
        'ROLE_CREATE': '#a78bfa', 'ROLE_DELETE': '#f87171', 'ROLE_UPDATE': '#818cf8'
    };

    function renderLogs(logs) {
        var tbody = document.getElementById('al-body');
        tbody.textContent = '';

        if (!logs.length) {
            var tr = document.createElement('tr');
            var td = document.createElement('td');
            td.colSpan = 6;
            td.style.cssText = 'text-align:center;padding:2rem;color:var(--text-muted)';
            td.textContent = 'No events found';
            tr.appendChild(td);
            tbody.appendChild(tr);
            return;
        }

        logs.forEach(function(log) {
            var tr = document.createElement('tr');
            tr.style.transition = 'background 0.15s';
            tr.onmouseenter = function() { tr.style.background = 'rgba(255,255,255,0.02)'; };
            tr.onmouseleave = function() { tr.style.background = ''; };

            var tdStyle = 'padding:0.6rem 1rem;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.82rem;vertical-align:top;';

            // Event type badge
            var td1 = document.createElement('td');
            td1.style.cssText = tdStyle;
            var badge = document.createElement('span');
            var color = eventColors[log.event_type] || '#6b7280';
            badge.style.cssText = 'background:' + color + '20;color:' + color + ';padding:0.2rem 0.5rem;border-radius:4px;font-size:0.7rem;font-weight:600;white-space:nowrap;';
            badge.textContent = log.event_type.replace(/_/g, ' ');
            td1.appendChild(badge);

            // Action
            var td2 = document.createElement('td');
            td2.style.cssText = tdStyle + 'color:var(--text-primary);font-weight:500;';
            td2.textContent = log.action || '-';

            // User
            var td3 = document.createElement('td');
            td3.style.cssText = tdStyle;
            td3.textContent = log.userName || (log.user_id ? log.user_id.substring(0, 8) + '...' : '-');

            // Target
            var td4 = document.createElement('td');
            td4.style.cssText = tdStyle;
            td4.textContent = log.targetName || (log.target_id ? log.target_id.substring(0, 8) + '...' : '-');

            // Details
            var td5 = document.createElement('td');
            td5.style.cssText = tdStyle + 'color:var(--text-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
            if (log.old_value || log.new_value) {
                td5.textContent = (log.old_value ? 'Old: ' + String(log.old_value).substring(0, 30) : '') + (log.new_value ? ' New: ' + String(log.new_value).substring(0, 30) : '');
            } else if (log.reason) {
                td5.textContent = log.reason;
            } else {
                td5.textContent = '-';
            }
            td5.title = td5.textContent;

            // Timestamp
            var td6 = document.createElement('td');
            td6.style.cssText = tdStyle + 'color:var(--text-muted);white-space:nowrap;';
            var d = new Date(log.timestamp);
            td6.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });

            tr.appendChild(td1);
            tr.appendChild(td2);
            tr.appendChild(td3);
            tr.appendChild(td4);
            tr.appendChild(td5);
            tr.appendChild(td6);
            tbody.appendChild(tr);
        });
    }
})();
</script>
