<%#
  Weather alerts: the on/off switch and check interval (one form, POST weather/config), usage
  numbers, and the member commands. Built on the settings-row kit (cf-settings.css); field names
  and ids are unchanged.
%>
<% const wc = (typeof weatherConfig !== 'undefined' && weatherConfig) ? weatherConfig : {}; %>
<style>
    .wx-cmds .cf-list-main code { font-family: var(--cf-mono); font-size: var(--cf-text-sm); color: var(--cf-text); overflow-wrap: anywhere; }
    .wx-cmds .wx-cmd-desc { display: block; margin-top: 2px; color: var(--cf-text-3); }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-cloud-sun"></i>
                <span>Weather alerts</span>
            </div>
            <div class="page-section-subtitle">Members opt in by saving a US ZIP code with <code>/weather check setlocation</code>.</div>
        </div>
    </div>

    <% if (weatherStats) { %>
    <dl class="cf-kpis" aria-label="Weather alerts at a glance">
        <div class="cf-kpi"><dt>Members with a location</dt><dd class="cf-kpi-value"><%= weatherStats.totalUsers || 0 %></dd></div>
        <%# weather_alerts has one row per National Weather Service alert, for every server together. %>
        <div class="cf-kpi"><dt>Active alerts, all servers</dt><dd class="cf-kpi-value"><%= weatherStats.activeAlerts || 0 %></dd></div>
        <div class="cf-kpi"><dt>New alerts in 24h, all servers</dt><dd class="cf-kpi-value"><%= weatherStats.alertsSent || 0 %></dd></div>
    </dl>
    <% } %>

    <form class="wx-form" action="/manage/<%= guild.id %>/weather/config" method="POST">
        <section class="cf-section" aria-labelledby="wx-config-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="wx-config-title">Alert settings</h2>
                    <p class="cf-section-desc">Alerts come from the US National Weather Service and cover every US ZIP code.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="weatherEnabled">Weather alerts</label>
                        <p class="cf-row-desc" id="weatherEnabled-desc">Members who saved a location get a direct message when a severe weather alert affects their area.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="weatherEnabled" name="enabled" data-feature-switch aria-describedby="weatherEnabled-desc" <%= wc.enabled ? 'checked' : '' %>>
                    </div>
                </div>
                <%# The bot checks every server's saved locations on one timer (index.js starts it at 180 s), so a
                    per-server interval would do nothing; the old field stays as a hidden value for the route. %>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <span class="cf-row-label">How alerts are sent</span>
                        <p class="cf-row-desc" id="f-weather-checkinterval-desc">New alerts are checked every 3 minutes for the ZIP codes members saved. Each alert is sent once, by direct message, to the members it covers; a bot restart does not send it again.</p>
                    </div>
                    <input id="f-weather-checkinterval" type="hidden" name="checkInterval" value="<%= wc.check_interval ? wc.check_interval : 60 %>">
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <section class="cf-section" aria-labelledby="wx-cmds-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="wx-cmds-title">Member commands</h2>
                <p class="cf-section-desc">Members save their own ZIP code; alerts only go to members who have one saved.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-list wx-cmds">
                <div class="cf-list-item"><div class="cf-list-main"><code>/weather check setlocation zipcode:</code><span class="wx-cmd-desc">Save a ZIP code for alerts.</span></div></div>
                <div class="cf-list-item"><div class="cf-list-main"><code>/weather check location</code><span class="wx-cmd-desc">Show the saved location.</span></div></div>
                <div class="cf-list-item"><div class="cf-list-main"><code>/weather check removelocation</code><span class="wx-cmd-desc">Remove the saved location and stop alerts.</span></div></div>
                <div class="cf-list-item"><div class="cf-list-main"><code>/weather check config enabled:</code><span class="wx-cmd-desc">Administrators: the same switch as on this page.</span></div></div>
            </div>
        </div>
    </section>
</div>
