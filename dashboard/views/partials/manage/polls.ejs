<style>
/* Compact Polls Page Styles */
.polls-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
}

.polls-stat-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 10px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.2s ease;
}

.polls-stat-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(167, 139, 250, 0.3);
}

.polls-stat-icon {
    width: 36px;
    height: 36px;
    background: rgba(167, 139, 250, 0.15);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.polls-stat-icon i { font-size: 0.9rem; color: #a78bfa; }
.polls-stat-icon.green { background: rgba(34, 197, 94, 0.15); }
.polls-stat-icon.green i { color: #22c55e; }
.polls-stat-icon.gray { background: rgba(107, 114, 128, 0.15); }
.polls-stat-icon.gray i { color: #9ca3af; }

.polls-stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.polls-stat-value {
    font-size: 1.25rem;
    font-weight: 700;
    color: #a78bfa;
}

/* Section Card */
.polls-section-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
}

.polls-section-header {
    background: rgba(167, 139, 250, 0.08);
    padding: 12px 16px;
    border-bottom: 1px solid rgba(167, 139, 250, 0.15);
    display: flex;
    align-items: center;
    gap: 10px;
}

.polls-section-header i { font-size: 0.9rem; color: #a78bfa; }
.polls-section-header h3 { font-size: 0.9rem; font-weight: 600; color: #ffffff; margin: 0; }

.polls-section-body { padding: 0; }

/* Compact Table Styles */
.polls-table { width: 100%; border-collapse: collapse; }
.polls-table thead { background: rgba(0, 0, 0, 0.2); }

.polls-table th {
    padding: 10px 14px;
    text-align: left;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.polls-table td {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.polls-table tbody tr { transition: background 0.15s; }
.polls-table tbody tr:hover { background: rgba(167, 139, 250, 0.05); }
.polls-table tbody tr:last-child td { border-bottom: none; }

.polls-question { font-weight: 600; color: #ffffff; font-size: 0.85rem; }

.polls-channel {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
}

.polls-channel i { color: #a78bfa; font-size: 0.7rem; }

.polls-date { font-size: 0.7rem; color: rgba(255, 255, 255, 0.5); }

/* Status Badge */
.polls-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
}

.polls-status-badge.active { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
.polls-status-badge.ended { background: rgba(107, 114, 128, 0.15); color: #9ca3af; }

/* Action Buttons */
.polls-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.polls-action-btn.end {
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    color: #fbbf24;
}

.polls-action-btn.end:hover { background: rgba(251, 191, 36, 0.2); }

.polls-action-btn.delete {
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.3);
    color: #f87171;
}

.polls-action-btn.delete:hover { background: rgba(248, 113, 113, 0.2); }

.polls-actions { display: flex; gap: 6px; justify-content: flex-end; }

/* Compact Empty State */
.polls-empty-state { text-align: center; padding: 48px 24px; }
.polls-empty-icon { font-size: 2.5rem; color: rgba(167, 139, 250, 0.3); margin-bottom: 16px; }
.polls-empty-title { font-size: 1.1rem; font-weight: 600; color: rgba(255, 255, 255, 0.9); margin-bottom: 8px; }
.polls-empty-description { font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); margin-bottom: 20px; }

/* Create Button */
.polls-create-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
    border: none;
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.polls-create-btn:hover { box-shadow: 0 4px 16px rgba(124, 58, 237, 0.4); }

/* Compact Modal Styles */
.polls-modal-form-group { margin-bottom: 14px; }

.polls-modal-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 6px;
}

.polls-modal-input,
.polls-modal-select {
    width: 100%;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.85rem;
    transition: all 0.2s;
}

.polls-modal-input:focus,
.polls-modal-select:focus {
    outline: none;
    border-color: rgba(167, 139, 250, 0.5);
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.1);
}

.polls-modal-select option { background: #1a1d21; color: #ffffff; }

.polls-modal-hint {
    display: block;
    margin-top: 4px;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
}

.polls-modal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.polls-options-box {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 12px;
}

.polls-options-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 8px;
}

.polls-checkbox-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
}

.polls-checkbox-wrapper input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }
.polls-checkbox-wrapper label { font-size: 0.75rem; color: rgba(255, 255, 255, 0.7); cursor: pointer; }

@media (max-width: 768px) {
    .polls-stats-grid { grid-template-columns: 1fr; }
    .polls-modal-grid { grid-template-columns: 1fr; }
    .polls-actions { flex-direction: column; }
}
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-poll"></i>
                <span>Polls</span>
            </div>
            <div class="page-section-subtitle">
                Create and manage polls to get feedback from your community
            </div>
        </div>
        <button class="polls-create-btn" data-bs-toggle="modal" data-bs-target="#createPollModal">
            <i class="fas fa-plus"></i>
            Create Poll
        </button>
    </div>

    <!-- Stats Overview -->
    <% if (polls && polls.length > 0) { %>
        <% const activeCount = polls.filter(p => p.is_active).length; const endedCount = polls.filter(p => !p.is_active).length; %>
        <div class="polls-stats-grid">
            <div class="polls-stat-card">
                <div class="polls-stat-icon green"><i class="fas fa-check-circle"></i></div>
                <div>
                    <div class="polls-stat-label">Active</div>
                    <div class="polls-stat-value"><%= activeCount %></div>
                </div>
            </div>
            <div class="polls-stat-card">
                <div class="polls-stat-icon gray"><i class="fas fa-clock"></i></div>
                <div>
                    <div class="polls-stat-label">Ended</div>
                    <div class="polls-stat-value"><%= endedCount %></div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Polls List -->
    <% if (polls && polls.length > 0) { %>
        <div class="polls-section-card">
            <div class="polls-section-header">
                <i class="fas fa-list"></i>
                <h3>All Polls</h3>
            </div>
            <div class="polls-section-body">
                <table class="polls-table">
                    <thead>
                        <tr>
                            <th>Question</th>
                            <th>Channel</th>
                            <th>Ends At</th>
                            <th>Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% polls.forEach(poll => { %>
                            <tr>
                                <td>
                                    <div class="polls-question"><%= poll.question %></div>
                                </td>
                                <td>
                                    <div class="polls-channel">
                                        <i class="fas fa-hashtag"></i>
                                        <%= channels.find(c => c.id === poll.channel_id)?.name || 'Unknown' %>
                                    </div>
                                </td>
                                <td>
                                    <div class="polls-date"><%= new Date(poll.ends_at).toLocaleString() %></div>
                                </td>
                                <td>
                                    <% if (poll.is_active) { %>
                                        <span class="polls-status-badge active">
                                            <i class="fas fa-circle"></i> Active
                                        </span>
                                    <% } else { %>
                                        <span class="polls-status-badge ended">
                                            <i class="fas fa-circle"></i> Ended
                                        </span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="polls-actions">
                                        <% if (poll.is_active) { %>
                                            <form action="/manage/<%= guild.id %>/end-poll" method="POST" style="display: inline;">
                                                <input type="hidden" name="pollId" value="<%= poll.id %>">
                                                <button type="submit" class="polls-action-btn end" onclick="return confirm('End this poll now?');">
                                                    <i class="fas fa-stop"></i> End
                                                </button>
                                            </form>
                                        <% } %>
                                        <form action="/manage/<%= guild.id %>/delete-poll" method="POST" style="display: inline;">
                                            <input type="hidden" name="pollId" value="<%= poll.id %>">
                                            <button type="submit" class="polls-action-btn delete" onclick="return confirm('Delete this poll?');">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } else { %>
        <div class="polls-empty-state">
            <div class="polls-empty-icon">
                <i class="fas fa-poll"></i>
            </div>
            <div class="polls-empty-title">No Polls Yet</div>
            <div class="polls-empty-description">
                Create your first poll to gather feedback from your community
            </div>
            <button class="polls-create-btn" data-bs-toggle="modal" data-bs-target="#createPollModal">
                <i class="fas fa-plus"></i>
                Create First Poll
            </button>
        </div>
    <% } %>
</div>

<!-- Create Poll Modal -->
<div class="modal fade" id="createPollModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Poll</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/manage/<%= guild.id %>/create-poll" method="POST">
                <div class="modal-body">
                    <div class="polls-modal-form-group">
                        <label class="polls-modal-label">Question</label>
                        <input type="text" class="polls-modal-input" name="question" required placeholder="What should we do next?">
                        <span class="polls-modal-hint">The question you want to ask</span>
                    </div>
                    <div class="polls-modal-form-group">
                        <label class="polls-modal-label">Options (comma-separated)</label>
                        <input type="text" class="polls-modal-input" name="options" required placeholder="Option 1, Option 2, Option 3">
                        <span class="polls-modal-hint">Poll options separated by commas</span>
                    </div>
                    <div class="polls-modal-grid">
                        <div class="polls-modal-form-group" style="margin-bottom: 0;">
                            <label class="polls-modal-label">Duration (optional)</label>
                            <input type="text" class="polls-modal-input" name="duration" placeholder="30m, 2h, 1d">
                            <span class="polls-modal-hint">Leave blank for no time limit</span>
                        </div>
                        <div class="polls-modal-form-group" style="margin-bottom: 0;">
                            <label class="polls-modal-label">Channel</label>
                            <select class="polls-modal-select" name="channel_id" required>
                                <option value="">Select...</option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>">#<%= channel.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                    <div class="polls-options-box" style="margin-top: 20px;">
                        <div class="polls-options-title">Poll Options</div>
                        <div class="polls-checkbox-wrapper">
                            <input type="checkbox" id="allow_multiple" name="allow_multiple" value="1">
                            <label for="allow_multiple">Allow multiple choices</label>
                        </div>
                        <div class="polls-checkbox-wrapper">
                            <input type="checkbox" id="anonymous" name="anonymous" value="1">
                            <label for="anonymous">Anonymous voting</label>
                        </div>
                        <div class="polls-checkbox-wrapper">
                            <input type="checkbox" id="allow_write_in" name="allow_write_in" value="1">
                            <label for="allow_write_in">Allow write-in answers</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="polls-create-btn">
                        <i class="fas fa-poll"></i>
                        Start Poll
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
