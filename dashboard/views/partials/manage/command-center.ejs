<%#
  Command center: chat prefixes and access, the command browser, shortcuts (aliases) and custom
  commands. Fully API-driven (/api/guilds/:id/prefix-commands, /custom-commands); needs only
  `guild` in locals. Built on the settings-row kit (cf-settings.css); ids are unchanged.
%>
<style>
    #commandCenter .cc-panel { display: none; }
    #commandCenter .cc-panel.active { display: block; }
    #commandCenter code { font-family: var(--cf-mono); font-size: 0.9em; overflow-wrap: anywhere; }
    #commandCenter .cf-row-desc code { font-size: 0.88em; }
    #commandCenter .cc-muted { font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    #commandCenter .cf-row-control > .cf-notice { margin: 0; }
    #commandCenter .cc-status { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    #commandCenter .cc-status.ok { color: var(--cf-success); }
    #commandCenter .cc-preview-list { font-family: var(--cf-mono); font-size: var(--cf-text-sm); line-height: 2; color: var(--cf-text-2); white-space: pre-wrap; overflow-wrap: anywhere; }
    #commandCenter .cc-preview-list b { font-weight: 600; color: var(--cf-text); }
    #commandCenter .cc-filter { display: flex; flex-wrap: wrap; gap: var(--cf-2); align-items: center; }
    #commandCenter .cc-filter input[type="search"] { flex: 1 1 16rem; min-width: 0; width: auto; }
    #commandCenter .cc-filter select { flex: 0 1 14rem; min-width: 0; width: auto; }
    #commandCenter .cc-browse-list { max-height: 520px; overflow-y: auto; }
    #commandCenter .cc-browse-list:empty { display: none; }
    #commandCenter .cc-cmd { padding-top: var(--cf-2); padding-bottom: var(--cf-2); }
    #commandCenter .cc-cmd code { font-size: var(--cf-text-sm); color: var(--cf-text); min-width: 0; }
    #commandCenter .cc-shortcuts { font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-3); text-align: right; overflow-wrap: anywhere; }
    #commandCenter .cc-arrow { color: var(--cf-text-3); margin: 0 4px; }
    #commandCenter .cc-cmd-settings { flex: none; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    #commandCenter .cc-cmd-settings:hover { color: var(--cf-accent-fg); }
    #commandCenter .cc-list-empty { padding: var(--cf-4) var(--cf-5); font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    #commandCenter .cc-list-desc { margin: 2px 0 0; font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    #commandCenter .cc-template .cf-list-main strong { font-weight: 600; color: var(--cf-text); margin-right: var(--cf-2); }
    #commandCenter .cc-vars { display: flex; flex-wrap: wrap; gap: 6px; }
    #commandCenter .cc-vars:empty { display: none; }
    #commandCenter .cc-var { display: inline-flex; align-items: center; height: 24px; padding: 0 8px; border: 1px solid var(--cf-border); border-radius: var(--cf-radius-sm); background: var(--cf-surface-2); font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-2); cursor: pointer; }
    #commandCenter .cc-var:hover { border-color: var(--cf-accent); color: var(--cf-text); }
    #commandCenter .cc-prefix-hint { font-family: var(--cf-mono); color: var(--cf-accent-fg); }
    #commandCenter #ccNameEcho { font-family: var(--cf-mono); }
    @media (max-width: 640px) {
        #commandCenter .cc-filter input[type="search"], #commandCenter .cc-filter select { flex: 1 1 100%; }
        #commandCenter .cc-shortcuts { text-align: left; }
    }
</style>

<div class="page-section" id="commandCenter" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-terminal"></i>
                <span>Command center</span>
            </div>
            <div class="page-section-subtitle">Every slash command also works from chat. Set your prefixes, browse the commands, add shortcuts and write your own commands.</div>
        </div>
    </div>

    <div class="cf-tabs cc-tabs" role="tablist" aria-label="Command center sections">
        <button type="button" class="cf-tab cc-tab active" data-tab="access" role="tab">Access and prefixes</button>
        <button type="button" class="cf-tab cc-tab" data-tab="browse" role="tab">Browse commands</button>
        <button type="button" class="cf-tab cc-tab" data-tab="aliases" role="tab">Shortcuts</button>
        <button type="button" class="cf-tab cc-tab" data-tab="custom" role="tab">Custom commands</button>
    </div>

    <%# Access and prefixes %>
    <div class="cc-panel active" data-panel="access" role="tabpanel">
        <section class="cf-section" aria-labelledby="cc-access-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cc-access-title">Prefixes and access</h2>
                    <p class="cf-section-desc">How members run commands from chat. Slash commands keep working whatever you choose here.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ccPrefixInput">Prefixes</label>
                        <p class="cf-row-desc" id="ccPrefixInput-desc">Any of these runs a command from chat. A prefix is 1 to 5 symbols (no letters or digits) and only counts when a letter follows it, so <code>...</code>, <code>?? what</code> and <code>$5</code> stay ordinary messages. <code>/</code> always works as well, because some commands can only be typed that way.</p>
                    </div>
                    <div class="cf-row-control">
                        <div id="ccPrefixChips" class="cf-chips"></div>
                        <div class="cf-input-group cc-add">
                            <input type="text" id="ccPrefixInput" class="form-control" maxlength="5" placeholder="Add a prefix, e.g. &gt;" aria-describedby="ccPrefixInput-desc">
                            <button class="btn btn-secondary" id="ccPrefixAdd" type="button">Add prefix</button>
                        </div>
                        <div id="ccPrefixError" class="cf-notice is-bad" role="alert" hidden></div>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ccAllowMention">Respond to @mentions</label>
                        <p class="cf-row-desc" id="ccAllowMention-desc">Members can type <code>@<%= guild.name %> play &lt;url&gt;</code>.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="ccAllowMention" aria-describedby="ccAllowMention-desc">
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ccUniversal">Reach every slash command from chat</label>
                        <p class="cf-row-desc" id="ccUniversal-desc">With this on, <code>!play</code> runs <code>/music play</code>. Turn it off and only the classic prefix commands and the commands typed with <code>/</code> work.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="ccUniversal" aria-describedby="ccUniversal-desc">
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ccEnabled">Prefix commands</label>
                        <p class="cf-row-desc" id="ccEnabled-desc">The main switch for chat commands. Slash commands, and commands typed with <code>/</code> as a message, work either way.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="ccEnabled" aria-describedby="ccEnabled-desc">
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span id="ccAccessStatus" class="cc-status cf-foot-note" role="status" aria-live="polite"></span>
                    <button class="btn btn-primary" id="ccSaveAccess" type="button">Save</button>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="cc-preview-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cc-preview-title">What members can type</h2>
                    <p class="cf-section-desc">Examples with the settings above, before you save.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div id="ccPreview" class="cc-preview-list">Loading…</div>
                </div>
            </div>
        </section>
    </div>

    <%# Browse %>
    <div class="cc-panel" data-panel="browse" role="tabpanel">
        <section class="cf-section" aria-labelledby="cc-browse-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cc-browse-title">Browse commands</h2>
                    <p class="cf-section-desc">Every command members can run from chat, with its arguments and shortcuts.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div class="cc-filter">
                        <label class="visually-hidden" for="ccBrowseSearch">Search commands</label>
                        <input type="search" id="ccBrowseSearch" class="form-control" placeholder="Search commands…" autocomplete="off">
                        <label class="visually-hidden" for="ccBrowseCategory">Category</label>
                        <select id="ccBrowseCategory" class="form-select">
                            <option value="">All categories</option>
                        </select>
                    </div>
                    <div class="cc-muted" id="ccBrowseCount" role="status" aria-live="polite">Loading…</div>
                </div>
                <div id="ccBrowseList" class="cf-list cc-browse-list"></div>
            </div>
        </section>
    </div>

    <%# Shortcuts %>
    <div class="cc-panel" data-panel="aliases" role="tabpanel">
        <section class="cf-section" aria-labelledby="cc-alias-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cc-alias-title">Shortcuts</h2>
                    <p class="cf-section-desc">Point a short word at any command. The target can be a plain name (<code>ping</code>) or a full path (<code>music play</code>).</p>
                </div>
            </header>
            <div class="cf-rows">
                <div id="ccAliasList" class="cf-list"><div class="cc-list-empty">Loading…</div></div>
                <div class="cf-rows-head" id="cc-alias-add-head">Add a shortcut</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="ccAliasName">Shortcut</label>
                            <input type="text" id="ccAliasName" class="form-control" maxlength="30" placeholder="pp">
                        </div>
                        <div class="cf-field">
                            <label for="ccAliasTarget">Command</label>
                            <input type="text" id="ccAliasTarget" class="form-control" list="ccPathList" placeholder="music play">
                            <datalist id="ccPathList"></datalist>
                        </div>
                    </div>
                    <div id="ccAliasError" class="cf-notice is-bad" role="alert" hidden></div>
                </div>
                <div class="cf-section-foot">
                    <button class="btn btn-primary" id="ccAliasAdd" type="button">Add shortcut</button>
                </div>
            </div>
        </section>
    </div>

    <%# Custom commands %>
    <div class="cc-panel" data-panel="custom" role="tabpanel">
        <section class="cf-section" aria-labelledby="cc-templates-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cc-templates-title">Start from a template</h2>
                    <p class="cf-section-desc">Use this creates the command straight away; you can edit it afterwards.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div id="ccTemplates" class="cf-list"><div class="cc-list-empty">Loading…</div></div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="cc-custom-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cc-custom-title">Your commands</h2>
                    <p class="cf-section-desc">Commands you wrote for this server, and the editor to create or change one.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div id="ccCustomList" class="cf-list"><div class="cc-list-empty">Loading…</div></div>
                <div id="ccCustomError" class="cf-notice is-bad" role="alert" hidden></div>
                <form id="ccCustomForm">
                    <div class="cf-rows-head" id="cc-custom-form-head">Create or edit a command</div>
                    <input type="hidden" id="ccCustomId">
                    <div class="cf-row cf-row--stack">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="ccCustomName">Name</label>
                                <input type="text" id="ccCustomName" class="form-control" maxlength="30" placeholder="rules" required aria-describedby="ccCustomName-hint">
                                <span class="cf-field-hint" id="ccCustomName-hint">Members type <span class="cc-prefix-hint"></span><span id="ccNameEcho">rules</span></span>
                            </div>
                            <div class="cf-field">
                                <label for="ccCustomAction">What it does</label>
                                <select id="ccCustomAction" class="form-select">
                                    <option value="reply">Sends a message</option>
                                    <option value="add_role">Gives a role</option>
                                    <option value="remove_role">Removes a role</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="cf-row cf-row--stack" id="ccReplyFields">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="ccCustomResponse">Response</label>
                            <p class="cf-row-desc" id="ccCustomResponse-desc">Select a variable to insert it at the cursor.</p>
                        </div>
                        <div class="cf-row-control">
                            <textarea id="ccCustomResponse" class="form-control" rows="4" maxlength="2000" placeholder="Welcome to {server.name}, {user.mention}." aria-describedby="ccCustomResponse-desc"></textarea>
                            <div class="cc-vars" id="ccVars"></div>
                        </div>
                    </div>
                    <div class="cf-row" id="ccRoleFields" hidden>
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="ccCustomRole">Role ID</label>
                            <p class="cf-row-desc" id="ccCustomRole-desc">In Discord, right-click a role and choose Copy Role ID (needs Developer Mode).</p>
                        </div>
                        <div class="cf-row-control">
                            <input type="text" id="ccCustomRole" class="form-control" placeholder="123456789012345678" aria-describedby="ccCustomRole-desc">
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <span id="ccCustomStatus" class="cc-status cf-foot-note" role="status" aria-live="polite"></span>
                        <button type="button" class="btn btn-secondary" id="ccCustomCancel" hidden>Cancel</button>
                        <button type="submit" class="btn btn-primary" id="ccCustomSave">Create command</button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

<script>
(function () {
  const root = document.getElementById('commandCenter');
  if (!root || root.dataset.init) return;
  root.dataset.init = '1';

  const guildId = root.dataset.guildId;
  const api = (path) => `/api/guilds/${guildId}${path}`;
  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

  async function req(url, options) {
    const res = await fetch(url, {
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      ...options,
    });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
    return body;
  }
  function showError(el, message) {
    if (!message) { el.hidden = true; return; }
    el.textContent = message; el.hidden = false;
  }
  function flash(el, message, ok = true) {
    el.textContent = message; el.className = 'cc-status cf-foot-note' + (ok ? ' ok' : '');
    setTimeout(() => { el.textContent = ''; }, 2500);
  }

  // ── Tabs ──
  root.querySelectorAll('.cc-tab').forEach(tab => tab.addEventListener('click', () => {
    root.querySelectorAll('.cc-tab').forEach(t => t.classList.toggle('active', t === tab));
    root.querySelectorAll('.cc-panel').forEach(p =>
      p.classList.toggle('active', p.dataset.panel === tab.dataset.tab));
  }));

  // ── State ──
  let config = { prefixes: ['!'], allow_mention: true, universal_commands: true, enabled: 1, prefix: '!' };
  let paths = [];

  // ── Access & prefixes ──
  function renderPrefixes() {
    const wrap = $('ccPrefixChips');
    wrap.innerHTML = config.prefixes.map(p =>
      `<span class="cf-chip"><code>${esc(p)}</code><button type="button" class="cf-chip-remove" data-prefix="${esc(p)}" title="Remove" aria-label="Remove ${esc(p)}"><i class="fas fa-times" aria-hidden="true"></i></button></span>`
    ).join('') || '<span class="cc-muted">No prefixes listed: the default ! and / still work.</span>';

    wrap.querySelectorAll('button[data-prefix]').forEach(btn => btn.addEventListener('click', () => {
      // An empty list is saved as "use the defaults" (! ? $ . /), so the last one stays.
      if (config.prefixes.length <= 1) {
        return showError($('ccPrefixError'), 'Keep at least one prefix. To stop prefix commands, turn Prefix commands off below.');
      }
      config.prefixes = config.prefixes.filter(p => p !== btn.dataset.prefix);
      renderPrefixes(); renderPreview();
    }));
  }

  function renderPreview() {
    const p = config.prefixes[0] || '!';
    const rows = [];
    if (config.enabled && config.universal_commands) {
      rows.push(`<b>${esc(p)}play</b> https://…   →  /music play`);
      rows.push(`<b>${esc(p)}cat inventory</b>    →  /cat inventory`);
      rows.push(`<b>${esc(p)}np</b>               →  /music nowplaying`);
    } else if (config.enabled) {
      rows.push(`<b>${esc(p)}ping</b>             →  classic prefix commands only`);
    } else {
      rows.push('Prefix commands are off. Slash commands, and commands typed with / as a message, still work.');
    }
    if (config.allow_mention && config.enabled) rows.push(`<b>@bot play</b> https://…  →  /music play`);
    $('ccPreview').innerHTML = rows.join('<br>');
    document.querySelectorAll('.cc-prefix-hint').forEach(el => el.textContent = p);
  }

  $('ccPrefixAdd').addEventListener('click', () => {
    const input = $('ccPrefixInput');
    const value = input.value.trim();
    showError($('ccPrefixError'), '');
    if (!value) return;
    if (!/^[^\w\s]{1,5}$/.test(value)) {
      return showError($('ccPrefixError'), 'A prefix must be 1 to 5 symbols, with no letters, digits or spaces.');
    }
    if (config.prefixes.includes(value)) return showError($('ccPrefixError'), 'That prefix is already listed.');
    if (config.prefixes.length >= 8) return showError($('ccPrefixError'), 'At most 8 prefixes.');
    config.prefixes.push(value);
    input.value = '';
    renderPrefixes(); renderPreview();
  });
  $('ccPrefixInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); $('ccPrefixAdd').click(); } });

  ['ccAllowMention','ccUniversal','ccEnabled'].forEach(id => $(id).addEventListener('change', () => {
    config.allow_mention = $('ccAllowMention').checked;
    config.universal_commands = $('ccUniversal').checked;
    config.enabled = $('ccEnabled').checked ? 1 : 0;
    renderPreview();
  }));

  $('ccSaveAccess').addEventListener('click', async () => {
    showError($('ccPrefixError'), '');
    try {
      await req(api('/prefix-commands/config'), { method: 'PUT', body: JSON.stringify({
        prefix: config.prefixes[0] || '!',
        prefixes: config.prefixes,
        allow_mention: config.allow_mention,
        universal_commands: config.universal_commands,
        enabled: config.enabled,
      }) });
      flash($('ccAccessStatus'), 'Saved');
    } catch (err) { showError($('ccPrefixError'), err.message); }
  });

  // ── Browse ──
  function renderBrowse() {
    const term = $('ccBrowseSearch').value.trim().toLowerCase();
    const category = $('ccBrowseCategory').value;
    const hits = paths.filter(p =>
      (!category || p.category === category) &&
      (!term || p.path.includes(term) || p.shortcuts.some(s => s.includes(term))));
    const prefix = config.prefixes[0] || '!';

    $('ccBrowseCount').textContent = `${hits.length} of ${paths.length} commands`;
    $('ccBrowseList').innerHTML = hits.slice(0, 400).map(p => {
      const args = p.options.map(o => o.required ? `&lt;${esc(o.name)}&gt;` : `[${esc(o.name)}]`).join(' ');
      const short = p.shortcuts.length ? `${p.shortcuts.map(s => esc(prefix + s)).join(', ')}` : '';
      // Roles, channels, cooldown and replies for this command live in its Commands page drawer.
      const key = p.command + (p.group ? ':' + p.group : (p.sub ? ':' + p.sub : ''));
      return `<div class="cf-list-item cc-cmd">
        <code>${esc(prefix)}${esc(p.path)}${args ? ' ' + args : ''}</code>
        <span class="cc-shortcuts">${short}</span>
        <a class="cc-cmd-settings" href="/manage/${esc(guildId)}?page=commands&amp;cmd=${encodeURIComponent(key)}" aria-label="Settings for ${esc(p.path)}">Settings</a>
      </div>`;
    }).join('') || '<div class="cc-list-empty">No commands match.</div>';
  }
  $('ccBrowseSearch').addEventListener('input', renderBrowse);
  $('ccBrowseCategory').addEventListener('change', renderBrowse);

  // ── Aliases ──
  let aliases = [];
  function renderAliases() {
    const prefix = config.prefixes[0] || '!';
    $('ccAliasList').innerHTML = aliases.map(a => `
      <div class="cf-list-item cc-alias">
        <div class="cf-list-main"><code>${esc(prefix)}${esc(a.alias)}</code><span class="cc-arrow" aria-hidden="true">→</span><code>${esc(a.command_name)}</code></div>
        <div class="cf-list-actions"><button class="btn btn-sm btn-secondary" data-del-alias="${esc(a.alias)}" type="button">Remove</button></div>
      </div>`).join('') || '<div class="cc-list-empty">No shortcuts yet.</div>';

    $('ccAliasList').querySelectorAll('[data-del-alias]').forEach(btn => btn.addEventListener('click', async () => {
      try {
        await req(api(`/prefix-commands/aliases/${encodeURIComponent(btn.dataset.delAlias)}`), { method: 'DELETE' });
        aliases = aliases.filter(a => a.alias !== btn.dataset.delAlias);
        renderAliases();
      } catch (err) { showError($('ccAliasError'), err.message); }
    }));
  }

  $('ccAliasAdd').addEventListener('click', async () => {
    showError($('ccAliasError'), '');
    const alias = $('ccAliasName').value.trim().toLowerCase();
    const target = $('ccAliasTarget').value.trim().toLowerCase();
    if (!alias || !target) return showError($('ccAliasError'), 'Both fields are required.');
    try {
      await req(api('/prefix-commands/aliases'), { method: 'POST', body: JSON.stringify({ alias, command_name: target }) });
      aliases = aliases.filter(a => a.alias !== alias).concat({ alias, command_name: target });
      aliases.sort((a, b) => a.alias.localeCompare(b.alias));
      $('ccAliasName').value = ''; $('ccAliasTarget').value = '';
      renderAliases();
    } catch (err) { showError($('ccAliasError'), err.message); }
  });

  // ── Custom commands ──
  let customs = [], variables = [];

  function renderVars() {
    $('ccVars').innerHTML = variables.map(v =>
      `<span class="cc-var" title="${esc(v.description)}" data-token="${esc(v.token)}">${esc(v.token)}</span>`).join('');
    $('ccVars').querySelectorAll('.cc-var').forEach(el => el.addEventListener('click', () => {
      const box = $('ccCustomResponse');
      const at = box.selectionStart ?? box.value.length;
      box.value = box.value.slice(0, at) + el.dataset.token + box.value.slice(box.selectionEnd ?? at);
      box.focus();
      box.selectionStart = box.selectionEnd = at + el.dataset.token.length;
    }));
  }

  function renderCustoms() {
    const prefix = config.prefixes[0] || '!';
    const label = { reply: 'Sends a message', add_role: 'Gives a role', remove_role: 'Removes a role' };
    $('ccCustomList').innerHTML = customs.map(c => `
      <div class="cf-list-item cc-custom">
        <div class="cf-list-main">
          <code>${esc(prefix)}${esc(c.command_name)}</code>
          <p class="cc-list-desc">${esc(label[c.action_type] || c.action_type)}</p>
        </div>
        <div class="cf-list-actions">
          <button class="btn btn-sm btn-secondary" data-edit="${c.id}" type="button">Edit</button>
          <button class="btn btn-sm btn-danger" data-del="${c.id}" type="button">Delete</button>
        </div>
      </div>`).join('') || '<div class="cc-list-empty">No custom commands yet. Start from a template above, or write one below.</div>';

    $('ccCustomList').querySelectorAll('[data-del]').forEach(btn => btn.addEventListener('click', async () => {
      if (!confirm('Delete this command?')) return;
      try {
        await req(api(`/custom-commands/${btn.dataset.del}`), { method: 'DELETE' });
        customs = customs.filter(c => String(c.id) !== btn.dataset.del);
        renderCustoms();
      } catch (err) { showError($('ccCustomError'), err.message); }
    }));

    $('ccCustomList').querySelectorAll('[data-edit]').forEach(btn => btn.addEventListener('click', () => {
      const c = customs.find(x => String(x.id) === btn.dataset.edit);
      if (!c) return;
      $('ccCustomId').value = c.id;
      $('ccCustomName').value = c.command_name;
      $('ccCustomAction').value = c.action_type;
      $('ccCustomResponse').value = c.response || '';
      $('ccCustomRole').value = c.action_content || '';
      $('ccCustomSave').textContent = 'Save changes';
      $('ccCustomCancel').hidden = false;
      syncActionFields();
      $('ccNameEcho').textContent = c.command_name;
      $('ccCustomForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
  }

  function syncActionFields() {
    const isReply = $('ccCustomAction').value === 'reply';
    $('ccReplyFields').hidden = !isReply;
    $('ccRoleFields').hidden = isReply;
  }
  $('ccCustomAction').addEventListener('change', syncActionFields);
  $('ccCustomName').addEventListener('input', () => { $('ccNameEcho').textContent = $('ccCustomName').value || 'name'; });

  function resetCustomForm() {
    $('ccCustomForm').reset();
    $('ccCustomId').value = '';
    $('ccCustomSave').textContent = 'Create command';
    $('ccCustomCancel').hidden = true;
    $('ccNameEcho').textContent = 'name';
    syncActionFields();
  }
  $('ccCustomCancel').addEventListener('click', resetCustomForm);

  $('ccCustomForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    showError($('ccCustomError'), '');
    const id = $('ccCustomId').value;
    const payload = {
      command_name: $('ccCustomName').value.trim().toLowerCase(),
      action_type: $('ccCustomAction').value,
      response: $('ccCustomResponse').value,
      action_content: $('ccCustomRole').value.trim() || null,
    };
    try {
      await req(api(id ? `/custom-commands/${id}` : '/custom-commands'),
        { method: id ? 'PUT' : 'POST', body: JSON.stringify(payload) });
      flash($('ccCustomStatus'), id ? 'Saved' : 'Created');
      resetCustomForm();
      await loadCustoms();
    } catch (err) { showError($('ccCustomError'), err.message); }
  });

  function renderTemplates(templates) {
    $('ccTemplates').innerHTML = templates.map(t => `
      <div class="cf-list-item cc-template">
        <div class="cf-list-main">
          <strong>${esc(t.name)}</strong><span class="cf-pill">${esc(t.category)}</span>
          <p class="cc-list-desc">${esc(t.description)}</p>
        </div>
        <div class="cf-list-actions"><button class="btn btn-sm btn-secondary" data-tpl="${esc(t.id)}" type="button">Use this</button></div>
      </div>`).join('') || '<div class="cc-list-empty">No templates available.</div>';

    $('ccTemplates').querySelectorAll('[data-tpl]').forEach(btn => btn.addEventListener('click', async () => {
      showError($('ccCustomError'), '');
      const tpl = templates.find(t => t.id === btn.dataset.tpl);
      // Role templates have no role yet — prefill the form instead of saving a broken command.
      if (tpl.needs === 'role') {
        $('ccCustomName').value = tpl.command_name;
        $('ccCustomAction').value = tpl.action_type;
        $('ccNameEcho').textContent = tpl.command_name;
        syncActionFields();
        showError($('ccCustomError'), 'Pick a role for this command, then select Create command.');
        $('ccCustomForm').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      try {
        await req(api(`/custom-commands/templates/${encodeURIComponent(tpl.id)}`), { method: 'POST', body: '{}' });
        flash($('ccCustomStatus'), `Created ${tpl.command_name}`);
        await loadCustoms();
      } catch (err) { showError($('ccCustomError'), err.message); }
    }));
  }

  async function loadCustoms() {
    const data = await req(api('/custom-commands'));
    customs = data.commands || [];
    variables = data.variables || variables;
    renderCustoms(); renderVars();
  }

  // ── Boot ──
  (async function init() {
    try {
      const cfg = await req(api('/prefix-commands/config'));
      config = { ...config, ...cfg.config };
      if (!Array.isArray(config.prefixes) || !config.prefixes.length) config.prefixes = [config.prefix || '!'];
      aliases = cfg.aliases || [];
      $('ccAllowMention').checked = !!config.allow_mention;
      $('ccUniversal').checked = !!config.universal_commands;
      $('ccEnabled').checked = !!config.enabled;
      renderPrefixes(); renderPreview(); renderAliases();
    } catch (err) {
      showError($('ccPrefixError'), err.message);
      $('ccPreview').className = 'cc-muted';
      $('ccPreview').textContent = 'The prefix settings could not be loaded.';
      $('ccAliasList').innerHTML = '<div class="cc-list-empty">Shortcuts could not be loaded.</div>';
    }

    try {
      const data = await req(api('/prefix-commands/slash-commands'));
      paths = data.commands || [];
      $('ccBrowseCategory').insertAdjacentHTML('beforeend',
        (data.categories || []).map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join(''));
      $('ccPathList').innerHTML = paths.slice(0, 1200).map(p => `<option value="${esc(p.path)}">`).join('');
      renderBrowse();
    } catch (err) { $('ccBrowseCount').textContent = err.message; }

    try {
      const t = await req(api('/custom-commands/templates'));
      variables = t.variables || [];
      renderTemplates(t.templates || []);
      await loadCustoms();
    } catch (err) {
      showError($('ccCustomError'), err.message);
      if (!customs.length) $('ccCustomList').innerHTML = '<div class="cc-list-empty">Custom commands could not be loaded.</div>';
      if ($('ccTemplates').querySelector('.cc-list-empty')) $('ccTemplates').innerHTML = '<div class="cc-list-empty">Templates could not be loaded.</div>';
    }

    syncActionFields();
  })();
})();
</script>
