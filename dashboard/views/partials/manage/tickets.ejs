#cfk-tk-detail dd { margin: 0; color: var(--cf-text); overflow-wrap: anywhere; white-space: pre-wrap; }
#cfk-tk-detail dd a { color: var(--cf-accent); }
#cfk-tk-detail .tk-d-pad { padding: var(--cf-3) var(--cf-4); display: grid; gap: var(--cf-2); }
#cfk-tk-detail .tk-d-label { font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
#cfk-tk-detail .tk-d-label:not(:first-child) { margin-top: var(--cf-2); }
#cfk-tk-detail .tk-d-hint { margin: 0; font-size: var(--cf-text-xs); font-weight: 400; color: var(--cf-text-3); }
#cfk-tk-detail a.tk-d-hint { color: var(--cf-accent); margin-left: 8px; }
#cfk-tk-detail .tk-d-closebtn { justify-self: start; }
