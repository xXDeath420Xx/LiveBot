#cfk-tk-detail .tk-d-msg:last-child, #cfk-tk-detail .tk-d-note:last-child { border-bottom: 0; }
#cfk-tk-detail .tk-d-avatar { width: 28px; height: 28px; border-radius: 50%; flex: none; background: var(--cf-surface-3); object-fit: cover; }
#cfk-tk-detail .tk-d-msgbody { min-width: 0; flex: 1 1 auto; }
#cfk-tk-detail .tk-d-who { font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text); }
#cfk-tk-detail .tk-d-when { margin-left: 6px; font-size: var(--cf-text-xs); font-weight: 400; color: var(--cf-text-3); }
#cfk-tk-detail .tk-d-text { margin: 2px 0 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); white-space: pre-wrap; overflow-wrap: anywhere; }
#cfk-tk-detail .tk-d-embed { margin: 4px 0 0; padding-left: 8px; border-left: 3px solid var(--cf-border-strong); font-size: var(--cf-text-xs); color: var(--cf-text-3); white-space: pre-wrap; overflow-wrap: anywhere; }
#cfk-tk-detail .tk-d-files { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: var(--cf-text-xs); }
