}
</style>

<script>
(function () {
    const root = document.getElementById('cfk-tk-page');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    const GUILD_ID = root.dataset.guildId;
    const base = `/manage/${GUILD_ID}/ticket-panels`;
    const toast = (msg, kind) => (window.showToast ? window.showToast(msg, kind) : alert(msg));
    const $ = (id) => document.getElementById(id);
    const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };

    async function call(url, method, body) {
        const res = await fetch(url, {
            method, credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            body: body ? JSON.stringify(body) : undefined,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) throw new Error(data.error || `Request failed (${res.status})`);
        return data;
    }

    // ── Templates (wording only; the admin picks channel, category and role) ──
    const TEMPLATES = [
        { name: 'General support', colour: '#5865F2', title: 'Need help?', button: 'Open a ticket', format: 'support-{username}',
          desc: 'Press the button below to open a private ticket. Tell us what you need and a member of staff will answer here.',
          blurb: 'One button for every question.' },
        { name: 'Report a member', colour: '#ED4245', title: 'Report a member', button: 'Make a report', format: 'report-{number}',
          desc: 'Seen someone breaking the rules? Open a report with their username, what happened and any message links or screenshots. Only staff can see it.',
          blurb: 'Private reports with evidence.' },
        { name: 'Appeals', colour: '#F0B232', title: 'Appeal a mute or warning', button: 'Start an appeal', format: 'appeal-{username}',
          desc: 'Think a mute or warning was a mistake? Open an appeal, tell us what happened and why it should be looked at again.',
          blurb: 'Members ask staff to review a punishment.' },
        { name: 'Staff applications', colour: '#EB459E', title: 'Apply for staff', button: 'Apply', format: 'apply-{username}',
          desc: 'Want to help run the server? Open an application and a member of the team will ask you a few questions. Attach a form to ask them up front.',
          blurb: 'Pairs well with an intake form.' },
        { name: 'Partnerships', colour: '#57F287', title: 'Partner with us', button: 'Request a partnership', format: 'partner-{username}',
          desc: 'Run a community or project you would like to partner with us? Open a request and tell us about it, your member count and what you have in mind.',
          blurb: 'For server and creator partnerships.' },
        { name: 'Bug reports', colour: '#FEE75C', title: 'Report a bug', button: 'Report a bug', format: 'bug-{number}',
          desc: 'Found something broken? Open a ticket with what you did, what you expected to happen and what happened instead.',
          blurb: 'Structured reports for a game, bot or app.' },
    ];
    $('cfk-tk-templates').replaceChildren(...TEMPLATES.map((t) => {
        const b = el('button', 'tk-tpl');
        b.type = 'button';
        b.style.setProperty('--tk-tpl', t.colour);
        b.appendChild(el('span', 'tk-tpl-name', t.name));
        b.appendChild(el('span', 'tk-tpl-desc', t.blurb));
        b.addEventListener('click', () => openPanel(null, {
            panel_name: t.name, embed_title: t.title, embed_description: t.desc, embed_color: t.colour,
            button_text: t.button, ticket_name_format: t.format,
        }));
        return b;
    }));

    // ── Panel dialog with live preview ──
    const modal = $('panelModal');
    const form = $('panelForm');
    const FIELDS = ['panel_name', 'panel_channel_id', 'embed_title', 'embed_description', 'embed_color', 'button_text', 'button_emoji',
        'ticket_category_id', 'support_role_id', 'ticket_name_format', 'log_channel_id', 'alert_channel_id'];
    const DEFAULTS = {
        embed_title: 'Support Ticket', embed_color: '#a78bfa', button_text: 'Create Ticket', ticket_name_format: 'ticket-{username}',
        embed_description: 'Click the button below to create a support ticket. Our team will assist you shortly!',
    };
    let editingId = null;
    let lastFocus = null;

    function preview() {
        const colour = /^#[0-9a-f]{6}$/i.test($('embed_color').value) ? $('embed_color').value : '#a78bfa';
        $('cfk-tk-pv-embed').style.setProperty('--tk-embed', colour);
        $('cfk-tk-pv-title').textContent = $('embed_title').value.trim() || 'Support Ticket';
        $('cfk-tk-pv-desc').textContent = $('embed_description').value.trim() || DEFAULTS.embed_description;
        const btn = $('cfk-tk-pv-btn');
        btn.replaceChildren();
        const emoji = $('button_emoji').value.trim();
        if (emoji) btn.appendChild(el('span', null, emoji));
        btn.appendChild(document.createTextNode($('button_text').value.trim() || 'Create Ticket'));
        const fmt = $('ticket_name_format').value.trim() || DEFAULTS.ticket_name_format;
        const sample = fmt.replace(/\{(username|user)\}/gi, 'kestrel').replace(/\{number\}/gi, '42').replace(/\{id\}/gi, '311298654338383873')
            .replace(/\{[^{}]*\}/g, '').toLowerCase().replace(/[^a-z0-9_-]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 100);
        $('cfk-tk-pv-name').replaceChildren(document.createTextNode('A ticket opens as '), el('code', null, '#' + (sample || 'ticket-kestrel')));
    }
    form.addEventListener('input', preview);
    form.addEventListener('change', preview);

    function openPanel(panel, prefill) {
        editingId = panel ? panel.panel_id : null;
        $('panelModalTitle').textContent = panel ? 'Edit ticket panel' : 'Create a ticket panel';
        const src = Object.assign({}, DEFAULTS, prefill || {}, panel || {});
        for (const key of FIELDS) $(key).value = src[key] == null ? '' : src[key];
        if (!/^#[0-9a-f]{6}$/i.test($('embed_color').value)) $('embed_color').value = DEFAULTS.embed_color;
        $('save_transcripts').checked = !(panel && panel.save_transcripts === 0);
        $('cfk-tk-form-status').textContent = '';
        preview();
        lastFocus = document.activeElement;
        modal.hidden = false;
        $('panel_name').focus();
    }
    function closePanel() {
        modal.hidden = true;
        editingId = null;
        if (lastFocus && document.body.contains(lastFocus)) lastFocus.focus();
    }
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closePanel(); });

    async function savePanel() {
        const status = $('cfk-tk-form-status');
        const missing = [['panel_name', 'a panel name'], ['ticket_category_id', 'a ticket category'], ['support_role_id', 'a support role']]
            .filter(([id]) => !$(id).value.trim()).map(([, label]) => label);
        if (missing.length) {
            status.className = 'cf-foot-note cf-status-line is-bad';
            status.textContent = 'Choose ' + missing.join(', ') + '.';
            return;
        }
        const body = {};
        for (const key of FIELDS) body[key] = $(key).value.trim() || null;
        body.panel_name = $('panel_name').value.trim();
        body.save_transcripts = $('save_transcripts').checked;
        const btn = $('cfk-tk-save');
        btn.disabled = true;
        status.className = 'cf-foot-note cf-status-line is-busy';
        status.textContent = 'Saving…';
        try {
            await call(editingId ? `${base}/${editingId}` : base, editingId ? 'PATCH' : 'POST', body);
            status.className = 'cf-foot-note cf-status-line is-ok';
            status.textContent = 'Saved.';
            location.reload();
        } catch (err) {
            status.className = 'cf-foot-note cf-status-line is-bad';
            status.textContent = err.message;
            btn.disabled = false;
        }
    }

    // ── Panel actions (called from the buttons' onclick) ──
    window.openCreatePanelModal = () => openPanel(null, null);
    window.closePanelModal = closePanel;
    window.savePanelForm = savePanel;
    window.editPanel = async (panelId) => {
        try {
            const data = await call(`${base}/${encodeURIComponent(panelId)}`, 'GET');
            openPanel(data.panel, null);
        } catch (err) { toast(err.message || 'Could not load the panel.', 'error'); }
    };
    window.deployPanel = async (panelId, btn) => {
        if (!confirm('Post this panel to its channel? If it was posted before, the old message is replaced.')) return;
        if (btn) btn.disabled = true;
        try {
            await call(`${base}/${encodeURIComponent(panelId)}/deploy`, 'POST');
            toast('Panel posted.', 'success');
            location.reload();
        } catch (err) { toast(err.message, 'error'); if (btn) btn.disabled = false; }
    };
    window.deletePanel = async (panelId, btn) => {
        if (!confirm('Delete this panel? Its message is removed from Discord too. This cannot be undone.')) return;
        if (btn) btn.disabled = true;
        try {
            await call(`${base}/${encodeURIComponent(panelId)}`, 'DELETE');
            toast('Panel deleted.', 'success');
            location.reload();
        } catch (err) { toast(err.message, 'error'); if (btn) btn.disabled = false; }
    };

    // ── Inline replies to tickets and modmail ──
    root.querySelectorAll('form.tk-reply').forEach((replyForm) => {
        replyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const input = replyForm.querySelector('input[name="content"]');
            const btn = replyForm.querySelector('button');
            const status = replyForm.parentElement.querySelector('.tk-reply-status');
            const content = (input.value || '').trim();
            if (!content) return;
            btn.disabled = true;
            status.className = 'cf-status-line tk-reply-status is-busy';
            status.textContent = 'Sending…';
            try {
                const res = await fetch(replyForm.dataset.endpoint, {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.ok) throw new Error(data.error || `Request failed (${res.status})`);
                input.value = '';
                status.className = 'cf-status-line tk-reply-status is-ok';
                status.textContent = 'Sent.';
            } catch (err) {
                status.className = 'cf-status-line tk-reply-status is-bad';
                status.textContent = 'Not sent: ' + err.message;
            } finally {
                btn.disabled = false;
            }
        });
    });

    // ── Search (shown when there are more than 15 open tickets) ──
    root.querySelectorAll('[data-tk-filter]').forEach((input) => {
        const list = $(input.dataset.tkFilter);
        const none = root.querySelector(`[data-tk-nomatch="${input.dataset.tkFilter}"]`);
        input.addEventListener('input', () => {
            const q = input.value.trim().toLowerCase();
            let shown = 0;
            for (const item of list.children) {
                const hit = !q || (item.dataset.search || '').includes(q);
                item.hidden = !hit;
                if (hit) shown++;
            }
            if (none) none.hidden = shown > 0;
        });
    });

    // ── Ticket details dialog (JSON API: /api/guilds/:id/tickets) ──
    const api = `/api/guilds/${GUILD_ID}/tickets`;
    const dlg = $('cfk-tk-detail');
    const dStatus = $('cfk-tk-d-status');
    let current = null;      // { id, data }
    let dlgFocus = null;
    let dirty = false;       // something changed: reload the page when the dialog closes
    const when = (s) => {
        if (!s) return '';
        const d = new Date(s);
        return Number.isNaN(d.getTime()) ? '' : d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    };
    const nameOf = (p) => (p ? (p.name || p.username || p.id) : '');
    const setLine = (node, text, kind) => { node.className = 'cf-status-line' + (kind ? ' is-' + kind : ''); node.textContent = text || ''; };
    const pill = (text, kind) => el('span', 'cf-pill' + (kind ? ' is-' + kind : ''), text);
    function avatarOf(p) {
        if (p && p.avatar) { const img = el('img', 'tk-d-avatar'); img.src = p.avatar; img.alt = ''; img.loading = 'lazy'; return img; }
        const span = el('span', 'tk-d-avatar'); span.setAttribute('aria-hidden', 'true'); return span;
    }
    function fact(dl, label, value) {
        if (value == null || value === '') return;
        dl.appendChild(el('dt', null, label));
        const dd = el('dd');
        if (value instanceof Node) dd.appendChild(value); else dd.textContent = String(value);
        dl.appendChild(dd);
    }
    function personNode(p, extra) {
        if (!p) return null;
        const frag = document.createDocumentFragment();
        frag.appendChild(document.createTextNode(nameOf(p)));
        if (p.id && p.id !== '0' && !p.in_server) frag.appendChild(document.createTextNode(' (not in the server)'));
        if (extra) frag.appendChild(document.createTextNode(extra));
        return frag;
    }

    function renderMessages(data) {
        const box = $('cfk-tk-d-msgs');
        box.replaceChildren();
        const head = $('cfk-tk-d-msghead');
        const viewer = $('cfk-tk-d-viewer');
        viewer.hidden = !data.transcript_viewer;
        if (data.transcript_viewer) viewer.href = data.transcript_viewer;
        head.textContent = data.messages_source === 'live' ? 'Conversation (latest 100 messages)'
            : data.messages_source === 'transcript' ? 'Saved transcript' : 'Conversation';
        if (data.truncated_notice) box.appendChild(el('p', 'tk-d-empty', data.truncated_notice));
        if (!data.messages.length) {
            box.appendChild(el('p', 'tk-d-empty', data.messages_source === 'none'
                ? (data.ticket.status === 'closed' ? 'No transcript was saved for this ticket.' : 'The ticket channel could not be read. It may have been deleted.')
                : 'No messages yet.'));
            return;
        }
        for (const m of data.messages) {
            const row = el('div', 'tk-d-msg');
            row.appendChild(avatarOf({ avatar: m.author_avatar }));
            const body = el('div', 'tk-d-msgbody');
            const who = el('div', 'tk-d-who', m.author_name || 'Unknown');
            if (m.kind === 'bot') who.appendChild(document.createTextNode(' (bot)'));
            else if (m.kind === 'staff') who.appendChild(document.createTextNode(' (staff)'));
            who.appendChild(el('span', 'tk-d-when', when(m.timestamp)));
            body.appendChild(who);
            if (m.content) body.appendChild(el('p', 'tk-d-text', m.content));
            for (const e of m.embeds || []) body.appendChild(el('p', 'tk-d-embed', [e.title, e.description].filter(Boolean).join('\n')));
            if (m.attachments && m.attachments.length) {
                const files = el('p', 'tk-d-files');
                for (const a of m.attachments) {
                    if (!/^https:\/\//i.test(a.url || '')) continue;
                    const link = el('a', null, a.name || 'file');
                    link.href = a.url; link.target = '_blank'; link.rel = 'noopener noreferrer';
                    files.appendChild(link);
                }
                if (files.childNodes.length) body.appendChild(files);
            }
            row.appendChild(body);
            box.appendChild(row);
        }
        box.scrollTop = box.scrollHeight;
    }

    function renderFacts(data) {
        const t = data.ticket;
        const dl = $('cfk-tk-d-facts');
        dl.replaceChildren();
        fact(dl, 'Status', t.status === 'open' ? pill('Open', 'info') : pill('Closed'));
        fact(dl, 'Opened by', personNode(data.opener) || 'Unknown');
        fact(dl, 'Opened', when(t.created_at));
        fact(dl, 'Assigned to', personNode(data.assignee) || 'Nobody');
        if (t.panel) fact(dl, 'Panel', t.panel.name);
        if (t.status === 'open') {
            if (t.channel.exists) {
                const a = el('a', null, '#' + (t.channel.name || 'ticket'));
                a.href = `https://discord.com/channels/${GUILD_ID}/${t.channel.id}`; a.target = '_blank'; a.rel = 'noopener';
                fact(dl, 'Channel', a);
            } else fact(dl, 'Channel', 'Deleted');
            fact(dl, 'Member wrote', when(t.last_user_reply_at));
            fact(dl, 'Staff replied', when(t.last_staff_reply_at));
        } else {
            fact(dl, 'Closed', when(t.closed_at));
            fact(dl, 'Closed by', personNode(data.closed_by));
        }
        const form = $('cfk-tk-d-form');
        form.replaceChildren();
        for (const q of t.form || []) { form.appendChild(el('dt', null, q.question)); form.appendChild(el('dd', null, q.answer || '(no answer)')); }
        $('cfk-tk-d-formwrap').hidden = !(t.form && t.form.length);
    }

    function noteNode(n) {
        const row = el('div', 'tk-d-note');
        const who = el('div', 'tk-d-who', nameOf(n.author) || 'Staff');
        who.appendChild(el('span', 'tk-d-when', when(n.created_at)));
        row.appendChild(who);
        row.appendChild(el('p', 'tk-d-text', n.note));
        return row;
    }
    function renderNotes(notes) {
        const box = $('cfk-tk-d-notes');
        box.replaceChildren(...(notes.length ? notes.map(noteNode) : [el('p', 'tk-d-empty', 'No notes yet.')]));
    }

    function renderActions(data) {
        const open = data.ticket.status === 'open';
        $('cfk-tk-d-actions').hidden = !open;
        if (!open) return;
        const sel = $('cfk-tk-d-staff');
        const nobody = el('option', null, 'Nobody');
        nobody.value = '';
        sel.replaceChildren(nobody, ...data.staff.map((s) => {
            const o = el('option', null, s.username && s.username !== s.name ? `${s.name} (@${s.username})` : s.name);
            o.value = s.id;
            return o;
        }));
        sel.value = data.assignee ? data.assignee.id : '';
        const role = data.ticket.support_role;
        $('cfk-tk-d-staffhint').textContent = role && role.name
            ? `Members with @${role.name}. Whoever you choose is pinged in the ticket.`
            : 'No support role is set for this ticket, so only the current assignee can be listed.';
        $('cfk-tk-d-reason').value = '';
        $('cfk-tk-d-assign').disabled = false;
        $('cfk-tk-d-close').disabled = false;
    }

    function render(data) {
        const t = data.ticket;
        $('cfk-tk-d-title').textContent = `Ticket #${t.number ?? t.id}: ${t.subject}`;
        $('cfk-tk-d-sub').textContent = data.opener ? `Opened by ${nameOf(data.opener)} on ${when(t.created_at)}` : '';
        renderFacts(data);
        renderMessages(data);
        renderNotes(data.notes || []);
        renderActions(data);
    }

    async function loadTicket(id) {
        setLine(dStatus, 'Loading…', 'busy');
        try {
            const data = await call(`${api}/${encodeURIComponent(id)}`, 'GET');
            if (!current || current.id !== id) return;
            current.data = data;
            render(data);
            setLine(dStatus, '');
            $('cfk-tk-d-body').hidden = false;
        } catch (err) {
            if (current && current.id === id) setLine(dStatus, err.message || 'Could not load the ticket.', 'bad');
        }
    }

    function openTicket(id) {
        current = { id, data: null };
        dlgFocus = document.activeElement;
        $('cfk-tk-d-title').textContent = 'Ticket';
        $('cfk-tk-d-sub').textContent = '';
        $('cfk-tk-d-body').hidden = true;
        $('cfk-tk-d-note').value = '';
        dlg.hidden = false;
        dlg.querySelector('.cf-modal-close').focus();
        loadTicket(id);
    }
    function closeDetails() {
        if (dlg.hidden) return;
        dlg.hidden = true;
        current = null;
        if (dirty) { location.reload(); return; }
        if (dlgFocus && document.body.contains(dlgFocus)) dlgFocus.focus();
    }
    dlg.querySelectorAll('[data-tk-close]').forEach((n) => n.addEventListener('click', closeDetails));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !dlg.hidden) closeDetails(); });
    document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-tk-view]');
        if (btn && root.contains(btn)) openTicket(Number(btn.dataset.tkView));
    });

    $('cfk-tk-d-noteform').addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!current) return;
        const box = $('cfk-tk-d-note');
        const note = box.value.trim();
        if (!note) return;
        const btn = e.currentTarget.querySelector('button');
        btn.disabled = true;
        try {
            const res = await call(`${api}/${encodeURIComponent(current.id)}/notes`, 'POST', { note });
            const notes = (current.data && current.data.notes) || [];
            notes.push(res.note);
            if (current.data) current.data.notes = notes;
            renderNotes(notes);
            box.value = '';
            setLine(dStatus, 'Note added.', 'ok');
        } catch (err) {
            setLine(dStatus, err.message, 'bad');
        } finally { btn.disabled = false; }
    });

    $('cfk-tk-d-assign').addEventListener('click', async () => {
        if (!current) return;
        const btn = $('cfk-tk-d-assign');
        const staffId = $('cfk-tk-d-staff').value;
        btn.disabled = true;
        setLine(dStatus, 'Saving…', 'busy');
        try {
            const res = await call(`${api}/${encodeURIComponent(current.id)}/assign`, 'POST', { staff_id: staffId || null });
            if (res.changed) dirty = true;
            setLine(dStatus, !res.changed ? 'No change.' : staffId ? 'Assigned. They were pinged in the ticket.' : 'Unassigned.', 'ok');
            const id = current.id;
            await loadTicket(id);
        } catch (err) {
            setLine(dStatus, err.message, 'bad');
        } finally { btn.disabled = false; }
    });

    $('cfk-tk-d-close').addEventListener('click', async () => {
        if (!current) return;
        if (!confirm('Close this ticket? The channel is deleted after the transcript is saved. This cannot be undone.')) return;
        const btn = $('cfk-tk-d-close');
        btn.disabled = true;
        $('cfk-tk-d-assign').disabled = true;
        setLine(dStatus, 'Closing…', 'busy');
        try {
            const res = await call(`${api}/${encodeURIComponent(current.id)}/close`, 'POST', { reason: $('cfk-tk-d-reason').value.trim() });
            dirty = true;
            setLine(dStatus, res.message || 'Closed.', 'ok');
            $('cfk-tk-d-actions').hidden = true;
        } catch (err) {
            setLine(dStatus, err.message, 'bad');
            btn.disabled = false;
            $('cfk-tk-d-assign').disabled = false;
        }
    });

    // ── Recently closed (loaded when asked for) ──
    const closedBtn = $('cfk-tk-closed-load');
    closedBtn.addEventListener('click', async () => {
        const wrap = $('cfk-tk-closed');
        if (!wrap.hidden) { wrap.hidden = true; closedBtn.textContent = 'Show'; closedBtn.setAttribute('aria-expanded', 'false'); return; }
        wrap.hidden = false;
        closedBtn.textContent = 'Hide';
        closedBtn.setAttribute('aria-expanded', 'true');
        const status = $('cfk-tk-closed-status');
        const list = $('cfk-tk-closed-list');
        setLine(status, 'Loading…', 'busy');
        list.replaceChildren();
        try {
            const data = await call(`${api}?status=closed&limit=25`, 'GET');
            setLine(status, data.tickets.length ? '' : 'No closed tickets yet.');
            for (const t of data.tickets) {
                const item = el('div', 'cf-list-item cf-list-item--multi');
                const main = el('div', 'cf-list-main');
                main.appendChild(el('p', 'cf-list-title', (t.number != null ? '#' + t.number + ' ' : '') + t.subject));
                const meta = el('p', 'cf-list-meta');
                meta.appendChild(el('span', null, 'Opened by ' + (nameOf(t.opener) || 'unknown member')));
                if (t.closed_at) meta.appendChild(el('span', null, 'Closed ' + when(t.closed_at)));
                if (t.closed_by) meta.appendChild(el('span', null, 'by ' + nameOf(t.closed_by)));
                main.appendChild(meta);
                const actions = el('div', 'cf-list-actions');
                const view = el('button', 'btn btn-secondary btn-sm', 'Details');
                view.type = 'button';
                view.dataset.tkView = String(t.id);
                view.setAttribute('aria-label', 'Details for ticket ' + (t.number ?? t.id));
                actions.appendChild(view);
                item.append(main, actions);
                list.appendChild(item);
            }
        } catch (err) {
            setLine(status, err.message || 'Could not load closed tickets.', 'bad');
        }
    });
})();
</script>
