<%#
  Tickets: ticket panels (JSON API under /manage/:id/ticket-panels, edited in the panel dialog with a
  live preview, or started from a template), the open tickets and modmail threads with an inline staff
  reply (/manage/:id/ticket/:id/reply, /manage/:id/modmail/:id/reply), and the original single-panel
  setup (POST update-tickets, create-ticket-panel). Built on the settings-row kit (cf-settings.css).
  Ticket details dialog (Details on an open ticket, or on a recently closed one): conversation or
  saved transcript, intake answers, staff notes, assign and close, through the JSON API in
  dashboard/routes/api/features/tickets.js (/api/guilds/:id/tickets).
  Panel ids, field ids and every route are unchanged.
%>
<%
const tkPanels = Array.isArray(ticketPanels) ? ticketPanels : [];
const tkOpenTickets = (typeof openTickets !== 'undefined' && openTickets) || [];
const tkOpenModmail = (typeof openModmail !== 'undefined' && openModmail) || [];
const tkText = (Array.isArray(channels) ? channels : []).filter(c => c.type === 0 || c.type === 5);
const tkCats = Array.isArray(categories) ? categories : [];
const tkRoles = (Array.isArray(roles) ? roles : []).slice().sort((a, b) => (b.position || 0) - (a.position || 0));
const tkName = (id) => {
    const m = guild && guild.members && guild.members.cache ? guild.members.cache.get(String(id)) : null;
    return m ? (m.displayName || m.user.username) : 'Unknown member';
};
const tkWhen = (d) => { try { return new Date(d).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (e) { return ''; } };
const tkWaiting = tkOpenTickets.filter(t => Number(t.awaiting_response)).length;
const tkPosted = tkPanels.filter(p => p.panel_message_id).length;
const tkReady = !!(ticketConfig && ticketConfig.panel_channel_id && ticketConfig.ticket_category_id);
%>
<div class="page-section" id="cfk-tk-page" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-ticket-alt"></i>
                <span>Tickets</span>
            </div>
            <div class="page-section-subtitle">Panels, support roles and the open queue.</div>
        </div>
        <button type="button" class="btn btn-primary" onclick="openCreatePanelModal()">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>New panel</span>
        </button>
    </div>

    <dl class="cf-kpis" aria-label="Tickets at a glance">
        <div class="cf-kpi"><dt>Panels</dt><dd class="cf-kpi-value"><%= tkPanels.length %></dd><span class="cf-kpi-sub"><%= tkPosted %> posted</span></div>
        <div class="cf-kpi"><dt>Open tickets</dt><dd class="cf-kpi-value"><%= tkOpenTickets.length %></dd></div>
        <div class="cf-kpi"><dt>Waiting on staff</dt><dd class="cf-kpi-value"><%= tkWaiting %></dd><span class="cf-kpi-sub">member replied last</span></div>
        <div class="cf-kpi"><dt>Open modmail</dt><dd class="cf-kpi-value"><%= tkOpenModmail.length %></dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="tk-panels-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tk-panels-title">Ticket panels <span class="tk-count"><%= tkPanels.length %></span></h2>
                <p class="cf-section-desc">A message with a button. Pressing it opens a private channel that only the member and the panel's support role can see.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% if (tkPanels.length) { %>
            <div class="cf-list">
                <% tkPanels.forEach(panel => {
                    const cat = tkCats.find(c => c.id === panel.ticket_category_id);
                    const role = tkRoles.find(r => r.id === panel.support_role_id);
                    const chan = panel.panel_channel_id ? (Array.isArray(channels) ? channels : []).find(c => c.id === panel.panel_channel_id) : null;
                    const logChan = panel.log_channel_id ? (Array.isArray(channels) ? channels : []).find(c => c.id === panel.log_channel_id) : null;
                    const desc = panel.embed_description || 'Click the button below to create a support ticket. Our team will assist you shortly!';
                %>
                <div class="cf-list-item cf-list-item--multi tk-panel" data-panel-id="<%= panel.panel_id %>">
                    <div class="cf-list-main">
                        <p class="cf-list-title">
                            <span><%= panel.panel_name %></span>
                            <% if (panel.panel_message_id) { %><span class="cf-pill is-ok">Posted</span><% } else { %><span class="cf-pill is-warn">Not posted</span><% } %>
                            <% if (panel.is_active === 0) { %><span class="cf-pill is-bad">Off</span><% } %>
                        </p>
                        <p class="cf-list-meta">
                            <span><%= chan ? '#' + chan.name : 'No channel set' %></span>
                            <span>Category: <%= cat ? cat.name : 'missing' %></span>
                            <span>Support: <%= role ? '@' + role.name : 'missing role' %></span>
                            <span>Log: <%= logChan ? '#' + logChan.name : 'none' %></span>
                            <% const alertChan = panel.alert_channel_id ? (Array.isArray(channels) ? channels : []).find(c => c.id === panel.alert_channel_id) : null; %>
                            <span>Alerts: <%= alertChan ? '#' + alertChan.name : 'none' %></span>
                            <span>Transcripts <%= panel.save_transcripts === 0 ? 'off' : 'on' %></span>
                            <% if (panel.form_id) { %><span>Intake form attached</span><% } %>
                        </p>
                        <div class="tk-dc tk-dc--mini" aria-label="How the panel looks in Discord">
                            <div class="tk-dc-embed" style="--tk-embed: <%= /^#[0-9a-f]{6}$/i.test(panel.embed_color || '') ? panel.embed_color : '#a78bfa' %>;">
                                <div class="tk-dc-title"><%= panel.embed_title || 'Support Ticket' %></div>
                                <div class="tk-dc-desc"><%= desc.length > 160 ? desc.slice(0, 160) + '…' : desc %></div>
                            </div>
                            <span class="tk-dc-btn"><% if (panel.button_emoji) { %><span><%= panel.button_emoji %></span> <% } %><%= panel.button_text || 'Create Ticket' %></span>
                        </div>
                    </div>
                    <div class="cf-list-actions">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="editPanel(<%= Number(panel.panel_id) || 0 %>)">Edit</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="deployPanel(<%= Number(panel.panel_id) || 0 %>, this)"<%= panel.panel_channel_id ? '' : ' disabled title="Choose a panel channel first"' %>><%= panel.panel_message_id ? 'Post again' : 'Post' %></button>
                        <button type="button" class="btn btn-danger btn-sm" onclick="deletePanel(<%= Number(panel.panel_id) || 0 %>, this)" aria-label="Delete <%= panel.panel_name %>">Delete</button>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="cf-state">
                <p class="cf-state-title">No ticket panels yet</p>
                <p class="cf-state-text">Start from a template below, or create a panel from scratch.</p>
                <button type="button" class="btn btn-primary" onclick="openCreatePanelModal()">Create a panel</button>
            </div>
            <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tk-tpl-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tk-tpl-title">Start from a template</h2>
                <p class="cf-section-desc">Opens a new panel with the wording filled in. Choose the channel, category and support role, then save.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="tk-pad">
                <div class="tk-tpls" id="cfk-tk-templates"></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tk-open-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tk-open-title">Open tickets <span class="tk-count"><%= tkOpenTickets.length %></span></h2>
                <p class="cf-section-desc">Waiting on staff means the member wrote last. A reply here is posted in the ticket channel as the bot.</p>
            </div>
            <div class="cf-section-actions"<%= tkOpenTickets.length > 15 ? '' : ' hidden' %>>
                <input type="search" id="ticketSearchInput" class="form-control tk-search" data-tk-filter="cfk-tk-ticket-list" placeholder="Search tickets" aria-label="Search open tickets">
            </div>
        </header>
        <div class="cf-rows">
            <% if (!tkOpenTickets.length) { %>
            <div class="cf-state cf-state--compact"><p class="cf-state-text">No open tickets.</p></div>
            <% } else { %>
            <div class="cf-list" id="cfk-tk-ticket-list">
                <% tkOpenTickets.forEach(t => { const who = tkName(t.user_id); const claimer = t.claimed_by_id ? tkName(t.claimed_by_id) : ''; %>
                <div class="cf-list-item cf-list-item--multi" data-ticket-id="<%= t.id %>" data-search="<%= (who + ' ' + (t.subject || '')).toLowerCase() %>">
                    <div class="cf-list-main">
                        <p class="cf-list-title">
                            <span><% if (t.ticket_number) { %>#<%= t.ticket_number %> <% } %><%= t.subject || 'Support ticket' %></span>
                            <% if (Number(t.awaiting_response)) { %><span class="cf-pill is-warn">Waiting on staff</span><% } %>
                            <% if (t.claimed_by_id) { %><span class="cf-pill is-info">Claimed by <%= claimer %></span><% } %>
                        </p>
                        <p class="cf-list-meta">
                            <span>Opened by <%= who %></span>
                            <span><%= tkWhen(t.created_at) %></span>
                            <a href="https://discord.com/channels/<%= guild.id %>/<%= t.channel_id %>" target="_blank" rel="noopener">Open in Discord</a>
                        </p>
                        <form class="tk-reply cf-input-group" data-endpoint="/manage/<%= guild.id %>/ticket/<%= t.id %>/reply">
                            <input type="text" name="content" class="form-control" placeholder="Reply in the ticket" aria-label="Reply to <%= who %>" maxlength="2000" required data-no-fieldkit>
                            <button type="submit" class="btn btn-sm btn-primary">Send</button>
                        </form>
                        <span class="cf-status-line tk-reply-status" role="status" aria-live="polite"></span>
                    </div>
                    <div class="cf-list-actions">
                        <button type="button" class="btn btn-secondary btn-sm" data-tk-view="<%= Number(t.id) || 0 %>" aria-label="Details for ticket <%= Number(t.ticket_number) || Number(t.id) || 0 %>">Details</button>
                    </div>
                </div>
                <% }); %>
            </div>
            <div class="cf-state cf-state--compact" data-tk-nomatch="cfk-tk-ticket-list" hidden><p class="cf-state-text">No ticket matches that search.</p></div>
            <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tk-closed-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tk-closed-title">Recently closed</h2>
                <p class="cf-section-desc">The last 25 closed tickets. Details shows the saved transcript and staff notes. Closed tickets and their transcripts are deleted a year after they close.</p>
            </div>
            <div class="cf-section-actions">
                <button type="button" class="btn btn-secondary btn-sm" id="cfk-tk-closed-load" aria-controls="cfk-tk-closed" aria-expanded="false">Show</button>
            </div>
        </header>
        <div class="cf-rows" id="cfk-tk-closed" hidden>
            <span class="cf-status-line" id="cfk-tk-closed-status" role="status" aria-live="polite"></span>
            <div class="cf-list" id="cfk-tk-closed-list"></div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tk-modmail-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tk-modmail-title">Open modmail <span class="tk-count"><%= tkOpenModmail.length %></span></h2>
                <p class="cf-section-desc">Conversations members started by messaging the bot. A reply here is sent to them as a DM from the server. Settings are on the <a href="/manage/<%= guild.id %>?page=modmail">Modmail</a> page.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% if (!tkOpenModmail.length) { %>
            <div class="cf-state cf-state--compact"><p class="cf-state-text">No open modmail.</p></div>
            <% } else { %>
            <div class="cf-list">
                <% tkOpenModmail.forEach(m => { const who = tkName(m.user_id); %>
                <div class="cf-list-item cf-list-item--multi" data-modmail-id="<%= m.id %>">
                    <div class="cf-list-main">
                        <p class="cf-list-title">
                            <span><%= who %></span>
                            <% if (Number(m.awaiting_response)) { %><span class="cf-pill is-warn">Waiting on staff</span><% } %>
                        </p>
                        <p class="cf-list-meta">
                            <span>Opened <%= tkWhen(m.created_at) %></span>
                            <a href="https://discord.com/channels/<%= guild.id %>/<%= m.channel_id %>" target="_blank" rel="noopener">Open in Discord</a>
                        </p>
                        <form class="tk-reply cf-input-group" data-endpoint="/manage/<%= guild.id %>/modmail/<%= m.id %>/reply">
                            <input type="text" name="content" class="form-control" placeholder="Reply by DM" aria-label="Reply to <%= who %>" maxlength="2000" required data-no-fieldkit>
                            <button type="submit" class="btn btn-sm btn-primary">Send</button>
                        </form>
                        <span class="cf-status-line tk-reply-status" role="status" aria-live="polite"></span>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tk-default-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tk-default-title">Default panel</h2>
                <p class="cf-section-desc">The original one-panel setup, also set with <code>/support ticket setup</code>. Panels above have their own settings; this log channel is also used for any panel without one.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form action="/manage/<%= guild.id %>/update-tickets" method="POST">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ticketPanelChannel">Panel channel</label>
                        <p class="cf-row-desc" id="ticketPanelChannel-desc">Where the bot posts the button.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="ticketPanelChannel" name="panel_channel_id" aria-describedby="ticketPanelChannel-desc">
                            <%- include('../kit/_options', { items: tkText, selected: ticketConfig ? ticketConfig.panel_channel_id : null, prefix: '#', empty: 'Choose a channel' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ticketCategory">Ticket category</label>
                        <p class="cf-row-desc" id="ticketCategory-desc">New ticket channels are created here.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="ticketCategory" name="ticket_category_id" aria-describedby="ticketCategory-desc">
                            <%- include('../kit/_options', { items: tkCats, selected: ticketConfig ? ticketConfig.ticket_category_id : null, prefix: '', empty: 'Choose a category' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ticketSupportRole">Support role</label>
                        <p class="cf-row-desc" id="ticketSupportRole-desc">Can see and manage tickets.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="ticketSupportRole" name="support_role_id" aria-describedby="ticketSupportRole-desc">
                            <%- include('../kit/_options', { items: tkRoles, selected: ticketConfig ? ticketConfig.support_role_id : null, prefix: '', empty: 'Choose a role' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ticketLogChannel">Log channel</label>
                        <p class="cf-row-desc" id="ticketLogChannel-desc">Optional. Closed tickets are logged here, with a link to the transcript.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="ticketLogChannel" name="log_channel_id" aria-describedby="ticketLogChannel-desc">
                            <%- include('../kit/_options', { items: tkText, selected: ticketConfig ? ticketConfig.log_channel_id : null, prefix: '#', empty: 'None' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="ticketAlertChannel">Alert channel</label>
                        <p class="cf-row-desc" id="ticketAlertChannel-desc">Optional. Staff get a "New Ticket Opened" post here, with a button to join the ticket, each time one opens from the default panel.</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="ticketAlertChannel" name="alert_channel_id" aria-describedby="ticketAlertChannel-desc">
                            <%- include('../kit/_options', { items: tkText, selected: ticketConfig ? ticketConfig.alert_channel_id : null, prefix: '#', empty: 'None' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <% if (tkReady && ticketConfig.support_role_id) { %><span class="cf-foot-note"><span class="cf-pill is-ok">Set up</span></span><% } %>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
            <% if (tkReady) { const panelChannel = (Array.isArray(channels) ? channels : []).find(c => c.id === ticketConfig.panel_channel_id); %>
            <form action="/manage/<%= guild.id %>/create-ticket-panel" method="POST">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Post the default panel</span>
                        <p class="cf-row-desc">Posts the button to #<%= panelChannel ? panelChannel.name : 'unknown channel' %>.</p>
                    </div>
                    <div class="cf-row-control tk-end">
                        <button type="submit" class="btn btn-secondary">Post panel</button>
                    </div>
                </div>
            </form>
            <% } else { %>
            <div class="cf-state cf-state--compact"><p class="cf-state-text">Choose a panel channel and a ticket category, then save, to post the default panel.</p></div>
            <% } %>
        </div>
    </section>
</div>

<!-- Panel create / edit dialog -->
<div id="panelModal" class="cf-modal" hidden role="dialog" aria-modal="true" aria-labelledby="panelModalTitle">
    <div class="tk-overlay" onclick="closePanelModal()"></div>
    <div class="cf-modal-dialog is-xl">
        <header class="cf-modal-head">
            <div>
                <h3 class="cf-modal-title" id="panelModalTitle">Create a ticket panel</h3>
                <p class="cf-modal-desc">The message members open tickets from, and where their tickets go.</p>
            </div>
            <button type="button" class="cf-modal-close" onclick="closePanelModal()" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
        </header>
        <div class="cf-modal-body">
            <form id="panelForm" novalidate onsubmit="event.preventDefault(); savePanelForm();">
                <div class="tk-modal-cols">
                    <div class="cf-rows">
                        <div class="cf-rows-head">Panel</div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="panel_name">Panel name</label>
                                <p class="cf-row-desc">Only shown here, to tell your panels apart.</p>
                            </div>
                            <div class="cf-row-control">
                                <input type="text" id="panel_name" class="form-control" placeholder="General support" maxlength="100" required data-no-fieldkit>
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="panel_channel_id">Panel channel</label>
                                <p class="cf-row-desc">Where the button is posted.</p>
                            </div>
                            <div class="cf-row-control">
                                <select id="panel_channel_id" class="form-select">
                                    <%- include('../kit/_options', { items: tkText, selected: null, prefix: '#', empty: 'Choose a channel' }) %>
                                </select>
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="ticket_category_id">Ticket category</label>
                                <p class="cf-row-desc">Ticket channels are created here.</p>
                            </div>
                            <div class="cf-row-control">
                                <select id="ticket_category_id" class="form-select" required>
                                    <%- include('../kit/_options', { items: tkCats, selected: null, prefix: '', empty: 'Choose a category' }) %>
                                </select>
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="support_role_id">Support role</label>
                                <p class="cf-row-desc">Can see and manage this panel's tickets.</p>
                            </div>
                            <div class="cf-row-control">
                                <select id="support_role_id" class="form-select" required>
                                    <%- include('../kit/_options', { items: tkRoles, selected: null, prefix: '', empty: 'Choose a role' }) %>
                                </select>
                            </div>
                        </div>

                        <div class="cf-rows-head">Panel message</div>
                        <div class="cf-row cf-row--stack">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="embed_title">Title</label>
                            </div>
                            <div class="cf-row-control">
                                <input type="text" id="embed_title" class="form-control" placeholder="Support Ticket" maxlength="256">
                            </div>
                        </div>
                        <div class="cf-row cf-row--stack">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="embed_description">Description</label>
                            </div>
                            <div class="cf-row-control">
                                <textarea id="embed_description" class="form-control" rows="4" maxlength="4096" placeholder="Press the button below to open a support ticket."></textarea>
                            </div>
                        </div>
                        <div class="cf-row cf-row--stack">
                            <div class="cf-fields">
                                <div class="cf-field">
                                    <label for="embed_color">Colour</label>
                                    <input type="color" id="embed_color" class="form-control form-control-color tk-color" value="#a78bfa">
                                </div>
                                <div class="cf-field">
                                    <label for="button_text">Button text</label>
                                    <input type="text" id="button_text" class="form-control" placeholder="Create Ticket" maxlength="80" data-no-fieldkit>
                                </div>
                                <div class="cf-field">
                                    <label for="button_emoji">Button emoji</label>
                                    <input type="text" id="button_emoji" class="form-control" placeholder="Optional" maxlength="100" aria-describedby="button_emoji-desc" data-no-fieldkit>
                                    <span class="cf-field-hint" id="button_emoji-desc">One emoji, pasted in.</span>
                                </div>
                            </div>
                        </div>

                        <div class="cf-rows-head">Tickets</div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="ticket_name_format">Ticket channel name</label>
                                <p class="cf-row-desc" id="ticket_name_format-desc">Use <code>{username}</code>, <code>{number}</code> or <code>{id}</code> (their user ID).</p>
                            </div>
                            <div class="cf-row-control">
                                <input type="text" id="ticket_name_format" class="form-control" placeholder="ticket-{username}" maxlength="100" aria-describedby="ticket_name_format-desc">
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="log_channel_id">Log channel</label>
                                <p class="cf-row-desc">Optional. Each closed ticket is logged here, with a link to its transcript. Left empty, the default panel's log channel is used.</p>
                            </div>
                            <div class="cf-row-control">
                                <select id="log_channel_id" class="form-select">
                                    <%- include('../kit/_options', { items: tkText, selected: null, prefix: '#', empty: 'None' }) %>
                                </select>
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="alert_channel_id">Alert channel</label>
                                <p class="cf-row-desc">Optional. Staff get a "New Ticket Opened" post here, with a button to join the ticket, each time one opens from this panel.</p>
                            </div>
                            <div class="cf-row-control">
                                <select id="alert_channel_id" class="form-select">
                                    <%- include('../kit/_options', { items: tkText, selected: null, prefix: '#', empty: 'None' }) %>
                                </select>
                            </div>
                        </div>
                        <div class="cf-row cf-row--switch">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="save_transcripts">Save transcripts</label>
                                <p class="cf-row-desc">Keep a copy of the conversation when a ticket is closed.</p>
                            </div>
                            <div class="cf-row-control">
                                <input type="checkbox" id="save_transcripts" class="cf-switch" role="switch" checked>
                            </div>
                        </div>
                    </div>

                    <aside class="tk-preview" aria-label="Preview">
                        <div class="tk-preview-label">Preview</div>
                        <div class="tk-dc">
                            <div class="tk-dc-msg">
                                <div class="tk-dc-avatar" aria-hidden="true"><%= (guild.members && guild.members.me && guild.members.me.displayName ? guild.members.me.displayName : 'B').charAt(0).toUpperCase() %></div>
                                <div class="tk-dc-body">
                                    <div class="tk-dc-author"><%= guild.members && guild.members.me ? guild.members.me.displayName : 'Bot' %><span class="tk-dc-tag">APP</span></div>
                                    <div class="tk-dc-embed" id="cfk-tk-pv-embed">
                                        <div class="tk-dc-title" id="cfk-tk-pv-title"></div>
                                        <div class="tk-dc-desc" id="cfk-tk-pv-desc"></div>
                                    </div>
                                    <span class="tk-dc-btn" id="cfk-tk-pv-btn"></span>
                                </div>
                            </div>
                        </div>
                        <p class="tk-preview-note" id="cfk-tk-pv-name"></p>
                    </aside>
                </div>
            </form>
        </div>
        <footer class="cf-modal-foot">
            <span class="cf-foot-note cf-status-line" id="cfk-tk-form-status" role="status" aria-live="polite"></span>
            <button type="button" class="btn btn-secondary" onclick="closePanelModal()">Cancel</button>
            <button type="submit" class="btn btn-primary" form="panelForm" id="cfk-tk-save">Save panel</button>
        </footer>
    </div>
</div>

<!-- Ticket details dialog (filled from /api/guilds/:id/tickets/:ticketId) -->
<div id="cfk-tk-detail" class="cf-modal" hidden role="dialog" aria-modal="true" aria-labelledby="cfk-tk-d-title">
    <div class="tk-overlay" data-tk-close></div>
    <div class="cf-modal-dialog is-xl">
        <header class="cf-modal-head">
            <div>
                <h3 class="cf-modal-title" id="cfk-tk-d-title">Ticket</h3>
                <p class="cf-modal-desc" id="cfk-tk-d-sub"></p>
            </div>
            <button type="button" class="cf-modal-close" data-tk-close aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
        </header>
        <div class="cf-modal-body">
            <span class="cf-status-line" id="cfk-tk-d-status" role="status" aria-live="polite"></span>
            <div class="tk-d-cols" id="cfk-tk-d-body" hidden>
                <div class="tk-d-col">
                    <div class="cf-rows">
                        <div class="cf-rows-head"><span id="cfk-tk-d-msghead">Conversation</span> <a class="tk-d-hint" id="cfk-tk-d-viewer" target="_blank" rel="noopener" hidden>Open full transcript</a></div>
                        <div class="tk-d-msgs" id="cfk-tk-d-msgs"></div>
                    </div>
                    <div class="cf-rows" id="cfk-tk-d-formwrap" hidden>
                        <div class="cf-rows-head">Intake answers</div>
                        <dl class="tk-d-form" id="cfk-tk-d-form"></dl>
                    </div>
                    <div class="cf-rows">
                        <div class="cf-rows-head">Staff notes <span class="tk-d-hint">Only shown here, never to the member</span></div>
                        <div id="cfk-tk-d-notes"></div>
                        <form class="tk-d-noteform" id="cfk-tk-d-noteform">
                            <label class="visually-hidden" for="cfk-tk-d-note">New staff note</label>
                            <textarea id="cfk-tk-d-note" class="form-control" rows="2" maxlength="2000" placeholder="Add a note for staff" data-no-fieldkit></textarea>
                            <button type="submit" class="btn btn-secondary btn-sm">Add note</button>
                        </form>
                    </div>
                </div>
                <aside class="tk-d-col">
                    <div class="cf-rows">
                        <div class="cf-rows-head">Ticket</div>
                        <dl class="tk-d-facts" id="cfk-tk-d-facts"></dl>
                    </div>
                    <div class="cf-rows" id="cfk-tk-d-actions">
                        <div class="cf-rows-head">Actions</div>
                        <div class="tk-d-pad">
                            <label class="tk-d-label" for="cfk-tk-d-staff">Assigned to</label>
                            <div class="cf-input-group">
                                <select id="cfk-tk-d-staff" class="form-select"></select>
                                <button type="button" class="btn btn-secondary btn-sm" id="cfk-tk-d-assign">Save</button>
                            </div>
                            <p class="tk-d-hint" id="cfk-tk-d-staffhint">Members with the support role. They are pinged in the ticket.</p>
                            <label class="tk-d-label" for="cfk-tk-d-reason">Close reason</label>
                            <input type="text" id="cfk-tk-d-reason" class="form-control" maxlength="500" placeholder="Optional" data-no-fieldkit>
                            <button type="button" class="btn btn-danger btn-sm tk-d-closebtn" id="cfk-tk-d-close">Close ticket</button>
                            <p class="tk-d-hint">Same as the Close button in Discord: the transcript is saved (if the panel keeps them), the member gets a DM, the log channel is told, and the channel is deleted.</p>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</div>

<style>
