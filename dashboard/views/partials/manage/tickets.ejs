@media (max-width: 1000px) {
    #cfk-tk-detail .tk-d-cols { grid-template-columns: minmax(0, 1fr); }
}
#panelModal .tk-overlay { position: absolute; inset: 0; }
#panelModal .tk-modal-cols { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: var(--cf-5); align-items: start; }
#panelModal .tk-preview { position: sticky; top: 0; display: grid; gap: var(--cf-2); min-width: 0; }
#panelModal .tk-preview-label { font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
#panelModal .tk-preview-note { margin: 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); overflow-wrap: anywhere; }
#panelModal .tk-preview-note code { font-family: var(--cf-mono); color: var(--cf-text-2); }
#panelModal .cf-rows .cf-field > input.tk-color { width: 64px; height: 38px; padding: 4px; }
@media (max-width: 1000px) {
    #panelModal .tk-modal-cols { grid-template-columns: minmax(0, 1fr); }
    #panelModal .tk-preview { position: static; order: -1; }
