<%# Add streamer dialog (POST add-streamer), opened from the Streaming page. One announcement channel
    (the route stores one), a message with variable chips, and the stream-end choice seeded from the
    server default. %>
<style>
/* Shared by the streaming dialogs (add, edit, bulk): a quiet section heading and help lines. */
.st-modal .modal-title { font-size: var(--cf-text-lg); font-weight: 600; color: var(--cf-text); }
.st-modal .modal-body { max-height: calc(100vh - 200px); overflow-y: auto; }
.st-modal .st-modal-section { margin: var(--cf-6) 0 var(--cf-1); padding-top: var(--cf-5); border-top: 1px solid var(--cf-border); font-size: var(--cf-text-md); font-weight: 600; color: var(--cf-text); }
.st-modal .st-modal-desc { margin: 0 0 var(--cf-4); font-size: var(--cf-text-sm); color: var(--cf-text-3); }
.st-modal .form-text, .st-modal .form-help { display: block; margin-top: 6px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
</style>

<div class="modal fade st-modal" id="add-streamer-modal" tabindex="-1" aria-labelledby="addStreamerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form action="/manage/<%= guild.id %>/add-streamer" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title" id="addStreamerModalLabel">Add a streamer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Basic Information -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label" for="f-add-streamer-platform">Platform</label>
                            <select id="f-add-streamer-platform" name="platform" class="form-select" required>
                                <option value="twitch">Twitch</option>
                                <option value="youtube">YouTube</option>
                                <option value="kick">Kick</option>
                                <option value="tiktok">TikTok</option>
                                <option value="rumble">Rumble</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="f-add-streamer-username">Username or channel ID</label>
                            <input id="f-add-streamer-username" type="text" name="username" class="form-control" maxlength="100" placeholder="Their username on that platform" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="f-add-streamer-discord_user_id">Discord member</label>
                            <input id="f-add-streamer-discord_user_id" type="text" name="discord_user_id" class="form-control" inputmode="numeric" pattern="\d{17,20}" placeholder="Discord user ID, such as 123456789012345678" aria-describedby="f-add-streamer-discord_user_id-desc">
                            <small class="form-text" id="f-add-streamer-discord_user_id-desc">Optional. The live role goes to this member.</small>
                        </div>
                    </div>

                    <h6 class="st-modal-section">Announcements</h6>
                    <p class="st-modal-desc">Where and how this streamer's live posts appear.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="f-add-streamer-announcement_channel_id">Announcement channel</label>
                            <select id="f-add-streamer-announcement_channel_id" name="announcement_channel_id" class="form-select">
                                <option value="">Server default</option>
                                <% channels.forEach(c => { %>
                                    <option value="<%= c.id %>">#<%= c.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="f-add-streamer-override_nickname">Name when posting as the streamer</label>
                            <input id="f-add-streamer-override_nickname" type="text" class="form-control" name="override_nickname" maxlength="80" placeholder="Their username">
                            <small class="form-text">Used when posts go out with the streamer's name and avatar.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="f-add-streamer-custom_message">Announcement message</label>
                            <textarea id="f-add-streamer-custom_message" class="form-control" name="custom_message" rows="3" maxlength="2000" placeholder="{streamer} is live playing {game}: {url}"></textarea>
                            <small class="form-text">Variables: {streamer}, {platform}, {game}, {title}, {url}. Leave empty to use the server default message. You can preview and test it with Edit once the streamer is added.</small>
                        </div>
                        <%
                            // Seeded from the server-wide default (Streamers tab -> "When a stream ends"). Both boxes post explicitly, so changing them here
                            // overrides the default for this streamer only.
                            const asDefaults = typeof streamEndDefaults !== 'undefined' && streamEndDefaults
                                ? streamEndDefaults
                                : { edit_on_end: 0, delete_on_end: 1 };
                            const asEdit = !!asDefaults.edit_on_end;
                            const asKeep = !asEdit && !asDefaults.delete_on_end;
                        %>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="edit_on_end_add" name="edit_on_end" <%= asEdit ? 'checked' : '' %>>
                                <label class="form-check-label" for="edit_on_end_add">
                                    Edit the announcement to "stream ended" when the stream ends
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="keep_summary_add" name="keep_summary" <%= asKeep ? 'checked' : '' %>>
                                <label class="form-check-label" for="keep_summary_add">
                                    Keep the announcement as it is when the stream ends
                                </label>
                            </div>
                            <small class="form-text">Filled in from this server's default. With both off, the announcement is deleted.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add streamer</button>
                </div>
            </form>
        </div>
    </div>
</div>
