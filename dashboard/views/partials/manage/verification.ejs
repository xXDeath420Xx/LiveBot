<%# Verification — I agree / CAPTCHA gate, setup wizard (preview, apply, undo), stats, the CAPTCHA clock, auto-prune settings + queue, the inactivity prune (settings, preview, run now), and ONE live activity log for all of them (GET /log; rules in core/verification-log-logic.js) (core/verification.js, core/auto-prune.js, core/inactivity-prune.js). API-driven (dashboard/routes/api/features/verification.js); needs `guild` in locals. Laid out with the settings-row kit (cf-settings.css); every id the script below uses is unchanged. %>
<div class="page-section" id="verificationPage" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-user-lock"></i>
                <span>Verification</span>
            </div>
            <div class="page-section-subtitle">The gate new members pass before they see the server, and the prunes that clear out accounts that never take part.</div>
        </div>
    </div>

    <div id="vfError" class="alert alert-danger" role="alert" hidden></div>
    <div id="vfNotice" class="alert alert-info" role="status" hidden></div>

    <!-- Status + stats -->
    <section class="cf-section" aria-labelledby="vf-overview-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="vf-overview-title">Last 30 days</h2>
                <p class="cf-section-desc">Green: verified. Red: failed or ran out of time. Amber: auto-pruned. The rate is verified divided by verified, failed and timed out together.</p>
            </div>
            <div class="cf-section-actions">
                <span id="vfRateBadge" class="cf-pill vf-badge">...</span>
                <a class="vl-jump" href="#vlCard">Activity log <i class="fas fa-arrow-down" aria-hidden="true"></i></a>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="vf-stats" id="vfStats"><div class="vf-muted">Loading...</div></div>
                <div id="vfChart" class="vf-chart" aria-hidden="true"></div>
            </div>
        </div>
    </section>

    <!-- Settings -->
    <section class="cf-section" aria-labelledby="vf-settings-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="vf-settings-title">Verification gate</h2>
                <p class="cf-section-desc">
                    Members verify with an "I agree" button, or a CAPTCHA: a picture of a fresh six-digit code answered on a keypad, with
                    a number of tries and a time limit. Allowlisted members and staff
                    (<a href="/manage/<%= guild.id %>?page=protection-settings">Protection settings</a>) are never kicked, banned or timed out by it.
                </p>
            </div>
            <div class="cf-section-actions"><span id="vfOnBadge" class="cf-pill vf-badge">...</span></div>
        </header>
        <div class="cf-rows">
            <div id="vfNoConfig" class="cf-notice is-warn" hidden>Verification is not set up yet. Use the setup wizard below, or pick a verified role here and save.</div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfEnabled">Verification on</label>
                    <p class="cf-row-desc">New members must verify before they can see the server.</p>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="vfEnabled" data-feature-switch></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfMode">How members verify</label>
                    <p class="cf-row-desc">A CAPTCHA stops bots; the button only asks people to agree to the rules.</p>
                </div>
                <div class="cf-row-control">
                    <select id="vfMode" class="form-select"><option value="button">I agree button</option><option value="captcha">CAPTCHA (image code and keypad)</option></select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfChannel">Verification channel</label>
                    <p class="cf-row-desc">Where the verification panel is posted.</p>
                </div>
                <div class="cf-row-control"><select id="vfChannel" class="form-select"></select></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfVerified">Verified role</label>
                    <p class="cf-row-desc">Given when someone verifies.</p>
                </div>
                <div class="cf-row-control"><select id="vfVerified" class="form-select"></select></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfUnverified">Unverified role</label>
                    <p class="cf-row-desc">Optional. Held from joining until they verify.</p>
                </div>
                <div class="cf-row-control"><select id="vfUnverified" class="form-select"></select></div>
            </div>

            <div id="vfCaptchaBox">
                <div class="cf-rows-head" id="vf-captcha-head">CAPTCHA rules</div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="vfAttempts">Wrong codes allowed</label>
                        <p class="cf-row-desc">A wrong answer brings a new picture. From 1 to 10.</p>
                    </div>
                    <div class="cf-row-control"><input id="vfAttempts" type="number" min="1" max="10" class="form-control"></div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="vfWindow">Time limit</label>
                        <p class="cf-row-desc">Minutes from joining to finish; 0 means no limit, at most 20160 (14 days). <span id="vfWindowFmt" class="vf-muted"></span></p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit"><input id="vfWindow" type="number" min="0" max="20160" class="form-control"><span class="cf-unit">minutes</span></div>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="vfFail">When someone fails</label>
                        <p class="cf-row-desc">Failing means running out of tries or time. Log only records it and posts to the server log without touching anyone.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="vfFail" class="form-select"><option value="none">Log only</option><option value="timeout">Timeout</option><option value="kick">Kick</option><option value="ban">Ban</option></select>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="vfTimeout">Timeout length</label>
                        <p class="cf-row-desc">Used when the action is Timeout.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit"><input id="vfTimeout" type="number" min="1" max="40320" class="form-control"><span class="cf-unit">minutes</span></div>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="vfDm">Tell them why by DM</label>
                        <p class="cf-row-desc">When they are kicked, banned or timed out.</p>
                    </div>
                    <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="vfDm"></div>
                </div>
            </div>

            <div class="cf-rows-head" id="vf-panel-head">Panel and clean-up</div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfTitle">Panel title</label>
                    <p class="cf-row-desc">Optional. The heading on the verification panel.</p>
                </div>
                <div class="cf-row-control"><input id="vfTitle" class="form-control" maxlength="100"></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfText">Panel text</label>
                    <p class="cf-row-desc">Optional. Explain what members are agreeing to or what to expect.</p>
                </div>
                <div class="cf-row-control"><textarea id="vfText" class="form-control" rows="3" maxlength="1000"></textarea></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <span class="cf-row-label" id="vf-pv-title">Panel preview</span>
                    <p class="cf-row-desc" id="vf-pv-desc">What new members see in the verification channel. Changes reach Discord when you save and post the panel again.</p>
                </div>
                <div class="cf-dc-frame" data-vf-preview aria-live="polite" aria-labelledby="vf-pv-title"></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="vfKickDays">Remove members still unverified after</label>
                    <p class="cf-row-desc">0 means never.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit"><input id="vfKickDays" type="number" min="0" max="365" class="form-control"><span class="cf-unit">days</span></div>
                </div>
            </div>
            <div id="vfPermWarn" class="cf-notice is-warn" hidden></div>
            <div class="cf-section-foot">
                <span id="vfPanelWhere" class="cf-foot-note"></span>
                <button type="button" class="btn btn-secondary" id="vfPanel">Post the panel again</button>
                <button type="button" class="btn btn-primary" id="vfSave">Save</button>
            </div>
        </div>
    </section>

    <!-- Setup wizard -->
    <section class="cf-section" aria-labelledby="wz-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="wz-title">Setup wizard</h2>
                <p class="cf-section-desc">Creates whatever is missing, saves the settings, can hide your public channels until people verify, and posts the panel. You see every change before anything happens, and every permission change is recorded so it can be undone.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="wzChannel">Verification channel</label>
                    <p class="cf-row-desc">An existing channel, or a new one with the name below.</p>
                </div>
                <div class="cf-row-control">
                    <select id="wzChannel" class="form-select"></select>
                    <input id="wzChannelName" class="form-control" maxlength="90" value="verify" placeholder="Name for the new channel" aria-label="Name for the new channel">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="wzVerified">Verified role</label>
                </div>
                <div class="cf-row-control">
                    <select id="wzVerified" class="form-select"></select>
                    <input id="wzVerifiedName" class="form-control" maxlength="100" value="Verified" placeholder="Name for the new role" aria-label="Name for the new verified role">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="wzUnverified">Unverified role</label>
                </div>
                <div class="cf-row-control">
                    <select id="wzUnverified" class="form-select"></select>
                    <input id="wzUnverifiedName" class="form-control" maxlength="100" value="Unverified" placeholder="Name for the new role" aria-label="Name for the new unverified role">
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text"><label class="cf-row-label" for="wzMode">How members verify</label></div>
                <div class="cf-row-control">
                    <select id="wzMode" class="form-select"><option value="captcha">CAPTCHA (image code and keypad)</option><option value="button">I agree button</option></select>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <span class="cf-row-label" id="wz-strategy-head">Hide public channels until people verify</span>
                </div>
                <div class="cf-choices" role="radiogroup" aria-labelledby="wz-strategy-head">
                    <label class="cf-choice"><input type="radio" name="wzStrategy" value="unverified" checked> <span><strong>The Unverified role cannot see them</strong> (recommended)<span class="cf-choice-desc">New members get the Unverified role on joining and lose it when they verify. Members already here are not affected.</span></span></label>
                    <label class="cf-choice"><input type="radio" name="wzStrategy" value="verified"> <span><strong>Only the Verified role can see them</strong><span class="cf-choice-desc">@everyone loses access and the Verified role gets it. Everyone already here is given the Verified role first.</span></span></label>
                    <label class="cf-choice"><input type="radio" name="wzStrategy" value="none"> <span><strong>Do not hide anything</strong><span class="cf-choice-desc">Just the roles, the channel and the panel.</span></span></label>
                </div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-choices">
                    <label class="cf-choice"><input type="checkbox" id="wzHideGate" checked> <span>Hide the verification channel from verified members</span></label>
                    <label class="cf-choice"><input type="checkbox" id="wzGrant" checked> <span>Give the Verified role to members already here (only-Verified mode)</span></label>
                    <label class="cf-choice"><input type="checkbox" id="wzPanel" checked> <span>Post the panel</span></label>
                </div>
            </div>
            <div class="cf-row cf-row--stack vf-out-row">
                <div id="wzPreviewOut"></div>
                <div id="wzProgress" hidden>
                    <div class="vf-muted" id="wzPhase"></div>
                    <div class="vf-progress"><div class="vf-progress-bar" id="wzBar"></div></div>
                </div>
                <div id="wzResult"></div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-secondary" id="wzPreview">Preview</button>
                <button type="button" class="btn btn-danger" id="wzApply" disabled>Apply</button>
            </div>
        </div>
    </section>

    <section class="cf-section cf-section--danger" aria-labelledby="wz-undo-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="wz-undo-title">Undo the setup wizard</h2>
                <p class="cf-section-desc">Reverts every permission change the wizard recorded. Roles it gave to members are not taken back.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div id="wzRecord" class="vf-muted">No setup recorded.</div>
                <label class="cf-choice"><input type="checkbox" id="wzDeleteCreated"> <span>Also delete the channel and roles the wizard created</span></label>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-danger" id="wzUndo" disabled>Undo the permission changes</button>
            </div>
        </div>
    </section>

    <!-- CAPTCHA clock -->
    <section class="cf-section" aria-labelledby="vf-clock-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="vf-clock-title">Waiting to verify</h2>
                <p class="cf-section-desc">Members on the CAPTCHA time limit. At their deadline the fail action applies unless they have verified. "Stop the clock" lets one person take their time.</p>
            </div>
            <div class="cf-section-actions"><span id="vfClockCount" class="cf-pill vf-badge"></span></div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack"><div id="vfClock" class="vf-list"></div></div>
        </div>
    </section>

    <!-- Auto-prune -->
    <section class="cf-section" aria-labelledby="ap-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ap-title">Auto-prune</h2>
                <p class="cf-section-desc">
                    Kicks members who still have no real role a set time after joining: idle accounts and bots that join and sit there.
                    Only joins after you switch it on are tracked, and switching it off clears the queue. A real role is any role except the
                    bypass roles below and the roles this bot gives out automatically. Boosters and other app-managed roles count as real.
                </p>
            </div>
            <div class="cf-section-actions"><span id="apOnBadge2" class="cf-pill vf-badge">...</span></div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="prEnabled">Auto-prune on</label>
                    <p class="cf-row-desc">Start tracking new members who never get a real role.</p>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="prEnabled"></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="prMinutes">Time limit</label>
                    <p class="cf-row-desc">Minutes after joining, from 10 minutes to 14 days. <span id="prMinutesFmt" class="vf-muted"></span></p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit"><input id="prMinutes" type="number" min="10" max="20160" class="form-control"><span class="cf-unit">minutes</span></div>
                    <div class="vf-quick" role="group" aria-label="Quick choices">
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="30">30 min</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="60">1 h</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="240">4 h</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="720">12 h</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="1440">24 h</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="4320">3 d</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="10080">7 d</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-prmin="20160">14 d</button>
                    </div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="prAction">At the limit</label>
                    <p class="cf-row-desc">Log only lists them without removing anyone.</p>
                </div>
                <div class="cf-row-control">
                    <select id="prAction" class="form-select"><option value="kick">Kick</option><option value="log">Log only (remove nobody)</option></select>
                </div>
            </div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text"><label class="cf-row-label" for="prDm">DM them before the kick</label></div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="prDm"></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Bypass roles</span>
                    <p class="cf-row-desc">Roles that do not count as a real role. <span id="prSystem"></span></p>
                </div>
                <div class="cf-row-control">
                    <div id="prBypass" class="cf-chips"></div>
                    <div class="cf-inline">
                        <select id="prBypassPick" class="form-select vf-pick" aria-label="Role to add"></select>
                        <button type="button" class="btn btn-sm btn-secondary" id="prBypassAdd">Add</button>
                    </div>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="button" class="btn btn-primary" id="prSave">Save</button>
            </div>
            <div class="cf-rows-head vf-head-row" id="pr-queue-head">Queue <span id="prQueueCount" class="cf-pill vf-badge"></span></div>
            <div class="cf-row cf-row--stack"><div id="prQueue" class="vf-list"></div></div>
        </div>
    </section>

    <!-- Inactivity prune -->
    <section class="cf-section" id="inCard" aria-labelledby="inCard-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="inCard-title">Inactivity prune</h2>
                <p class="cf-section-desc">
                    Removes, or just lists, members who got through the gate but never show up: no message in any channel and no voice
                    join. Two rules, each off, log only or kick. Activity is counted from when this bot started tracking it here
                    (<span id="inSince">...</span>), so nobody is judged on time before that. Members in voice right now, members still
                    verifying or on the auto-prune queue, and members newer than the minimum below are never judged. Every kick respects the
                    allowlist and the pause on <a href="/manage/<%= guild.id %>?page=protection-settings">Protection settings</a>.
                    For a one-off look back over message history, see the <a href="/manage/<%= guild.id %>?page=activity-audit">Activity audit</a>.
                </p>
            </div>
            <div class="cf-section-actions"><span id="inBadge" class="cf-pill vf-badge">...</span></div>
        </header>
        <div class="cf-rows">
            <div class="cf-rows-head" id="in-rules-head">Rules</div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="inNever">Never active</label>
                    <p class="cf-row-desc">No message or voice join within a number of days of joining.</p>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="inNever"></div>
            </div>
            <div class="cf-row cf-row--sub">
                <div class="cf-row-text"><label class="cf-row-label" for="inNeverDays">Days after joining</label><p class="cf-row-desc">From 7 to 180.</p></div>
                <div class="cf-row-control"><div class="cf-input-unit"><input id="inNeverDays" type="number" min="7" max="180" class="form-control"><span class="cf-unit">days</span></div></div>
            </div>
            <div class="cf-row cf-row--sub">
                <div class="cf-row-text"><label class="cf-row-label" for="inNeverAction">Then</label></div>
                <div class="cf-row-control"><select id="inNeverAction" class="form-select"><option value="log">Log only (remove nobody)</option><option value="kick">Kick</option></select></div>
            </div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="inQuiet">Gone quiet</label>
                    <p class="cf-row-desc">Last message or voice join older than a number of days.</p>
                </div>
                <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" id="inQuiet"></div>
            </div>
            <div class="cf-row cf-row--sub">
                <div class="cf-row-text"><label class="cf-row-label" for="inQuietDays">Days without activity</label><p class="cf-row-desc">From 30 to 365.</p></div>
                <div class="cf-row-control"><div class="cf-input-unit"><input id="inQuietDays" type="number" min="30" max="365" class="form-control"><span class="cf-unit">days</span></div></div>
            </div>
            <div class="cf-row cf-row--sub">
                <div class="cf-row-text"><label class="cf-row-label" for="inQuietAction">Then</label></div>
                <div class="cf-row-control"><select id="inQuietAction" class="form-select"><option value="log">Log only (remove nobody)</option><option value="kick">Kick</option></select></div>
            </div>

            <div class="cf-rows-head" id="in-safety-head">Safety limits</div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="inWarn">Warn by DM before a kick</label>
                    <p class="cf-row-desc">Days of warning; 0 means none. The DM names the server and says how to stay: post anything or join voice. Any activity after it cancels it.</p>
                </div>
                <div class="cf-row-control"><div class="cf-input-unit"><input id="inWarn" type="number" min="0" max="30" class="form-control"><span class="cf-unit">days</span></div></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text"><label class="cf-row-label" for="inMinDays">Never judge members newer than</label></div>
                <div class="cf-row-control"><div class="cf-input-unit"><input id="inMinDays" type="number" min="0" max="365" class="form-control"><span class="cf-unit">days</span></div></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text"><label class="cf-row-label" for="inPerSweep">Most kicks per sweep</label><p class="cf-row-desc">From 1 to 100.</p></div>
                <div class="cf-row-control"><input id="inPerSweep" type="number" min="1" max="100" class="form-control"></div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text"><label class="cf-row-label" for="inPerDay">Most kicks per day</label><p class="cf-row-desc">From 1 to 1000.</p></div>
