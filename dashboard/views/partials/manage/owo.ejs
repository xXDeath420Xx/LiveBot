<%#
  OwO hunt: an animal-collecting game whose rewards go into the server's economy and leveling.
  API-driven (/api/guilds/:id/owo/*): every section loads and saves through the script below.
  Built on the settings-row kit (cf-settings.css). The channel and role pickers are rendered here from
  the guild (roles the bot cannot manage are greyed out); the script only sets which are selected.
  Everything the API returns is drawn with createElement/textContent.
  The master switch (owoEnabled, in the page header) saves as soon as it changes.
%>
<%
const owoBotTop = (() => { try { return guild.members.me.roles.highest.position; } catch (e) { return Infinity; } })();
const owoTextChannels = (locals.channels || []).filter(c => c.type === 0 || c.type === 5);
const owoRoles = (locals.roles || []).slice().sort((a, b) => (b.position || 0) - (a.position || 0));
%>
<%- include('_game-kit') %>
<div class="page-section" id="owoPage">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-paw"></i>
                <span>OwO hunt and zoo</span>
            </div>
            <div class="page-section-subtitle">Pays out in this server's economy currency and leveling XP, not a currency of its own.</div>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="OwO at a glance">
        <div class="cf-kpi"><dt>Hunters</dt><dd class="cf-kpi-value" id="stat-hunters">0</dd></div>
        <div class="cf-kpi"><dt>Different animals caught</dt><dd class="cf-kpi-value" id="stat-unique">0</dd></div>
        <div class="cf-kpi"><dt>Total catches</dt><dd class="cf-kpi-value" id="stat-total">0</dd></div>
        <div class="cf-kpi"><dt>Last 24 hours</dt><dd class="cf-kpi-value" id="stat-24h">0</dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="owo-status-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-status-title">Game</h2>
                <p class="cf-section-desc">Catches pay the currency on the <a href="?page=economy">Economy page</a>. Hunting never gives <a href="?page=leveling">Leveling</a> XP; the XP in a hunt goes to the member's OwO team.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoEnabled">OwO hunt</label>
                    <p class="cf-row-desc">Members in this server can hunt and collect animals.</p>
                </div>
                <div class="cf-row-control">
                    <input type="checkbox" class="cf-switch" role="switch" id="owoEnabled" data-feature-switch>
                </div>
            </div>
            <div class="cf-row cf-row--switch">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoAnnounceRare">Log rare catches</label>
                    <p class="cf-row-desc">Sends an <code>owoRareCatch</code> log event for every epic or rarer catch. Choose its channel on the <a href="?page=logging">Logging page</a>.</p>
                </div>
                <div class="cf-row-control">
                    <input type="checkbox" class="cf-switch" role="switch" id="owoAnnounceRare">
                </div>
            </div>
            <div class="cf-section-foot">
                <span class="cf-status-line owo-save-status" data-section="status" role="status"></span>
                <button type="button" class="btn btn-primary owo-save-btn" data-section="status">Save</button>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-preview-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-preview-title">In Discord</h2>
                <p class="cf-section-desc">A hunt is one line. Gems from lootboxes turn it into several catches at once.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="gk-preview gk-preview-grid">
                <div class="cf-dc" aria-label="Preview: a hunt without gems">
                    <%- include('_gk-author', { gkUsed: '/owo hunt' }) %>
                    <div class="cf-dc-text"><strong>🌱 | Alex</strong> caught a <strong>rare</strong> 🦊!</div>
                </div>
                <div class="cf-dc" aria-label="Preview: a hunt with gems">
                    <%- include('_gk-author', { gkUsed: '/owo hunt' }) %>
                    <div class="cf-dc-text"><strong>🌱 | Alex</strong>, hunt is empowered by 🔮<code>[24/100]</code> 🍀<code>[84/100]</code> !
<strong>▫️ |</strong> You found: 🐝 🐝 🐞 🐢
▫️ <strong>|</strong> 🐊 🐅 🐘 gained <strong>489xp</strong>!
<strong>📦 |</strong> You found a <strong>lootbox</strong>! <code>[1/3] RESETS IN: 20H 40M 59S</code></div>
                </div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-rarity-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-rarity-title">Catches by rarity</h2>
                <p class="cf-section-desc">Every catch in this server so far, by tier.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div id="stat-rank-bars" class="owo-rank-bars"></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-hunt-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-hunt-title">Hunting</h2>
                <p class="cf-section-desc">How often members can hunt and how much each catch pays.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoCooldownNum">Hunt cooldown</label>
                    <p class="cf-row-desc">Seconds between hunts, from 1 to 3600. The default is 15.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range">
                        <input type="range" id="owoCooldown" min="1" max="300" step="1" aria-label="Hunt cooldown">
                        <input type="number" id="owoCooldownNum" class="form-control" min="1" max="3600" aria-label="Hunt cooldown in seconds">
                    </div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoCurMulNum">Currency multiplier</label>
                    <p class="cf-row-desc">Scales the currency every catch pays. 1 is the standard rate.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range">
                        <input type="range" id="owoCurMul" min="0.1" max="10" step="0.1" aria-label="Currency multiplier">
                        <input type="number" id="owoCurMulNum" class="form-control" min="0.1" max="10" step="0.1" aria-label="Currency multiplier">
                    </div>
                </div>
            </div>
            <div class="cf-rows-head" id="owo-rewards-head">Rewards per rarity, after the multiplier</div>
            <div class="cf-table-wrap">
                <table class="cf-table">
                    <thead><tr><th scope="col">Rarity</th><th scope="col">Chance</th><th scope="col" class="cf-cell-end">Currency</th></tr></thead>
                    <tbody id="owoEffectiveRewards"></tbody>
                </table>
            </div>
            <div class="cf-section-foot">
                <span class="cf-status-line owo-save-status" data-section="hunt" role="status"></span>
                <button type="button" class="btn btn-primary owo-save-btn" data-section="hunt">Save</button>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-sellsac-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-sellsac-title">Selling and sacrificing</h2>
                <p class="cf-section-desc">Selling always keeps one of each animal. Higher multipliers make both more generous.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoSellMulNum">Sell price multiplier</label>
                    <p class="cf-row-desc">A fraction of the animal's hunt value. The default is 0.5.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range">
                        <input type="range" id="owoSellMul" min="0.1" max="10" step="0.05" aria-label="Sell price multiplier">
                        <input type="number" id="owoSellMulNum" class="form-control" min="0.1" max="10" step="0.05" aria-label="Sell price multiplier">
                    </div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoSacMulNum">Sacrifice essence multiplier</label>
                    <p class="cf-row-desc">Sacrificing pays OwO essence, not server XP. The default is 1.</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-range">
                        <input type="range" id="owoSacMul" min="0.1" max="10" step="0.05" aria-label="Sacrifice essence multiplier">
                        <input type="number" id="owoSacMulNum" class="form-control" min="0.1" max="10" step="0.05" aria-label="Sacrifice essence multiplier">
                    </div>
                </div>
            </div>
            <div class="cf-section-foot">
                <span class="cf-status-line owo-save-status" data-section="sellsac" role="status"></span>
                <button type="button" class="btn btn-primary owo-save-btn" data-section="sellsac">Save</button>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-access-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-access-title">Where and who</h2>
                <p class="cf-section-desc">Leave both empty to let everyone hunt everywhere.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoAllowedChannels">Hunting channels</label>
                    <p class="cf-row-desc">Where <code>/owo hunt</code> works. Choose none to allow every channel.</p>
                </div>
                <div class="cf-row-control">
                    <select id="owoAllowedChannels" multiple class="form-control">
                        <% owoTextChannels.forEach(c => { %><option value="<%= c.id %>" data-kind="text">#<%= c.name %></option><% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoBlockedRoles">Blocked roles</label>
                    <p class="cf-row-desc">Members with any of these roles cannot use OwO, such as a timeout role.</p>
                </div>
                <div class="cf-row-control">
                    <select id="owoBlockedRoles" multiple class="form-control">
                        <% owoRoles.forEach(r => { %><option value="<%= r.id %>" data-kind="role" data-color="<%= r.hexColor || '' %>"><%= r.name %></option><% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-section-foot">
                <span class="cf-status-line owo-save-status" data-section="access" role="status"></span>
                <button type="button" class="btn btn-primary owo-save-btn" data-section="access">Save</button>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-top-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-top-title">Leaderboards</h2>
                <p class="cf-section-desc">The top 10 in this server.</p>
            </div>
            <div class="cf-section-actions">
                <div class="cf-segmented" id="owoLbTabs" role="group" aria-label="Leaderboard">
                    <button type="button" class="cf-segment owo-tab active" aria-pressed="true" data-kind="hunters">Hunters</button>
                    <button type="button" class="cf-segment owo-tab" aria-pressed="false" data-kind="battle">Battle</button>
                    <button type="button" class="cf-segment owo-tab" aria-pressed="false" data-kind="wealth">Wealth</button>
                </div>
            </div>
        </header>
        <div class="cf-rows">
            <div id="owoLbBody" class="cf-list owo-top-list">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-snapshot-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-snapshot-title">Engagement</h2>
                <p class="cf-section-desc">How much of the wider game members use.</p>
            </div>
        </header>
        <dl id="owoSnapshot" class="cf-kpis owo-snapshot"></dl>
    </section>

    <section class="cf-section" aria-labelledby="owo-catalog-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-catalog-title">Animals</h2>
                <p class="cf-section-desc">Every animal in the game, by rarity.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div id="owoCatalogTabs" class="cf-segmented" role="group" aria-label="Rarity"></div>
                <div id="owoCatalogBody" class="owo-catalog-body"></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-admin-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-admin-title">Members</h2>
                <p class="cf-section-desc">Look up a member's zoo, give them animals, currency, shards or crates, or reset their zoo. Use their Discord user ID.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoLookupUserId">Look up a zoo</label>
                    <p class="cf-row-desc">Shows what they have caught, with an option to reset it.</p>
                </div>
                <div class="cf-input-group">
                    <input type="text" id="owoLookupUserId" class="form-control" placeholder="User ID" inputmode="numeric" data-no-savebar>
                    <button type="button" id="owoLookupBtn" class="btn btn-secondary">Look up</button>
                </div>
                <div id="owoUserResult" class="owo-user-result"></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoGrantUserId">Give an animal</label>
                    <p class="cf-row-desc">A negative count takes animals away.</p>
                </div>
                <div class="cf-fields">
                    <div class="cf-field"><input type="text" id="owoGrantUserId" class="form-control" placeholder="User ID" inputmode="numeric" aria-label="User ID" data-no-savebar></div>
                    <div class="cf-field"><select id="owoGrantAnimal" class="form-control" aria-label="Animal" data-no-savebar><option value="">Choose an animal</option></select></div>
                    <div class="cf-field"><input type="number" id="owoGrantCount" class="form-control" value="1" min="-100" max="100" aria-label="Count" data-no-savebar></div>
                    <div class="cf-field"><button type="button" id="owoGrantBtn" class="btn btn-secondary">Give</button></div>
                </div>
                <div id="owoGrantResult" class="owo-grant-result"></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoGrantEconUser">Give currency, shards or crates</label>
                    <p class="cf-row-desc">A negative amount takes them away.</p>
                </div>
                <div class="cf-fields">
                    <div class="cf-field"><input type="text" id="owoGrantEconUser" class="form-control" placeholder="User ID" inputmode="numeric" aria-label="User ID" data-no-savebar></div>
                    <div class="cf-field"><input type="number" id="owoGrantEconAmount" class="form-control" placeholder="Amount" aria-label="Amount" data-no-savebar></div>
                    <div class="cf-field">
                        <select id="owoGrantEconKind" class="form-control" aria-label="What to give" data-no-savebar>
                            <option value="currency">Currency</option>
                            <option value="shards">Shards</option>
                            <option value="crate">Crates</option>
                        </select>
                    </div>
                    <div class="cf-field"><button type="button" id="owoGrantEconBtn" class="btn btn-secondary">Give</button></div>
                </div>
                <div id="owoGrantEconResult" class="owo-grant-result"></div>
            </div>
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoFullUserId">Full profile</label>
                    <p class="cf-row-desc">Wallet, zoo, weapons, teams, autohunt, ranch and quests.</p>
                </div>
                <div class="cf-input-group">
                    <input type="text" id="owoFullUserId" class="form-control" placeholder="User ID" inputmode="numeric" data-no-savebar>
                    <button type="button" id="owoFullLookupBtn" class="btn btn-secondary">Load</button>
                </div>
                <div id="owoFullSnapshot" class="owo-user-result"></div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="owo-subs-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-subs-title">Commands <span class="gk-cmd-count" id="owoCmdCount"></span></h2>
                <p class="cf-section-desc">Switch a command off and members can no longer use it. Each one also works without the slash, shown under it. <code>/owo toggle</code> always stays available to admins.</p>
            </div>
        </header>
        <div class="cf-rows" id="owoSubs">
            <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null, id: null, boxed: false, compact: true }) %>
        </div>
        <div class="cf-form-actions owo-subs-save">
            <span class="cf-status-line owo-save-status" data-section="subs" role="status"></span>
            <button type="button" class="btn btn-primary owo-save-btn" data-section="subs">Save commands</button>
        </div>
    </section>

    <%- include('_game-commands', { gkCmdTitle: 'More commands', gkCmdNote: 'Always available while OwO is on.', gkCommands: [
        { cmd: 'owo', exclude: ['hunt', 'sell', 'sacrifice', 'daily', 'balance', 'give', 'zoo', 'leaderboard', 'catalog', 'stats'] },
        { cmd: 'owo2', as: 'owo' },
        { cmd: 'owo-profile', as: 'owo profile' },
        { cmd: 'autohunt', as: 'owo autohunt' },
    ] }) %>

    <section class="cf-section cf-section--danger" aria-labelledby="owo-reset-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="owo-reset-title">Reset every zoo</h2>
                <p class="cf-section-desc">Wipes every member's zoo and cooldowns in this server. It cannot be undone.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="owoResetConfirm">Type the server name to confirm</label>
                </div>
                <div class="cf-input-group">
                    <input type="text" id="owoResetConfirm" class="form-control" placeholder="Server name, exactly" data-no-savebar autocomplete="off">
                    <button type="button" id="owoResetGuildBtn" class="btn btn-danger" disabled>Reset every zoo</button>
                </div>
                <div id="owoResetResult" class="owo-grant-result"></div>
            </div>
        </div>
    </section>

    <p class="owo-license">
        Inspired by <a href="https://github.com/ChristopherBThai/Discord-OwO-Bot" target="_blank" rel="noopener">OwO Bot</a>
        (CC-BY-NC-SA-4.0); non-commercial use only. See <code>LICENSE-OWO-NOTICE.md</code>.
    </p>
</div>

<style>
/* OwO page: a rarity bar chart, a grid of catalog tiles and the member inspector panels. */
#owoPage .owo-group-label { font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text); }
#owoPage .owo-rank-bars { display: flex; flex-direction: column; gap: var(--cf-2); }
#owoPage .owo-rank-bar-row { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) 5rem; align-items: center; gap: var(--cf-3); font-size: var(--cf-text-sm); color: var(--cf-text); }
#owoPage .owo-rank-bar-row > :last-child { text-align: right; font-variant-numeric: tabular-nums; color: var(--cf-text-2); }
#owoPage .owo-rank-bar-outer { height: 8px; background: var(--cf-surface-3); border-radius: 999px; overflow: hidden; }
#owoPage .owo-rank-bar-inner { height: 100%; border-radius: 999px; background: var(--owo-tone); }
#owoPage #owoCatalogTabs .owo-tab { text-transform: capitalize; }
#owoPage .cf-rows .cf-row--stack > .cf-segmented { justify-self: start; }
#owoPage .owo-catalog-body { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr)); gap: var(--cf-2); margin-top: var(--cf-3); }
#owoPage .owo-catalog-body:empty { display: none; }
#owoPage .owo-catalog-item { display: flex; align-items: center; gap: var(--cf-2); padding: var(--cf-2) var(--cf-3); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); font-size: var(--cf-text-sm); color: var(--cf-text); min-width: 0; }
#owoPage .owo-catalog-key { font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-3); }
#owoPage .owo-meta { color: var(--cf-text-3); font-size: var(--cf-text-xs); text-align: right; }
#owoPage .owo-user-result, #owoPage .owo-grant-result { font-size: var(--cf-text-sm); color: var(--cf-text-2); }
#owoPage .owo-user-result:empty, #owoPage .owo-grant-result:empty { display: none; }
#owoPage .owo-panel { padding: var(--cf-3) var(--cf-4); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface-2); }
#owoPage .owo-panel ul { margin: 4px 0 0; padding-left: 1.2em; }
#owoPage .owo-panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--cf-3); margin-top: var(--cf-3); }
#owoPage .owo-panel-grid .owo-wide { grid-column: 1 / -1; }
#owoPage .owo-panel-btn { margin-top: var(--cf-3); }
#owoPage .owo-cmd-meta { display: block; margin-top: 1px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
#owoPage .owo-subs-save { margin: var(--cf-3) 0 0; }
#owoPage .owo-license { margin: var(--cf-6) 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
#owoPage .owo-license a { color: inherit; text-decoration: underline; }
@media (max-width: 640px) {
    #owoPage .owo-rank-bar-row { grid-template-columns: 5.5rem minmax(0, 1fr) 3.5rem; }
    #owoPage .cf-rows .cf-row--stack > .cf-segmented { justify-self: stretch; }
}
</style>

<script>
(function() {
    const guildId = '<%= guild.id %>';
    const guildName = <%- JSON.stringify(guild.name).replace(/</g, '\\u003c') %>;
    const botTop = <%- JSON.stringify(Number.isFinite(owoBotTop) ? owoBotTop : null).replace(/</g, '\\u003c') %>;
    const rolePos = <%- JSON.stringify(Object.fromEntries(owoRoles.map(r => [r.id, r.position || 0]))).replace(/</g, '\\u003c') %>;
    const baseUrl = '/api/guilds/' + guildId + '/owo';

    let config = null;
    let catalog = [];
    let commands = [];

    function $(id) { return document.getElementById(id); }
    // h('div', { className, text, attrs, data }, ...children): text always goes in as text.
    function h(tag, props, ...kids) {
        const n = document.createElement(tag);
        const p = props || {};
        if (p.className) n.className = p.className;
        if (p.text !== undefined) n.textContent = String(p.text);
        for (const [k, v] of Object.entries(p.attrs || {})) if (v !== false && v != null) n.setAttribute(k, v === true ? '' : v);
        for (const [k, v] of Object.entries(p.data || {})) n.dataset[k] = v;
        for (const kid of kids) if (kid != null) n.append(kid);
        return n;
    }
    const n = v => (Number(v) || 0).toLocaleString();
    const compact = (text) => h('div', { className: 'cf-state cf-state--compact' }, h('p', { className: 'cf-state-text', text }));

    // Roles above the bot's highest role cannot be handled by it; show them but do not offer them.
    if (botTop !== null) {
        Array.from($('owoBlockedRoles').options).forEach(o => {
            if ((rolePos[o.value] || 0) >= botTop) { o.disabled = true; o.textContent = o.textContent + ' (above the bot)'; }
        });
    }

    function showStatus(section, ok, message) {
        const el = document.querySelector('.owo-save-status[data-section="' + section + '"]');
        if (!el) return;
        el.textContent = ok ? (message || 'Saved.') : (message || 'Could not save.');
        el.classList.toggle('is-ok', ok);
        el.classList.toggle('is-bad', !ok);
        clearTimeout(el._owoClear);
        el._owoClear = setTimeout(() => { el.textContent = ''; el.classList.remove('is-ok', 'is-bad'); }, 2500);
    }

    async function api(path, opts) {
        const res = await fetch(baseUrl + path, Object.assign({ headers: { 'Content-Type': 'application/json' } }, opts || {}));
        return res.json().catch(() => ({ success: false, error: 'Invalid JSON response' }));
    }

    async function loadAll() {
        try {
            const [cfgR, statsR, catR, cmdR] = await Promise.all([
                fetch(baseUrl + '/config').then(r => r.json()).catch(() => ({})),
                fetch(baseUrl + '/stats').then(r => r.json()).catch(() => ({})),
                fetch(baseUrl + '/catalog').then(r => r.json()).catch(() => ({})),
                fetch(baseUrl + '/commands').then(r => r.json()).catch(() => ({})),
            ]);
            config = cfgR.config || {};
            catalog = catR.catalog || [];
            commands = cmdR.commands || [];
            hydrateStatus();
            hydrateStats(statsR.stats || {});
            hydrateHuntConfig();
            hydrateSellSac();
            hydrateSubcommands();
            hydrateAccessControl();
            hydrateCatalog();
            hydrateGrantSelect();
        } catch (e) {
            console.error('[OwO] loadAll failed', e);
        }
    }

    // ── Status
    let savedEnabled = null;
    function hydrateStatus() {
        $('owoEnabled').checked = !!config.enabled;
        savedEnabled = !!config.enabled;
        $('owoEnabled').dispatchEvent(new Event('change'));
        $('owoAnnounceRare').checked = config.announce_rare_catches !== 0;
    }
    // The header On/Off switch (cf-pagehead.js fires `input` on the real box) saves straight away.
    $('owoEnabled').addEventListener('input', async () => {
        const want = $('owoEnabled').checked;
        if (want === savedEnabled) return;
        const r = await api('/config', { method: 'PUT', body: JSON.stringify({ enabled: want }) });
        if (r.success) { savedEnabled = want; config = r.config || config; showStatus('status', true, want ? 'OwO is on.' : 'OwO is off.'); }
        else { $('owoEnabled').checked = !want; $('owoEnabled').dispatchEvent(new Event('change')); showStatus('status', false, r.error); }
    });

    // ── Stats
    function hydrateStats(s) {
        $('stat-hunters').textContent = n(s.hunters);
        $('stat-unique').textContent = n(s.uniqueCatches);
        $('stat-total').textContent = n(s.totalCatches);
        $('stat-24h').textContent = n(s.last24hCatches);

        const total = Math.max(1, s.totalCatches || 0);
        const byRank = Object.fromEntries((s.byRank || []).map(r => [r.rank, r.total]));
        const tones = { legendary: 'var(--cf-danger)', mythical: 'var(--cf-warning)', epic: 'var(--cf-accent)', rare: 'var(--cf-info)', uncommon: 'var(--cf-success)', common: 'var(--cf-text-3)' };
        const order = ['legendary', 'mythical', 'epic', 'rare', 'uncommon', 'common'];
        $('stat-rank-bars').replaceChildren(...order.map(r => {
            const count = Number(byRank[r]) || 0;
            const bar = h('div', { className: 'owo-rank-bar-inner' });
            bar.style.width = ((count / total) * 100).toFixed(1) + '%';
            bar.style.setProperty('--owo-tone', tones[r]);
            return h('div', { className: 'owo-rank-bar-row' },
                h('div', { text: r.charAt(0).toUpperCase() + r.slice(1) }),
                h('div', { className: 'owo-rank-bar-outer' }, bar),
                h('div', { text: count.toLocaleString() }));
        }));
    }

    // ── Hunting
    const RANKS = [
        ['Common', 58.85, 1], ['Uncommon', 30.00, 5], ['Rare', 10.00, 20],
        ['Epic', 1.00, 250], ['Mythical', 0.10, 3000], ['Legendary', 0.05, 10000],
    ];
    function renderEffectiveTable() {
        const cur = Number($('owoCurMulNum').value) || 1;
        $('owoEffectiveRewards').replaceChildren(...RANKS.map(([label, pct, base]) => h('tr', null,
            h('td', { text: label }), h('td', { text: pct + '%' }),
            h('td', { className: 'cf-cell-end', text: Math.max(1, Math.floor(base * cur)).toLocaleString() }))));
    }
    function syncPair(rangeId, numId, value) {
        const r = $(rangeId), num = $(numId);
        r.value = value; num.value = value;
        if (r.dataset.owoBound) return;
        r.dataset.owoBound = '1';
        r.addEventListener('input', () => { num.value = r.value; if (numId === 'owoCurMulNum') renderEffectiveTable(); });
        num.addEventListener('input', () => { r.value = num.value; if (numId === 'owoCurMulNum') renderEffectiveTable(); });
    }
    function hydrateHuntConfig() {
        syncPair('owoCooldown', 'owoCooldownNum', config.hunt_cooldown_seconds ?? 15);
        syncPair('owoCurMul', 'owoCurMulNum', config.reward_currency_multiplier ?? 1.0);
        renderEffectiveTable();
    }
    function hydrateSellSac() {
        syncPair('owoSellMul', 'owoSellMulNum', config.sell_multiplier ?? 0.5);
        syncPair('owoSacMul', 'owoSacMulNum', config.sacrifice_xp_multiplier ?? 1.0);
    }

    // ── Commands members can use (one list: switch, slash form, prefix form and aliases)
    function hydrateSubcommands() {
        const groups = [['Actions', 'Actions'], ['Economy', 'Economy'], ['Viewers', 'Viewing']];
        $('owoCmdCount').textContent = commands.length ? String(commands.length) : '';
        const rows = [];
        groups.forEach(([key, title]) => {
            const list = commands.filter(c => c.category === key);
            if (!list.length) return;
            rows.push(h('div', { className: 'cf-rows-head', text: title }));
            list.forEach(c => {
                const id = 'owoCmd-' + c.name;
                const meta = 'Prefix: ' + c.prefix + (c.aliases && c.aliases.length ? ' · also ' + c.aliases.join(', ') : '');
                rows.push(h('div', { className: 'cf-row cf-row--switch' },
                    h('div', { className: 'cf-row-text' },
                        h('label', { className: 'cf-row-label', attrs: { for: id } }, h('code', { className: 'gk-cmd-name', text: c.slash })),
                        h('p', { className: 'cf-row-desc' }, c.description || '', h('span', { className: 'owo-cmd-meta', text: meta }))),
                    h('div', { className: 'cf-row-control' },
                        h('input', { className: 'cf-switch owo-sub-cb', attrs: { type: 'checkbox', role: 'switch', id, checked: !!c.enabled }, data: { name: c.name } }))));
            });
        });
        $('owoSubs').replaceChildren(...(rows.length ? rows : [compact('Could not load the command list.')]));
    }

    // ── Where and who: options are server-rendered; only the selection comes from the config.
    function hydrateAccessControl() {
        const pick = (select, ids) => {
            const set = new Set(ids || []);
            Array.from(select.options).forEach(o => { o.selected = set.has(o.value); });
            select.dispatchEvent(new Event('change'));
        };
        pick($('owoAllowedChannels'), config.allowed_channel_ids);
        pick($('owoBlockedRoles'), config.blocked_role_ids);
    }

    // ── Catalog
    function hydrateCatalog() {
        if (!catalog.length) { $('owoCatalogTabs').replaceChildren(); $('owoCatalogBody').replaceChildren(compact('Could not load the animals.')); return; }
        $('owoCatalogTabs').replaceChildren(...catalog.map((tier, i) =>
            h('button', { className: 'cf-segment owo-tab' + (i === 0 ? ' active' : ''), attrs: { type: 'button', 'aria-pressed': String(i === 0) }, data: { rank: tier.rank } },
                tier.rank + ' ', h('span', { className: 'cf-cell-muted', text: tier.animals.length }))));
        renderCatalogBody(catalog[0].rank);
    }
    $('owoCatalogTabs').addEventListener('click', (e) => {
        const t = e.target.closest('.owo-tab');
        if (!t) return;
        $('owoCatalogTabs').querySelectorAll('.owo-tab').forEach(x => { x.classList.toggle('active', x === t); x.setAttribute('aria-pressed', String(x === t)); });
        renderCatalogBody(t.dataset.rank);
    });
    function renderCatalogBody(rank) {
        const tier = catalog.find(c => c.rank === rank);
        if (!tier) return;
        $('owoCatalogBody').replaceChildren(...tier.animals.map(a => h('div', { className: 'owo-catalog-item' },
            h('span', { attrs: { 'aria-hidden': 'true' }, text: a.emoji }),
            h('div', null, h('div', { text: a.name }), h('div', { className: 'owo-catalog-key', text: a.key })))));
    }

    // ── Admin: grant select
    function hydrateGrantSelect() {
        const sel = $('owoGrantAnimal');
        sel.replaceChildren(h('option', { attrs: { value: '' }, text: 'Choose an animal' }),
            ...catalog.map(tier => h('optgroup', { attrs: { label: tier.rank } },
                ...tier.animals.map(a => h('option', { attrs: { value: a.key }, text: a.emoji + ' ' + a.name })))));
    }

    // ── Save handlers (per section)
    async function saveSection(section) {
        const body = {};
        if (section === 'status') {
            body.enabled = $('owoEnabled').checked;
            body.announce_rare_catches = $('owoAnnounceRare').checked;
        } else if (section === 'hunt') {
            body.hunt_cooldown_seconds = Number($('owoCooldownNum').value);
            body.reward_currency_multiplier = Number($('owoCurMulNum').value);
        } else if (section === 'sellsac') {
            body.sell_multiplier = Number($('owoSellMulNum').value);
            body.sacrifice_xp_multiplier = Number($('owoSacMulNum').value);
        } else if (section === 'subs') {
            body.disabled_subcommands = Array.from(document.querySelectorAll('.owo-sub-cb'))
                .filter(cb => !cb.checked).map(cb => cb.dataset.name);
        } else if (section === 'access') {
            body.allowed_channel_ids = Array.from($('owoAllowedChannels').selectedOptions).map(o => o.value);
            body.blocked_role_ids = Array.from($('owoBlockedRoles').selectedOptions).map(o => o.value);
        }

        const result = await api('/config', { method: 'PUT', body: JSON.stringify(body) });
        if (result.success) {
            config = result.config;
            if (section === 'status') savedEnabled = !!config.enabled;
            showStatus(section, true);
        } else {
            showStatus(section, false, result.error || 'Could not save.');
        }
    }
    document.querySelectorAll('.owo-save-btn').forEach(btn => btn.addEventListener('click', () => saveSection(btn.dataset.section)));

    // ── Admin: results
    function renderResult(targetId, msg, ok) {
        $(targetId).replaceChildren(h('span', { className: 'cf-status-line ' + (ok ? 'is-ok' : 'is-bad'), text: msg }));
    }
    const renderError = (targetId, msg) => renderResult(targetId, msg, false);
    const who = (profile, userId) => profile && profile.tag
        ? h('span', null, h('strong', { text: profile.tag }), ' ', h('span', { className: 'cf-cell-muted', text: userId }))
        : h('span', null, h('code', { text: userId }), ' ', h('span', { className: 'cf-cell-muted', text: '(not in the server cache)' }));

    $('owoLookupBtn').addEventListener('click', async () => {
        const userId = $('owoLookupUserId').value.trim();
        if (!/^\d{15,25}$/.test(userId)) { renderError('owoUserResult', 'That is not a user ID.'); return; }
        $('owoUserResult').textContent = 'Loading…';
        const res = await fetch(baseUrl + '/user-zoo/' + encodeURIComponent(userId)).then(r => r.json()).catch(() => ({}));
        if (!res.success) { renderError('owoUserResult', res.error || 'Could not load that zoo.'); return; }
        renderUserZoo(userId, res);
    });

    function renderUserZoo(userId, res) {
        const zoo = res.zoo || {};
        const grouped = zoo.grouped || {};
        const order = ['legendary', 'mythical', 'epic', 'rare', 'uncommon', 'common'];
        const lines = order.filter(r => grouped[r]?.length).map(r =>
            h('div', null, h('strong', { text: r.charAt(0).toUpperCase() + r.slice(1) }), ': ' + grouped[r].map(a => a.emoji + '×' + a.count).join(' ')));
        const resetBtn = h('button', { className: 'btn btn-danger btn-sm owo-panel-btn', text: "Reset this member's zoo", attrs: { type: 'button' } });
        resetBtn.addEventListener('click', async () => {
            if (!confirm('Reset ' + userId + "'s zoo? This cannot be undone.")) return;
            const r = await api('/reset-user', { method: 'POST', body: JSON.stringify({ userId }) });
            if (r.success) renderResult('owoUserResult', 'Reset. ' + r.zooRowsRemoved + ' zoo rows and ' + r.cooldownsRemoved + ' cooldowns removed.', true);
            else renderError('owoUserResult', r.error || 'Could not reset.');
        });
        $('owoUserResult').replaceChildren(h('div', { className: 'owo-panel' },
            h('div', null, who(res.profile, userId), ' · ' + n(zoo.uniqueAnimals) + '/' + n(zoo.catalogSize || 58) + ' different · ' + n(zoo.totalCatches) + ' total'),
            ...(lines.length ? lines : [h('div', { className: 'cf-cell-muted', text: 'No animals yet.' })]),
            resetBtn));
    }

    $('owoGrantBtn').addEventListener('click', async () => {
        const userId = $('owoGrantUserId').value.trim();
        const animalKey = $('owoGrantAnimal').value;
        const count = Number($('owoGrantCount').value);
        if (!/^\d{15,25}$/.test(userId)) { renderError('owoGrantResult', 'That is not a user ID.'); return; }
        if (!animalKey) { renderError('owoGrantResult', 'Choose an animal.'); return; }
        const r = await api('/grant-animal', { method: 'POST', body: JSON.stringify({ userId, animalKey, count }) });
        if (r.success) renderResult('owoGrantResult', 'Done: ' + animalKey + ' (' + r.rank + ') is now at ' + r.newCount + '.', true);
        else renderError('owoGrantResult', r.error || 'Could not give it.');
    });

    $('owoResetConfirm').addEventListener('input', (e) => { $('owoResetGuildBtn').disabled = e.target.value !== guildName; });
    $('owoResetGuildBtn').addEventListener('click', async () => {
        if ($('owoResetConfirm').value !== guildName) return;
        if (!confirm('Wipe every zoo in this server? This cannot be undone.')) return;
        const r = await api('/reset-guild', { method: 'POST', body: JSON.stringify({ confirm: true }) });
        if (r.success) {
            renderResult('owoResetResult', 'Every zoo reset. ' + r.zooRowsRemoved + ' zoo rows and ' + r.cooldownsRemoved + ' cooldowns removed.', true);
            $('owoResetConfirm').value = '';
            $('owoResetGuildBtn').disabled = true;
        } else {
            renderError('owoResetResult', r.error || 'Could not reset.');
        }
    });

    // ── Engagement
    async function loadSnapshot() {
        const res = await fetch(baseUrl + '/module-snapshot').then(r => r.json()).catch(() => ({}));
        if (!res.success) { $('owoSnapshot').hidden = true; return; }
        const s = res.snapshot;
        const tiles = [
            ['Hunters', s.hunters], ['Weapon owners', s.weaponOwners], ['Teams', s.teamOwners], ['Battles fought', s.battlesFought],
            ['Autohunt on', s.autohuntActive], ['Quest holders', s.questHolders], ['Crates unopened', s.cratesUnopened], ['Total shards', s.totalShards],
        ];
        $('owoSnapshot').replaceChildren(...tiles.map(([label, v]) => h('div', { className: 'cf-kpi' }, h('dt', { text: label }), h('dd', { className: 'cf-kpi-value', text: n(v) }))));
    }

    // ── Leaderboards
    async function loadLeaderboard(kind) {
        const body = $('owoLbBody');
        const res = await fetch(baseUrl + '/leaderboard/' + encodeURIComponent(kind)).then(r => r.json()).catch(() => ({}));
        if (!res.success) { body.replaceChildren(h('div', { className: 'cf-state cf-state--compact cf-state--error' }, h('p', { className: 'cf-state-title', text: 'Could not load the leaderboard.' }))); return; }
        const rows = res.leaderboard || [];
        if (!rows.length) { body.replaceChildren(compact('Nobody on this board yet.')); return; }
        body.replaceChildren(...rows.map((r, i) => {
            let meta = '';
            if (kind === 'hunters') meta = n(r.total) + ' catches · ' + (r.legendary || 0) + ' legendary, ' + (r.mythical || 0) + ' mythical, ' + (r.epic || 0) + ' epic';
            else if (kind === 'battle') meta = (r.wins || 0) + ' won, ' + (r.losses || 0) + ' lost · streak ' + (r.streak || 0) + ' (best ' + (r.highestStreak || 0) + ')';
            else if (kind === 'wealth') meta = n(r.wallet);
            return h('div', { className: 'cf-list-item' },
                h('span', { className: 'cf-list-main' }, h('span', { className: 'cf-em', text: i + 1 }), ' ',
                    h('span', { data: { userId: r.userId, userSize: 'sm' } }, h('code', { text: r.userId }))),
                h('span', { className: 'owo-meta', text: meta }));
        }));
        if (window.CFUser && typeof CFUser.scan === 'function') CFUser.scan(body);
    }
    $('owoLbTabs').addEventListener('click', (e) => {
        const t = e.target.closest('.owo-tab');
        if (!t) return;
        $('owoLbTabs').querySelectorAll('.owo-tab').forEach(x => { x.classList.toggle('active', x === t); x.setAttribute('aria-pressed', String(x === t)); });
        loadLeaderboard(t.dataset.kind);
    });

    // ── Admin: currency, shards and crates; full profile
    $('owoGrantEconBtn').addEventListener('click', async () => {
        const userId = $('owoGrantEconUser').value.trim();
        const amount = Number($('owoGrantEconAmount').value);
        const kind = $('owoGrantEconKind').value;
        if (!/^\d{15,25}$/.test(userId)) { renderError('owoGrantEconResult', 'That is not a user ID.'); return; }
        if (!Number.isFinite(amount) || amount === 0) { renderError('owoGrantEconResult', 'Enter an amount other than 0.'); return; }
        const endpoint = kind === 'crate' ? '/grant-crate' : kind === 'shards' ? '/grant-shards' : '/grant-currency';
        const body = kind === 'crate' ? { userId, count: amount } : { userId, amount };
        const r = await api(endpoint, { method: 'POST', body: JSON.stringify(body) });
        if (r.success) renderResult('owoGrantEconResult', 'Gave ' + amount + ' ' + (kind === 'crate' ? 'crate(s)' : kind) + '. New total: ' + r.total + '.', true);
        else renderError('owoGrantEconResult', r.error || 'Could not give them.');
    });

    $('owoFullLookupBtn').addEventListener('click', async () => {
        const userId = $('owoFullUserId').value.trim();
        if (!/^\d{15,25}$/.test(userId)) { renderError('owoFullSnapshot', 'That is not a user ID.'); return; }
        $('owoFullSnapshot').textContent = 'Loading…';
        const res = await fetch(baseUrl + '/user-full/' + encodeURIComponent(userId)).then(r => r.json()).catch(() => ({}));
        if (!res.success) { renderError('owoFullSnapshot', res.error || 'Could not load that profile.'); return; }
        renderFullSnapshot(userId, res);
    });

    function block(title, ...content) { return h('div', null, h('div', { className: 'owo-group-label', text: title }), ...content); }
    const list = (items) => h('ul', null, ...(items.length ? items.map(t => h('li', { text: t })) : [h('li', { text: 'None' })]));
    function renderFullSnapshot(userId, r) {
        const weapons = (r.weapons?.top || []).slice(0, 5).map(w => `${w.rank} ${w.name} #${w.uwid}${w.favorite ? ' (favourite)' : ''}`);
        const teams = (r.teams || []).map(t => `${t.tname} (pgid ${t.pgid}) · ${t.win} won, ${t.lose} lost · streak ${t.streak}${t.active ? ' · active' : ''}`);
        const roster = r.activeTeam ? (r.activeTeam.animals || []).map(a => `Position ${a.pos}: ${a.name}${a.nickname ? ' (' + a.nickname + ')' : ''} [${a.rank}]${a.weapon ? ' · weapon: ' + a.weapon.rank + ' ' + a.weapon.name : ''}`) : [];
        const quests = (r.quests || []).map(q => `${q.qid} ${q.qname} ${q.count}/${q.target}${q.complete ? ' (done)' : ''} → ${q.reward} ${q.prize}`);
        $('owoFullSnapshot').replaceChildren(h('div', { className: 'owo-panel' },
            h('div', null, who(r.profile, userId), ' · wallet ' + n(r.wallet) + ' · ' + n(r.shards) + ' shards · ' + n(r.luck?.lifetimeRolls) + ' luck rolls'),
            h('div', { className: 'owo-panel-grid' },
                block('Zoo', r.zoo ? `${n(r.zoo.uniqueAnimals)}/${n(r.zoo.catalogSize)} different · ${n(r.zoo.totalCatches)} total · ${(Number(r.zoo.completionPct) || 0).toFixed(1)}%` : 'None'),
                block('Weapons', 'Total: ' + n(r.weapons?.total), list(weapons)),
                block('Teams', list(teams)),
                block('Active team', list(roster)),
                block('Autohunt', r.autohunt?.enabled ? `On · queued ${r.autohunt.queued}/${r.autohunt.queuedCap} · next in ${r.autohunt.nextInMinutes}m · lifetime ${r.autohunt.totalLifetime}` : 'Off'),
                block('Ranch', r.ranch?.hasTeam ? `${r.ranch.hourlyRate}/hr · ${r.ranch.hoursAccrued}h waiting = ${r.ranch.pendingPayout}` : 'No team'),
                h('div', { className: 'owo-wide' }, h('div', { className: 'owo-group-label', text: 'Active quests' }), list(quests)))));
    }

    loadAll().then(() => { loadSnapshot(); loadLeaderboard('hunters'); });
})();
</script>
