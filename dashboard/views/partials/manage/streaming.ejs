.empty-state-title-modern { font-size: 1.1rem; font-weight: 600; color: rgba(255, 255, 255, 0.9); margin-bottom: 8px; }
.empty-state-description-modern { font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); margin-bottom: 20px; }

/* ---- Action Buttons ---- */
.action-buttons { display: flex; gap: 6px; justify-content: flex-end; }
.btn-action {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(167, 139, 250, 0.3);
    color: #a78bfa;
    cursor: pointer;
    transition: all 0.2s;
