}
.team-info-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
}
.team-info-label i { color: #a78bfa; font-size: 0.7rem; }
.team-info-value { font-size: 0.85rem; font-weight: 600; color: #ffffff; }
.btn-team-settings {
    padding: 6px 12px;
    background: rgba(167, 139, 250, 0.15);
    border: 1px solid rgba(167, 139, 250, 0.3);
