                            <div style="margin-bottom:16px;">
                                <label class="form-label">Update Interval (minutes)</label>
                                <input class="form-input" type="number" name="syncIntervalMinutes" id="twitch-sched-edit-interval" min="15" max="10080">
                                <div class="form-help">15–10080 (1 week). Default: 360 (6 hr).</div>
                            </div>
                            <div style="margin-bottom:20px;">
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="checkbox" name="weeklyRefresh" id="twitch-sched-edit-weekly" style="width:16px; height:16px;">
                                    <span style="color:rgba(255,255,255,0.8);">Weekly Fresh Post (delete old + post new every 7 days)</span>
