    cursor: pointer;
    font-size: 0.9rem;
}
.at-btn-add:hover { opacity: 0.9; }
.at-form-group { margin-bottom: 16px; }
.at-form-label { display: block; font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,0.7); margin-bottom: 6px; }
.at-form-hint { font-size: 0.7rem; color: rgba(255,255,255,0.4); margin-top: 4px; }
