}
.sched-table tbody tr:last-child td { border-bottom: none; }
.sched-table tbody tr:hover { background: rgba(167,139,250,0.06); }

/* ---- Edit on End status message ---- */
.eoe-status-msg {
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    margin-bottom: 16px;
    display: none;
}
.eoe-status-msg.success { display: block; background: rgba(167, 139, 250, 0.15); color: #c4b5fd; border: 1px solid rgba(167, 139, 250, 0.3); }
.eoe-status-msg.error { display: block; background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }

/* ---- Form Styling ---- */
.form-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 6px;
}
.form-help {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 4px;
}
.form-control, .form-select {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 8px;
    padding: 10px 14px;
    color: #fff;
    font-size: 0.85rem;
    width: 100%;
}
.form-control:focus, .form-select:focus {
    outline: none;
    border-color: rgba(167, 139, 250, 0.5);
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.1);
}

/* ---- Checkbox styling for webhook persona ---- */
.form-check-inline {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
}
.form-check-inline input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #a78bfa;
    cursor: pointer;
}

/* ---- Responsive ---- */
@media (max-width: 1200px) {
    .streamers-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .sched-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .settings-grid { grid-template-columns: 1fr; }
    .settings-grid-full { grid-column: span 1; }
}
@media (max-width: 768px) {
    .streamers-stats-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 8px; }
    .sched-stats-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 8px; }
    .settings-grid { grid-template-columns: 1fr !important; }
    .settings-grid-full { grid-column: span 1 !important; }
    .streamers-table .mobile-hide { display: none !important; }
    .streamers-table-wrapper { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .streamers-table thead th, .streamers-table tbody td { padding: 8px 10px !important; }
    .streaming-tab-nav { flex-wrap: wrap; }
    .streaming-tab-btn { flex: 1; min-width: 0; text-align: center; justify-content: center; padding: 8px 12px; font-size: 0.8rem; }
    .teams-stats-grid { grid-template-columns: 1fr; }
    .teams-grid { grid-template-columns: 1fr; }
    .team-info-grid { grid-template-columns: 1fr; }
    .team-card-header { flex-direction: column; gap: 12px; align-items: flex-start; }
    .at-form-grid { grid-template-columns: 1fr; }
}
</style>

<!-- ========================================
     PAGE HEADER
     ======================================== -->
<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-video"></i>
                <span>Streaming</span>
            </div>
            <div class="page-section-subtitle">
                Manage all streaming features: announcements, streamers, teams, auto-track, and schedules
            </div>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-streamer-modal">
            <i class="fas fa-plus"></i>
            <span>Add Streamer</span>
        </button>
    </div>

    <!-- ========================================
         WARNING BANNER (no default channel)
         ======================================== -->
    <% if (!defaultChannelId) { %>
        <div class="warning-banner">
            <i class="fas fa-exclamation-triangle"></i>
            <div class="warning-banner-text">
                <strong>No default announcement channel configured.</strong> Streamers using "Server Default" won't post announcements until you set one below.
            </div>
        </div>
    <% } %>

    <!-- ========================================
         GLOBAL DEFAULTS (always visible)
         ======================================== -->
    <div class="global-defaults-card">
        <div class="global-defaults-header">
            <div class="global-defaults-title">
                <i class="fas fa-bullhorn"></i>
                Global Defaults
            </div>
            <span class="settings-status-badge <%= defaultChannelId ? 'configured' : 'not-configured' %>" style="padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; <%= defaultChannelId ? 'background: rgba(16,185,129,0.15); color: #10b981; border: 1px solid rgba(16,185,129,0.3);' : 'background: rgba(245,158,11,0.15); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3);' %>">
                <%= defaultChannelId ? 'Configured' : 'Not Set' %>
            </span>
        </div>
        <div class="global-defaults-body">
            <form action="/manage/<%= guild.id %>/update-announcements" method="POST">
                <div class="settings-grid">
                    <div>
                        <label class="form-label">Default Channel</label>
                        <select class="form-select" name="announcement_channel_id">
                            <option value="">Disabled</option>
                            <% channels.forEach(channel => { %>
                                <option value="<%= channel.id %>" <%= defaultChannelId === channel.id ? 'selected' : '' %>>
                                    #<%= channel.name %>
                                </option>
                            <% }); %>
                        </select>
                        <div class="form-help">Channel for streamers using "Server Default"</div>
                    </div>
                    <div>
                        <label class="form-label">Live Role</label>
                        <select class="form-select" name="live_role_id">
                            <option value="">No Role</option>
                            <% roles.forEach(role => { %>
                                <option value="<%= role.id %>" <%= defaultLiveRoleId === role.id ? 'selected' : '' %>>
                                    <%= role.name %>
                                </option>
                            <% }); %>
                        </select>
                        <div class="form-help">Auto-assigned when Discord users go live</div>
                    </div>
                    <div>
                        <label class="form-label">Use Webhook Persona</label>
                        <div class="form-check-inline">
                            <input type="checkbox" name="use_webhook_persona" value="1" id="webhook-persona-check" <%= useWebhookPersona ? 'checked' : '' %>>
                            <label for="webhook-persona-check" style="font-size: 0.85rem; color: rgba(255,255,255,0.7); cursor: pointer;">
                                Post announcements as the streamer's persona via webhook
                            </label>
                        </div>
                    </div>
                    <div>
                        <!-- Spacer for grid alignment -->
                    </div>
                    <div class="settings-grid-full">
                        <label class="form-label">Message Template</label>
                        <textarea class="form-control" name="announcement_message" rows="2" style="font-family: monospace; font-size: 0.8rem;"><%= defaultMessage %></textarea>
                        <div class="form-help">Variables: {streamer}, {platform}, {game}, {url}, {title}, {everyone}</div>
                    </div>
                    <div class="settings-grid-full">
                        <label class="form-label">Ignored Roles</label>
                        <select class="form-select" name="stream_ignored_roles" multiple size="3" style="min-height: 80px;" id="ignored-roles-select-streaming">
                            <% roles.forEach(role => { %>
                                <option value="<%= role.id %>"
                                    <%= ignoredRoles.includes(role.id) ? 'selected' : '' %>>
                                    <%= role.name %>
                                </option>
                            <% }); %>
                        </select>
                        <div class="form-help">
                            Streamers with any of these roles won't trigger live notifications (Ctrl+Click to select multiple)
                            <span id="ignored-roles-count-streaming" style="color: #a78bfa; font-weight: 600;"></span>
                        </div>
                    </div>
                </div>
                <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
                    <button type="submit" class="btn btn-primary" style="padding: 8px 16px; font-size: 0.85rem;">
                        <i class="fas fa-save"></i> Save Defaults
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================
         TAB NAVIGATION
         ======================================== -->
    <div class="streaming-tab-nav">
        <button class="streaming-tab-btn" data-tab="streamers" onclick="switchStreamingTab('streamers')">
            <i class="fas fa-video"></i>
            <span>Streamers</span>
            <span class="tab-count"><%= consolidatedStreamers?.length || 0 %></span>
        </button>
        <button class="streaming-tab-btn" data-tab="teams" onclick="switchStreamingTab('teams')">
            <i class="fas fa-users-cog"></i>
            <span>Teams</span>
            <span class="tab-count"><%= teamSubscriptions?.length || 0 %></span>
        </button>
        <button class="streaming-tab-btn" data-tab="auto-track" onclick="switchStreamingTab('auto-track')">
            <i class="fas fa-satellite-dish"></i>
            <span>Auto-Track</span>
            <span class="tab-count"><%= atConfigs.length %></span>
        </button>
        <button class="streaming-tab-btn" data-tab="schedules" onclick="switchStreamingTab('schedules')">
            <i class="fab fa-twitch"></i>
            <span>Schedules</span>
            <span class="tab-count"><%= syncs.length %></span>
        </button>
        <button class="streaming-tab-btn" data-tab="role-sync" onclick="switchStreamingTab('role-sync')">
            <i class="fas fa-sync-alt"></i>
            <span>Role Sync</span>
            <span class="tab-count"><%= typeof twitchRoleSyncConfig !== 'undefined' && twitchRoleSyncConfig ? '1' : '0' %></span>
        </button>
    </div>

    <!-- ========================================
         TAB: STREAMERS
         ======================================== -->
    <div class="streaming-tab-content" data-tab="streamers">

        <!-- Stats Overview -->
        <div class="streamers-stats-grid">
            <div class="stat-card-compact">
                <div class="stat-card-label">Streamers</div>
                <div class="stat-card-value"><%= consolidatedStreamers?.length || 0 %></div>
            </div>
            <div class="stat-card-compact">
                <div class="stat-card-label">Subscriptions</div>
                <div class="stat-card-value"><%= consolidatedStreamers?.reduce((sum, s) => sum + (s.subscriptions?.length || 0), 0) || 0 %></div>
            </div>
            <div class="stat-card-compact">
                <div class="stat-card-label">Platforms</div>
                <div class="stat-card-value"><%= new Set(consolidatedStreamers?.flatMap(s => s.platforms || []) || []).size %></div>
            </div>
            <div class="stat-card-compact">
                <div class="stat-card-label">Discord Linked</div>
                <div class="stat-card-value success"><%= consolidatedStreamers?.filter(s => s.discord_user_id).length || 0 %></div>
            </div>
        </div>

        <!-- Edit on End status message -->
        <div id="eoe-status" class="eoe-status-msg"></div>

        <!-- Search + Bulk Actions Bar -->
        <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 16px;">
            <div class="search-wrapper" style="flex: 1; margin-bottom: 0;">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="streamerSearch" class="search-input" placeholder="Search streamers...">
            </div>
            <button class="btn btn-secondary" id="bulk-actions-btn" style="display: none; white-space: nowrap;"
                    data-bs-toggle="modal" data-bs-target="#bulk-actions-modal">
                <i class="fas fa-layer-group"></i>
                <span>Bulk Actions (<span id="bulk-count">0</span>)</span>
            </button>
        </div>

        <!-- Streamers Table -->
        <% if (consolidatedStreamers && consolidatedStreamers.length > 0) { %>
            <div class="streamers-table-wrapper">
                <table class="streamers-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;" class="mobile-hide">
                                <input type="checkbox" id="select-all-streamers" class="form-check-input" title="Select All">
                            </th>
                            <th>Streamer</th>
                            <th>Platforms</th>
                            <th class="mobile-hide">Subscriptions</th>
                            <th class="mobile-hide">Status</th>
                            <th class="mobile-hide">Edit on End</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="streamersTableBody">
                        <% consolidatedStreamers.forEach(streamer => {
                            // Get the first subscription for the edit_on_end toggle
                            const firstSub = streamer.subscriptions && streamer.subscriptions.length > 0 ? streamer.subscriptions[0] : null;
                            const firstSubId = firstSub ? (firstSub.id || firstSub.subscription_id) : null;
                            const firstSubEditOnEnd = firstSubId ? (editOnEndMap[firstSubId] || false) : false;
                        %>
                            <tr class="streamer-row" data-streamer-name="<%= (streamer.name || '').toLowerCase() %>" data-platforms="<%= ((streamer.platforms || []).join(' ')).toLowerCase() %>" data-subscription-ids="<%= (streamer.subscriptions || []).map(s => s.id || s.subscription_id).filter(Boolean).join(',') %>">
                                <td class="mobile-hide">
                                    <input type="checkbox" class="form-check-input streamer-checkbox">
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div class="streamer-avatar">
                                            <i class="fas fa-video" style="color: #a78bfa; font-size: 0.9rem;"></i>
                                        </div>
                                        <div>
                                            <div class="streamer-name"><%= streamer.name %></div>
                                            <% if (streamer.discord_user_id) { %>
                                                <div class="streamer-meta">
                                                    <i class="fab fa-discord"></i> Linked
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="platform-badges">
                                        <% streamer.platforms.forEach(platform => {
                                            const colors = {
                                                twitch: '#9146FF',
                                                youtube: '#FF0000',
                                                kick: '#53FC18',
                                                tiktok: '#000',
                                                trovo: '#1BC981',
                                                facebook: '#1877F2',
                                                instagram: '#E4405F'
                                            };
                                            const color = colors[platform.toLowerCase()] || '#6B7280';
                                        %>
                                            <span class="platform-badge" style="background: <%= color %>; color: white;"><%= platform %></span>
                                        <% }); %>
                                    </div>
                                </td>
                                <td class="mobile-hide">
                                    <span class="subscription-badge"><%= streamer.subscriptions.length %></span>
                                </td>
                                <td class="mobile-hide">
                                    <span class="status-badge <%= streamer.is_blacklisted ? 'blacklisted' : 'active' %>">
                                        <%= streamer.is_blacklisted ? 'Blocked' : 'Active' %>
                                    </span>
                                </td>
                                <td class="mobile-hide">
                                    <% if (firstSubId) { %>
                                        <label class="eoe-toggle" title="Toggle edit-on-end for this streamer's first subscription">
                                            <input type="checkbox"
                                                data-sub-id="<%= firstSubId %>"
                                                <%= firstSubEditOnEnd ? 'checked' : '' %>
                                                onchange="toggleEoeInline(this)">
                                            <span class="eoe-toggle-track" style="background: <%= firstSubEditOnEnd ? '#a78bfa' : 'rgba(255,255,255,0.1)' %>;"></span>
                                            <span class="eoe-toggle-dot" style="left: <%= firstSubEditOnEnd ? '18px' : '2px' %>;"></span>
                                        </label>
                                    <% } else { %>
                                        <span style="color: rgba(255,255,255,0.3); font-size: 0.75rem;">-</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-action edit-streamer-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#edit-streamer-modal"
                                                data-streamer="<%- JSON.stringify(streamer).replace(/"/g, '&quot;') %>">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state-modern">
                <div class="empty-state-icon-modern">
                    <i class="fas fa-video"></i>
                </div>
                <div class="empty-state-title-modern">No Streamers Yet</div>
                <div class="empty-state-description-modern">
                    Add your first streamer to start receiving live notifications across 7 platforms
                </div>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-streamer-modal">
                    <i class="fas fa-plus"></i>
                    <span>Add First Streamer</span>
                </button>
            </div>
        <% } %>
    </div>

    <!-- ========================================
         TAB: TEAMS
         ======================================== -->
    <div class="streaming-tab-content" data-tab="teams">

        <!-- Stats Overview -->
        <div class="teams-stats-grid">
            <div class="team-stat-card">
                <div class="team-stat-label">Total Teams</div>
                <div class="team-stat-value"><%= teamSubscriptions?.length || 0 %></div>
            </div>
            <div class="team-stat-card">
                <div class="team-stat-label">Active Channels</div>
                <div class="team-stat-value"><%= teamSubscriptions?.filter(t => t.announcement_channel_id).length || 0 %></div>
            </div>
            <div class="team-stat-card">
                <div class="team-stat-label">With Live Role</div>
                <div class="team-stat-value"><%= teamSubscriptions?.filter(t => t.live_role_id).length || 0 %></div>
            </div>
        </div>

        <% if (teamSubscriptions && teamSubscriptions.length > 0) { %>
            <div class="teams-grid">
                <% teamSubscriptions.forEach(team => { %>
                    <div class="team-card">
                        <div class="team-card-header">
                            <div class="team-card-title">
                                <div class="team-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div>
                                    <h3 class="team-name"><%= team.team_name %></h3>
                                    <div class="team-subtitle">Team Subscription</div>
                                </div>
                            </div>
                            <div class="team-actions">
                                <button class="btn-team-settings edit-team-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#teamSettingsModal"
                                        data-team='<%= JSON.stringify(team) %>'>
                                    <i class="fas fa-cog"></i>
                                    <span>Settings</span>
                                </button>
                                <form action="/manage/<%= guild.id %>/delete-team" method="POST" class="d-inline" onsubmit="return confirm('Are you sure? This will remove all associated streamers.');">
                                    <input type="hidden" name="teamId" value="<%= team.id %>">
                                    <button type="submit" class="btn-team-delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="team-card-body">
                            <div class="team-info-grid">
                                <div class="team-info-item">
                                    <div class="team-info-label">
                                        <i class="fas fa-hashtag"></i>
                                        <span>Announcement Channel</span>
                                    </div>
                                    <div class="team-info-value">
                                        #<%= channels.find(c => c.id === team.announcement_channel_id)?.name || 'Default' %>
                                    </div>
                                </div>
                                <div class="team-info-item">
                                    <div class="team-info-label">
                                        <i class="fas fa-at"></i>
                                        <span>Live Role</span>
                                    </div>
                                    <div class="team-info-value">
                                        @<%= roles.find(r => r.id === team.live_role_id)?.name || 'None' %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="teams-empty-state">
                <div class="teams-empty-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="teams-empty-title">No Team Subscriptions</div>
                <div class="teams-empty-description">
                    Subscribe to streaming teams to automatically track all team members and receive live notifications
                </div>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTeamModal">
                    <i class="fas fa-plus"></i>
                    <span>Add First Team</span>
                </button>
            </div>
        <% } %>
    </div>

    <!-- ========================================
         TAB: AUTO-TRACK
         ======================================== -->
    <div class="streaming-tab-content" data-tab="auto-track">

        <div class="at-callout">
            <strong>Fallback System:</strong> Auto-Track detects when guild members start streaming on Twitch
            (via Discord presence) and automatically creates a streamer subscription. Members already tracked
            by <strong>Self-Promo</strong>, <strong>Teams</strong>, or <strong>manual subscriptions</strong>
            are automatically skipped to prevent duplicate announcements.
        </div>

        <div id="at-status" class="at-status-msg"></div>

        <!-- Existing Mappings -->
        <div class="at-card">
            <div class="at-card-header">
                <i class="fas fa-list"></i>
                <h3>Active Mappings</h3>
            </div>
            <div class="at-card-body">
                <% if (atConfigs.length === 0) { %>
                    <div class="at-empty">No auto-track mappings configured yet. Add one below.</div>
                <% } else { %>
                    <% atConfigs.forEach((config, index) => {
                        const deleteOnEnd = config.delete_on_end !== undefined ? config.delete_on_end : 1;
                        const editOnEnd = config.edit_on_end !== undefined ? config.edit_on_end : 0;
                        let streamEndVal = 'delete';
                        if (deleteOnEnd && editOnEnd) streamEndVal = 'edit';
                        else if (!deleteOnEnd && !editOnEnd) streamEndVal = 'keep';
                    %>
                        <div class="at-mapping-card" data-auto-id="<%= config.auto_id %>">
                            <div class="at-mapping-header">
                                <div class="at-mapping-title">
                                    <span class="at-badge <%= config.enabled ? 'at-badge-on' : 'at-badge-off' %>">
                                        <%= config.enabled ? 'Enabled' : 'Disabled' %>
                                    </span>
                                    Mapping #<%= index + 1 %>
                                </div>
                                <div class="at-mapping-actions">
                                    <button class="at-btn at-btn-save" onclick="atEdit(<%= config.auto_id %>)">
                                        <i class="fas fa-save"></i> Save
                                    </button>
                                    <button class="at-btn at-btn-toggle" onclick="atToggle(<%= config.auto_id %>)">
                                        <%= config.enabled ? 'Disable' : 'Enable' %>
                                    </button>
                                    <button class="at-btn at-btn-delete" onclick="atDelete(<%= config.auto_id %>)">Delete</button>
                                </div>
                            </div>
                            <div class="at-form-grid">
                                <div class="at-form-group">
                                    <label class="at-form-label">Role</label>
                                    <select id="at-role-<%= config.auto_id %>" class="at-form-select">
                                        <option value="" <%= !config.role_id ? 'selected' : '' %>>Any Member</option>
                                        <% atRoles.forEach(role => { %>
                                            <option value="<%= role.id %>" <%= config.role_id === role.id ? 'selected' : '' %>><%= role.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="at-form-group">
                                    <label class="at-form-label">Announcement Channel</label>
                                    <select id="at-channel-<%= config.auto_id %>" class="at-form-select">
                                        <% atChannels.forEach(ch => { %>
                                            <option value="<%= ch.id %>" <%= config.announcement_channel_id === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="at-form-group">
                                    <label class="at-form-label">Live Role</label>
                                    <select id="at-liverole-<%= config.auto_id %>" class="at-form-select">
                                        <option value="" <%= !config.live_role_id ? 'selected' : '' %>>Guild Default</option>
                                        <% atRoles.forEach(role => { %>
                                            <option value="<%= role.id %>" <%= config.live_role_id === role.id ? 'selected' : '' %>>@<%= role.name %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="at-form-group">
                                    <label class="at-form-label">When Stream Ends</label>
                                    <select id="at-streamend-<%= config.auto_id %>" class="at-form-select">
                                        <option value="delete" <%= streamEndVal === 'delete' ? 'selected' : '' %>>Delete message</option>
                                        <option value="edit" <%= streamEndVal === 'edit' ? 'selected' : '' %>>Edit to "Stream Ended"</option>
                                        <option value="keep" <%= streamEndVal === 'keep' ? 'selected' : '' %>>Keep as-is</option>
                                    </select>
                                    <div class="at-form-hint">What happens to the announcement when the stream ends</div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <!-- Add Mapping -->
        <div class="at-card">
            <div class="at-card-header">
                <i class="fas fa-plus-circle"></i>
                <h3>Add Mapping</h3>
            </div>
            <div class="at-card-body">
                <form id="at-add-form">
                    <div class="at-form-grid">
                        <div class="at-form-group">
                            <label class="at-form-label">Role</label>
                            <select name="role_id" class="at-form-select">
                                <option value="">Any Member</option>
                                <% atRoles.forEach(role => { %>
                                    <option value="<%= role.id %>"><%= role.name %></option>
                                <% }); %>
                            </select>
                            <div class="at-form-hint">Select "Any Member" to track all streaming members</div>
                        </div>
                        <div class="at-form-group">
                            <label class="at-form-label">Announcement Channel</label>
                            <select name="announcement_channel_id" class="at-form-select" required>
                                <option value="">Select a channel...</option>
                                <% atChannels.forEach(ch => { %>
                                    <option value="<%= ch.id %>">#<%= ch.name %></option>
                                <% }); %>
                            </select>
                            <div class="at-form-hint">Where auto-tracked stream announcements will be posted</div>
                        </div>
                        <div class="at-form-group">
                            <label class="at-form-label">Live Role</label>
                            <select name="live_role_id" class="at-form-select">
                                <option value="">Guild Default</option>
                                <% atRoles.forEach(role => { %>
                                    <option value="<%= role.id %>">@<%= role.name %></option>
                                <% }); %>
                            </select>
                            <div class="at-form-hint">Role assigned when streamer goes live (leave empty for guild default)</div>
                        </div>
                        <div class="at-form-group">
                            <label class="at-form-label">When Stream Ends</label>
                            <select name="stream_end" class="at-form-select">
                                <option value="delete">Delete message</option>
                                <option value="edit">Edit to "Stream Ended"</option>
                                <option value="keep">Keep as-is</option>
                            </select>
                            <div class="at-form-hint">What happens to the announcement when the stream ends</div>
                        </div>
                    </div>
                    <button type="submit" class="at-btn-add">
                        <i class="fas fa-plus"></i> Add Mapping
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ========================================
         TAB: SCHEDULES
         ======================================== -->
    <div class="streaming-tab-content" data-tab="schedules">

        <!-- Stats Overview -->
        <div class="sched-stats-grid">
            <div class="sched-stat-card">
                <div class="stat-card-label">Active Syncs</div>
                <div class="stat-card-value"><%= syncs.length %></div>
            </div>
            <div class="sched-stat-card">
                <div class="stat-card-label">Twitch Streamers</div>
                <div class="stat-card-value" style="color: #9146FF;"><%= twitchStreamers.length %></div>
            </div>
            <div class="sched-stat-card">
                <div class="stat-card-label">Channels Used</div>
                <div class="stat-card-value"><%= new Set(syncs.map(s => s.channel_id)).size %></div>
            </div>
            <div class="sched-stat-card">
                <div class="stat-card-label">Auto-Update</div>
                <div class="stat-card-value success" style="font-size: 1.2rem;">
                    <i class="fas fa-check-circle"></i> Enabled
                </div>
            </div>
        </div>

        <!-- Add Schedule Sync -->
        <div class="sched-add-card">
            <h3 class="sched-card-title">
                <i class="fas fa-calendar-plus"></i>
                Add Schedule Sync
            </h3>
            <div class="sched-card-subtitle">
                Sync a Twitch streamer's schedule to automatically post updates
            </div>
            <form action="/manage/<%= guild.id %>/twitch-schedules/sync" method="POST">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                    <div>
                        <label class="form-label">Twitch Streamer</label>
                        <select class="form-select" name="streamerId" required>
                            <option value="">Select streamer</option>
                            <% twitchStreamers.forEach(streamer => { %>
                                <% const twitchSub = streamer.subscriptions?.find(sub => sub.platform === 'twitch'); %>
                                <% if (twitchSub) { %>
                                    <option value="<%= twitchSub.streamer_id %>"><%= twitchSub.platform_username || streamer.name %></option>
                                <% } %>
                            <% }) %>
                        </select>
                        <div class="form-help">Must be a Twitch streamer</div>
                    </div>
                    <div>
                        <label class="form-label">Post Schedule In</label>
                        <select class="form-select" name="channelId" required>
                            <option value="">Select channel</option>
                            <% channels.forEach(channel => { %>
                                <option value="<%= channel.id %>">#<%= channel.name %></option>
                            <% }) %>
                        </select>
                        <div class="form-help">Where to post updates</div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: end;">
                    <div>
                        <label class="form-label">Update Interval (minutes)</label>
                        <input class="form-input" type="number" name="syncIntervalMinutes" min="15" max="10080" value="360">
                        <div class="form-help">How often the bot checks for changes. 15–10080 (1 week). Default: 360 (6 hr).</div>
                    </div>
                    <div>
                        <label class="form-label">Weekly Fresh Post</label>
                        <label style="display: flex; align-items: center; gap: 8px; padding: 10px 0; cursor: pointer;">
                            <input type="checkbox" name="weeklyRefresh" style="width: 16px; height: 16px;">
                            <span style="color: rgba(255,255,255,0.8); font-size: 0.9rem;">Delete old embed + post new every 7 days</span>
                        </label>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px 20px;">
                            <i class="fas fa-save"></i>
                            <span>Create Sync</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Existing Syncs -->
        <div class="sched-list-card">
            <h3 class="sched-card-title">
                <i class="fas fa-calendar-check"></i>
                Active Schedule Syncs
            </h3>
            <div class="sched-card-subtitle">
                Manage your configured schedule synchronizations
            </div>

            <% if (syncs.length > 0) { %>
                <div class="sched-table-wrapper">
                    <table class="sched-table">
                        <thead>
                            <tr>
                                <th style="width: 24%;">Streamer</th>
                                <th style="width: 22%;">Channel</th>
                                <th style="width: 12%;">Interval</th>
                                <th style="width: 14%;">Mode</th>
                                <th style="width: 28%;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% syncs.forEach(sync => { %>
                                <% const channel = channels.find(c => c.id === sync.channel_id); %>
                                <% const intervalMin = sync.sync_interval_minutes || 360; %>
                                <% const intervalLabel = intervalMin >= 60 ? (intervalMin / 60) + ' hr' : intervalMin + ' min'; %>
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <i class="fab fa-twitch" style="color: #9146FF; font-size: 1.1rem;"></i>
                                            <a href="https://twitch.tv/<%= sync.twitch_username || '' %>" target="_blank" style="font-weight: 600; color: #9146FF; text-decoration: none;">
                                                <%= sync.twitch_username || 'Unknown Streamer' %>
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <i class="fas fa-hashtag" style="color: rgba(255,255,255,0.4); font-size: 0.85rem;"></i>
                                            <span style="color: rgba(255,255,255,0.7);">
                                                <%= channel ? channel.name : 'Unknown Channel' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span style="color: rgba(255,255,255,0.75); font-size: 0.85rem;"><%= intervalLabel %></span>
                                    </td>
                                    <td>
                                        <% if (sync.weekly_refresh) { %>
                                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; background: rgba(145,70,255,0.15); color: #b18fff;">
                                                <i class="fas fa-sync-alt"></i> Weekly fresh
                                            </span>
                                        <% } else { %>
                                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.5);">
                                                <i class="fas fa-edit"></i> Edit in place
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div style="display: inline-flex; gap: 6px;">
                                            <button type="button" class="btn-action" style="color: #60a5fa; border-color: rgba(96,165,250,0.3);"
                                                onclick="openTwitchSchedEdit('<%= sync.id %>', <%= intervalMin %>, <%= sync.weekly_refresh ? 'true' : 'false' %>)">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                            <form action="/manage/<%= guild.id %>/twitch-schedules/force-sync" method="POST" style="display: inline;">
                                                <input type="hidden" name="syncId" value="<%= sync.id %>">
                                                <button type="submit" class="btn-action" style="color: #34d399; border-color: rgba(52,211,153,0.3);" title="Force sync now">
                                                    <i class="fas fa-bolt"></i> Sync
                                                </button>
