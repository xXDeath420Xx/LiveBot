/* ---- Settings Grid ---- */
.settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}
.settings-grid-full {
    grid-column: span 2;
}

/* ---- Warning Banner ---- */
.warning-banner {
