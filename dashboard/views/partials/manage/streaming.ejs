}
.team-icon i { font-size: 0.9rem; color: #a78bfa; }
.team-name { font-size: 1rem; font-weight: 600; color: #ffffff; margin: 0; }
.team-subtitle { font-size: 0.7rem; color: rgba(255, 255, 255, 0.5); margin-top: 2px; }
.team-actions { display: flex; gap: 8px; }
.team-card-body { padding: 14px 16px; }
.team-info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.team-info-item {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
