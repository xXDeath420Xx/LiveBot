<!-- ========================================
     JAVASCRIPT
     ======================================== -->
<script>
/* =============================================
   TAB SWITCHING
   ============================================= */
function switchStreamingTab(tabName) {
    document.querySelectorAll('.streaming-tab-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tabName));
    document.querySelectorAll('.streaming-tab-content').forEach(el => el.classList.toggle('active', el.dataset.tab === tabName));
    // Update URL without reload
    const url = new URL(window.location);
    url.searchParams.set('tab', tabName);
    history.replaceState(null, '', url);
    // Lazy-load the Twitch mods/VIPs mapping panel when the role-sync tab is opened
    if (tabName === 'role-sync') trsLoadModsVips();
}

/* =============================================
   TWITCH ROLE-SYNC: live mod/VIP mapping panel
   All DOM constructed with createElement/textContent (no innerHTML)
   to avoid XSS even though every external value goes through validation.
   ============================================= */
const TRS_GUILD_ID = '<%= guild.id %>';

function trsEl(tag, attrs = {}, ...children) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
        if (k === 'style' && typeof v === 'object') Object.assign(e.style, v);
        else if (k === 'dataset' && typeof v === 'object') Object.assign(e.dataset, v);
        else if (k === 'onClick') e.addEventListener('click', v);
        else if (k === 'className') e.className = v;
        else if (k === 'text') e.textContent = v;
        else e.setAttribute(k, v);
    }
    for (const c of children.flat()) {
        if (c == null || c === false) continue;
        e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
    }
    return e;
}

async function trsLoadModsVips() {
    const summary = document.getElementById('trs-mods-vips-summary');
    const list    = document.getElementById('trs-mods-vips-list');
    if (!summary || !list) return;
    summary.textContent = 'Loading…';
    list.replaceChildren();
    try {
        const resp = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/mods-vips`, { headers: { 'Accept': 'application/json' } });
        const data = await resp.json();
        if (data.error) {
            summary.replaceChildren(trsEl('span', { style: { color: '#fb923c' } }, `Cannot fetch from Twitch: `, trsEl('code', { text: data.error }), data.message ? ' — ' + data.message : ''));
            return;
        }
        const all = [...data.mods, ...data.vips];
        const linked   = all.filter(x => x.discord_user_id).length;
        const bots     = all.filter(x => x.is_known_bot).length;
        const unlinked = all.length - linked - bots;

        summary.replaceChildren(
            trsEl('strong', { text: String(data.counts.mods_total) }), ' Twitch mods, ',
            trsEl('strong', { text: String(data.counts.vips_total) }), ' VIPs',
            ' · ', trsEl('span', { style: { color: '#22c55e' }, text: `${linked} linked` }),
            ' · ', trsEl('span', { style: { color: '#fbbf24' }, text: `${unlinked} unlinked` }),
            ' · ', trsEl('span', { style: { color: 'var(--text-muted)' }, text: `${bots} bot(s)` }),
            ' · broadcaster ', trsEl('strong', { text: data.broadcaster.twitch_username }),
        );

        if (all.length === 0) {
            list.appendChild(trsEl('div', { style: { padding: '14px', color: 'var(--text-muted)', textAlign: 'center', fontSize: '0.85rem' }, text: 'No mods or VIPs returned by Twitch.' }));
        } else {
            for (const row of all) list.appendChild(trsBuildRow(row));
        }

        // Reveal auto-link button only when there are high-confidence suggestions to apply
        const autoBtn = document.getElementById('trs-autolink-btn');
        if (autoBtn) {
            const candidates = all.filter(r => !r.discord_user_id && !r.is_known_bot && r.suggestion?.score >= 90);
            if (candidates.length > 0) {
                autoBtn.style.display = '';
                autoBtn.textContent = '';
                autoBtn.appendChild(trsEl('i', { className: 'fas fa-wand-magic-sparkles' }));
                autoBtn.appendChild(document.createTextNode(` Auto-link ${candidates.length} high-confidence match${candidates.length === 1 ? '' : 'es'}`));
                autoBtn.onclick = () => trsAutoLinkAll(candidates);
            } else {
                autoBtn.style.display = 'none';
            }
        }
    } catch (err) {
        summary.replaceChildren(trsEl('span', { style: { color: '#ef4444' }, text: 'Fetch failed: ' + err.message }));
    }
}

async function trsAutoLinkAll(candidates) {
    if (!confirm(`Auto-link ${candidates.length} Twitch mods/VIPs using high-confidence username matches?\n\nEach match has a score of 90 or higher (case-insensitive exact match, normalized exact match, or edit-distance ≤ 1). You can unlink any individual row afterward if a match is wrong.`)) return;
    const btn = document.getElementById('trs-autolink-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Linking…'; }
    let succeeded = 0, failed = 0;
    for (const row of candidates) {
        try {
            const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/link`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    twitch_user_id: row.twitch_user_id,
                    twitch_username: row.twitch_username,
                    discord_user_id: row.suggestion.discord_user_id,
                }),
            });
            const j = await r.json();
            if (j.success) succeeded++; else failed++;
        } catch { failed++; }
    }
    alert(`Auto-link finished — ${succeeded} linked, ${failed} failed.`);
    trsLoadModsVips();
}

function trsBuildRow(row) {
    const badge = row.type === 'mod'
        ? trsEl('span', { style: { background: 'rgba(96,165,250,0.18)', color: '#60a5fa', padding: '2px 8px', borderRadius: '4px', fontSize: '0.7rem', fontWeight: '600' }, text: 'MOD' })
        : trsEl('span', { style: { background: 'rgba(251,191,36,0.18)', color: '#fbbf24', padding: '2px 8px', borderRadius: '4px', fontSize: '0.7rem', fontWeight: '600' }, text: 'VIP' });

    const twitchCell = trsEl('div',
        { style: { display: 'flex', alignItems: 'center', gap: '8px', minWidth: '200px' } },
        badge,
        trsEl('span', { style: { color: '#9146FF', fontWeight: '600' }, text: row.twitch_display_name || row.twitch_username }),
        trsEl('span', { style: { color: 'var(--text-muted)', fontSize: '0.7rem' }, text: '@' + row.twitch_username }),
    );

    let action;
    if (row.is_known_bot) {
        action = trsEl('span', { style: { color: 'var(--text-muted)', fontStyle: 'italic', fontSize: '0.75rem' }, text: 'Known Twitch bot — no Discord mapping' });
    } else if (row.discord_user_id) {
        const children = [
            trsEl('span', { style: { fontSize: '0.75rem', color: '#22c55e' } },
                trsEl('i', { className: 'fas fa-link' }), ' linked to ',
                trsEl('code', { text: row.discord_user_id })),
            trsEl('span', { style: { fontSize: '0.65rem', color: 'var(--text-muted)' }, text: 'via ' + row.link_source }),
        ];
        if (row.link_source === 'community_twitch_links') {
            const unlinkBtn = trsEl('button',
                { className: 'btn btn-sm btn-secondary', style: { padding: '2px 8px', fontSize: '0.7rem' }, dataset: { discordId: row.discord_user_id }, onClick: (e) => trsUnlink(e.currentTarget) },
                trsEl('i', { className: 'fas fa-times' })
            );
            children.push(unlinkBtn);
        }
        action = trsEl('div', { style: { display: 'flex', alignItems: 'center', gap: '8px' } }, ...children);
    } else {
        const input = trsEl('input',
            { list: 'trs-discord-members', type: 'text', className: 'form-input form-input-sm',
              placeholder: 'Pick or paste Discord user ID…',
              style: { fontSize: '0.75rem', padding: '4px 8px', width: '240px' },
              dataset: { trsInput: 'discord_id' } }
        );
        // Pre-fill input with suggestion if confident enough
        if (row.suggestion?.score >= 60) input.value = row.suggestion.discord_user_id;

        const linkBtn = trsEl('button',
            { className: 'btn btn-sm btn-primary',
              style: { padding: '2px 10px', fontSize: '0.75rem' },
              dataset: { twitchId: row.twitch_user_id, twitchUsername: row.twitch_username },
              onClick: (e) => trsLink(e.currentTarget) },
            trsEl('i', { className: 'fas fa-link' }), ' Link'
        );

        const children = [input, linkBtn];

        // Suggestion badge — color-coded by confidence
        if (row.suggestion) {
            const s = row.suggestion;
            const color = s.score >= 90 ? '#22c55e' : s.score >= 75 ? '#84cc16' : '#fbbf24';
            const badge = trsEl('span',
                { style: { fontSize: '0.7rem', color, marginLeft: '6px', whiteSpace: 'nowrap' },
                  title: s.reason },
                trsEl('i', { className: 'fas fa-wand-magic-sparkles' }),
                ` ${s.discord_username}`,
                trsEl('span', { style: { color: 'var(--text-muted)', marginLeft: '4px' }, text: `(${s.score})` }),
            );
            children.push(badge);
        }
        action = trsEl('div', { style: { display: 'flex', alignItems: 'center', gap: '6px', flexWrap: 'wrap' } }, ...children);
    }

    return trsEl('div',
        { style: { display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '8px 12px', borderBottom: '1px solid rgba(255,255,255,0.04)' } },
        twitchCell, action,
    );
}

async function trsLink(btn) {
    const row = btn.closest('div');
    const input = row?.querySelector('input[data-trs-input="discord_id"]');
    const discord_user_id = input?.value?.trim();
    if (!discord_user_id || !/^\d{15,21}$/.test(discord_user_id)) {
        alert('Pick a Discord user from the dropdown (or paste a numeric user ID).');
        return;
    }
    btn.disabled = true;
    try {
        const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/link`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                twitch_user_id: btn.dataset.twitchId,
                twitch_username: btn.dataset.twitchUsername,
                discord_user_id,
            }),
        });
        const j = await r.json();
        if (j.success) trsLoadModsVips();
        else { alert(`Link failed: ${j.error || 'unknown'} ${j.message || ''}`); btn.disabled = false; }
    } catch (err) {
        alert('Link failed: ' + err.message);
        btn.disabled = false;
    }
}

async function trsUnlink(btn) {
    if (!confirm('Remove this Twitch ↔ Discord link?')) return;
    btn.disabled = true;
    try {
        const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/unlink`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discord_user_id: btn.dataset.discordId }),
        });
        const j = await r.json();
        if (j.success) trsLoadModsVips();
        else { alert(`Unlink failed: ${j.error}`); btn.disabled = false; }
    } catch (err) {
        alert('Unlink failed: ' + err.message);
        btn.disabled = false;
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('trs-refresh-btn');
    if (btn) btn.addEventListener('click', trsLoadModsVips);
});

/* =============================================
   STREAMERS TAB JS
   ============================================= */
function waitForBootstrap(callback, maxAttempts = 50) {
    let attempts = 0;
    function check() {
        if (typeof bootstrap !== 'undefined') {
            callback();
        } else if (attempts < maxAttempts) {
            attempts++;
            setTimeout(check, 50);
        } else {
            callback();
        }
    }
    check();
}

// Run immediately — partial is rendered after DOM is ready
(function() {
    // Init tab from URL param
    const params = new URLSearchParams(window.location.search);
    const tab = params.get('tab') || 'streamers';
    switchStreamingTab(tab);

    waitForBootstrap(() => {
        const modal = document.getElementById('edit-streamer-modal');
        if (!modal) return;

        document.querySelectorAll('.edit-streamer-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                const modalEl = document.getElementById('edit-streamer-modal');
                if (!modalEl) return;

                const streamerData = btn.getAttribute('data-streamer');

                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    try {
                        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modalEl._streamerData = streamerData;
                        modalEl._triggerButton = btn;
                        bsModal.show();
                    } catch (err) {
                        openModalManually(modalEl, btn);
                    }
                } else {
                    openModalManually(modalEl, btn);
                }
            });
        });
    });

    function openModalManually(modalEl, btn) {
        modalEl._triggerButton = btn;

        let backdrop = document.querySelector('.modal-backdrop');
        if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            document.body.appendChild(backdrop);
        }

        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        modalEl.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');

        const event = new CustomEvent('show.bs.modal', {
            bubbles: true,
            detail: { relatedTarget: btn }
        });
        modalEl.dispatchEvent(event);

        backdrop.onclick = () => closeModalManually(modalEl);

        modalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(closeBtn => {
            closeBtn.addEventListener('click', () => closeModalManually(modalEl));
        });

        document.addEventListener('keydown', function escHandler(e) {
            if (e.key === 'Escape') {
                closeModalManually(modalEl);
                document.removeEventListener('keydown', escHandler);
            }
        });
    }

    function closeModalManually(modalEl) {
        modalEl.classList.remove('show');
        modalEl.style.display = 'none';
        modalEl.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
        document.querySelector('.modal-backdrop')?.remove();
    }

    // Search functionality
    const searchInput = document.getElementById('streamerSearch');
    const tableBody = document.getElementById('streamersTableBody');

    if (searchInput && tableBody) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const rows = tableBody.querySelectorAll('.streamer-row');

            rows.forEach(row => {
                const name = row.dataset.streamerName;
                const platforms = row.dataset.platforms;

                if (name.includes(query) || platforms.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }

    // Ignored roles count
    const ignoredSelect = document.getElementById('ignored-roles-select-streaming');
    const ignoredCount = document.getElementById('ignored-roles-count-streaming');
    if (ignoredSelect && ignoredCount) {
        function updateIgnoredCount() {
            const count = ignoredSelect.selectedOptions.length;
            ignoredCount.textContent = count > 0 ? ` \u2014 ${count} role(s) selected` : '';
        }
        updateIgnoredCount();
        ignoredSelect.addEventListener('change', updateIgnoredCount);
    }
})();

/* ---- Bulk selection logic ---- */
function updateBulkSelection() {
    const checked = document.querySelectorAll('.streamer-checkbox:checked');
    const bulkBtn = document.getElementById('bulk-actions-btn');
    const bulkCount = document.getElementById('bulk-count');
    const selectAll = document.getElementById('select-all-streamers');

    if (bulkBtn) bulkBtn.style.display = checked.length > 0 ? '' : 'none';
    if (bulkCount) bulkCount.textContent = checked.length;

    const subIds = [];
    checked.forEach(cb => {
        const row = cb.closest('tr');
        const ids = (row?.dataset.subscriptionIds || '').split(',').filter(Boolean);
        subIds.push(...ids);
    });
    window._bulkSelectedSubscriptionIds = subIds;

    const countEl = document.getElementById('bulk-selection-count');
    if (countEl) countEl.textContent = checked.length + ' streamer(s) selected (' + subIds.length + ' subscription(s))';

    const allCheckboxes = document.querySelectorAll('.streamer-checkbox');
    if (selectAll && allCheckboxes.length > 0) {
        selectAll.checked = checked.length === allCheckboxes.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < allCheckboxes.length;
    }
}

document.getElementById('select-all-streamers')?.addEventListener('change', function() {
    document.querySelectorAll('.streamer-checkbox').forEach(cb => { cb.checked = this.checked; });
    updateBulkSelection();
});

document.addEventListener('change', function(e) {
    if (e.target.classList.contains('streamer-checkbox')) updateBulkSelection();
});

/* ---- Edit on End inline toggle ---- */
async function toggleEoeInline(checkbox) {
    const subId = checkbox.dataset.subId;
    const editOnEnd = checkbox.checked;
    const status = document.getElementById('eoe-status');
    const track = checkbox.parentElement.querySelector('.eoe-toggle-track');
    const dot = checkbox.parentElement.querySelector('.eoe-toggle-dot');

    try {
        const res = await fetch('/api/guilds/<%= guild.id %>/stream-ended/subscriptions/' + subId, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ edit_on_end: editOnEnd })
        });
        const data = await res.json();
        if (data.success) {
            track.style.background = editOnEnd ? '#a78bfa' : 'rgba(255,255,255,0.1)';
            dot.style.left = editOnEnd ? '18px' : '2px';
            status.textContent = 'Edit-on-end updated!';
            status.className = 'eoe-status-msg success';
        } else {
            checkbox.checked = !editOnEnd;
            status.textContent = data.error || 'Failed to update';
            status.className = 'eoe-status-msg error';
        }
    } catch (err) {
        checkbox.checked = !editOnEnd;
        status.textContent = 'Network error';
        status.className = 'eoe-status-msg error';
    }
    setTimeout(() => { status.className = 'eoe-status-msg'; }, 3000);
}

/* =============================================
   TEAMS TAB JS
   ============================================= */
(function() {
    const teamSettingsModal = document.getElementById('teamSettingsModal');
    if (teamSettingsModal) {
        teamSettingsModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget || teamSettingsModal._triggerButton;
            if (!button) return;

            const team = JSON.parse(button.getAttribute('data-team'));

            document.getElementById('modal-team-name').textContent = team.team_name;
            document.getElementById('edit-team-subscription-id').value = team.id;
            document.getElementById('edit-team-channel-id').value = team.announcement_channel_id || '';
            document.getElementById('edit-team-live-role-id').value = team.live_role_id || '';
            document.getElementById('edit-team-webhook-name').value = team.webhook_name || '';
            document.getElementById('edit-team-webhook-avatar-url').value = team.webhook_avatar_url || '';
        });
    }
})();

/* =============================================
   AUTO-TRACK TAB JS
   ============================================= */
const atGuildId = '<%= guild.id %>';

function atShowStatus(msg, type) {
    const el = document.getElementById('at-status');
    el.textContent = msg;
    el.className = 'at-status-msg ' + type;
    setTimeout(() => { el.className = 'at-status-msg'; }, 4000);
}

function atParseStreamEnd(val) {
    if (val === 'edit') return { delete_on_end: true, edit_on_end: true };
    if (val === 'keep') return { delete_on_end: false, edit_on_end: false };
    return { delete_on_end: true, edit_on_end: false };
}

document.getElementById('at-add-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const streamEnd = atParseStreamEnd(e.target.stream_end.value);
    const body = {
        role_id: e.target.role_id.value || null,
        announcement_channel_id: e.target.announcement_channel_id.value,
        live_role_id: e.target.live_role_id.value || null,
        delete_on_end: streamEnd.delete_on_end,
        edit_on_end: streamEnd.edit_on_end
    };
    if (!body.announcement_channel_id) {
        atShowStatus('Please select a channel.', 'error');
        return;
    }
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            atShowStatus(data.error || 'Failed to add mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
});

async function atEdit(autoId) {
    try {
        const streamEnd = atParseStreamEnd(document.getElementById(`at-streamend-${autoId}`).value);
        const body = {
            role_id: document.getElementById(`at-role-${autoId}`).value || null,
            announcement_channel_id: document.getElementById(`at-channel-${autoId}`).value,
            live_role_id: document.getElementById(`at-liverole-${autoId}`).value || null,
            delete_on_end: streamEnd.delete_on_end,
            edit_on_end: streamEnd.edit_on_end
        };
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs/${autoId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}: ${text.substring(0, 100)}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            atShowStatus('Mapping updated successfully', 'success');
        } else {
            atShowStatus(data.error || 'Failed to update mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
}

async function atToggle(autoId) {
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs/${autoId}/toggle`, { method: 'PATCH' });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            atShowStatus(data.error || 'Failed to toggle mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
}

async function atDelete(autoId) {
    if (!confirm('Remove this auto-track mapping?')) return;
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs/${autoId}`, { method: 'DELETE' });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            atShowStatus(data.error || 'Failed to delete mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
}
</script>
