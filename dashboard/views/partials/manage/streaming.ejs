<%#
  Streaming: one partial for the streamers, teams, announcements (appearance), stream-ended,
  auto-track, twitch-schedules, role-sync and analytics pages; each opens on its own tab
  (window.MANAGE_PAGE_TAB, or ?tab=). Tabs: streamers (list with live / last notified, the stream-end
  defaults, the live role check and recently removed), teams, announcements (the server-wide defaults,
  POST update-announcements, with a live preview and a test post; then the live style, live-style.ejs),
  auto-track and live channel routing, Twitch schedule syncs, Twitch role sync and analytics.
  Built on the settings-row kit (cf-settings.css); the preview is /js/cf-msgpreview.js.
%>
<%
const announcementSettings = settings || {};
const defaultChannelId = announcementSettings.announcement_channel_id || '';
const defaultLiveRoleId = announcementSettings.live_role_id || '';
// The box used to be pre-filled with this text, so most servers saved it without choosing it; the bot
// treats it as "not set" (utils/announcer.js), and so does this page.
const defaultMessage = (announcementSettings.announcement_message || '').trim() === '{streamer} is now live on {platform}! {url}'
    ? '' : (announcementSettings.announcement_message || '');
const useWebhookPersona = announcementSettings.use_webhook_persona === 1;
const ignoredRoles = announcementSettings.stream_ignored_roles || [];
const seSubscriptions = typeof streamEndedSubs !== 'undefined' ? streamEndedSubs : [];
const atConfigs = typeof autoTrackConfigs !== 'undefined' ? autoTrackConfigs : [];
const atRoles = typeof roles !== 'undefined' ? roles : [];
const atChannels = typeof channels !== 'undefined' ? channels : [];
// Role-based live channel routing (subs > team > normal)
const lrRules = typeof liveRoutingRules !== 'undefined' ? (liveRoutingRules || []) : [];
const lrIntegrationRoles = typeof integrationRoles !== 'undefined' ? integrationRoles : [];
// Integration roles (Twitch sub tiers) are filtered out of `roles`, so merge both lists.
const lrRoles = [...atRoles.map(r => ({ id: r.id, name: r.name, integration: false })),
                 ...lrIntegrationRoles.map(r => ({ id: r.id, name: r.name, integration: true }))];
const syncs = (typeof twitchScheduleSyncs !== 'undefined' && twitchScheduleSyncs) || [];
const schedTemplates = typeof scheduleTemplates !== 'undefined' ? (scheduleTemplates || []) : [];
/* Ready-made looks. Each one is a prompt the generator understands; picking one
   writes it into the prompt box so it can still be edited by hand afterwards. */
const schedThemes = [
    ['Dark metal', 'dark grunge metal poster, torn paper texture, chrome and black, red accents'],
    ['Neon cyberpunk', 'neon cyberpunk cityscape at night, magenta and cyan glow, rain-slick reflections'],
    ['Retro arcade', 'retro 80s arcade poster, chrome grid horizon, sunset gradient, VHS grain'],
    ['Gothic horror', 'gothic horror poster, candlelight, deep crimson and charcoal, ornate frame'],
    ['Cosy autumn', 'cosy autumn scene, warm amber and rust, soft bokeh lights, hand-drawn feel'],
    ['Ice and frost', 'frozen landscape, pale blue and white, frost crystals, cold clean light'],
    ['Galaxy', 'deep space nebula, violet and teal starfield, glowing dust clouds'],
    ['Pastel kawaii', 'soft pastel kawaii illustration, pink and lilac, sparkles, rounded shapes'],
];
const twitchStreamers = consolidatedStreamers ? consolidatedStreamers.filter(s => s.platforms?.includes('twitch')) : [];

// Build a lookup map: subscription_id -> edit_on_end
const editOnEndMap = {};
seSubscriptions.forEach(sub => {
    editOnEndMap[sub.subscription_id] = !!sub.edit_on_end;
});
%>
<%
// The tab this page opens on, so the right one is showing before any script runs (the script
// still honours ?tab= and re-selects on load). Mirrors the `tab` of each page in the pageMap.
const stOpenTab = ({ teams: 'teams', announcements: 'appearance', 'auto-track': 'auto-track', 'twitch-schedules': 'schedules' })[typeof page !== 'undefined' ? page : ''] || 'streamers';
const stTab = (name) => (name === stOpenTab ? ' active' : '');
const stPlatform = (p) => ({ twitch: 'Twitch', youtube: 'YouTube', kick: 'Kick', tiktok: 'TikTok', rumble: 'Rumble', trovo: 'Trovo' })[String(p).toLowerCase()] || p;
// Platform marks for the streamer list. Kick and Rumble have no Font Awesome mark, so they get a letter.
const stIcon = (p) => ({ twitch: 'fab fa-twitch', youtube: 'fab fa-youtube', tiktok: 'fab fa-tiktok', rumble: 'fas fa-play', trovo: 'fas fa-tv' })[String(p).toLowerCase()] || null;
// Roles for the pickers: colour for the chip, and whether the bot can give the role (Manage Roles
// and the role below the bot's highest role). Live roles the bot cannot give are disabled.
const stEditable = (r) => { try { return r.editable !== false; } catch (e) { return true; } };
const stRoles = (roles || []).map(r => ({ id: r.id, name: r.name, color: r.hexColor && r.hexColor !== '#000000' ? r.hexColor : '', assignable: stEditable(r) }));
const stRoleOpts = (selected, { empty = null, gate = false } = {}) => {
    const sel = [].concat(selected == null ? [] : selected).map(String);
    let out = empty !== null ? `<option value="">${empty}</option>` : '';
    stRoles.forEach(r => {
        const on = sel.includes(String(r.id));
        const off = gate && !r.assignable && !on;
        out += `<option value="${r.id}" data-kind="role"${r.color ? ` data-color="${r.color}"` : ''}${on ? ' selected' : ''}${off ? ' disabled' : ''}>${String(r.name).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]))}${gate && !r.assignable ? ' (above the bot)' : ''}</option>`;
    });
    return out;
};
// "3 hours ago" for the Last notified column; dates come from subscriptions.last_announced_at.
const stAgo = (d) => {
    if (!d) return null;
    const s = Math.max(0, Math.round((Date.now() - new Date(d).getTime()) / 1000));
    if (s < 3600) return `${Math.max(1, Math.round(s / 60))} min ago`;
    if (s < 86400) return `${Math.round(s / 3600)} h ago`;
    if (s < 86400 * 60) return `${Math.round(s / 86400)} days ago`;
    return new Date(d).toISOString().slice(0, 10);
};
const stLiveCount = (consolidatedStreamers || []).filter(s => s.is_live).length;
const stRoleColor = Object.fromEntries(stRoles.map(r => [r.id, r.color]));
const stCanGive = Object.fromEntries(stRoles.map(r => [r.id, r.assignable]));
%>
<%#
  Page-scoped styles. Everything else comes from the settings-row kit (cf-settings.css): the tab
  bar (.cf-tabs), the notice and status lines (.cf-notice), the search box (.cf-search), the
  example schedule gallery (.cf-gallery) and the schedule-sync dialog (.cf-modal). What the kit
  has no part for: the stream-end switches a script repaints (.eoe-toggle) and a rule header
  with its buttons.
%>
<style>
.streaming-tab-nav { margin-top: var(--cf-8); }
.streaming-tab-content { display: none; }
.streaming-tab-content.active { display: block; }

/* Stream-end switches: the page script paints the track and moves the dot. */
.eoe-toggle { position: relative; display: inline-block; flex: none; width: 40px; height: 24px; margin: 0; cursor: pointer; }
.eoe-toggle input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; z-index: 1; }
.eoe-toggle-track { position: absolute; inset: 0; border-radius: 999px; border: 1px solid var(--cf-border-strong); background: var(--cf-surface-3); transition: background var(--cf-fast) var(--cf-ease); }
.eoe-toggle-dot { position: absolute; top: 3px; left: 2px; width: 18px; height: 18px; border-radius: 50%; background: var(--cf-text-2); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3); transition: left var(--cf-fast) var(--cf-ease); }
.eoe-toggle input:checked ~ .eoe-toggle-dot { background: var(--cf-on-accent); }
.eoe-toggle input:focus-visible ~ .eoe-toggle-track { outline: 2px solid var(--cf-accent); outline-offset: 2px; }

.st-name { font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
.st-meta { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
.st-rule-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--cf-2) var(--cf-3); margin-bottom: var(--cf-3); }
.st-rule-name { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-weight: 600; color: var(--cf-text); }
.st-actions { display: flex; flex-wrap: wrap; gap: var(--cf-2); }
.st-scroll { max-height: 26rem; overflow-y: auto; }
/* Example schedules: wide tiles; the image sits inside a link to the full size. */
.st-gallery { --cf-gallery-min: 13rem; --cf-gallery-ratio: 16 / 9; }
.st-gallery .cf-gallery-item > a { display: block; }
.st-gallery .cf-gallery-item img { display: block; width: 100%; aspect-ratio: var(--cf-gallery-ratio); object-fit: cover; background: var(--cf-surface-3); }
#trs-mods-vips-list:empty { display: none; }
.st-page .cf-cell-end .st-actions { justify-content: flex-end; }

/* Platform marks in the streamer list (Kick has no icon font mark: a letter tile instead). */
.st-plat { display: inline-flex; align-items: center; gap: 6px; }
.st-plat i { width: 1em; text-align: center; }
.st-plat-twitch i { color: #9146ff; } .st-plat-youtube i { color: #ff3b3b; } .st-plat-tiktok i { color: var(--cf-text); }
.st-plat-rumble i { color: #85c742; }
.st-kick { display: inline-flex; align-items: center; justify-content: center; width: 1.1em; height: 1.1em; border-radius: 3px; background: #53fc18; color: #0b0e0f; font-size: 0.7em; font-weight: 800; line-height: 1; }
.st-when { display: block; font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-top: 2px; }

/* Announcement defaults: settings on the left, the preview beside them on wide screens. */
.st-preview-row { display: grid; gap: var(--cf-3); }
.st-preview-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2); }

/* Live role check results and the Twitch mods/VIPs list: plain rows. */
.st-check-list, .st-plain-list { display: grid; gap: 6px; }
.st-check-item, .st-plain-item { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px var(--cf-3); padding: 8px 12px; border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface-2); }
.st-check-main, .st-plain-main { display: grid; gap: 2px; min-width: 0; flex: 1 1 14rem; }
.st-check-name { font-weight: 600; color: var(--cf-text); overflow-wrap: anywhere; }
.st-role-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; background: var(--st-role, var(--cf-text-3)); vertical-align: baseline; }
.st-plain-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.st-plain-actions input { width: 15rem; max-width: 100%; }
.st-trs-twitch { color: #a970ff; font-weight: 600; }
:root:is([data-theme="light"], [data-theme="sand"]) .st-trs-twitch { color: #772ce8; }
.st-grant { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-2); }
.st-grant input { width: 12rem; max-width: 100%; }
@media (max-width: 640px) {
    .st-plain-actions input, .st-grant input { width: 100%; }
}
</style>

<div class="page-section st-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-video"></i>
                <span>Streaming</span>
            </div>
            <div class="page-section-subtitle"><%= (consolidatedStreamers || []).length %> streamer<%= (consolidatedStreamers || []).length === 1 ? '' : 's' %> followed<% if (stLiveCount) { %>, <%= stLiveCount %> live now<% } %><% if (!defaultChannelId) { %> · no default channel set<% } %></div>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-streamer-modal">Add streamer</button>
    </div>

    <div class="cf-tabs streaming-tab-nav" role="tablist" aria-label="Streaming sections">
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('streamers') %>" data-tab="streamers" onclick="switchStreamingTab('streamers')">
            <span>Streamers</span>
            <span class="cf-tab-count"><%= consolidatedStreamers?.length || 0 %></span>
        </button>
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('teams') %>" data-tab="teams" onclick="switchStreamingTab('teams')">
            <span>Teams</span>
            <span class="cf-tab-count"><%= teamSubscriptions?.length || 0 %></span>
        </button>
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('appearance') %>" data-tab="appearance" onclick="switchStreamingTab('appearance')">
            <span>Announcements</span>
        </button>
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('auto-track') %>" data-tab="auto-track" onclick="switchStreamingTab('auto-track')">
            <span>Auto-track</span>
            <span class="cf-tab-count"><%= atConfigs.length %></span>
        </button>
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('schedules') %>" data-tab="schedules" onclick="switchStreamingTab('schedules')">
            <span>Schedules</span>
            <span class="cf-tab-count"><%= syncs.length %></span>
        </button>
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('role-sync') %>" data-tab="role-sync" onclick="switchStreamingTab('role-sync')">
            <span>Role sync</span>
            <span class="cf-tab-count"><%= typeof twitchRoleSyncConfig !== 'undefined' && twitchRoleSyncConfig ? '1' : '0' %></span>
        </button>
        <button type="button" role="tab" class="cf-tab streaming-tab-btn<%= stTab('analytics') %>" data-tab="analytics" onclick="switchStreamingTab('analytics')">
            <span>Analytics</span>
            <span class="cf-tab-count"><%= (typeof twitchAnalyticsData !== 'undefined' && twitchAnalyticsData?.alerts?.length) || 0 %></span>
        </button>
    </div>

    <!-- Streamers -->
    <div class="streaming-tab-content<%= stTab('streamers') %>" data-tab="streamers">
        <dl class="cf-kpis" aria-label="Streamers at a glance">
            <div class="cf-kpi"><dt>Streamers</dt><dd class="cf-kpi-value"><%= consolidatedStreamers?.length || 0 %></dd></div>
            <div class="cf-kpi"><dt>Subscriptions</dt><dd class="cf-kpi-value"><%= consolidatedStreamers?.reduce((sum, s) => sum + (s.subscriptions?.length || 0), 0) || 0 %></dd></div>
            <div class="cf-kpi"><dt>Live now</dt><dd class="cf-kpi-value"><%= stLiveCount %></dd></div>
            <div class="cf-kpi"><dt>Linked to Discord</dt><dd class="cf-kpi-value"><%= consolidatedStreamers?.filter(s => s.discord_user_id).length || 0 %></dd></div>
        </dl>

        <% if (!defaultChannelId) { %>
        <div class="cf-notice is-warn" role="note"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i><p class="cf-notice-body"><strong>No default announcement channel.</strong> Streamers left on the server default are not announced until one is chosen.</p><button type="button" class="btn btn-sm btn-secondary" onclick="switchStreamingTab('appearance')">Choose a channel</button></div>
        <% } %>

        <div id="eoe-status" class="cf-notice" role="status" aria-live="polite" hidden></div>


        <section class="cf-section" aria-labelledby="st-streamers-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-streamers-title">Streamers</h2>
                    <p class="cf-section-desc">Everyone this server announces, one row per person across their platforms. Tick rows to change several at once.</p>
                </div>
                <div class="cf-section-actions">
                    <div class="cf-search"><i class="fas fa-magnifying-glass" aria-hidden="true"></i><input type="search" id="streamerSearch" class="form-control" placeholder="Search streamers" aria-label="Search streamers"></div>
                    <button type="button" class="btn btn-secondary" id="bulk-actions-btn" style="display: none;"
                            data-bs-toggle="modal" data-bs-target="#bulk-actions-modal">
                        <span>Change selected (<span id="bulk-count">0</span>)</span>
                    </button>
                    <button type="button" class="btn btn-primary" id="cf-rescan-live-btn" title="Force a live-check for every tracked streamer in this server">
                        <i class="fas fa-rotate" aria-hidden="true"></i> <span>Rescan live</span>
                    </button>
                    <button type="button" class="btn btn-secondary" id="cf-departed-btn" title="Recently removed / paused subscriptions — quick-restore accidental removals here">
                        <i class="fas fa-rotate-left" aria-hidden="true"></i> <span>Recently removed</span>
                    </button>
                </div>
            </header>
            <div class="cf-rows">
            <% if (consolidatedStreamers && consolidatedStreamers.length > 0) { %>
                <div class="cf-table-wrap">
                    <table class="cf-table cf-table--stack">
                        <thead>
                            <tr>
                                <th scope="col"><input type="checkbox" id="select-all-streamers" class="form-check-input" title="Select all" aria-label="Select all streamers"></th>
                                <th scope="col">Streamer</th>
                                <th scope="col">Platforms</th>
                                <th scope="col">Subscriptions</th>
                                <th scope="col">Status</th>
                                <th scope="col">Edit on end</th>
                                <th scope="col"><span class="visually-hidden">Edit</span></th>
                            </tr>
                        </thead>
                        <tbody id="streamersTableBody">
                            <% consolidatedStreamers.forEach(streamer => {
                                // A row groups every subscription sharing a Discord user, so the
                                // edit_on_end toggle must read and write ALL of them, not just the
                                // first; a TikTok row sorting ahead of the Twitch one used to
                                // swallow the toggle and leave the Twitch announcement deleting.
                                const eoeSubIds = (streamer.subscriptions || []).map(s => s.id || s.subscription_id).filter(Boolean);
                                const eoeOnCount = eoeSubIds.filter(id => editOnEndMap[id]).length;
                                const eoeAllOn = eoeSubIds.length > 0 && eoeOnCount === eoeSubIds.length;
                                const eoeMixed = eoeOnCount > 0 && !eoeAllOn;
                            %>
                            <tr class="streamer-row" data-streamer-name="<%= (streamer.name || '').toLowerCase() %>" data-platforms="<%= ((streamer.platforms || []).join(' ')).toLowerCase() %>" data-subscription-ids="<%= (streamer.subscriptions || []).map(s => s.id || s.subscription_id).filter(Boolean).join(',') %>">
                                <td data-label="Select">
                                    <input type="checkbox" class="form-check-input streamer-checkbox" aria-label="Select <%= streamer.name %>">
                                </td>
                                <td data-label="Streamer">
                                    <div><span class="st-name"><%= streamer.name %></span>
                                    <% if (streamer.discord_user_id) { %><span class="st-meta">Linked to Discord</span><% } %></div>
                                </td>
                                <td data-label="Platforms">
                                    <span class="cf-chips"><% streamer.platforms.forEach(platform => { const pl = String(platform).toLowerCase(); %><span class="cf-pill st-plat st-plat-<%= pl %>"><% if (pl === 'kick') { %><span class="st-kick" aria-hidden="true">K</span><% } else if (stIcon(pl)) { %><i class="<%= stIcon(pl) %>" aria-hidden="true"></i><% } %><%= stPlatform(platform) %></span><% }); %></span>
                                </td>
                                <td data-label="Subscriptions"><span class="cf-em"><%= streamer.subscriptions.length %></span></td>
                                <td data-label="Status">
                                    <% if (streamer.is_blacklisted) { %><span class="cf-pill is-bad">Blocked</span>
                                    <% } else if (streamer.is_live) { %><span class="cf-pill is-ok"><span class="cf-live-dot" aria-hidden="true"></span> Live now</span>
                                    <% } else { %><span class="cf-pill">Offline</span><% } %>
                                    <span class="st-when"><%= streamer.last_announced_at ? `Last notified ${stAgo(streamer.last_announced_at)}` : 'Not notified yet' %></span>
                                </td>
                                <td data-label="Edit on end">
                                    <% if (eoeSubIds.length) { %>
                                        <label class="eoe-toggle" title="<%= eoeMixed ? `Mixed: ${eoeOnCount} of ${eoeSubIds.length} subscriptions edit on end. Click to turn it on for all.` : `Edit on end for all ${eoeSubIds.length} of this streamer's subscriptions` %>">
                                            <input type="checkbox"
                                                data-sub-ids="<%= eoeSubIds.join(',') %>"
                                                aria-label="Edit on end for <%= streamer.name %>"
                                                <%= eoeAllOn ? 'checked' : '' %>
                                                onchange="toggleEoeInline(this)">
                                            <span class="eoe-toggle-track" style="background: <%= eoeAllOn ? 'var(--cf-accent)' : (eoeMixed ? 'var(--cf-warning)' : 'var(--cf-surface-3)') %>;"></span>
                                            <span class="eoe-toggle-dot" style="left: <%= eoeAllOn ? '18px' : (eoeMixed ? '10px' : '2px') %>;"></span>
                                        </label>
                                    <% } else { %>
                                        <span class="cf-cell-muted">None</span>
                                    <% } %>
                                </td>
                                <td class="cf-cell-end">
                                    <button type="button" class="btn btn-sm btn-secondary edit-streamer-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#edit-streamer-modal"
                                            data-streamer="<%= JSON.stringify(streamer) %>">Edit</button>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="cf-state cf-state--empty">
                    <p class="cf-state-title">No streamers yet</p>
                    <p class="cf-state-text">Add a streamer to announce them when they go live on Twitch, YouTube, Kick, TikTok or Rumble.</p>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#add-streamer-modal">Add streamer</button>
                </div>
            <% } %>
            </div>
        </section>

        <%
            const sedEditDefault = !!(settings && settings.default_edit_on_end);
            const sedDeleteDefault = settings && settings.default_delete_on_end !== undefined
                ? !!settings.default_delete_on_end
                : true;
            const sedKeepDefault = !sedEditDefault && !sedDeleteDefault;
        %>
        <section class="cf-section" data-st-end aria-labelledby="st-end-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-end-title">When a stream ends</h2>
                    <p class="cf-section-desc">The default for every streamer added from now on, however they are added (this page, <code>/socials streamer add</code>, auto-track, team sync). Existing streamers keep their own setting unless you apply this to all of them.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sed-edit">Edit on end</label>
                        <p class="cf-row-desc">Rewrite the announcement as a "stream ended" summary, with the VOD link on Twitch.</p>
                    </div>
                    <div class="cf-row-control">
                        <label class="eoe-toggle" title="Default edit-on-end for new streamers">
                            <input type="checkbox" id="sed-edit" <%= sedEditDefault ? 'checked' : '' %>>
                            <span class="eoe-toggle-track" style="background: <%= sedEditDefault ? 'var(--cf-accent)' : 'var(--cf-surface-3)' %>;"></span>
                            <span class="eoe-toggle-dot" style="left: <%= sedEditDefault ? '18px' : '2px' %>;"></span>
                        </label>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sed-keep">Keep on end</label>
                        <p class="cf-row-desc">Leave the announcement exactly as it was posted.</p>
                    </div>
                    <div class="cf-row-control">
                        <label class="eoe-toggle" title="Default keep-on-end for new streamers">
                            <input type="checkbox" id="sed-keep" <%= sedKeepDefault ? 'checked' : '' %>>
                            <span class="eoe-toggle-track" style="background: <%= sedKeepDefault ? 'var(--cf-accent)' : 'var(--cf-surface-3)' %>;"></span>
                            <span class="eoe-toggle-dot" style="left: <%= sedKeepDefault ? '18px' : '2px' %>;"></span>
                        </label>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-foot-note" id="sed-outcome" aria-live="polite"></span>
                    <button type="button" class="btn btn-secondary" id="sed-apply-all">Apply to all streamers</button>
                    <button type="button" class="btn btn-primary" id="sed-save">Save default</button>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="st-lrc-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-lrc-title">Live role check</h2>
                    <p class="cf-section-desc">Checks every live role in use here: that it still exists, that the bot is allowed to give it, and who still has one without being live.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-secondary" data-st="lrc-run">Run check</button>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div data-st="lrc-out" aria-live="polite"><p class="cf-row-desc">Not run yet.</p></div>
                </div>
            </div>
        </section>

        <section class="cf-section" id="cf-departed-card" aria-labelledby="st-departed-title" hidden>
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-departed-title">Recently removed</h2>
                    <p class="cf-section-desc">Subscriptions taken off the list, by staff or because the member left, are kept here so they can be put back exactly as they were.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-sm btn-primary" id="cf-restore-all">Restore all</button>
                    <button type="button" class="btn btn-sm btn-secondary" id="cf-restore-except-manual" title="Leave out the ones staff removed on purpose">Restore all but staff removals</button>
                    <button type="button" class="btn btn-sm btn-secondary" id="cf-departed-close">Close</button>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div id="cf-departed-list" class="st-plain-list">Loading</div>
                </div>
                <div class="cf-rows-head">Removed before this list existed</div>
                <div class="cf-row cf-row--stack">
                    <p class="cf-row-desc">Streamers announced here before who no longer have a subscription. Subscribing again posts to the last channel they were announced in.</p>
                    <div id="cf-history-list" class="st-plain-list"></div>
                </div>
            </div>
        </section>
    </div>

    <!-- Teams -->
    <div class="streaming-tab-content<%= stTab('teams') %>" data-tab="teams">
        <dl class="cf-kpis" aria-label="Teams at a glance">
            <div class="cf-kpi"><dt>Teams</dt><dd class="cf-kpi-value"><%= teamSubscriptions?.length || 0 %></dd></div>
            <div class="cf-kpi"><dt>With their own channel</dt><dd class="cf-kpi-value"><%= teamSubscriptions?.filter(t => t.announcement_channel_id).length || 0 %></dd></div>
            <div class="cf-kpi"><dt>With a live role</dt><dd class="cf-kpi-value"><%= teamSubscriptions?.filter(t => t.live_role_id).length || 0 %></dd></div>
        </dl>

        <section class="cf-section" aria-labelledby="st-teams-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-teams-title">Team subscriptions</h2>
                    <p class="cf-section-desc">Follow a whole streaming team: every member is tracked and announced, and new members are picked up on their own.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#addTeamModal">Add team</button>
                </div>
            </header>
            <div class="cf-rows">
            <% if (teamSubscriptions && teamSubscriptions.length > 0) { %>
                <div class="cf-list">
                <% teamSubscriptions.forEach(team => { %>
                    <div class="cf-list-item">
                        <div class="cf-list-main">
                            <span class="st-name"><%= team.team_name %></span>
                            <span class="st-meta">Posts in #<%= channels.find(c => c.id === team.announcement_channel_id)?.name || 'the server default' %> · live role <%= roles.find(r => r.id === team.live_role_id)?.name || 'none' %> · live board <%= team.live_board_channel_id ? '#' + (channels.find(c => c.id === team.live_board_channel_id)?.name || 'deleted channel') : 'off' %></span>
                            <span class="st-meta"><%= team.memberCount === null ? 'Live status unavailable' : `${(team.liveNow || []).length} of ${team.memberCount} member${team.memberCount === 1 ? '' : 's'} live now` %><% (team.liveNow || []).forEach((m, i) => { %><%= i ? ', ' : ': ' %><a href="https://www.twitch.tv/<%= m.login %>" target="_blank" rel="noopener"><%= m.name %></a><%= m.game ? ` (${m.game}${m.viewers !== null ? `, ${m.viewers}` : ''})` : '' %><% }) %></span>
                        </div>
                        <div class="cf-list-actions">
                            <button type="button" class="btn btn-sm btn-secondary edit-team-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#teamSettingsModal"
                                    data-team='<%= JSON.stringify(team) %>'>Settings</button>
                            <form action="/manage/<%= guild.id %>/delete-team" method="POST" class="d-inline" onsubmit="return confirm('Are you sure? This will remove all associated streamers.');">
                                <input type="hidden" name="teamId" value="<%= team.id %>">
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </div>
                    </div>
                <% }) %>
                </div>
            <% } else { %>
                <div class="cf-state cf-state--empty">
                    <p class="cf-state-title">No team subscriptions</p>
                    <p class="cf-state-text">Follow a streaming team to track all of its members and announce them when they go live.</p>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTeamModal">Add team</button>
                </div>
            <% } %>
            </div>
        </section>
    </div>

    <!-- Announcements: the server-wide defaults and how live announcements are drawn -->
    <%
        let stBotName = 'Bot', stBotAvatar = '';
        try { stBotName = guild.members.me.displayName || stBotName; stBotAvatar = guild.members.me.displayAvatarURL({ size: 64 }) || ''; } catch (e) { /* bot member not cached */ }
    %>
    <div class="streaming-tab-content<%= stTab('appearance') %>" data-tab="appearance">
        <form action="/manage/<%= guild.id %>/update-announcements" method="POST">
            <section class="cf-section" aria-labelledby="st-defaults-title">
                <header class="cf-section-head">
                    <div>
                        <h2 class="cf-section-title" id="st-defaults-title">Announcement defaults</h2>
                        <p class="cf-section-desc">Used for every streamer whose own settings say "Server default".</p>
                    </div>
                    <div class="cf-section-actions">
                        <span class="cf-pill <%= defaultChannelId ? 'is-ok' : 'is-warn' %>"><%= defaultChannelId ? 'Channel set' : 'No channel' %></span>
                    </div>
                </header>
                <div class="cf-rows">
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-announcement_channel_id">Default channel</label>
                            <p class="cf-row-desc" id="f-streaming-announcement_channel_id-desc">Where go-live posts go for streamers on the server default.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-streaming-announcement_channel_id" class="form-select" name="announcement_channel_id" aria-describedby="f-streaming-announcement_channel_id-desc">
                                <%- include('../kit/_options', { items: channels, selected: defaultChannelId || null, prefix: '#', empty: 'None' }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-live_role_id">Live role</label>
                            <p class="cf-row-desc" id="f-streaming-live_role_id-desc">Given to linked Discord members while they are live and taken back when they stop. Roles above the bot's own role cannot be given.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-streaming-live_role_id" class="form-select" name="live_role_id" aria-describedby="f-streaming-live_role_id-desc">
                                <%- stRoleOpts(defaultLiveRoleId || null, { empty: 'No role', gate: true }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="webhook-persona-check">Post as the streamer</label>
                            <p class="cf-row-desc" id="webhook-persona-check-desc">Posts go out with the streamer's name and avatar instead of the bot's. Needs Manage Webhooks in the channel.</p>
                        </div>
                        <div class="cf-row-control">
                            <input type="checkbox" class="cf-switch" role="switch" name="use_webhook_persona" value="1" id="webhook-persona-check" aria-describedby="webhook-persona-check-desc" <%= useWebhookPersona ? 'checked' : '' %>>
                        </div>
                    </div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-announcement_message">Message</label>
                            <p class="cf-row-desc" id="f-streaming-announcement_message-desc">Text above the live card, for streamers without a message of their own. Leave it empty to post the card on its own. Variables: {streamer}, {platform}, {game}, {title}, {url}, {everyone}.</p>
                        </div>
                        <div class="cf-row-control">
                            <textarea id="f-streaming-announcement_message" class="form-control" name="announcement_message" rows="2" maxlength="2000" placeholder="{streamer} is live on {platform}: {title}" aria-describedby="f-streaming-announcement_message-desc"><%= defaultMessage %></textarea>
                        </div>
                    </div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-row-text">
                            <span class="cf-row-label">Preview</span>
                            <p class="cf-row-desc">With made-up stream details. A test post uses the channel above and does not ping anyone.</p>
                        </div>
                        <div class="cf-row-control st-preview-row">
                            <div class="cf-mp-frame" data-st="def-preview" data-bot-name="<%= stBotName %>" data-bot-avatar="<%= stBotAvatar %>"></div>
                            <div class="st-preview-actions">
                                <button type="button" class="btn btn-sm btn-secondary" data-st="def-test">Send test</button>
                                <span class="cf-status-line" data-st="def-test-status" aria-live="polite"></span>
                            </div>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="ignored-roles-select-streaming">Roles never announced</label>
                            <p class="cf-row-desc" id="ignored-roles-select-streaming-desc">Members with any of these roles do not trigger go-live posts.<span id="ignored-roles-count-streaming"></span></p>
                        </div>
                        <div class="cf-row-control">
                            <select class="form-select" name="stream_ignored_roles" multiple size="4" id="ignored-roles-select-streaming" aria-describedby="ignored-roles-select-streaming-desc">
                                <%- stRoleOpts(ignoredRoles, { empty: null }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Save defaults</button>
                    </div>
                </div>
            </section>
        </form>

        <%- include('partials/manage/live-style', { guild }) %>
    </div>

    <!-- Auto-track -->
    <div class="streaming-tab-content<%= stTab('auto-track') %>" data-tab="auto-track">
        <div id="at-status" class="cf-notice" role="status" aria-live="polite" hidden></div>

        <section class="cf-section" aria-labelledby="st-routing-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-routing-title">Live channel routing</h2>
                    <p class="cf-section-desc">Send announcements to a different channel depending on the streamer's roles, for example subscribers to #subs-live and team members to #team-live. The highest priority rule that matches wins, and roles are checked again right before each post, so a lapsed subscriber falls back to the normal channel. A rule with no roles picks up your Twitch subscriber roles (tiers 1 to 3), which Discord gives members once they link Twitch.</p>
                </div>
            </header>
            <div class="cf-rows">
                <% if (lrRules.length === 0) { %>
                    <%- include('../kit/_state', { kind: 'empty', title: 'No routing rules yet', text: 'Add one below.', id: null, boxed: false, compact: true }) %>
                <% } else { %>
                    <% lrRules.forEach(rule => { %>
                    <div class="cf-row cf-row--stack" data-rule-id="<%= rule.rule_id %>">
                        <div class="st-rule-head">
                            <div class="st-rule-name">
                                <span><%= rule.label || ('Rule ' + rule.rule_id) %></span>
                                <span class="cf-pill <%= rule.enabled ? 'is-ok' : '' %>"><%= rule.enabled ? 'On' : 'Off' %></span>
                                <% if (!rule.role_ids || rule.role_ids.length === 0) { %><span class="cf-pill is-info">Subscriber roles</span><% } %>
                            </div>
                            <div class="st-actions">
                                <button type="button" class="btn btn-sm btn-secondary" onclick="lrSave(<%= rule.rule_id %>)">Save</button>
                                <button type="button" class="btn btn-sm btn-secondary" onclick="lrToggle(<%= rule.rule_id %>)"><%= rule.enabled ? 'Turn off' : 'Turn on' %></button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="lrDelete(<%= rule.rule_id %>)">Delete</button>
                            </div>
                        </div>
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="lr-label-<%= rule.rule_id %>">Name</label>
                                <input type="text" class="form-control" id="lr-label-<%= rule.rule_id %>" value="<%= rule.label || '' %>" maxlength="64" placeholder="Subscribers">
                            </div>
                            <div class="cf-field">
                                <label for="lr-priority-<%= rule.rule_id %>">Priority</label>
                                <input type="number" class="form-control" id="lr-priority-<%= rule.rule_id %>" value="<%= rule.priority %>">
                                <span class="cf-field-hint">Higher wins, for example subscribers 100 and team 50.</span>
                            </div>
                            <div class="cf-field">
                                <label for="lr-channel-<%= rule.rule_id %>">Live channel</label>
                                <select class="form-select" id="lr-channel-<%= rule.rule_id %>">
                                    <% atChannels.forEach(ch => { %>
                                        <option value="<%= ch.id %>" <%= rule.channel_id === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="lr-roles-<%= rule.rule_id %>">Roles</label>
                                <select class="form-select" id="lr-roles-<%= rule.rule_id %>" multiple size="4">
                                    <% lrRoles.forEach(role => { %>
                                        <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>" <%= (rule.role_ids || []).includes(role.id) ? 'selected' : '' %>><%= role.name %><%= role.integration ? ' (integration)' : '' %></option>
                                    <% }); %>
                                </select>
                                <span class="cf-field-hint">None chosen: your Twitch subscriber roles.</span>
                            </div>
                            <div class="cf-field">
                                <label for="lr-sources-<%= rule.rule_id %>">Only reroute from</label>
                                <select class="form-select" id="lr-sources-<%= rule.rule_id %>" multiple size="4">
                                    <% atChannels.forEach(ch => { %>
                                        <option value="<%= ch.id %>" <%= (rule.source_channel_ids || []).includes(ch.id) ? 'selected' : '' %>>#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                                <span class="cf-field-hint">None chosen: reroute out of any channel.</span>
                            </div>
                            <div class="cf-field">
                                <label for="lr-owner-<%= rule.rule_id %>">Server owner</label>
                                <select class="form-select" id="lr-owner-<%= rule.rule_id %>">
                                    <option value="1" <%= rule.exclude_owner ? 'selected' : '' %>>Skip: announce in their own channel</option>
                                    <option value="0" <%= rule.exclude_owner ? '' : 'selected' %>>Route like everyone else</option>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="lr-unrouted-<%= rule.rule_id %>">Streamers with no channel</label>
                                <select class="form-select" id="lr-unrouted-<%= rule.rule_id %>">
                                    <option value="0" <%= rule.apply_to_unrouted ? '' : 'selected' %>>Leave them unannounced</option>
                                    <option value="1" <%= rule.apply_to_unrouted ? 'selected' : '' %>>Use this rule as their default channel</option>
                                </select>
                                <span class="cf-field-hint">For subscriptions with no channel set anywhere.</span>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                <% } %>

                <form id="lr-add-form">
                    <div class="cf-rows-head" id="st-lr-add-head">Add a routing rule</div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="f-streaming-label">Name</label>
                                <input id="f-streaming-label" type="text" name="label" class="form-control" maxlength="64" placeholder="Subscribers">
                            </div>
                            <div class="cf-field">
                                <label for="f-streaming-priority">Priority</label>
                                <input id="f-streaming-priority" type="number" name="priority" class="form-control" value="0">
                                <span class="cf-field-hint">Higher wins, for example subscribers 100 and team 50.</span>
                            </div>
                            <div class="cf-field">
                                <label for="f-streaming-channel_id">Live channel</label>
                                <select id="f-streaming-channel_id" name="channel_id" class="form-select" required>
                                    <option value="">Choose a channel</option>
                                    <% atChannels.forEach(ch => { %>
                                        <option value="<%= ch.id %>">#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-streaming-role_ids">Roles</label>
                                <select id="f-streaming-role_ids" name="role_ids" class="form-select" multiple size="4">
                                    <% lrRoles.forEach(role => { %>
                                        <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>"><%= role.name %><%= role.integration ? ' (integration)' : '' %></option>
                                    <% }); %>
                                </select>
                                <span class="cf-field-hint">None chosen: your Twitch subscriber roles.</span>
                            </div>
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Add rule</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="st-at-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-at-title">Auto-track mappings</h2>
                    <p class="cf-section-desc">A fallback: when a member starts streaming on Twitch (seen through their Discord status), a streamer subscription is created for them. Members already covered by self-promo, a team or a manual subscription are skipped, so nobody is announced twice.</p>
                </div>
            </header>
            <div class="cf-rows">
                <% if (atConfigs.length === 0) { %>
                    <%- include('../kit/_state', { kind: 'empty', title: 'No auto-track mappings yet', text: 'Add one below.', id: null, boxed: false, compact: true }) %>
                <% } else { %>
                    <% atConfigs.forEach((config, index) => {
                        const deleteOnEnd = config.delete_on_end !== undefined ? config.delete_on_end : 1;
                        const editOnEnd = config.edit_on_end !== undefined ? config.edit_on_end : 0;
                        // Edit wins over delete, as the bot reads it (core/stream-end-defaults.js), so a
                        // mapping stored as edit-only shows (and re-saves) as edit, not delete.
                        let streamEndVal = 'delete';
                        if (editOnEnd) streamEndVal = 'edit';
                        else if (!deleteOnEnd) streamEndVal = 'keep';
                    %>
                    <div class="cf-row cf-row--stack" data-auto-id="<%= config.auto_id %>">
                        <div class="st-rule-head">
                            <div class="st-rule-name">
                                <span>Mapping <%= index + 1 %></span>
                                <span class="cf-pill <%= config.enabled ? 'is-ok' : '' %>"><%= config.enabled ? 'On' : 'Off' %></span>
                            </div>
                            <div class="st-actions">
                                <button type="button" class="btn btn-sm btn-secondary" onclick="atEdit(<%= config.auto_id %>)">Save</button>
                                <button type="button" class="btn btn-sm btn-secondary" onclick="atToggle(<%= config.auto_id %>)"><%= config.enabled ? 'Turn off' : 'Turn on' %></button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="atDelete(<%= config.auto_id %>)">Delete</button>
                            </div>
                        </div>
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="at-role-<%= config.auto_id %>">Role</label>
                                <select id="at-role-<%= config.auto_id %>" class="form-select">
                                    <option value="" <%= !config.role_id ? 'selected' : '' %>>Any member</option>
                                    <% atRoles.forEach(role => { %>
                                        <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>" <%= config.role_id === role.id ? 'selected' : '' %>><%= role.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="at-channel-<%= config.auto_id %>">Announcement channel</label>
                                <select id="at-channel-<%= config.auto_id %>" class="form-select">
                                    <% atChannels.forEach(ch => { %>
                                        <option value="<%= ch.id %>" <%= config.announcement_channel_id === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="at-liverole-<%= config.auto_id %>">Live role</label>
                                <select id="at-liverole-<%= config.auto_id %>" class="form-select">
                                    <option value="" <%= !config.live_role_id ? 'selected' : '' %>>Server default</option>
                                    <% atRoles.forEach(role => { %>
                                        <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>" <%= config.live_role_id === role.id ? 'selected' : '' %><%= stCanGive[role.id] === false && config.live_role_id !== role.id ? ' disabled' : '' %>><%= role.name %><%= stCanGive[role.id] === false ? ' (above the bot)' : '' %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="at-streamend-<%= config.auto_id %>">When the stream ends</label>
                                <select id="at-streamend-<%= config.auto_id %>" class="form-select">
                                    <option value="delete" <%= streamEndVal === 'delete' ? 'selected' : '' %>>Delete the announcement</option>
                                    <option value="edit" <%= streamEndVal === 'edit' ? 'selected' : '' %>>Edit it to "stream ended"</option>
                                    <option value="keep" <%= streamEndVal === 'keep' ? 'selected' : '' %>>Keep it as it is</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                <% } %>

                <form id="at-add-form">
                    <div class="cf-rows-head" id="st-at-add-head">Add a mapping</div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="f-streaming-role_id">Role</label>
                                <select id="f-streaming-role_id" name="role_id" class="form-select">
                                    <option value="">Any member</option>
                                    <% atRoles.forEach(role => { %>
                                        <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>"><%= role.name %></option>
                                    <% }); %>
                                </select>
                                <span class="cf-field-hint">"Any member" tracks everyone who streams.</span>
                            </div>
                            <div class="cf-field">
                                <label for="f-streaming-announcement_channel_id-2">Announcement channel</label>
                                <select id="f-streaming-announcement_channel_id-2" name="announcement_channel_id" class="form-select" required>
                                    <option value="">Choose a channel</option>
                                    <% atChannels.forEach(ch => { %>
                                        <option value="<%= ch.id %>">#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-streaming-live_role_id-2">Live role</label>
                                <select id="f-streaming-live_role_id-2" name="live_role_id" class="form-select">
                                    <option value="">Server default</option>
                                    <% atRoles.forEach(role => { %>
                                        <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>"<%= stCanGive[role.id] === false ? ' disabled' : '' %>><%= role.name %><%= stCanGive[role.id] === false ? ' (above the bot)' : '' %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-streaming-stream_end">When the stream ends</label>
                                <select id="f-streaming-stream_end" name="stream_end" class="form-select">
                                    <option value="delete">Delete the announcement</option>
                                    <option value="edit">Edit it to "stream ended"</option>
                                    <option value="keep">Keep it as it is</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Add mapping</button>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <!-- Schedules -->
    <div class="streaming-tab-content<%= stTab('schedules') %>" data-tab="schedules">
        <dl class="cf-kpis" aria-label="Schedules at a glance">
            <div class="cf-kpi"><dt>Schedule syncs</dt><dd class="cf-kpi-value"><%= syncs.length %></dd></div>
            <div class="cf-kpi"><dt>Twitch streamers</dt><dd class="cf-kpi-value"><%= twitchStreamers.length %></dd></div>
            <div class="cf-kpi"><dt>Channels used</dt><dd class="cf-kpi-value"><%= new Set(syncs.map(s => s.channel_id)).size %></dd></div>
        </dl>

        <form action="/manage/<%= guild.id %>/twitch-schedules/sync" method="POST">
            <section class="cf-section" aria-labelledby="st-sync-add-title">
                <header class="cf-section-head">
                    <div>
                        <h2 class="cf-section-title" id="st-sync-add-title">Add a schedule sync</h2>
                        <p class="cf-section-desc">Posts a Twitch streamer's schedule in a channel and keeps it up to date.</p>
                    </div>
                </header>
                <div class="cf-rows">
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-streamerid">Twitch streamer</label>
                            <p class="cf-row-desc">Only streamers with a Twitch subscription are listed.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-streaming-streamerid" class="form-select" name="streamerId" required>
                                <option value="">Choose a streamer</option>
                                <% twitchStreamers.forEach(streamer => { %>
                                    <% const twitchSub = streamer.subscriptions?.find(sub => sub.platform === 'twitch'); %>
                                    <% if (twitchSub) { %>
                                        <option value="<%= twitchSub.streamer_id %>"><%= twitchSub.platform_username || streamer.name %></option>
                                    <% } %>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-channelid">Post the schedule in</label>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-streaming-channelid" class="form-select" name="channelId" required>
                                <option value="">Choose a channel</option>
                                <% channels.forEach(channel => { %>
                                    <option value="<%= channel.id %>">#<%= channel.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-syncintervalminutes">Check for changes every</label>
                            <p class="cf-row-desc" id="f-streaming-syncintervalminutes-desc">From 15 minutes to 10080 (a week). 360 (six hours) is usual.</p>
                        </div>
                        <div class="cf-row-control">
                            <div class="cf-input-unit">
                                <input id="f-streaming-syncintervalminutes" class="form-control" type="number" name="syncIntervalMinutes" min="15" max="10080" value="360" aria-describedby="f-streaming-syncintervalminutes-desc">
                                <span class="cf-unit">minutes</span>
                            </div>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-weekly-new">Fresh post each week</label>
                            <p class="cf-row-desc">Delete the old schedule message and post a new one every seven days, instead of editing it in place.</p>
                        </div>
                        <div class="cf-row-control">
                            <input type="checkbox" class="cf-switch" role="switch" name="weeklyRefresh" id="cfk-weekly-new">
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Create sync</button>
                    </div>
                </div>
            </section>
        </form>

        <section class="cf-section" aria-labelledby="st-syncs-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-syncs-title">Schedule syncs</h2>
                    <p class="cf-section-desc">Schedules this server keeps posted.</p>
                </div>
            </header>
            <div class="cf-rows">
            <% if (syncs.length > 0) { %>
                <div class="cf-table-wrap">
                    <table class="cf-table cf-table--stack">
                        <thead>
                            <tr>
                                <th scope="col">Streamer</th>
                                <th scope="col">Channel</th>
                                <th scope="col">Checks</th>
                                <th scope="col">Mode</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% syncs.forEach(sync => { %>
                                <% const channel = channels.find(c => c.id === sync.channel_id); %>
                                <% const intervalMin = sync.sync_interval_minutes || 360; %>
                                <% const intervalLabel = intervalMin >= 60 ? (intervalMin / 60) + ' hr' : intervalMin + ' min'; %>
                                <% const pausedLabel = { channel_deleted: 'Paused: channel deleted', guild_left: 'Paused: bot not in this server' }[sync.paused_reason] || (sync.paused_reason ? 'Paused' : null); %>
                                <% const syncOff = sync.is_enabled !== null && sync.is_enabled !== undefined && !sync.is_enabled; %>
                                <tr>
                                    <td data-label="Streamer"><a class="st-name" href="https://twitch.tv/<%= sync.twitch_username || '' %>" target="_blank" rel="noopener"><%= sync.twitch_username || 'Unknown streamer' %></a></td>
                                    <td data-label="Channel">
                                        <% if (channel) { %>#<%= channel.name %><% } else { %><span class="text-muted">Channel deleted</span><% } %>
                                        <% if (pausedLabel) { %><br><span class="cf-pill is-warn"><%= pausedLabel %></span><% } else if (syncOff) { %><br><span class="cf-pill">Off</span><% } %>
                                    </td>
                                    <td data-label="Checks">Every <%= intervalLabel %></td>
                                    <td data-label="Mode"><span class="cf-pill <%= sync.weekly_refresh ? 'is-info' : '' %>"><%= sync.weekly_refresh ? 'Fresh post weekly' : 'Edited in place' %></span></td>
                                    <td class="cf-cell-end">
                                        <div class="st-actions">
                                            <button type="button" class="btn btn-sm btn-secondary"
                                                onclick='openTwitchSchedEdit(<%= JSON.stringify({ id: String(sync.id), interval: intervalMin, weekly: !!sync.weekly_refresh, channel: channel ? String(sync.channel_id) : "", role: String(sync.mention_role_id || ""), message: sync.custom_message || "", enabled: sync.paused_reason ? true : (sync.is_enabled === null || sync.is_enabled === undefined ? true : !!sync.is_enabled), paused: !!sync.paused_reason }).replace(/</g, "\\u003c") %>)'><%= pausedLabel ? 'Pick a new channel' : 'Edit' %></button>
                                            <form action="/manage/<%= guild.id %>/twitch-schedules/force-sync" method="POST" class="d-inline">
                                                <input type="hidden" name="syncId" value="<%= sync.id %>">
                                                <button type="submit" class="btn btn-sm btn-secondary" title="Sync now">Sync now</button>
                                            </form>
                                            <a class="btn btn-sm btn-secondary" href="/manage/<%= guild.id %>/calendar">Calendar</a>
                                            <form action="/manage/<%= guild.id %>/twitch-schedules/delete" method="POST" class="d-inline">
                                                <input type="hidden" name="syncId" value="<%= sync.id %>">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Remove this schedule sync?');">Remove</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Edit dialog (inline, shared by every row) -->
                <div id="twitch-sched-edit-modal" class="cf-modal" style="display:none">
                    <div class="cf-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="st-sched-edit-title">
                        <header class="cf-modal-head"><h3 class="cf-modal-title" id="st-sched-edit-title">Edit schedule sync</h3></header>
                        <div class="cf-modal-body">
                        <form id="twitch-sched-edit-form" action="/manage/<%= guild.id %>/twitch-schedules/edit" method="POST">
                            <input type="hidden" name="syncId" id="twitch-sched-edit-id">
                            <div class="cf-rows">
                                <div class="cf-row cf-row--stack">
                                    <div class="cf-fields">
                                        <div class="cf-field">
                                            <label for="twitch-sched-edit-interval">Check every (minutes)</label>
                                            <input class="form-control" type="number" name="syncIntervalMinutes" id="twitch-sched-edit-interval" min="15" max="10080">
                                            <span class="cf-field-hint">15 to 10080. 360 is usual.</span>
                                        </div>
                                        <div class="cf-field">
                                            <label for="twitch-sched-edit-channel">Post it in</label>
                                            <select class="form-select" name="channelId" id="twitch-sched-edit-channel">
                                                <option value="">Choose a channel</option>
                                                <% channels.forEach(channel => { %>
                                                    <option value="<%= channel.id %>">#<%= channel.name %></option>
                                                <% }) %>
                                            </select>
                                            <span class="cf-field-hint">Moving it posts a fresh message there.</span>
                                            <span class="cf-field-hint" id="twitch-sched-edit-paused" style="display:none">Its old channel was deleted, so this schedule is paused. Pick a channel and save to start it again.</span>
                                        </div>
                                        <div class="cf-field">
                                            <label for="twitch-sched-edit-role">Ping a role</label>
                                            <select class="form-select" name="mentionRoleId" id="twitch-sched-edit-role">
                                                <option value="">Nobody</option>
                                                <% (typeof roles !== 'undefined' ? roles : []).forEach(role => { %>
                                                    <option value="<%= role.id %>" data-kind="role" data-color="<%= stRoleColor[role.id] || '' %>"><%= role.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="cf-field">
                                            <label for="twitch-sched-edit-message">Line above the schedule</label>
                                            <input class="form-control" type="text" name="customMessage" id="twitch-sched-edit-message"
                                                   maxlength="200" placeholder="Leave empty for the usual heading">
                                        </div>
                                    </div>
                                </div>
                                <div class="cf-row cf-row--switch">
                                    <div class="cf-row-text">
                                        <label class="cf-row-label" for="twitch-sched-edit-weekly">New message every week</label>
                                        <p class="cf-row-desc">Delete the old message and post a new one every seven days.</p>
                                    </div>
                                    <div class="cf-row-control"><input type="checkbox" class="cf-switch" role="switch" name="weeklyRefresh" id="twitch-sched-edit-weekly"></div>
                                </div>
                                <div class="cf-row cf-row--switch">
                                    <div class="cf-row-text">
                                        <label class="cf-row-label" for="twitch-sched-edit-enabled">Keep this schedule updating</label>
                                    </div>
                                    <div class="cf-row-control"><input type="hidden" name="isEnabled" value="0"><input type="checkbox" class="cf-switch" role="switch" name="isEnabled" id="twitch-sched-edit-enabled"></div>
                                </div>
                                <div class="cf-section-foot">
                                    <button type="button" class="btn btn-secondary" onclick="closeTwitchSchedEdit()">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>
                <script>
                function openTwitchSchedEdit(sync) {
                    document.getElementById('twitch-sched-edit-id').value = sync.id;
                    document.getElementById('twitch-sched-edit-interval').value = sync.interval;
                    document.getElementById('twitch-sched-edit-weekly').checked = !!sync.weekly;
                    document.getElementById('twitch-sched-edit-enabled').checked = !!sync.enabled;
                    document.getElementById('twitch-sched-edit-message').value = sync.message || '';
                    var ch = document.getElementById('twitch-sched-edit-channel');
                    if (ch) ch.value = sync.channel || '';
                    var hint = document.getElementById('twitch-sched-edit-paused');
                    if (hint) hint.style.display = sync.paused ? '' : 'none';
                    var role = document.getElementById('twitch-sched-edit-role');
                    if (role) role.value = sync.role || '';
                    document.getElementById('twitch-sched-edit-modal').style.display = 'flex';
                }
                function closeTwitchSchedEdit() {
                    document.getElementById('twitch-sched-edit-modal').style.display = 'none';
                }
                </script>
            <% } else { %>
                <%- include('../kit/_state', { kind: 'empty', title: 'No schedule syncs', text: 'Add one above to post a Twitch schedule and keep it up to date.', id: null, boxed: false, compact: false }) %>
            <% } %>
            </div>
        </section>

        <% syncs.forEach(sync => { %>
        <form action="/manage/<%= guild.id %>/twitch-schedules/style" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="syncId" value="<%= sync.id %>">
            <section class="cf-section" aria-labelledby="st-look-<%= sync.id %>-title">
                <header class="cf-section-head">
                    <div>
                        <h2 class="cf-section-title" id="st-look-<%= sync.id %>-title">Schedule look for <%= sync.twitch_username || 'this streamer' %></h2>
                        <p class="cf-section-desc">Choose a layout, where the backdrop comes from, and the wording on the image.</p>
                    </div>
                </header>
                <div class="cf-rows">
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-layout-<%= sync.id %>">Layout</label>
                            <p class="cf-row-desc">The posters show one week; the grid and the month poster show the month. The Canva-style poster needs a backdrop below other than "Drawn by the bot"; without one it is posted as the calendar grid.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="sched-layout-<%= sync.id %>" class="form-select" name="layout">
                                <option value="month"   <%= (sync.layout || 'month') === 'month' ? 'selected' : '' %>>Calendar grid (default)</option>
                                <option value="overlay" <%= sync.layout === 'overlay' ? 'selected' : '' %>>Poster: days over artwork (wide)</option>
                                <option value="rows"    <%= sync.layout === 'rows' ? 'selected' : '' %>>Poster: day rows down the page (tall)</option>
                                <option value="poster"  <%= sync.layout === 'poster' ? 'selected' : '' %>>Poster: Canva-style over your backdrop (wide, needs a backdrop)</option>
                                <option value="calendar" <%= sync.layout === 'calendar' ? 'selected' : '' %>>Month poster: peach calendar with your art (wide)</option>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--sub">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-viewmode-<%= sync.id %>">Grid covers</label>
                            <p class="cf-row-desc">Only used by the calendar grid.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="sched-viewmode-<%= sync.id %>" class="form-select" name="view_mode">
                                <option value="monthly" <%= (sync.view_mode || 'monthly') === 'monthly' ? 'selected' : '' %>>A whole month</option>
                                <option value="weekly"  <%= sync.view_mode === 'weekly' ? 'selected' : '' %>>One week</option>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-accent-<%= sync.id %>">Accent colour</label>
                            <p class="cf-row-desc">Day names and the line under the title.</p>
                        </div>
                        <div class="cf-row-control">
                            <input id="sched-accent-<%= sync.id %>" class="form-control form-control-color" type="color" name="accent_color" value="<%= sync.accent_color || '#9146FF' %>">
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-bgmode-<%= sync.id %>">Backdrop</label>
                            <p class="cf-row-desc">"Copy the look" suits finished posters: the colours and mood are read and a clean version is made with no lettering.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="sched-bgmode-<%= sync.id %>" class="form-select" name="background_mode">
                                <option value="default" <%= (sync.background_mode || 'default') === 'default' ? 'selected' : '' %>>Drawn by the bot (no artwork)</option>
                                <option value="upload"  <%= sync.background_mode === 'upload' ? 'selected' : '' %>>Use my image exactly as it is</option>
                                <option value="style"   <%= sync.background_mode === 'style' ? 'selected' : '' %>>Copy the look of my image</option>
                                <option value="prompt"  <%= sync.background_mode === 'prompt' ? 'selected' : '' %>>Generate from a theme I describe</option>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-rotation-<%= sync.id %>">With several examples saved</label>
                            <p class="cf-row-desc">Rotate never shows the same image twice running; random can.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="sched-rotation-<%= sync.id %>" class="form-select" name="background_rotation">
                                <option value="fixed"   <%= (sync.background_rotation || 'fixed') === 'fixed' ? 'selected' : '' %>>Always the first one</option>
                                <option value="shuffle" <%= sync.background_rotation === 'shuffle' ? 'selected' : '' %>>Rotate: each one once before any repeats</option>
                                <option value="random"  <%= sync.background_rotation === 'random' ? 'selected' : '' %>>Pick at random every time</option>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-bgfile-<%= sync.id %>">Upload an image</label>
                            <p class="cf-row-desc">PNG, JPG or WEBP, up to 5 MB. Replaces the link below.</p>
                        </div>
                        <div class="cf-row-control">
                            <input id="sched-bgfile-<%= sync.id %>" class="form-control" type="file" name="background_file" accept=".png,.jpg,.jpeg,.webp">
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-bgurl-<%= sync.id %>">Or paste a link</label>
                            <% if (sync.background_url) { %><p class="cf-row-desc"><a href="<%= sync.background_url %>" target="_blank" rel="noopener">See the current image</a></p><% } %>
                        </div>
                        <div class="cf-row-control">
                            <input id="sched-bgurl-<%= sync.id %>" class="form-control" type="url" name="background_url" value="<%= sync.background_url || '' %>" placeholder="https://">
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-theme-<%= sync.id %>">Ready-made theme</label>
                            <p class="cf-row-desc">Fills in the description below, which you can still edit.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="sched-theme-<%= sync.id %>" class="form-select"
                                    onchange="schedApplyTheme('<%= sync.id %>', this.value)">
                                <option value="">Choose a theme</option>
                                <% schedThemes.forEach(t => { %>
                                    <option value="<%= t[1] %>"><%= t[0] %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-prompt-<%= sync.id %>">Describe the artwork</label>
                            <p class="cf-row-desc">Used by "Generate from a theme", and added on top of an example image when its look is copied.</p>
                        </div>
                        <div class="cf-row-control">
                            <textarea id="sched-prompt-<%= sync.id %>" class="form-control" name="background_prompt" rows="2" maxlength="400" placeholder="What the artwork should look like"><%= sync.background_prompt || '' %></textarea>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-title-<%= sync.id %>">Heading on the image</label>
                        </div>
                        <div class="cf-row-control">
                            <input id="sched-title-<%= sync.id %>" class="form-control" type="text" name="card_title" maxlength="80" value="<%= sync.card_title || '' %>" placeholder="<%= (sync.twitch_username || 'Stream') %>'s schedule">
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="sched-footer-<%= sync.id %>">Line along the bottom</label>
                        </div>
                        <div class="cf-row-control">
                            <input id="sched-footer-<%= sync.id %>" class="form-control" type="text" name="card_footer" maxlength="200" value="<%= sync.card_footer || '' %>" placeholder="twitch.tv/<%= sync.twitch_username || '' %>">
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-apply-<%= sync.id %>">Post the schedule again now</label>
                            <% if (sync.background_cache_url) { %><p class="cf-row-desc">Generated artwork is kept and reused between updates; changing the theme or the example replaces it.</p><% } %>
                        </div>
                        <div class="cf-row-control">
                            <input type="checkbox" class="cf-switch" role="switch" name="apply_now" id="cfk-apply-<%= sync.id %>" checked>
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Save the look</button>
                    </div>
                </div>
            </section>
        </form>
        <% }) %>

        <section class="cf-section" aria-labelledby="st-examples-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-examples-title">Example schedules</h2>
                    <p class="cf-section-desc">Schedules you have posted before. Their colours and mood are used to build a clean backdrop in the same style; the old dates and lettering are never copied. They belong to the server, so every schedule here can use them.</p>
                </div>
            </header>
            <div class="cf-rows">
                <form action="/manage/<%= guild.id %>/twitch-schedules/templates/add" method="POST" enctype="multipart/form-data">
                    <div class="cf-rows-head" id="st-tpl-add-head">Add examples</div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="sched-tpl-files">Images</label>
                                <input id="sched-tpl-files" class="form-control" type="file" name="template_files" accept=".png,.jpg,.jpeg,.webp" multiple>
                                <span class="cf-field-hint">Up to ten at once. PNG, JPG or WEBP, 5 MB each.</span>
                            </div>
                            <div class="cf-field">
                                <label for="sched-tpl-url">Or paste links</label>
                                <input id="sched-tpl-url" class="form-control" type="text" name="template_url" placeholder="https://">
                                <span class="cf-field-hint">Separate several with a space.</span>
                            </div>
                        </div>
                    </div>
                    <div class="cf-row cf-row--stack">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="sched-tpl-label">Name</label>
                                <input id="sched-tpl-label" class="form-control" type="text" name="label" maxlength="80" placeholder="September poster">
                            </div>
                            <div class="cf-field">
                                <label for="sched-tpl-mode">How to use them</label>
                                <select id="sched-tpl-mode" class="form-select" name="mode">
                                    <option value="style">Copy the look (finished schedules)</option>
                                    <option value="upload">Use as they are (already a blank background)</option>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="sched-tpl-prompt">Anything to add</label>
                                <input id="sched-tpl-prompt" class="form-control" type="text" name="prompt" maxlength="400" placeholder="Optional, such as: keep the skull">
                            </div>
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                </form>

                <% if (schedTemplates.length > 0) { %>
                <div class="cf-rows-head" id="st-tpl-saved-head">Saved examples</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-gallery st-gallery">
                    <% schedTemplates.forEach(tpl => { %>
                        <div class="cf-gallery-item<%= tpl.enabled ? '' : ' is-muted' %>">
                            <a href="<%= tpl.cache_url || tpl.source_url %>" target="_blank" rel="noopener">
                                <img src="<%= tpl.cache_url || tpl.source_url %>" alt="<%= tpl.label || 'Example schedule' %>" loading="lazy">
                            </a>
                            <div class="cf-gallery-body">
                                <span class="st-name"><%= tpl.label || 'Example schedule' %></span>
                                <span class="st-meta"><%= tpl.mode === 'upload' ? 'Used as it is' : 'Look copied' %><%= tpl.cache_url ? ' · artwork ready' : '' %><%= tpl.enabled ? '' : ' · paused' %></span>
                                <form action="/manage/<%= guild.id %>/twitch-schedules/templates/update" method="POST">
                                    <input type="hidden" name="templateId" value="<%= tpl.id %>">
                                    <input type="hidden" name="label" value="<%= tpl.label || '' %>">
                                    <input type="hidden" name="prompt" value="<%= tpl.prompt || '' %>">
                                    <input type="hidden" name="mode" value="<%= tpl.mode %>">
                                    <div class="st-actions">
                                        <button type="submit" name="action" value="toggle" class="btn btn-sm btn-secondary"><%= tpl.enabled ? 'Pause' : 'Use' %></button>
                                        <% if (tpl.mode !== 'upload') { %>
                                        <button type="submit" name="action" value="regenerate" class="btn btn-sm btn-secondary" title="Discard the generated artwork and make it again">Redraw</button>
                                        <% } %>
                                        <button type="submit" name="action" value="delete" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Remove this example?');">Remove</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                    </div>
                </div>
                <% } else { %>
                    <%- include('../kit/_state', { kind: 'empty', title: 'No examples saved', text: 'Add one and its look is matched. Without any, the backdrop chosen for each schedule is used.', id: null, boxed: false, compact: false }) %>
                <% } %>
            </div>
        </section>

        <script>
        function schedApplyTheme(syncId, value) {
            if (!value) return;
            var box = document.getElementById('sched-prompt-' + syncId);
            if (box) box.value = value;
            var mode = document.getElementById('sched-bgmode-' + syncId);
            // Picking a theme is only meaningful if something generates from it.
            if (mode && mode.value === 'default') mode.value = 'prompt';
        }
        </script>
    </div>

    <!-- Role sync -->
    <div class="streaming-tab-content<%= stTab('role-sync') %>" data-tab="role-sync">
        <% const trsOn = typeof twitchRoleSyncConfig !== 'undefined' && twitchRoleSyncConfig; %>
        <section class="cf-section" aria-labelledby="st-trs-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-trs-title">Twitch role sync</h2>
                    <p class="cf-section-desc">Give Discord roles to the broadcaster's Twitch VIPs and moderators. The broadcaster connects their Twitch account to allow it.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Broadcaster account</span>
                        <p class="cf-row-desc"><% if (trsOn) { %>Connected as <strong><%= twitchRoleSyncConfig.broadcaster_twitch_username %></strong>.<% if (twitchRoleSyncConfig.broadcaster_token_status === 'needs_reauth') { %> Twitch no longer accepts this connection, so role sync and analytics have stopped. Choose Reconnect.<% } %><% } else { %>Not connected. The broadcaster needs to sign in with Twitch.<% } %></p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-inline">
                            <% if (trsOn) { %>
                            <form action="/manage/<%= guild.id %>/twitch-role-sync/disconnect" method="POST" class="d-inline" onsubmit="return confirm('Disconnect broadcaster account? This will stop role sync.')">
                                <button type="submit" class="btn btn-sm btn-danger">Disconnect</button>
                            </form>
                            <% } %>
                            <a href="/auth/twitch/broadcaster/<%= guild.id %>" class="btn btn-sm btn-primary"><%= trsOn ? 'Reconnect' : 'Connect Twitch account' %></a>
                        </div>
                    </div>
                </div>
            <% if (trsOn) { %>
                <form action="/manage/<%= guild.id %>/twitch-role-sync/settings" method="POST">
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-vip_role_id">VIP role</label>
                            <p class="cf-row-desc">Given to the broadcaster's Twitch VIPs.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-streaming-vip_role_id" name="vip_role_id" class="form-select">
                                <%- include('../kit/_options', { items: roles, selected: twitchRoleSyncConfig.vip_role_id || null, prefix: '', empty: 'None' }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-streaming-mod_role_id">Moderator role</label>
                            <p class="cf-row-desc">Given to the broadcaster's Twitch moderators.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-streaming-mod_role_id" name="mod_role_id" class="form-select">
                                <%- include('../kit/_options', { items: roles, selected: twitchRoleSyncConfig.mod_role_id || null, prefix: '', empty: 'None' }) %>
                            </select>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-trs-remove-vip">Remove Twitch VIP when they leave</label>
                            <p class="cf-row-desc">Takes away a member's Twitch VIP when they leave this Discord server.</p>
                        </div>
                        <div class="cf-row-control">
                            <input type="checkbox" class="cf-switch" role="switch" id="cfk-trs-remove-vip" name="remove_vip_on_leave" value="1" <%= twitchRoleSyncConfig.remove_vip_on_leave ? 'checked' : '' %>>
                        </div>
                    </div>
                    <div class="cf-row cf-row--switch">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="cfk-trs-enabled">Sync roles</label>
                        </div>
                        <div class="cf-row-control">
                            <input type="checkbox" class="cf-switch" role="switch" id="cfk-trs-enabled" name="enabled" value="1" <%= twitchRoleSyncConfig.enabled ? 'checked' : '' %>>
                        </div>
                    </div>
                    <div class="cf-section-foot">
                        <span class="cf-foot-note"><% if (twitchRoleSyncConfig.last_synced) { %>Last synced <%= new Date(twitchRoleSyncConfig.last_synced).toLocaleString() %><% } else { %>Never synced<% } %></span>
                        <button type="submit" class="btn btn-primary">Save settings</button>
                    </div>
                </form>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Sync now</span>
                        <p class="cf-row-desc">Check Twitch and update roles straight away instead of waiting for the next run.</p>
                    </div>
                    <div class="cf-row-control">
                        <form action="/manage/<%= guild.id %>/twitch-role-sync/sync-now" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-secondary">Sync now</button>
                        </form>
                    </div>
                </div>
            <% } %>
            </div>
        </section>

        <% if (trsOn) { %>
        <section class="cf-section" aria-labelledby="st-trs-live-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-trs-live-title">Twitch moderators and VIPs</h2>
                    <p class="cf-section-desc">Read live from Twitch through the broadcaster's account. Link anyone unmatched to a Discord member and the next sync gives them the role.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" id="trs-autolink-btn" class="btn btn-sm btn-primary" hidden title="Apply every suggestion scoring 90 or more">Link high-confidence matches</button>
                    <button type="button" id="trs-refresh-btn" class="btn btn-sm btn-secondary">Refresh</button>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <p class="cf-row-desc" id="trs-mods-vips-summary" aria-live="polite">Loading…</p>
                    <div id="trs-mods-vips-list" class="st-scroll st-plain-list"></div>
                </div>
                <div class="cf-rows-head">Give VIP or moderator on Twitch</div>
                <div class="cf-row cf-row--stack">
                    <p class="cf-row-desc">Adds the role on the broadcaster's Twitch channel straight away. Every change is written to the audit log.</p>
                    <div class="st-grant">
                        <input type="text" id="trs-grant-vip-input" class="form-control form-control-sm" placeholder="Twitch username" aria-label="Twitch username to make VIP" autocomplete="off">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="trsGrantRole('vip', 'add')">Add VIP</button>
                        <span id="trs-grant-vip-status" class="cf-status-line" aria-live="polite"></span>
                    </div>
                    <div class="st-grant">
                        <input type="text" id="trs-grant-mod-input" class="form-control form-control-sm" placeholder="Twitch username" aria-label="Twitch username to make moderator" autocomplete="off">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="trsGrantRole('mod', 'add')">Add moderator</button>
                        <span id="trs-grant-mod-status" class="cf-status-line" aria-live="polite"></span>
                    </div>
                </div>
            </div>
        </section>

        <datalist id="trs-discord-members">
            <% (typeof guildMembers !== 'undefined' ? guildMembers : []).forEach(m => { %>
            <option value="<%= m.id %>" label="<%= m.username %>"><%= m.username %><% if (m.display && m.display !== m.username) { %> · <%= m.display %><% } %></option>
            <% }); %>
        </datalist>

        <% const syncMembers = typeof twitchRoleSyncMembers !== 'undefined' ? twitchRoleSyncMembers : []; %>
        <% if (syncMembers.length > 0) { %>
        <section class="cf-section" aria-labelledby="st-trs-members-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-trs-members-title">Synced members</h2>
                    <p class="cf-section-desc"><%= syncMembers.length %> Discord <%= syncMembers.length === 1 ? 'member is' : 'members are' %> linked to a Twitch account.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-list st-scroll">
                <% syncMembers.forEach(m => { %>
                    <div class="cf-list-item">
                        <div class="cf-list-main">
                            <%- include('_user-cell', { cfUser: null, cfUserId: m.discord_user_id, cfUserName: null, cfUserSize: 'sm' }) %>
                            <span class="st-meta">Twitch: <%= m.twitch_username %></span>
                        </div>
                        <div class="cf-list-actions cf-chips">
                            <% if (m.is_vip) { %><span class="cf-pill is-warn">VIP</span><% } %>
                            <% if (m.is_mod) { %><span class="cf-pill is-info">Moderator</span><% } %>
                            <% if (!m.is_vip && !m.is_mod) { %><span class="cf-cell-muted">No role</span><% } %>
                        </div>
                    </div>
                <% }); %>
                </div>
            </div>
        </section>
        <% } %>
        <% } %>
    </div>
</div>

<%- include('partials/manage/add-streamer', { guild, roles, channels, streamEndDefaults: { edit_on_end: (settings && settings.default_edit_on_end) ? 1 : 0, delete_on_end: (settings && settings.default_delete_on_end !== undefined) ? (settings.default_delete_on_end ? 1 : 0) : 1 } }) %>

    <!-- Analytics -->
    <div class="streaming-tab-content<%= stTab('analytics') %>" data-tab="analytics">
        <% const ta = typeof twitchAnalyticsData !== 'undefined' ? twitchAnalyticsData : null; %>
        <% const taBound = typeof twitchRoleSyncConfig !== 'undefined' && twitchRoleSyncConfig && twitchRoleSyncConfig.broadcaster_twitch_id; %>
        <% const taCfg = ta?.config; %>
        <% const taSum = ta?.summary; %>
        <% const taAlerts = ta?.alerts || []; %>
        <%
          const REQ_SCOPES = [
              // v1 (anti-abuse analytics)
              'moderator:read:followers','channel:read:subscriptions','bits:read','channel:moderate',
              'user:read:chat','user:bot',
              // v2 (growth + engagement — added 2026-10-18)
              'channel:read:hype_train','channel:read:goals','channel:read:ads','channel:read:charity',
              'channel:read:redemptions','channel:read:polls','channel:read:predictions',
              'moderator:read:shoutouts','moderator:read:chatters',
          ];
          const taScopes = String(ta?.scopesGranted || '').split(/[\s,]+/).filter(Boolean);
          const taMissing = REQ_SCOPES.filter(x => !taScopes.includes(x));
        %>

        <section class="cf-section" aria-labelledby="st-an-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-title">Stream analytics &amp; anomaly alerts</h2>
                    <p class="cf-section-desc">Detects view-bot bursts, follow-bot spikes, moderation surges and chat harassment while the broadcaster is live. Incoming raids are counted but never flagged as anomalies. Requires the broadcaster account to be connected on the Role sync tab.</p>
                </div>
                <% if (taBound) { %>
                <a href="/manage/<%= guild.id %>/twitch-analytics" class="btn btn-sm btn-primary" style="margin-left:auto; align-self:center;">Open full analytics →</a>
                <% } %>
            </header>

            <% if (!taBound) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Broadcaster not connected</span>
                    <p class="cf-row-desc">Go to the Role sync tab and connect a Twitch account. Analytics piggy-backs on the same OAuth, so no second sign-in.</p>
                </div>
                <div class="cf-row-control">
                    <a href="?page=role-sync" class="btn btn-sm btn-primary">Open Role sync</a>
                </div>
            </div>
            <% } else { %>

            <% if (taMissing.length) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Expand Twitch scopes</span>
                    <p class="cf-row-desc">The connected account is missing these scopes: <code><%= taMissing.join(', ') %></code>. Without them, analytics are limited to viewer counts and raid alerts. Reconnect to grant them.</p>
                </div>
                <div class="cf-row-control">
                    <a href="/auth/twitch/broadcaster/<%= guild.id %>" class="btn btn-sm btn-secondary">Reconnect</a>
                </div>
            </div>
            <% } %>

            <form action="/manage/<%= guild.id %>/twitch-analytics/settings" method="POST">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-an-channel">Alert channel</label>
                        <p class="cf-row-desc">Anomaly alerts post here. Choose a mod-only channel for best signal.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-an-channel" name="alert_channel_id" class="form-select">
                            <%- include('../kit/_options', { items: channels, selected: taCfg?.alert_discord_channel_id || null, prefix: '#', empty: 'None' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-an-enabled">Post alerts</label>
                        <p class="cf-row-desc">Data collection runs regardless. This toggle controls whether the bot posts to the alert channel.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="cfk-an-enabled" name="enabled" value="1" <%= taCfg?.enabled ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-foot-note">
                        Broadcaster <strong><%= twitchRoleSyncConfig.broadcaster_twitch_username %></strong>
                        <% const liveState = ta?.liveState || 'untracked'; %>
                        <% if (liveState === 'live') { %>
                            <span class="cf-pill is-ok" title="Snapshot in the last 3 minutes shows the stream live">Live</span>
                        <% } else if (liveState === 'offline') { %>
                            <span class="cf-pill" title="Last snapshot shows the stream offline — analytics populate while live">Offline</span>
                        <% } else { %>
                            <span class="cf-pill" title="No snapshots recorded yet — analytics populate once the broadcaster goes live">Offline</span>
                        <% } %>
                    </span>
                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                </div>
            </form>
            <% } %>
        </section>

        <% if (taBound) { %>
        <section class="cf-section" aria-labelledby="st-an-sum-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-sum-title">Last 12 hours live</h2>
                    <p class="cf-section-desc">Rolled up from per-minute snapshots recorded while the stream was live.</p>
                </div>
            </header>
            <% if (!taSum) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">No live data yet</span>
                    <p class="cf-row-desc">Snapshots start recording the moment Twitch marks the stream live.</p>
                </div>
            </div>
            <% } else { %>
            <dl class="cf-kpis" aria-label="Last 12h at a glance">
                <div class="cf-kpi"><dt>Peak viewers</dt><dd class="cf-kpi-value"><%= Number(taSum.peak_viewers) || 0 %></dd></div>
                <div class="cf-kpi"><dt>Avg viewers</dt><dd class="cf-kpi-value"><%= Math.round(Number(taSum.avg_viewers) || 0) %></dd></div>
                <div class="cf-kpi"><dt>Chat</dt><dd class="cf-kpi-value"><%= Number(taSum.total_msgs) || 0 %></dd></div>
                <div class="cf-kpi"><dt>Follows</dt><dd class="cf-kpi-value"><%= Number(taSum.total_follows) || 0 %></dd></div>
                <div class="cf-kpi"><dt>Subs</dt><dd class="cf-kpi-value"><%= Number(taSum.total_subs) || 0 %></dd></div>
                <div class="cf-kpi"><dt>Bits</dt><dd class="cf-kpi-value"><%= Number(taSum.total_bits) || 0 %></dd></div>
                <div class="cf-kpi"><dt>Raids in</dt><dd class="cf-kpi-value"><%= Number(taSum.total_raids) || 0 %></dd></div>
            </dl>
            <% } %>
        </section>

        <section class="cf-section" aria-labelledby="st-an-alerts-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-alerts-title">Recent anomalies</h2>
                    <p class="cf-section-desc">Alerts waiting for a decision. Closed alerts stay in the integrity report.</p>
                </div>
            </header>
            <% if (!taAlerts.length) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Nothing to flag</span>
                    <p class="cf-row-desc">No open anomalies. Detectors require at least one chat / follow / ban subscription to be active for the broadcaster.</p>
                </div>
            </div>
            <% } else { %>
            <div class="cf-list">
                <% taAlerts.forEach(a => {
                    let ev = {}; try { ev = JSON.parse(a.evidence_json || '{}'); } catch {}
                    const sevCls = a.severity === 'critical' ? 'is-bad' : a.severity === 'warning' ? 'is-warn' : 'is-info';
                %>
                <div class="cf-alert-row" data-status="open">
                    <span class="cf-pill <%= sevCls %>"><%= a.severity %></span>
                    <div class="cf-alert-head">
                        <span class="cf-alert-name"><%= a.alert_type %></span>
                        <span class="cf-alert-meta"><%= ev.interpretation || ('score ' + Number(a.score || 0).toFixed(3)) %></span>
                    </div>
                    <time class="cf-alert-time" datetime="<%= new Date(a.created_at).toISOString() %>"><%= new Date(a.created_at).toLocaleString() %></time>
                    <form method="POST" action="/manage/<%= guild.id %>/twitch-analytics/anomaly/<%= a.id %>/false-positive?next=streamers" class="d-inline"><button type="submit" class="btn btn-sm btn-secondary">False alarm</button></form>
                    <form method="POST" action="/manage/<%= guild.id %>/twitch-analytics/anomaly/<%= a.id %>/resolve?next=streamers" class="d-inline"><button type="submit" class="btn btn-sm btn-secondary">Real, handled</button></form>
                </div>
                <% }) %>
            </div>
            <% } %>
        </section>

        <% const taMentions = ta?.mentionTargets || []; %>
        <section class="cf-section" aria-labelledby="st-an-ment-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-ment-title">Mention targets (last hour)</h2>
                    <p class="cf-section-desc">Users most @-mentioned in chat. The harassment detector uses the same signal.</p>
                </div>
            </header>
            <% if (!taMentions.length) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Nobody notable</span>
                    <p class="cf-row-desc">No chat mentions recorded in the last hour. Expected while the stream is offline, or when chat is quiet.</p>
                </div>
            </div>
            <% } else { %>
            <ul class="cf-list">
                <% taMentions.forEach(m => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title"><%= m.target_login %></div>
                        <div class="cf-list-meta"><%= m.mention_count %> mention<%= Number(m.mention_count) === 1 ? '' : 's' %> from <%= m.unique_senders %> sender<%= Number(m.unique_senders) === 1 ? '' : 's' %></div>
                    </div>
                </li>
                <% }) %>
            </ul>
            <% } %>
        </section>

        <section class="cf-section" aria-labelledby="st-an-thr-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-thr-title">Detector thresholds</h2>
                    <p class="cf-section-desc">Tune sensitivity. Defaults err on the side of too few alerts rather than too many.</p>
                </div>
            </header>
            <form action="/manage/<%= guild.id %>/twitch-analytics/thresholds" method="POST">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-an-viewbot">View-bot ratio</label>
                        <p class="cf-row-desc">Minimum chat-messages per viewer per minute. Below this is suspicious.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-an-viewbot" name="viewbot_threshold" type="number" step="0.001" min="0.001" class="form-control" value="<%= taCfg?.viewbot_threshold ?? 0.020 %>">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-an-minview">View-bot min viewers</label>
                        <p class="cf-row-desc">Only run the view-bot detector above this viewer count.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-an-minview" name="viewbot_min_viewers" type="number" min="1" class="form-control" value="<%= taCfg?.viewbot_min_viewers ?? 50 %>">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-an-followbot">Follow-bot alert</label>
                        <p class="cf-row-desc">New follows per minute that trigger an alert.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-an-followbot" name="followbot_threshold" type="number" min="1" class="form-control" value="<%= taCfg?.followbot_threshold ?? 10 %>">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-an-modspike">Mod action spike</label>
                        <p class="cf-row-desc">Bans + deletes per minute that trigger an alert (raid-detection assist).</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-an-modspike" name="mod_spike_threshold" type="number" min="1" class="form-control" value="<%= taCfg?.mod_spike_threshold ?? 5 %>">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-an-harass">Harassment target</label>
                        <p class="cf-row-desc">Different people @-mentioning one user in 5 minutes without a reply. Commands, bots and mentions of the streamer don't count.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-an-harass" name="harassment_threshold" type="number" min="1" class="form-control" value="<%= taCfg?.harassment_threshold ?? 5 %>">
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-sm btn-primary">Save thresholds</button>
                </div>
            </form>
        </section>

        <!-- ───────────────────────────────────────────────────────────────── -->
        <!--                     v2 Analytics (added 2026-10-18)              -->
        <!-- ───────────────────────────────────────────────────────────────── -->

        <% const taSessions = ta?.sessions || []; %>
        <% const taWow = ta?.wow; %>
        <% const taEng = ta?.engagement; %>
        <% const taCatHist = ta?.categoryHistory || []; %>
        <% const taHype = ta?.hypeTrains || []; %>
        <% const taGoals = ta?.goals || []; %>
        <% const taAds = ta?.adBreaks || []; %>
        <% const taAdsSum = ta?.adBreaksSummary; %>
        <% const taCharity = ta?.charity || []; %>
        <% const taPolls = ta?.polls || []; %>
        <% const taPreds = ta?.predictions || []; %>
        <% const taShout = ta?.shoutouts || []; %>
        <% const taRewards = ta?.topRewards || []; %>
        <% const taResubs = ta?.resubs || []; %>
        <% const taVipMod = ta?.vipModChanges || []; %>
        <% const taChurn = ta?.churn; %>
        <%
          function fmtDelta(cur, prev) {
              const c = Number(cur) || 0; const p = Number(prev) || 0;
              if (p === 0) return c > 0 ? '+' + c + ' (new)' : '0';
              const pct = ((c - p) / p) * 100;
              const sign = pct > 0 ? '+' : '';
              return sign + pct.toFixed(1) + '%';
          }
          function fmtDate(d) { if (!d) return '—'; try { return new Date(d).toLocaleString(); } catch { return String(d); } }
          function fmtDuration(min) { if (!min) return '—'; const h = Math.floor(min/60); const m = min%60; return h ? `${h}h ${m}m` : `${m}m`; }
        %>

        <!-- Stream session history -->
        <section class="cf-section" aria-labelledby="st-an-sess-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-sess-title">Stream sessions</h2>
                    <p class="cf-section-desc">Each live run between a go-live and the next offline, materialized from per-minute snapshots.</p>
                </div>
            </header>
            <% if (!taSessions.length) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">No sessions recorded yet</span>
                    <p class="cf-row-desc">The first session row appears the moment Twitch marks the stream live and the aggregator picks it up (next minute boundary).</p>
                </div>
            </div>
            <% } else { %>
            <ul class="cf-list">
                <% taSessions.forEach(s => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= fmtDate(s.started_at) %>
                            <% if (!s.ended_at) { %><span class="cf-pill is-ok">Live now</span><% } else { %><span class="cf-pill"><%= fmtDuration(s.duration_minutes) %></span><% } %>
                        </div>
                        <div class="cf-list-meta">
                            <% if (s.primary_category_name) { %><%= s.primary_category_name %> · <% } %>
                            peak <%= Number(s.peak_viewers) || 0 %> · avg <%= Math.round(Number(s.avg_viewers) || 0) %> ·
                            <%= Number(s.total_msgs) || 0 %> msgs · <%= Number(s.unique_chatters) || 0 %> chatters ·
                            <%= Number(s.total_follows) || 0 %>F · <%= Number(s.total_subs) || 0 %>S · <%= Number(s.total_bits) || 0 %>b
                            <% if (s.title_change_count > 0 || s.category_change_count > 0) { %>
                            · <%= s.title_change_count || 0 %> title / <%= s.category_change_count || 0 %> category change<%= (s.title_change_count + s.category_change_count) === 1 ? '' : 's' %>
                            <% } %>
                        </div>
                    </div>
                </li>
                <% }) %>
            </ul>
            <% } %>
        </section>

        <!-- Engagement rates + WoW deltas -->
        <section class="cf-section" aria-labelledby="st-an-eng-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-eng-title">Engagement rates (12h)</h2>
                    <p class="cf-section-desc">Derived from the per-minute rollup. Zero or <code>—</code> means the stream was offline all window.</p>
                </div>
            </header>
            <% if (!taEng) { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">No live data in window</span>
                    <p class="cf-row-desc">Rates populate once the stream has been live for at least a few minutes.</p>
                </div>
            </div>
            <% } else { %>
            <dl class="cf-kpis" aria-label="Engagement rates">
                <div class="cf-kpi"><dt>Chat / chatter</dt><dd class="cf-kpi-value"><%= taEng.msgs_per_chatter ? taEng.msgs_per_chatter.toFixed(1) : '—' %></dd></div>
                <div class="cf-kpi"><dt>Follows / viewer-hour</dt><dd class="cf-kpi-value"><%= taEng.follows_per_viewer_hour ? taEng.follows_per_viewer_hour.toFixed(2) : '—' %></dd></div>
                <div class="cf-kpi"><dt>Subs / viewer-hour</dt><dd class="cf-kpi-value"><%= taEng.subs_per_viewer_hour ? taEng.subs_per_viewer_hour.toFixed(3) : '—' %></dd></div>
                <div class="cf-kpi"><dt>Bits / viewer-hour</dt><dd class="cf-kpi-value"><%= taEng.bits_per_viewer_hour ? taEng.bits_per_viewer_hour.toFixed(1) : '—' %></dd></div>
                <div class="cf-kpi"><dt>Mod actions / 1k msgs</dt><dd class="cf-kpi-value"><%= taEng.mod_actions_per_1k_msgs !== null ? taEng.mod_actions_per_1k_msgs.toFixed(2) : '—' %></dd></div>
                <div class="cf-kpi"><dt>Avg chatters</dt><dd class="cf-kpi-value"><%= taEng.avg_chatters ? Math.round(taEng.avg_chatters) : '—' %></dd></div>
            </dl>
            <% } %>
        </section>

        <% if (taWow && (Number(taWow.lastWeek.msgs) > 0 || Number(taWow.thisWeek.msgs) > 0)) { %>
        <section class="cf-section" aria-labelledby="st-an-wow-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-wow-title">Week-over-week</h2>
                    <p class="cf-section-desc">Last 7 days compared with the prior 7-day window.</p>
                </div>
            </header>
            <dl class="cf-kpis" aria-label="Week-over-week deltas">
                <div class="cf-kpi"><dt>Peak viewers</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.peak_v, taWow.lastWeek.peak_v) %></dd></div>
                <div class="cf-kpi"><dt>Avg viewers</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.avg_v, taWow.lastWeek.avg_v) %></dd></div>
                <div class="cf-kpi"><dt>Chat</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.msgs, taWow.lastWeek.msgs) %></dd></div>
                <div class="cf-kpi"><dt>Follows</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.follows, taWow.lastWeek.follows) %></dd></div>
                <div class="cf-kpi"><dt>Subs</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.subs, taWow.lastWeek.subs) %></dd></div>
                <div class="cf-kpi"><dt>Bits</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.bits, taWow.lastWeek.bits) %></dd></div>
                <div class="cf-kpi"><dt>Raids</dt><dd class="cf-kpi-value"><%= fmtDelta(taWow.thisWeek.raids, taWow.lastWeek.raids) %></dd></div>
            </dl>
        </section>
        <% } %>

        <!-- Category / title history -->
        <% if (taCatHist.length) { %>
        <section class="cf-section" aria-labelledby="st-an-cat-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-cat-title">Category &amp; title changes</h2>
                    <p class="cf-section-desc">Last 20 edits picked up from <code>channel.update</code>.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taCatHist.forEach(c => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title"><%= c.title || '(no title)' %></div>
                        <div class="cf-list-meta"><%= c.category_name || 'uncategorized' %><% if (c.language) { %> · <%= c.language %><% } %></div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(c.changed_at).toISOString() %>"><%= fmtDate(c.changed_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Hype trains -->
        <% if (taHype.length) { %>
        <section class="cf-section" aria-labelledby="st-an-hype-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-hype-title">Hype trains</h2>
                    <p class="cf-section-desc">Last 10 start / end events.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taHype.forEach(h => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= h.event_type === 'end' ? 'Ended' : 'Started' %> · level <%= h.level ?? '?' %>
                            <% if (h.is_golden) { %><span class="cf-pill is-warn">Golden Kappa</span><% } %>
                        </div>
                        <div class="cf-list-meta"><%= h.total_bits || 0 %> bits · <%= h.total_subs || 0 %> subs<% if (h.goal) { %> · goal <%= h.goal %><% } %></div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(h.occurred_at).toISOString() %>"><%= fmtDate(h.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Goals -->
        <% if (taGoals.length) { %>
        <section class="cf-section" aria-labelledby="st-an-goals-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-goals-title">Goals</h2>
                    <p class="cf-section-desc">Current + recent follower / sub goals.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taGoals.forEach(g => { %>
                <% const pct = g.target_amount ? Math.min(100, Math.round((Number(g.current_amount) / Number(g.target_amount)) * 100)) : 0; %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= g.description || g.goal_type || 'Goal' %>
                            <% if (g.event_type === 'end') { %>
                                <span class="cf-pill<%= g.is_achieved ? ' is-ok' : '' %>"><%= g.is_achieved ? 'Hit' : 'Missed' %></span>
                            <% } else { %>
                                <span class="cf-pill is-info">In progress</span>
                            <% } %>
                        </div>
                        <div class="cf-list-meta"><%= g.current_amount ?? 0 %> / <%= g.target_amount ?? '?' %> (<%= pct %>%)</div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(g.occurred_at).toISOString() %>"><%= fmtDate(g.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Ad breaks -->
        <% if (taAds.length || (taAdsSum && Number(taAdsSum.n) > 0)) { %>
        <section class="cf-section" aria-labelledby="st-an-ads-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-ads-title">Ad schedule</h2>
                    <p class="cf-section-desc">Picked up from <code>channel.ad_break.begin</code>.</p>
                </div>
            </header>
            <% if (taAdsSum && Number(taAdsSum.n) > 0) { %>
            <dl class="cf-kpis" aria-label="Ad totals">
                <div class="cf-kpi"><dt>Ads (7d)</dt><dd class="cf-kpi-value"><%= Number(taAdsSum.n) %></dd></div>
                <div class="cf-kpi"><dt>Ad time (7d)</dt><dd class="cf-kpi-value"><%= Math.round(Number(taAdsSum.s) / 60) %>m</dd></div>
            </dl>
            <% } %>
            <% if (taAds.length) { %>
            <ul class="cf-list">
                <% taAds.slice(0, 10).forEach(a => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title"><%= a.duration_seconds || 0 %>s · <%= a.is_automatic ? 'auto' : (a.requester_user_login || 'manual') %></div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(a.started_at).toISOString() %>"><%= fmtDate(a.started_at) %></time></div>
                </li>
                <% }) %>
            </ul>
            <% } %>
        </section>
        <% } %>

        <!-- Charity -->
        <% if (taCharity.length) { %>
        <section class="cf-section" aria-labelledby="st-an-charity-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-charity-title">Charity campaigns</h2>
                    <p class="cf-section-desc">Donations, progress, and campaign lifecycle events.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taCharity.forEach(c => {
                   const amt = c.donation_amount ? (Number(c.donation_amount) / 100).toFixed(2) : null;
                   const cur = c.current_amount ? (Number(c.current_amount) / 100).toFixed(2) : null;
                   const tgt = c.target_amount ? (Number(c.target_amount) / 100).toFixed(2) : null;
                   const sym = c.donation_currency === 'USD' ? '$' : (c.donation_currency ? c.donation_currency + ' ' : '');
                %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= c.charity_name || c.event_type %>
                            <% if (c.event_type === 'donate') { %>
                                <span class="cf-pill is-ok">+<%= sym %><%= amt %></span>
                            <% } else { %>
                                <span class="cf-pill"><%= c.event_type %></span>
                            <% } %>
                        </div>
                        <div class="cf-list-meta">
                            <% if (c.event_type === 'donate' && c.donor_user_login) { %>from <%= c.donor_user_login %><% } %>
                            <% if (cur && tgt) { %> · <%= sym %><%= cur %> / <%= sym %><%= tgt %><% } %>
                        </div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(c.occurred_at).toISOString() %>"><%= fmtDate(c.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Polls -->
        <% if (taPolls.length) { %>
        <section class="cf-section" aria-labelledby="st-an-polls-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-polls-title">Polls</h2>
                    <p class="cf-section-desc">Last 5 completed polls with the winning choice.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taPolls.forEach(p => {
                    let choices = [];
                    try { choices = JSON.parse(p.choices_json || '[]'); } catch {}
                    const winner = Array.isArray(choices) ? choices.slice().sort((a,b) => (b.votes||0) - (a.votes||0))[0] : null;
                    const totalVotes = Array.isArray(choices) ? choices.reduce((s,c) => s + (Number(c.votes)||0), 0) : 0;
                %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title"><%= p.title || '(untitled)' %></div>
                        <div class="cf-list-meta">
                            <% if (winner) { %>Winner: <%= winner.title %> (<%= winner.votes || 0 %> votes)<% } else { %>No votes<% } %>
                            · <%= totalVotes %> total · status: <%= p.status || p.event_type %>
                        </div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(p.occurred_at).toISOString() %>"><%= fmtDate(p.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Predictions -->
        <% if (taPreds.length) { %>
        <section class="cf-section" aria-labelledby="st-an-preds-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-preds-title">Predictions</h2>
                    <p class="cf-section-desc">Last 5 resolved predictions.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taPreds.forEach(p => {
                    let outcomes = [];
                    try { outcomes = JSON.parse(p.outcomes_json || '[]'); } catch {}
                    const winner = outcomes.find(o => o.id === p.winning_outcome_id);
                    const totalPts = outcomes.reduce((s,o) => s + (Number(o.channel_points)||0), 0);
                %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title"><%= p.title || '(untitled)' %></div>
                        <div class="cf-list-meta">
                            <% if (winner) { %>Winner: <%= winner.title %><% } else { %>Status: <%= p.status || p.event_type %><% } %>
                            · <%= totalPts.toLocaleString() %> channel points wagered
                        </div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(p.occurred_at).toISOString() %>"><%= fmtDate(p.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Top redemptions -->
        <% if (taRewards.length) { %>
        <section class="cf-section" aria-labelledby="st-an-rew-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-rew-title">Top redemptions (7d)</h2>
                    <p class="cf-section-desc">Most-redeemed channel point rewards in the last week.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taRewards.forEach(r => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title"><%= r.reward_title %> <span class="cf-pill"><%= r.reward_cost || 0 %> pts</span></div>
                        <div class="cf-list-meta"><%= r.redemption_count %> redemption<%= Number(r.redemption_count) === 1 ? '' : 's' %> · last <%= fmtDate(r.last_redeemed) %></div>
                    </div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Shoutouts -->
        <% if (taShout.length) { %>
        <section class="cf-section" aria-labelledby="st-an-sh-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-sh-title">Shoutouts</h2>
                    <p class="cf-section-desc">Given and received, last 10.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taShout.forEach(s => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= s.direction === 'sent' ? 'To' : 'From' %> <%= s.counterpart_user_login || '(unknown)' %>
                            <span class="cf-pill<%= s.direction === 'sent' ? '' : ' is-info' %>"><%= s.direction %></span>
                        </div>
                        <div class="cf-list-meta">
                            <% if (s.viewer_count) { %><%= s.viewer_count %> viewers at the time<% } %>
                            <% if (s.direction === 'sent' && s.moderator_user_login) { %> · by <%= s.moderator_user_login %><% } %>
                        </div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(s.occurred_at).toISOString() %>"><%= fmtDate(s.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- Sub churn + resub messages -->
        <% if (taChurn && (taChurn.new_subs_7d > 0 || taChurn.ended_subs_7d > 0)) { %>
        <section class="cf-section" aria-labelledby="st-an-churn-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-churn-title">Subscription churn (7d)</h2>
                    <p class="cf-section-desc">Net sub movement in the last week.</p>
                </div>
            </header>
            <dl class="cf-kpis" aria-label="Sub churn">
                <div class="cf-kpi"><dt>New subs</dt><dd class="cf-kpi-value"><%= taChurn.new_subs_7d %></dd></div>
                <div class="cf-kpi"><dt>Ended subs</dt><dd class="cf-kpi-value"><%= taChurn.ended_subs_7d %></dd></div>
                <div class="cf-kpi"><dt>Net</dt><dd class="cf-kpi-value"><%= (taChurn.new_subs_7d - taChurn.ended_subs_7d >= 0 ? '+' : '') + (taChurn.new_subs_7d - taChurn.ended_subs_7d) %></dd></div>
            </dl>
        </section>
        <% } %>

        <% if (taResubs.length) { %>
        <section class="cf-section" aria-labelledby="st-an-resub-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-resub-title">Recent resub messages</h2>
                    <p class="cf-section-desc">Resubs with a message attached — great for shoutouts.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taResubs.forEach(r => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= r.user_login %>
                            <span class="cf-pill">T<%= (r.tier || '1000').replace(/0+$/,'') || '1' %></span>
                            <% if (r.cumulative_months) { %><span class="cf-pill is-info"><%= r.cumulative_months %>mo cumulative</span><% } %>
                            <% if (r.streak_months) { %><span class="cf-pill is-ok"><%= r.streak_months %>mo streak</span><% } %>
                        </div>
                        <div class="cf-list-meta">"<%= String(r.message || '').slice(0, 180) %>"</div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(r.occurred_at).toISOString() %>"><%= fmtDate(r.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <!-- VIP + Moderator churn -->
        <% if (taVipMod.length) { %>
        <section class="cf-section" aria-labelledby="st-an-vipmod-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="st-an-vipmod-title">VIP &amp; moderator churn</h2>
                    <p class="cf-section-desc">Role grants and revocations, last 10.</p>
                </div>
            </header>
            <ul class="cf-list">
                <% taVipMod.forEach(v => { %>
                <li class="cf-list-item">
                    <div class="cf-list-main">
                        <div class="cf-list-title">
                            <%= v.action === 'add' ? 'Granted' : 'Revoked' %> <%= v.role %> <span class="cf-pill<%= v.action === 'add' ? ' is-ok' : '' %>"><%= v.action %></span>
                        </div>
                        <div class="cf-list-meta">User: <%= v.target_user_login || '(unknown)' %></div>
                    </div>
                    <div class="cf-list-side"><time datetime="<%= new Date(v.occurred_at).toISOString() %>"><%= fmtDate(v.occurred_at) %></time></div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <% } %>
    </div>

<%- include('partials/manage/edit-streamer-modal', { guild, roles, channels }) %>
<%- include('partials/manage/bulk-actions-modal', { channels, roles }) %>
<%- include('partials/add-team-modal', { guild, channels, roles }) %>
<%- include('partials/manage-team-modal', { guild, channels, roles }) %>

<script>
/* =============================================
   TAB SWITCHING
   ============================================= */
// The tabs this partial actually renders, read off the nav so the list cannot drift.
function streamingTabNames() {
    return Array.from(document.querySelectorAll('.streaming-tab-btn')).map(btn => btn.dataset.tab);
}

function switchStreamingTab(tabName) {
    document.querySelectorAll('.streaming-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tabName);
        btn.setAttribute('aria-selected', String(btn.dataset.tab === tabName));
    });
    document.querySelectorAll('.streaming-tab-content').forEach(el => el.classList.toggle('active', el.dataset.tab === tabName));
    // Update URL without reload
    const url = new URL(window.location);
    url.searchParams.set('tab', tabName);
    history.replaceState(null, '', url);
    // Lazy-load the Twitch mods/VIPs mapping panel when the role-sync tab is opened
    if (tabName === 'role-sync') trsLoadModsVips();
}

/* =============================================
   TWITCH ROLE-SYNC: live mod/VIP mapping panel
   All DOM constructed with createElement/textContent (no innerHTML)
   to avoid XSS even though every external value goes through validation.
   ============================================= */
const TRS_GUILD_ID = '<%= guild.id %>';

function trsEl(tag, attrs = {}, ...children) {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
        if (k === 'style' && typeof v === 'object') Object.assign(e.style, v);
        else if (k === 'dataset' && typeof v === 'object') Object.assign(e.dataset, v);
        else if (k === 'onClick') e.addEventListener('click', v);
        else if (k === 'className') e.className = v;
        else if (k === 'text') e.textContent = v;
        else e.setAttribute(k, v);
    }
    for (const c of children.flat()) {
        if (c == null || c === false) continue;
        e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
    }
    return e;
}

async function trsLoadModsVips() {
    const summary = document.getElementById('trs-mods-vips-summary');
    const list    = document.getElementById('trs-mods-vips-list');
    if (!summary || !list) return;
    summary.textContent = 'Loading…';
    list.replaceChildren();
    try {
        const resp = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/mods-vips`, { headers: { 'Accept': 'application/json' } });
        const data = await resp.json();
        if (data.error) {
            summary.replaceChildren(trsEl('span', { className: 'cf-status-line is-warn' }, 'Twitch did not answer: ', trsEl('code', { text: data.error }), data.message ? ' (' + data.message + ')' : ''));
            return;
        }
        const all = [...data.mods, ...data.vips];
        const linked   = all.filter(x => x.discord_user_id).length;
        const bots     = all.filter(x => x.is_known_bot).length;
        const unlinked = all.length - linked - bots;

        summary.replaceChildren(
            trsEl('strong', { text: String(data.counts.mods_total) }), ' Twitch mods, ',
            trsEl('strong', { text: String(data.counts.vips_total) }), ' VIPs',
            ' · ', trsEl('span', { className: 'cf-pill is-ok', text: `${linked} linked` }),
            ' ', trsEl('span', { className: 'cf-pill' + (unlinked ? ' is-warn' : ''), text: `${unlinked} not linked` }),
            ' ', trsEl('span', { className: 'cf-pill', text: `${bots} bot${bots === 1 ? '' : 's'}` }),
            ' · broadcaster ', trsEl('strong', { text: data.broadcaster.twitch_username }),
        );

        if (all.length === 0) {
            list.appendChild(trsEl('p', { className: 'cf-row-desc', text: 'Twitch lists no moderators or VIPs on this channel.' }));
        } else {
            for (const row of all) list.appendChild(trsBuildRow(row));
        }

        // Reveal auto-link button only when there are high-confidence suggestions to apply
        const autoBtn = document.getElementById('trs-autolink-btn');
        if (autoBtn) {
            const candidates = all.filter(r => !r.discord_user_id && !r.is_known_bot && r.suggestion?.score >= 90);
            if (candidates.length > 0) {
                autoBtn.hidden = false;
                autoBtn.textContent = `Link ${candidates.length} close match${candidates.length === 1 ? '' : 'es'}`;
                autoBtn.onclick = () => trsAutoLinkAll(candidates);
            } else {
                autoBtn.hidden = true;
            }
        }
    } catch (err) {
        summary.replaceChildren(trsEl('span', { className: 'cf-status-line is-bad', text: 'Could not load the list: ' + err.message }));
    }
}

async function trsAutoLinkAll(candidates) {
    if (!confirm(`Link ${candidates.length} Twitch moderator${candidates.length === 1 ? '' : 's'} or VIP${candidates.length === 1 ? '' : 's'} to the Discord member with the same or almost the same name?\n\nYou can unlink any of them afterwards if a match is wrong.`)) return;
    const btn = document.getElementById('trs-autolink-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Linking'; }
    let succeeded = 0, failed = 0;
    for (const row of candidates) {
        try {
            const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/link`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    twitch_user_id: row.twitch_user_id,
                    twitch_username: row.twitch_username,
                    discord_user_id: row.suggestion.discord_user_id,
                }),
            });
            const j = await r.json();
            if (j.success) succeeded++; else failed++;
        } catch { failed++; }
    }
    alert(`${succeeded} linked${failed ? `, ${failed} could not be linked` : ''}.`);
    trsLoadModsVips();
}

function trsBuildRow(row) {
    const badge = trsEl('span', { className: 'cf-pill ' + (row.type === 'mod' ? 'is-info' : 'is-warn'), text: row.type === 'mod' ? 'Moderator' : 'VIP' });

    const twitchCell = trsEl('div', { className: 'st-plain-main' },
        trsEl('span', {}, badge, ' ', trsEl('span', { className: 'st-trs-twitch', text: row.twitch_display_name || row.twitch_username })),
        trsEl('span', { className: 'st-meta', text: '@' + row.twitch_username }),
    );

    let action;
    if (row.is_known_bot) {
        action = trsEl('span', { className: 'st-meta', text: 'Known Twitch bot, not linked to anyone' });
    } else if (row.discord_user_id) {
        const children = [
            trsEl('span', { className: 'cf-status-line is-ok' },
                'Linked to ',
                window.CFUser ? CFUser.cell(row.discord_user_id, { size: 'sm' }) : trsEl('code', { text: row.discord_user_id })),
            trsEl('span', { className: 'st-meta', text: 'via ' + row.link_source }),
        ];
        if (row.link_source === 'community_twitch_links') {
            const unlinkBtn = trsEl('button',
                { type: 'button', className: 'btn btn-sm btn-secondary', dataset: { discordId: row.discord_user_id }, onClick: (e) => trsUnlink(e.currentTarget) },
                'Unlink'
            );
            children.push(unlinkBtn);
        }
        action = trsEl('div', { className: 'st-plain-actions' }, ...children);
    } else {
        const input = trsEl('input',
            { list: 'trs-discord-members', type: 'text', className: 'form-control form-control-sm',
              placeholder: 'Discord member or user ID',
              'aria-label': 'Discord member for ' + row.twitch_username,
              dataset: { trsInput: 'discord_id' } }
        );
        // Pre-fill input with suggestion if confident enough
        if (row.suggestion?.score >= 60) input.value = row.suggestion.discord_user_id;

        const linkBtn = trsEl('button',
            { type: 'button', className: 'btn btn-sm btn-primary',
              dataset: { twitchId: row.twitch_user_id, twitchUsername: row.twitch_username },
              onClick: (e) => trsLink(e.currentTarget) },
            'Link'
        );

        const children = [input, linkBtn];

        // The suggested match, toned by how close the names are.
        if (row.suggestion) {
            const s = row.suggestion;
            children.push(trsEl('span',
                { className: 'cf-pill ' + (s.score >= 90 ? 'is-ok' : s.score >= 75 ? 'is-info' : 'is-warn'), title: s.reason },
                `Suggested: ${s.discord_username} (${s.score})`,
            ));
        }
        action = trsEl('div', { className: 'st-plain-actions' }, ...children);
    }

    // Revoke button — removes the user's VIP/Mod role on Twitch via the roles manager API.
    const revokeBtn = trsEl('button',
        { type: 'button', className: 'btn btn-sm btn-secondary',
          dataset: { role: row.type, login: row.twitch_username, userId: row.twitch_user_id },
          onClick: (e) => trsRevokeRole(e.currentTarget),
          title: `Take ${row.type === 'mod' ? 'moderator' : 'VIP'} away from ${row.twitch_username} on Twitch` },
        row.type === 'mod' ? 'Remove moderator' : 'Remove VIP',
    );

    return trsEl('div', { className: 'st-plain-item' }, twitchCell, action, revokeBtn);
}

async function trsGrantRole(role, op) {
    const input = document.getElementById(`trs-grant-${role}-input`);
    const status = document.getElementById(`trs-grant-${role}-status`);
    const login = input?.value?.trim();
    const tone = (t) => { status.className = 'cf-status-line' + (t ? ' is-' + t : ''); };
    if (!login) { status.textContent = 'Enter a Twitch username first.'; tone('warn'); return; }
    status.textContent = 'Working'; tone('');
    try {
        const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-roles/${role}/${op}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_login: login }),
        });
        const data = await r.json().catch(() => ({ ok: false, error: 'parse_failed' }));
        if (data.ok) {
            status.textContent = `${op === 'add' ? 'Added' : 'Removed'} ${data.user.display_name || login} as ${role.toUpperCase()}.`;
            tone('ok');
            input.value = '';
            setTimeout(() => trsLoadModsVips(), 400); // let Helix propagate
        } else {
            let msg = data.error || 'failed';
            if (data.scope_missing) msg = `Scope missing: ${data.scope_missing} — reauth broadcaster-write.`;
            status.textContent = msg; tone('bad');
        }
    } catch (e) {
        status.textContent = e.message; tone('bad');
    }
}

async function trsRevokeRole(btn) {
    const role = btn.dataset.role;
    const login = btn.dataset.login;
    const userId = btn.dataset.userId;
    if (!confirm(`Remove ${role.toUpperCase()} from @${login} on Twitch?`)) return;
    btn.disabled = true;
    try {
        // Pass user_id — handles platform-banned Twitch users whose login no longer resolves.
        const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-roles/${role}/remove`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: userId, user_login: login }),
        });
        const data = await r.json().catch(() => ({ ok: false, error: 'parse_failed' }));
        if (data.ok) {
            setTimeout(() => trsLoadModsVips(), 400);
        } else {
            alert(`Revoke failed: ${data.error || 'unknown'}${data.scope_missing ? ' (scope ' + data.scope_missing + ' not granted — reauth broadcaster-write)' : ''}`);
            btn.disabled = false;
        }
    } catch (e) {
        alert('Revoke failed: ' + e.message);
        btn.disabled = false;
    }
}

async function trsLink(btn) {
    const row = btn.closest('div');
    const input = row?.querySelector('input[data-trs-input="discord_id"]');
    const discord_user_id = input?.value?.trim();
    if (!discord_user_id || !/^\d{15,21}$/.test(discord_user_id)) {
        alert('Pick a Discord user from the dropdown (or paste a numeric user ID).');
        return;
    }
    btn.disabled = true;
    try {
        const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/link`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                twitch_user_id: btn.dataset.twitchId,
                twitch_username: btn.dataset.twitchUsername,
                discord_user_id,
            }),
        });
        const j = await r.json();
        if (j.success) trsLoadModsVips();
        else { alert(`Link failed: ${j.error || 'unknown'} ${j.message || ''}`); btn.disabled = false; }
    } catch (err) {
        alert('Link failed: ' + err.message);
        btn.disabled = false;
    }
}

async function trsUnlink(btn) {
    if (!confirm('Remove this Twitch ↔ Discord link?')) return;
    btn.disabled = true;
    try {
        const r = await fetch(`/manage/${TRS_GUILD_ID}/twitch-role-sync/unlink`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ discord_user_id: btn.dataset.discordId }),
        });
        const j = await r.json();
        if (j.success) trsLoadModsVips();
        else { alert(`Unlink failed: ${j.error}`); btn.disabled = false; }
    } catch (err) {
        alert('Unlink failed: ' + err.message);
        btn.disabled = false;
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('trs-refresh-btn');
    if (btn) btn.addEventListener('click', trsLoadModsVips);
});

/* =============================================
   STREAMERS TAB JS
   ============================================= */
function waitForBootstrap(callback, maxAttempts = 50) {
    let attempts = 0;
    function check() {
        if (typeof bootstrap !== 'undefined') {
            callback();
        } else if (attempts < maxAttempts) {
            attempts++;
            setTimeout(check, 50);
        } else {
            callback();
        }
    }
    check();
}

// Run immediately — partial is rendered after DOM is ready
(function() {
    // Init tab: an explicit ?tab= wins, otherwise the page's own tab (this partial serves
    // ?page=twitch-schedules, teams, auto-track and friends, which each open on their own tab).
    const params = new URLSearchParams(window.location.search);
    const known = streamingTabNames();
    const requested = [params.get('tab'), window.MANAGE_PAGE_TAB]
        .find(t => t && known.includes(t));
    switchStreamingTab(requested || known[0] || 'streamers');
    // The "When a stream ends" page shares the Streamers tab: bring its section into view.
    if (<%- JSON.stringify(typeof page !== 'undefined' ? page : '').replace(/</g, '\\u003c') %> === 'stream-ended' && !params.get('tab')) {
        document.querySelector('[data-st-end]')?.scrollIntoView({ block: 'start' });
    }

    waitForBootstrap(() => {
        const modal = document.getElementById('edit-streamer-modal');
        if (!modal) return;

        document.querySelectorAll('.edit-streamer-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();

                const modalEl = document.getElementById('edit-streamer-modal');
                if (!modalEl) return;

                const streamerData = btn.getAttribute('data-streamer');

                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    try {
                        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modalEl._streamerData = streamerData;
                        modalEl._triggerButton = btn;
                        bsModal.show();
                    } catch (err) {
                        openModalManually(modalEl, btn);
                    }
                } else {
                    openModalManually(modalEl, btn);
                }
            });
        });
    });

    function openModalManually(modalEl, btn) {
        modalEl._triggerButton = btn;

        let backdrop = document.querySelector('.modal-backdrop');
        if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            document.body.appendChild(backdrop);
        }

        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        modalEl.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');

        const event = new CustomEvent('show.bs.modal', {
            bubbles: true,
            detail: { relatedTarget: btn }
        });
        modalEl.dispatchEvent(event);

        backdrop.onclick = () => closeModalManually(modalEl);

        modalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(closeBtn => {
            closeBtn.addEventListener('click', () => closeModalManually(modalEl));
        });

        document.addEventListener('keydown', function escHandler(e) {
            if (e.key === 'Escape') {
                closeModalManually(modalEl);
                document.removeEventListener('keydown', escHandler);
            }
        });
    }

    function closeModalManually(modalEl) {
        modalEl.classList.remove('show');
        modalEl.style.display = 'none';
        modalEl.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
        document.querySelector('.modal-backdrop')?.remove();
    }

    // Search functionality
    const searchInput = document.getElementById('streamerSearch');
    const tableBody = document.getElementById('streamersTableBody');

    if (searchInput && tableBody) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const rows = tableBody.querySelectorAll('.streamer-row');

            rows.forEach(row => {
                const name = row.dataset.streamerName;
                const platforms = row.dataset.platforms;

                if (name.includes(query) || platforms.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }

    // Ignored roles count
    const ignoredSelect = document.getElementById('ignored-roles-select-streaming');
    const ignoredCount = document.getElementById('ignored-roles-count-streaming');
    if (ignoredSelect && ignoredCount) {
        function updateIgnoredCount() {
            const count = ignoredSelect.selectedOptions.length;
            ignoredCount.textContent = count > 0 ? ` \u2014 ${count} role(s) selected` : '';
        }
        updateIgnoredCount();
        ignoredSelect.addEventListener('change', updateIgnoredCount);
    }
})();

/* ---- Bulk selection logic ---- */
function updateBulkSelection() {
    const checked = document.querySelectorAll('.streamer-checkbox:checked');
    const bulkBtn = document.getElementById('bulk-actions-btn');
    const bulkCount = document.getElementById('bulk-count');
    const selectAll = document.getElementById('select-all-streamers');

    if (bulkBtn) bulkBtn.style.display = checked.length > 0 ? '' : 'none';
    if (bulkCount) bulkCount.textContent = checked.length;

    const subIds = [];
    checked.forEach(cb => {
        const row = cb.closest('tr');
        const ids = (row?.dataset.subscriptionIds || '').split(',').filter(Boolean);
        subIds.push(...ids);
    });
    window._bulkSelectedSubscriptionIds = subIds;

    const countEl = document.getElementById('bulk-selection-count');
    if (countEl) countEl.textContent = checked.length + ' streamer(s) selected (' + subIds.length + ' subscription(s))';

    const allCheckboxes = document.querySelectorAll('.streamer-checkbox');
    if (selectAll && allCheckboxes.length > 0) {
        selectAll.checked = checked.length === allCheckboxes.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < allCheckboxes.length;
    }
}

document.getElementById('select-all-streamers')?.addEventListener('change', function() {
    document.querySelectorAll('.streamer-checkbox').forEach(cb => { cb.checked = this.checked; });
    updateBulkSelection();
});

document.addEventListener('change', function(e) {
    if (e.target.classList.contains('streamer-checkbox')) updateBulkSelection();
});

/* ---- Guild stream-end defaults ---- */
(function() {
    const editCb = document.getElementById('sed-edit');
    const keepCb = document.getElementById('sed-keep');
    if (!editCb || !keepCb) return;

    const outcome = document.getElementById('sed-outcome');
    const status = document.getElementById('eoe-status');

    function paint(cb, onColor) {
        const track = cb.parentElement.querySelector('.eoe-toggle-track');
        const dot = cb.parentElement.querySelector('.eoe-toggle-dot');
        track.style.background = cb.checked ? onColor : 'var(--cf-surface-3)';
        dot.style.left = cb.checked ? '18px' : '2px';
    }

    // Cleanup checks edit_on_end before delete_on_end, so "edit" and "keep" are
    // genuinely exclusive outcomes — never let the UI claim both.
    function render() {
        paint(editCb, 'var(--cf-accent)');
        paint(keepCb, 'var(--cf-accent)');
        outcome.textContent = editCb.checked
            ? 'New streamers: the live announcement is edited to a "stream ended" summary.'
            : (keepCb.checked
                ? 'New streamers: the live announcement is left up untouched.'
                : 'New streamers: the live announcement is deleted when the stream ends.');
    }

    editCb.addEventListener('change', () => { if (editCb.checked) keepCb.checked = false; render(); });
    keepCb.addEventListener('change', () => { if (keepCb.checked) editCb.checked = false; render(); });
    render();

    function say(msg, type) {
        status.textContent = msg;
        status.className = 'cf-notice ' + (type === 'error' ? 'is-bad' : 'is-ok');
        status.hidden = false;
        setTimeout(() => { status.hidden = true; }, 4000);
    }

    async function saveDefaults(applyToExisting) {
        const body = {
            edit_on_end: editCb.checked,
            delete_on_end: editCb.checked ? true : !keepCb.checked,
            apply_to_existing: !!applyToExisting
        };
        try {
            const res = await fetch(`/api/guilds/<%= guild.id %>/stream-ended/defaults`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.success) {
                if (applyToExisting) {
                    say(`Default saved and applied to ${data.applied} subscription${data.applied === 1 ? '' : 's'}.`, 'success');
                    setTimeout(() => location.reload(), 900);
                } else {
                    say('Server default saved.', 'success');
                }
            } else {
                say(data.error || `Server error ${res.status}`, 'error');
            }
        } catch (err) {
            say('Network error: ' + err.message, 'error');
        }
    }

    document.getElementById('sed-save').addEventListener('click', () => saveDefaults(false));

    document.getElementById('sed-apply-all').addEventListener('click', () => {
        const label = editCb.checked ? 'Edit on End' : (keepCb.checked ? 'Keep on End' : 'Delete on End');
        if (!confirm(`Set EVERY streamer in this server to "${label}"?\n\nThis overwrites per-streamer settings you have already changed.`)) return;
        saveDefaults(true);
    });
})();

/* ---- Edit on End inline toggle ---- */
async function toggleEoeInline(checkbox) {
    const subIds = (checkbox.dataset.subIds || '').split(',').filter(Boolean);
    const editOnEnd = checkbox.checked;
    const status = document.getElementById('eoe-status');
    const label = checkbox.parentElement;
    const track = label.querySelector('.eoe-toggle-track');
    const dot = label.querySelector('.eoe-toggle-dot');

    try {
        const res = await fetch('/api/guilds/<%= guild.id %>/stream-ended/subscriptions/bulk', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_ids: subIds, edit_on_end: editOnEnd })
        });
        const data = await res.json();
        if (data.success) {
            track.style.background = editOnEnd ? 'var(--cf-accent)' : 'var(--cf-surface-3)';
            dot.style.left = editOnEnd ? '18px' : '2px';
            label.title = `Edit on end for all ${subIds.length} of this streamer's subscriptions`;
            status.textContent = 'Edit on end updated.';
            status.className = 'cf-notice is-ok';
            status.hidden = false;
        } else {
            checkbox.checked = !editOnEnd;
            status.textContent = data.error || 'Failed to update';
            status.className = 'cf-notice is-bad';
            status.hidden = false;
        }
    } catch (err) {
        checkbox.checked = !editOnEnd;
        status.textContent = 'Network error';
        status.className = 'cf-notice is-bad';
        status.hidden = false;
    }
    setTimeout(() => { status.hidden = true; }, 3000);
}

