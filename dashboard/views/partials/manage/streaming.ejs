async function atDelete(autoId) {
    if (!confirm('Remove this auto-track mapping?')) return;
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs/${autoId}`, { method: 'DELETE' });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            atShowStatus(data.error || 'Failed to delete mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
}
</script>


<script>
(function(){
  const guildId = (window.location.pathname.match(/manage\/(\d+)/) || [])[1];
  if (!guildId) return;
  const base = `/api/guilds/${guildId}/streaming`;
  const PLATFORM_LABEL = { twitch: 'Twitch', youtube: 'YouTube', kick: 'Kick', tiktok: 'TikTok', rumble: 'Rumble', trovo: 'Trovo' };
  const CHANNEL_NAMES = <%- JSON.stringify(Object.fromEntries((channels || []).map(c => [c.id, c.name]))).replace(/</g, '\\u003c') %>;

  function el(tag, props) {
    const node = document.createElement(tag);
    if (!props) return node;
    for (const k of Object.keys(props)) {
      if (k === 'style') node.style.cssText = props[k];
      else if (k === 'text') node.textContent = props[k];
      else if (k === 'className') node.className = props[k];
      else node.setAttribute(k, props[k]);
    }
    return node;
  }

  async function rescan(btn) {
    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-rotate fa-spin"></i> <span>Scanning…</span>';
    // A proxy timeout or login redirect returns HTML, not JSON; report the status instead of a parse error.
    async function readJson(r) {
      const text = await r.text();
      try { return JSON.parse(text); }
      catch { throw new Error(`server returned ${r.status} ${r.statusText || ''}`.trim()); }
    }
    try {
      const start = await fetch(base + '/rescan', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
      const s = await readJson(start);
      if (!start.ok) throw new Error(s.error || 'Rescan failed');
      // The scan runs in the background; poll until it finishes (give up after 10 minutes).
      const label = btn.querySelector('span');
      const deadline = Date.now() + 10 * 60_000;
      let j;
      for (;;) {
        await new Promise(res => setTimeout(res, 3000));
        const r = await fetch(base + '/rescan', { headers: { Accept: 'application/json' } });
        j = await readJson(r);
        if (!r.ok) throw new Error(j.error || 'Rescan failed');
        if (j.status === 'error') throw new Error(j.error || 'Rescan failed');
        if (j.status === 'idle') throw new Error('the scan was interrupted (bot restarted?); try again');
        if (j.status !== 'running') break;
        if (label) label.textContent = `Scanning… ${Math.round((Date.now() - j.startedAt) / 1000)}s`;
        if (Date.now() > deadline) throw new Error('still running after 10 minutes; check back later');
      }
      const summary = (j.scope ? `${j.scope} scanned` : 'none to scan')
        + (j.announced ? ` · ${j.announced} newly announced` : ' · nothing new')
        + (j.errors ? ` · ${j.errors} error(s)` : '');
      alert('Rescan complete — ' + summary);
    } catch (e) {
      alert('Rescan failed: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = original;
    }
  }

  async function loadDeparted() {
    const list = document.getElementById('cf-departed-list');
    list.replaceChildren(el('p', { className: 'cf-row-desc', text: 'Loading' }));
    try {
      const r = await fetch(base + '/departed');
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'load failed');
      list.replaceChildren();
      if (!j.departed?.length) {
        list.appendChild(el('p', { className: 'cf-row-desc', text: 'Nothing has been removed.' }));
        return;
      }
      const REASONS = { manual: 'removed by staff', leave: 'member left', kick: 'member was kicked', ban: 'member was banned', sweep: 'member no longer in the server', guild_left: 'bot left the server' };
      for (const d of j.departed) {
        const row = el('div', { className: 'st-plain-item' });
        const info = el('div', { className: 'st-plain-main' });
        info.append(el('span', { className: 'st-check-name', text: d.username || 'Unknown' }),
          el('span', { className: 'st-meta', text: `${PLATFORM_LABEL[d.platform] || d.platform || 'Unknown platform'} · ${REASONS[d.departed_reason] || d.departed_reason || 'removed'} · ${d.days_gone} day${d.days_gone === 1 ? '' : 's'} ago` }));
        const btn = el('button', { className: 'btn btn-sm btn-secondary', type: 'button', text: 'Restore' });
        btn.addEventListener('click', async () => {
            btn.disabled = true;
            try {
                const r2 = await fetch(base + '/restore-one', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subscriptionId: d.subscription_id }) });
                const j2 = await r2.json();
                if (!r2.ok) throw new Error(j2.error || 'Restore failed');
                row.remove();
            } catch (e) {
                btn.disabled = false;
                alert('Restore failed: ' + e.message);
            }
        });
        row.append(info, btn);
        list.appendChild(row);
      }
    } catch (e) {
      list.replaceChildren(document.createTextNode('Load failed: ' + e.message));
    }
  }

  async function loadHistory() {
    const list = document.getElementById('cf-history-list');
    list.replaceChildren(el('p', { className: 'cf-row-desc', text: 'Loading' }));
    try {
      const r = await fetch(base + '/removed-history');
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'load failed');
      list.replaceChildren();
      if (!j.history?.length) {
        list.appendChild(el('p', { className: 'cf-row-desc', text: 'Nothing to recover.' }));
        return;
      }
      for (const h of j.history) {
        const row = el('div', { className: 'st-plain-item' });
        const info = el('div', { className: 'st-plain-main' });
        const ch = CHANNEL_NAMES[h.last_channel_id];
        info.append(el('span', { className: 'st-check-name', text: h.username || 'Unknown' }),
          el('span', { className: 'st-meta', text: `${PLATFORM_LABEL[h.platform] || h.platform || 'Unknown platform'} · ${h.announce_count} earlier announcement${h.announce_count === 1 ? '' : 's'} · last in ${ch ? '#' + ch : 'a deleted channel'}` }));
        const btn = el('button', { className: 'btn btn-sm btn-secondary', type: 'button', text: 'Subscribe again' });
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const r2 = await fetch(base + '/resubscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ streamerId: h.streamer_id, channelId: h.last_channel_id }) });
            const j2 = await r2.json();
            if (!r2.ok) throw new Error(j2.error || 'Resubscribe failed');
            row.remove();
          } catch (e) {
            btn.disabled = false;
            alert('Resubscribe failed: ' + e.message);
          }
        });
        row.append(info, btn);
        list.appendChild(row);
      }
    } catch (e) {
      list.replaceChildren(document.createTextNode('Load failed: ' + e.message));
    }
  }

  async function restore(mode, btn) {
    if (!confirm(mode === 'all' ? 'Put back every removed subscription?' : 'Put back every removed subscription except the ones staff removed?')) return;
    btn.disabled = true;
    try {
      const r = await fetch(base + '/restore', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode }) });
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'Restore failed');
      alert(`Restored ${j.restored} subscription${j.restored === 1 ? '' : 's'}.`);
      await loadDeparted();
    } catch (e) {
      alert('Restore failed: ' + e.message);
    } finally {
      btn.disabled = false;
    }
  }

  document.getElementById('cf-rescan-live-btn')?.addEventListener('click', e => rescan(e.currentTarget));
  document.getElementById('cf-departed-btn')?.addEventListener('click', () => {
    const card = document.getElementById('cf-departed-card');
    card.hidden = !card.hidden;
    if (!card.hidden) { loadDeparted(); loadHistory(); card.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  });
  document.getElementById('cf-departed-close')?.addEventListener('click', () => {
    document.getElementById('cf-departed-card').hidden = true;
  });
  document.getElementById('cf-restore-all')?.addEventListener('click', e => restore('all', e.currentTarget));
  document.getElementById('cf-restore-except-manual')?.addEventListener('click', e => restore('except-manual', e.currentTarget));
})();
</script>

<script src="/js/cf-msgpreview.js"></script>
<script>
/* Announcement defaults: live preview, test post; and the live role check. DOM is built with
   createElement/textContent throughout (role and member names are server data). */
(function () {
    const GUILD = '<%= guild.id %>';
    const CTX = {
        channels: <%- JSON.stringify((channels || []).map(c => ({ id: c.id, name: c.name }))).replace(/</g, '\\u003c') %>,
        roles: <%- JSON.stringify(stRoles.map(r => ({ id: r.id, name: r.name, color: r.color }))).replace(/</g, '\\u003c') %>,
    };
    const $ = (id) => document.getElementById(id);
    const $st = (k) => document.querySelector(`[data-st="${k}"]`);
    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; };
    const setStatus = (node, text, tone) => { node.textContent = text; node.className = 'cf-status-line' + (tone ? ' is-' + tone : ''); };

    // ---- Announcement defaults preview ----
    const frame = $st('def-preview');
    const msg = $('f-streaming-announcement_message');
    const persona = $('webhook-persona-check');
    const SAMPLE = { streamer: 'SampleStreamer', username: 'SampleStreamer', platform: 'Twitch', game: 'Just Chatting', title: 'Sample stream title', url: 'https://twitch.tv/samplestreamer', everyone: '@everyone' };
    function drawDefault() {
        if (!frame || !window.CFMsgPreview) return;
        const asStreamer = !!persona?.checked;
        CFMsgPreview.render(frame, {
            username: asStreamer ? SAMPLE.streamer : frame.dataset.botName,
            avatarUrl: asStreamer ? '' : frame.dataset.botAvatar,
            content: CFMsgPreview.fill(msg?.value || '', SAMPLE),
            embeds: [{
                color: '#9146FF',
                author: { name: `${SAMPLE.streamer} is LIVE on Twitch!` },
                title: SAMPLE.title, url: SAMPLE.url,
                fields: [{ name: 'Playing', value: SAMPLE.game, inline: true }, { name: 'Viewers', value: '123', inline: true }],
                thumbnail: { placeholder: '' },
                image: { placeholder: 'Live stream preview' },
                timestamp: true,
            }],
        }, CTX);
    }
    msg?.addEventListener('input', drawDefault);
    persona?.addEventListener('change', drawDefault);
    drawDefault();

    $st('def-test')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const status = $st('def-test-status');
        const channelId = $('f-streaming-announcement_channel_id')?.value || '';
        if (!channelId) { setStatus(status, 'Choose a default channel first.', 'warn'); return; }
        btn.disabled = true;
        setStatus(status, 'Sending', '');
        try {
            const r = await fetch(`/api/guilds/${GUILD}/streaming/test-alert`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ channel_id: channelId, message: msg?.value || '' }),
            });
            const j = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(j.error || `Request failed (${r.status})`);
            setStatus(status, `Test posted in #${j.channel}.`, 'ok');
        } catch (err) {
            setStatus(status, err.message, 'bad');
        } finally {
            btn.disabled = false;
        }
    });

    // ---- Live role check ----
    const out = $st('lrc-out');
    function renderCheck(j) {
        const parts = [];
        if (!j.bot.canManageRoles) {
            const n = el('div', 'cf-notice is-bad');
            n.setAttribute('role', 'note');
            n.appendChild(el('p', 'cf-notice-body', 'The bot does not have the Manage Roles permission, so it cannot give any live role. Turn it on for the bot’s role in Server Settings, Roles.'));
            parts.push(n);
        }
        if (!j.roles.length) {
            parts.push(el('p', 'cf-row-desc', 'No live role is set, on the server default, a streamer or a team.'));
        } else {
            const list = el('div', 'st-check-list');
            j.roles.forEach((r) => {
                const item = el('div', 'st-check-item');
                const main = el('div', 'st-check-main');
                const name = el('span', 'st-check-name');
                const dot = el('span', 'st-role-dot');
                if (r.color && r.color !== '#000000') dot.style.setProperty('--st-role', r.color);
                name.append(dot, document.createTextNode(r.name ? '@' + r.name : 'Deleted role'));
                main.appendChild(name);
                const more = r.usedByCount > r.usedBy.length ? ` and ${r.usedByCount - r.usedBy.length} more` : '';
                main.appendChild(el('span', 'st-meta', 'Used by ' + r.usedBy.join(', ') + more));
                if (r.problem) main.appendChild(el('span', 'cf-status-line is-bad', r.problem));
                item.append(main, el('span', 'cf-pill ' + (r.status === 'ok' ? 'is-ok' : 'is-bad'), r.status === 'ok' ? 'Bot can give it' : 'Needs fixing'));
                list.appendChild(item);
            });
            parts.push(list);
        }
        const g = j.grants;
        parts.push(el('p', 'cf-row-desc', g.total
            ? `${g.total} member${g.total === 1 ? ' has' : 's have'} a live role from the bot; ${g.live} of them ${g.live === 1 ? 'is' : 'are'} live now.`
            : 'Nobody has a live role from the bot right now.'));
        if (g.notLive.length) {
            const list = el('div', 'st-check-list');
            g.notLive.forEach((m) => {
                const item = el('div', 'st-check-item');
                const main = el('div', 'st-check-main');
                main.appendChild(el('span', 'st-check-name', m.user || `Member ${m.userId}`));
                const since = m.grantedAt ? new Date(m.grantedAt).toLocaleString() : 'unknown';
                main.appendChild(el('span', 'st-meta', `${m.role ? '@' + m.role : 'Deleted role'} since ${since}. Not live now: the next stream check takes it back. If it stays, remove it by hand.`));
                item.append(main, el('span', 'cf-pill is-warn', 'Not live'));
                list.appendChild(item);
            });
            parts.push(list);
        }
        if (j.unlinked) {
            parts.push(el('p', 'cf-row-desc', `${j.unlinked} streamer${j.unlinked === 1 ? ' has' : 's have'} a live role but no linked Discord member, so nobody gets it for them. Link a member with Edit in the list above.`));
        }
        out.replaceChildren(...parts);
    }
    $st('lrc-run')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        out.replaceChildren(el('p', 'cf-row-desc', 'Checking'));
        try {
            const r = await fetch(`/api/guilds/${GUILD}/streaming/live-role-check`, { headers: { Accept: 'application/json' } });
            const j = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(j.error || `Request failed (${r.status})`);
            renderCheck(j);
        } catch (err) {
            out.replaceChildren(el('p', 'cf-status-line is-bad', err.message));
        } finally {
            btn.disabled = false;
        }
    });
})();
</script>
