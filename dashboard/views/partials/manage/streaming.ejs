/* =============================================
   AUTO-TRACK TAB JS
   ============================================= */
const atGuildId = '<%= guild.id %>';

function atShowStatus(msg, type) {
    const el = document.getElementById('at-status');
    el.textContent = msg;
    el.className = 'cf-notice ' + (type === 'error' ? 'is-bad' : 'is-ok');
    el.hidden = false;
    setTimeout(() => { el.hidden = true; }, 4000);
}

function atParseStreamEnd(val) {
    if (val === 'edit') return { delete_on_end: true, edit_on_end: true };
    if (val === 'keep') return { delete_on_end: false, edit_on_end: false };
    return { delete_on_end: true, edit_on_end: false };
}

// --- Live channel routing rules ---
const lrPicked = (id) => Array.from(document.getElementById(id)?.selectedOptions || []).map(o => o.value).filter(Boolean);

async function lrRequest(path, options, okMessage, reload) {
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/live-routing/${path}`, options);
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
            if (reload) { location.reload(); return; }
            atShowStatus(okMessage, 'success');
        } else {
            atShowStatus(data.error || `Server error ${res.status}`, 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
}

const lrJson = (body) => ({
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
});

document.getElementById('lr-add-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const channelId = e.target.channel_id.value;
    if (!channelId) { atShowStatus('Please select a channel.', 'error'); return; }
    await lrRequest('rules', {
        method: 'POST',
        ...lrJson({
            label: e.target.label.value || null,
            priority: Number(e.target.priority.value) || 0,
            channel_id: channelId,
            role_ids: Array.from(e.target.role_ids.selectedOptions).map(o => o.value)
        })
    }, 'Routing rule added', true);
});

async function lrSave(ruleId) {
    await lrRequest(`rules/${ruleId}`, {
        method: 'PATCH',
        ...lrJson({
            label: document.getElementById(`lr-label-${ruleId}`).value || null,
            priority: Number(document.getElementById(`lr-priority-${ruleId}`).value) || 0,
            channel_id: document.getElementById(`lr-channel-${ruleId}`).value,
            role_ids: lrPicked(`lr-roles-${ruleId}`),
            source_channel_ids: lrPicked(`lr-sources-${ruleId}`),
            exclude_owner: document.getElementById(`lr-owner-${ruleId}`).value === '1',
            apply_to_unrouted: document.getElementById(`lr-unrouted-${ruleId}`).value === '1'
        })
    }, 'Routing rule updated');
}

async function lrToggle(ruleId) {
    await lrRequest(`rules/${ruleId}/toggle`, { method: 'PATCH' }, 'Routing rule toggled', true);
}

async function lrDelete(ruleId) {
    if (!confirm('Delete this routing rule?')) return;
    await lrRequest(`rules/${ruleId}`, { method: 'DELETE' }, 'Routing rule removed', true);
}

document.getElementById('at-add-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const streamEnd = atParseStreamEnd(e.target.stream_end.value);
    const body = {
        role_id: e.target.role_id.value || null,
        announcement_channel_id: e.target.announcement_channel_id.value,
        live_role_id: e.target.live_role_id.value || null,
        delete_on_end: streamEnd.delete_on_end,
        edit_on_end: streamEnd.edit_on_end
    };
    if (!body.announcement_channel_id) {
        atShowStatus('Please select a channel.', 'error');
        return;
    }
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            atShowStatus(data.error || 'Failed to add mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
});

async function atEdit(autoId) {
    try {
        const streamEnd = atParseStreamEnd(document.getElementById(`at-streamend-${autoId}`).value);
        const body = {
            role_id: document.getElementById(`at-role-${autoId}`).value || null,
            announcement_channel_id: document.getElementById(`at-channel-${autoId}`).value,
            live_role_id: document.getElementById(`at-liverole-${autoId}`).value || null,
            delete_on_end: streamEnd.delete_on_end,
            edit_on_end: streamEnd.edit_on_end
        };
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs/${autoId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}: ${text.substring(0, 100)}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            atShowStatus('Mapping updated successfully', 'success');
        } else {
            atShowStatus(data.error || 'Failed to update mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
    }
}

async function atToggle(autoId) {
    try {
        const res = await fetch(`/api/guilds/${atGuildId}/auto-track/configs/${autoId}/toggle`, { method: 'PATCH' });
        if (!res.ok) {
            const text = await res.text();
            try { const data = JSON.parse(text); atShowStatus(data.error || `Error ${res.status}`, 'error'); }
            catch { atShowStatus(`Server error ${res.status}`, 'error'); }
            return;
        }
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            atShowStatus(data.error || 'Failed to toggle mapping', 'error');
        }
    } catch (err) {
        atShowStatus('Error: ' + err.message, 'error');
