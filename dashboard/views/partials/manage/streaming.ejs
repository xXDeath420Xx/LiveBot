<%
const announcementSettings = settings || {};
const defaultChannelId = announcementSettings.announcement_channel_id || '';
const defaultLiveRoleId = announcementSettings.live_role_id || '';
const defaultMessage = announcementSettings.announcement_message || '{streamer} is now live on {platform}! {url}';
const useWebhookPersona = announcementSettings.use_webhook_persona === 1;
const ignoredRoles = announcementSettings.stream_ignored_roles || [];
const seSubscriptions = typeof streamEndedSubs !== 'undefined' ? streamEndedSubs : [];
const atConfigs = typeof autoTrackConfigs !== 'undefined' ? autoTrackConfigs : [];
const atRoles = typeof roles !== 'undefined' ? roles : [];
const atChannels = typeof channels !== 'undefined' ? channels : [];
const syncs = twitchScheduleSyncs || [];
const twitchStreamers = consolidatedStreamers ? consolidatedStreamers.filter(s => s.platforms?.includes('twitch')) : [];

// Build a lookup map: subscription_id -> edit_on_end
const editOnEndMap = {};
seSubscriptions.forEach(sub => {
    editOnEndMap[sub.subscription_id] = !!sub.edit_on_end;
});
%>

<style>
/* =============================================
   STREAMING UNIFIED DASHBOARD STYLES
   ============================================= */

/* Tab Navigation */
.streaming-tab-nav {
    display: flex;
    gap: 4px;
    margin-bottom: 20px;
    background: rgba(255,255,255,0.03);
    padding: 4px;
    border-radius: 10px;
    border: 1px solid rgba(167,139,250,0.15);
}
.streaming-tab-btn {
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.6);
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.streaming-tab-btn:hover {
    color: #fff;
    background: rgba(255,255,255,0.05);
}
