<%#
  Community support: counts raids and support posts in two channels, awards points, and each month
  posts the top supporters and announces their streams in the shoutout channel for the next month
  (events/communitySupportTracker.js, jobs/community-support-rotation.js). Saved with
  PUT /api/guilds/:id/community-support/config. Field names and ids are unchanged.
%>
<%
const csConfig = typeof communitySupportConfig !== 'undefined' && communitySupportConfig ? communitySupportConfig : {};
const csEnabled = !!csConfig.enabled;
const csText = (channels || []).filter(c => c.type === 0 || c.type === 5 || c.type === undefined);
const csOpts = (selected) => csText.map(c => ({ id: c.id, name: c.name, sel: String(c.id) === String(selected || '') }));
%>
<style>
    #csPage .cf-section-foot > .cf-status-line { margin-right: auto; }
</style>

<div class="page-section" id="csPage">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-hands-helping" aria-hidden="true"></i>
                <span>Community support</span>
            </div>
            <div class="page-section-subtitle">Points for raids and support posts, counted per calendar month.</div>
        </div>
        <a class="btn btn-secondary btn-sm" href="/supporters/<%= guild.id %>" target="_blank" rel="noopener">Public leaderboard</a>
    </div>

    <form id="cs-form" novalidate>
        <%# Not used by the bot; kept as stored so saving here never clears them. %>
        <input type="hidden" id="f-community-support-affiliate_link_channel_id" name="affiliate_link_channel_id" value="<%= csConfig.affiliate_link_channel_id || '' %>">
        <input type="hidden" id="f-community-support-non_affiliate_link_channel_id" name="non_affiliate_link_channel_id" value="<%= csConfig.non_affiliate_link_channel_id || '' %>">
        <section class="cf-section" aria-labelledby="cs-general-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cs-general-title">Channels</h2>
                    <p class="cf-section-desc">Members earn points by mentioning the streamer they raided or supported, or posting their twitch.tv link.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cs-enabled">Community support</label>
                        <p class="cf-row-desc" id="cs-enabled-desc">Count points in the channels below and run the monthly shoutout.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="enabled" id="cs-enabled" aria-describedby="cs-enabled-desc" data-feature-switch <%= csEnabled ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-community-support-raid_channel_id">Raid channel</label>
                        <p class="cf-row-desc">Each post here counts as a raid.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-community-support-raid_channel_id" name="raid_channel_id" class="form-select">
                            <option value="">None</option>
                            <% csOpts(csConfig.raid_channel_id).forEach(o => { %><option value="<%= o.id %>" data-kind="text"<%= o.sel ? ' selected' : '' %>>#<%= o.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-community-support-support_channel_id">Support channel</label>
                        <p class="cf-row-desc">Each post here counts as support; a post that says "raided" counts as a raid.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-community-support-support_channel_id" name="support_channel_id" class="form-select">
                            <option value="">None</option>
                            <% csOpts(csConfig.support_channel_id).forEach(o => { %><option value="<%= o.id %>" data-kind="text"<%= o.sel ? ' selected' : '' %>>#<%= o.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-community-support-shoutout_channel_id">Shoutout channel</label>
                        <p class="cf-row-desc">Early on the 1st of each month (UTC) the top 10 supporters are posted here, and their streams are announced here for that month. /alerts shoutout add uses it too.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-community-support-shoutout_channel_id" name="shoutout_channel_id" class="form-select">
                            <option value="">None</option>
                            <% csOpts(csConfig.shoutout_channel_id).forEach(o => { %><option value="<%= o.id %>" data-kind="text"<%= o.sel ? ' selected' : '' %>>#<%= o.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="cs-points-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cs-points-title">Points</h2>
                    <p class="cf-section-desc">What each post is worth, from 1 to 100. Affiliate status is checked on Twitch.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-community-support-raid_affiliate_points">Raiding an affiliate</label>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input id="f-community-support-raid_affiliate_points" type="number" name="raid_affiliate_points" class="form-control" value="<%= csConfig.raid_affiliate_points || 5 %>" min="1" max="100">
                            <span class="cf-unit">points</span>
                        </div>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-community-support-raid_non_affiliate_points">Raiding a non-affiliate</label>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input id="f-community-support-raid_non_affiliate_points" type="number" name="raid_non_affiliate_points" class="form-control" value="<%= csConfig.raid_non_affiliate_points || 10 %>" min="1" max="100">
                            <span class="cf-unit">points</span>
                        </div>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-community-support-support_points">Support post</label>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input id="f-community-support-support_points" type="number" name="support_points" class="form-control" value="<%= csConfig.support_points || 3 %>" min="1" max="100">
                            <span class="cf-unit">points</span>
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-status-line" id="cs-status" role="status" aria-live="polite"></span>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>
</div>

<script>
(function () {
    const form = document.getElementById('cs-form');
    if (!form) return;
    const status = document.getElementById('cs-status');
    const say = (text, cls) => { status.textContent = text; status.className = 'cf-status-line' + (cls ? ' ' + cls : ''); };
    const pts = (name, dflt) => Math.min(100, Math.max(1, parseInt(form[name].value, 10) || dflt));
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = {
            enabled: document.getElementById('cs-enabled').checked,
            raid_channel_id: form.raid_channel_id.value || null,
            support_channel_id: form.support_channel_id.value || null,
            shoutout_channel_id: form.shoutout_channel_id.value || null,
            raid_affiliate_points: pts('raid_affiliate_points', 5),
            raid_non_affiliate_points: pts('raid_non_affiliate_points', 10),
            support_points: pts('support_points', 3),
        };
        if (body.enabled && !body.raid_channel_id && !body.support_channel_id) return say('Choose a raid or support channel, or nothing is counted.', 'is-bad');
        say('Saving', 'is-busy');
        try {
            const res = await fetch('/api/guilds/<%= guild.id %>/community-support/config', {
                method: 'PUT', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body),
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) throw new Error(data.error || 'Could not save.');
            say('Saved', 'is-ok');
            form.dispatchEvent(new CustomEvent('cf:clean', { bubbles: true }));
        } catch (err) {
            say(err.message, 'is-bad');
        }
    });
})();
</script>
