<%# Global Ban Database - Guild Management Partial %>

<style>
.gb-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 16px;
}

.gb-header {
    background: rgba(248, 113, 113, 0.08);
    padding: 14px 18px;
    border-bottom: 1px solid rgba(248, 113, 113, 0.15);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.gb-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gb-header-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(248, 113, 113, 0.15);
    border-radius: 8px;
}

.gb-header-icon i { font-size: 1rem; color: #f87171; }
.gb-header-icon.purple { background: rgba(167, 139, 250, 0.15); }
.gb-header-icon.purple i { color: #a78bfa; }

.gb-header h3 { font-size: 0.95rem; font-weight: 600; color: #ffffff; margin: 0; }
.gb-header p { font-size: 0.75rem; color: rgba(255, 255, 255, 0.5); margin: 2px 0 0 0; }

.gb-body { padding: 18px; }

/* Stat cards */
.gb-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
}

@media (max-width: 768px) {
    .gb-stats { grid-template-columns: repeat(2, 1fr); }
}

.gb-stat {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.gb-stat-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    flex-shrink: 0;
}

.gb-stat-icon.green { background: rgba(35, 245, 107, 0.1); }
.gb-stat-icon.green i { color: #23f56b; }
.gb-stat-icon.red { background: rgba(248, 113, 113, 0.1); }
.gb-stat-icon.red i { color: #f87171; }
.gb-stat-icon.yellow { background: rgba(251, 191, 36, 0.1); }
.gb-stat-icon.yellow i { color: #fbbf24; }
.gb-stat-icon.purple { background: rgba(167, 139, 250, 0.1); }
.gb-stat-icon.purple i { color: #a78bfa; }

.gb-stat-icon i { font-size: 1rem; }

.gb-stat-label { font-size: 0.7rem; color: rgba(255, 255, 255, 0.5); }
.gb-stat-value { font-size: 1.1rem; font-weight: 700; color: #ffffff; }

/* Form grid */
.gb-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
}

.gb-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

@media (max-width: 768px) {
    .gb-grid-4 { grid-template-columns: repeat(2, 1fr); }
    .gb-grid-3 { grid-template-columns: 1fr; }
}

.gb-form-group { margin-bottom: 14px; }

.gb-form-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 6px;
}

.gb-form-select,
.gb-form-input {
    width: 100%;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.85rem;
    transition: all 0.2s;
}

.gb-form-select:focus,
.gb-form-input:focus {
    outline: none;
    border-color: rgba(167, 139, 250, 0.5);
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.1);
}

.gb-form-select option { background: #1a1d21; color: #ffffff; }

.gb-form-hint {
    display: block;
    margin-top: 4px;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
}

.gb-toggle-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
}

.gb-toggle-label { font-size: 0.8rem; color: rgba(255, 255, 255, 0.7); }
.gb-toggle-hint { font-size: 0.7rem; color: rgba(255, 255, 255, 0.4); }

.gb-actions {
    display: flex;
    justify-content: flex-end;
    padding-top: 12px;
}

.gb-save-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: linear-gradient(135deg, #a78bfa, #7c3aed);
    color: white;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
}

.gb-save-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(167, 139, 250, 0.3);
}

.gb-save-btn i { font-size: 0.85rem; }

/* Tables */
.gb-table {
    width: 100%;
    border-collapse: collapse;
}

.gb-table thead th {
    padding: 10px 14px;
    font-size: 0.7rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    text-align: left;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.gb-table tbody td {
    padding: 10px 14px;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.gb-table tbody tr:hover { background: rgba(255, 255, 255, 0.03); }

.gb-table .mono { font-family: 'JetBrains Mono', monospace; color: #ffffff; }
.gb-table .truncate { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.gb-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
}

.gb-badge.critical { background: rgba(248, 113, 113, 0.2); color: #f87171; }
.gb-badge.high { background: rgba(251, 146, 60, 0.2); color: #fb923c; }
.gb-badge.medium { background: rgba(251, 191, 36, 0.2); color: #fbbf24; }
.gb-badge.low { background: rgba(96, 165, 250, 0.2); color: #60a5fa; }
.gb-badge.action { background: rgba(167, 139, 250, 0.2); color: #a78bfa; }

.gb-search-row {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gb-search-row input,
.gb-search-row select {
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #ffffff;
    font-size: 0.8rem;
}

.gb-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
}

.gb-pagination span { font-size: 0.8rem; color: rgba(255, 255, 255, 0.5); }

.gb-pagination-btns {
    display: flex;
    gap: 8px;
}

.gb-pagination-btns button {
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
}

.gb-pagination-btns button:hover:not(:disabled) { background: rgba(255, 255, 255, 0.1); }
.gb-pagination-btns button:disabled { opacity: 0.4; cursor: not-allowed; }
</style>

<!-- Stats Overview -->
<div class="gb-stats">
    <div class="gb-stat">
        <div class="gb-stat-icon green"><i class="fas fa-globe"></i></div>
        <div>
            <div class="gb-stat-label">Protection</div>
            <div class="gb-stat-value"><%= (locals.globalBanConfig && locals.globalBanConfig.enabled) ? 'Active' : 'Disabled' %></div>
        </div>
    </div>
    <div class="gb-stat">
        <div class="gb-stat-icon red"><i class="fas fa-ban"></i></div>
        <div>
            <div class="gb-stat-label">Active Bans</div>
            <div class="gb-stat-value"><%= locals.globalBanStats ? locals.globalBanStats.activeEntries : 0 %></div>
        </div>
    </div>
    <div class="gb-stat">
        <div class="gb-stat-icon yellow"><i class="fas fa-clipboard-list"></i></div>
        <div>
            <div class="gb-stat-label">Pending Reports</div>
            <div class="gb-stat-value"><%= locals.globalBanStats ? locals.globalBanStats.pendingReports : 0 %></div>
        </div>
    </div>
    <div class="gb-stat">
        <div class="gb-stat-icon purple"><i class="fas fa-shield-alt"></i></div>
        <div>
            <div class="gb-stat-label">Guilds Protected</div>
            <div class="gb-stat-value"><%= locals.globalBanStats ? locals.globalBanStats.enabledGuilds : 0 %></div>
        </div>
    </div>
</div>

<!-- Guild Configuration -->
<div class="gb-card">
    <div class="gb-header">
        <div class="gb-header-left">
            <div class="gb-header-icon purple"><i class="fas fa-cog"></i></div>
            <div>
                <h3>Global Ban Protection</h3>
                <p>Configure how this server enforces global bans</p>
            </div>
        </div>
        <div class="toggle-switch">
            <input type="checkbox" id="globalban_enabled" name="globalban_enabled" <%= (locals.globalBanConfig && locals.globalBanConfig.enabled) ? 'checked' : '' %>>
            <label class="toggle-slider" for="globalban_enabled"></label>
        </div>
    </div>

    <div class="gb-body">
        <form id="globalban-config-form">
            <div class="gb-grid-4">
                <div class="gb-form-group">
                    <label class="gb-form-label">Critical Action</label>
                    <select name="action_critical" class="gb-form-select">
                        <option value="ban" <%= (locals.globalBanConfig && locals.globalBanConfig.action_critical === 'ban') ? 'selected' : (!locals.globalBanConfig ? 'selected' : '') %>>Ban</option>
                        <option value="kick" <%= (locals.globalBanConfig && locals.globalBanConfig.action_critical === 'kick') ? 'selected' : '' %>>Kick</option>
                        <option value="alert" <%= (locals.globalBanConfig && locals.globalBanConfig.action_critical === 'alert') ? 'selected' : '' %>>Alert Only</option>
                        <option value="none" <%= (locals.globalBanConfig && locals.globalBanConfig.action_critical === 'none') ? 'selected' : '' %>>None</option>
                    </select>
                    <span class="gb-form-hint">Phishing, verified scams</span>
                </div>
                <div class="gb-form-group">
                    <label class="gb-form-label">High Action</label>
                    <select name="action_high" class="gb-form-select">
                        <option value="ban" <%= (locals.globalBanConfig && locals.globalBanConfig.action_high === 'ban') ? 'selected' : (!locals.globalBanConfig ? 'selected' : '') %>>Ban</option>
                        <option value="kick" <%= (locals.globalBanConfig && locals.globalBanConfig.action_high === 'kick') ? 'selected' : '' %>>Kick</option>
                        <option value="alert" <%= (locals.globalBanConfig && locals.globalBanConfig.action_high === 'alert') ? 'selected' : '' %>>Alert Only</option>
                        <option value="none" <%= (locals.globalBanConfig && locals.globalBanConfig.action_high === 'none') ? 'selected' : '' %>>None</option>
                    </select>
                    <span class="gb-form-hint">Raid organizers, repeat offenders</span>
                </div>
                <div class="gb-form-group">
                    <label class="gb-form-label">Medium Action</label>
                    <select name="action_medium" class="gb-form-select">
                        <option value="ban" <%= (locals.globalBanConfig && locals.globalBanConfig.action_medium === 'ban') ? 'selected' : '' %>>Ban</option>
                        <option value="kick" <%= (locals.globalBanConfig && locals.globalBanConfig.action_medium === 'kick') ? 'selected' : (!locals.globalBanConfig ? 'selected' : '') %>>Kick</option>
                        <option value="alert" <%= (locals.globalBanConfig && locals.globalBanConfig.action_medium === 'alert') ? 'selected' : '' %>>Alert Only</option>
                        <option value="none" <%= (locals.globalBanConfig && locals.globalBanConfig.action_medium === 'none') ? 'selected' : '' %>>None</option>
                    </select>
                    <span class="gb-form-hint">Spam accounts, nuisance</span>
                </div>
                <div class="gb-form-group">
                    <label class="gb-form-label">Low Action</label>
                    <select name="action_low" class="gb-form-select">
                        <option value="ban" <%= (locals.globalBanConfig && locals.globalBanConfig.action_low === 'ban') ? 'selected' : '' %>>Ban</option>
                        <option value="kick" <%= (locals.globalBanConfig && locals.globalBanConfig.action_low === 'kick') ? 'selected' : '' %>>Kick</option>
                        <option value="alert" <%= (locals.globalBanConfig && locals.globalBanConfig.action_low === 'alert') ? 'selected' : (!locals.globalBanConfig ? 'selected' : '') %>>Alert Only</option>
                        <option value="none" <%= (locals.globalBanConfig && locals.globalBanConfig.action_low === 'none') ? 'selected' : '' %>>None</option>
                    </select>
                    <span class="gb-form-hint">Single incident, unverified</span>
                </div>
            </div>

            <div class="gb-grid-3">
                <div class="gb-form-group">
                    <label class="gb-form-label">Alert Channel</label>
                    <select name="alert_channel_id" class="gb-form-select">
                        <option value="">None</option>
                        <% if (locals.channels) { channels.forEach(ch => { %>
                            <option value="<%= ch.id %>" <%= (locals.globalBanConfig && locals.globalBanConfig.alert_channel_id === ch.id) ? 'selected' : '' %>>#<%= ch.name %></option>
                        <% }); } %>
                    </select>
                    <span class="gb-form-hint">Channel for ban alert notifications</span>
                </div>
                <div class="gb-form-group">
                    <label class="gb-form-label">Options</label>
                    <div class="gb-toggle-row">
                        <div class="toggle-switch">
                            <input type="checkbox" id="check_on_message" name="check_on_message" <%= (locals.globalBanConfig && locals.globalBanConfig.check_on_message) ? 'checked' : '' %>>
                            <label class="toggle-slider" for="check_on_message"></label>
                        </div>
                        <div>
                            <span class="gb-toggle-label">Check on Message</span><br>
                            <span class="gb-toggle-hint">Also check when users send messages</span>
                        </div>
                    </div>
                </div>
                <div class="gb-form-group">
                    <label class="gb-form-label">&nbsp;</label>
                    <div class="gb-toggle-row">
                        <div class="toggle-switch">
                            <input type="checkbox" id="auto_aggregate" name="auto_aggregate" <%= (locals.globalBanConfig ? locals.globalBanConfig.auto_aggregate_opt_in : true) ? 'checked' : '' %>>
                            <label class="toggle-slider" for="auto_aggregate"></label>
                        </div>
                        <div>
                            <span class="gb-toggle-label">Auto-Aggregate</span><br>
                            <span class="gb-toggle-hint">Contribute bans to the shared database</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="gb-actions">
                <button type="submit" class="gb-save-btn"><i class="fas fa-save"></i> Save Settings</button>
            </div>
        </form>
    </div>
</div>

<!-- Ban List -->
<div class="gb-card">
    <div class="gb-header">
        <div class="gb-header-left">
            <div class="gb-header-icon"><i class="fas fa-ban"></i></div>
            <div>
                <h3>Global Ban List</h3>
                <p>Users flagged across the CertiFried network</p>
            </div>
        </div>
        <div class="gb-search-row">
            <input type="text" id="globalban-search" placeholder="Search User ID...">
            <select id="globalban-severity-filter">
                <option value="">All</option>
                <option value="critical">Critical</option>
                <option value="high">High</option>
                <option value="medium">Medium</option>
                <option value="low">Low</option>
            </select>
        </div>
    </div>

    <div class="gb-body" style="overflow-x: auto;">
        <table class="gb-table">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Severity</th>
                    <th>Category</th>
                    <th>Source</th>
                    <th>Reason</th>
                    <th>Evidence</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="globalban-entries-body">
                <tr><td colspan="7" style="text-align: center; padding: 24px; color: rgba(255,255,255,0.4);">Loading...</td></tr>
            </tbody>
        </table>

        <div class="gb-pagination">
            <span id="globalban-page-info"></span>
            <div class="gb-pagination-btns">
                <button id="globalban-prev" disabled>Previous</button>
                <button id="globalban-next" disabled>Next</button>
            </div>
        </div>
    </div>
</div>

<!-- Action Log -->
<div class="gb-card">
    <div class="gb-header">
        <div class="gb-header-left">
            <div class="gb-header-icon purple"><i class="fas fa-clipboard-list"></i></div>
            <div>
                <h3>Action Log</h3>
                <p>Global ban actions taken in this server</p>
            </div>
        </div>
    </div>

    <div class="gb-body" style="overflow-x: auto;">
        <table class="gb-table">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>User</th>
                    <th>Details</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="globalban-log-body">
                <tr><td colspan="4" style="text-align: center; padding: 24px; color: rgba(255,255,255,0.4);">Loading...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
(function() {
    const guildId = '<%= guild.id %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    let currentPage = 1;
    const pageSize = 15;

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    async function loadEntries(page = 1) {
        const search = document.getElementById('globalban-search').value.trim();
        const severity = document.getElementById('globalban-severity-filter').value;
        let url = '/api/guilds/' + guildId + '/global-ban/entries?page=' + page + '&limit=' + pageSize;
        if (search) url += '&search=' + encodeURIComponent(search);
        if (severity) url += '&severity=' + severity;

        try {
            const res = await fetch(url);
            const data = await res.json();
            if (!data.success) throw new Error(data.error);

            const tbody = document.getElementById('globalban-entries-body');
            while (tbody.firstChild) tbody.removeChild(tbody.firstChild);

            if (data.entries.length === 0) {
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 7;
                td.style.textAlign = 'center';
                td.style.padding = '24px';
                td.style.color = 'rgba(255,255,255,0.4)';
                td.textContent = 'No entries found';
                tr.appendChild(td);
                tbody.appendChild(tr);
            } else {
                data.entries.forEach(function(e) {
                    const tr = document.createElement('tr');

                    const tdId = document.createElement('td');
                    tdId.className = 'mono';
                    tdId.textContent = e.user_id;
                    tr.appendChild(tdId);

                    const tdSev = document.createElement('td');
                    const badge = document.createElement('span');
                    badge.className = 'gb-badge ' + e.severity;
                    badge.textContent = e.severity.toUpperCase();
                    tdSev.appendChild(badge);
                    tr.appendChild(tdSev);

                    const tdCat = document.createElement('td');
                    tdCat.textContent = e.category;
                    tr.appendChild(tdCat);

                    const tdSrc = document.createElement('td');
                    tdSrc.textContent = e.source.replace('_', ' ');
                    tr.appendChild(tdSrc);

                    const tdReason = document.createElement('td');
                    tdReason.className = 'truncate';
                    tdReason.textContent = e.reason || '-';
                    tr.appendChild(tdReason);

                    var tdEvidence = document.createElement('td');
                    if (e.evidence) {
                        try {
                            var urls = typeof e.evidence === 'string' ? JSON.parse(e.evidence) : e.evidence;
                            if (Array.isArray(urls) && urls.length > 0) {
                                urls.forEach(function(url, i) {
                                    if (i > 0) tdEvidence.appendChild(document.createTextNode(' '));
                                    var a = document.createElement('a');
                                    a.href = url;
                                    a.target = '_blank';
                                    a.style.cssText = 'color:#60a5fa;font-size:0.75rem;text-decoration:none;';
                                    if (url.match(/\.(png|jpg|jpeg|gif|webp)/i)) {
                                        a.textContent = '[img ' + (i + 1) + ']';
                                    } else if (url.includes('discord.com/channels/')) {
                                        a.textContent = '[msg ' + (i + 1) + ']';
                                    } else {
                                        a.textContent = '[link ' + (i + 1) + ']';
                                    }
                                    tdEvidence.appendChild(a);
                                });
                            } else {
                                tdEvidence.textContent = '-';
                                tdEvidence.style.color = 'rgba(255,255,255,0.3)';
                            }
                        } catch { tdEvidence.textContent = '-'; tdEvidence.style.color = 'rgba(255,255,255,0.3)'; }
                    } else {
                        tdEvidence.textContent = '-';
                        tdEvidence.style.color = 'rgba(255,255,255,0.3)';
                    }
                    tr.appendChild(tdEvidence);

                    const tdDate = document.createElement('td');
                    tdDate.textContent = new Date(e.created_at).toLocaleDateString();
                    tr.appendChild(tdDate);

                    tbody.appendChild(tr);
                });
            }

            currentPage = data.pagination.page;
            document.getElementById('globalban-page-info').textContent = 'Page ' + data.pagination.page + ' of ' + (data.pagination.pages || 1) + ' (' + data.pagination.total + ' entries)';
            document.getElementById('globalban-prev').disabled = data.pagination.page <= 1;
            document.getElementById('globalban-next').disabled = data.pagination.page >= data.pagination.pages;
        } catch (err) {
            console.error('Failed to load entries:', err);
        }
    }

    async function loadActionLog() {
        try {
            const res = await fetch('/api/guilds/' + guildId + '/global-ban/action-log?limit=15');
            const data = await res.json();
            if (!data.success) return;

            const tbody = document.getElementById('globalban-log-body');
            while (tbody.firstChild) tbody.removeChild(tbody.firstChild);

            if (data.logs.length === 0) {
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = 4;
                td.style.textAlign = 'center';
                td.style.padding = '24px';
                td.style.color = 'rgba(255,255,255,0.4)';
                td.textContent = 'No actions recorded yet';
                tr.appendChild(td);
                tbody.appendChild(tr);
            } else {
                data.logs.forEach(function(l) {
                    const tr = document.createElement('tr');

                    const tdAction = document.createElement('td');
                    const badge = document.createElement('span');
                    badge.className = 'gb-badge action';
                    badge.textContent = l.action;
                    tdAction.appendChild(badge);
                    tr.appendChild(tdAction);

                    const tdUser = document.createElement('td');
                    tdUser.className = 'mono';
                    tdUser.textContent = l.user_id;
                    tr.appendChild(tdUser);

                    const tdDetails = document.createElement('td');
                    tdDetails.className = 'truncate';
                    tdDetails.textContent = l.details || '-';
                    tr.appendChild(tdDetails);

                    const tdDate = document.createElement('td');
                    tdDate.textContent = new Date(l.created_at).toLocaleString();
                    tr.appendChild(tdDate);

                    tbody.appendChild(tr);
                });
            }
        } catch (err) {
            console.error('Failed to load action log:', err);
        }
    }

    document.getElementById('globalban-config-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        var form = e.target;
        var body = {
            enabled: document.getElementById('globalban_enabled').checked,
            action_critical: form.querySelector('[name="action_critical"]').value,
            action_high: form.querySelector('[name="action_high"]').value,
            action_medium: form.querySelector('[name="action_medium"]').value,
            action_low: form.querySelector('[name="action_low"]').value,
            alert_channel_id: form.querySelector('[name="alert_channel_id"]').value || null,
            check_on_join: true,
            check_on_message: document.getElementById('check_on_message').checked,
            auto_aggregate_opt_in: document.getElementById('auto_aggregate').checked,
            exempt_roles: []
        };

        try {
            var res = await fetch('/api/guilds/' + guildId + '/global-ban/config', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
                body: JSON.stringify(body)
            });
            var data = await res.json();
            if (data.success) {
                showToast('Global ban settings saved', 'success');
            } else {
                showToast(data.error || 'Failed to save', 'error');
            }
        } catch (err) {
            showToast('Failed to save settings', 'error');
        }
    });

    document.getElementById('globalban-search').addEventListener('input', debounce(function() { loadEntries(1); }, 500));
    document.getElementById('globalban-severity-filter').addEventListener('change', function() { loadEntries(1); });
    document.getElementById('globalban-prev').addEventListener('click', function() { loadEntries(currentPage - 1); });
    document.getElementById('globalban-next').addEventListener('click', function() { loadEntries(currentPage + 1); });

    function debounce(fn, ms) {
        var t;
        return function() {
            var args = arguments;
            clearTimeout(t);
            t = setTimeout(function() { fn.apply(null, args); }, ms);
        };
    }

    function showToast(msg, type) {
        if (window.showToast) return window.showToast(msg, type);
        alert(msg);
    }

    loadEntries(1);
    loadActionLog();
})();
</script>
