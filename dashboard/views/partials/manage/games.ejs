<%#
  Trivia and hangman: this server's own trivia questions and hangman words (POST games/trivia|hangman/
  add|delete, from the two modals below), a preview of each game in Discord, and the commands.
  Counting channels live on the Counting page only. Built on the settings-row kit (cf-settings.css);
  field names and ids are unchanged.
%>
<%
const gmDiffTone = { easy: 'is-ok', medium: 'is-warn', hard: 'is-bad' };
const gmCap = (s) => { const t = String(s == null ? '' : s); return t.charAt(0).toUpperCase() + t.slice(1); };
const gmTrivia = triviaQuestions || [];
const gmWords = hangmanWords || [];
// Preview: the newest question this server wrote, else a sample. Answers are shuffled in Discord.
const gmQ = gmTrivia[0] || null;
let gmWrong = ['London', 'Berlin', 'Madrid'];
if (gmQ && gmQ.incorrect_answers) {
    try { const w = JSON.parse(gmQ.incorrect_answers); if (Array.isArray(w) && w.length) gmWrong = w.slice(0, 3).map(String); }
    catch (e) { gmWrong = String(gmQ.incorrect_answers).split(',').map(s => s.trim()).filter(Boolean).slice(0, 3); }
}
const gmPreview = gmQ
    ? { question: gmQ.question, category: gmQ.category, difficulty: gmQ.difficulty, points: gmQ.points_value || 10, answers: [gmQ.correct_answer, ...gmWrong] }
    : { question: 'What is the capital of France?', category: 'geography', difficulty: 'easy', points: 10, answers: ['Paris', 'London', 'Berlin', 'Madrid'] };
const gmW = gmWords[0] ? String(gmWords[0].word || '').toUpperCase() : 'ELEPHANT';
const gmShown = gmW.split('').map((ch, i) => (i === 0 || i === gmW.length - 1 || ch === gmW[2]) ? ch : '_').join(' ');
%>
<%- include('_game-kit') %>
<style>
    .gm-word { font-weight: 600; color: var(--cf-text); letter-spacing: 0.05em; font-family: var(--cf-mono); }
    .gm-answer { font-weight: 500; color: var(--cf-text); }
    .gm-num { font-weight: 600; color: var(--cf-text); font-variant-numeric: tabular-nums; }
    .gm-clip { display: block; max-width: 28rem; overflow-wrap: anywhere; }
    .gm-upper { text-transform: uppercase; letter-spacing: 0.1em; }
    .gm-modal-preview { margin-top: var(--cf-4); }
</style>

<div class="page-section" id="gamesPage">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-gamepad"></i>
                <span>Trivia and hangman</span>
            </div>
            <div class="page-section-subtitle">Played with <code>/arcade trivia start</code> and <code>/arcade hangman start</code>.</div>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="Trivia and hangman at a glance">
        <div class="cf-kpi"><dt>Your trivia questions</dt><dd class="cf-kpi-value"><%= gmTrivia.length %></dd></div>
        <div class="cf-kpi"><dt>Your hangman words</dt><dd class="cf-kpi-value"><%= gmWords.length %></dd></div>
        <div class="cf-kpi"><dt>Games played</dt><dd class="cf-kpi-value"><%= Number(gameStats?.total_games || 0).toLocaleString() %></dd></div>
        <div class="cf-kpi"><dt>Players</dt><dd class="cf-kpi-value"><%= Number(gameStats?.total_players || 0).toLocaleString() %></dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="gm-preview-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="gm-preview-title">In Discord</h2>
                <p class="cf-section-desc"><%= gmQ ? 'Trivia shows your newest question. ' : '' %>Members answer trivia with the buttons and guess hangman letters with <code>/arcade hangman guess</code>.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="gk-preview gk-preview-grid">
                <div class="cf-dc" aria-label="Preview: a trivia question">
                    <%- include('_gk-author', { gkUsed: '/arcade trivia start' }) %>
                    <div class="cf-dc-embed">
                        <div class="cf-dc-title">Trivia Question 1/5</div>
                        <div class="cf-dc-desc"><%= gmPreview.question %></div>
                        <div class="cf-dc-fields">
                            <div class="cf-dc-field"><div class="cf-dc-fname">Category</div><%= gmCap(gmPreview.category) %></div>
                            <div class="cf-dc-field"><div class="cf-dc-fname">Difficulty</div><%= gmCap(gmPreview.difficulty) %></div>
                            <div class="cf-dc-field"><div class="cf-dc-fname">Points</div><%= gmPreview.points %></div>
                        </div>
                        <div class="cf-dc-footer">Score: 0 | Correct: 0/0</div>
                    </div>
                    <div class="cf-dc-buttons">
                        <% gmPreview.answers.forEach((a, i) => { %><span class="cf-dc-btn is-primary"><%= String.fromCharCode(65 + i) %>. <%= String(a).length > 50 ? String(a).slice(0, 50) + '...' : a %></span><% }) %>
                    </div>
                </div>
                <div class="cf-dc" aria-label="Preview: a hangman game">
                    <%- include('_gk-author', { gkUsed: '/arcade hangman start' }) %>
                    <div class="cf-dc-embed">
                        <div class="cf-dc-title">Hangman</div>
<pre>  +---+
  |   |
  O   |
      |
      |
=========</pre>
                        <div class="cf-dc-desc"><strong><%= gmShown %></strong></div>
                        <div class="cf-dc-fields">
                            <div class="cf-dc-field is-wide"><div class="cf-dc-fname">Wrong letters</div>S</div>
                        </div>
                        <div class="cf-dc-footer">Use /arcade hangman guess &lt;letter&gt; to guess | /arcade hangman give-up to reveal</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="gm-trivia-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="gm-trivia-title">Trivia questions <span class="gk-cmd-count"><%= gmTrivia.length %></span></h2>
                <p class="cf-section-desc">Asked alongside the built-in questions in this server.</p>
            </div>
            <div class="cf-section-actions">
                <% if (gmTrivia.length > 15) { %>
                <label class="cf-search"><i class="fas fa-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="Search questions" aria-label="Search trivia questions" data-gm-search="gm-trivia-body" data-no-savebar autocomplete="off"></label>
                <% } %>
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#addTriviaModal">Add question</button>
            </div>
        </header>
        <div class="cf-rows">
        <% if (gmTrivia.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Question</th>
                            <th scope="col">Answer</th>
                            <th scope="col">Category</th>
                            <th scope="col">Difficulty</th>
                            <th scope="col">Points</th>
                            <th scope="col"><span class="visually-hidden">Delete</span></th>
                        </tr>
                    </thead>
                    <tbody id="gm-trivia-body">
                        <% gmTrivia.forEach(q => { %>
                            <tr data-gm-text="<%= (String(q.question) + ' ' + q.correct_answer + ' ' + q.category).toLowerCase() %>">
                                <td data-label="Question"><span class="gm-clip"><%= q.question %></span></td>
                                <td data-label="Answer"><span class="gm-answer"><%= q.correct_answer %></span></td>
                                <td data-label="Category"><span class="cf-pill"><%= gmCap(q.category) %></span></td>
                                <td data-label="Difficulty"><span class="cf-pill <%= gmDiffTone[q.difficulty] || '' %>"><%= gmCap(q.difficulty) %></span></td>
                                <td data-label="Points"><span class="gm-num"><%= q.points_value ?? 10 %></span></td>
                                <td class="cf-cell-end">
                                    <form action="/manage/<%= guild.id %>/games/trivia/delete" method="POST">
                                        <input type="hidden" name="question_id" value="<%= q.question_id %>">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this question?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <div class="cf-state cf-state--compact" data-gm-none="gm-trivia-body" hidden><p class="cf-state-text">No questions match.</p></div>
        <% } else { %>
            <div class="cf-state cf-state--empty">
                <p class="cf-state-title">No questions of your own yet</p>
                <p class="cf-state-text">Trivia uses the built-in questions until you add some.</p>
                <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#addTriviaModal">Add question</button>
            </div>
        <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="gm-hangman-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="gm-hangman-title">Hangman words <span class="gk-cmd-count"><%= gmWords.length %></span></h2>
                <p class="cf-section-desc">Words hangman can pick in this server. The hint is shown when the word is revealed.</p>
            </div>
            <div class="cf-section-actions">
                <% if (gmWords.length > 15) { %>
                <label class="cf-search"><i class="fas fa-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="Search words" aria-label="Search hangman words" data-gm-search="gm-hangman-body" data-no-savebar autocomplete="off"></label>
                <% } %>
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#addHangmanModal">Add word</button>
            </div>
        </header>
        <div class="cf-rows">
        <% if (gmWords.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Word</th>
                            <th scope="col">Difficulty</th>
                            <th scope="col">Category</th>
                            <th scope="col">Hint</th>
                            <th scope="col"><span class="visually-hidden">Delete</span></th>
                        </tr>
                    </thead>
                    <tbody id="gm-hangman-body">
                        <% gmWords.forEach(w => { %>
                            <tr data-gm-text="<%= (String(w.word) + ' ' + w.category + ' ' + (w.hint || '')).toLowerCase() %>">
                                <td data-label="Word"><span class="gm-word"><%= w.word %></span></td>
                                <td data-label="Difficulty"><span class="cf-pill <%= gmDiffTone[w.difficulty] || '' %>"><%= gmCap(w.difficulty) %></span></td>
                                <td data-label="Category"><span class="cf-pill"><%= gmCap(w.category) %></span></td>
                                <td data-label="Hint"><span class="gm-clip cf-cell-muted"><%= w.hint || 'None' %></span></td>
                                <td class="cf-cell-end">
                                    <form action="/manage/<%= guild.id %>/games/hangman/delete" method="POST">
                                        <input type="hidden" name="word_id" value="<%= w.word_id %>">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this word?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <div class="cf-state cf-state--compact" data-gm-none="gm-hangman-body" hidden><p class="cf-state-text">No words match.</p></div>
        <% } else { %>
            <div class="cf-state cf-state--empty">
                <p class="cf-state-title">No words of your own yet</p>
                <p class="cf-state-text">Hangman uses the built-in word list until you add some.</p>
                <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#addHangmanModal">Add word</button>
            </div>
        <% } %>
        </div>
    </section>

    <%- include('_game-commands', { gkCommands: [{ cmd: 'arcade', groups: ['trivia', 'hangman'] }] }) %>
</div>

<!-- Add trivia question -->
<div class="modal fade" id="addTriviaModal" tabindex="-1" aria-labelledby="gm-trivia-modal-title">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="gm-trivia-modal-title">Add a trivia question</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/manage/<%= guild.id %>/games/trivia/add" method="POST" id="gm-trivia-form">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="f-games-question">Question</label>
                        <textarea id="f-games-question" class="form-control" name="question" rows="2" required maxlength="4000" placeholder="What is the capital of France?"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="f-games-category">Category</label>
                            <%# The categories /arcade trivia start offers (commands/games/arcade.js); a question in any other category could only come up under Random. %>
                            <select id="f-games-category" class="form-select" name="category" required>
                                <% [['general', 'General knowledge'], ['science', 'Science and nature'], ['history', 'History'], ['geography', 'Geography'], ['entertainment', 'Entertainment'], ['sports', 'Sports'], ['technology', 'Technology'], ['music', 'Music'], ['art', 'Art and literature'], ['gaming', 'Video games']].forEach(([v, l]) => { %><option value="<%= v %>"><%= l %></option><% }) %>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="f-games-difficulty">Difficulty</label>
                            <select id="f-games-difficulty" class="form-select" name="difficulty" required>
                                <option value="easy">Easy</option>
                                <option value="medium" selected>Medium</option>
                                <option value="hard">Hard</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-games-correct_answer">Correct answer</label>
                        <input id="f-games-correct_answer" type="text" class="form-control" name="correct_answer" required maxlength="255" placeholder="Paris">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="f-games-incorrect_answers">Wrong answers</label>
                        <input id="f-games-incorrect_answers" type="text" class="form-control" name="incorrect_answers" placeholder="London, Berlin, Madrid" required>
                        <div class="form-text">Exactly three, separated by commas. Buttons show the first 50 characters of each answer.</div>
                    </div>
                    <div>
                        <label class="form-label" for="f-games-points_value">Points</label>
                        <input id="f-games-points_value" type="number" class="form-control" name="points_value" value="10" min="1" max="1000">
                        <div class="form-text">Awarded for a correct answer.</div>
                    </div>
                    <div class="gm-modal-preview">
                        <p class="gk-preview-label">Preview</p>
                        <div class="cf-dc" aria-label="Preview of the question in Discord">
                            <%- include('_gk-author', { gkUsed: '/arcade trivia start' }) %>
                            <div class="cf-dc-embed">
                                <div class="cf-dc-title">Trivia Question 1/5</div>
                                <div class="cf-dc-desc" id="gm-pv-q"></div>
                                <div class="cf-dc-fields">
                                    <div class="cf-dc-field"><div class="cf-dc-fname">Category</div><span id="gm-pv-cat"></span></div>
                                    <div class="cf-dc-field"><div class="cf-dc-fname">Difficulty</div><span id="gm-pv-diff"></span></div>
                                    <div class="cf-dc-field"><div class="cf-dc-fname">Points</div><span id="gm-pv-pts"></span></div>
                                </div>
                            </div>
                            <div class="cf-dc-buttons" id="gm-pv-buttons"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add question</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add hangman word -->
<div class="modal fade" id="addHangmanModal" tabindex="-1" aria-labelledby="gm-hangman-modal-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="gm-hangman-modal-title">Add a hangman word</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/manage/<%= guild.id %>/games/hangman/add" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="hangmanWordInput">Word</label>
                        <input type="text" class="form-control gm-upper" id="hangmanWordInput" name="word" required maxlength="40" pattern="[A-Za-z]+" placeholder="ELEPHANT">
                        <div class="form-text">Letters only; saved in capitals. /arcade hangman start describes easy as 4-5 letters, medium 6-8 and hard 9 or more.</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="f-games-difficulty-2">Difficulty</label>
                            <select id="f-games-difficulty-2" class="form-select" name="difficulty" required>
                                <option value="easy">Easy</option>
                                <option value="medium" selected>Medium</option>
                                <option value="hard">Hard</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="f-games-category-2">Category</label>
                            <%# The categories /arcade hangman start offers (commands/games/arcade.js). %>
                            <select id="f-games-category-2" class="form-select" name="category" required>
                                <% [['general', 'General'], ['animals', 'Animals'], ['food', 'Food'], ['nature', 'Nature'], ['music', 'Music'], ['sports', 'Sports'], ['technology', 'Technology']].forEach(([v, l]) => { %><option value="<%= v %>"><%= l %></option><% }) %>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="f-games-hint">Hint</label>
                        <input id="f-games-hint" type="text" class="form-control" name="hint" maxlength="1024" placeholder="A large mammal with a trunk">
                        <div class="form-text">Optional. Shown as the definition when the word is revealed.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add word</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    var hangmanInput = $('hangmanWordInput');
    if (hangmanInput) hangmanInput.addEventListener('input', function () { this.value = this.value.toUpperCase(); });

    // Search for long lists (rows carry their own lower-case text).
    document.querySelectorAll('[data-gm-search]').forEach(function (input) {
        var body = $(input.getAttribute('data-gm-search'));
        var none = document.querySelector('[data-gm-none="' + input.getAttribute('data-gm-search') + '"]');
        input.addEventListener('input', function () {
            var q = input.value.trim().toLowerCase(), shown = 0;
            body.querySelectorAll('tr').forEach(function (tr) {
                var hit = !q || (tr.getAttribute('data-gm-text') || '').indexOf(q) !== -1;
                tr.hidden = !hit;
                if (hit) shown++;
            });
            if (none) none.hidden = shown > 0;
        });
    });

    // Live preview in the Add question dialog.
    function cap(s) { s = String(s || ''); return s.charAt(0).toUpperCase() + s.slice(1); }
    function drawTrivia() {
        GK.fill($('gm-pv-q'), $('f-games-question').value || 'Your question appears here.');
        $('gm-pv-cat').textContent = cap($('f-games-category').value.trim() || 'general');
        $('gm-pv-diff').textContent = cap($('f-games-difficulty').value);
        $('gm-pv-pts').textContent = $('f-games-points_value').value || '10';
        var answers = [$('f-games-correct_answer').value.trim() || 'Correct answer']
            .concat($('f-games-incorrect_answers').value.split(',').map(function (s) { return s.trim(); }).filter(Boolean).slice(0, 3));
        while (answers.length < 4) answers.push('Wrong answer');
        var box = $('gm-pv-buttons');
        box.replaceChildren();
        answers.forEach(function (a, i) {
            box.appendChild(GK.el('span', 'cf-dc-btn is-primary', String.fromCharCode(65 + i) + '. ' + (a.length > 50 ? a.slice(0, 50) + '...' : a)));
        });
    }
    var form = $('gm-trivia-form');
    if (form) { form.addEventListener('input', drawTrivia); drawTrivia(); }
})();
</script>
