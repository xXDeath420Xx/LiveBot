<%#
  Auto-memes: posts an image meme from one of the chosen subreddits into one channel on an interval.
  Settings load from and save to /manage/:guildId/automeme (JSON); "Post one now" uses
  /manage/:guildId/automeme/test (dashboard/routes/features/content-management.js). Posts are made by
  core/auto-meme-manager.js. Ids and field names are unchanged.
%>
<%
const amText = (channels || []).filter(c => c.type === 0 || c.type === 5 || c.type === undefined);
%>
<style>
    .am-status { display: inline-flex; align-items: center; gap: 8px; }
    .am-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--cf-text-3); }
    .am-dot.active { background: var(--cf-success); }
    .am-suggest { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: var(--cf-2); }
    .am-suggest-label { font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-right: 2px; }
    #cfk-automeme-page .cf-section-foot > .cf-status-line { margin-right: auto; }
</style>

<div class="page-section" id="cfk-automeme-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-laugh-beam" aria-hidden="true"></i>
                <span>Auto-memes</span>
            </div>
            <div class="page-section-subtitle">Image posts only. Posts marked NSFW on Reddit are never used.</div>
        </div>
    </div>

    <dl class="cf-kpis" id="automeme-stats-container" aria-label="Auto-memes at a glance" hidden>
        <div class="cf-kpi"><dt>Status</dt><dd class="cf-kpi-value is-small"><span class="am-status"><span id="status-icon" class="am-dot" aria-hidden="true"></span><span id="status-value">Off</span></span></dd></div>
        <div class="cf-kpi"><dt>Posts every</dt><dd class="cf-kpi-value" id="interval-value">24h</dd></div>
        <div class="cf-kpi"><dt>Subreddits</dt><dd class="cf-kpi-value" id="subreddit-count">0</dd></div>
        <div class="cf-kpi"><dt>Last post</dt><dd class="cf-kpi-value is-small" id="cfk-am-last-post">Never</dd></div>
    </dl>

    <% if (!(process.env.REDDIT_CLIENT_ID && process.env.REDDIT_CLIENT_SECRET)) { %>
    <div class="cf-state" role="note"><p class="cf-state-text"><strong>Auto memes are paused.</strong> They come from Reddit. Reddit no longer lets bots read subreddits: since November 2025 its API needs approval Reddit is not granting to new apps, and it blocks requests from bot servers. Saved settings are kept and start working again if Reddit access is ever restored.</p></div>
    <% } %>
    <form id="automeme-config-form" onsubmit="saveAutoMemeConfig(event)" novalidate>
        <section class="cf-section" aria-labelledby="am-config-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="am-config-title">Settings</h2>
                    <p class="cf-section-desc">Each post picks one of the subreddits at random and uses a popular image post that has not been posted here recently.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="automeme-enabled">Auto-memes</label>
                        <p class="cf-row-desc" id="automeme-enabled-desc">Post a meme every interval while this is on.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="automeme-enabled" name="enabled" aria-describedby="automeme-enabled-desc" data-feature-switch>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="meme-channel">Channel</label>
                        <p class="cf-row-desc">Where the memes are posted.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="meme-channel" name="channel_id" class="form-select">
                            <option value="">Choose a channel</option>
                            <% amText.forEach(channel => { %><option value="<%= channel.id %>" data-kind="text">#<%= channel.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="post-interval">Post every</label>
                        <p class="cf-row-desc" id="post-interval-desc">From 1 to 168 hours (one week).</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input type="number" id="post-interval" name="post_interval_hours" class="form-control" min="1" max="168" value="24" aria-describedby="post-interval-desc">
                            <span class="cf-unit">hours</span>
                        </div>
                    </div>
                </div>
                <div class="cf-row cf-row--wide">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="subreddits">Subreddits</label>
                        <p class="cf-row-desc" id="subreddits-desc">Names without "r/", separated by commas. Up to 10.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="text" id="subreddits" name="subreddits" class="form-control" maxlength="230" placeholder="memes,dankmemes,wholesomememes" aria-describedby="subreddits-desc">
                        <div class="am-suggest">
                            <span class="am-suggest-label">Add:</span>
                            <% ['memes', 'dankmemes', 'wholesomememes', 'ProgrammerHumor'].forEach(s => { %><button type="button" class="btn btn-secondary btn-sm" onclick="addSubreddit('<%= s %>')">r/<%= s %></button>
                            <% }) %>
                        </div>
                    </div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Preview</span>
                        <p class="cf-row-desc">Each post looks like this, with the meme's own title, image and score.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-mp-frame"><div id="cfk-am-preview"></div></div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-status-line" id="cfk-am-status" role="status" aria-live="polite"></span>
                    <button type="button" class="btn btn-secondary" id="cfk-am-test">Post one now</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>
</div>

<script src="/js/cf-msgpreview.js" defer></script>
<script>
(function () {
    const base = '/manage/<%= guild.id %>/automeme';
    const BOT = <%- JSON.stringify({ name: (guild.members && guild.members.me && guild.members.me.displayName) || 'CertiFried', avatar: (guild.members && guild.members.me && guild.members.me.displayAvatarURL ? guild.members.me.displayAvatarURL({ size: 64 }) : null) }).replace(/</g, '\\u003c') %>;
    const $ = (id) => document.getElementById(id);
    const form = $('automeme-config-form');
    const subs = () => $('subreddits').value.split(',').map(s => s.trim().replace(/^r\//i, '')).filter(Boolean);
    function status(text, cls) { const n = $('cfk-am-status'); n.textContent = text; n.className = 'cf-status-line' + (cls ? ' ' + cls : ''); }

    // Preview: the embed core/auto-meme-manager.js posts (orange bar, title, image, score footer).
    function renderPreview() {
        if (!window.CFMsgPreview) return;
        const sub = subs()[0] || 'memes';
        CFMsgPreview.render($('cfk-am-preview'), {
            username: BOT.name, avatarUrl: BOT.avatar,
            embeds: [{ color: '#FF4500', title: 'The title of the Reddit post', url: 'https://reddit.com', image: { placeholder: 'Meme image' }, footer: { text: '👍 12345 upvotes • r/' + sub }, timestamp: true }],
        }, {});
    }
    $('subreddits').addEventListener('input', renderPreview);
    window.addEventListener('load', renderPreview);

    // Called from the markup (onclick / onsubmit).
    window.addSubreddit = function (name) {
        const current = subs();
        if (!current.some(s => s.toLowerCase() === name.toLowerCase())) {
            current.push(name);
            $('subreddits').value = current.join(',');
            $('subreddits').dispatchEvent(new Event('input', { bubbles: true }));
            form.dispatchEvent(new CustomEvent('cf:dirty', { bubbles: true }));
        }
    };

    function paintStats(c) {
        const box = $('automeme-stats-container');
        box.hidden = false;
        document.getElementById('status-value').textContent = c.enabled ? 'On' : 'Off';
        document.getElementById('status-icon').classList.toggle('active', !!c.enabled);
        $('interval-value').textContent = (c.post_interval_hours || 24) + 'h';
        $('subreddit-count').textContent = String((c.subreddits || '').split(',').filter(s => s.trim()).length);
        $('cfk-am-last-post').textContent = c.last_posted_at ? new Date(c.last_posted_at).toLocaleString() : 'Never';
    }

    async function load() {
        try {
            const res = await fetch(base, { credentials: 'same-origin' });
            const data = await res.json();
            const c = data.config || {};
            const sw = $('automeme-enabled');
            sw.checked = !!c.enabled;
            sw.dispatchEvent(new Event('change'));   // keep the header switch in step
            $('meme-channel').value = c.channel_id || '';
            $('post-interval').value = c.post_interval_hours || 24;
            $('subreddits').value = c.subreddits || 'memes,dankmemes';
            form.dispatchEvent(new CustomEvent('cf:clean', { bubbles: true }));
            paintStats(c);
            renderPreview();
        } catch (err) {
            status('Could not load the settings. Reload the page to try again.', 'is-bad');
        }
    }

    window.saveAutoMemeConfig = async function (event) {
        event.preventDefault();
        const config = {
            enabled: $('automeme-enabled').checked,
            channel_id: $('meme-channel').value,
            post_interval_hours: parseInt($('post-interval').value, 10),
            subreddits: $('subreddits').value.trim(),
        };
        if (config.enabled && !config.channel_id) return status('Choose a channel before switching auto-memes on.', 'is-bad');
        if (config.enabled && !subs().length) return status('Add at least one subreddit.', 'is-bad');
        status('Saving', 'is-busy');
        try {
            const res = await fetch(base, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(config) });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Could not save.');
            status('Saved', 'is-ok');
            load();
        } catch (err) {
            status(err.message, 'is-bad');
        }
    };

    $('cfk-am-test').addEventListener('click', async () => {
        const btn = $('cfk-am-test');
        btn.disabled = true;
        status('Posting', 'is-busy');
        try {
            const res = await fetch(base + '/test', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ channel_id: $('meme-channel').value, subreddits: $('subreddits').value }) });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Could not post.');
            status('Posted a meme from r/' + data.subreddit + '.', 'is-ok');
        } catch (err) {
            status(err.message, 'is-bad');
        } finally { btn.disabled = false; }
    });

    load();
})();
</script>
