<%#
  TikTok: tracked creators (POST tiktok/add-creator, edit, toggle-feed, remove), the video feed
  channel (POST tiktok/feed-settings) and recent videos. Live alerts themselves are run from the
  Streaming page. Each creator's edit panel and the add form show how a new-video post looks
  (jobs/tiktok-video-checker.js). Built on the settings-row kit (cf-settings.css); field names are
  unchanged. Every edit panel is written with the same field ids (the settings search indexes the
  template); the script below suffixes the ids of the second and later panels so ids stay unique.
%>
<%
const ttCanGive = (r) => { try { return r.editable !== false; } catch (e) { return true; } };
const ttRoles = (typeof roles !== 'undefined' ? roles : []).map(r => ({ id: r.id, name: r.name, color: r.hexColor && r.hexColor !== '#000000' ? r.hexColor : '', assignable: ttCanGive(r) }));
let ttBotName = 'Bot', ttBotAvatar = '';
try { ttBotName = guild.members.me.displayName || ttBotName; ttBotAvatar = guild.members.me.displayAvatarURL({ size: 64 }) || ''; } catch (e) { /* bot member not cached */ }
const ttVarsHint = 'Variables: {username}, {title}, {description}, {url}, {everyone}.';
%>
<style>
    .cf-rows .tt-creator { align-items: center; }
    .tt-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex: none; background: var(--cf-surface-2); }
    .tt-name { text-decoration: none; }
    .tt-name:hover { text-decoration: underline; }
    .tt-actions { flex-wrap: wrap; }
    .tt-actions form { display: inline; margin: 0; }
    .tiktok-edit-panel { padding: var(--cf-4) var(--cf-5); background: color-mix(in srgb, var(--cf-surface-2) 45%, var(--cf-surface)); border-top: 1px dashed var(--cf-border); }
    .tt-edit-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--cf-3) var(--cf-4); margin-top: var(--cf-4); }
    .tt-edit-foot .btn { margin-left: auto; }
    .tt-msg-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--cf-4); margin-top: var(--cf-3); }
    .tt-video { display: flex; gap: var(--cf-3); align-items: center; text-decoration: none; color: inherit; }
    .tt-thumb { width: 48px; height: 64px; border-radius: var(--cf-radius-sm); flex: none; background: var(--cf-surface-2); object-fit: cover; }
    .tt-sub { display: block; margin-top: 2px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .tt-video-title { color: var(--cf-text); font-weight: 500; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    @media (max-width: 900px) { .tt-msg-grid { grid-template-columns: minmax(0, 1fr); } }
    @media (max-width: 640px) {
        .tiktok-edit-panel { padding-left: var(--cf-4); padding-right: var(--cf-4); }
        .cf-rows .tt-creator { flex-direction: row; flex-wrap: wrap; }
        .tt-creator > .cf-list-main { flex: 1 1 calc(100% - 52px); }
        .tt-creator > .cf-list-actions { flex-basis: 100%; }
        .tt-edit-foot .btn { margin-left: 0; width: 100%; }
    }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fab fa-tiktok"></i>
                <span>TikTok</span>
            </div>
            <div class="page-section-subtitle"><%= tiktokSubs.length %> creator<%= tiktokSubs.length === 1 ? '' : 's' %> tracked · new videos checked every 5 minutes</div>
        </div>
        <a class="btn btn-primary" href="#tt-add-head">Add creator</a>
    </div>

    <section class="cf-section" aria-labelledby="tt-creators-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tt-creators-title">Tracked creators <span class="cf-tab-count"><%= tiktokSubs.length %></span></h2>
                <p class="cf-section-desc">Each creator's video feed and live alerts. Edit changes where they post and who is pinged.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% if (tiktokSubs.length > 0) { %>
            <% tiktokSubs.forEach(sub => { const sid = sub.subscription_id; %>
            <div class="tiktok-creator-row" data-tt-sub="<%= sid %>" data-tt-user="<%= sub.username %>">
                <div class="cf-list-item cf-list-item--multi tt-creator">
                    <div class="cf-list-lead">
                        <% if (sub.profile_image_url) { %>
                        <img src="<%= sub.profile_image_url %>" alt="" class="tt-avatar" loading="lazy" referrerpolicy="no-referrer">
                        <% } else { %>
                        <span class="tt-avatar" aria-hidden="true"></span>
                        <% } %>
                    </div>
                    <div class="cf-list-main">
                        <a class="cf-list-title tt-name" href="https://tiktok.com/@<%= sub.username %>" target="_blank" rel="noopener">@<%= sub.username %></a>
                        <div class="cf-chips">
                            <span class="cf-pill <%= sub.tiktok_vod_notifications ? 'is-ok' : '' %>">Video feed <%= sub.tiktok_vod_notifications ? 'on' : 'off' %></span>
                            <span class="cf-pill <%= sub.has_live ? 'is-ok' : '' %>">Live alerts <%= sub.has_live ? 'on' : 'off' %></span>
                        </div>
                    </div>
                    <div class="cf-list-actions tt-actions">
                        <form action="/manage/<%= guild.id %>/tiktok/toggle-feed" method="POST">
                            <input type="hidden" name="subscription_id" value="<%= sid %>">
                            <input type="hidden" name="enabled" value="<%= sub.tiktok_vod_notifications ? '0' : '1' %>">
                            <button type="submit" class="btn btn-sm btn-secondary"><%= sub.tiktok_vod_notifications ? 'Stop video feed' : 'Start video feed' %></button>
                        </form>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="this.closest('.tiktok-creator-row').querySelector('.tiktok-edit-panel').style.display = this.closest('.tiktok-creator-row').querySelector('.tiktok-edit-panel').style.display === 'none' ? 'block' : 'none'" title="Edit settings">Edit</button>
                        <form action="/manage/<%= guild.id %>/tiktok/remove" method="POST" onsubmit="return confirm('Remove @<%= String(sub.username).replace(/['"\\]/g, '') %> from TikTok tracking?');">
                            <input type="hidden" name="subscription_id" value="<%= sid %>">
                            <input type="hidden" name="streamer_id" value="<%= sub.streamer_id %>">
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </div>
                </div>
                <div class="tiktok-edit-panel" style="display: none;">
                    <form action="/manage/<%= guild.id %>/tiktok/edit" method="POST">
                        <input type="hidden" name="subscription_id" value="<%= sid %>">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="f-tiktok-video_announcement_channel_id">Video feed channel</label>
                                <select id="f-tiktok-video_announcement_channel_id" name="video_announcement_channel_id" class="form-select">
                                    <option value="">Same as the live channel</option>
                                    <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= sub.video_announcement_channel_id === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-tiktok-announcement_channel_id">Live alert channel</label>
                                <select id="f-tiktok-announcement_channel_id" name="announcement_channel_id" class="form-select">
                                    <option value="">Server default</option>
                                    <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= sub.announcement_channel_id === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-tiktok-ping_role_id">Role to ping</label>
                                <select id="f-tiktok-ping_role_id" name="ping_role_id" class="form-select" data-tt-ping>
                                    <option value="">No ping</option>
                                    <option value="everyone" <%= sub.ping_role_id === 'everyone' ? 'selected' : '' %>>@everyone</option>
                                    <% ttRoles.forEach(role => { %>
                                    <option value="<%= role.id %>" data-kind="role" data-color="<%= role.color %>" <%= sub.ping_role_id === role.id ? 'selected' : '' %>><%= role.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-tiktok-live_role_id">Live role</label>
                                <select id="f-tiktok-live_role_id" name="live_role_id" class="form-select">
                                    <option value="">None</option>
                                    <% ttRoles.forEach(role => { const on = sub.live_role_id === role.id; %>
                                    <option value="<%= role.id %>" data-kind="role" data-color="<%= role.color %>" <%= on ? 'selected' : '' %><%= !role.assignable && !on ? ' disabled' : '' %>><%= role.name %><%= role.assignable ? '' : ' (above the bot)' %></option>
                                    <% }); %>
                                </select>
                                <span class="cf-field-hint">Given to the linked member while they are live.</span>
                            </div>
                        </div>
                        <div class="tt-msg-grid">
                            <div class="cf-field">
                                <label for="f-tiktok-custom_message">Message</label>
                                <textarea id="f-tiktok-custom_message" name="custom_message" class="form-control" rows="3" maxlength="2000" placeholder="{username} posted a new TikTok" data-tt-msg aria-describedby="f-tiktok-custom_message-desc"><%= sub.custom_message || '' %></textarea>
                                <span class="cf-field-hint" id="f-tiktok-custom_message-desc">Text above new-video posts and live alerts. <%= ttVarsHint %></span>
                            </div>
                            <div class="cf-field">
                                <span class="form-label">New video post</span>
                                <div class="cf-mp-frame" data-tt-preview></div>
                            </div>
                        </div>
                        <div class="tt-edit-foot">
                            <label class="cf-choice"><input type="checkbox" name="delete_on_end" value="1" <%= sub.delete_on_end ? 'checked' : '' %>> Delete the live alert when the stream ends</label>
                            <label class="cf-choice"><input type="checkbox" name="edit_on_end" value="1" <%= sub.edit_on_end ? 'checked' : '' %>> Edit it to "stream ended"</label>
                            <label class="cf-choice" title="When on, the video file is uploaded to Discord. When off, only a link is posted."><input type="checkbox" name="tiktok_embed_video" value="1" data-tt-embed <%= sub.tiktok_embed_video !== 0 ? 'checked' : '' %>> Upload the video file</label>
                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>
            <% }); %>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No TikTok creators tracked yet', text: 'Add one below.', id: null, boxed: false, compact: false }) %>
            <% } %>

            <form action="/manage/<%= guild.id %>/tiktok/add-creator" method="POST" class="tiktok-creator-row" data-tt-add>
                <div class="cf-rows-head" id="tt-add-head">Add a creator</div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-tiktok-username">TikTok username</label>
                        <p class="cf-row-desc">With or without the @.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-tiktok-username" type="text" name="username" class="form-control" maxlength="100" required placeholder="username" data-tt-username>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-tiktok-channel_id">Post videos to</label>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-tiktok-channel_id" name="channel_id" class="form-select" required>
                            <option value="">Choose a channel</option>
                            <% channels.forEach(ch => { %>
                            <option value="<%= ch.id %>">#<%= ch.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-tiktok-mention_role_id">Role to mention</label>
                        <p class="cf-row-desc">Optional. Mentioned at the start of each post.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-tiktok-mention_role_id" name="mention_role_id" class="form-select" data-tt-ping>
                            <option value="">No ping</option>
                            <option value="everyone">@everyone</option>
                            <% ttRoles.forEach(role => { %>
                            <option value="<%= role.id %>" data-kind="role" data-color="<%= role.color %>"><%= role.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-tiktok-custom_message-2">New video message</label>
                        <p class="cf-row-desc" id="f-tiktok-custom_message-2-desc">Optional. <%= ttVarsHint %></p>
                    </div>
                    <div class="cf-row-control">
                        <textarea id="f-tiktok-custom_message-2" name="custom_message" class="form-control" rows="2" maxlength="2000" placeholder="{username} posted a new TikTok" data-tt-msg aria-describedby="f-tiktok-custom_message-2-desc"></textarea>
                    </div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Preview</span>
                        <p class="cf-row-desc">With a made-up video.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-mp-frame" data-tt-preview></div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Add creator</button>
                </div>
            </form>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tt-feed-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tt-feed-title">Video feed channel for everyone</h2>
                <p class="cf-section-desc">Sets the video channel of every tracked creator at once. Uploads come with a View on TikTok button, and the video file itself when it is under 8 MB.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form action="/manage/<%= guild.id %>/tiktok/feed-settings" method="POST">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-tiktok-video_channel_id">Video feed channel</label>
                        <p class="cf-row-desc" id="f-tiktok-video_channel_id-desc">Leave as is to use each creator's live alert channel.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-tiktok-video_channel_id" class="form-select" name="video_channel_id" aria-describedby="f-tiktok-video_channel_id-desc">
                            <option value="">Same as the live alert channel</option>
                            <% channels.forEach(ch => { %>
                                <option value="<%= ch.id %>" <%= tiktokConfig.video_channel_id === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Apply to all creators</button>
                </div>
            </form>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="tt-live-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tt-live-title">Live stream alerts</h2>
                <p class="cf-section-desc">Run from the Streamers page, with Twitch, Kick, YouTube and the other platforms. Any TikTok creator added there is checked for live streams automatically.</p>
            </div>
            <div class="cf-section-actions">
                <a href="/manage/<%= guild.id %>?page=streamers" class="btn btn-secondary">Open Streamers</a>
            </div>
        </header>
    </section>

    <% if (recentVideos.length > 0) { %>
    <section class="cf-section" aria-labelledby="tt-recent-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="tt-recent-title">Recent videos</h2>
                <p class="cf-section-desc">The latest uploads the feed has seen.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-list">
                <% recentVideos.forEach(v => { %>
                <div class="cf-list-item">
                    <a class="tt-video cf-list-main" href="<%= v.video_url %>" target="_blank" rel="noopener">
                        <% if (v.thumbnail_url) { %><img class="tt-thumb" src="<%= v.thumbnail_url %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } else { %><span class="tt-thumb" aria-hidden="true"></span><% } %>
                        <span>
                            <span class="tt-video-title"><%= v.title || 'Untitled' %></span>
                            <span class="tt-sub">@<%= v.username %><% if (v.posted_at) { %> · <%= new Date(v.posted_at).toLocaleDateString() %><% } %><% if (v.thumbnail_url) { %> · <%= (v.view_count || 0).toLocaleString() %> views<% } %></span>
                        </span>
                    </a>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>
</div>

<script src="/js/cf-msgpreview.js"></script>
<script>
(function () {
    const TT = <%- JSON.stringify({ roles: ttRoles.map(r => ({ id: r.id, name: r.name, color: r.color })), channels: (channels || []).map(c => ({ id: c.id, name: c.name })), bot: { name: ttBotName, avatar: ttBotAvatar } }).replace(/</g, '\\u003c') %>;
    const CTX = { roles: TT.roles, channels: TT.channels };

    // A new-video post as jobs/tiktok-video-checker.js builds it: the ping and message as text,
    // then the video link, a blurple embed with the caption, and two link buttons.
    function draw(scope) {
        const frame = scope.querySelector('[data-tt-preview]');
        if (!frame || !window.CFMsgPreview) return;
        const user = (scope.dataset.ttUser || scope.querySelector('[data-tt-username]')?.value || 'creator').replace(/^@/, '').trim() || 'creator';
        const url = `https://www.tiktok.com/@${user}/video/7000000000000000000`;
        const caption = 'Sample video caption #fyp';
        let content = CFMsgPreview.fill(scope.querySelector('[data-tt-msg]')?.value || '', {
            username: user, streamer: user, url, title: 'Sample video', description: caption, everyone: '@everyone', here: '@here',
        }).trim();
        const ping = scope.querySelector('[data-tt-ping]')?.value || '';
        if (ping) content = (ping === 'everyone' ? '@everyone' : `<@&${ping}>`) + (content ? ' ' + content : '');
        // With "Upload the video file" on, the file is attached (videos up to 8 MB); otherwise the link is added.
        const embedBox = scope.querySelector('[data-tt-embed]');
        const upload = embedBox ? embedBox.checked : true;
        if (!upload) content = (content ? content + '\n' : '') + url;
        CFMsgPreview.render(frame, {
            username: TT.bot.name, avatarUrl: TT.bot.avatar, content,
            attachments: upload ? [{ placeholder: `${user}_video.mp4` }] : [],
            embeds: [{ color: '#5865F2', title: `${user} uploaded a new TikTok!`, description: caption, thumbnail: { placeholder: '' }, timestamp: true }],
            buttons: [{ label: 'View on TikTok' }, { label: 'View Analytics' }],
        }, CTX);
    }

    // Panels after the first get their subscription id on every field id (and the labels that point
    // at them), so each label opens its own field.
    document.querySelectorAll('.tiktok-creator-row[data-tt-sub]').forEach((row, i) => {
        if (i === 0) return;
        const sfx = '-' + row.dataset.ttSub;
        row.querySelectorAll('.tiktok-edit-panel [id]').forEach((el) => {
            const old = el.id;
            el.id = old + sfx;
            row.querySelectorAll(`label[for="${old}"]`).forEach((l) => { l.htmlFor = el.id; });
            row.querySelectorAll(`[aria-describedby="${old}"]`).forEach((c) => c.setAttribute('aria-describedby', el.id));
        });
    });

    document.querySelectorAll('.tiktok-creator-row').forEach((row) => {
        draw(row);
        row.addEventListener('input', () => draw(row));
        row.addEventListener('change', () => draw(row));
    });

})();
</script>
