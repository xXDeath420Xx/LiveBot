<%#
  Server statistics: key numbers compared with the period before, a message trend, leaderboards, an
  hour-by-day heatmap and the top emoji for a period, all loaded from GET /manage/:id/serverstats
  (dashboard/routes/features/statistics.js) by the script below, which builds every list with
  createElement/textContent. CSV export is built in the browser from the same response. Built on
  the settings-row kit (cf-settings.css); ids and the period select's handler are unchanged.
%>
<style>
    #period-select { width: auto; min-width: 11rem; }
    .ss-head-actions { display: flex; flex-wrap: wrap; gap: var(--cf-2); align-items: center; }
    .cf-kpi .ss-delta { display: block; margin-top: 2px; font-size: var(--cf-text-xs); font-weight: 400; color: var(--cf-text-3); letter-spacing: 0; }
    .cf-kpi .ss-delta.is-up { color: var(--cf-success); }
    .cf-kpi .ss-delta.is-down { color: var(--cf-danger); }
    .ss-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--cf-6); }

    /* Lists the script renders into the panels. */
    .ss-rank-list { list-style: none; padding: 0; margin: 0; }
    .ss-rank-entry { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-3); padding: 10px var(--cf-5); min-width: 0; }
    .ss-rank-entry + .ss-rank-entry { border-top: 1px solid var(--cf-border); }
    .ss-rank-info { display: flex; align-items: center; gap: var(--cf-3); min-width: 0; }
    .ss-rank-pos { flex: none; width: 24px; text-align: right; font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    .ss-rank-pos.gold, .ss-rank-pos.silver, .ss-rank-pos.bronze { color: var(--cf-text); }
    .ss-rank-name { min-width: 0; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text); overflow-wrap: anywhere; }
    .ss-rank-name i { color: var(--cf-text-3); margin-right: 6px; font-size: 0.75rem; }
    .ss-rank-value { display: flex; align-items: baseline; gap: 4px; flex: none; }
    .ss-rank-count { font-weight: 600; color: var(--cf-text); font-size: var(--cf-text-sm); font-variant-numeric: tabular-nums; }
    .ss-rank-label { font-size: var(--cf-text-xs); color: var(--cf-text-3); }

    .ss-trend-container { padding: var(--cf-4) var(--cf-5); }
    .ss-sparkline { height: 72px; display: flex; align-items: flex-end; gap: 2px; }
    .ss-sparkline-bar { flex: 1; min-height: 3px; border-radius: 2px 2px 0 0; background: color-mix(in srgb, var(--cf-accent) 45%, transparent); }
    .ss-sparkline-bar.is-zero { background: var(--cf-surface-3); }
    .ss-sparkline-bar:hover { background: var(--cf-accent); }
    .ss-trend-labels { display: flex; justify-content: space-between; margin-top: 8px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }

    .ss-heatmap-container { padding: var(--cf-4) var(--cf-5); overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .ss-heatmap { display: grid; grid-template-columns: 40px repeat(24, minmax(0, 1fr)); gap: 2px; font-size: 0.65rem; min-width: 560px; }
    .ss-heatmap-header { text-align: center; color: var(--cf-text-3); padding: 4px 0; font-weight: 500; }
    .ss-heatmap-day { display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; color: var(--cf-text-3); font-weight: 500; }
    .ss-heatmap-cell { aspect-ratio: 1; border-radius: 3px; background: var(--cf-surface-2); }
    .ss-heatmap-cell.level-1, .ss-heatmap-legend-cell.level-1 { background: color-mix(in srgb, var(--cf-accent) 20%, var(--cf-surface-2)); }
    .ss-heatmap-cell.level-2, .ss-heatmap-legend-cell.level-2 { background: color-mix(in srgb, var(--cf-accent) 40%, var(--cf-surface-2)); }
    .ss-heatmap-cell.level-3, .ss-heatmap-legend-cell.level-3 { background: color-mix(in srgb, var(--cf-accent) 60%, var(--cf-surface-2)); }
    .ss-heatmap-cell.level-4, .ss-heatmap-legend-cell.level-4 { background: color-mix(in srgb, var(--cf-accent) 80%, var(--cf-surface-2)); }
    .ss-heatmap-cell.level-5, .ss-heatmap-legend-cell.level-5 { background: var(--cf-accent); }
    .ss-heatmap-legend { display: flex; align-items: center; justify-content: flex-end; gap: 6px; margin-top: 12px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .ss-heatmap-legend-cell { width: 14px; height: 14px; border-radius: 3px; background: var(--cf-surface-2); }

    .ss-emoji-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr)); gap: var(--cf-2); padding: var(--cf-4) var(--cf-5); }
    .ss-emoji-item { background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); padding: 10px 8px; text-align: center; min-width: 0; }
    .ss-emoji-display { font-size: 1.5rem; line-height: 1; margin-bottom: 6px; }
    .ss-emoji-display img { width: 24px; height: 24px; object-fit: contain; }
    .ss-emoji-count { font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text); font-variant-numeric: tabular-nums; }
    .ss-emoji-name { font-size: var(--cf-text-xs); color: var(--cf-text-3); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    @media (max-width: 900px) { .ss-two-col { grid-template-columns: minmax(0, 1fr); } }
    @media (max-width: 640px) {
        .ss-rank-entry, .ss-trend-container, .ss-heatmap-container, .ss-emoji-grid { padding-left: var(--cf-4); padding-right: var(--cf-4); }
        .ss-head-actions { width: 100%; }
        .ss-head-actions > * { flex: 1 1 auto; }
        #period-select { width: 100%; min-height: 44px; }
        .ss-head-actions .btn { min-height: 44px; justify-content: center; }
    }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-chart-bar"></i>
                <span>Server statistics</span>
            </div>
            <div class="page-section-subtitle">Who talks most, where, and at what time of day.</div>
        </div>
        <div class="ss-head-actions">
            <select id="period-select" class="form-select ss-period-select" onchange="loadServerStats()" aria-label="Period">
                <option value="7d">Last 7 days</option>
                <option value="30d">Last 30 days</option>
                <option value="90d">Last 90 days</option>
            </select>
            <button type="button" class="btn btn-secondary btn-sm" id="cfk-ss-csv" disabled><i class="fas fa-download" aria-hidden="true"></i> Download CSV</button>
        </div>
    </div>

    <dl id="stats-overview" class="cf-kpis" aria-label="Server statistics for the period">
        <div class="cf-kpi"><dt>Messages</dt><dd class="cf-kpi-value ss-stat-value" id="stat-messages">-</dd></div>
        <div class="cf-kpi"><dt>Members who posted</dt><dd class="cf-kpi-value ss-stat-value" id="stat-members">-</dd></div>
        <div class="cf-kpi"><dt>Joined</dt><dd class="cf-kpi-value ss-stat-value" id="stat-joined">-</dd></div>
        <div class="cf-kpi"><dt>Left</dt><dd class="cf-kpi-value ss-stat-value" id="stat-left">-</dd></div>
        <div class="cf-kpi"><dt>Time in voice</dt><dd class="cf-kpi-value ss-stat-value" id="stat-voice">-</dd></div>
        <div class="cf-kpi"><dt>Commands</dt><dd class="cf-kpi-value ss-stat-value" id="stat-commands">-</dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="ss-trend-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ss-trend-title">Message activity</h2>
                <p class="cf-section-desc">Messages each day, including days with none. Hover a bar for the count; the Analytics page has full charts.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="message-trend" class="ss-trend-container">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null }) %>
            </div>
        </div>
    </section>

    <div class="ss-two-col">
        <section class="cf-section" aria-labelledby="ss-senders-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ss-senders-title">Top message senders</h2>
                </div>
            </header>
            <div class="cf-rows">
                <div id="top-messagers">
                    <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null }) %>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="ss-channels-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ss-channels-title">Most active channels</h2>
                </div>
            </header>
            <div class="cf-rows">
                <div id="channel-activity">
                    <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null }) %>
                </div>
            </div>
        </section>
    </div>

    <section class="cf-section" aria-labelledby="ss-hours-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ss-hours-title">Busiest hours</h2>
                <p class="cf-section-desc">Messages by day of the week and hour of the day (UTC), over everything the bot has recorded. Darker is busier.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="activity-heatmap" class="ss-heatmap-container">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="ss-emoji-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ss-emoji-title">Top emoji</h2>
                <p class="cf-section-desc">The five most used. Emoji stats has the full list and the emoji nobody uses.</p>
            </div>
            <div class="cf-section-actions">
                <a class="btn btn-secondary btn-sm" href="/manage/<%= guild.id %>?page=emojistats">Emoji stats</a>
            </div>
        </header>
        <div class="cf-rows">
            <div id="emoji-stats">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading', text: null }) %>
            </div>
        </div>
    </section>
</div>

<script>
// Small DOM helper: ssEl('div', 'cls', 'text' | [children], { attr: value }).
function ssEl(tag, cls, content, attrs) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (Array.isArray(content)) content.filter((c) => c != null && c !== false).forEach((c) => n.append(c));
    else if (content != null) n.textContent = String(content);
    if (attrs) Object.keys(attrs).forEach((k) => n.setAttribute(k, attrs[k]));
    return n;
}
// Loading, empty and error states: the kit's markup (partials/kit/_state.ejs).
function ssState(kind, title) {
    const box = ssEl('div', `cf-state cf-state--${kind}`, [
        kind === 'loading' ? ssEl('span', 'cf-spinner', null, { 'aria-hidden': 'true' }) : null,
        ssEl('p', 'cf-state-title', title),
    ]);
    if (kind === 'loading') { box.setAttribute('role', 'status'); box.setAttribute('aria-live', 'polite'); }
    if (kind === 'error') box.setAttribute('role', 'alert');
    return box;
}
function ssShow(id, node) { document.getElementById(id).replaceChildren(node); }
const ssFmt = (v) => (Number(v) || 0).toLocaleString();
const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
let ssLast = null; // the last response, for the CSV

// A KPI value plus a quiet "vs the days before" line. higherIsBad flips the colour (more leaves).
function ssKpi(id, value, prev, days, opts) {
    opts = opts || {};
    const dd = document.getElementById(id);
    if (!dd) return;
    dd.textContent = opts.text != null ? opts.text : ssFmt(value);
    if (prev == null) return;
    const v = Number(value) || 0, p = Number(prev) || 0, diff = v - p;
    const pct = p ? Math.round(diff / p * 100) : null;
    const note = ssEl('span', 'ss-delta', diff === 0 ? `Same as the ${days} days before`
        : `${pct == null ? (diff > 0 ? '+' : '') + diff.toLocaleString() : (pct > 0 ? '+' : '') + pct + '%'} vs the ${days} days before`);
    if (diff !== 0) note.classList.add((diff > 0) !== !!opts.higherIsBad ? 'is-up' : 'is-down');
    dd.appendChild(note);
}

async function loadServerStats() {
    const period = document.getElementById('period-select').value;

    document.querySelectorAll('.ss-stat-value').forEach(el => { el.textContent = '-'; });
    ['top-messagers', 'channel-activity', 'activity-heatmap', 'emoji-stats', 'message-trend'].forEach(id => ssShow(id, ssState('loading', 'Loading')));

    try {
        const response = await fetch(`/manage/<%= guild.id %>/serverstats?period=${encodeURIComponent(period)}`, { credentials: 'same-origin' });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || ('HTTP ' + response.status));
        ssLast = data;
        document.getElementById('cfk-ss-csv').disabled = false;

        // Overview, each against the period before (prevStats).
        const stats = data.currentStats || {};
        const prev = data.prevStats || null;
        const days = data.days || ({ '7d': 7, '30d': 30, '90d': 90 }[period] || 7);
        const pv = (k) => (prev ? prev[k] : null);
        ssKpi('stat-messages', stats.total_messages, pv('total_messages'), days);
        ssKpi('stat-members', stats.active_members ?? stats.total_members, pv('active_members'), days);
        ssKpi('stat-joined', stats.members_joined, pv('members_joined'), days);
        ssKpi('stat-left', stats.members_left, pv('members_left'), days, { higherIsBad: true });
        ssKpi('stat-voice', stats.voice_minutes, pv('voice_minutes'), days, { text: formatMinutes(stats.voice_minutes) });
        ssKpi('stat-commands', stats.commands_used, pv('commands_used'), days);

        renderMessageTrend(fillDays(data.dailyMessages || [], days));
        renderTopMessagers(data.topMessagers || []);
        renderChannelActivity(data.channelActivity || []);
        renderHeatmap(data.peakHours || []);
        renderEmojiStats(data.topEmojis || []);
    } catch (error) {
        console.error('Error loading server stats:', error);
        ['top-messagers', 'channel-activity', 'activity-heatmap', 'emoji-stats', 'message-trend'].forEach(showError);
    }
}

function formatMinutes(mins) {
    mins = Number(mins) || 0;
    if (mins >= 60) return Math.floor(mins / 60).toLocaleString() + 'h';
    return mins.toLocaleString() + 'm';
}

// Every day of the period, oldest first, with 0 for days that have no row.
function ymd(d) { return d.toISOString().slice(0, 10); }
function fillDays(rows, days) {
    const byDay = new Map(rows.map(r => [ymd(new Date(r.date)), Number(r.messages) || 0]));
    const out = [];
    for (let i = days; i >= 0; i--) {
        const d = new Date(Date.now() - i * 86400000);
        out.push({ date: ymd(d), messages: byDay.get(ymd(d)) || 0 });
    }
    return out;
}
const fmtDay = (v) => new Date(v + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

function renderMessageTrend(dailyMessages) {
    if (!dailyMessages.some(d => d.messages > 0)) {
        ssShow('message-trend', ssState('empty', 'No messages recorded in this period'));
        return;
    }
    const maxMessages = Math.max(...dailyMessages.map(d => d.messages));
    const spark = ssEl('div', 'ss-sparkline', dailyMessages.map(d => {
        const bar = ssEl('div', 'ss-sparkline-bar' + (d.messages ? '' : ' is-zero'), null, { title: `${fmtDay(d.date)}: ${ssFmt(d.messages)} messages` });
        bar.style.height = Math.max(maxMessages > 0 ? (d.messages / maxMessages) * 100 : 0, 4) + '%';
        return bar;
    }), { role: 'img', 'aria-label': `Messages per day, ${fmtDay(dailyMessages[0].date)} to ${fmtDay(dailyMessages[dailyMessages.length - 1].date)}; busiest day ${ssFmt(maxMessages)}` });
    const wrap = ssEl('div', null, [spark, ssEl('div', 'ss-trend-labels', [
        ssEl('span', null, fmtDay(dailyMessages[0].date)),
        ssEl('span', null, fmtDay(dailyMessages[dailyMessages.length - 1].date)),
    ])]);
    ssShow('message-trend', wrap);
}

function rankList(items, nameNode, count) {
    return ssEl('div', 'ss-rank-list', items.map((it, i) => ssEl('div', 'ss-rank-entry', [
        ssEl('div', 'ss-rank-info', [
            ssEl('div', 'ss-rank-pos ' + (['gold', 'silver', 'bronze'][i] || ''), i + 1),
            ssEl('div', 'ss-rank-name', nameNode(it)),
        ]),
        ssEl('div', 'ss-rank-value', [ssEl('span', 'ss-rank-count', ssFmt(count(it))), ssEl('span', 'ss-rank-label', 'msgs')]),
    ])));
}

function renderTopMessagers(messagers) {
    if (!messagers.length) { ssShow('top-messagers', ssState('empty', 'No message data for this period')); return; }
    ssShow('top-messagers', rankList(messagers, (u) => u.username
        ? [ssEl('i', 'fas fa-user', null, { 'aria-hidden': 'true' }), u.username]
        : [ssEl('span', null, u.user_id, { 'data-user-id': u.user_id, 'data-user-size': 'sm' })], (u) => u.total_messages));
}

function renderChannelActivity(channels) {
    if (!channels.length) { ssShow('channel-activity', ssState('empty', 'No channel data for this period')); return; }
    ssShow('channel-activity', rankList(channels, (c) => [ssEl('i', 'fas fa-hashtag', null, { 'aria-hidden': 'true' }), c.channel_name || ('deleted channel ' + c.channel_id)], (c) => c.total_messages));
}

function renderHeatmap(peakHours) {
    const heatData = {};
    let maxCount = 0;
    peakHours.forEach(h => {
        const n = Number(h.message_count) || 0;
        heatData[`${h.day_of_week}-${h.hour_of_day}`] = n;
        if (n > maxCount) maxCount = n;
    });
    if (maxCount === 0) { ssShow('activity-heatmap', ssState('empty', 'No activity data available yet')); return; }

    const grid = ssEl('div', 'ss-heatmap', null, { role: 'img', 'aria-label': 'Messages by weekday and hour' });
    grid.append(ssEl('div', 'ss-heatmap-header'));
    for (let h = 0; h < 24; h++) grid.append(ssEl('div', 'ss-heatmap-header', h % 6 === 0 ? String(h) : ''));
    for (let d = 0; d < 7; d++) {
        grid.append(ssEl('div', 'ss-heatmap-day', dayNames[d]));
        for (let h = 0; h < 24; h++) {
            const count = heatData[`${d}-${h}`] || 0;
            grid.append(ssEl('div', `ss-heatmap-cell level-${getHeatLevel(count, maxCount)}`, null, { title: `${dayNames[d]} ${h}:00, ${ssFmt(count)} messages` }));
        }
    }
    const legend = ssEl('div', 'ss-heatmap-legend', [ssEl('span', null, 'Less')]);
    for (let l = 0; l <= 5; l++) legend.append(ssEl('div', 'ss-heatmap-legend-cell' + (l ? ` level-${l}` : '')));
    legend.append(ssEl('span', null, 'More'));
    ssShow('activity-heatmap', ssEl('div', null, [grid, legend]));
}

function getHeatLevel(count, max) {
    if (count === 0) return 0;
    const pct = count / max;
    if (pct <= 0.2) return 1;
    if (pct <= 0.4) return 2;
    if (pct <= 0.6) return 3;
    if (pct <= 0.8) return 4;
    return 5;
}

function renderEmojiStats(emojis) {
    if (!emojis.length) { ssShow('emoji-stats', ssState('empty', 'No emoji usage data for this period')); return; }
    ssShow('emoji-stats', ssEl('div', 'ss-emoji-grid', emojis.slice(0, 5).map(e => {
        let display;
        if (e.is_custom && /^\d{15,22}$/.test(String(e.emoji_id))) {
            display = ssEl('img', null, null, { src: `https://cdn.discordapp.com/emojis/${e.emoji_id}.webp?size=32`, alt: e.emoji_name || 'custom emoji', width: '24', height: '24', loading: 'lazy' });
        } else {
            display = e.emoji_name || e.emoji_id || '';
        }
        return ssEl('div', 'ss-emoji-item', [
            ssEl('div', 'ss-emoji-display', [display]),
            ssEl('div', 'ss-emoji-count', ssFmt(e.use_count)),
            ssEl('div', 'ss-emoji-name', e.is_custom ? ':' + (e.emoji_name || 'emoji') + ':' : 'standard'),
        ]);
    })));
}

function showError(elementId) {
    ssShow(elementId, ssState('error', 'Could not load this. Refresh to try again.'));
}

// CSV of what the page shows: the totals (with the period before), each day's messages and both leaderboards.
document.getElementById('cfk-ss-csv').addEventListener('click', function () {
    if (!ssLast) return;
    const q = (v) => { const t = String(v ?? ''); return /[",\r\n]/.test(t) ? '"' + t.replace(/"/g, '""') + '"' : t; };
    const s = ssLast.currentStats || {}, p = ssLast.prevStats || {};
    const lines = [['section', 'name', 'value', 'previous_period'].join(',')];
    [['messages', 'total_messages'], ['members_who_posted', 'active_members'], ['joined', 'members_joined'], ['left', 'members_left'],
     ['voice_minutes', 'voice_minutes'], ['commands', 'commands_used']]
        .forEach(([n, k]) => lines.push(['total', n, s[k] ?? (k === 'active_members' ? s.total_members : 0), p[k] ?? ''].map(q).join(',')));
    fillDays(ssLast.dailyMessages || [], ssLast.days || 7).forEach(d => lines.push(['day', d.date, d.messages, ''].map(q).join(',')));
    (ssLast.topMessagers || []).forEach(u => lines.push(['top_sender', u.username || u.user_id, u.total_messages, ''].map(q).join(',')));
    (ssLast.channelActivity || []).forEach(c => lines.push(['channel', '#' + (c.channel_name || c.channel_id), c.total_messages, ''].map(q).join(',')));
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([lines.join('\r\n') + '\r\n'], { type: 'text/csv;charset=utf-8' }));
    a.download = 'server-stats-<%= guild.id %>-' + (ssLast.period || 'period') + '.csv';
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 0);
});

loadServerStats();
</script>
