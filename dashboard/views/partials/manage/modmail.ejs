<%
// Modmail page. Data from dashboard/services/modmail-section.js (LOADERS.modmail in
// manage-sections.js); actions go to dashboard/routes/api/features/modmail.js
// (/api/guilds/:guildId/modmail/...). The bot side is core/modmail-manager.js.
const mmConfig = (typeof modmailConfig !== 'undefined' && modmailConfig) ? modmailConfig : {};
const mmStats = (typeof modmailStats !== 'undefined' && modmailStats) ? modmailStats : {};
const mmThreads = (typeof modmailThreads !== 'undefined' && Array.isArray(modmailThreads)) ? modmailThreads : [];
const mmHistory = (typeof modmailHistory !== 'undefined' && Array.isArray(modmailHistory)) ? modmailHistory : [];
const mmBlocked = (typeof modmailBlockedUsers !== 'undefined' && Array.isArray(modmailBlockedUsers)) ? modmailBlockedUsers : [];
const mmCategories = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : [];
const mmChannels = (typeof channels !== 'undefined' && Array.isArray(channels)) ? channels : [];
const mmRoles = (typeof roles !== 'undefined' && Array.isArray(roles)) ? roles : [];
const mmEnabled = Number(mmConfig.enabled) === 1;
const mmRole = mmRoles.find(r => r.id === mmConfig.staff_role_id);
const mmCategory = mmCategories.find(c => c.id === mmConfig.category_id);
const fmtDate = (v) => v ? new Date(v).toLocaleString('en-GB', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) + ' UTC' : '—';
%>
<div class="page-section" id="modmail-page" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-envelope-open-text"></i>
                <span>Modmail</span>
            </div>
            <div class="page-section-subtitle">
                Members DM the bot to reach your staff privately; staff answer from a private channel
            </div>
        </div>
    </div>

    <!-- Configuration -->
    <div class="mm-card">
        <div class="mm-card-head">
            <div class="mm-icon" style="background: var(--bg-card-hover);"><i class="fas fa-cog"></i></div>
            <div>
                <h4 class="mm-title">Settings</h4>
                <p class="mm-sub">Where conversations open, who answers them, and what members are told</p>
            </div>
        </div>

        <form id="modmail-config-form">
            <label class="mm-switch-row">
                <input type="checkbox" id="mmEnabled" <%= mmEnabled ? 'checked' : '' %>>
                <span>
                    <span class="mm-label">Enable modmail</span>
                    <span class="mm-help">Members who DM the bot are asked whether to contact this server's staff. Off by default.</span>
                </span>
            </label>

            <div class="mm-grid">
                <div>
                    <label class="mm-label" for="mmCategory">Thread category</label>
                    <select class="form-select" id="mmCategory">
                        <option value="">— top of the channel list —</option>
                        <% mmCategories.forEach(c => { %>
                            <option value="<%= c.id %>" <%= mmConfig.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                        <% }); %>
                    </select>
                    <div class="mm-help">Each conversation gets a private channel here. Roles the category already lets in keep access.</div>
                </div>
                <div>
                    <label class="mm-label" for="mmStaffRole">Staff role</label>
                    <select class="form-select" id="mmStaffRole">
                        <option value="">— administrators only —</option>
                        <% mmRoles.forEach(r => { %>
                            <option value="<%= r.id %>" <%= mmConfig.staff_role_id === r.id ? 'selected' : '' %>><%= r.name %></option>
                        <% }); %>
                    </select>
                    <div class="mm-help">Can see conversations and reply; pinged when one opens. Manage Server / Administrator always can.</div>
                </div>
                <div>
                    <label class="mm-label" for="mmLogChannel">Log channel</label>
                    <select class="form-select" id="mmLogChannel">
                        <option value="">— none —</option>
                        <% mmChannels.forEach(c => { %>
                            <option value="<%= c.id %>" <%= mmConfig.log_channel_id === c.id ? 'selected' : '' %>>#<%= c.name %></option>
                        <% }); %>
                    </select>
                    <div class="mm-help">Opens, closes and a .txt transcript of every closed conversation.</div>
                </div>
                <div>
                    <label class="mm-switch-row" style="margin:0">
                        <input type="checkbox" id="mmAnonymous" <%= Number(mmConfig.anonymous_replies) === 1 ? 'checked' : '' %>>
                        <span>
                            <span class="mm-label">Anonymous staff replies</span>
                            <span class="mm-help">Members see "<%= guild.name %> Staff" instead of who answered. Transcripts still record the staff member.</span>
                        </span>
                    </label>
                </div>
            </div>

            <div style="margin-bottom: var(--spacing-4);">
                <label class="mm-label" for="mmGreeting">Greeting</label>
                <textarea class="form-control" id="mmGreeting" rows="3" maxlength="2000" placeholder="Thank you for contacting the staff team. Please describe your issue."><%= mmConfig.greeting_message || '' %></textarea>
                <div class="mm-help">Sent to the member when their conversation opens.</div>
            </div>
            <div style="margin-bottom: var(--spacing-4);">
                <label class="mm-label" for="mmClose">Closing message</label>
                <textarea class="form-control" id="mmClose" rows="2" maxlength="2000" placeholder="This modmail thread has been closed. Thank you for contacting us."><%= mmConfig.close_message || '' %></textarea>
                <div class="mm-help">Sent to the member when a conversation is closed (with the reason, if staff give one).</div>
            </div>

            <% if (mmEnabled) { %>
                <div class="mm-note mm-note-ok">
                    <i class="fas fa-check-circle"></i>
                    Modmail is on. Conversations open in <strong><%= mmCategory ? mmCategory.name : 'the top of the channel list' %></strong>
                    and are answered by <strong><%= mmRole ? '@' + mmRole.name : 'administrators' %></strong>.
                    In each conversation channel, start a message with <code>//</code> to keep it as a staff-only note.
                </div>
            <% } %>

            <button type="submit" class="btn btn-primary" id="mmSave">
                <i class="fas fa-save"></i>
                <span>Save settings</span>
            </button>
        </form>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-4" style="margin-bottom: var(--spacing-6); gap: var(--spacing-4);">
        <div class="mm-stat"><div class="mm-stat-label">Total conversations</div><div class="mm-stat-value"><%= mmStats.total_threads || 0 %></div></div>
        <div class="mm-stat"><div class="mm-stat-label">Open now</div><div class="mm-stat-value" style="color: var(--color-primary-400);"><%= mmStats.active_threads || 0 %></div></div>
        <div class="mm-stat"><div class="mm-stat-label">Avg first reply</div><div class="mm-stat-value" style="color: var(--cf-info-ink);"><%= mmStats.avg_response_time || '—' %></div></div>
        <div class="mm-stat"><div class="mm-stat-label">Avg time to close</div><div class="mm-stat-value" style="color: var(--color-success);"><%= mmStats.avg_resolution_time || '—' %></div></div>
    </div>

    <!-- Open conversations -->
    <div class="mm-card">
        <div class="mm-card-head">
            <div class="mm-icon" style="background: var(--bg-card-hover);"><i class="fas fa-inbox"></i></div>
            <div>
                <h4 class="mm-title">Open conversations</h4>
                <p class="mm-sub">Reply from the conversation's channel in Discord; close from there or here</p>
            </div>
        </div>

        <% if (mmThreads.length > 0) { %>
            <input type="text" id="mmThreadSearch" class="form-control" placeholder="Filter by member or #number…" style="margin-bottom: var(--spacing-4);">
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr><th>Member</th><th>#</th><th>Channel</th><th>Opened</th><th>Last activity</th><th>Messages</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody id="mmThreadsBody">
                        <% mmThreads.forEach(t => { %>
                            <tr class="mm-thread-row" data-search="<%= ((t.user_tag || '') + ' ' + t.user_id + ' #' + t.id).toLowerCase() %>">
                                <td>
                                    <div class="mm-who"><%- include('_user-cell', { cfUser: null, cfUserId: t.user_id, cfUserName: t.user_tag || null }) %></div>
                                </td>
                                <td><code class="mm-code">#<%= t.id %></code></td>
                                <td>
                                    <% if (t.channel_exists) { %>
                                        <a href="https://discord.com/channels/<%= guild.id %>/<%= t.channel_id %>" target="_blank" rel="noopener">Open in Discord</a>
                                    <% } else { %>
                                        <span class="badge badge-danger">channel missing</span>
                                    <% } %>
                                </td>
                                <td><%= fmtDate(t.created_at) %></td>
                                <td><%= fmtDate(t.last_activity) %></td>
                                <td><span class="badge badge-primary"><%= t.message_count %></span></td>
                                <td class="text-end">
                                    <div style="display: flex; gap: var(--spacing-2); justify-content: flex-end;">
                                        <button type="button" class="btn btn-sm btn-secondary mm-view" data-thread-id="<%= t.id %>" title="View messages"><i class="fas fa-eye"></i></button>
                                        <button type="button" class="btn btn-sm btn-danger mm-close" data-thread-id="<%= t.id %>" title="Close conversation"><i class="fas fa-times"></i></button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-inbox"></i></div>
                <div class="empty-state-title">No open conversations</div>
                <div class="empty-state-description"><%= mmEnabled ? 'Nobody is waiting on staff right now.' : 'Turn modmail on above to start receiving messages.' %></div>
            </div>
        <% } %>
    </div>

    <!-- Blocked -->
    <div class="mm-card">
        <div class="mm-card-head" style="justify-content: space-between;">
            <div style="display:flex; gap: var(--spacing-3); align-items:center;">
                <div class="mm-icon" style="background: linear-gradient(135deg, var(--color-danger), #be123c);"><i class="fas fa-ban"></i></div>
                <div>
                    <h4 class="mm-title">Blocked members</h4>
                    <p class="mm-sub">They can't open conversations with this server's staff</p>
                </div>
            </div>
            <button type="button" class="btn btn-danger" id="mmBlockBtn"><i class="fas fa-user-slash"></i> <span>Block a user</span></button>
        </div>

        <% if (mmBlocked.length > 0) { %>
            <div class="table-container">
                <table class="data-table">
                    <thead><tr><th>Member</th><th>Blocked by</th><th>Reason</th><th>When</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        <% mmBlocked.forEach(b => { %>
                            <tr>
                                <td><div class="mm-who"><%- include('_user-cell', { cfUser: null, cfUserId: b.user_id, cfUserName: b.user_tag || null }) %></div></td>
                                <td><%= b.blocked_by_tag || '—' %></td>
                                <td><div class="mm-ellipsis"><%= b.reason || 'No reason given' %></div></td>
                                <td><%= fmtDate(b.blocked_at) %></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-success mm-unblock" data-user-id="<%= b.user_id %>"><i class="fas fa-unlock"></i> <span>Unblock</span></button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-user-check"></i></div>
                <div class="empty-state-title">Nobody is blocked</div>
                <div class="empty-state-description">Use "Block & close" in a conversation channel, or block a user ID here.</div>
            </div>
        <% } %>
    </div>

    <!-- History -->
    <div class="mm-card">
        <div class="mm-card-head">
            <div class="mm-icon" style="background: var(--bg-card-hover);"><i class="fas fa-history"></i></div>
            <div>
                <h4 class="mm-title">Closed conversations</h4>
                <p class="mm-sub">The 50 most recent, with full transcripts</p>
            </div>
        </div>

        <% if (mmHistory.length > 0) { %>
            <div class="table-container">
                <table class="data-table">
                    <thead><tr><th>Member</th><th>#</th><th>Closed</th><th>Closed by</th><th>Reason</th><th>Open for</th><th class="text-end">Transcript</th></tr></thead>
                    <tbody>
                        <% mmHistory.forEach(t => { %>
                            <tr>
                                <td><div class="mm-who"><%- include('_user-cell', { cfUser: null, cfUserId: t.user_id, cfUserName: t.user_tag || null }) %></div></td>
                                <td><code class="mm-code">#<%= t.id %></code></td>
                                <td><%= fmtDate(t.closed_at) %></td>
                                <td><%= t.closed_by_tag || '—' %></td>
                                <td><div class="mm-ellipsis"><%= t.close_reason || '—' %></div></td>
                                <td><span class="badge badge-secondary"><%= t.duration || '—' %></span></td>
                                <td class="text-end">
                                    <div style="display: flex; gap: var(--spacing-2); justify-content: flex-end;">
                                        <button type="button" class="btn btn-sm btn-secondary mm-view" data-thread-id="<%= t.id %>" title="View transcript"><i class="fas fa-file-alt"></i></button>
                                        <a class="btn btn-sm btn-secondary" href="/api/guilds/<%= guild.id %>/modmail/threads/<%= t.id %>/transcript?format=txt" title="Download .txt"><i class="fas fa-download"></i></a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-history"></i></div>
                <div class="empty-state-title">No closed conversations yet</div>
                <div class="empty-state-description">Closed conversations and their transcripts appear here.</div>
            </div>
        <% } %>
    </div>

    <div class="mm-note">
        <i class="fas fa-lightbulb"></i>
        <div>
            <strong>How it works.</strong>
            A member DMs the bot → the bot asks which server's staff it is for → a private channel opens here and your staff role is pinged.
            Everything staff write in that channel goes to the member's DMs (except messages starting with <code>//</code>); the member's replies come back to the channel.
            <strong>Close</strong> saves the transcript, tells the member and deletes the channel; <strong>Block &amp; close</strong> also stops them opening new ones.
            One open conversation per member.
        </div>
    </div>
</div>

<!-- Block modal -->
<div class="modal fade" id="mmBlockModal" tabindex="-1" aria-labelledby="mmBlockModalLabel" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="mmBlockModalLabel"><i class="fas fa-user-slash"></i> Block a user from modmail</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="mmBlockForm">
            <div class="modal-body">
                <label class="mm-label" for="mmBlockUserId">User ID</label>
                <input type="text" class="form-control" id="mmBlockUserId" inputmode="numeric" pattern="\d{15,25}" placeholder="123456789012345678" required>
                <div class="mm-help">Right-click the user in Discord → Copy User ID. Any conversation they have open is closed.</div>
                <label class="mm-label" for="mmBlockReason" style="margin-top: var(--spacing-4);">Reason (staff only)</label>
                <textarea class="form-control" id="mmBlockReason" rows="3" maxlength="1000"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger"><i class="fas fa-ban"></i> Block</button>
            </div>
        </form>
    </div></div>
</div>

<!-- Close modal -->
<div class="modal fade" id="mmCloseModal" tabindex="-1" aria-labelledby="mmCloseModalLabel" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="mmCloseModalLabel"><i class="fas fa-times-circle"></i> Close conversation</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="mmCloseForm">
            <input type="hidden" id="mmCloseThreadId">
            <div class="modal-body">
                <label class="mm-label" for="mmCloseReason">Reason (optional)</label>
                <textarea class="form-control" id="mmCloseReason" rows="3" maxlength="1000"></textarea>
                <div class="mm-help">Sent to the member with the closing message. The channel is deleted after the transcript is saved.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger"><i class="fas fa-times"></i> Close</button>
            </div>
        </form>
    </div></div>
</div>

<!-- Messages / transcript modal -->
<div class="modal fade" id="mmViewModal" tabindex="-1" aria-labelledby="mmViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="mmViewModalLabel"><i class="fas fa-comments"></i> <span id="mmViewTitle">Conversation</span></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="mmViewBody" style="max-height: 520px; overflow-y: auto;"></div>
        <div class="modal-footer">
            <a class="btn btn-primary" id="mmViewDownload" href="#"><i class="fas fa-download"></i> Download .txt</a>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
    </div></div>
</div>

<script>
(function () {
    var root = document.getElementById('modmail-page');
    if (!root) return;
    var guildId = root.getAttribute('data-guild-id');
    var api = '/api/guilds/' + guildId + '/modmail';

    function toast(msg, type) {
        if (typeof window.showToast === 'function') return window.showToast(msg, type);
        if (type === 'error') console.error(msg); else console.log(msg);
    }

    // DOM builder — message text is user content and must never be parsed as markup.
    function el(tag, props, children) {
        var node = document.createElement(tag);
        Object.keys(props || {}).forEach(function (k) {
            if (k === 'text') node.textContent = props[k];
            else if (k === 'style') node.style.cssText = props[k];
            else if (k === 'className') node.className = props[k];
            else node.setAttribute(k, props[k]);
        });
        (children || []).forEach(function (c) { if (c) node.appendChild(typeof c === 'string' ? document.createTextNode(c) : c); });
        return node;
    }

    function modal(id) {
        var node = document.getElementById(id);
        return (node && typeof bootstrap !== 'undefined') ? bootstrap.Modal.getOrCreateInstance(node) : null;
    }

    async function send(method, url, body) {
        var res = await fetch(url, {
            method: method,
            headers: body ? { 'Content-Type': 'application/json' } : {},
            body: body ? JSON.stringify(body) : undefined
        });
        var data = {};
        try { data = await res.json(); } catch (e) { /* non-JSON error page */ }
        if (!res.ok) throw new Error(data.error || ('Request failed (' + res.status + ')'));
        return data;
    }

    // Settings
    var form = document.getElementById('modmail-config-form');
    if (form) form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = document.getElementById('mmSave');
        btn.disabled = true;
        try {
            var data = await send('PUT', api + '/config', {
                enabled: document.getElementById('mmEnabled').checked,
                category_id: document.getElementById('mmCategory').value,
                staff_role_id: document.getElementById('mmStaffRole').value,
                log_channel_id: document.getElementById('mmLogChannel').value,
                anonymous_replies: document.getElementById('mmAnonymous').checked,
                greeting_message: document.getElementById('mmGreeting').value,
                close_message: document.getElementById('mmClose').value
            });
            toast(data.message || 'Saved', 'success');
            setTimeout(function () { location.reload(); }, 900);
        } catch (err) {
            toast(err.message, 'error');
        }
        btn.disabled = false;
    });

    // Filter open conversations
    var search = document.getElementById('mmThreadSearch');
    if (search) search.addEventListener('input', function () {
        var q = search.value.trim().toLowerCase();
        document.querySelectorAll('#mmThreadsBody .mm-thread-row').forEach(function (row) {
            row.style.display = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1 ? '' : 'none';
        });
    });

    // View messages / transcript
    function renderMessages(container, thread, messages) {
        container.replaceChildren();
        var opened = thread && thread.created_at ? new Date(thread.created_at).toLocaleString() : '';
        var closed = thread && thread.closed_at ? new Date(thread.closed_at).toLocaleString() : null;
        container.appendChild(el('div', { className: 'mm-meta' }, [
            el('div', { text: 'Opened ' + opened + (closed ? ' · Closed ' + closed : ' · still open') }),
            thread && thread.close_reason ? el('div', { text: 'Reason: ' + thread.close_reason }) : null
        ]));
        if (!messages.length) {
            container.appendChild(el('div', { className: 'mm-help', text: 'No messages.' }));
            return;
        }
        messages.forEach(function (m) {
            var kind = m.author_type === 'user' ? 'member' : m.author_type === 'system' ? 'system' : (m.is_internal ? 'note' : 'staff');
            var who = kind === 'member' ? 'Member' : kind === 'system' ? 'System' : kind === 'note' ? 'Staff note' : 'Staff';
            if (m.author_name && kind !== 'system') who += ' · ' + m.author_name;
            if (m.is_anonymous) who += ' (sent anonymously)';
            var attachments = (m.attachments || []).map(function (a) {
                return el('div', {}, [el('a', { href: a.url, target: '_blank', rel: 'noopener noreferrer', text: '📎 ' + a.name })]);
            });
            container.appendChild(el('div', { className: 'mm-msg mm-msg-' + kind }, [
                el('div', { className: 'mm-msg-head' }, [
                    el('span', { className: 'mm-msg-who', text: who }),
                    el('span', { className: 'mm-help', style: 'margin:0', text: new Date(m.timestamp).toLocaleString() })
                ]),
                el('div', { className: 'mm-msg-body', text: m.message_content || '(no text)' })
            ].concat(attachments)));
        });
    }

    document.querySelectorAll('.mm-view').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            var id = btn.getAttribute('data-thread-id');
            var body = document.getElementById('mmViewBody');
            document.getElementById('mmViewTitle').textContent = 'Conversation #' + id;
            document.getElementById('mmViewDownload').setAttribute('href', api + '/threads/' + id + '/transcript?format=txt');
            body.replaceChildren(el('div', { className: 'mm-help', text: 'Loading…' }));
            var m = modal('mmViewModal'); if (m) m.show();
            try {
                var data = await send('GET', api + '/threads/' + id + '/messages');
                renderMessages(body, data.thread, data.messages || []);
            } catch (err) {
                body.replaceChildren(el('div', { className: 'mm-help', style: 'color: var(--color-danger)', text: err.message }));
            }
        });
    });

    // Close
    document.querySelectorAll('.mm-close').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById('mmCloseThreadId').value = btn.getAttribute('data-thread-id');
            document.getElementById('mmCloseReason').value = '';
            var m = modal('mmCloseModal'); if (m) m.show();
        });
    });
    var closeForm = document.getElementById('mmCloseForm');
    if (closeForm) closeForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var id = document.getElementById('mmCloseThreadId').value;
        try {
            var data = await send('POST', api + '/threads/' + id + '/close', { reason: document.getElementById('mmCloseReason').value });
            toast(data.message || 'Closed', 'success');
            var m = modal('mmCloseModal'); if (m) m.hide();
            setTimeout(function () { location.reload(); }, 900);
        } catch (err) {
            toast(err.message, 'error');
        }
    });

    // Block / unblock
    var blockBtn = document.getElementById('mmBlockBtn');
    if (blockBtn) blockBtn.addEventListener('click', function () {
        var m = modal('mmBlockModal'); if (m) m.show();
    });
    var blockForm = document.getElementById('mmBlockForm');
    if (blockForm) blockForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        try {
            var data = await send('POST', api + '/blocked', {
                user_id: document.getElementById('mmBlockUserId').value.trim(),
                reason: document.getElementById('mmBlockReason').value
            });
            toast(data.message || 'Blocked', 'success');
            var m = modal('mmBlockModal'); if (m) m.hide();
            setTimeout(function () { location.reload(); }, 900);
        } catch (err) {
            toast(err.message, 'error');
        }
    });
    document.querySelectorAll('.mm-unblock').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            if (!confirm('Unblock this user? They will be able to open modmail conversations again.')) return;
            try {
                var data = await send('DELETE', api + '/blocked/' + encodeURIComponent(btn.getAttribute('data-user-id')));
                toast(data.message || 'Unblocked', 'success');
                setTimeout(function () { location.reload(); }, 900);
            } catch (err) {
                toast(err.message, 'error');
            }
        });
    });
})();
</script>

