<div class="modal fade" id="bulk-actions-modal" tabindex="-1" aria-labelledby="bulkActionsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkActionsModalLabel">Bulk Update Subscriptions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="bulk-selection-count" style="color: rgba(255,255,255,0.7); font-size: 0.85rem; margin-bottom: 16px;">
                    0 streamer(s) selected
                </p>

                <!-- Announcement Channel -->
                <div class="mb-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="bulk-apply-channel">
                        <label class="form-check-label" for="bulk-apply-channel" style="font-weight: 600;">
                            Change Announcement Channel
                        </label>
                    </div>
                    <select id="bulk-channel-select" class="form-select" disabled>
                        <option value="">Server Default</option>
                        <% channels.forEach(c => { %>
                            <option value="<%= c.id %>">#<%= c.name %></option>
                        <% }); %>
                    </select>
                </div>

                <!-- Live Role -->
                <div class="mb-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="bulk-apply-role">
                        <label class="form-check-label" for="bulk-apply-role" style="font-weight: 600;">
                            Change Role to Mention
                        </label>
                    </div>
                    <select id="bulk-role-select" class="form-select" disabled>
                        <option value="">No Role</option>
                        <% roles.forEach(r => { %>
                            <option value="<%= r.id %>"><%= r.name %></option>
                        <% }); %>
                    </select>
                </div>

                <!-- Custom Message -->
                <div class="mb-3">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="bulk-apply-message">
                        <label class="form-check-label" for="bulk-apply-message" style="font-weight: 600;">
                            Change Message Template
                        </label>
                    </div>
                    <textarea id="bulk-message-input" class="form-control" rows="3" disabled
                        placeholder="{streamer} is now live on {platform}! {url}"
                        style="font-family: monospace; font-size: 0.8rem;"></textarea>
                    <div class="form-help">Variables: {streamer}, {platform}, {game}, {url}, {title}, {everyone}</div>
                </div>

                <div id="bulk-actions-status"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="execute-bulk-update">Apply Changes</button>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    function showStatus(type, message) {
        const statusEl = document.getElementById('bulk-actions-status');
        statusEl.textContent = '';
        const div = document.createElement('div');
        div.className = 'alert alert-' + type;
        div.style.fontSize = '0.85rem';
        div.textContent = message;
        statusEl.appendChild(div);
    }

    // Toggle field enabled state based on apply checkbox
    document.getElementById('bulk-apply-channel')?.addEventListener('change', function() {
        document.getElementById('bulk-channel-select').disabled = !this.checked;
    });
    document.getElementById('bulk-apply-role')?.addEventListener('change', function() {
        document.getElementById('bulk-role-select').disabled = !this.checked;
    });
    document.getElementById('bulk-apply-message')?.addEventListener('change', function() {
        document.getElementById('bulk-message-input').disabled = !this.checked;
    });

    // Execute bulk update
    document.getElementById('execute-bulk-update')?.addEventListener('click', async function() {
        const btn = this;

        // Gather selected subscription IDs from the global
        const subscriptionIds = window._bulkSelectedSubscriptionIds || [];
        if (subscriptionIds.length === 0) {
            showStatus('warning', 'No subscriptions selected.');
            return;
        }

        // Build payload with only checked fields
        const payload = { subscriptionIds };
        let fieldCount = 0;

        if (document.getElementById('bulk-apply-channel').checked) {
            payload.announcement_channel_id = document.getElementById('bulk-channel-select').value || null;
            fieldCount++;
        }
        if (document.getElementById('bulk-apply-role').checked) {
            payload.role_to_mention = document.getElementById('bulk-role-select').value || null;
            fieldCount++;
        }
        if (document.getElementById('bulk-apply-message').checked) {
            payload.custom_message = document.getElementById('bulk-message-input').value || null;
            fieldCount++;
        }

        if (fieldCount === 0) {
            showStatus('warning', 'Check at least one field to update.');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Updating...';
        document.getElementById('bulk-actions-status').textContent = '';

        try {
            const guildId = window.location.pathname.split('/')[2];
            const res = await fetch(`/api/guilds/${guildId}/streaming/subscriptions/bulk-update`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();

            if (res.ok && data.success) {
                showStatus('success', 'Updated ' + data.updatedCount + ' subscription(s).');
                setTimeout(() => location.reload(), 1200);
            } else {
                showStatus('danger', data.error || 'Update failed.');
            }
        } catch (err) {
            showStatus('danger', 'Network error. Please try again.');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Apply Changes';
        }
    });
})();
</script>
