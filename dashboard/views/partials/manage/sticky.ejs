<%#
  Sticky messages: one message per channel that the bot reposts at the bottom after new messages
  (events/messageCreate.js). The list loads from GET /manage/:guildId/sticky; add and edit (POST, one
  row per channel, so saving to a channel that has one replaces it) and delete (DELETE
  …/sticky/:channelId) go through the same route (dashboard/routes/features/content-management.js).
  Built on the settings-row kit (cf-settings.css); ids, field names and handlers are unchanged.
  The preview is the shared Discord-style one (/js/cf-msgpreview.js).
%>
<%
const stChannels = (typeof channels !== 'undefined' && channels ? channels : []).filter(c => c.type === 0 || c.type === 5);
const stRoles = typeof roles !== 'undefined' && roles ? roles : [];
// Names for the preview's <#channel> and <@&role> mentions; JSON with '<' escaped below.
const stNames = {
    channels: Object.fromEntries((typeof channels !== 'undefined' && channels ? channels : []).map(c => [c.id, c.name])),
    roles: Object.fromEntries(stRoles.map(r => [r.id, { name: r.name, color: r.hexColor || (typeof r.color === 'number' && r.color ? '#' + r.color.toString(16).padStart(6, '0') : null) }])),
};
%>
<style>
    /* The sticky text itself, quoted under its channel. */
    #sticky-list .sticky-content {
        margin: 0; padding: var(--cf-3) var(--cf-4); white-space: pre-wrap; overflow-wrap: anywhere;
        font-size: var(--cf-text-sm); line-height: 1.55; color: var(--cf-text-2);
        background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius);
    }
    .st-preview-row .cf-row-control { gap: var(--cf-2); }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-thumbtack"></i>
                <span>Sticky messages</span>
            </div>
            <div class="page-section-subtitle">One per channel, plain text up to 2,000 characters.</div>
        </div>
    </div>

    <section class="cf-section" id="add-sticky-card" hidden aria-labelledby="add-sticky-card-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="add-sticky-card-title">New sticky message</h2>
                <p class="cf-section-desc">The bot posts it after the next message in the channel, then keeps it at the bottom.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form id="sticky-form" onsubmit="createStickyMessage(event)">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sticky-channel">Channel</label>
                        <p class="cf-row-desc" id="sticky-channel-desc">A channel that already has a sticky message gets this one instead.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="sticky-channel" name="channel_id" class="form-select" required aria-describedby="sticky-channel-desc">
                            <option value="">Choose a channel</option>
                            <% stChannels.forEach(channel => { %>
                                <option value="<%= channel.id %>" data-kind="text">#<%= channel.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sticky-content">Message</label>
                        <p class="cf-row-desc" id="sticky-content-desc">Plain text with Discord formatting: **bold**, *italic*, links, and channel or role mentions such as &lt;#id&gt;. Mentions show as names but never ping anyone.</p>
                    </div>
                    <div class="cf-row-control">
                        <textarea id="sticky-content" name="message_content" class="form-control" rows="5" maxlength="2000" placeholder="Read the pinned rules before posting." required aria-describedby="sticky-content-desc"></textarea>
                    </div>
                </div>
                <div class="cf-row cf-row--stack st-preview-row">
                    <div class="cf-row-text">
                        <span class="cf-row-label" id="cfk-st-preview-title">Preview</span>
                    </div>
                    <div class="cf-row-control">
                        <div id="cfk-st-preview" aria-labelledby="cfk-st-preview-title" aria-live="polite"></div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-status-line" id="cfk-st-form-error" role="status" aria-live="polite"></span>
                    <button type="button" class="btn btn-secondary" onclick="hideAddStickyForm()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="cfk-st-submit">Create sticky message</button>
                </div>
            </form>
        </div>
    </section>
    <section class="cf-section" aria-labelledby="sticky-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="sticky-list-title">Active sticky messages</h2>
                <p class="cf-section-desc">Deleting one stops the reposting; the last copy stays in the channel until someone removes it.</p>
            </div>
            <div class="cf-section-actions">
                <span class="cf-status-line" id="cfk-st-list-error" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-primary btn-sm sticky-add-btn" onclick="showAddStickyForm()">Add sticky message</button>
            </div>
        </header>
        <div class="cf-rows">
            <div id="sticky-list">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading sticky messages', text: null }) %>
            </div>
        </div>
    </section>

</div>

<script src="/js/cf-msgpreview.js"></script>
<script type="application/json" id="cfk-st-names"><%- JSON.stringify(stNames).replace(/</g, '\\u003c') %></script>
<script>
// Channels that already have a sticky message, from the last list load (channel id -> row).
var stickyByChannel = {};
var stickyNames = {};
try { stickyNames = JSON.parse(document.getElementById('cfk-st-names').textContent || '{}'); } catch (e) { stickyNames = {}; }

function stickyStatus(id, text, tone) {
    var box = document.getElementById(id);
    if (!box) return;
    box.textContent = text || '';
    box.className = 'cf-status-line' + (text && tone ? ' is-' + tone : '');
}

function stickyPreview() {
    var box = document.getElementById('cfk-st-preview');
    if (!box || !window.cfDiscordPreview) return;
    window.cfDiscordPreview.render(box, {
        content: document.getElementById('sticky-content').value,
        names: stickyNames,
        emptyText: 'Type a message to see it here.'
    });
}

function stickySyncForm() {
    // Say when saving will replace a channel's current sticky message.
    var select = document.getElementById('sticky-channel');
    var editing = !!stickyByChannel[select.value];
    document.getElementById('add-sticky-card-title').textContent = editing ? 'Edit sticky message' : 'New sticky message';
    document.getElementById('cfk-st-submit').textContent = editing ? 'Save sticky message' : 'Create sticky message';
}

function showAddStickyForm(channelId) {
    var form = document.getElementById('sticky-form');
    form.reset();
    stickyStatus('cfk-st-form-error', '');
    if (typeof channelId === 'string' && stickyByChannel[channelId]) {
        document.getElementById('sticky-channel').value = channelId;
        document.getElementById('sticky-content').value = stickyByChannel[channelId].message_content || '';
    }
    document.getElementById('add-sticky-card').hidden = false;
    stickySyncForm();
    stickyPreview();
    document.getElementById('sticky-content').dispatchEvent(new Event('input'));
    document.getElementById('add-sticky-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
    document.getElementById('sticky-content').focus();
}

function hideAddStickyForm() {
    document.getElementById('add-sticky-card').hidden = true;
    document.getElementById('sticky-form').reset();
}

// Kit markup (cf-settings.css), built with createElement/textContent. Discord.channel() returns
// escaped markup (public/js/discord-mentions.js), so it is parsed as a fragment, never as text.
function stickyEl(tag, cls, text) {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
}

function stickyState(kind, title, text, button) {
    const box = stickyEl('div', 'cf-state' + (kind === 'error' ? ' cf-state--error' : ''));
    if (kind === 'error') box.setAttribute('role', 'alert');
    box.append(stickyEl('p', 'cf-state-title', title), stickyEl('p', 'cf-state-text', text));
    if (button) box.append(button);
    return box;
}

function stickyItem(sticky) {
    const createdDate = new Date(sticky.created_at);
    const item = stickyEl('div', 'sticky-item cf-list-item cf-list-item--multi');
    const main = stickyEl('div', 'cf-list-main');
    const title = stickyEl('p', 'cf-list-title');
    const name = stickyNames.channels && stickyNames.channels[sticky.channel_id];
    if (name) title.textContent = '#' + name;
    else if (window.Discord) title.append(document.createRange().createContextualFragment(Discord.channel(sticky.channel_id)));
    else title.textContent = 'Channel ' + sticky.channel_id;
    if (!name) title.append(stickyEl('span', 'cf-pill is-bad', 'Channel not found'));
    const meta = stickyEl('p', 'cf-list-meta');
    const by = stickyEl('span', null, 'Added by ');
    if (sticky.created_by && /^\d{15,25}$/.test(sticky.created_by)) {
        const who = stickyEl('span', null, sticky.created_by);
        who.setAttribute('data-user-id', sticky.created_by);
        by.append(who);
    } else by.append(sticky.created_by || 'unknown');
    meta.append(by,
        stickyEl('span', null, isNaN(createdDate) ? '' : createdDate.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' })),
        stickyEl('span', null, (sticky.message_content || '').length + ' characters'));
    main.append(title, stickyEl('div', 'sticky-content', sticky.message_content), meta);
    const actions = stickyEl('div', 'cf-list-actions');
    const edit = stickyEl('button', 'btn btn-sm btn-secondary', 'Edit');
    edit.type = 'button';
    edit.addEventListener('click', () => showAddStickyForm(sticky.channel_id));
    const del = stickyEl('button', 'btn btn-sm btn-danger', 'Delete');
    del.type = 'button';
    del.addEventListener('click', () => deleteStickyMessage(sticky.channel_id));
    actions.append(edit, del);
    item.append(main, actions);
    return item;
}

async function loadStickyMessages() {
    const list = document.getElementById('sticky-list');
    const heading = document.getElementById('sticky-list-title');
    try {
        const response = await fetch('/manage/<%= guild.id %>/sticky', { credentials: 'same-origin' });
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const data = await response.json();
        const stickies = Array.isArray(data.stickyMessages) ? data.stickyMessages : [];
        stickyByChannel = {};
        stickies.forEach(s => { stickyByChannel[s.channel_id] = s; });
        heading.textContent = stickies.length ? 'Active sticky messages (' + stickies.length + ')' : 'Active sticky messages';
        if (stickies.length) list.replaceChildren(...stickies.map(stickyItem));
        else {
            const add = stickyEl('button', 'btn btn-primary', 'Add sticky message');
            add.type = 'button';
            add.addEventListener('click', () => showAddStickyForm());
            list.replaceChildren(stickyState('empty', 'No sticky messages yet', 'Keep rules or a how-to at the bottom of a busy channel.', add));
        }
        // Mark channels that already have one in the picker.
        Array.prototype.forEach.call(document.getElementById('sticky-channel').options, o => {
            if (!o.value) return;
            if (!o.dataset.name) o.dataset.name = o.textContent;
            o.textContent = o.dataset.name + (stickyByChannel[o.value] ? ' (has one)' : '');
        });
        stickySyncForm();
    } catch (error) {
        console.error('Error loading sticky messages:', error);
        list.replaceChildren(stickyState('error', 'Could not load sticky messages', 'Refresh the page to try again.'));
    }
}

async function createStickyMessage(event) {
    event.preventDefault();
    const formData = new FormData(event.target);

    const sticky = {
        channel_id: formData.get('channel_id'),
        message_content: formData.get('message_content')
    };
    if (!String(sticky.message_content || '').trim()) {
        stickyStatus('cfk-st-form-error', 'Write the message first.', 'bad');
        return;
    }
    const button = document.getElementById('cfk-st-submit');
    button.disabled = true;
    stickyStatus('cfk-st-form-error', 'Saving', 'busy');
    try {
        const response = await fetch('/manage/<%= guild.id %>/sticky', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify(sticky)
        });
        const data = await response.json().catch(() => ({}));
        if (response.ok) {
            hideAddStickyForm();
            stickyStatus('cfk-st-list-error', 'Saved. It appears after the next message in the channel.', 'ok');
            loadStickyMessages();
        } else {
            stickyStatus('cfk-st-form-error', data.error || 'Could not save the sticky message.', 'bad');
        }
    } catch (error) {
        console.error('Error creating sticky message:', error);
        stickyStatus('cfk-st-form-error', 'Could not reach the dashboard. Try again.', 'bad');
    }
    button.disabled = false;
}

async function deleteStickyMessage(channelId) {
    if (!confirm('Delete this sticky message? The bot stops reposting it.')) {
        return;
    }

    try {
        const response = await fetch(`/manage/<%= guild.id %>/sticky/${encodeURIComponent(channelId)}`, {
            method: 'DELETE',
            credentials: 'same-origin'
        });

        if (response.ok) {
            stickyStatus('cfk-st-list-error', 'Deleted.', 'ok');
            loadStickyMessages();
        } else {
            stickyStatus('cfk-st-list-error', 'Could not delete it. Try again.', 'bad');
        }
    } catch (error) {
        console.error('Error deleting sticky message:', error);
        stickyStatus('cfk-st-list-error', 'Could not reach the dashboard. Try again.', 'bad');
    }
}

document.getElementById('sticky-content').addEventListener('input', stickyPreview);
document.getElementById('sticky-channel').addEventListener('change', stickySyncForm);
loadStickyMessages();
</script>
