<%
// Server backups: create a snapshot, restore or delete one, and compare one with the server as it
// is now (the compare dialog). Built on the settings-row kit (cf-settings.css). Restore (H-801, 2026-11-20)
// opens a preview dialog (GET /api/guilds/:id/backup-restore-preview), posts the confirmed plan's hash to
// /manage/:id/restore-backup and shows progress (backup-restore-status) with Resume; create and delete
// are plain forms (dashboard/routes/features/backups.js).
const bkList = (typeof backups !== 'undefined' && Array.isArray(backups)) ? backups.slice().sort((a, b) => new Date(b.created_at) - new Date(a.created_at)) : [];
const bkNow = Date.now();
const bkAge = (d) => {
    const days = Math.floor((bkNow - new Date(d).getTime()) / 86400000);
    return days <= 0 ? 'Today' : days === 1 ? 'Yesterday' : days < 60 ? `${days} days ago` : `${Math.round(days / 30)} months ago`;
};
const bkBy = (id) => {
    if (!id) return null;
    const m = guild && guild.members && guild.members.cache && typeof guild.members.cache.get === 'function' ? guild.members.cache.get(String(id)) : null;
    return m ? (m.displayName || (m.user && m.user.username)) : null;
};
%>
<style>
    .bk-list .cf-list-actions form { display: inline-flex; margin: 0; }
    .bk-list .cf-list-item[hidden] { display: none; }
    .diff-overlay { display: none; }
    .diff-overlay.active { display: flex; }
    .diff-modal { --cf-modal-w: 40rem; }
    .diff-body { font-size: var(--cf-text-sm); color: var(--cf-text-2); }
    .diff-section + .diff-section { margin-top: var(--cf-4); }
    .diff-section-title { margin: 0 0 var(--cf-2); font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); }
    .diff-item { padding: 6px 10px; border-radius: var(--cf-radius-sm); font-size: var(--cf-text-sm); overflow-wrap: anywhere; }
    .diff-item + .diff-item { margin-top: 4px; }
    .diff-added { color: var(--cf-success); background: color-mix(in srgb, var(--cf-success) 10%, transparent); }
    .diff-removed { color: var(--cf-danger); background: color-mix(in srgb, var(--cf-danger) 10%, transparent); }
    .diff-changed { color: var(--cf-warning); background: color-mix(in srgb, var(--cf-warning) 10%, transparent); }
    .diff-summary { justify-content: flex-start; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .diff-summary:empty { display: none; }
    .rs-opts { display: grid; gap: var(--cf-2); margin-bottom: var(--cf-4); }
    .rs-opts label { display: flex; gap: var(--cf-2); align-items: flex-start; font-size: var(--cf-text-sm); color: var(--cf-text-2); }
    .rs-opts input { margin-top: 3px; }
    .rs-foot { justify-content: flex-end; gap: var(--cf-2); }
    .rs-foot .rs-status { margin-right: auto; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .diff-item.diff-note { color: var(--cf-text-2); background: color-mix(in srgb, var(--cf-text-3) 10%, transparent); }
    .bk-run { margin: 0 0 var(--cf-4); padding: var(--cf-3) var(--cf-4); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-sm); }
    .bk-run[hidden] { display: none; }
    .bk-run-title { margin: 0 0 var(--cf-2); font-size: var(--cf-text-sm); font-weight: 600; color: var(--cf-text-1); }
    .bk-run-bar { height: 6px; border-radius: 3px; background: color-mix(in srgb, var(--cf-text-3) 20%, transparent); overflow: hidden; }
    .bk-run-bar span { display: block; height: 100%; width: 0; background: var(--cf-accent, var(--cf-success)); transition: width .3s; }
    .bk-run-log { margin: var(--cf-2) 0 0; padding: 0; list-style: none; font-size: var(--cf-text-xs); color: var(--cf-text-3); max-height: 9rem; overflow: auto; overflow-wrap: anywhere; }
    .bk-run-actions:empty, .bk-run-actions button[hidden] { display: none; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-database"></i>
                <span>Server backups</span>
            </div>
            <div class="page-section-subtitle">Make one before big changes. A restore shows you what it will do first.</div>
        </div>
    </div>

    <% if (bkList.length) { %>
    <%- include('../kit/_kpis', { label: 'Backups at a glance', items: [
        { label: 'Backups', value: bkList.length },
        { label: 'Latest', value: bkAge(bkList[0].created_at), small: true },
    ] }) %>
    <% } %>

    <section class="cf-section" aria-labelledby="bk-create-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bk-create-title">Create a backup</h2>
                <p class="cf-section-desc">Saves roles, channels and categories with their permissions, server settings, emojis, stickers, webhooks, bans, every member's roles and all of the bot's settings for this server.</p>
            </div>
        </header>
        <form class="cf-rows" action="/manage/<%= guild.id %>/create-backup" method="POST">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-backups-snapshot_name">Name</label>
                    <p class="cf-row-desc" id="f-backups-snapshot_name-desc">Something you will recognise later, such as "Before the event".</p>
                </div>
                <div class="cf-row-control">
                    <input id="f-backups-snapshot_name" type="text" name="snapshot_name" class="form-control" required maxlength="100" placeholder="Before the event" aria-describedby="f-backups-snapshot_name-desc">
                </div>
            </div>
            <div class="cf-section-foot">
                <span class="cf-foot-note">Takes a few seconds on large servers.</span>
                <button type="submit" class="btn btn-primary">Create backup</button>
            </div>
        </form>
    </section>

    <section class="cf-section" aria-labelledby="bk-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bk-list-title">Saved backups<% if (bkList.length) { %> <span class="cf-chip"><%= bkList.length %></span><% } %></h2>
                <p class="cf-section-desc">Compare shows what changed since the backup. Restore first lists what it would create, change and delete; it re-creates what is missing and resets what changed, and removes nothing unless you tick "Also remove".</p>
            </div>
            <% if (bkList.length > 15) { %>
            <div class="cf-section-actions">
                <label class="cf-search">
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                    <span class="visually-hidden">Search backups</span>
                    <input type="search" class="form-control form-control-sm" id="bkSearch" placeholder="Search backups" autocomplete="off">
                </label>
            </div>
            <% } %>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="restore-grace-period">Give roles back to members who rejoin</label>
                    <p class="cf-row-desc" id="restore-grace-period-desc">After a restore, members who left and come back within this time get the roles they had in the backup.</p>
                </div>
                <div class="cf-row-control">
                    <select id="restore-grace-period" class="form-select" aria-describedby="restore-grace-period-desc">
                        <option value="7">For 7 days</option>
                        <option value="14">For 14 days</option>
                        <option value="30" selected>For 30 days</option>
                        <option value="60">For 60 days</option>
                        <option value="90">For 90 days</option>
                        <option value="0">Off</option>
                    </select>
                </div>
            </div>
            <div class="bk-run" id="bkRun" hidden aria-live="polite">
                <p class="bk-run-title" id="bkRunTitle"></p>
                <div class="bk-run-bar"><span id="bkRunBar"></span></div>
                <ul class="bk-run-log" id="bkRunLog"></ul>
                <div class="bk-run-actions"><button type="button" class="btn btn-sm btn-primary" id="bkRunResume" hidden>Resume restore</button></div>
            </div>
            <% if (bkList.length) { %>
            <div class="cf-list bk-list" id="bkList">
                <% bkList.forEach(function (backup) {
                    const created = new Date(backup.created_at);
                    const by = bkBy(backup.created_by_id);
                %>
                <div class="cf-list-item cf-list-item--multi" data-name="<%= String(backup.snapshot_name || '').toLowerCase() %>">
                    <div class="cf-list-main">
                        <p class="cf-list-title"><%= backup.snapshot_name %></p>
                        <p class="cf-list-meta">
                            <span title="<%= created.toISOString() %>"><%= created.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %> <%= created.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) %> UTC</span>
                            <span><%= bkAge(backup.created_at) %></span>
                            <% if (by) { %><span>by <%= by %></span><% } %>
                        </p>
                    </div>
                    <div class="cf-list-actions">
                        <button type="button" class="btn btn-sm btn-secondary" data-bk-compare="<%= backup.id %>">Compare</button>
                        <button type="button" class="btn btn-sm btn-secondary" data-bk-restore="<%= backup.id %>" data-name="<%= backup.snapshot_name %>">Restore…</button>
                        <form action="/manage/<%= guild.id %>/delete-backup" method="POST" class="bk-delete" data-name="<%= backup.snapshot_name %>">
                            <input type="hidden" name="backupId" value="<%= backup.id %>">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
            <div class="cf-state cf-state--compact" id="bkNoMatch" hidden><p class="cf-state-text">No backups match that search.</p></div>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No backups yet', text: 'Name one above and press Create backup.' }) %>
            <% } %>
        </div>
    </section>
</div>

<div class="diff-overlay cf-modal" id="diffOverlay" role="dialog" aria-modal="true" aria-labelledby="diffTitle">
    <div class="diff-modal cf-modal-dialog">
        <div class="cf-modal-head">
            <h3 class="cf-modal-title" id="diffTitle">Backup comparison</h3>
            <button type="button" class="cf-modal-close" id="diffClose" aria-label="Close">&times;</button>
        </div>
        <div class="diff-body cf-modal-body" id="diffBody"></div>
        <div class="diff-summary cf-modal-foot" id="diffSummary"></div>
    </div>
</div>

<div class="diff-overlay cf-modal" id="rsOverlay" role="dialog" aria-modal="true" aria-labelledby="rsTitle">
    <div class="diff-modal cf-modal-dialog">
        <div class="cf-modal-head">
            <h3 class="cf-modal-title" id="rsTitle">Restore preview</h3>
            <button type="button" class="cf-modal-close" id="rsClose" aria-label="Close">&times;</button>
        </div>
        <div class="diff-body cf-modal-body">
            <div class="rs-opts">
                <label><input type="checkbox" id="rsRemove"> <span>Also remove channels, categories and roles that are not in the backup. They are removed last, and only if everything before worked.</span></label>
                <label><input type="checkbox" id="rsConfig" checked> <span>Restore CertiFried's settings for this server from the backup. Settings added since the backup are kept unless "Also remove" is ticked.</span></label>
                <label><input type="checkbox" id="rsBans"> <span>Ban again the users who were banned in the backup and are not banned now.</span></label>
            </div>
            <div id="rsBody"></div>
        </div>
        <div class="cf-modal-foot rs-foot">
            <span class="rs-status" id="rsStatus"></span>
            <button type="button" class="btn btn-sm btn-secondary" id="rsCancel">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary" id="rsGo" disabled>Restore</button>
        </div>
    </div>
</div>

<script>
(function () {
    var gid = '<%= guild.id %>';
    var overlay = document.getElementById('diffOverlay');
    var lastFocus = null;

    // Restore: preview first (GET backup-restore-preview), then the run the admin confirmed (planHash), then progress.
    var rs = { overlay: document.getElementById('rsOverlay'), body: document.getElementById('rsBody'), go: document.getElementById('rsGo'),
        status: document.getElementById('rsStatus'), id: null, name: '', hash: null, last: null };
    function rsOpts() {
        return { removeExtras: document.getElementById('rsRemove').checked, restoreBotConfig: document.getElementById('rsConfig').checked, restoreBans: document.getElementById('rsBans').checked };
    }
    function rsSection(title, items, cls, limit) {
        if (!items || !items.length) return;
        var sec = document.createElement('div'); sec.className = 'diff-section';
        var t = document.createElement('div'); t.className = 'diff-section-title'; t.textContent = title + ' (' + items.length + ')'; sec.appendChild(t);
        items.slice(0, limit || 40).forEach(function (txt) { var el = document.createElement('div'); el.className = 'diff-item ' + cls; el.textContent = txt; sec.appendChild(el); });
        if (items.length > (limit || 40)) { var more = document.createElement('div'); more.className = 'diff-item diff-note'; more.textContent = '…and ' + (items.length - (limit || 40)) + ' more'; sec.appendChild(more); }
        rs.body.appendChild(sec);
    }
    async function rsPreview() {
        rs.hash = null; rs.go.disabled = true; rs.status.textContent = 'Working out what would change…';
        rs.body.textContent = '';
        var o = rsOpts();
        var q = '?removeExtras=' + (o.removeExtras ? 1 : 0) + '&restoreBotConfig=' + (o.restoreBotConfig ? 1 : 0) + '&restoreBans=' + (o.restoreBans ? 1 : 0);
        try {
            var resp = await fetch('/api/guilds/' + gid + '/backup-restore-preview/' + encodeURIComponent(rs.id) + q, { credentials: 'include' });
            var data = await resp.json();
            if (!data.success) throw new Error(data.error || 'Request failed');
            var s = data.summary;
            rs.body.textContent = '';
            rsSection('Will be created', s.create, 'diff-added');
            rsSection('Will be changed', s.update, 'diff-changed');
            rsSection('Will be deleted', s.remove, 'diff-removed');
            if (s.keptNotInBackup) {
                var kept = [].concat(s.keptNotInBackup.categories.map(function (n) { return 'Category ' + n; }), s.keptNotInBackup.channels.map(function (n) { return '#' + n; }), s.keptNotInBackup.roles.map(function (n) { return 'Role ' + n; }));
                rsSection('Not in the backup, kept', kept, 'diff-note', 20);
            }
            rsSection('Cannot be restored', s.skipped, 'diff-note');
            rsSection('Good to know', s.notes, 'diff-note');
            if (!s.counts.total) { var none = document.createElement('p'); none.textContent = 'The server already matches this backup. There is nothing to restore.'; rs.body.appendChild(none); }
            rs.hash = s.hash;
            rs.go.disabled = !s.counts.total || data.running;
            rs.go.className = 'btn btn-sm ' + (s.counts.deletes ? 'btn-danger' : 'btn-primary');
            rs.go.textContent = s.counts.deletes ? 'Restore and delete ' + s.counts.deletes : 'Restore';
            rs.status.textContent = data.running ? 'A restore is already running for this server.' : s.counts.total + ' step' + (s.counts.total === 1 ? '' : 's');
        } catch (err) {
            rs.status.textContent = '';
            rs.body.textContent = 'Could not build the preview: ' + err.message;
        }
    }
    function rsClose() { rs.overlay.classList.remove('active'); if (rs.last) rs.last.focus(); }
    document.querySelectorAll('[data-bk-restore]').forEach(function (b) {
        b.addEventListener('click', function () {
            rs.last = b; rs.id = b.getAttribute('data-bk-restore'); rs.name = b.dataset.name || '';
            document.getElementById('rsTitle').textContent = 'Restore "' + rs.name + '"?';
            document.getElementById('rsRemove').checked = false;
            rs.overlay.classList.add('active');
            document.getElementById('rsClose').focus();
            rsPreview();
        });
    });
    ['rsRemove', 'rsConfig', 'rsBans'].forEach(function (id) { document.getElementById(id).addEventListener('change', rsPreview); });
    document.getElementById('rsClose').addEventListener('click', rsClose);
    document.getElementById('rsCancel').addEventListener('click', rsClose);
    rs.overlay.addEventListener('click', function (e) { if (e.target === rs.overlay) rsClose(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && rs.overlay.classList.contains('active')) rsClose(); });
    async function rsPost(path, params) {
        var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        var resp = await fetch('/manage/' + gid + path, { method: 'POST', credentials: 'include', body: new URLSearchParams(params),
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json', 'X-CSRF-Token': csrf } });
        return resp.json();
    }
    rs.go.addEventListener('click', async function () {
        if (!rs.hash) return;
        var o = rsOpts();
        if (o.removeExtras && !confirm('Delete everything listed under "Will be deleted"? This cannot be undone.')) return;
        rs.go.disabled = true; rs.status.textContent = 'Starting…';
        var grace = document.getElementById('restore-grace-period');
        try {
            var data = await rsPost('/restore-backup', { backupId: rs.id, planHash: rs.hash, gracePeriod: grace ? grace.value : '30',
                removeExtras: o.removeExtras ? '1' : '0', restoreBotConfig: o.restoreBotConfig ? '1' : '0', restoreBans: o.restoreBans ? '1' : '0' });
            if (!data.success) {
                rs.status.textContent = data.error || 'The restore did not start.';
                if (data.summary) rsPreview();
                else rs.go.disabled = false;
                return;
            }
            rsClose();
            pollRun();
        } catch (err) { rs.status.textContent = 'The restore did not start: ' + err.message; rs.go.disabled = false; }
    });

    // Progress of the current or last restore; an interrupted or failed one can be resumed.
    var runTimer = null;
    var RUN_LABEL = { running: 'Restoring', done: 'Restore finished', done_with_errors: 'Restore finished with errors', failed: 'Restore stopped', interrupted: 'Restore interrupted (the bot restarted)' };
    async function pollRun() {
        clearTimeout(runTimer);
        try {
            var resp = await fetch('/api/guilds/' + gid + '/backup-restore-status', { credentials: 'include' });
            var data = await resp.json();
            var run = data && data.run;
            var box = document.getElementById('bkRun');
            if (!run) { box.hidden = true; return; }
            var stale = run.finishedAt && (Date.now() - new Date(run.finishedAt).getTime()) > 7 * 86400000;
            if (stale && run.status === 'done') { box.hidden = true; return; }
            box.hidden = false;
            document.getElementById('bkRunTitle').textContent = (RUN_LABEL[run.status] || run.status) + ': "' + run.backupName + '", ' + run.done + ' of ' + run.total + ' steps' + (run.failedCount ? ', ' + run.failedCount + ' failed' : '') + (run.error ? ' (' + run.error + ')' : '');
            document.getElementById('bkRunBar').style.width = (run.total ? Math.round(100 * run.done / run.total) : 0) + '%';
            var log = document.getElementById('bkRunLog'); log.textContent = '';
            run.failed.slice(-5).forEach(function (f) { var li = document.createElement('li'); li.textContent = 'Failed: ' + f.label + ': ' + f.error; log.appendChild(li); });
            run.log.slice(-8).forEach(function (l) { var li = document.createElement('li'); li.textContent = l; log.appendChild(li); });
            document.getElementById('bkRunResume').hidden = ['interrupted', 'failed', 'done_with_errors'].indexOf(run.status) === -1;
            if (run.status === 'running') runTimer = setTimeout(pollRun, 3000);
        } catch (err) { runTimer = setTimeout(pollRun, 10000); }
    }
    document.getElementById('bkRunResume').addEventListener('click', async function () {
        var btn = this; btn.disabled = true;
        try {
            var data = await rsPost('/restore-backup/resume', {});
            if (!data.success) alert(data.error || 'Could not resume.');
        } finally { btn.disabled = false; pollRun(); }
    });
    pollRun();

    document.querySelectorAll('form.bk-delete').forEach(function (f) {
        f.addEventListener('submit', function (e) {
            if (!confirm('Delete the backup "' + f.dataset.name + '"? This cannot be undone.')) e.preventDefault();
        }, true);
    });

    var search = document.getElementById('bkSearch');
    if (search) {
        search.addEventListener('input', function () {
            var q = search.value.trim().toLowerCase(), shown = 0;
            document.querySelectorAll('#bkList > .cf-list-item').forEach(function (row) {
                var hit = !q || (row.dataset.name || '').indexOf(q) !== -1;
                row.hidden = !hit;
                if (hit) shown++;
            });
            document.getElementById('bkNoMatch').hidden = shown !== 0;
        });
    }

    document.querySelectorAll('[data-bk-compare]').forEach(function (b) {
        b.addEventListener('click', function () { lastFocus = b; showDiff(gid, b.getAttribute('data-bk-compare')); });
    });
    document.getElementById('diffClose').addEventListener('click', closeDiff);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeDiff(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.classList.contains('active')) closeDiff(); });

    async function showDiff(guildId, backupId) {
        overlay.classList.add('active');
        document.getElementById('diffTitle').textContent = 'Backup comparison';
        document.getElementById('diffBody').textContent = 'Comparing with the server…';
        document.getElementById('diffSummary').textContent = '';
        document.getElementById('diffClose').focus();
        try {
            var resp = await fetch('/api/guilds/' + guildId + '/backup-diff/' + encodeURIComponent(backupId), { credentials: 'include' });
            var data = await resp.json();
            if (!data.success) throw new Error(data.error || 'Request failed');
            renderDiff(data.diff);
        } catch (err) {
            document.getElementById('diffBody').textContent = 'Could not compare: ' + err.message;
        }
    }
    function closeDiff() {
        overlay.classList.remove('active');
        if (lastFocus) lastFocus.focus();
    }
    function renderDiff(diff) {
        var body = document.getElementById('diffBody');
        var summary = document.getElementById('diffSummary');
        document.getElementById('diffTitle').textContent = 'Compared with ' + (diff.summary.backupName || 'the backup');
        if (diff.summary.identical) {
            body.textContent = 'The server matches this backup.';
            summary.textContent = 'No changes';
            return;
        }
        body.textContent = '';
        function addItems(title, items) {
            if (!items.length) return;
            var sec = document.createElement('div'); sec.className = 'diff-section';
            var t = document.createElement('div'); t.className = 'diff-section-title'; t.textContent = title + ' (' + items.length + ')'; sec.appendChild(t);
            items.forEach(function (item) {
                var el = document.createElement('div'); el.className = 'diff-item ' + item.c;
                el.textContent = item.t; sec.appendChild(el);
            });
            body.appendChild(sec);
        }
        var ri = [];
        diff.roles.removed.forEach(function (r) { ri.push({ c: 'diff-removed', t: 'Deleted since the backup: ' + r }); });
        diff.roles.added.forEach(function (r) { ri.push({ c: 'diff-added', t: 'New since the backup: ' + r }); });
        diff.roles.changed.forEach(function (r) { ri.push({ c: 'diff-changed', t: r.name + ': ' + r.changes.join(', ') }); });
        addItems('Roles', ri);
        var ci = [];
        diff.categories.removed.forEach(function (c) { ci.push({ c: 'diff-removed', t: 'Deleted since the backup: ' + c }); });
        diff.categories.added.forEach(function (c) { ci.push({ c: 'diff-added', t: 'New since the backup: ' + c }); });
        addItems('Categories', ci);
        var ch = [];
        diff.channels.removed.forEach(function (c) { ch.push({ c: 'diff-removed', t: 'Deleted since the backup: #' + c }); });
        diff.channels.added.forEach(function (c) { ch.push({ c: 'diff-added', t: 'New since the backup: #' + c }); });
        addItems('Channels', ch);
        var si = [];
        diff.settings.forEach(function (s) { si.push({ c: 'diff-changed', t: s }); });
        addItems('Server settings', si);
        var ei = [];
        if (diff.emojis.removed) ei.push({ c: 'diff-removed', t: diff.emojis.removed + (diff.emojis.removed === 1 ? ' emoji' : ' emojis') + ' deleted since the backup' });
        if (diff.emojis.added) ei.push({ c: 'diff-added', t: diff.emojis.added + (diff.emojis.added === 1 ? ' emoji' : ' emojis') + ' added since the backup' });
        addItems('Emojis', ei);
        var n = diff.summary.totalChanges;
        summary.textContent = n + (n === 1 ? ' difference' : ' differences') + ' · backup made ' + new Date(diff.summary.backupDate).toLocaleDateString();
    }
    window.showDiff = showDiff;
    window.closeDiff = closeDiff;
})();
</script>
