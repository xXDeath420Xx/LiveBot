<%
// CSV import and export of the server's streamers. Built on the settings-row kit (cf-settings.css).
// Import: POST /manage/:guildId/import-csv (multipart, field csvFile), sent with fetch so the page
// can list what was added, updated and skipped. Export: GET /manage/:guildId/export.
const csvStreamers = (typeof consolidatedStreamers !== 'undefined' && Array.isArray(consolidatedStreamers)) ? consolidatedStreamers : [];
%>
<style>
    .csv-sample { margin: 0; padding: var(--cf-3) var(--cf-4); overflow-x: auto; max-width: 100%;
        background: var(--cf-surface-2); border: 1px solid var(--cf-border); border-radius: var(--cf-radius);
        font-family: var(--cf-mono); font-size: var(--cf-text-sm); line-height: 1.6; color: var(--cf-text-2); white-space: pre; }
    .csv-cols { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px var(--cf-4); font-size: var(--cf-text-sm); color: var(--cf-text-2); }
    .csv-cols dt { margin: 0; font-family: var(--cf-mono); color: var(--cf-text); }
    .csv-cols dd { margin: 0; }
    @media (max-width: 640px) { .csv-cols { grid-template-columns: minmax(0, 1fr); } .csv-cols dd { margin-bottom: 6px; } }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-file-csv"></i>
                <span>CSV import and export</span>
            </div>
            <div class="page-section-subtitle">Streamers only. One row per streamer.</div>
        </div>
    </div>

    <%- include('../kit/_kpis', { label: 'Streamers at a glance', items: [
        { label: 'Streamers', value: csvStreamers.length },
        { label: 'Platforms', value: new Set(csvStreamers.flatMap(s => s.platforms || [])).size },
        { label: 'Subscriptions', value: csvStreamers.reduce((sum, s) => sum + ((s.subscriptions && s.subscriptions.length) || 0), 0) },
    ] }) %>

    <section class="cf-section" aria-labelledby="csv-import-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="csv-import-title">Import</h2>
                <p class="cf-section-desc">New streamers are added. For streamers already here, the channel, role and message in the file replace the current ones; empty cells leave them as they are. Up to 200 rows per file.</p>
            </div>
        </header>
        <form class="cf-rows" id="csvImportForm" action="/manage/<%= guild.id %>/import-csv" method="POST" enctype="multipart/form-data">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="csvFile">CSV file</label>
                    <p class="cf-row-desc" id="csvFile-desc">Needs <code>platform</code> and <code>username</code> columns. A file downloaded below imports as it is.</p>
                </div>
                <div class="cf-row-control">
                    <input class="form-control" type="file" name="csvFile" id="csvFile" accept=".csv,text/csv" required aria-describedby="csvFile-desc">
                </div>
            </div>
            <div class="cf-section-foot">
                <span class="cf-status-line cf-foot-note" id="csvStatus" role="status" aria-live="polite"></span>
                <button type="submit" class="btn btn-primary" id="csvImportBtn">Import</button>
            </div>
        </form>

        <div class="cf-rows" id="csvResult" hidden>
            <div class="cf-rows-head">Import result</div>
            <div class="cf-row cf-row--stack">
                <div class="cf-chips" id="csvResultCounts"></div>
            </div>
            <div class="cf-list" id="csvResultErrors"></div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="csv-export-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="csv-export-title">Export</h2>
                <p class="cf-section-desc">For a backup, to move streamers to another server, or to edit them in a spreadsheet.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <span class="cf-row-label">Streamers file</span>
                    <p class="cf-row-desc">Username, platform, announcement channel, live role, custom message and linked Discord user for each streamer.</p>
                </div>
                <div class="cf-row-control">
                    <a href="/manage/<%= guild.id %>/export" class="btn btn-secondary" download>Download CSV</a>
                </div>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="csv-format-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="csv-format-title">File format</h2>
                <p class="cf-section-desc">A header row, then one streamer per line. Leave a cell empty to skip it, but keep the commas.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <dl class="csv-cols">
                    <dt>platform</dt><dd>twitch, youtube, kick, tiktok or rumble. Required.</dd>
                    <dt>username</dt><dd>The channel name. For YouTube, the channel ID (starts with UC). Required.</dd>
                    <dt>discord_user_id</dt><dd>The streamer's Discord user ID, to link them.</dd>
                    <dt>announcement_channel_id</dt><dd>The channel ID live alerts go to.</dd>
                    <dt>live_role_id</dt><dd>A role given while they are live.</dd>
                    <dt>custom_message</dt><dd>The alert text for this streamer.</dd>
                </dl>
            </div>
            <div class="cf-row cf-row--stack">
                <pre class="csv-sample" aria-label="Example CSV file">platform,username,discord_user_id,announcement_channel_id
twitch,example_streamer,123456789012345678,987654321098765432
youtube,UCxxxxxxxxxxxxxxxxxxxxxx,,987654321098765432
kick,cool_gamer,456789012345678901,</pre>
            </div>
        </div>
    </section>
</div>

<script>
(function () {
    var form = document.getElementById('csvImportForm');
    var input = document.getElementById('csvFile');
    var btn = document.getElementById('csvImportBtn');
    var status = document.getElementById('csvStatus');
    var result = document.getElementById('csvResult');
    var counts = document.getElementById('csvResultCounts');
    var errors = document.getElementById('csvResultErrors');
    if (!form || !input) return;

    function setStatus(text, tone) {
        status.textContent = text || '';
        status.className = 'cf-status-line cf-foot-note' + (tone ? ' is-' + tone : '');
    }
    function chip(text, tone) {
        var c = document.createElement('span');
        c.className = 'cf-chip' + (tone ? ' is-' + tone : '');
        c.textContent = text;
        return c;
    }

    input.addEventListener('change', function () {
        var f = input.files && input.files[0];
        setStatus('');
        if (f && !/\.csv$/i.test(f.name)) {
            setStatus('Choose a .csv file.', 'bad');
            input.value = '';
        }
    });

    form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var f = input.files && input.files[0];
        if (!f) { setStatus('Choose a CSV file first.', 'bad'); return; }
        btn.disabled = true;
        setStatus('Importing. Each streamer is looked up on its platform, so this can take a minute.', 'busy');
        result.hidden = true;
        try {
            var resp = await fetch(form.getAttribute('action'), {
                method: 'POST',
                body: new FormData(form),
                credentials: 'include',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            var data = await resp.json().catch(function () { return { success: false, error: 'Request failed (status ' + resp.status + ')' }; });
            if (!data.success) { setStatus(data.error || 'The import failed.', 'bad'); return; }

            counts.textContent = '';
            counts.appendChild(chip(data.added + ' added', data.added ? 'ok' : ''));
            counts.appendChild(chip(data.updated + ' updated', data.updated ? 'info' : ''));
            counts.appendChild(chip(data.skipped + ' unchanged', ''));
            if (data.errors.length) counts.appendChild(chip(data.errors.length + ' not imported', 'bad'));
            if (data.truncated) counts.appendChild(chip('Rows after 200 were not read', 'warn'));

            errors.textContent = '';
            data.errors.slice(0, 100).forEach(function (er) {
                var item = document.createElement('div');
                item.className = 'cf-list-item';
                var main = document.createElement('div');
                main.className = 'cf-list-main';
                var line = document.createElement('span');
                line.className = 'cf-em';
                line.textContent = 'Line ' + er.line + ': ';
                main.appendChild(line);
                main.appendChild(document.createTextNode(er.reason));
                item.appendChild(main);
                errors.appendChild(item);
            });
            result.hidden = false;
            setStatus(data.added || data.updated ? 'Imported. Reload the page to see the new totals.' : 'Done.', 'ok');
            input.value = '';
        } catch (err) {
            setStatus('Network error: ' + err.message, 'bad');
        } finally {
            btn.disabled = false;
        }
    });
})();
</script>
