<%
    // Rows come from core/trade-manager.js loadTradingPageData(): *_items are arrays of labels
    // ("2x Sword (ID 12)", "Card #45"); older shapes passed a comma-separated string.
    const tradeItemList = (v) => Array.isArray(v) ? v : (v ? String(v).split(',').map(x => x.trim()).filter(Boolean) : []);
    const tradeCoins = (v) => Number(v) || 0;
    const tradeWho = (name, id) => name ? name : id;
    const tdCap = (v) => { const t = String(v == null ? '' : v); return t.charAt(0).toUpperCase() + t.slice(1); };
    const tdHistoryTone = { completed: 'is-ok', cancelled: 'is-bad', declined: 'is-warn' };
%>
<%# Built on the settings-row kit (cf-settings.css); field names and routes are unchanged. %>
<%- include('_game-kit') %>
<style>
    .td-id { font-family: var(--cf-mono); font-size: var(--cf-text-xs); color: var(--cf-text-2); }
    .td-who { color: var(--cf-text); overflow-wrap: anywhere; }
    .td-sub { display: block; margin-top: 2px; font-size: var(--cf-text-xs); color: var(--cf-text-3); }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-exchange-alt"></i>
                <span>Trading</span>
            </div>
            <div class="page-section-subtitle">Offers made with <code>/economy trade offer</code> and card swaps from <code>/games trade</code>.</div>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="Trading at a glance">
        <div class="cf-kpi"><dt>Active</dt><dd class="cf-kpi-value"><%= tradeStats?.active_trades || 0 %></dd></div>
        <div class="cf-kpi"><dt>Completed</dt><dd class="cf-kpi-value"><%= tradeStats?.completed_trades || 0 %></dd></div>
        <div class="cf-kpi"><dt>Cancelled</dt><dd class="cf-kpi-value"><%= tradeStats?.cancelled_trades || 0 %></dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="td-active-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="td-active-title">Active trades <span class="gk-cmd-count"><%= (activeTrades || []).length || '' %></span></h2>
                <p class="cf-section-desc">Offers still waiting on one side. Nothing is held while an offer is open, so cancelling one closes it for both members with nothing to return.</p>
            </div>
        </header>
        <div class="cf-rows">
        <% if (activeTrades && activeTrades.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Trade</th>
                            <th scope="col">From</th>
                            <th scope="col">To</th>
                            <th scope="col">Offered</th>
                            <th scope="col">Asked for</th>
                            <th scope="col">Status</th>
                            <th scope="col">Created</th>
                            <th scope="col"><span class="visually-hidden">Cancel</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% activeTrades.forEach(trade => { %>
                            <tr>
                                <td data-label="Trade"><span class="td-id">#<%= trade.trade_id %></span></td>
                                <td data-label="From"><span class="td-who" title="<%= trade.initiator_id %>"><%= tradeWho(trade.initiator_name, trade.initiator_id) %></span></td>
                                <td data-label="To"><span class="td-who" title="<%= trade.partner_id %>"><%= tradeWho(trade.partner_name, trade.partner_id) %></span></td>
                                <td data-label="Offered">
                                    <div class="cf-chips">
                                        <% const initiatorItems = tradeItemList(trade.initiator_items); %>
                                        <% if (tradeCoins(trade.initiator_currency) > 0) { %>
                                            <span class="cf-pill is-warn"><%= tradeCoins(trade.initiator_currency).toLocaleString() %> coins</span>
                                        <% } %>
                                        <% initiatorItems.slice(0, 4).forEach(label => { %>
                                            <span class="cf-pill"><%= label %></span>
                                        <% }); %>
                                        <% if (initiatorItems.length > 4) { %>
                                            <span class="cf-pill">+<%= initiatorItems.length - 4 %> more</span>
                                        <% } %>
                                        <% if (!tradeCoins(trade.initiator_currency) && !initiatorItems.length) { %>
                                            <span class="cf-cell-muted">Nothing</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="Asked for">
                                    <div class="cf-chips">
                                        <% const partnerItems = tradeItemList(trade.partner_items); %>
                                        <% if (tradeCoins(trade.partner_currency) > 0) { %>
                                            <span class="cf-pill is-warn"><%= tradeCoins(trade.partner_currency).toLocaleString() %> coins</span>
                                        <% } %>
                                        <% partnerItems.slice(0, 4).forEach(label => { %>
                                            <span class="cf-pill"><%= label %></span>
                                        <% }); %>
                                        <% if (partnerItems.length > 4) { %>
                                            <span class="cf-pill">+<%= partnerItems.length - 4 %> more</span>
                                        <% } %>
                                        <% if (!tradeCoins(trade.partner_currency) && !partnerItems.length) { %>
                                            <span class="cf-cell-muted">Nothing</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="Status">
                                    <div>
                                    <% if (trade.status === 'pending') { %>
                                        <span class="cf-pill is-warn">Pending</span>
                                        <% if (trade.awaiting_id) { %>
                                            <span class="td-sub">Waiting on <%= trade.awaiting_id === trade.initiator_id ? tradeWho(trade.initiator_name, trade.initiator_id) : tradeWho(trade.partner_name, trade.partner_id) %></span>
                                        <% } %>
                                    <% } else if (trade.status === 'accepted') { %>
                                        <span class="cf-pill is-ok">Accepted</span>
                                    <% } else { %>
                                        <span class="cf-pill"><%= tdCap(trade.status) %></span>
                                    <% } %>
                                    </div>
                                </td>
                                <td data-label="Created" class="cf-cell-muted"><%= new Date(trade.created_at).toLocaleString() %></td>
                                <td class="cf-cell-end">
                                    <form action="/manage/<%= guild.id %>/trading/cancel" method="POST">
                                        <input type="hidden" name="trade_id" value="<%= trade.trade_id %>">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Cancel this trade?')">Cancel trade</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No active trades', text: 'Trades in progress will be listed here.', id: null, boxed: false, compact: false }) %>
        <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="td-history-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="td-history-title">Trade history</h2>
                <p class="cf-section-desc">The last 50 trades that finished.</p>
            </div>
            <% if (tradeHistory && tradeHistory.length > 15) { %>
            <div class="cf-section-actions">
                <label class="cf-search"><i class="fas fa-search" aria-hidden="true"></i><input type="search" class="form-control" id="td-search" placeholder="Search by member or item" aria-label="Search trade history" data-no-savebar autocomplete="off"></label>
            </div>
            <% } %>
        </header>
        <div class="cf-rows">
        <% if (tradeHistory && tradeHistory.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr>
                            <th scope="col">Trade</th>
                            <th scope="col">From</th>
                            <th scope="col">To</th>
                            <th scope="col">From gave</th>
                            <th scope="col">To gave</th>
                            <th scope="col">Status</th>
                            <th scope="col">Finished</th>
                        </tr>
                    </thead>
                    <tbody id="td-history-body">
                        <% tradeHistory.forEach(trade => { %>
                            <tr data-td-text="<%= [trade.trade_id, trade.initiator_name, trade.partner_name, trade.status].concat(tradeItemList(trade.initiator_items), tradeItemList(trade.partner_items)).filter(Boolean).join(' ').toLowerCase() %>">
                                <td data-label="Trade"><span class="td-id">#<%= trade.trade_id %></span></td>
                                <td data-label="From"><span class="td-who" title="<%= trade.initiator_id %>"><%= tradeWho(trade.initiator_name, trade.initiator_id) %></span></td>
                                <td data-label="To"><span class="td-who" title="<%= trade.partner_id %>"><%= tradeWho(trade.partner_name, trade.partner_id) %></span></td>
                                <td data-label="From gave">
                                    <div>
                                        <% const initiatorGave = tradeItemList(trade.initiator_items); %>
                                        <% if (tradeCoins(trade.initiator_currency) > 0) { %>
                                            <span><%= tradeCoins(trade.initiator_currency).toLocaleString() %> coins</span>
                                        <% } %>
                                        <% if (initiatorGave.length > 0) { %>
                                            <% if (tradeCoins(trade.initiator_currency) > 0) { %> + <% } %>
                                            <span title="<%= initiatorGave.join(', ') %>"><%= initiatorGave.length <= 2 ? initiatorGave.join(', ') : initiatorGave.length + ' items' %></span>
                                        <% } %>
                                        <% if (!tradeCoins(trade.initiator_currency) && !initiatorGave.length) { %>
                                            <span class="cf-cell-muted">Nothing</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="To gave">
                                    <div>
                                        <% const partnerGave = tradeItemList(trade.partner_items); %>
                                        <% if (tradeCoins(trade.partner_currency) > 0) { %>
                                            <span><%= tradeCoins(trade.partner_currency).toLocaleString() %> coins</span>
                                        <% } %>
                                        <% if (partnerGave.length > 0) { %>
                                            <% if (tradeCoins(trade.partner_currency) > 0) { %> + <% } %>
                                            <span title="<%= partnerGave.join(', ') %>"><%= partnerGave.length <= 2 ? partnerGave.join(', ') : partnerGave.length + ' items' %></span>
                                        <% } %>
                                        <% if (!tradeCoins(trade.partner_currency) && !partnerGave.length) { %>
                                            <span class="cf-cell-muted">Nothing</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="Status"><span class="cf-pill <%= tdHistoryTone[trade.status] || '' %>"><%= tdCap(trade.status) %></span></td>
                                <td data-label="Finished" class="cf-cell-muted"><%= new Date(trade.completed_at || trade.updated_at || trade.created_at).toLocaleString() %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <div class="cf-state cf-state--compact" id="td-none" hidden><p class="cf-state-text">No trades match.</p></div>
        <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No trade history yet', text: 'Completed, cancelled, declined and expired trades will be listed here.', id: null, boxed: false, compact: false }) %>
        <% } %>
        </div>
    </section>

    <%- include('_game-commands', { gkCommands: [{ cmd: 'economy', groups: ['trade'] }], gkCmdNote: 'Card swaps use /games trade, part of the card collection game.' }) %>
</div>
<script>
(function () {
    var input = document.getElementById('td-search');
    if (!input) return;
    input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase(), shown = 0;
        document.querySelectorAll('#td-history-body > tr').forEach(function (tr) {
            var hit = !q || tr.getAttribute('data-td-text').indexOf(q) !== -1;
            tr.hidden = !hit;
            if (hit) shown++;
        });
        document.getElementById('td-none').hidden = shown > 0;
    });
})();
</script>
