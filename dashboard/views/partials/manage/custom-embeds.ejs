<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-newspaper"></i>
                <span>Custom Embeds</span>
            </div>
            <div class="page-section-subtitle">
                Create and post rich embed messages to any channel
            </div>
        </div>
    </div>

    <!-- Existing embeds -->
    <% const embedList = typeof customEmbeds !== 'undefined' ? customEmbeds : []; %>
    <% if (embedList.length > 0) { %>
    <div style="margin-bottom: var(--spacing-6);">
        <h3 style="font-size: var(--font-size-base); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-3);">
            Embeds (<%= embedList.length %>)
        </h3>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <% embedList.forEach(emb => { %>
            <details style="background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-md); border-left: 4px solid <%= emb.color || '#a78bfa' %>;">
                <summary style="display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-3) var(--spacing-4); cursor: pointer; list-style: none;">
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary); font-size: var(--font-size-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <%= emb.title || 'Untitled' %>
                        </div>
                        <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); margin-top: 2px;">
                            <% const ch = channels.find(c => c.id === emb.channel_id); %>
                            #<%= ch ? ch.name : emb.channel_id %> &middot;
                            <% if (emb.message_id) { %>
                                <span style="color: var(--accent-green);">Posted</span>
                            <% } else { %>
                                <span style="color: var(--color-warning);">Draft</span>
                            <% } %>
                            &middot; <%= new Date(emb.created_at).toLocaleDateString() %>
                        </div>
                    </div>
                    <div style="display: flex; gap: 6px; flex-shrink: 0; margin-left: var(--spacing-3);">
                        <button type="button" style="background: rgba(167,139,250,0.15); border: 1px solid rgba(167,139,250,0.3); border-radius: var(--radius-md); padding: 6px 12px; color: #a78bfa; cursor: pointer; font-size: 0.75rem;" onclick="event.stopPropagation(); this.closest('details').open = !this.closest('details').open;">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <% if (!emb.message_id) { %>
                        <button type="button" class="ce-post-btn btn btn-primary" data-id="<%= emb.id %>" style="padding: 6px 12px; font-size: 0.75rem;" onclick="event.stopPropagation();">
                            <i class="fas fa-paper-plane"></i> Post
                        </button>
                        <% } %>
                        <form action="/manage/<%= guild.id %>/delete-custom-embed" method="POST" style="display: inline;" onsubmit="event.stopPropagation(); return confirm('Delete this embed and its Discord message?')">
                            <input type="hidden" name="embedId" value="<%= emb.id %>">
                            <button type="submit" style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius-md); padding: 6px 12px; color: #f87171; cursor: pointer; font-size: 0.75rem;">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </summary>
                <!-- Expand: preview + edit form -->
                <div style="padding: 0 var(--spacing-4) var(--spacing-4); border-top: 1px solid var(--color-dark-400);">
                    <!-- Preview -->
                    <div style="margin: var(--spacing-3) 0; padding: var(--spacing-3); background: var(--color-dark-700); border-radius: var(--radius-sm); border-left: 4px solid <%= emb.color || '#a78bfa' %>;">
                        <% if (emb.author_name) { %>
                        <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                            <% if (emb.author_icon_url) { %><img src="<%= emb.author_icon_url %>" style="width: 16px; height: 16px; border-radius: 50%;"><% } %>
                            <%= emb.author_name %>
                        </div>
                        <% } %>
                        <% if (emb.title) { %>
                        <div style="font-weight: var(--font-weight-bold); color: var(--accent-purple); font-size: var(--font-size-sm); margin-bottom: 4px;"><%= emb.title %></div>
                        <% } %>
                        <% if (emb.description) { %>
                        <div style="font-size: var(--font-size-xs); color: var(--color-text-secondary); line-height: 1.5; white-space: pre-wrap; word-break: break-word;"><%= emb.description %></div>
                        <% } %>
                        <% if (emb.image_url) { %>
                        <img src="<%= emb.image_url %>" style="max-width: 200px; max-height: 100px; border-radius: var(--radius-sm); margin-top: 6px;">
                        <% } %>
                        <% if (emb.footer_text) { %>
                        <div style="font-size: 0.65rem; color: var(--color-text-muted); margin-top: 6px;"><%= emb.footer_text %></div>
                        <% } %>
                    </div>
                    <!-- Edit form -->
                    <form action="/manage/<%= guild.id %>/edit-custom-embed" method="POST">
                        <input type="hidden" name="embedId" value="<%= emb.id %>">
                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px; margin-bottom: 8px;">
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Channel</label>
                                <select name="channel_id" class="form-select" style="font-size: 0.75rem; padding: 4px 8px;">
                                    <% channels.forEach(c => { %>
                                    <option value="<%= c.id %>" <%= c.id === emb.channel_id ? 'selected' : '' %>>#<%= c.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Color</label>
                                <input type="color" name="color" value="<%= emb.color || '#a78bfa' %>" style="width: 100%; height: 30px; cursor: pointer; border-radius: 4px;">
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px; margin-bottom: 8px;">
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Title</label>
                                <input type="text" name="title" class="form-control" value="<%= emb.title || '' %>" style="font-size: 0.75rem; padding: 4px 8px;" maxlength="256">
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Title URL</label>
                                <input type="text" name="url" class="form-control" value="<%= emb.url || '' %>" style="font-size: 0.75rem; padding: 4px 8px;">
                            </div>
                        </div>
                        <div style="margin-bottom: 8px;">
                            <label class="form-label" style="font-size: 0.7rem;">Description</label>
                            <textarea name="description" class="form-control" rows="3" style="font-size: 0.75rem; padding: 4px 8px; resize: vertical;"><%= emb.description || '' %></textarea>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Author Name</label>
                                <input type="text" name="author_name" class="form-control" value="<%= emb.author_name || '' %>" style="font-size: 0.75rem; padding: 4px 8px;" maxlength="256">
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Author Icon URL</label>
                                <input type="text" name="author_icon_url" class="form-control" value="<%= emb.author_icon_url || '' %>" style="font-size: 0.75rem; padding: 4px 8px;">
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Thumbnail URL</label>
                                <input type="text" name="thumbnail_url" class="form-control" value="<%= emb.thumbnail_url || '' %>" style="font-size: 0.75rem; padding: 4px 8px;">
                            </div>
                            <div>
                                <label class="form-label" style="font-size: 0.7rem;">Image URL</label>
                                <input type="text" name="image_url" class="form-control" value="<%= emb.image_url || '' %>" style="font-size: 0.75rem; padding: 4px 8px;">
                            </div>
                        </div>
                        <div style="margin-bottom: 8px;">
                            <label class="form-label" style="font-size: 0.7rem;">Footer Text</label>
                            <input type="text" name="footer_text" class="form-control" value="<%= emb.footer_text || '' %>" style="font-size: 0.75rem; padding: 4px 8px;">
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button type="submit" name="action" value="save" class="btn btn-primary" style="font-size: 0.75rem; padding: 6px 14px;">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <% if (emb.message_id) { %>
                            <button type="submit" name="action" value="update_discord" class="btn btn-secondary" style="font-size: 0.75rem; padding: 6px 14px;">
                                <i class="fas fa-sync"></i> Save & Update Discord Message
                            </button>
                            <% } %>
                        </div>
                    </form>
                </div>
            </details>
            <% }); %>
        </div>
    </div>
    <% } %>

    <!-- Create new embed -->
    <div style="background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-lg); padding: var(--spacing-6);">
        <h3 style="font-size: var(--font-size-base); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-4);">
            <i class="fas fa-plus" style="color: var(--accent-purple); margin-right: var(--spacing-2);"></i>
            Create Embed
        </h3>

        <div id="ce-error" style="display: none; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: var(--radius-md); padding: var(--spacing-3); margin-bottom: var(--spacing-4); color: var(--color-danger); font-size: var(--font-size-sm);"></div>

        <form action="/manage/<%= guild.id %>/create-custom-embed" method="POST">
            <!-- Row 1: Channel + Color -->
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">Post to Channel</label>
                    <select name="channel_id" class="form-select" required>
                        <option value="">Select channel...</option>
                        <% channels.forEach(ch => { %>
                        <option value="<%= ch.id %>">#<%= ch.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="form-label">Embed Color</label>
                    <input type="color" name="color" value="#a78bfa" class="form-control" style="height: 42px; cursor: pointer;">
                </div>
            </div>

            <!-- Row 2: Title + URL -->
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">Title</label>
                    <input type="text" name="title" class="form-control" placeholder="Embed title" maxlength="256">
                </div>
                <div>
                    <label class="form-label">Title URL <span style="font-weight:400;color:var(--color-text-muted);">(optional)</span></label>
                    <input type="text" name="url" class="form-control" placeholder="https://...">
                </div>
            </div>

            <!-- Description -->
            <div style="margin-bottom: var(--spacing-4);">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="4" placeholder="Embed description — supports Discord markdown" style="resize: vertical;"></textarea>
                <div class="form-help">Supports **bold**, *italic*, ~~strikethrough~~, `code`, [links](url), and Discord emoji</div>
            </div>

            <!-- Author -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">Author Name <span style="font-weight:400;color:var(--color-text-muted);">(optional)</span></label>
                    <input type="text" name="author_name" class="form-control" placeholder="Author text above title" maxlength="256">
                </div>
                <div>
                    <label class="form-label">Author Icon URL <span style="font-weight:400;color:var(--color-text-muted);">(optional)</span></label>
                    <input type="text" name="author_icon_url" class="form-control" placeholder="https://...">
                </div>
            </div>

            <!-- Images -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">Thumbnail URL <span style="font-weight:400;color:var(--color-text-muted);">(optional)</span></label>
                    <input type="text" name="thumbnail_url" class="form-control" placeholder="Small image top-right">
                </div>
                <div>
                    <label class="form-label">Image URL <span style="font-weight:400;color:var(--color-text-muted);">(optional)</span></label>
                    <input type="text" name="image_url" class="form-control" placeholder="Large image at bottom">
                </div>
            </div>

            <!-- Footer -->
            <div style="margin-bottom: var(--spacing-6);">
                <label class="form-label">Footer Text <span style="font-weight:400;color:var(--color-text-muted);">(optional)</span></label>
                <input type="text" name="footer_text" class="form-control" placeholder="Small text at the bottom">
            </div>

            <!-- Action buttons -->
            <div style="display: flex; gap: var(--spacing-3);">
                <button type="submit" name="action" value="post" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i>
                    <span>Create & Post</span>
                </button>
                <button type="submit" name="action" value="draft" class="btn btn-secondary">
                    <i class="fas fa-save"></i>
                    <span>Save as Draft</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
(function() {
    var guildId = '<%= guild.id %>';

    // Post draft embeds
    document.querySelectorAll('.ce-post-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = btn.getAttribute('data-id');
            btn.disabled = true;
            btn.querySelector('i').className = 'fas fa-spinner fa-spin';
            fetch('/api/guilds/' + guildId + '/custom-embeds/' + id + '/post', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) { window.location.reload(); }
                else { alert(data.error || 'Failed to post'); btn.disabled = false; btn.querySelector('i').className = 'fas fa-paper-plane'; }
            })
            .catch(function() { alert('Network error'); btn.disabled = false; btn.querySelector('i').className = 'fas fa-paper-plane'; });
        });
    });
})();
</script>

<style>
.form-label { display: block; font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-2); }
.form-help { font-size: var(--font-size-xs); color: var(--color-text-muted); margin-top: var(--spacing-2); }
</style>
