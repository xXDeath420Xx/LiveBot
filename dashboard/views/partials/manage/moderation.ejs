<%#
  Moderation: the mod log channel and mute role (POST update-moderation), messages to members, protected
  roles and default lengths (PUT /api/guilds/:id/moderation/messages), recent infractions, the
  automated ban log (core/ban-log.js, GET /api/guilds/:id/insight/ban-log, one-click Unban),
  /ban requests (GET/PUT /api/guilds/:id/moderation/ban-requests, core/ban-requests.js; shown only where
  /ban is available, `banAvailable`, core/guild-scoped-access.js) and
  escalation rules (POST add-/remove-escalation-rule). Built on the settings-row kit
  (dashboard/public/css/cf-settings.css, partials/kit/); field names and ids are the ones the
  routes and the settings search (core/settings-index.js) already use.
%>
<%
const modTone = { warn: 'is-warn', timeout: 'is-warn', mute: 'is-warn', kick: 'is-info', ban: 'is-bad' };
const modType = (t) => { const s = String(t || ''); return s ? s.charAt(0).toUpperCase() + s.slice(1).toLowerCase() : 'Unknown'; };
// Pickers: text channels only for the log (voice channels are text-based in discord.js too), and role
// colours for the chips. The mute role is one the bot gives, so roles above the bot are marked.
const modTextChannels = (channels || []).filter(c => !(c && typeof c.isVoiceBased === 'function' && c.isVoiceBased()));
const modBotTop = (guild && guild.members && guild.members.me && guild.members.me.roles && guild.members.me.roles.highest) ? guild.members.me.roles.highest.position : Infinity;
const modRoleColor = (r) => (r && r.hexColor && r.hexColor !== '#000000') ? r.hexColor : '';
%>
<style>
    .mod-user-info { font-weight: 500; color: var(--cf-text); min-width: 0; }
    .mod-moderator-info { font-size: var(--cf-text-sm); color: var(--cf-text-2); }
    .mod-reason { max-width: 22rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--cf-text-2); }
    .mod-date { font-size: var(--cf-text-xs); color: var(--cf-text-3); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .mod-evidence { margin-top: 2px; font-size: var(--cf-text-xs); color: var(--cf-text-3); white-space: normal; }
    .mod-unbanned { font-size: var(--cf-text-xs); color: var(--cf-success); white-space: nowrap; }
    #banLogStatus { font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    #banLogFilter { width: auto; max-width: 15rem; }
    @media (max-width: 640px) {
        .mod-reason { max-width: none; white-space: normal; overflow-wrap: anywhere; }
        #banLogFilter { max-width: none; flex: 1 1 100%; }
    }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-shield-alt"></i>
                <span>Moderation</span>
            </div>
            <div class="page-section-subtitle">Settings every moderation command shares, and the record those commands leave.</div>
        </div>
    </div>

    <section class="cf-section" aria-labelledby="mod-config-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mod-config-title">Log and mute role</h2>
                <p class="cf-section-desc">Where moderation actions are recorded, and the role the bot uses when it mutes someone.</p>
            </div>
        </header>
        <form class="cf-rows" action="/manage/<%= guild.id %>/update-moderation" method="POST">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-mod_log_channel_id">Moderation log channel</label>
                    <p class="cf-row-desc" id="f-moderation-mod_log_channel_id-desc">Every warning, timeout, kick and ban is posted here.</p>
                </div>
                <div class="cf-row-control">
                    <select id="f-moderation-mod_log_channel_id" class="form-select" name="mod_log_channel_id" aria-describedby="f-moderation-mod_log_channel_id-desc">
                        <%- include('../kit/_options', { items: modTextChannels, selected: settings ? settings.mod_log_channel_id : null, prefix: '#', empty: 'No log channel' }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-muted_role_id">Mute role</label>
                    <p class="cf-row-desc" id="f-moderation-muted_role_id-desc">Given to members when they are muted and taken away when the mute ends.</p>
                </div>
                <div class="cf-row-control">
                    <select id="f-moderation-muted_role_id" class="form-select" name="muted_role_id" aria-describedby="f-moderation-muted_role_id-desc">
                        <option value="">No mute role</option>
                        <% (roles || []).forEach(r => { const sel = settings && String(settings.muted_role_id) === String(r.id); const above = typeof r.position === 'number' && r.position >= modBotTop; %><option value="<%= r.id %>" data-kind="role" data-color="<%= modRoleColor(r) %>"<%= sel ? ' selected' : '' %><%= above && !sel ? ' disabled' : '' %>><%= r.name %><%= above ? ' (above the bot)' : '' %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-section-foot">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </section>

    <%# Messages to members, protected roles and default lengths (moderation_config, migration 420;
        PUT /api/guilds/:id/moderation/messages). Used by every bot moderation command through
        core/moderation-manager.js. %>
    <%
    const mdRow = settings || {};
    const mdOnDefault = { warn: true, mute: true, unmute: true, kick: true, ban: true, unban: false };
    const mdOn = (a) => (mdRow['dm_on_' + a] === undefined || mdRow['dm_on_' + a] === null) ? mdOnDefault[a] : !!Number(mdRow['dm_on_' + a]);
    let mdTemplates = {};
    try { const p = typeof mdRow.dm_templates === 'string' ? JSON.parse(mdRow.dm_templates) : (mdRow.dm_templates || {}); if (p && typeof p === 'object') mdTemplates = p; } catch (e) { mdTemplates = {}; }
    let mdProtected = [];
    try { const p = typeof mdRow.protected_role_ids === 'string' ? JSON.parse(mdRow.protected_role_ids) : (mdRow.protected_role_ids || []); if (Array.isArray(p)) mdProtected = p.map(String); } catch (e) { mdProtected = []; }
    const mdActions = [
        { key: 'warn', label: 'Warning', when: 'When a member is warned.', title: 'You have been warned in {server}' },
        { key: 'mute', label: 'Timeout', when: 'When a member is muted (timed out).', title: 'You have been muted in {server}' },
        { key: 'unmute', label: 'Timeout removed', when: 'When a timeout is lifted early.', title: 'You have been unmuted in {server}' },
        { key: 'kick', label: 'Kick', when: 'Sent just before the kick.', title: 'You have been kicked from {server}' },
        { key: 'ban', label: 'Ban', when: 'Sent just before the ban.', title: 'You have been banned from {server}' },
        { key: 'unban', label: 'Unban', when: 'Often not delivered: after a ban the bot usually shares no server with them.', title: 'You have been unbanned from {server}' },
    ];
    %>
    <style>
        .mod-dm-text { min-height: 4.5rem; }
        .mod-dm-vars { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .mod-dm-vars code { font-size: var(--cf-text-xs); }
        .mod-dm-preview { border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface-2); padding: var(--cf-3) var(--cf-4); font-size: var(--cf-text-sm); color: var(--cf-text); overflow-wrap: anywhere; line-height: 1.45; }
        .mod-dm-preview-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-3); flex-wrap: wrap; margin-bottom: 6px; }
        .mod-dm-preview-head { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
        .mod-dm-author { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; font-weight: 600; }
        .mod-dm-avatar { flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--cf-border-strong); }
        .mod-dm-app { padding: 0 4px; border-radius: 3px; font-size: 10px; font-weight: 600; line-height: 15px; color: var(--cf-on-accent, #fff); background: var(--cf-accent); }
        .mod-dm-plain { white-space: pre-wrap; }
        .mod-dm-embed { max-width: 520px; padding: var(--cf-3); border-left: 4px solid var(--cf-danger); border-radius: var(--cf-radius-sm); background: var(--cf-surface); }
        .mod-dm-embed.is-warn { border-left-color: var(--cf-warning); }
        .mod-dm-embed.is-ok { border-left-color: var(--cf-success); }
        .mod-dm-preview-title { font-weight: 600; margin-bottom: 6px; }
        .mod-dm-preview-field + .mod-dm-preview-field { margin-top: 6px; }
        .mod-dm-field-name { font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text); }
        .mod-dm-field-value { color: var(--cf-text-2); white-space: pre-wrap; }
        #modMsgStatus, #modSafetyStatus, #cfk-mod-test-status { font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    </style>
    <section class="cf-section" id="modMessagesSection" aria-labelledby="mod-dm-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mod-dm-title">Messages to members</h2>
                <p class="cf-section-desc">The direct message a member gets when a moderator uses a bot command on them. Leave a message empty to send the standard one.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% mdActions.forEach(a => { %>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-dm_on_<%= a.key %>">Message on <%= a.label.toLowerCase() %></label>
                    <p class="cf-row-desc" id="f-moderation-dm_on_<%= a.key %>-desc"><%= a.when %></p>
                </div>
                <div class="cf-row-control">
                    <input class="cf-switch" type="checkbox" role="switch" id="f-moderation-dm_on_<%= a.key %>" name="dm_on_<%= a.key %>" data-dm-on="<%= a.key %>" aria-describedby="f-moderation-dm_on_<%= a.key %>-desc" <%= mdOn(a.key) ? 'checked' : '' %>>
                </div>
            </div>
            <div class="cf-row cf-row--sub cf-row--stack">
                <label class="visually-hidden" for="f-moderation-dm_template_<%= a.key %>"><%= a.label %> message</label>
                <textarea id="f-moderation-dm_template_<%= a.key %>" name="dm_template_<%= a.key %>" class="form-control mod-dm-text" rows="2" maxlength="1500" data-dm-template="<%= a.key %>" data-dm-title="<%= a.title %>" placeholder="Standard message: <%= a.title %>, with the reason"><%= typeof mdTemplates[a.key] === 'string' ? mdTemplates[a.key] : '' %></textarea>
            </div>
            <% }) %>
            <div class="cf-row cf-row--stack">
                <p class="mod-dm-vars" id="mod-dm-vars">You can use <code>{user}</code> <code>{server}</code> <code>{action}</code> <code>{reason}</code> <code>{duration}</code> <code>{moderator}</code> <code>{appeal_link}</code>. <code>{moderator}</code> says "a moderator" unless the switch below is on.</p>
                <div>
                    <div class="mod-dm-preview-bar">
                        <div class="mod-dm-preview-head" id="mod-dm-preview-head">Preview</div>
                        <div class="cf-inline">
                            <span id="cfk-mod-test-status" role="status" aria-live="polite"></span>
                            <button type="button" class="btn btn-sm btn-secondary" id="cfk-mod-test-send" title="Sends the message shown, as it is now, to you in a DM">Send me a test</button>
                        </div>
                    </div>
                    <div class="mod-dm-preview" id="mod-dm-preview" aria-live="polite"></div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-dm_show_moderator">Name the moderator</label>
                    <p class="cf-row-desc" id="f-moderation-dm_show_moderator-desc">Off keeps moderators anonymous: the message says "a moderator".</p>
                </div>
                <div class="cf-row-control">
                    <input class="cf-switch" type="checkbox" role="switch" id="f-moderation-dm_show_moderator" name="dm_show_moderator" aria-describedby="f-moderation-dm_show_moderator-desc" <%= Number(mdRow.dm_show_moderator || 0) ? 'checked' : '' %>>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-appeal_link">Appeal link</label>
                    <p class="cf-row-desc" id="f-moderation-appeal_link-desc">Added to warning, timeout, kick and ban messages, and available as <code>{appeal_link}</code>.</p>
                </div>
                <div class="cf-row-control">
                    <input id="f-moderation-appeal_link" type="url" class="form-control" name="appeal_link" maxlength="500" placeholder="https://" value="<%= mdRow.appeal_link || '' %>" aria-describedby="f-moderation-appeal_link-desc">
                </div>
            </div>
            <div class="cf-section-foot">
                <span id="modMsgStatus" class="cf-foot-note" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-primary" data-mod-save>Save</button>
            </div>
        </div>
    </section>

    <section class="cf-section" id="modSafetySection" aria-labelledby="mod-safety-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mod-safety-title">Protected roles and default lengths</h2>
                <p class="cf-section-desc">Applies to the bot's moderation commands, including the buttons on filtered-word reports.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-protected_role_ids">Protected roles</label>
                    <p class="cf-row-desc" id="f-moderation-protected_role_ids-desc">Members with any of these roles cannot be warned, muted, kicked or banned with bot commands.</p>
                </div>
                <div class="cf-row-control">
                    <select id="f-moderation-protected_role_ids" class="form-select" name="protected_role_ids" multiple size="5" aria-describedby="f-moderation-protected_role_ids-desc">
                        <% (roles || []).forEach(r => { %><option value="<%= r.id %>" data-kind="role" data-color="<%= modRoleColor(r) %>"<%= mdProtected.includes(String(r.id)) ? ' selected' : '' %>><%= r.name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-default_mute_minutes">Default timeout length</label>
                    <p class="cf-row-desc" id="f-moderation-default_mute_minutes-desc">Used when a mute is given no length. Empty means a length is required. At most 40320 minutes (28 days).</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit">
                        <input id="f-moderation-default_mute_minutes" type="number" class="form-control" name="default_mute_minutes" min="1" max="40320" step="1" value="<%= mdRow.default_mute_minutes || '' %>" aria-describedby="f-moderation-default_mute_minutes-desc">
                        <span class="cf-unit">minutes</span>
                    </div>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="f-moderation-default_ban_minutes">Default ban length</label>
                    <p class="cf-row-desc" id="f-moderation-default_ban_minutes-desc">Used when a ban is given no length; the member is unbanned when it runs out. Empty keeps bans permanent. A moderator can still type "permanent". At most 525600 minutes (365 days).</p>
                </div>
                <div class="cf-row-control">
                    <div class="cf-input-unit">
                        <input id="f-moderation-default_ban_minutes" type="number" class="form-control" name="default_ban_minutes" min="1" max="525600" step="1" value="<%= mdRow.default_ban_minutes || '' %>" aria-describedby="f-moderation-default_ban_minutes-desc">
                        <span class="cf-unit">minutes</span>
                    </div>
                </div>
            </div>
            <div class="cf-section-foot">
                <span id="modSafetyStatus" class="cf-foot-note" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-primary" data-mod-save>Save</button>
            </div>
        </div>
    </section>
    <script>
    (function () {
        const guildId = <%- JSON.stringify(String(guild.id)).replace(/</g, '\\u003c') %>;
        const serverName = <%- JSON.stringify(String(guild.name || 'this server')).replace(/</g, '\\u003c') %>;
        const myName = <%- JSON.stringify(String((locals.user && (locals.user.global_name || locals.user.username)) || 'YourName')).replace(/</g, '\\u003c') %>;
        const url = '/api/guilds/' + guildId + '/moderation/messages';
        const $ = (id) => document.getElementById(id);
        const actions = ['warn', 'mute', 'unmute', 'kick', 'ban', 'unban'];
        const past = { warn: 'warned', mute: 'muted', unmute: 'unmuted', kick: 'kicked', ban: 'banned', unban: 'unbanned' };
        const sampleLength = { mute: '1 hour', ban: 'permanent' };
        const botName = <%- JSON.stringify(String((guild && guild.client && guild.client.user && guild.client.user.username) || 'CertiFried')).replace(/</g, '\\u003c') %>;
        const tone = { warn: 'is-warn', mute: 'is-warn', unmute: 'is-ok', kick: '', ban: '', unban: 'is-ok' };
        const preview = $('mod-dm-preview');
        const previewHead = $('mod-dm-preview-head');
        let shown = 'ban';

        function fill(text, vars) {
            return String(text).replace(/\{(user|server|action|reason|duration|moderator|appeal_link)\}/gi, (_, k) => vars[k.toLowerCase()] ?? '');
        }
        function line(cls, text) { const d = document.createElement('div'); d.className = cls; d.textContent = text; return d; }
        function field(name, value) {
            const d = line('mod-dm-preview-field', '');
            d.append(line('mod-dm-field-name', name), line('mod-dm-field-value', value));
            return d;
        }
        function author() {
            const a = line('mod-dm-author', '');
            const av = document.createElement('span'); av.className = 'mod-dm-avatar'; av.setAttribute('aria-hidden', 'true');
            const app = document.createElement('span'); app.className = 'mod-dm-app'; app.textContent = 'APP'; app.setAttribute('aria-hidden', 'true');
            a.append(av, document.createTextNode(botName), app);
            return a;
        }
        function render() {
            const box = document.querySelector('[data-dm-template="' + shown + '"]');
            const showMod = $('f-moderation-dm_show_moderator').checked;
            const appeal = $('f-moderation-appeal_link').value.trim();
            const vars = { user: 'pixelpal', server: serverName, action: past[shown], reason: 'Spamming in #general',
                duration: sampleLength[shown] || '', moderator: showMod ? myName : 'a moderator', appeal_link: appeal };
            const on = $('f-moderation-dm_on_' + shown).checked;
            previewHead.textContent = 'Preview: ' + box.labels[0].textContent + (on ? '' : ' (switched off, not sent)');
            const custom = box.value.trim();
            if (custom) {
                preview.replaceChildren(author(), line('mod-dm-plain', (fill(custom, vars).trim() || fill(box.dataset.dmTitle, vars)).slice(0, 2000)));
                return;
            }
            const embed = line('mod-dm-embed' + (tone[shown] ? ' ' + tone[shown] : ''), '');
            embed.append(line('mod-dm-preview-title', fill(box.dataset.dmTitle, vars)), field('Reason', vars.reason));
            if (shown === 'mute') embed.append(field('Ends', 'in ' + vars.duration));
            else if (vars.duration) embed.append(field('Duration', vars.duration));
            if (showMod) embed.append(field('Moderator', myName));
            if (appeal && ['warn', 'mute', 'kick', 'ban'].includes(shown)) embed.append(field('Appeal', appeal));
            preview.replaceChildren(author(), embed);
        }
        actions.forEach(a => {
            const box = document.querySelector('[data-dm-template="' + a + '"]');
            const sw = $('f-moderation-dm_on_' + a);
            const pick = () => { shown = a; render(); };
            box.addEventListener('focus', pick);
            box.addEventListener('input', pick);
            sw.addEventListener('change', pick);
        });
        $('f-moderation-dm_show_moderator').addEventListener('change', render);
        $('f-moderation-appeal_link').addEventListener('input', render);
        render();

        // Send me a test: the message being previewed, with its unsaved text, DMed to the admin.
        $('cfk-mod-test-send').addEventListener('click', async () => {
            const btn = $('cfk-mod-test-send');
            const status = $('cfk-mod-test-status');
            btn.disabled = true;
            status.textContent = 'Sending...';
            try {
                const res = await fetch(url + '/test', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: shown, template: document.querySelector('[data-dm-template="' + shown + '"]').value,
                        showModerator: $('f-moderation-dm_show_moderator').checked, appealLink: $('f-moderation-appeal_link').value.trim() }) });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || ('Request failed (' + res.status + ')'));
                status.textContent = 'Sent. Check your DMs.';
            } catch (e) {
                status.textContent = e.message;
            } finally {
                setTimeout(() => { btn.disabled = false; }, 3000);
            }
        });

        function collect() {
            const dmOn = {}, templates = {};
            actions.forEach(a => {
                dmOn[a] = $('f-moderation-dm_on_' + a).checked;
                templates[a] = document.querySelector('[data-dm-template="' + a + '"]').value;
            });
            return {
                dmOn, templates,
                showModerator: $('f-moderation-dm_show_moderator').checked,
                appealLink: $('f-moderation-appeal_link').value.trim(),
                protectedRoleIds: Array.from($('f-moderation-protected_role_ids').selectedOptions, o => o.value),
                defaultMuteMinutes: $('f-moderation-default_mute_minutes').value.trim(),
                defaultBanMinutes: $('f-moderation-default_ban_minutes').value.trim(),
            };
        }
        function apply(d) {
            actions.forEach(a => {
                $('f-moderation-dm_on_' + a).checked = !!(d.dmOn && d.dmOn[a]);
                document.querySelector('[data-dm-template="' + a + '"]').value = (d.templates && d.templates[a]) || '';
            });
            $('f-moderation-dm_show_moderator').checked = !!d.showModerator;
            $('f-moderation-appeal_link').value = d.appealLink || '';
            const keep = new Set(d.protectedRoleIds || []);
            for (const o of $('f-moderation-protected_role_ids').options) o.selected = keep.has(o.value);
            $('f-moderation-default_mute_minutes').value = d.defaultMuteMinutes || '';
            $('f-moderation-default_ban_minutes').value = d.defaultBanMinutes || '';
            render();
        }
        document.querySelectorAll('[data-mod-save]').forEach(btn => btn.addEventListener('click', async () => {
            const status = btn.closest('.cf-section').querySelector('[role="status"]');
            const buttons = document.querySelectorAll('[data-mod-save]');
            buttons.forEach(b => { b.disabled = true; });
            status.textContent = 'Saving...';
            try {
                const res = await fetch(url, { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(collect()) });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || ('Request failed (' + res.status + ')'));
                apply(d);
                status.textContent = 'Saved.';
            } catch (e) {
                status.textContent = e.message;
            } finally {
                buttons.forEach(b => { b.disabled = false; });
            }
        }));
    })();
    </script>

    <%# /ban requests (ban_request_config; core/ban-requests.js, H-657). Loaded and saved by the script below.
        /ban is per-server (guildScoped), so the section only shows where it is registered (H-712). %>
    <% if (typeof banAvailable !== 'undefined' && banAvailable === false) { %>
    <p class="cf-section-desc" id="cfk-mod-banreq-unavailable">Ban requests come with <code>/ban</code>, which is not available in this server. Moderators with Ban Members can still use <code>/admin mod ban</code>.</p>
    <% } else { %>
    <section class="cf-section" id="cfk-mod-banreq" aria-labelledby="mod-banreq-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mod-banreq-title">Ban requests</h2>
                <p class="cf-section-desc">How <code>/ban</code> works for moderators who cannot ban: it kicks the member and posts a request that an admin approves or declines. Members with Ban Members always ban outright; members with Kick Members can always file a request.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="cfk-mod-banreq-channel">Request channel</label>
                    <p class="cf-row-desc" id="cfk-mod-banreq-channel-desc">Requests are posted here with Approve and Decline buttons, and the approver roles are pinged. Without one, requests only reach the server log.</p>
                </div>
                <div class="cf-row-control">
                    <select id="cfk-mod-banreq-channel" class="form-select" aria-describedby="cfk-mod-banreq-channel-desc">
                        <%- include('../kit/_options', { items: modTextChannels, selected: null, prefix: '#', empty: 'No request channel' }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="cfk-mod-banreq-approvers">Approver roles</label>
                    <p class="cf-row-desc" id="cfk-mod-banreq-approvers-desc">Members with these roles ban outright with <code>/ban</code> and can approve or decline requests, even without Ban Members.</p>
                </div>
                <div class="cf-row-control">
                    <select id="cfk-mod-banreq-approvers" class="form-select" multiple size="5" aria-describedby="cfk-mod-banreq-approvers-desc">
                        <% (roles || []).forEach(r => { %><option value="<%= r.id %>" data-kind="role" data-color="<%= modRoleColor(r) %>"><%= r.name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-row">
                <div class="cf-row-text">
                    <label class="cf-row-label" for="cfk-mod-banreq-requesters">Requester roles</label>
                    <p class="cf-row-desc" id="cfk-mod-banreq-requesters-desc">Members with these roles can use <code>/ban</code> to kick and ask for a ban, even without Kick Members. Discord shows <code>/ban</code> only to members with Kick Members unless you change it under Server Settings, Integrations.</p>
                </div>
                <div class="cf-row-control">
                    <select id="cfk-mod-banreq-requesters" class="form-select" multiple size="5" aria-describedby="cfk-mod-banreq-requesters-desc">
                        <% (roles || []).forEach(r => { %><option value="<%= r.id %>" data-kind="role" data-color="<%= modRoleColor(r) %>"><%= r.name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="cf-section-foot">
                <span id="cfk-mod-banreq-status" class="cf-foot-note" role="status" aria-live="polite"></span>
                <button type="button" class="btn btn-primary" id="cfk-mod-banreq-save">Save</button>
            </div>
        </div>
    </section>
    <script>
    (function () {
        const guildId = <%- JSON.stringify(String(guild.id)).replace(/</g, '\\u003c') %>;
        const url = '/api/guilds/' + guildId + '/moderation/ban-requests';
        const $ = (id) => document.getElementById(id);
        const status = $('cfk-mod-banreq-status');
        const save = $('cfk-mod-banreq-save');
        const pick = (id, values) => { const want = new Set((values || []).map(String)); for (const o of $(id).options) o.selected = want.has(o.value); $(id).dispatchEvent(new Event('change', { bubbles: true })); };
        function apply(d) {
            $('cfk-mod-banreq-channel').value = d.channelId || '';
            $('cfk-mod-banreq-channel').dispatchEvent(new Event('change', { bubbles: true }));
            pick('cfk-mod-banreq-approvers', d.approverRoleIds);
            pick('cfk-mod-banreq-requesters', d.requesterRoleIds);
        }
        async function load() {
            try {
                const res = await fetch(url, { credentials: 'same-origin' });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || ('Request failed (' + res.status + ')'));
                apply(d);
            } catch (e) {
                status.textContent = 'Could not load: ' + e.message;
            }
        }
        save.addEventListener('click', async () => {
            save.disabled = true;
            status.textContent = 'Saving...';
            try {
                const body = {
                    channelId: $('cfk-mod-banreq-channel').value || null,
                    approverRoleIds: Array.from($('cfk-mod-banreq-approvers').selectedOptions, o => o.value),
                    requesterRoleIds: Array.from($('cfk-mod-banreq-requesters').selectedOptions, o => o.value),
                };
                const res = await fetch(url, { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                const d = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(d.error || ('Request failed (' + res.status + ')'));
                apply(d);
                status.textContent = 'Saved.';
            } catch (e) {
                status.textContent = e.message;
            } finally {
                save.disabled = false;
            }
        });
        load();
    })();
    </script>
    <% } %>

    <section class="cf-section" aria-labelledby="mod-infractions-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mod-infractions-title">Recent infractions</h2>
                <p class="cf-section-desc">The latest warnings, timeouts, kicks and bans, by moderators and by the bot.</p>
            </div>
            <% if (infractions && infractions.length) { %><div class="cf-section-actions"><span class="cf-pill"><%= infractions.length %> shown</span></div><% } %>
        </header>
        <div class="cf-rows">
            <% if (infractions && infractions.length > 0) { %>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr><th scope="col">Member</th><th scope="col">Moderator</th><th scope="col">Action</th><th scope="col">Reason</th><th scope="col">Date</th></tr>
                    </thead>
                    <tbody>
                        <% infractions.forEach(infraction => { const t = String(infraction.type || '').toLowerCase(); %>
                        <tr>
                            <td data-label="Member">
                                <div class="mod-user-info">
                                    <%- include('_user-cell', { cfUser: infraction.user || null, cfUserId: infraction.user_id, cfUserName: infraction.user_tag || null }) %>
                                </div>
                            </td>
                            <td data-label="Moderator">
                                <div class="mod-moderator-info">
                                    <%- include('_user-cell', { cfUser: infraction.moderator || null, cfUserId: infraction.moderator_id, cfUserName: infraction.moderator_tag || null, cfUserSize: 'sm' }) %>
                                </div>
                            </td>
                            <td data-label="Action"><span class="cf-pill <%= modTone[t] || '' %>"><%= modType(t) %></span></td>
                            <td data-label="Reason"><div class="mod-reason" title="<%= infraction.reason || 'No reason given' %>"><%= infraction.reason || 'No reason given' %></div></td>
                            <td data-label="Date"><span class="mod-date"><%= new Date(infraction.created_at).toLocaleDateString() %></span></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No recent infractions', text: 'Warnings, timeouts, kicks and bans will be listed here.', id: null, boxed: false, compact: false }) %>
            <% } %>
        </div>
    </section>

    <%# Automated ban log (core/ban-log.js): every ban the protections made, with evidence and one-click Unban. %>
    <section class="cf-section" id="banLogSection" aria-labelledby="banLogSection-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="banLogSection-title">Automated ban log</h2>
                <p class="cf-section-desc">Bans made by the bot's protections in the last 90 days: the spammer check, name and avatar filters, raid lockdown, message threats, the global ban list, the join gate and verification.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-row cf-row--stack">
                <div class="cf-inline">
                    <label class="visually-hidden" for="banLogFilter">Protection</label>
                    <select id="banLogFilter" class="form-select form-select-sm">
                        <option value="">Every protection</option>
                    </select>
                    <label class="cf-choice" for="banLogActive"><input type="checkbox" id="banLogActive" checked> <span>Still banned only</span></label>
                    <button type="button" class="btn btn-sm btn-secondary" id="banLogRefresh">Refresh</button>
                </div>
                <div id="banLogStatus" role="status" aria-live="polite">Loading...</div>
            </div>
            <div class="cf-table-wrap">
                <table class="cf-table cf-table--stack">
                    <thead>
                        <tr><th scope="col">Member</th><th scope="col">Protection</th><th scope="col">Reason and evidence</th><th scope="col">When</th><th scope="col"><span class="visually-hidden">Action</span></th></tr>
                    </thead>
                    <tbody id="banLogBody"></tbody>
                </table>
            </div>
        </div>
    </section>
    <script>
    (function () {
        const guildId = <%- JSON.stringify(String(guild.id)).replace(/</g, '\\u003c') %>;
        const base = '/api/guilds/' + guildId + '/insight';
        const el = (tag, props, ...kids) => {
            const node = document.createElement(tag);
            if (props) { const { style, label, ...rest } = props; Object.assign(node, rest); if (style) node.style.cssText = style; if (label) node.dataset.label = label; }
            for (const k of kids) if (k != null) node.append(k);
            return node;
        };
        const body = document.getElementById('banLogBody');
        const status = document.getElementById('banLogStatus');
        const filter = document.getElementById('banLogFilter');
        const activeOnly = document.getElementById('banLogActive');
        let rows = [];

        function render() {
            const shown = rows.filter(r => (!filter.value || r.protection === filter.value) && (!activeOnly.checked || !r.unbanned));
            status.textContent = rows.length
                ? shown.length + ' shown of ' + rows.length + ' automated bans (' + rows.filter(r => !r.unbanned).length + ' still banned).'
                : 'No automated bans in the last 90 days.';
            body.replaceChildren(...shown.map(r => {
                const who = el('div', { className: 'mod-user-info' },
                    window.CFUser ? CFUser.cell(r.user || { id: r.userId, username: r.username, avatar: r.avatar })
                        : el('span', { textContent: r.username || r.userId }));
                const prot = el('a', { href: '/manage/' + guildId + '?page=' + r.page, textContent: r.label, className: 'cf-pill is-bad' });
                const ev = el('div', { className: 'mod-reason' }, el('div', { textContent: r.reason || 'No reason recorded' }));
                if (r.evidence) {
                    const line = el('div', { className: 'mod-evidence' });
                    if (r.evidence.text) line.append(r.evidence.text + ' ');
                    if (r.evidence.url) line.append(el('a', { href: r.evidence.url, target: '_blank', rel: 'noopener', textContent: 'Message' }), ' ');
                    if (r.evidence.page) line.append(el('a', { href: '/manage/' + guildId + '?page=' + r.evidence.page, textContent: 'Details' }));
                    ev.append(line);
                }
                const action = el('td', { className: 'cf-cell-end' });
                if (r.unbanned) {
                    action.append(el('span', { className: 'mod-unbanned', textContent: 'Unbanned ' + new Date(r.unbannedAt).toLocaleDateString() }));
                } else {
                    const btn = el('button', { type: 'button', className: 'btn btn-sm btn-secondary', textContent: 'Unban' });
                    btn.addEventListener('click', async () => {
                        if (!confirm('Unban ' + (window.CFUser && r.user ? CFUser.label(r.user) : (r.username || r.userId)) + '? They can rejoin straight away, and the rejoin limit counts from now.')) return;
                        btn.disabled = true; btn.textContent = 'Unbanning...';
                        try {
                            const res = await fetch(base + '/ban-log/' + encodeURIComponent(r.userId) + '/unban', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' } });
                            const out = await res.json().catch(() => ({}));
                            if (!res.ok) throw new Error(out.error || ('Request failed (' + res.status + ')'));
                            r.unbanned = true; r.unbannedAt = Date.now();
                            render();
                        } catch (e) {
                            btn.disabled = false; btn.textContent = 'Unban';
                            alert(e.message);
                        }
                    });
                    action.append(btn);
                }
                return el('tr', {},
                    el('td', { label: 'Member' }, who),
                    el('td', { label: 'Protection' }, prot),
                    el('td', { label: 'Reason' }, ev),
                    el('td', { label: 'When' }, el('span', { className: 'mod-date', textContent: new Date(r.at).toLocaleString() })),
                    action);
            }));
        }

        async function load() {
            status.textContent = 'Loading...';
            try {
                const res = await fetch(base + '/ban-log', { credentials: 'same-origin' });
                const out = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(out.error || ('Request failed (' + res.status + ')'));
                rows = out.rows || [];
                const kinds = [...new Map(rows.map(r => [r.protection, r.label])).entries()];
                const keep = filter.value;
                filter.replaceChildren(el('option', { value: '', textContent: 'Every protection' }),
                    ...kinds.map(([k, label]) => el('option', { value: k, textContent: label })));
                filter.value = kinds.some(([k]) => k === keep) ? keep : '';
                render();
            } catch (e) {
                status.textContent = 'Could not load the ban log: ' + e.message;
            }
        }
        filter.addEventListener('change', render);
        activeOnly.addEventListener('change', render);
        document.getElementById('banLogRefresh').addEventListener('click', load);
        load();
    })();
    </script>

    <section class="cf-section" aria-labelledby="mod-escalation-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="mod-escalation-title">Escalation rules</h2>
                <p class="cf-section-desc">Stricter action, applied automatically, for members who keep breaking the rules. Warnings, timeouts, kicks and bans count, from moderators and from the automatic protections; actions taken by these rules and anything before a member's infractions were cleared do not. When several rules match, the one with the highest count acts.</p>
            </div>
            <div class="cf-section-actions"><span class="cf-pill<%= escalationRules && escalationRules.length ? ' is-ok' : '' %>"><%= (escalationRules && escalationRules.length) || 0 %> <%= escalationRules && escalationRules.length === 1 ? 'rule' : 'rules' %></span></div>
        </header>
        <div class="cf-rows">
            <% if (escalationRules && escalationRules.length > 0) { %>
            <div class="cf-list">
                <% escalationRules.forEach(rule => { %>
                <div class="cf-list-item">
                    <div class="cf-list-main">
                        After <span class="cf-em"><%= rule.infraction_count %></span> infractions within
                        <span class="cf-em"><%= rule.time_period_hours %></span> hours:
                        <span class="cf-pill <%= modTone[String(rule.action).toLowerCase()] || '' %>"><%= (rule.action === 'mute' || rule.action === 'timeout') ? 'Timeout' : modType(rule.action) %></span><% if ((rule.action === 'mute' || rule.action === 'timeout') && rule.action_duration_minutes) { %>
                        for <span class="cf-em"><%= rule.action_duration_minutes %></span> minutes<% } %>
                    </div>
                    <form class="cf-list-actions" action="/manage/<%= guild.id %>/remove-escalation-rule" method="POST">
                        <input type="hidden" name="ruleId" value="<%= rule.id %>">
                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                    </form>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No escalation rules', text: 'Add one below, for example a timeout after three infractions in a day.', id: null, boxed: false, compact: false }) %>
            <% } %>
            <form action="/manage/<%= guild.id %>/add-escalation-rule" method="POST">
                <div class="cf-rows-head" id="mod-add-rule-head">Add a rule</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="f-moderation-infraction_count">Infractions</label>
                            <input id="f-moderation-infraction_count" type="number" name="infraction_count" class="form-control" required min="1" max="100" placeholder="3">
                        </div>
                        <div class="cf-field">
                            <label for="f-moderation-time_period_hours">Within (hours)</label>
                            <input id="f-moderation-time_period_hours" type="number" name="time_period_hours" class="form-control" required min="1" max="17520" placeholder="24">
                        </div>
                        <div class="cf-field">
                            <label for="f-moderation-action">Action</label>
                            <select id="f-moderation-action" name="action" class="form-select" required>
                                <option value="timeout">Timeout</option>
                                <option value="kick">Kick</option>
                                <option value="ban">Ban</option>
                            </select>
                        </div>
                        <div class="cf-field">
                            <label for="f-moderation-action_duration_minutes">Timeout length (minutes)</label>
                            <input id="f-moderation-action_duration_minutes" type="number" name="action_duration_minutes" class="form-control" min="1" max="40320" value="60" placeholder="60">
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-foot-note">Up to 100 infractions within up to 17520 hours (two years, as long as infractions are kept). The timeout length, at most 40320 minutes (28 days), is only used when the action is Timeout.</span>
                    <button type="submit" class="btn btn-primary">Add rule</button>
                </div>
            </form>
        </div>
    </section>
</div>
