<%# Initialize Bot — end-to-end setup wizard.
    API-driven; needs `guild` and `channels` in locals. Every step's `done` flag is derived
    from the same rows the runtime reads, so the checklist can never claim something is set
    up when it isn't. Built on the settings-row kit (cf-settings.css): progress and permissions
    are kit panels, and the script draws each step group as a kit section of list rows. %>
<style>
  #initWizard .init-progress { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-4); padding: var(--cf-4) var(--cf-5); }
  #initWizard .init-progress-text { margin: 0; font-size: var(--cf-text-sm); color: var(--cf-text-2); line-height: 1.5; min-width: 0; }
  #initWizard .init-pct { flex: none; font-size: var(--cf-text-xl); font-weight: 600; color: var(--cf-text); font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  #initWizard .init-bar { height: 6px; margin: 0 var(--cf-5) var(--cf-4); border-radius: 999px; background: var(--cf-surface-3); overflow: hidden; }
  #initWizard .cf-rows > .init-bar { border-top: 0; }
  #initWizard .init-bar-fill { width: 0; height: 100%; background: var(--cf-accent); border-radius: inherit; transition: width .4s ease; }
  #initWizard .cf-state--compact { flex-wrap: wrap; }
  #initWizard .cf-state--compact .cf-state-title { white-space: nowrap; }
  #initWizard .init-perm-flag { font-weight: 500; color: var(--cf-text); }
  #initWizard .init-perm-why { display: block; color: var(--cf-text-3); }
  #initWizard .init-title { display: flex; align-items: center; flex-wrap: wrap; gap: var(--cf-2); font-weight: 500; color: var(--cf-text); font-size: var(--cf-text-md); }
  #initWizard .init-desc { display: block; margin-top: 2px; color: var(--cf-text-3); }
  #initWizard .init-detail { display: block; margin-top: 4px; font-size: var(--cf-text-xs); color: var(--cf-warning); }
  #initWizard .init-step .cf-list-actions { flex-wrap: wrap; align-items: center; justify-content: flex-end; max-width: 30rem; }
  #initWizard select.init-chan { width: auto; min-width: 0; max-width: 14rem; margin: 0; }
  #initWizard .init-status { flex-basis: 100%; justify-content: flex-end; }
  #initWizard .init-status:empty { display: none; }
  @media (max-width: 640px) {
    #initWizard .init-progress { padding: var(--cf-4); }
    #initWizard .init-bar { margin: 0 var(--cf-4) var(--cf-4); }
    #initWizard .init-step .cf-list-actions { max-width: none; justify-content: stretch; }
    #initWizard .init-step .cf-list-actions > select.init-chan { flex: 1 1 100%; max-width: none; min-height: 44px; }
    #initWizard .init-step .cf-list-actions > .btn { flex: 1 1 auto; justify-content: center; }
    #initWizard .init-status { justify-content: flex-start; }
  }
</style>

<div class="page-section" id="initWizard" data-guild-id="<%= guild.id %>">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span>Initialize bot</span>
            </div>
            <div class="page-section-subtitle">A step is only marked done when its settings are really in place.</div>
        </div>
    </div>

    <div id="initError" class="cf-notice is-bad" role="alert" hidden></div>

    <section class="cf-section" aria-labelledby="initBotName">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="initBotName">Setup progress</h2>
                <p class="cf-section-desc">Essential and recommended steps count towards the total; optional extras are listed separately.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="init-progress">
                <p class="init-progress-text" id="initProgressText" role="status" aria-live="polite">Loading setup status</p>
                <div class="init-pct" id="initPct" aria-hidden="true">0%</div>
            </div>
            <div class="init-bar" aria-hidden="true"><div class="init-bar-fill" id="initBarFill"></div></div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="init-perms-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="init-perms-title">Bot permissions</h2>
                <p class="cf-section-desc">A feature whose permission is missing fails quietly, so fix these first.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div id="initPerms" class="cf-list">
                <%- include('../kit/_state', { kind: 'loading', title: 'Checking permissions', compact: true }) %>
            </div>
        </div>
    </section>

    <div id="initGroups">
        <section class="cf-section" aria-labelledby="init-steps-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="init-steps-title">Setup steps</h2>
                </div>
            </header>
            <div class="cf-rows">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading setup steps', compact: true }) %>
            </div>
        </section>
    </div>
</div>

<script>
(function () {
  const root = document.getElementById('initWizard');
  if (!root) return;
  const guildId = root.dataset.guildId;
  const api = (p) => `/api/guilds/${guildId}${p}`;
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

  // Text channels for the one-click steps that need one.
  const CHANNELS = <%- JSON.stringify((locals.channels || []).filter(c => c.type === 0 || c.type === 'GUILD_TEXT' || c.type === 5).map(c => ({ id: c.id, name: c.name }))).replace(/</g, '\\u003c') %>;

  const GROUPS = [
    { key: 'essential',   label: 'Essential',   desc: 'The basics every server should have.' },
    { key: 'recommended', label: 'Recommended', desc: 'Worth setting up for most servers.' },
    { key: 'optional',    label: 'Optional',    desc: 'Extras to switch on if you want them.' },
  ];
  // Steps the wizard can complete in place. Everything else links to its own page, because a
  // wizard that guesses at moderation thresholds is worse than one that refuses.
  const QUICK = { logging: 'channel', welcome: 'channel', leveling: null, prefixes: null };

  // Kit empty / error state markup (partials/kit/_state.ejs) for the panels the script fills.
  const stateHtml = (kind, title, text) =>
    `<div class="cf-state cf-state--${kind} cf-state--compact"${kind === 'error' ? ' role="alert"' : ''}>` +
    `<p class="cf-state-title">${esc(title)}</p>${text ? `<p class="cf-state-text">${esc(text)}</p>` : ''}</div>`;

  async function req(url, options) {
    const res = await fetch(url, { credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, ...options });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || `Request failed (${res.status})`);
    return body;
  }
  const showError = (msg) => {
    const el = document.getElementById('initError');
    if (!msg) { el.hidden = true; return; }
    el.textContent = msg; el.hidden = false;
  };

  function renderPerms(perms) {
    const el = document.getElementById('initPerms');
    if (!perms.length) { el.innerHTML = stateHtml('empty', 'Could not read permissions.'); return; }
    el.innerHTML = perms.map(p => {
      const pill = p.granted === null ? '<span class="cf-pill">Unknown</span>'
        : p.granted ? '<span class="cf-pill is-ok">Granted</span>' : '<span class="cf-pill is-bad">Missing</span>';
      return `<div class="cf-list-item init-perm"><div class="cf-list-main"><span class="init-perm-flag">${esc(p.flag)}</span><span class="init-perm-why">${esc(p.why)}</span></div><div class="cf-list-actions">${pill}</div></div>`;
    }).join('');
  }

  function stepHtml(step) {
    const pill = step.done === null ? '<span class="cf-pill">Checking</span>'
      : step.done ? '<span class="cf-pill is-ok">Done</span>' : '<span class="cf-pill is-warn">To do</span>';
    const quick = Object.prototype.hasOwnProperty.call(QUICK, step.id) && !step.done;
    const needsChannel = QUICK[step.id] === 'channel';

    let actions = '';
    if (quick) {
      const picker = needsChannel
        ? `<select class="form-select form-select-sm init-chan" data-chan-for="${esc(step.id)}" aria-label="Channel for ${esc(step.title)}">
             <option value="">Choose a channel</option>
             ${CHANNELS.map(c => `<option value="${esc(c.id)}">#${esc(c.name)}</option>`).join('')}
           </select>`
        : '';
      actions += `${picker}<button type="button" class="btn btn-sm btn-primary" data-quick="${esc(step.id)}">Turn on</button>`;
    }
    if (step.section) {
      actions += `<a class="btn btn-sm btn-secondary" href="/manage/${esc(guildId)}?page=${encodeURIComponent(step.section)}">${step.done ? 'Review' : 'Set up'}</a>`;
    }
    const detail = step.detail ? `<span class="init-detail">${esc(step.detail)}</span>` : '';

    return `<div class="cf-list-item init-step ${step.done ? 'done' : ''}">
      <div class="cf-list-main">
        <span class="init-title">${esc(step.title)} ${pill}</span>
        <span class="init-desc">${esc(step.description)}</span>
        ${detail}
      </div>
      <div class="cf-list-actions">${actions}<span class="init-status cf-status-line" data-status="${esc(step.id)}" role="status"></span></div>
    </div>`;
  }

  function render(data) {
    document.getElementById('initBotName').textContent = `${data.botName} setup progress`;
    const { done, total, optionalDone, optionalTotal } = data.progress;
    const pct = total ? Math.round((done / total) * 100) : 0;
    document.getElementById('initPct').textContent = `${pct}%`;
    document.getElementById('initBarFill').style.width = `${pct}%`;
    document.getElementById('initProgressText').textContent =
      `${done} of ${total} essential and recommended steps done. ${optionalDone} of ${optionalTotal} optional extras on.`;

    renderPerms(data.permissions || []);

    document.getElementById('initGroups').innerHTML = GROUPS.map(g => {
      const steps = data.steps.filter(s => s.group === g.key);
      if (!steps.length) return '';
      return `<section class="cf-section init-group" aria-label="${g.label} steps">
        <header class="cf-section-head"><div><h2 class="cf-section-title">${g.label}</h2><p class="cf-section-desc">${g.desc}</p></div></header>
        <div class="cf-rows"><div class="cf-list">${steps.map(stepHtml).join('')}</div></div>
      </section>`;
    }).join('');
  }

  async function load() {
    try {
      showError('');
      render(await req(api('/initialize/status')));
    } catch (err) {
      showError(err.message);
      // Replace the loading rows (first load only) so the panels don't spin forever.
      root.querySelectorAll('#initPerms .cf-state--loading, #initGroups .cf-state--loading').forEach((el) => {
        el.outerHTML = stateHtml('error', 'Could not load setup status', 'Reload the page to try again.');
      });
      const txt = document.getElementById('initProgressText');
      if (txt.textContent === 'Loading setup status') txt.textContent = 'Setup status is unavailable right now.';
    }
  }

  root.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-quick]');
    if (!btn) return;
    const step = btn.dataset.quick;
    const status = root.querySelector(`[data-status="${step}"]`);
    const picker = root.querySelector(`[data-chan-for="${step}"]`);

    if (picker && !picker.value) { status.textContent = 'Pick a channel first.'; status.className = 'init-status cf-status-line is-bad'; return; }

    btn.disabled = true;
    try {
      await req(api(`/initialize/quick/${step}`), {
        method: 'POST',
        body: JSON.stringify(picker ? { channel_id: picker.value } : {}),
      });
      status.className = 'init-status cf-status-line is-ok';
      status.textContent = 'Turned on.';
      await load();
    } catch (err) {
      status.className = 'init-status cf-status-line is-bad';
      status.textContent = err.message;
      btn.disabled = false;
    }
  });

  load();
})();
</script>
