<script>
const guildId = '<%= guild.id %>';
let currentEventId = null;
let currentScheduleId = null;
let currentEventData = null;
let currentScheduleData = null;

document.addEventListener('DOMContentLoaded', () => {
    loadEvents();
});

// Rows are built with createElement / textContent: event, schedule and run names (which can hold
// apostrophes, quotes or markup) are never put into HTML or into inline onclick code. Each button
// carries data-sch-action and the ids it needs; one click listener on #schedule-content routes it.
function schEl(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
}
function schIcon(name) {
    const i = schEl('i', name);
    i.setAttribute('aria-hidden', 'true');
    return i;
}
function schButton(label, cls, action, data, iconName) {
    const b = schEl('button', `btn btn-sm ${cls}`);
    b.type = 'button';
    b.dataset.schAction = action;
    for (const [k, v] of Object.entries(data || {})) b.dataset[k] = String(v ?? '');
    if (iconName) {
        b.append(schIcon(`fas fa-${iconName}`));
        b.title = label;
        b.setAttribute('aria-label', label);
    } else b.textContent = label;
    return b;
}
function schState(title, text, button) {
    const box = schEl('div', 'cf-state cf-state--empty');
    box.append(schEl('p', 'cf-state-title', title), schEl('p', 'cf-state-text', text));
    if (button) {
        button.classList.remove('btn-sm');
        box.append(button);
    }
    return box;
}
function schPill(status) {
    const s = String(status || 'pending');
    const tone = { running: 'is-ok', completed: 'is-info', skipped: 'is-warn' }[s] || '';
    return schEl('span', `cf-pill ${tone}`.trim(), s.charAt(0).toUpperCase() + s.slice(1));
}
/** The heading line above a schedule's or an event's list: its name and the add button. */
function schViewHead(title, button, sub) {
    const head = schEl('div', 'cf-list-item sch-view-head');
    const text = schEl('div');
    text.append(schEl('h3', 'cf-list-title', title));
    if (sub) text.append(schEl('p', 'sch-view-sub', sub));
    head.append(text, button);
    return head;
}
// Feedback goes to the dashboard's own toast (manage-tailwind.ejs defines window.showToast after
// this partial, so it is looked up when a message is shown, not when the script loads).
function schNotify(message, type = 'info') {
    const toast = typeof window !== 'undefined' ? window.showToast : null;
    if (typeof toast === 'function') toast(message, type);
    else if (type === 'error' && typeof alert === 'function') alert(message);
}
// A slug from a name: "Day 1, Saturday" -> "day-1-saturday".
function schSlugify(text) {
    return String(text || '').toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 100);
}
// Fill each slug from its name until someone types in the slug itself.
for (const [nameId, slugId] of [['f-schedule-name', 'f-schedule-slug'], ['f-schedule-name-2', 'f-schedule-slug-2']]) {
    const nameInput = document.getElementById(nameId);
    const slugInput = document.getElementById(slugId);
    if (!nameInput || !slugInput) continue;
    slugInput.addEventListener('input', () => { slugInput.dataset.touched = slugInput.value ? '1' : ''; });
    nameInput.addEventListener('input', () => { if (!slugInput.dataset.touched) slugInput.value = schSlugify(nameInput.value); });
}
function schWhen(iso) {
    if (!iso) return '-';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '-';
    return d.toLocaleString(undefined, { weekday: 'short', hour: '2-digit', minute: '2-digit' });
}

// The four totals at the top are for the whole server, whichever event or schedule is open.
function schSetTotals(events) {
    const sum = (k) => events.reduce((n, e) => n + (Number(e[k]) || 0), 0);
    document.getElementById('stat-events').textContent = events.length;
    document.getElementById('stat-active').textContent = events.filter(e => e.is_active).length;
    document.getElementById('stat-schedules').textContent = sum('schedule_count');
    document.getElementById('stat-runs').textContent = sum('run_count');
}

async function schRefreshTotals() {
    try {
        const data = await (await fetch(`/manage/${guildId}/schedule/events`)).json();
        if (Array.isArray(data.events)) schSetTotals(data.events);
    } catch (_) { /* totals stay as they were */ }
}

async function loadEvents() {
    currentEventId = null;
    currentScheduleId = null;
    document.getElementById('schedule-breadcrumb').style.display = 'none';
    document.getElementById('events-view').style.display = 'block';
    document.getElementById('schedules-view').style.display = 'none';
    document.getElementById('items-view').style.display = 'none';

    try {
        const response = await fetch(`/manage/${guildId}/schedule/events`);
        const data = await response.json();
        const events = Array.isArray(data.events) ? data.events : [];
        schSetTotals(events);
        const list = document.getElementById('events-list');
        if (!events.length) {
            list.replaceChildren(schState('No events yet', 'Create an event, then add a schedule for each day of it.',
                schButton('Create event', 'btn-primary', 'create-event')));
            return;
        }
        list.replaceChildren(...events.map(event => {
            const row = schEl('div', 'cf-list-item cf-list-item--multi');
            const main = schEl('div', 'cf-list-main');
            const title = schEl('p', 'cf-list-title');
            const open = schEl('button', 'sch-open', event.name);
            open.type = 'button';
            open.dataset.schAction = 'open-event';
            open.dataset.id = event.id;
            open.dataset.name = event.name || '';
            title.append(open, schEl('span', `cf-pill ${event.is_active ? 'is-ok' : ''}`.trim(), event.is_active ? 'Active' : 'Inactive'));
            const meta = schEl('p', 'cf-list-meta');
            const slug = schEl('span');
            slug.append(schIcon('fas fa-link'), ` ${event.slug || ''}`);
            meta.append(slug);
            if (event.twitch_channel) {
                const tw = schEl('span');
                tw.append(schIcon('fab fa-twitch'), ` ${event.twitch_channel}`);
                meta.append(tw);
            }
            main.append(title, meta);
            if (event.description) main.append(schEl('p', 'cf-list-body', event.description));
            const actions = schEl('div', 'cf-list-actions');
            actions.append(
                schButton('Open', 'btn-primary', 'open-event', { id: event.id, name: event.name }),
                schButton(event.is_active ? 'Pause event' : 'Make event active', 'btn-secondary', 'toggle-event', { id: event.id, active: event.is_active ? '0' : '1' }, event.is_active ? 'pause' : 'play'),
                schButton('Delete event', 'btn-danger', 'delete-event', { id: event.id }, 'trash'),
            );
            row.append(main, actions);
            return row;
        }));
    } catch (error) {
        console.error('Error loading events:', error);
        schNotify('Failed to load events', 'error');
    }
}

function setCrumb(id, text) {
    const crumb = document.getElementById(id);
    if (!text) { crumb.replaceChildren(); return; }
    crumb.replaceChildren(schIcon('fas fa-chevron-right'), ` ${text}`);
}

async function loadSchedules(eventId, eventName) {
    currentEventId = eventId;
    currentEventData = { id: eventId, name: eventName };
    document.getElementById('schedule-breadcrumb').style.display = 'flex';
    setCrumb('breadcrumb-event', eventName);
    setCrumb('breadcrumb-schedule', '');
    document.getElementById('events-view').style.display = 'none';
    document.getElementById('schedules-view').style.display = 'block';
    document.getElementById('items-view').style.display = 'none';

    try {
        const response = await fetch(`/manage/${guildId}/schedule/events/${eventId}/schedules`);
        const data = await response.json();
        const schedules = Array.isArray(data.schedules) ? data.schedules : [];
        schRefreshTotals();

        const parts = [schViewHead(`Schedules in ${eventName}`, schButton('Add schedule', 'btn-primary', 'add-schedule', { event: eventId }))];
        if (!schedules.length) {
            parts.push(schState('No schedules yet', 'Add a schedule for each day or block of the event.',
                schButton('Add schedule', 'btn-primary', 'add-schedule', { event: eventId })));
        }
        for (const schedule of schedules) {
            const row = schEl('div', 'cf-list-item cf-list-item--multi');
            const main = schEl('div', 'cf-list-main');
            const title = schEl('p', 'cf-list-title');
            const open = schEl('button', 'sch-open', schedule.name);
            open.type = 'button';
            open.dataset.schAction = 'open-schedule';
            open.dataset.id = schedule.id;
            open.dataset.name = schedule.name || '';
            title.append(open);
            const meta = schEl('p', 'cf-list-meta');
            const when = schEl('span');
            when.append(schIcon('fas fa-clock'), ` ${schedule.start_time ? new Date(schedule.start_time).toLocaleString() : 'No start time set'}`);
            meta.append(when);
            main.append(title, meta);
            if (schedule.description) main.append(schEl('p', 'cf-list-body', schedule.description));
            const actions = schEl('div', 'cf-list-actions');
            actions.append(
                schButton('Open', 'btn-primary', 'open-schedule', { id: schedule.id, name: schedule.name }),
                schButton('Delete schedule', 'btn-danger', 'delete-schedule', { id: schedule.id }, 'trash'),
            );
            row.append(main, actions);
            parts.push(row);
        }
        document.getElementById('schedules-view').replaceChildren(...parts);
    } catch (error) {
        console.error('Error loading schedules:', error);
        schNotify('Failed to load schedules', 'error');
    }
}

// The runs on screen, by id, so Edit fills its form from the data and not from markup.
let schRuns = new Map();

async function loadItems(scheduleId, scheduleName) {
    currentScheduleId = scheduleId;
    currentScheduleData = { id: scheduleId, name: scheduleName };
    setCrumb('breadcrumb-schedule', scheduleName);
    document.getElementById('schedules-view').style.display = 'none';
    document.getElementById('items-view').style.display = 'block';

    try {
        const response = await fetch(`/manage/${guildId}/schedule/schedules/${scheduleId}/items`);
        const data = await response.json();
        const items = Array.isArray(data.items) ? data.items : [];
        schRefreshTotals();
        schRuns = new Map(items.map(item => [String(item.id), item]));

        const total = items.filter(i => i.status !== 'skipped')
            .reduce((sum, i) => sum + (Number(i.estimate_seconds) || 0) + (Number(i.setup_seconds) || 0), 0);
        const done = items.filter(i => i.status === 'completed').length;
        const sub = items.length
            ? `${items.length} run${items.length === 1 ? '' : 's'}, ${formatSeconds(total)} with setup${done ? `, ${done} done` : ''}`
            : '';
        const hasPlan = items.some(i => i.projected_start);
        const parts = [schViewHead(`Runs in ${scheduleName}`, schButton('Add run', 'btn-primary', 'add-run', { schedule: scheduleId }), sub)];
        if (!items.length) {
            parts.push(schState('No runs yet', 'Add the runs in the order they will be played.',
                schButton('Add run', 'btn-primary', 'add-run', { schedule: scheduleId })));
        } else {
            const wrap = schEl('div', 'cf-table-wrap');
            const table = schEl('table', 'cf-table cf-table--stack');
            table.id = 'runs-table';
            const thead = schEl('thead');
            const hr = schEl('tr');
            const heads = [['#', 'run-position']].concat(hasPlan ? [['Starts']] : [], [['Game'], ['Category'], ['Runners'], ['Estimate'], ['Setup'], ['Status'], ['Actions', 'cf-cell-end']]);
            for (const [label, cls] of heads) {
                const th = schEl('th', cls || null, label);
                th.scope = 'col';
                hr.append(th);
            }
            thead.append(hr);
            const tbody = schEl('tbody');
            tbody.id = 'runs-tbody';
            items.forEach((item, index) => {
                const status = item.status || 'pending';
                const tr = schEl('tr', `status-${status}`);
                tr.dataset.itemId = item.id;
                const cell = (label, text, cls) => {
                    const td = schEl('td', cls || null, text);
                    td.dataset.label = label;
                    tr.append(td);
                    return td;
                };
                cell('#', String(index + 1), 'run-position');
                if (hasPlan) cell('Starts', status === 'skipped' ? '-' : schWhen(item.projected_start), 'sch-time');
                cell('Game', item.game_name, 'sch-game');
                cell('Category', item.category || '-', 'cf-cell-muted');
                cell('Runners', item.runners || '-', 'cf-cell-muted');
                cell('Estimate', formatSeconds(item.estimate_seconds), 'sch-time');
                cell('Setup', formatSeconds(item.setup_seconds), 'sch-time cf-cell-muted');
                cell('Status', null).append(schPill(status));
                const actionsCell = schEl('td', 'cf-cell-end');
                const actions = schEl('div', 'cf-inline sch-run-actions');
                if (status !== 'running' && status !== 'completed') actions.append(schButton('Start run', 'btn-success', 'run-status', { id: item.id, status: 'running' }, 'play'));
                if (status === 'running') actions.append(schButton('Mark run complete', 'btn-primary', 'run-status', { id: item.id, status: 'completed' }, 'check'));
                actions.append(
                    schButton('Edit run', 'btn-secondary', 'edit-run', { id: item.id }, 'edit'),
                    schButton('Delete run', 'btn-danger', 'delete-run', { id: item.id }, 'trash'),
                );
                actionsCell.append(actions);
                tr.append(actionsCell);
                tbody.append(tr);
            });
            table.append(thead, tbody);
            wrap.append(table);
            parts.push(wrap);
        }
        document.getElementById('items-view').replaceChildren(...parts);
    } catch (error) {
        console.error('Error loading items:', error);
        schNotify('Failed to load runs', 'error');
    }
}

document.getElementById('schedule-content').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-sch-action]');
    if (!btn) return;
    const d = btn.dataset;
    const id = Number(d.id);
    switch (d.schAction) {
        case 'create-event': return showCreateEventModal();
        case 'open-event': return loadSchedules(id, d.name);
        case 'toggle-event': return toggleEventStatus(id, d.active === '1');
        case 'delete-event': return deleteEvent(id);
        case 'add-schedule': return showCreateScheduleModal(Number(d.event));
        case 'open-schedule': return loadItems(id, d.name);
        case 'delete-schedule': return deleteSchedule(id);
        case 'add-run': return showAddRunModal(Number(d.schedule));
        case 'run-status': return setRunStatus(id, d.status);
        case 'delete-run': return deleteRun(id);
        case 'edit-run': {
            const item = schRuns.get(String(d.id));
            if (item) showEditRunModal(item.id, item.game_name || '', item.category || '', item.runners || '', item.estimate_seconds, item.setup_seconds, item.notes || '');
            return undefined;
        }
        default: return undefined;
    }
});

function showCreateEventModal() {
    document.getElementById('createEventForm').reset();
    new bootstrap.Modal(document.getElementById('createEventModal')).show();
}

function showCreateScheduleModal(eventId) {
    document.getElementById('createScheduleForm').reset();
    document.getElementById('scheduleEventId').value = eventId;
    new bootstrap.Modal(document.getElementById('createScheduleModal')).show();
}

function showAddRunModal(scheduleId) {
    document.getElementById('addRunForm').reset();
    document.getElementById('runScheduleId').value = scheduleId;
    new bootstrap.Modal(document.getElementById('addRunModal')).show();
}

function showEditRunModal(itemId, gameName, category, runners, estimateSeconds, setupSeconds, notes) {
    document.getElementById('editItemId').value = itemId;
    document.getElementById('editGameName').value = gameName;
    document.getElementById('editCategory').value = category;
    document.getElementById('editRunners').value = runners;
    document.getElementById('editEstimate').value = formatSeconds(estimateSeconds);
    document.getElementById('editSetup').value = formatSeconds(setupSeconds);
    document.getElementById('editNotes').value = notes;
    new bootstrap.Modal(document.getElementById('editRunModal')).show();
}

async function createEvent(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);

    try {
        const response = await fetch(`/manage/${guildId}/schedule/events`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: formData.get('name'),
                slug: formData.get('slug'),
                description: formData.get('description'),
                twitchChannel: formData.get('twitchChannel')
            })
        });

        const data = await response.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createEventModal')).hide();
            schNotify('Event created', 'success');
            loadEvents();
        } else {
            schNotify(data.error || 'Failed to create event', 'error');
        }
    } catch (error) {
        console.error('Error creating event:', error);
        schNotify('Failed to create event', 'error');
    }
}

async function createSchedule(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const eventId = formData.get('eventId');

    try {
        const response = await fetch(`/manage/${guildId}/schedule/events/${eventId}/schedules`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: formData.get('name'),
                slug: formData.get('slug'),
                description: formData.get('description'),
                // datetime-local is the browser's own time; the database keeps UTC, like /schedule list create.
                startTime: (function (v) {
                    var d = v ? new Date(v) : null;
                    return d && !isNaN(d) ? d.toISOString().slice(0, 19).replace('T', ' ') : null;
                })(formData.get('startTime'))
            })
        });

        const data = await response.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createScheduleModal')).hide();
            schNotify('Schedule created', 'success');
            loadSchedules(eventId, currentEventData.name);
        } else {
            schNotify(data.error || 'Failed to create schedule', 'error');
        }
    } catch (error) {
        console.error('Error creating schedule:', error);
        schNotify('Failed to create schedule', 'error');
    }
}

async function addRun(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const scheduleId = formData.get('scheduleId');

    try {
        const response = await fetch(`/manage/${guildId}/schedule/schedules/${scheduleId}/items`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                gameName: formData.get('gameName'),
                category: formData.get('category'),
                runners: formData.get('runners'),
                estimateSeconds: parseTimeToSeconds(formData.get('estimate')),
                setupSeconds: parseTimeToSeconds(formData.get('setup')),
                notes: formData.get('notes')
            })
        });

        const data = await response.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('addRunModal')).hide();
            schNotify('Run added', 'success');
            loadItems(scheduleId, currentScheduleData.name);
        } else {
            schNotify(data.error || 'Failed to add run', 'error');
        }
    } catch (error) {
        console.error('Error adding run:', error);
        schNotify('Failed to add run', 'error');
    }
}

async function updateRun(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const itemId = formData.get('itemId');

    try {
        const response = await fetch(`/manage/${guildId}/schedule/items/${itemId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                gameName: formData.get('gameName'),
                category: formData.get('category'),
                runners: formData.get('runners'),
                estimateSeconds: parseTimeToSeconds(formData.get('estimate')),
                setupSeconds: parseTimeToSeconds(formData.get('setup')),
                notes: formData.get('notes')
            })
        });

        const data = await response.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('editRunModal')).hide();
            schNotify('Run updated', 'success');
            loadItems(currentScheduleId, currentScheduleData.name);
        } else {
            schNotify(data.error || 'Failed to update run', 'error');
        }
    } catch (error) {
        console.error('Error updating run:', error);
        schNotify('Failed to update run', 'error');
    }
}

async function deleteEvent(eventId) {
    if (!confirm('Delete this event and all its schedules? This cannot be undone.')) return;

    try {
        const response = await fetch(`/manage/${guildId}/schedule/events/${eventId}`, {
            method: 'DELETE'
        });

        const data = await response.json();
        if (data.success) {
            schNotify('Event deleted', 'success');
            loadEvents();
        } else {
            schNotify(data.error || 'Failed to delete event', 'error');
        }
    } catch (error) {
        console.error('Error deleting event:', error);
        schNotify('Failed to delete event', 'error');
    }
}

async function deleteSchedule(scheduleId) {
    if (!confirm('Delete this schedule and all its runs? This cannot be undone.')) return;

    try {
        const response = await fetch(`/manage/${guildId}/schedule/schedules/${scheduleId}`, {
            method: 'DELETE'
        });

        const data = await response.json();
        if (data.success) {
            schNotify('Schedule deleted', 'success');
            loadSchedules(currentEventId, currentEventData.name);
        } else {
            schNotify(data.error || 'Failed to delete schedule', 'error');
        }
    } catch (error) {
        console.error('Error deleting schedule:', error);
        schNotify('Failed to delete schedule', 'error');
    }
}

async function deleteRun(itemId) {
    if (!confirm('Delete this run?')) return;

    try {
        const response = await fetch(`/manage/${guildId}/schedule/items/${itemId}`, {
            method: 'DELETE'
        });

        const data = await response.json();
        if (data.success) {
            schNotify('Run deleted', 'success');
            loadItems(currentScheduleId, currentScheduleData.name);
        } else {
            schNotify(data.error || 'Failed to delete run', 'error');
        }
    } catch (error) {
        console.error('Error deleting run:', error);
        schNotify('Failed to delete run', 'error');
    }
}

async function toggleEventStatus(eventId, isActive) {
    try {
        const response = await fetch(`/manage/${guildId}/schedule/events/${eventId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isActive })
        });

        const data = await response.json();
        if (data.success) {
            schNotify(`Event ${isActive ? 'activated' : 'deactivated'}`, 'success');
            loadEvents();
        } else {
            schNotify(data.error || 'Failed to update event', 'error');
        }
    } catch (error) {
        console.error('Error updating event:', error);
        schNotify('Failed to update event', 'error');
    }
}

async function setRunStatus(itemId, status) {
    try {
        const response = await fetch(`/manage/${guildId}/schedule/items/${itemId}/status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
        });

        const data = await response.json();
        if (data.success) {
            schNotify(`Run ${status}`, 'success');
            loadItems(currentScheduleId, currentScheduleData.name);
        } else {
            schNotify(data.error || 'Failed to update status', 'error');
        }
    } catch (error) {
        console.error('Error updating status:', error);
        schNotify('Failed to update status', 'error');
    }
}

function formatSeconds(seconds) {
    if (!seconds) return '0:00:00';
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = seconds % 60;
    return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
}

function parseTimeToSeconds(timeStr) {
    if (!timeStr) return 0;
    const parts = timeStr.split(':').map(Number);
    if (parts.length === 3) {
        return parts[0] * 3600 + parts[1] * 60 + parts[2];
    }
    return 0;
}

