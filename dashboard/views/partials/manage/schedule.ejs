<%#
  Schedules: events (a marathon), their schedules (a day) and the runs in each, for speedrun-style
  event schedules. Everything loads and saves through the JSON routes under
  /manage/:guildId/schedule/…; the three views (#events-view, #schedules-view, #items-view) are
  filled by the script below. Built on the settings-row kit (cf-settings.css); ids, field names and
  handlers are unchanged. The rows and table the script builds (.schedule-card, .data-table, …) are
  styled below to read as kit list rows and a kit table.
%>
<style>
    /* Schedules page: the breadcrumb, the event/schedule name buttons and the runs table's
       running/completed rows. Lists, states, pills and the table are the kit's. */
    .sch-crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 0 var(--cf-4); font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    .sch-crumbs a { color: var(--cf-accent-fg); text-decoration: none; }
    .sch-crumbs a:hover { text-decoration: underline; }
    .sch-crumbs i { font-size: 0.75em; }
    .sch-crumbs .fa-home { display: none; }
    .sch-open { margin: 0; padding: 0; border: 0; background: none; font: inherit; color: var(--cf-text); text-align: left; cursor: pointer; overflow-wrap: anywhere; }
    .sch-open:hover { color: var(--cf-accent-fg); text-decoration: underline; }
    .sch-open:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 2px; border-radius: var(--cf-radius-sm); }
    .cf-rows .sch-view-head { align-items: center; flex-direction: row; flex-wrap: wrap; border-bottom: 1px solid var(--cf-border);
        background: color-mix(in srgb, var(--cf-surface-2) 45%, var(--cf-surface)); }
    .cf-rows .sch-view-head .cf-list-title { font-size: var(--cf-text-md); }
    .cf-rows .sch-view-head + .cf-list-item { border-top: 0; }
    #runs-table .run-position { width: 40px; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    #runs-table .sch-game { font-weight: 600; }
    #runs-table .sch-time { font-family: var(--cf-mono); font-variant-numeric: tabular-nums; }
    #runs-table tbody tr.status-running { background: color-mix(in srgb, var(--cf-success) 8%, transparent); }
    #runs-table tbody tr.status-completed { opacity: 0.6; }
    .sch-run-actions { justify-content: flex-end; gap: 6px; }
    .sch-modal .cf-rows .cf-row { grid-template-columns: minmax(0, 1fr); }
    .cf-rows .sch-view-head .sch-view-sub { margin: 2px 0 0; font-size: var(--cf-text-xs); color: var(--cf-text-3); font-weight: 400; }
    .cf-rows .sch-view-head > div { min-width: 0; flex: 1 1 auto; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-calendar-alt"></i>
                <span>Schedules</span>
            </div>
            <div class="page-section-subtitle">Events, the days in each, and the runs on each day.</div>
        </div>
    </div>

    <dl class="cf-kpis" id="schedule-stats" aria-label="Schedules at a glance">
        <div class="cf-kpi"><dt>Events</dt><dd class="cf-kpi-value" id="stat-events">0</dd></div>
        <div class="cf-kpi"><dt>Active events</dt><dd class="cf-kpi-value" id="stat-active">0</dd></div>
        <div class="cf-kpi"><dt>Schedules</dt><dd class="cf-kpi-value" id="stat-schedules">0</dd></div>
        <div class="cf-kpi"><dt>Runs</dt><dd class="cf-kpi-value" id="stat-runs">0</dd></div>
    </dl>

    <section class="cf-section" aria-labelledby="sch-events-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="sch-events-title">Events</h2>
                <p class="cf-section-desc">Open an event to see its schedules, then a schedule to see and run its list of runs.</p>
            </div>
            <div class="cf-section-actions">
                <button type="button" class="btn btn-primary btn-sm" onclick="showCreateEventModal()">Create event</button>
            </div>
        </header>

        <nav id="schedule-breadcrumb" class="sch-crumbs" style="display: none;" aria-label="Where you are">
            <a href="#" onclick="loadEvents(); return false;"><i class="fas fa-home"></i> All events</a>
            <span id="breadcrumb-event"></span>
            <span id="breadcrumb-schedule"></span>
        </nav>

        <div class="cf-rows">
            <div id="schedule-content">
                <div id="events-view">
                    <div id="events-list">
                        <div class="cf-state cf-state--empty">
                            <p class="cf-state-title">No events yet</p>
                            <p class="cf-state-text">Create an event, then add a schedule for each day of it.</p>
                            <button type="button" class="btn btn-primary" onclick="showCreateEventModal()">Create event</button>
                        </div>
                    </div>
                </div>

                <div id="schedules-view" style="display: none;"></div>

                <div id="items-view" style="display: none;"></div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade sch-modal" id="createEventModal" tabindex="-1" aria-labelledby="cfk-sch-event-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfk-sch-event-title">Create event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createEventForm" onsubmit="createEvent(event)">
                <div class="modal-body">
                    <div class="cf-rows">
                        <div class="cf-row">
                            <div class="cf-row-text"><label class="cf-row-label" for="f-schedule-name">Name</label></div>
                            <div class="cf-row-control">
                                <input id="f-schedule-name" type="text" class="form-control" name="name" required maxlength="255" placeholder="Summer speedathon 2026" data-sch-slug-for="f-schedule-slug">
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="f-schedule-slug">Slug</label>
                                <p class="cf-row-desc" id="f-schedule-slug-desc">The event's public page is /schedule/&lt;slug&gt;, so no other event on any server can use the same one. Lowercase letters, numbers and hyphens; filled in from the name.</p>
                            </div>
                            <div class="cf-row-control">
                                <input id="f-schedule-slug" type="text" class="form-control" name="slug" required maxlength="100" placeholder="summer-speedathon-2026" pattern="[a-z0-9-]+" aria-describedby="f-schedule-slug-desc">
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text"><label class="cf-row-label" for="f-schedule-description">Description</label><p class="cf-row-desc">Optional.</p></div>
                            <div class="cf-row-control">
                                <textarea id="f-schedule-description" class="form-control" name="description" rows="3" placeholder="A weekend marathon of community runs"></textarea>
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="f-schedule-twitchchannel">Twitch channel</label>
                                <p class="cf-row-desc" id="f-schedule-twitchchannel-desc">Optional. The channel the event streams on.</p>
                            </div>
                            <div class="cf-row-control">
                                <input id="f-schedule-twitchchannel" type="text" class="form-control" name="twitchChannel" maxlength="100" placeholder="channelname" aria-describedby="f-schedule-twitchchannel-desc">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create event</button>
                </div>
            </form>
        </div>
    </div>
</div>

