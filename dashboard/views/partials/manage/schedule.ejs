    new bootstrap.Modal(document.getElementById('editRunModal')).show();
}

async function createEvent(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);

    try {
        const response = await fetch(`/manage/${guildId}/schedule/events`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: formData.get('name'),
                slug: formData.get('slug'),
                description: formData.get('description'),
                twitchChannel: formData.get('twitchChannel')
            })
        });

        const data = await response.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('createEventModal')).hide();
            showToast('Event created successfully', 'success');
            loadEvents();
        } else {
            showToast(data.error || 'Failed to create event', 'error');
        }
    } catch (error) {
        console.error('Error creating event:', error);
        showToast('Failed to create event', 'error');
    }
}

