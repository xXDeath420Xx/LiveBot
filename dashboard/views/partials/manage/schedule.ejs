                            <div class="cf-row-control">
                                <input id="f-schedule-name-2" type="text" class="form-control" name="name" required maxlength="255" placeholder="Day 1, Saturday" data-sch-slug-for="f-schedule-slug-2">
                            </div>
                        </div>
                        <div class="cf-row">
                            <div class="cf-row-text">
                                <label class="cf-row-label" for="f-schedule-slug-2">Slug</label>
                                <p class="cf-row-desc" id="f-schedule-slug-2-desc">Lowercase letters, numbers and hyphens; filled in from the name.</p>
                            </div>
                            <div class="cf-row-control">
                                <input id="f-schedule-slug-2" type="text" class="form-control" name="slug" required maxlength="100" placeholder="day-1" pattern="[a-z0-9-]+" aria-describedby="f-schedule-slug-2-desc">
