}

function showEditRunModal(itemId, gameName, category, runners, estimateSeconds, setupSeconds, notes) {
    document.getElementById('editItemId').value = itemId;
    document.getElementById('editGameName').value = gameName;
    document.getElementById('editCategory').value = category;
    document.getElementById('editRunners').value = runners;
    document.getElementById('editEstimate').value = formatSeconds(estimateSeconds);
    document.getElementById('editSetup').value = formatSeconds(setupSeconds);
