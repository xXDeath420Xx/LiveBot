}

function showCreateScheduleModal(eventId) {
    document.getElementById('createScheduleForm').reset();
    document.getElementById('scheduleEventId').value = eventId;
    new bootstrap.Modal(document.getElementById('createScheduleModal')).show();
}

function showAddRunModal(scheduleId) {
    document.getElementById('addRunForm').reset();
