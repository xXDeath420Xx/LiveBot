<style>
/* Overview/Hub Page Styles */
.hub-hero {
    background: linear-gradient(135deg, #0a0e27 0%, #1e2028 50%, #16181d 100%);
    border-radius: 20px;
    padding: 48px 40px;
    margin-bottom: 40px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(167, 139, 250, 0.2);
}

.hub-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 50%, rgba(167, 139, 250, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 70% 50%, rgba(155, 89, 182, 0.15) 0%, transparent 50%);
    pointer-events: none;
}

.hub-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
}

.hub-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff 0%, #b9bbbe 50%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 12px;
}

.hub-hero p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
}

.modules-section {
    margin-bottom: 56px;
}

.section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(167, 139, 250, 0.3), transparent);
}

.module-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
}

.module-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    text-decoration: none;
    display: block;
    position: relative;
    overflow: hidden;
}

.module-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #a78bfa 0%, #b959f6 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
}

.module-card:hover {
    transform: translateY(-8px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(167, 139, 250, 0.5);
    box-shadow: 0 16px 40px rgba(167, 139, 250, 0.25);
}

.module-card:hover::before {
    transform: scaleX(1);
}

.module-icon {
    font-size: 2.5rem;
    margin-bottom: 16px;
    color: #a78bfa;
    transition: all 0.3s ease;
}

.module-card:hover .module-icon {
    transform: scale(1.15);
    color: #6b77f4;
    filter: drop-shadow(0 0 12px rgba(167, 139, 250, 0.5));
}

.module-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
}

.module-description {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 6px;
    line-height: 1.4;
}

/* Quick Stats */
.quick-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
}

.quick-stat {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 14px;
    padding: 24px 20px;
    text-align: center;
    transition: all 0.3s ease;
}

.quick-stat:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(167, 139, 250, 0.4);
}

.quick-stat-icon {
    font-size: 1.75rem;
    color: #a78bfa;
    margin-bottom: 12px;
}

.quick-stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    background: linear-gradient(135deg, #a78bfa 0%, #b959f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
    margin-bottom: 4px;
}

.quick-stat-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
</style>

<!-- Hub Hero -->
