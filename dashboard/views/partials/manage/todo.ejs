<%#
  Task lists: create a list (posted as an embed in a channel) and manage its items. Everything goes
  through the JSON API (/api/guilds/:id/todo); the script below renders the lists. Built on the
  settings-row kit (cf-settings.css); ids are unchanged.
%>
<style>
    /* Each list is its own kit panel (built by the script below): a header row, one row per task, an add box. */
    #todoListsContainer > .todo-list + .todo-list { margin-top: var(--cf-4); }
    .todo-item { display: flex; align-items: center; gap: var(--cf-3); padding: 8px var(--cf-5); min-width: 0; }
    .todo-item-num { font-size: var(--cf-text-xs); font-weight: 600; color: var(--cf-text-3); min-width: 22px; font-variant-numeric: tabular-nums; }
    .todo-item-state { flex: none; width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--cf-border-strong); }
    .todo-item.completed .todo-item-state { background: var(--cf-success); border-color: var(--cf-success); }
    .todo-item-text { flex: 1; min-width: 0; font-size: var(--cf-text-sm); color: var(--cf-text); overflow-wrap: anywhere; }
    .todo-item.completed .todo-item-text { text-decoration: line-through; color: var(--cf-text-3); }
    .todo-item-actions { display: flex; gap: 4px; opacity: 0; transition: opacity var(--cf-fast) var(--cf-ease); }
    .todo-item:hover .todo-item-actions, .todo-item:focus-within .todo-item-actions { opacity: 1; }
    @media (hover: none) { .todo-item-actions { opacity: 1; } }
    .todo-action-btn {
        width: 28px; height: 28px; border: 1px solid var(--cf-border); border-radius: var(--cf-radius-sm); cursor: pointer;
        display: flex; align-items: center; justify-content: center; font-size: 0.7rem; background: var(--cf-surface-2); color: var(--cf-text-2);
        transition: border-color var(--cf-fast) var(--cf-ease), color var(--cf-fast) var(--cf-ease);
    }
    .todo-btn-done:hover { color: var(--cf-success); border-color: var(--cf-success); }
    .todo-btn-undo:hover { color: var(--cf-warning); border-color: var(--cf-warning); }
    .todo-btn-delete:hover { color: var(--cf-danger); border-color: var(--cf-danger); }
    .todo-action-btn:focus-visible { outline: 2px solid var(--cf-accent); outline-offset: 1px; }
    .todo-count { margin-left: 6px; font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    .todo-empty-items { padding: var(--cf-3) var(--cf-5); font-size: var(--cf-text-sm); color: var(--cf-text-3); }
    @media (max-width: 640px) {
        .todo-item { padding-left: var(--cf-4); padding-right: var(--cf-4); }
        .todo-action-btn { width: 40px; height: 40px; }
    }
</style>

<div class="page-section" id="cfk-todo-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title"><i class="fas fa-tasks"></i> <span>Task lists</span></div>
            <div class="page-section-subtitle">Manage them here or with <code>/todo</code> in Discord.</div>
        </div>
    </div>

    <section class="cf-section" aria-labelledby="todo-new-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="todo-new-title">New task list</h2>
                <p class="cf-section-desc">The bot posts the list in the channel and edits it as tasks are added and ticked off. One list per channel.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form id="todoCreateForm" data-no-ajax>
                <div class="cf-row cf-row--stack">
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="todoTitle">Title</label>
                            <input type="text" id="todoTitle" class="form-control" placeholder="Task List" maxlength="256" data-no-fieldkit>
                        </div>
                        <div class="cf-field">
                            <label for="todoChannel">Channel</label>
                            <select id="todoChannel" class="form-select" required>
                                <%- include('../kit/_pick-options', { items: channels, selected: null, kind: 'text', only: 'text', empty: 'Choose a channel' }) %>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-foot-note cf-status-line" id="cfk-todo-status" role="status" aria-live="polite"></span>
                    <button type="submit" class="btn btn-primary">Create list</button>
                </div>
            </form>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="todo-lists-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="todo-lists-title">Your lists <span class="todo-count" id="cfk-todo-count"></span></h2>
                <p class="cf-section-desc">Tick items off, add new ones or remove a list.</p>
            </div>
        </header>
        <div id="todoListsContainer">
            <%- include('../kit/_state', { kind: 'loading', title: 'Loading task lists', text: null, id: null, boxed: true, compact: false }) %>
        </div>
    </section>
</div>

<script>
(function() {
    var GUILD_ID = '<%= guild.id %>';
    var API = '/api/guilds/' + GUILD_ID + '/todo';

    // window.showToast is defined further down manage-tailwind.ejs than this partial, so look it up when a
    // message is shown, not now. Without it the message goes to the status line (never a blocking alert).
    function toast(m, kind) {
        if (typeof window.showToast === 'function') return window.showToast(m, kind);
        var s = document.getElementById('cfk-todo-status');
        if (!s) return;
        s.className = 'cf-foot-note cf-status-line' + (kind === 'error' ? ' is-bad' : kind === 'success' ? ' is-ok' : '');
        s.textContent = m;
    }

    // Every change goes through here, so a failed save is reported instead of silently reloading.
    async function send(url, method, body) {
        var resp = await fetch(url, { method: method, credentials: 'include', headers: body ? { 'Content-Type': 'application/json' } : undefined, body: body ? JSON.stringify(body) : undefined });
        var data = await resp.json().catch(function () { return {}; });
        if (!resp.ok || data.success === false) throw new Error(data.error || ('Request failed (' + resp.status + ')'));
        return data;
    }

    async function loadLists() {
        try {
            var resp = await fetch(API, { credentials: 'include' });
            var data = await resp.json();
            if (!data.success) throw new Error(data.error);
            document.getElementById('cfk-todo-count').textContent = data.lists.length;
            renderLists(data.lists);
        } catch(e) {
            var box = document.createElement('div');
            box.className = 'cf-state cf-state--error cf-state--boxed';
            box.setAttribute('role', 'alert');
            var t = document.createElement('p');
            t.className = 'cf-state-title';
            t.textContent = 'Could not load the task lists';
            var d = document.createElement('p');
            d.className = 'cf-state-text';
            d.textContent = e.message || 'Refresh the page to try again.';
            box.appendChild(t);
            box.appendChild(d);
            document.getElementById('todoListsContainer').replaceChildren(box);
        }
    }

    function icon(name) {
        var i = document.createElement('i');
        i.className = 'fas ' + name;
        i.setAttribute('aria-hidden', 'true');
        return i;
    }

    function renderLists(lists) {
        var container = document.getElementById('todoListsContainer');
        container.textContent = '';

        if (!lists.length) {
            var empty = document.createElement('div');
            empty.className = 'cf-state cf-state--boxed';
            var emptyTitle = document.createElement('p');
            emptyTitle.className = 'cf-state-title';
            emptyTitle.textContent = 'No task lists yet';
            var emptyText = document.createElement('p');
            emptyText.className = 'cf-state-text';
            emptyText.textContent = 'Create one above, or use /todo create in Discord.';
            empty.appendChild(emptyTitle);
            empty.appendChild(emptyText);
            container.appendChild(empty);
            return;
        }

        lists.forEach(function(list) {
            var card = document.createElement('div');
            card.className = 'todo-list cf-rows';

            // Header
            var header = document.createElement('div');
            header.className = 'todo-list-header cf-list-item cf-list-item--multi';
            var headerInfo = document.createElement('div');
            headerInfo.className = 'cf-list-main';
            var titleEl = document.createElement('p');
            titleEl.className = 'cf-list-title';
            titleEl.textContent = list.title;
            var chanEl = document.createElement('p');
            chanEl.className = 'cf-list-meta';
            var completed = list.items.filter(function(i) { return i.completed; }).length;
            chanEl.textContent = '#' + (list.channel_name || list.channel_id) + ' \u00b7 ' + completed + ' of ' + list.items.length + ' done';
            headerInfo.appendChild(titleEl);
            headerInfo.appendChild(chanEl);
            header.appendChild(headerInfo);
            var delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'btn btn-sm btn-danger';
            delBtn.textContent = 'Delete list';
            delBtn.setAttribute('aria-label', 'Delete the list ' + list.title);
            delBtn.addEventListener('click', function() { deleteList(list.id); });
            var headerActions = document.createElement('div');
            headerActions.className = 'cf-list-actions';
            headerActions.appendChild(delBtn);
            header.appendChild(headerActions);
            card.appendChild(header);

            // Items
            if (!list.items.length) card.appendChild(Object.assign(document.createElement('div'), { className: 'todo-empty-items', textContent: 'No tasks yet.' }));
            list.items.forEach(function(item, idx) {
                var row = document.createElement('div');
                row.className = 'todo-item' + (item.completed ? ' completed' : '');

                var num = document.createElement('span');
                num.className = 'todo-item-num';
                num.textContent = (idx + 1) + '.';
                row.appendChild(num);

                var state = document.createElement('span');
                state.className = 'todo-item-state';
                state.setAttribute('role', 'img');
                state.setAttribute('aria-label', item.completed ? 'Done' : 'To do');
                row.appendChild(state);

                var text = document.createElement('span');
                text.className = 'todo-item-text';
                text.textContent = item.task;
                row.appendChild(text);

                var actions = document.createElement('div');
                actions.className = 'todo-item-actions';
                if (item.completed) {
                    var undoBtn = document.createElement('button');
                    undoBtn.className = 'todo-action-btn todo-btn-undo';
                    undoBtn.title = 'Undo';
                    undoBtn.type = 'button';
                    undoBtn.setAttribute('aria-label', 'Undo');
                    undoBtn.appendChild(icon('fa-undo'));
                    undoBtn.addEventListener('click', function() { toggleItem(list.id, item.id, 0); });
                    actions.appendChild(undoBtn);
                } else {
                    var doneBtn = document.createElement('button');
                    doneBtn.className = 'todo-action-btn todo-btn-done';
                    doneBtn.title = 'Complete';
                    doneBtn.type = 'button';
                    doneBtn.setAttribute('aria-label', 'Complete');
                    doneBtn.appendChild(icon('fa-check'));
                    doneBtn.addEventListener('click', function() { toggleItem(list.id, item.id, 1); });
                    actions.appendChild(doneBtn);
                }
                var rmBtn = document.createElement('button');
                rmBtn.className = 'todo-action-btn todo-btn-delete';
                rmBtn.title = 'Remove';
                rmBtn.type = 'button';
                rmBtn.setAttribute('aria-label', 'Remove');
                rmBtn.appendChild(icon('fa-times'));
                rmBtn.addEventListener('click', function() { removeItem(list.id, item.id); });
                actions.appendChild(rmBtn);
                row.appendChild(actions);

                card.appendChild(row);
            });

            // Add form
            var addForm = document.createElement('div');
            addForm.className = 'todo-add-form cf-section-foot';
            var addGroup = document.createElement('div');
            addGroup.className = 'cf-input-group';
            addForm.appendChild(addGroup);
            var addInput = document.createElement('input');
            addInput.type = 'text';
            addInput.className = 'form-control';
            addInput.placeholder = 'Add a task';
            addInput.maxLength = 200;
            addInput.setAttribute('data-no-fieldkit', '');
            addInput.setAttribute('aria-label', 'New task for ' + list.title);
            addInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { addItem(list.id, addInput); } });
            addGroup.appendChild(addInput);
            var addBtn = document.createElement('button');
            addBtn.type = 'button';
            addBtn.className = 'btn btn-secondary';
            addBtn.textContent = 'Add';
            addBtn.addEventListener('click', function() { addItem(list.id, addInput); });
            addGroup.appendChild(addBtn);
            card.appendChild(addForm);

            container.appendChild(card);
        });
    }

    async function addItem(listId, input) {
        var task = input.value.trim();
        if (!task) return;
        try { await send(API + '/' + listId + '/items', 'POST', { task: task }); input.value = ''; }
        catch (e) { toast(e.message, 'error'); }
        loadLists();
    }

    async function toggleItem(listId, itemId, completed) {
        try { await send(API + '/' + listId + '/items/' + itemId, 'PATCH', { completed: completed }); }
        catch (e) { toast(e.message, 'error'); }
        loadLists();
    }

    async function removeItem(listId, itemId) {
        try { await send(API + '/' + listId + '/items/' + itemId, 'DELETE'); }
        catch (e) { toast(e.message, 'error'); }
        loadLists();
    }

    async function deleteList(listId) {
        if (!confirm('Delete this task list? Its message in Discord is deleted too.')) return;
        try { await send(API + '/' + listId, 'DELETE'); }
        catch (e) { toast(e.message, 'error'); }
        loadLists();
    }

    document.getElementById('todoCreateForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        var status = document.getElementById('cfk-todo-status');
        var title = document.getElementById('todoTitle').value.trim() || 'Task List';
        var channelId = document.getElementById('todoChannel').value;
        if (!channelId) { status.className = 'cf-foot-note cf-status-line is-bad'; status.textContent = 'Choose a channel.'; return; }
        status.className = 'cf-foot-note cf-status-line is-busy'; status.textContent = 'Creating…';
        try {
            await send(API, 'POST', { title: title, channel_id: channelId });
            document.getElementById('todoTitle').value = '';
            status.className = 'cf-foot-note cf-status-line is-ok'; status.textContent = 'Created and posted.';
        } catch (err) {
            status.className = 'cf-foot-note cf-status-line is-bad'; status.textContent = err.message;
        }
        loadLists();
    });

    loadLists();
})();
</script>
