<%#
  Confessions: the channel, approval switch and review channel (JSON POST confessions/config),
  the review queue (approve / reject) and the latest decisions, loaded from GET confessions.
  Built on the settings-row kit (cf-settings.css); ids, field names and script hooks unchanged.
%>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-user-secret"></i>
                <span>Anonymous confessions</span>
            </div>
            <div class="page-section-subtitle">Settings, the review queue and recent decisions. Members never see who sent a confession; server admins can show the sender here for 30 days to deal with abuse, and each time is written to the audit log.</div>
        </div>
    </div>

    <form id="confession-config-form" onsubmit="saveConfessionConfig(event)">
        <section class="cf-section" aria-labelledby="cfs-config-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="cfs-config-title">Settings</h2>
                    <p class="cf-section-desc">Where confessions are posted, and whether staff approve them first.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfs-enabled">Confessions</label>
                        <p class="cf-row-desc" id="cfs-enabled-desc">Members can use /confess (also /fun confess) in this server.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="cfs-enabled" name="enabled" data-feature-switch aria-describedby="cfs-enabled-desc">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="confession-channel">Confession channel</label>
                        <p class="cf-row-desc" id="confession-channel-desc">Approved confessions are posted here.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="confession-channel" name="channel_id" class="form-select" required aria-describedby="confession-channel-desc">
                            <%- include('../kit/_pick-options', { items: (typeof channels !== 'undefined' && channels) || [], selected: null, kind: 'channel', only: 'text', empty: 'Choose a channel' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="require-approval">Require approval</label>
                        <p class="cf-row-desc" id="require-approval-desc">Staff approve each confession before it is posted.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="require-approval" name="require_approval" aria-describedby="require-approval-desc">
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="mod-channel">Review channel</label>
                        <p class="cf-row-desc" id="mod-channel-desc">Where confessions waiting for approval are sent.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="mod-channel" name="mod_channel_id" class="form-select" aria-describedby="mod-channel-desc">
                            <%- include('../kit/_pick-options', { items: (typeof channels !== 'undefined' && channels) || [], selected: null, kind: 'channel', only: 'text', empty: 'None (review here only)' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfs-min-length">Length</label>
                        <p class="cf-row-desc" id="cfs-length-desc">The shortest and longest confession members can send, in characters.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-group">
                            <div class="cf-input-unit"><span class="cf-unit">from</span><input id="cfs-min-length" type="number" class="form-control" name="min_length" min="1" max="1000" value="10" aria-describedby="cfs-length-desc"></div>
                            <div class="cf-input-unit"><span class="cf-unit">to</span><input id="cfs-max-length" type="number" class="form-control" name="max_length" min="10" max="4000" value="1000" aria-label="Longest confession" aria-describedby="cfs-length-desc"></div>
                        </div>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfs-cooldown">Wait between confessions</label>
                        <p class="cf-row-desc" id="cfs-cooldown-desc">How long a member waits after one confession before sending another. 0 means no wait.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit"><input id="cfs-cooldown" type="number" class="form-control" name="cooldown_minutes" min="0" max="1440" step="1" value="5" aria-describedby="cfs-cooldown-desc"><span class="cf-unit">minutes</span></div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-status-line cf-foot-note" id="cfs-save-status" role="status"></span>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <section class="cf-section" aria-labelledby="cfs-pending-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="cfs-pending-title">Waiting for review <span id="cfs-pending-count"></span></h2>
                <p class="cf-section-desc">Approve to post a confession, or reject it.</p>
            </div>
        </header>
        <div class="cf-rows" id="pending-confessions">
            <%- include('../kit/_state', { kind: 'loading', title: 'Loading confessions', text: null, id: null, boxed: false, compact: true }) %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="cfs-recent-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="cfs-recent-title">Recent decisions</h2>
                <p class="cf-section-desc">Confessions approved or rejected lately.</p>
            </div>
        </header>
        <div class="cf-rows" id="recent-confessions">
            <%- include('../kit/_state', { kind: 'loading', title: 'Loading confessions', text: null, id: null, boxed: false, compact: true }) %>
        </div>
    </section>
</div>

<script>
async function loadConfessions() {
    try {
        const response = await fetch('/manage/<%= guild.id %>/confessions');
        const data = await response.json();

        // Load config
        if (data.config) {
            document.getElementById('confession-channel').value = data.config.channel_id || '';
            document.getElementById('require-approval').checked = data.config.require_approval || false;
            document.getElementById('mod-channel').value = data.config.mod_channel_id || '';
            // Never set up yet: on by default, as the bot treats a new row.
            const on = document.getElementById('cfs-enabled');
            on.checked = data.config.channel_id ? !!data.config.enabled : true;
            on.dispatchEvent(new Event('change'));
            document.getElementById('cfs-min-length').value = data.config.min_length || 10;
            document.getElementById('cfs-max-length').value = data.config.max_length || 1000;
            document.getElementById('cfs-cooldown').value = data.config.cooldown_minutes ?? 5;
        }
        cfsSyncReview();
        const waiting = Array.isArray(data.pendingConfessions) ? data.pendingConfessions.length : 0;
        document.getElementById('cfs-pending-count').textContent = waiting ? '(' + waiting + ')' : '';

        // Confession text is what members wrote: it only ever goes in as text (textContent).
        window.cfsCanReveal = !!data.canRevealSender;
        renderConfessions(document.getElementById('pending-confessions'), data.pendingConfessions, true, 'Nothing waiting for review');
        renderConfessions(document.getElementById('recent-confessions'), data.recentConfessions, false, 'No confessions yet');

    } catch (error) {
        console.error('Error loading confessions:', error);
        document.getElementById('pending-confessions').replaceChildren(confessionState('Could not load confessions', true));
    }
}

function confessionEl(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
}

function confessionState(title, isError) {
    const box = confessionEl('div', `cf-state cf-state--${isError ? 'error' : 'empty'} cf-state--compact`);
    if (isError) box.setAttribute('role', 'alert');
    box.append(confessionEl('p', 'cf-state-title', title));
    return box;
}

/** One list row per confession: the text, when it was sent, and Approve / Reject or the decision. */
function renderConfessions(box, list, pending, emptyTitle) {
    if (!Array.isArray(list) || !list.length) {
        box.replaceChildren(confessionState(emptyTitle, false));
        return;
    }
    box.replaceChildren(...list.map((confession) => {
        const row = confessionEl('div', 'cf-list-item cf-list-item--multi');
        const main = confessionEl('div', 'cf-list-main');
        main.append(confessionEl('p', 'cf-list-body is-pre', confession.content));
        const meta = confessionEl('p', 'cf-list-meta');
        meta.append(confessionEl('span', null, `Submitted ${new Date(confession.submitted_at).toLocaleString()}`));
        if (!pending) {
            const ok = confession.approved === 1;
            meta.append(confessionEl('span', `cf-pill ${ok ? 'is-ok' : 'is-bad'}`, ok ? 'Approved' : 'Rejected'));
        }
        main.append(meta);
        row.append(main);
        const actions = confessionEl('div', 'cf-list-actions');
        let buttons = 0;
        // Server admins only (the server decides; this just hides the button for everyone else).
        if (window.cfsCanReveal && Number(confession.sender_available) === 1) {
            const who = confessionEl('button', 'btn btn-sm btn-secondary', 'Show sender');
            who.type = 'button';
            who.title = 'Only server admins see this. Each time is written to the audit log.';
            who.addEventListener('click', () => revealSender(Number(confession.id), who, meta));
            actions.append(who);
            buttons++;
        }
        if (pending) {
            const id = Number(confession.id);
            const approve = confessionEl('button', 'btn btn-sm btn-primary', 'Approve');
            approve.type = 'button';
            approve.addEventListener('click', () => approveConfession(id));
            const reject = confessionEl('button', 'btn btn-sm btn-danger', 'Reject');
            reject.type = 'button';
            reject.addEventListener('click', () => rejectConfession(id));
            actions.append(approve, reject);
            buttons += 2;
        }
        if (buttons) row.append(actions);
        return row;
    }));
}

// The review channel only matters while approval is required.
function cfsSyncReview() {
    const row = document.getElementById('mod-channel').closest('.cf-row');
    if (row) row.hidden = !document.getElementById('require-approval').checked;
}
document.getElementById('require-approval').addEventListener('change', cfsSyncReview);

function cfsSay(text, ok) {
    if (window.showToast) { window.showToast(text, ok ? 'success' : 'error'); return; }
    const line = document.getElementById('cfs-save-status');
    line.textContent = text;
    line.classList.toggle('is-ok', !!ok);
    line.classList.toggle('is-bad', !ok);
}

async function saveConfessionConfig(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const config = {
        enabled: document.getElementById('cfs-enabled').checked,
        min_length: Number(formData.get('min_length')) || 10,
        max_length: Number(formData.get('max_length')) || 1000,
        cooldown_minutes: Math.min(Math.max(Math.round(Number(formData.get('cooldown_minutes'))) || 0, 0), 1440),
        channel_id: formData.get('channel_id'),
        require_approval: document.getElementById('require-approval').checked,
        mod_channel_id: formData.get('mod_channel_id') || null
    };

    try {
        const response = await fetch('/manage/<%= guild.id %>/confessions/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(config)
        });

        const line = document.getElementById('cfs-save-status');
        line.textContent = response.ok ? 'Saved' : 'Could not save the settings.';
        line.classList.toggle('is-ok', response.ok);
        line.classList.toggle('is-bad', !response.ok);
    } catch (error) {
        console.error('Error saving config:', error);
        const line = document.getElementById('cfs-save-status');
        line.textContent = 'Could not reach the server.';
        line.classList.add('is-bad');
    }
}

async function approveConfession(id) {
    try {
        const response = await fetch(`/manage/<%= guild.id %>/confessions/${id}/approve`, {
            method: 'POST'
        });

        if (response.ok) {
            cfsSay('Confession approved and posted.', true);
            loadConfessions();
        } else {
            cfsSay('Could not approve the confession.', false);
        }
    } catch (error) {
        console.error('Error approving confession:', error);
        cfsSay('Could not approve the confession.', false);
    }
}

/** Admins only: fetch who sent a confession (the server writes an audit-log entry first). */
async function revealSender(id, button, meta) {
    button.disabled = true;
    try {
        const response = await fetch(`/manage/<%= guild.id %>/confessions/${id}/sender`, { method: 'POST' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.sender) {
            cfsSay(data.error || 'Could not look up the sender.', false);
            button.disabled = false;
            return;
        }
        const label = data.sender.name ? `${data.sender.name}, ${data.sender.id}` : `User ${data.sender.id} (no longer in the server)`;
        meta.append(confessionEl('span', 'cf-pill', `Sent by ${label}`));
        button.remove();
    } catch (error) {
        console.error('Error revealing sender:', error);
        cfsSay('Could not look up the sender.', false);
        button.disabled = false;
    }
}

async function rejectConfession(id) {
    try {
        const response = await fetch(`/manage/<%= guild.id %>/confessions/${id}/reject`, {
            method: 'POST'
        });

        if (response.ok) {
            cfsSay('Confession rejected.', true);
            loadConfessions();
        } else {
            cfsSay('Could not reject the confession.', false);
        }
    } catch (error) {
        console.error('Error rejecting confession:', error);
        cfsSay('Could not reject the confession.', false);
    }
}

loadConfessions();
</script>
