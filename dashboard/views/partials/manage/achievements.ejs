<%#
  Achievements: the on/off switch and announcement channel (JSON POST achievements/config), the
  leaderboard, every achievement and the latest unlocks (all loaded from GET achievements).
  Built on the settings-row kit (cf-settings.css); ids, field names and script hooks unchanged.
%>
<style>
    .ach-who { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .ach-rank { min-width: 1.5rem; font-weight: 600; color: var(--cf-text-3); font-variant-numeric: tabular-nums; }
    .ach-avatar { width: 28px; height: 28px; border-radius: 50%; flex: none; display: inline-flex; align-items: center; justify-content: center;
        background: var(--cf-surface-2); color: var(--cf-text-3); font-size: var(--cf-text-xs); }
    .ach-avatar.is-sm { width: 18px; height: 18px; font-size: 9px; }
    .ach-progress { display: flex; align-items: center; gap: 8px; color: var(--cf-text-2); font-size: var(--cf-text-sm); font-variant-numeric: tabular-nums; flex: none; }
    .ach-bar { width: 80px; height: 6px; border-radius: 3px; background: var(--cf-surface-3); overflow: hidden; }
    .ach-bar > span { display: block; height: 100%; background: var(--cf-accent); }
    .ach-icon { width: 36px; height: 36px; flex: none; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--cf-radius);
        background: var(--cf-surface-2); border: 1px solid var(--cf-border); font-size: 1.1rem; color: var(--cf-text-3); }
    .ach-name { margin: 0; font-weight: 600; color: var(--cf-text); }
    .ach-desc { margin: 2px 0 0; color: var(--cf-text-3); }
    .ach-meta { font-size: var(--cf-text-xs); color: var(--cf-text-3); display: flex; align-items: center; gap: 6px; }
    .ach-list-scroll { max-height: 520px; overflow-y: auto; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-medal"></i>
                <span>Achievements</span>
            </div>
            <div class="page-section-subtitle">The leaderboard, every badge and the latest unlocks.</div>
        </div>
    </div>

    <dl class="cf-kpis" aria-label="Achievements at a glance">
        <div class="cf-kpi"><dt>Achievements</dt><dd class="cf-kpi-value" id="stat-total">-</dd></div>
        <div class="cf-kpi"><dt>Members tracked</dt><dd class="cf-kpi-value" id="stat-users">-</dd></div>
        <div class="cf-kpi"><dt>Unlocks</dt><dd class="cf-kpi-value" id="stat-unlocks">-</dd></div>
    </dl>

    <form id="achievement-config-form" onsubmit="saveAchievementConfig(event)">
        <section class="cf-section" aria-labelledby="ach-config-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="ach-config-title">Settings</h2>
                    <p class="cf-section-desc">Whether unlocks are announced, and where. Progress is tracked and rewards are paid either way.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="enabled">Announce unlocks</label>
                        <p class="cf-row-desc" id="enabled-desc">Post each unlock in the announcement channel below. Nothing is posted while this is off or no channel is set.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="enabled" name="enabled" data-feature-switch aria-describedby="enabled-desc">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="announcement-channel">Announcement channel</label>
                        <p class="cf-row-desc" id="announcement-channel-desc">Where unlocks are posted. With no channel, unlocks are not announced.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="announcement-channel" name="announcement_channel_id" class="form-select" aria-describedby="announcement-channel-desc">
                            <%- include('../kit/_pick-options', { items: (typeof channels !== 'undefined' && channels) || [], selected: null, kind: 'channel', only: 'text', empty: 'No announcements' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-status-line cf-foot-note" id="ach-save-status" role="status"></span>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <section class="cf-section" aria-labelledby="ach-board-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ach-board-title">Leaderboard</h2>
                <p class="cf-section-desc">Members with the most achievements unlocked.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-list" id="achievement-leaderboard">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading the leaderboard', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="ach-all-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ach-all-title">All achievements (<span id="stat-total-list">-</span>)</h2>
                <p class="cf-section-desc">Every achievement members can unlock in this server.</p>
            </div>
            <div class="cf-section-actions" id="ach-search-head" hidden>
                <label class="cf-search"><i class="fas fa-search" aria-hidden="true"></i><input type="search" class="form-control" id="ach-search" placeholder="Search achievements" aria-label="Search achievements"></label>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-list ach-list-scroll" id="achievements-list">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading achievements', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="ach-recent-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="ach-recent-title">Recent unlocks</h2>
                <p class="cf-section-desc">The last ten achievements members unlocked.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-list" id="recent-achievements">
                <%- include('../kit/_state', { kind: 'loading', title: 'Loading recent unlocks', text: null, id: null, boxed: false, compact: true }) %>
            </div>
        </div>
    </section>
</div>

<script>
// Everything from the API (achievement names, descriptions, categories, icons, member names) goes
// in as text: rows are built with createElement / textContent, never as HTML strings.
function achEl(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
}
function userLabel(row) {
    // Resolved display name, or the ID (cf-user.js names it) for members who left the server.
    if (row.username) return achEl('span', null, row.username);
    const span = achEl('span', null, String(row.user_id ?? ''));
    span.dataset.userId = String(row.user_id ?? '');
    span.setAttribute('data-user-plain', '');
    return span;
}
function userAvatar(row, size) {
    if (row.avatar && /^https:\/\//.test(String(row.avatar))) {
        const img = achEl('img', `ach-avatar${size < 24 ? ' is-sm' : ''}`);
        img.src = String(row.avatar);
        img.alt = '';
        img.width = size;
        img.height = size;
        return img;
    }
    const span = achEl('span', `ach-avatar${size < 24 ? ' is-sm' : ''}`);
    span.setAttribute('aria-hidden', 'true');
    span.append(achEl('i', 'fas fa-user'));
    return span;
}
function achIcon(emoji) {
    // An achievement's own icon is an emoji (text); without one, a trophy.
    const box = achEl('span', 'ach-icon');
    box.setAttribute('aria-hidden', 'true');
    if (emoji) box.textContent = String(emoji);
    else box.append(achEl('i', 'fas fa-trophy'));
    return box;
}
function achState(title, isError) {
    const box = achEl('div', `cf-state cf-state--${isError ? 'error' : 'empty'} cf-state--compact`);
    if (isError) box.setAttribute('role', 'alert');
    box.append(achEl('p', 'cf-state-title', title));
    return box;
}
function fillList(box, rows, emptyTitle, build) {
    if (!box) return;
    if (!Array.isArray(rows) || !rows.length) box.replaceChildren(achState(emptyTitle, false));
    else box.replaceChildren(...rows.map(build));
}

async function loadAchievements() {
    try {
        const response = await fetch('/manage/<%= guild.id %>/achievements');
        const data = await response.json();

        // Load config
        if (data.config) {
            document.getElementById('enabled').checked = data.config.enabled || false;
            document.getElementById('enabled').dispatchEvent(new Event('change'));
            document.getElementById('announcement-channel').value = data.config.announcement_channel_id || '';
        }

        // Update stats from the real (guild-scoped) totals the API returns —
        // not the length of the capped leaderboard/recent arrays.
        document.getElementById('stat-users').textContent = data.stats?.total_users ?? 0;
        document.getElementById('stat-unlocks').textContent = data.stats?.total_completed ?? 0;
        const totalDefs = data.achievements?.length ?? 0;
        document.getElementById('stat-total').textContent = totalDefs;
        const totalListEl = document.getElementById('stat-total-list');
        if (totalListEl) totalListEl.textContent = totalDefs;

        fillList(document.getElementById('achievement-leaderboard'), data.topUsers, 'No achievements unlocked yet', (user, index) => {
            const done = Number(user.completed_achievements) || 0;
            const total = Number(user.total_achievements) || 0;
            const percent = total > 0 ? Math.round((done / total) * 100) : 0;
            const row = achEl('div', 'cf-list-item');
            const who = achEl('div', 'cf-list-main ach-who');
            who.append(achEl('span', 'ach-rank', String(index + 1)), userAvatar(user, 28), userLabel(user));
            const progress = achEl('div', 'ach-progress');
            const bar = achEl('span', 'ach-bar');
            const fill = achEl('span');
            fill.style.width = `${percent}%`;
            bar.append(fill);
            progress.append(bar, achEl('span', null, `${done}/${total}`));
            row.append(who, progress);
            return row;
        });

        fillList(document.getElementById('achievements-list'), data.achievements, 'No achievements yet', (achievement) => {
            const row = achEl('div', 'cf-list-item');
            const who = achEl('div', 'cf-list-main ach-who');
            const text = achEl('div');
            text.append(achEl('p', 'ach-name', achievement.name), achEl('p', 'ach-desc', achievement.description || ''));
            who.append(achIcon(achievement.icon_emoji), text);
            row.append(who);
            if (achievement.category) row.append(achEl('span', 'cf-pill', achievement.category));
            return row;
        });

        // A search box once the list is long enough to need one.
        const all = document.getElementById('achievements-list');
        const search = document.getElementById('ach-search');
        document.getElementById('ach-search-head').hidden = totalDefs <= 15;
        search.oninput = () => {
            const q = search.value.trim().toLowerCase();
            Array.from(all.children).forEach((row) => { row.hidden = !!q && !row.textContent.toLowerCase().includes(q); });
        };

        fillList(document.getElementById('recent-achievements'), (data.recentAchievements || []).slice(0, 10), 'No recent unlocks', (unlock) => {
            const row = achEl('div', 'cf-list-item');
            const who = achEl('div', 'cf-list-main ach-who');
            const text = achEl('div');
            const meta = achEl('div', 'ach-meta');
            meta.append(userAvatar(unlock, 18), userLabel(unlock));
            text.append(achEl('p', 'ach-name', unlock.name), meta);
            who.append(achIcon(unlock.icon), text);
            row.append(who, achEl('span', 'ach-meta', new Date(unlock.completed_at).toLocaleDateString()));
            return row;
        });
    } catch (error) {
        console.error('Error loading achievements:', error);
        document.getElementById('achievement-leaderboard').replaceChildren(achState('Could not load achievements', true));
    }
}

function achStatus(text, ok) {
    const line = document.getElementById('ach-save-status');
    line.textContent = text;
    line.classList.toggle('is-ok', !!ok);
    line.classList.toggle('is-bad', !ok);
}

async function saveAchievementConfig(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const config = {
        enabled: document.getElementById('enabled').checked,
        announcement_channel_id: formData.get('announcement_channel_id') || null
    };

    try {
        const response = await fetch('/manage/<%= guild.id %>/achievements/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(config)
        });

        achStatus(response.ok ? 'Saved' : 'Could not save the settings.', response.ok);
    } catch (error) {
        console.error('Error saving config:', error);
        achStatus('Could not reach the server.', false);
    }
}

loadAchievements();
</script>
