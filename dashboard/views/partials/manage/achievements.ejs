<style>
/* Achievements Page Styles */
.achievements-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
}

.achievement-stat-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 14px;
    padding: 24px 20px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.achievement-stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.achievement-stat-card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(251, 191, 36, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(251, 191, 36, 0.15);
}

.achievement-stat-card:hover::before {
    opacity: 1;
}

.achievement-stat-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    font-weight: 500;
}

.achievement-stat-value {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Section Cards */
.achievements-section {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(167, 139, 250, 0.15);
    border-radius: 16px;
    margin-bottom: 24px;
    overflow: hidden;
}

.achievements-section-header {
    background: rgba(167, 139, 250, 0.08);
    padding: 20px 24px;
    border-bottom: 1px solid rgba(167, 139, 250, 0.15);
    display: flex;
    align-items: center;
    gap: 12px;
}

.achievements-section-header i {
    color: #fbbf24;
    font-size: 1.25rem;
}

.achievements-section-header h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
}

.achievements-section-body {
    padding: 24px;
}

/* Configuration Form */
.config-form-group {
    margin-bottom: 20px;
}

.config-form-group:last-child {
    margin-bottom: 0;
}

.config-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 8px;
}

.config-help {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    margin-top: 6px;
}

.toggle-container {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.toggle-container:hover {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(167, 139, 250, 0.3);
}

.toggle-container input[type="checkbox"] {
    width: 44px;
    height: 24px;
    appearance: none;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    position: relative;
    cursor: pointer;
    transition: all 0.3s ease;
}

.toggle-container input[type="checkbox"]::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: white;
    top: 3px;
    left: 3px;
    transition: transform 0.3s ease;
}

.toggle-container input[type="checkbox"]:checked {
    background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
}

.toggle-container input[type="checkbox"]:checked::before {
    transform: translateX(20px);
}

.toggle-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
}

/* Achievement Item */
.achievement-item {
    padding: 20px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.2s ease;
}

.achievement-item:last-child {
    margin-bottom: 0;
}

.achievement-item:hover {
    background: rgba(0, 0, 0, 0.3);
    border-color: rgba(251, 191, 36, 0.3);
    transform: translateX(4px);
}

.achievement-icon-wrapper {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(245, 158, 11, 0.2));
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(251, 191, 36, 0.3);
    font-size: 1.75rem;
    flex-shrink: 0;
}

.achievement-info {
    flex: 1;
}

.achievement-name {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 4px 0;
}

.achievement-description {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 8px 0;
}

.achievement-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgba(167, 139, 250, 0.15);
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 6px;
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
}

/* Leaderboard Entry */
.leaderboard-entry {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.2s ease;
}

.leaderboard-entry:last-child {
    border-bottom: none;
}

.leaderboard-entry:hover {
    background: rgba(167, 139, 250, 0.06);
}

.leaderboard-rank {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(245, 158, 11, 0.2));
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 8px;
    font-weight: 700;
    color: #fbbf24;
    font-size: 0.85rem;
    margin-right: 14px;
}

.leaderboard-user {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
}

.leaderboard-progress {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.85rem;
}

.leaderboard-progress-bar {
    width: 80px;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    overflow: hidden;
}

.leaderboard-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #7c3aed 0%, #a78bfa 100%);
    border-radius: 3px;
}

/* Loading & Empty States */
.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px;
    color: rgba(255, 255, 255, 0.5);
}

.loading-state i {
    font-size: 2rem;
    margin-bottom: 12px;
    color: #a78bfa;
}

.empty-message {
    text-align: center;
    padding: 32px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.95rem;
}

.achievements-list-container {
    max-height: 500px;
    overflow-y: auto;
}

.achievements-list-container::-webkit-scrollbar {
    width: 6px;
}

.achievements-list-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
}

.achievements-list-container::-webkit-scrollbar-thumb {
    background: rgba(167, 139, 250, 0.3);
    border-radius: 3px;
}

.achievements-list-container::-webkit-scrollbar-thumb:hover {
    background: rgba(167, 139, 250, 0.5);
}
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-medal"></i>
                <span>Achievements</span>
            </div>
            <div class="page-section-subtitle">
                Track and reward user accomplishments with custom achievements
            </div>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="achievements-stats-grid">
        <div class="achievement-stat-card">
            <div class="achievement-stat-label">Total Achievements</div>
            <div class="achievement-stat-value">25</div>
        </div>
        <div class="achievement-stat-card">
            <div class="achievement-stat-label">Users Tracked</div>
            <div class="achievement-stat-value" id="stat-users">-</div>
        </div>
        <div class="achievement-stat-card">
            <div class="achievement-stat-label">Total Unlocks</div>
            <div class="achievement-stat-value" id="stat-unlocks">-</div>
        </div>
    </div>

    <!-- Configuration -->
    <div class="achievements-section">
        <div class="achievements-section-header">
            <i class="fas fa-cog"></i>
            <h3>Configuration</h3>
        </div>
        <div class="achievements-section-body">
            <form id="achievement-config-form" onsubmit="saveAchievementConfig(event)">
                <div class="config-form-group">
                    <label class="toggle-container">
                        <input type="checkbox" id="enabled" name="enabled">
                        <span class="toggle-label">Enable Achievement System</span>
                    </label>
                </div>

                <div class="config-form-group">
                    <label class="config-label">Announcement Channel</label>
                    <select id="announcement-channel" name="announcement_channel_id" class="form-select">
                        <option value="">Select a channel...</option>
                        <% if (channels) { %>
                            <% channels.filter(c => c.type === 0).forEach(channel => { %>
                                <option value="<%= channel.id %>">#<%= channel.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                    <div class="config-help">Channel where achievement unlocks will be announced</div>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    <span>Save Settings</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Leaderboard -->
    <div class="achievements-section">
        <div class="achievements-section-header">
            <i class="fas fa-trophy"></i>
            <h3>Achievement Leaderboard</h3>
        </div>
        <div id="achievement-leaderboard">
            <div class="loading-state">
                <i class="fas fa-spinner fa-spin"></i>
                <span>Loading leaderboard...</span>
            </div>
        </div>
    </div>

    <!-- All Achievements -->
    <div class="achievements-section">
        <div class="achievements-section-header">
            <i class="fas fa-list"></i>
            <h3>All Achievements (25 Total)</h3>
        </div>
        <div class="achievements-section-body">
            <div class="achievements-list-container" id="achievements-list">
                <div class="loading-state">
                    <i class="fas fa-spinner fa-spin"></i>
                    <span>Loading achievements...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Unlocks -->
    <div class="achievements-section">
        <div class="achievements-section-header">
            <i class="fas fa-history"></i>
            <h3>Recent Unlocks</h3>
        </div>
        <div id="recent-achievements">
            <div class="loading-state">
                <i class="fas fa-spinner fa-spin"></i>
                <span>Loading recent unlocks...</span>
            </div>
        </div>
    </div>
</div>

<script>
async function loadAchievements() {
    try {
        const response = await fetch('/manage/<%= guild.id %>/achievements');
        const data = await response.json();

        // Load config
        if (data.config) {
            document.getElementById('enabled').checked = data.config.enabled || false;
            document.getElementById('announcement-channel').value = data.config.announcement_channel_id || '';
        }

        // Update stats
        document.getElementById('stat-users').textContent = data.topUsers?.length || 0;
        document.getElementById('stat-unlocks').textContent = data.recentAchievements?.length || 0;

        // Load leaderboard
        if (data.topUsers && data.topUsers.length > 0) {
            const leaderboardHtml = data.topUsers.map((user, index) => {
                const percent = user.total_achievements > 0
                    ? Math.round((user.completed_achievements / user.total_achievements) * 100)
                    : 0;
                return `
                    <div class="leaderboard-entry">
                        <div style="display: flex; align-items: center;">
                            <span class="leaderboard-rank">${index + 1}</span>
                            <span class="leaderboard-user">User ${user.user_id.substring(0, 8)}...</span>
                        </div>
                        <div class="leaderboard-progress">
                            <div class="leaderboard-progress-bar">
                                <div class="leaderboard-progress-fill" style="width: ${percent}%"></div>
                            </div>
                            <span>${user.completed_achievements}/${user.total_achievements}</span>
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('achievement-leaderboard').innerHTML = leaderboardHtml;
        } else {
            document.getElementById('achievement-leaderboard').innerHTML = '<div class="empty-message">No achievements unlocked yet</div>';
        }

        // Load all achievements
        if (data.achievements && data.achievements.length > 0) {
            const achievementsHtml = data.achievements.map(achievement => `
                <div class="achievement-item">
                    <div class="achievement-icon-wrapper">${achievement.icon_emoji || '🏆'}</div>
                    <div class="achievement-info">
                        <h4 class="achievement-name">${achievement.name}</h4>
                        <p class="achievement-description">${achievement.description}</p>
                        <span class="achievement-category">${achievement.category}</span>
                    </div>
                </div>
            `).join('');
            document.getElementById('achievements-list').innerHTML = achievementsHtml;
        } else {
            document.getElementById('achievements-list').innerHTML = '<div class="empty-message">No achievements found</div>';
        }

        // Load recent achievements
        if (data.recentAchievements && data.recentAchievements.length > 0) {
            const recentHtml = data.recentAchievements.slice(0, 10).map(unlock => `
                <div class="leaderboard-entry">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 1.5rem;">${unlock.icon || '🏆'}</span>
                        <div>
                            <div style="font-weight: 500; color: #ffffff;">${unlock.name}</div>
                            <div style="font-size: 0.8rem; color: rgba(255,255,255,0.5);">User ${unlock.user_id.substring(0, 8)}...</div>
                        </div>
                    </div>
                    <div style="color: rgba(255,255,255,0.5); font-size: 0.85rem;">
                        ${new Date(unlock.completed_at).toLocaleDateString()}
                    </div>
                </div>
            `).join('');
            document.getElementById('recent-achievements').innerHTML = recentHtml;
        } else {
            document.getElementById('recent-achievements').innerHTML = '<div class="empty-message">No recent achievements</div>';
        }

    } catch (error) {
        console.error('Error loading achievements:', error);
        document.getElementById('achievement-leaderboard').innerHTML = '<div class="empty-message" style="color: #f87171;">Error loading data</div>';
    }
}

async function saveAchievementConfig(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const config = {
        enabled: document.getElementById('enabled').checked,
        announcement_channel_id: formData.get('announcement_channel_id') || null
    };

    try {
        const response = await fetch('/manage/<%= guild.id %>/achievements/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(config)
        });

        if (response.ok) {
            alert('Configuration saved successfully!');
        } else {
            alert('Failed to save configuration');
        }
    } catch (error) {
        console.error('Error saving config:', error);
        alert('Error saving configuration');
    }
}

loadAchievements();
</script>
