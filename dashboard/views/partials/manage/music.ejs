<%#
  Music: the module switch and DJ role, the AI DJ voice, playback options, playlist limits and the
  audio filters members may use. Five forms (POST music/config, dj, advanced, playlists,
  filters). Built on the settings-row kit (cf-settings.css); field names and ids are unchanged.
%>
<% const muCfg = (typeof musicConfig !== 'undefined' && musicConfig) || {}; %>
<style>
    .mu-filters { --cf-check-min: 9rem; }
</style>

<div class="page-section" id="cfk-mu-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-music"></i>
                <span>Music</span>
            </div>
            <div class="page-section-subtitle">Playback, the AI DJ, playlists and filters.</div>
        </div>
    </div>

    <form action="/manage/<%= guild.id %>/music/config" method="POST">
        <section class="cf-section" aria-labelledby="mu-general-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="mu-general-title">General</h2>
                    <p class="cf-section-desc">Whether music commands work here, and who controls them.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="musicEnabled">Music</label>
                        <p class="cf-row-desc" id="musicEnabled-desc">Members can play music in voice channels.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="musicEnabled" name="enabled" data-feature-switch aria-describedby="musicEnabled-desc" <%= muCfg.enabled ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-djroleid">DJ role</label>
                        <p class="cf-row-desc" id="f-music-djroleid-desc">When set, only members with this role, Administrators and someone alone in the voice channel can play and control music. Any listener can still start a vote to skip.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-music-djroleid" class="form-select" name="djRoleId" aria-describedby="f-music-djroleid-desc">
                            <%- include('../kit/_pick-options', { items: roles, selected: muCfg.dj_role_id || null, kind: 'role', empty: 'None' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <form action="/manage/<%= guild.id %>/music/dj" method="POST">
        <section class="cf-section" aria-labelledby="mu-dj-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="mu-dj-title">AI DJ</h2>
                    <p class="cf-section-desc">Announces tracks and talks between songs, like a radio DJ.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="djEnabled">AI DJ</label>
                        <p class="cf-row-desc" id="djEnabled-desc">Off unless you switch it on. The same switch as on the AI DJ page; it also needs Music on.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="djEnabled" name="djEnabled" aria-describedby="djEnabled-desc" <%= Number(muCfg.ai_dj_enabled) === 1 ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-djvoice">DJ voice</label>
                        <p class="cf-row-desc" id="f-music-djvoice-desc"><%= availableDJVoices ? availableDJVoices.length : 0 %> voices available.<% if (availableDJVoices && availableDJVoices.some(v => v.engine === 'kokoro')) { %> Kokoro voices sound more natural; Piper voices start speaking a little sooner.<% } %> Preview one before saving.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-music-djvoice" class="form-select" name="djVoice" aria-describedby="f-music-djvoice-desc">
                            <% if (availableDJVoices && availableDJVoices.length > 0) { %>
                                <%
                                // Group voices by category
                                const voicesByCategory = {};
                                availableDJVoices.forEach(voice => {
                                    if (!voicesByCategory[voice.category]) {
                                        voicesByCategory[voice.category] = [];
                                    }
                                    voicesByCategory[voice.category].push(voice);
                                });

                                // Sort categories: Piper's English first (the default engine), then the
                                // Kokoro groups, then every other language alphabetically.
                                const categoryRank = (c) => c === 'US English' ? 0 : c === 'British English' ? 1 : c.indexOf('Kokoro') === 0 ? 2 : 3;
                                const sortedCategories = Object.keys(voicesByCategory).sort((a, b) =>
                                    categoryRank(a) - categoryRank(b) || a.localeCompare(b));
                                // A saved voice that is not installed (or an old placeholder) stays selected,
                                // so saving this form never changes the DJ voice by accident.
                                const savedDjVoice = musicConfig && musicConfig.dj_voice;
                                const savedListed = !savedDjVoice || availableDJVoices.some(v => v.value === savedDjVoice);
                                %>
                                <% if (!savedListed) { %>
                                    <option value="<%= savedDjVoice %>" selected>Current: <%= savedDjVoice %> (not an installed voice)</option>
                                <% } %>
                                <% sortedCategories.forEach(category => { %>
                                    <% const voices = voicesByCategory[category]; %>
                                    <% if (voices.length > 0) { %>
                                        <optgroup label="<%= category %>">
                                            <% voices.forEach(voice => { %>
                                                <option value="<%= voice.value %>" <%= (musicConfig && musicConfig.dj_voice === voice.value) ? 'selected' : '' %>><%= voice.label %></option>
                                            <% }); %>
                                        </optgroup>
                                    <% } %>
                                <% }); %>
                            <% } else { %>
                                <option value="amy">US English, Amy (default)</option>
                            <% } %>
                        </select>
                        <div class="cf-inline">
                            <button type="button" class="btn btn-secondary btn-sm" id="preview-voice-btn" onclick="previewVoice()">Preview voice</button>
                            <span id="preview-status" class="cf-status-line" role="status" aria-live="polite"></span>
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <form action="/manage/<%= guild.id %>/music/advanced" method="POST">
        <section class="cf-section" aria-labelledby="mu-play-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="mu-play-title">Playback</h2>
                    <p class="cf-section-desc">What happens when the queue runs out, song requests and skipping.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="twentyFourSeven">Stay in voice (24/7)</label>
                        <p class="cf-row-desc" id="twentyFourSeven-desc">The bot stays in the voice channel when the queue is empty.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="twentyFourSeven" name="twentyFourSeven" aria-describedby="twentyFourSeven-desc" <%= (musicConfig && musicConfig.twenty_four_seven) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="autoplayEnabled">Autoplay</label>
                        <p class="cf-row-desc" id="autoplayEnabled-desc">Plays similar songs when the queue ends.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="autoplayEnabled" name="autoplayEnabled" aria-describedby="autoplayEnabled-desc" <%= (musicConfig && musicConfig.autoplay_enabled) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-autoplaysource">Autoplay picks songs from</label>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-music-autoplaysource" class="form-select" name="autoplaySource">
                            <option value="youtube" <%= (musicConfig && musicConfig.autoplay_source === 'youtube') ? 'selected' : '' %>>Similar songs (Last.fm)</option>
                            <option value="ai" <%= (musicConfig && musicConfig.autoplay_source === 'ai') ? 'selected' : '' %>>AI recommendations (Gemini)</option>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-requestchannelid">Song request channel</label>
                        <p class="cf-row-desc" id="f-music-requestchannelid-desc">Every message posted here is treated as a song request.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-music-requestchannelid" class="form-select" name="requestChannelId" aria-describedby="f-music-requestchannelid-desc">
                            <%- include('../kit/_pick-options', { items: channels, selected: muCfg.request_channel_id || null, kind: 'text', only: 'text', empty: 'Off' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="voteSkipEnabled">Vote to skip</label>
                        <p class="cf-row-desc" id="voteSkipEnabled-desc">Listeners vote before a song is skipped.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="voteSkipEnabled" name="voteSkipEnabled" aria-describedby="voteSkipEnabled-desc" <%= (musicConfig && musicConfig.vote_skip_enabled) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-voteskippercentage">Votes needed</label>
                        <p class="cf-row-desc" id="f-music-voteskippercentage-desc">Share of listeners who must vote, from 1 to 100 percent.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input id="f-music-voteskippercentage" type="number" class="form-control" name="voteSkipPercentage" value="<%= muCfg.vote_skip_percentage || 50 %>" min="1" max="100" aria-describedby="f-music-voteskippercentage-desc">
                            <span class="cf-unit">%</span>
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <form action="/manage/<%= guild.id %>/music/playlists" method="POST">
        <section class="cf-section" aria-labelledby="mu-pl-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="mu-pl-title">Playlists</h2>
                    <p class="cf-section-desc">Limits on the playlists members save.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-maxplaylists">Playlists per member</label>
                        <p class="cf-row-desc">From 1 to 50. Leave empty for no limit.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-music-maxplaylists" type="number" class="form-control" name="maxPlaylists" value="<%= Number(muCfg.max_playlists_per_user) > 0 ? muCfg.max_playlists_per_user : '' %>" min="1" max="50" placeholder="No limit">
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-music-maxsongsperplaylist">Songs per playlist</label>
                        <p class="cf-row-desc">From 10 to 1000. Leave empty for no limit.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-music-maxsongsperplaylist" type="number" class="form-control" name="maxSongsPerPlaylist" value="<%= Number(muCfg.max_songs_per_playlist) > 0 ? muCfg.max_songs_per_playlist : '' %>" min="10" max="1000" placeholder="No limit">
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <form action="/manage/<%= guild.id %>/music/filters" method="POST">
        <section class="cf-section" aria-labelledby="mu-filters-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="mu-filters-title">Audio filters</h2>
                    <p class="cf-section-desc">The filters members can turn on with /music filter and /music eq. Leave every box clear to allow them all.</p>
                </div>
                <div class="cf-section-actions">
                    <button type="button" class="btn btn-sm btn-secondary" data-mu-filters="all">Select all</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-mu-filters="none">Clear</button>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--stack">
                    <div class="cf-check-grid mu-filters">
                        <% const availableFilters = [['bassboost', 'Bass boost'], ['8D', '8D audio'], ['vaporwave', 'Vaporwave'], ['nightcore', 'Nightcore'], ['phaser', 'Phaser'], ['tremolo', 'Tremolo'], ['vibrato', 'Vibrato'], ['reverse', 'Reverse'], ['treble', 'Treble boost'], ['normalizer', 'Normaliser'], ['surrounding', 'Surround'], ['pulsator', 'Pulsator'], ['subboost', 'Sub boost'], ['karaoke', 'Karaoke'], ['flanger', 'Flanger'], ['gate', 'Gate'], ['haas', 'Haas'], ['mcompand', 'Compander']]; %>
                        <% availableFilters.forEach(([filter, label]) => { %>
                            <label class="cf-choice" for="filter-<%= filter %>">
                                <input type="checkbox" name="filters[]" value="<%= filter %>" id="filter-<%= filter %>" <%= (muCfg.enabled_filters && muCfg.enabled_filters.includes(filter)) ? 'checked' : '' %>>
                                <span><%= label %></span>
                            </label>
                        <% }); %>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>
</div>

<script>
let currentAudio = null;

function setPreviewStatus(text, kind) {
    const s = document.getElementById('preview-status');
    s.textContent = text;
    s.className = 'cf-status-line' + (kind ? ' is-' + kind : '');
}

// Audio filters: Select all / Clear.
document.addEventListener('click', function (e) {
    const b = e.target.closest('[data-mu-filters]');
    if (!b) return;
    const on = b.dataset.muFilters === 'all';
    const form = b.closest('form');
    document.querySelectorAll('#cfk-mu-page input[name="filters[]"]').forEach(function (box) {
        if (box.checked !== on) { box.checked = on; box.dispatchEvent(new Event('change', { bubbles: true })); }
    });
    if (form) form.dispatchEvent(new CustomEvent('cf:dirty', { bubbles: true }));
});

function previewVoice() {
    const voiceSelect = document.querySelector('select[name="djVoice"]');
    const selectedVoice = voiceSelect.value;
    const statusSpan = document.getElementById('preview-status');
    const previewBtn = document.getElementById('preview-voice-btn');

    if (!selectedVoice) {
        setPreviewStatus('Choose a voice first.', 'warn');
        return;
    }

    // Stop any currently playing audio
    if (currentAudio) {
        currentAudio.pause();
        currentAudio = null;
    }

    // Update button state
    previewBtn.disabled = true;
    setPreviewStatus('Loading preview', 'busy');

    // Fetch pre-generated preview audio
    fetch(`/api/voice-preview/${selectedVoice}`)
    .then(response => {
        if (!response.ok) {
            throw new Error('Voice preview not found');
        }
        return response.blob();
    })
    .then(audioBlob => {
        const audioUrl = URL.createObjectURL(audioBlob);
        currentAudio = new Audio(audioUrl);

        currentAudio.onplay = () => {
            setPreviewStatus('Playing', 'ok');
        };

        currentAudio.onended = () => {
            setPreviewStatus('', '');
            previewBtn.disabled = false;
            URL.revokeObjectURL(audioUrl);
            currentAudio = null;
        };

        currentAudio.onerror = () => {
            setPreviewStatus('Could not play the preview.', 'bad');
            previewBtn.disabled = false;
            currentAudio = null;
        };

        currentAudio.play().catch(err => {
            console.error('Audio playback error:', err);
            setPreviewStatus('Could not play the preview.', 'bad');
            previewBtn.disabled = false;
        });
    })
    .catch(error => {
        console.error('Preview error:', error);
        setPreviewStatus('No preview is available for this voice.', 'bad');
        previewBtn.disabled = false;
    });
}

// Auto-enable preview button when voice changes
document.addEventListener('DOMContentLoaded', function() {
    const voiceSelect = document.querySelector('select[name="djVoice"]');
    if (voiceSelect) {
        voiceSelect.addEventListener('change', function() {
            setPreviewStatus('', '');
            document.getElementById('preview-voice-btn').disabled = false;
        });
    }
});
</script>
