<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-shield-virus"></i>
                <span>Advanced Protection</span>
            </div>
            <div class="page-section-subtitle">
                AI-powered protection against raids, self-bots, and evolving spam patterns
            </div>
        </div>
    </div>

    <!-- Protection Status Overview -->
    <div class="grid grid-cols-4" style="margin-bottom: var(--spacing-6);">
        <div style="background: var(--color-dark-600); padding: var(--spacing-4); border-radius: var(--radius-md); border: 1px solid var(--color-dark-400);">
            <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Raid Protection</div>
            <div style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: <%= raidConfig && raidConfig.enabled ? 'var(--color-success)' : 'var(--color-text-muted)' %>;">
                <%= raidConfig && raidConfig.enabled ? 'Active' : 'Disabled' %>
            </div>
        </div>
        <div style="background: var(--color-dark-600); padding: var(--spacing-4); border-radius: var(--radius-md); border: 1px solid var(--color-dark-400);">
            <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Self-Bot Detection</div>
            <div style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: <%= selfbotConfig && selfbotConfig.enabled ? 'var(--color-success)' : 'var(--color-text-muted)' %>;">
                <%= selfbotConfig && selfbotConfig.enabled ? 'Active' : 'Disabled' %>
            </div>
        </div>
        <div style="background: var(--color-dark-600); padding: var(--spacing-4); border-radius: var(--radius-md); border: 1px solid var(--color-dark-400);">
            <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Adaptive Spam</div>
            <div style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: <%= adaptiveSpamConfig && adaptiveSpamConfig.enabled ? 'var(--color-success)' : 'var(--color-text-muted)' %>;">
                <%= adaptiveSpamConfig && adaptiveSpamConfig.enabled ? 'Active' : 'Disabled' %>
            </div>
        </div>
        <div style="background: var(--color-dark-600); padding: var(--spacing-4); border-radius: var(--radius-md); border: 1px solid var(--color-dark-400);">
            <div style="font-size: var(--font-size-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Recent Incidents</div>
            <div style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); color: var(--color-primary-400);">
                <%= (raidIncidents ? raidIncidents.length : 0) + (selfbotDetections ? selfbotDetections.length : 0) %>
            </div>
        </div>
    </div>

    <!-- Raid Protection Configuration -->
    <div style="margin-bottom: var(--spacing-6);">
        <h3 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); color: var(--color-text-primary); margin-bottom: var(--spacing-4);">
            <i class="fas fa-people-robbery" style="color: var(--color-danger); margin-right: var(--spacing-2);"></i>
            Raid Protection
        </h3>
        <form action="/manage/<%= guild.id %>/advanced-protection/raid" method="POST" style="background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-lg); padding: var(--spacing-6);">
            <div style="margin-bottom: var(--spacing-4);">
                <div class="form-check form-switch" style="display: flex; align-items: center; gap: var(--spacing-3); padding: var(--spacing-4); background: var(--color-dark-700); border-radius: var(--radius-md);">
                    <input class="form-check-input" type="checkbox" role="switch" id="raidEnabled" name="enabled" <%= raidConfig && raidConfig.enabled ? 'checked' : '' %> style="width: 48px; height: 24px; cursor: pointer;">
                    <label class="form-check-label" for="raidEnabled" style="cursor: pointer; flex: 1;">
                        <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-1);">Enable Raid Protection</div>
                        <div style="font-size: var(--font-size-xs); color: var(--color-text-muted);">Detect coordinated mass-join attacks and automatically mute/purge raiders</div>
                    </label>
                </div>
            </div>

            <div class="grid grid-cols-3" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-users" style="margin-right: var(--spacing-1); color: var(--color-danger);"></i>
                        Join Threshold
                    </label>
                    <input type="number" class="form-control" name="join_threshold" value="<%= raidConfig ? raidConfig.join_threshold : '10' %>" min="3" max="50" required>
                    <div class="form-help">Joins within timeframe to trigger</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-stopwatch" style="margin-right: var(--spacing-1); color: var(--color-accent-orange);"></i>
                        Timeframe (seconds)
                    </label>
                    <input type="number" class="form-control" name="join_timeframe_seconds" value="<%= raidConfig ? raidConfig.join_timeframe_seconds : '30' %>" min="10" max="300" required>
                    <div class="form-help">Window to count joins</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-baby" style="margin-right: var(--spacing-1); color: var(--color-warning);"></i>
                        New Account Age (hours)
                    </label>
                    <input type="number" class="form-control" name="new_account_age_hours" value="<%= raidConfig ? raidConfig.new_account_age_hours : '24' %>" min="1" max="720" required>
                    <div class="form-help">Flag accounts younger than this</div>
                </div>
            </div>

            <div class="grid grid-cols-3" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-percent" style="margin-right: var(--spacing-1); color: var(--color-primary-400);"></i>
                        New Account Ratio
                    </label>
                    <input type="number" class="form-control" name="new_account_ratio" value="<%= raidConfig ? (raidConfig.new_account_ratio * 100) : '70' %>" min="30" max="100" step="5" required>
                    <div class="form-help">% of new accounts to trigger (e.g., 70)</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-hammer" style="margin-right: var(--spacing-1); color: var(--color-accent-purple);"></i>
                        Action
                    </label>
                    <select class="form-select" name="action" required>
                        <option value="mute" <%= raidConfig && raidConfig.action === 'mute' ? 'selected' : '' %>>Mute Raiders</option>
                        <option value="kick" <%= raidConfig && raidConfig.action === 'kick' ? 'selected' : '' %>>Kick Raiders</option>
                        <option value="ban" <%= raidConfig && raidConfig.action === 'ban' ? 'selected' : '' %>>Ban Raiders</option>
                        <option value="alert" <%= raidConfig && raidConfig.action === 'alert' ? 'selected' : '' %>>Alert Only</option>
                    </select>
                    <div class="form-help">Action on detected raiders</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-bell" style="margin-right: var(--spacing-1); color: var(--color-success);"></i>
                        Alert Channel
                    </label>
                    <select class="form-select" name="alert_channel_id">
                        <option value="">Select alert channel</option>
                        <% channels.filter(c => c.type === 0).forEach(channel => { %>
                            <option value="<%= channel.id %>" <%= raidConfig && raidConfig.alert_channel_id === channel.id ? 'selected' : '' %>>
                                #<%= channel.name %>
                            </option>
                        <% }) %>
                    </select>
                    <div class="form-help">Channel for raid alerts</div>
                </div>
            </div>

            <div class="grid grid-cols-2" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-clock" style="margin-right: var(--spacing-1); color: var(--color-warning);"></i>
                        Mute Duration (minutes)
                    </label>
                    <input type="number" class="form-control" name="mute_duration_minutes" value="<%= raidConfig ? raidConfig.mute_duration_minutes : '60' %>" min="1" max="10080">
                    <div class="form-help">How long to mute raiders</div>
                </div>
                <div style="display: flex; align-items: center; padding-top: var(--spacing-6);">
                    <div class="form-check form-switch" style="display: flex; align-items: center; gap: var(--spacing-3);">
                        <input class="form-check-input" type="checkbox" role="switch" id="raidPurge" name="purge_messages" <%= raidConfig && raidConfig.purge_messages ? 'checked' : '' %> style="width: 48px; height: 24px; cursor: pointer;">
                        <label class="form-check-label" for="raidPurge" style="cursor: pointer;">
                            <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary);">Purge Messages</div>
                            <div style="font-size: var(--font-size-xs); color: var(--color-text-muted);">Delete recent messages from raiders</div>
                        </label>
                    </div>
                </div>
            </div>

            <div style="background: var(--color-dark-700); border-left: 4px solid var(--color-danger); padding: var(--spacing-4); border-radius: var(--radius-sm); margin-bottom: var(--spacing-4);">
                <div style="font-size: var(--font-size-sm); color: var(--color-text-secondary);">
                    <i class="fas fa-info-circle" style="color: var(--color-danger); margin-right: var(--spacing-2);"></i>
                    <strong>How it works:</strong> Triggers when <%= raidConfig ? raidConfig.join_threshold : '10' %> users join within <%= raidConfig ? raidConfig.join_timeframe_seconds : '30' %> seconds AND at least <%= raidConfig ? Math.round(raidConfig.new_account_ratio * 100) : '70' %>% have accounts younger than <%= raidConfig ? raidConfig.new_account_age_hours : '24' %> hours.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i>
                <span>Save Raid Protection Settings</span>
            </button>
        </form>

        <% if (raidIncidents && raidIncidents.length > 0) { %>
        <div style="margin-top: var(--spacing-4); background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-lg); padding: var(--spacing-4);">
            <h4 style="font-size: var(--font-size-md); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-3);">
                <i class="fas fa-history" style="margin-right: var(--spacing-2);"></i>
                Recent Raid Incidents
            </h4>
            <div style="overflow-x: auto;">
                <table class="data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Joins</th>
                            <th>New Accounts</th>
                            <th>Action</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% raidIncidents.forEach(incident => { %>
                        <tr>
                            <td><%= new Date(incident.detected_at).toLocaleString() %></td>
                            <td><%= incident.join_count %></td>
                            <td><%= incident.new_account_count %></td>
                            <td><span class="badge" style="background: var(--color-warning);"><%= incident.action_taken %></span></td>
                            <td>
                                <% if (incident.resolved_at) { %>
                                    <span class="badge" style="background: var(--color-success);">Resolved</span>
                                <% } else { %>
                                    <span class="badge" style="background: var(--color-danger);">Active</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Self-Bot Detection Configuration -->
    <div style="margin-bottom: var(--spacing-6);">
        <h3 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); color: var(--color-text-primary); margin-bottom: var(--spacing-4);">
            <i class="fas fa-robot" style="color: var(--color-accent-orange); margin-right: var(--spacing-2);"></i>
            Self-Bot Detection
        </h3>
        <form action="/manage/<%= guild.id %>/advanced-protection/selfbot" method="POST" style="background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-lg); padding: var(--spacing-6);">
            <div style="margin-bottom: var(--spacing-4);">
                <div class="form-check form-switch" style="display: flex; align-items: center; gap: var(--spacing-3); padding: var(--spacing-4); background: var(--color-dark-700); border-radius: var(--radius-md);">
                    <input class="form-check-input" type="checkbox" role="switch" id="selfbotEnabled" name="enabled" <%= selfbotConfig && selfbotConfig.enabled ? 'checked' : '' %> style="width: 48px; height: 24px; cursor: pointer;">
                    <label class="form-check-label" for="selfbotEnabled" style="cursor: pointer; flex: 1;">
                        <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-1);">Enable Self-Bot Detection</div>
                        <div style="font-size: var(--font-size-xs); color: var(--color-text-muted);">Detect users running unauthorized automation (self-bots violate Discord ToS)</div>
                    </label>
                </div>
            </div>

            <div class="grid grid-cols-3" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-bolt" style="margin-right: var(--spacing-1); color: var(--color-warning);"></i>
                        Min Response Time (ms)
                    </label>
                    <input type="number" class="form-control" name="min_response_time_ms" value="<%= selfbotConfig ? selfbotConfig.min_response_time_ms : '50' %>" min="10" max="500" required>
                    <div class="form-help">Flag responses faster than this</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-comment-dots" style="margin-right: var(--spacing-1); color: var(--color-primary-400);"></i>
                        Burst Threshold
                    </label>
                    <input type="number" class="form-control" name="message_burst_threshold" value="<%= selfbotConfig ? selfbotConfig.message_burst_threshold : '20' %>" min="5" max="100" required>
                    <div class="form-help">Messages in burst window to flag</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-stopwatch" style="margin-right: var(--spacing-1); color: var(--color-accent-orange);"></i>
                        Burst Window (ms)
                    </label>
                    <input type="number" class="form-control" name="message_burst_window_ms" value="<%= selfbotConfig ? selfbotConfig.message_burst_window_ms : '1000' %>" min="100" max="5000" required>
                    <div class="form-help">Window to count burst messages</div>
                </div>
            </div>

            <div class="grid grid-cols-3" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-exclamation-triangle" style="margin-right: var(--spacing-1); color: var(--color-danger);"></i>
                        Pattern Threshold
                    </label>
                    <input type="number" class="form-control" name="pattern_threshold" value="<%= selfbotConfig ? selfbotConfig.pattern_threshold : '3' %>" min="1" max="10" required>
                    <div class="form-help">Suspicious patterns before action</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-hammer" style="margin-right: var(--spacing-1); color: var(--color-accent-purple);"></i>
                        Action
                    </label>
                    <select class="form-select" name="action" required>
                        <option value="mute" <%= selfbotConfig && selfbotConfig.action === 'mute' ? 'selected' : '' %>>Mute User</option>
                        <option value="kick" <%= selfbotConfig && selfbotConfig.action === 'kick' ? 'selected' : '' %>>Kick User</option>
                        <option value="ban" <%= selfbotConfig && selfbotConfig.action === 'ban' ? 'selected' : '' %>>Ban User</option>
                        <option value="alert" <%= selfbotConfig && selfbotConfig.action === 'alert' ? 'selected' : '' %>>Alert Only</option>
                    </select>
                    <div class="form-help">Action on detected self-bots</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-bell" style="margin-right: var(--spacing-1); color: var(--color-success);"></i>
                        Alert Channel
                    </label>
                    <select class="form-select" name="alert_channel_id">
                        <option value="">Select alert channel</option>
                        <% channels.filter(c => c.type === 0).forEach(channel => { %>
                            <option value="<%= channel.id %>" <%= selfbotConfig && selfbotConfig.alert_channel_id === channel.id ? 'selected' : '' %>>
                                #<%= channel.name %>
                            </option>
                        <% }) %>
                    </select>
                    <div class="form-help">Channel for detection alerts</div>
                </div>
            </div>

            <div style="background: var(--color-dark-700); border-left: 4px solid var(--color-accent-orange); padding: var(--spacing-4); border-radius: var(--radius-sm); margin-bottom: var(--spacing-4);">
                <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-2);">
                    <i class="fas fa-search" style="margin-right: var(--spacing-2);"></i>
                    Detection Signals:
                </div>
                <ul style="margin: 0; padding-left: var(--spacing-6); color: var(--color-text-secondary); font-size: var(--font-size-sm);">
                    <li style="margin-bottom: var(--spacing-1);"><strong>Inhuman response times</strong> - Consistent replies under 50ms</li>
                    <li style="margin-bottom: var(--spacing-1);"><strong>Message bursts</strong> - 20+ messages in under 1 second</li>
                    <li style="margin-bottom: var(--spacing-1);"><strong>Pattern regularity</strong> - Messages at exact intervals</li>
                    <li style="margin-bottom: var(--spacing-1);"><strong>API-like behavior</strong> - Identical formatting, no variation</li>
                </ul>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i>
                <span>Save Self-Bot Detection Settings</span>
            </button>
        </form>

        <% if (selfbotDetections && selfbotDetections.length > 0) { %>
        <div style="margin-top: var(--spacing-4); background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-lg); padding: var(--spacing-4);">
            <h4 style="font-size: var(--font-size-md); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-3);">
                <i class="fas fa-history" style="margin-right: var(--spacing-2);"></i>
                Recent Detections
            </h4>
            <div style="overflow-x: auto;">
                <table class="data-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Type</th>
                            <th>Confidence</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% selfbotDetections.forEach(detection => { %>
                        <tr>
                            <td><%= new Date(detection.detected_at).toLocaleString() %></td>
                            <td><%= detection.user_id %></td>
                            <td><span class="badge" style="background: var(--color-accent-orange);"><%= detection.detection_type %></span></td>
                            <td><%= detection.confidence_score %>%</td>
                            <td><span class="badge" style="background: var(--color-warning);"><%= detection.action_taken %></span></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Adaptive Spam Configuration -->
    <div>
        <h3 style="font-size: var(--font-size-lg); font-weight: var(--font-weight-bold); color: var(--color-text-primary); margin-bottom: var(--spacing-4);">
            <i class="fas fa-brain" style="color: var(--color-primary-400); margin-right: var(--spacing-2);"></i>
            Adaptive Spam Detection
        </h3>
        <form action="/manage/<%= guild.id %>/advanced-protection/adaptive-spam" method="POST" style="background: var(--color-dark-600); border: 1px solid var(--color-dark-400); border-radius: var(--radius-lg); padding: var(--spacing-6);">
            <div style="margin-bottom: var(--spacing-4);">
                <div class="form-check form-switch" style="display: flex; align-items: center; gap: var(--spacing-3); padding: var(--spacing-4); background: var(--color-dark-700); border-radius: var(--radius-md);">
                    <input class="form-check-input" type="checkbox" role="switch" id="adaptiveSpamEnabled" name="enabled" <%= adaptiveSpamConfig && adaptiveSpamConfig.enabled ? 'checked' : '' %> style="width: 48px; height: 24px; cursor: pointer;">
                    <label class="form-check-label" for="adaptiveSpamEnabled" style="cursor: pointer; flex: 1;">
                        <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-1);">Enable Adaptive Spam Detection</div>
                        <div style="font-size: var(--font-size-xs); color: var(--color-text-muted);">Learn user behavior patterns and detect spam that evades traditional filters</div>
                    </label>
                </div>
            </div>

            <div class="grid grid-cols-3" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-layer-group" style="margin-right: var(--spacing-1); color: var(--color-danger);"></i>
                        Cross-Channel Threshold
                    </label>
                    <input type="number" class="form-control" name="cross_channel_threshold" value="<%= adaptiveSpamConfig ? adaptiveSpamConfig.cross_channel_threshold : '3' %>" min="2" max="10" required>
                    <div class="form-help">Channels with same message to flag</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-clock" style="margin-right: var(--spacing-1); color: var(--color-accent-orange);"></i>
                        Cross-Channel Timeframe (min)
                    </label>
                    <input type="number" class="form-control" name="cross_channel_timeframe_minutes" value="<%= adaptiveSpamConfig ? adaptiveSpamConfig.cross_channel_timeframe_minutes : '5' %>" min="1" max="30" required>
                    <div class="form-help">Window for cross-channel detection</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-chart-line" style="margin-right: var(--spacing-1); color: var(--color-primary-400);"></i>
                        Deviation Multiplier
                    </label>
                    <input type="number" class="form-control" name="deviation_multiplier" value="<%= adaptiveSpamConfig ? adaptiveSpamConfig.deviation_multiplier : '2.0' %>" min="1.5" max="5.0" step="0.1" required>
                    <div class="form-help">Flag when rate exceeds baseline by X</div>
                </div>
            </div>

            <div class="grid grid-cols-3" style="gap: var(--spacing-4); margin-bottom: var(--spacing-4);">
                <div>
                    <label class="form-label">
                        <i class="fas fa-baby" style="margin-right: var(--spacing-1); color: var(--color-warning);"></i>
                        New Account Multiplier (7d)
                    </label>
                    <input type="number" class="form-control" name="new_account_multiplier_7d" value="<%= adaptiveSpamConfig ? adaptiveSpamConfig.new_account_multiplier_7d : '1.5' %>" min="1.0" max="3.0" step="0.1" required>
                    <div class="form-help">Score boost for accounts &lt;7 days</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-user-clock" style="margin-right: var(--spacing-1); color: var(--color-danger);"></i>
                        New Account Multiplier (24h)
                    </label>
                    <input type="number" class="form-control" name="new_account_multiplier_24h" value="<%= adaptiveSpamConfig ? adaptiveSpamConfig.new_account_multiplier_24h : '2.0' %>" min="1.0" max="5.0" step="0.1" required>
                    <div class="form-help">Score boost for accounts &lt;24 hours</div>
                </div>
                <div>
                    <label class="form-label">
                        <i class="fas fa-hammer" style="margin-right: var(--spacing-1); color: var(--color-accent-purple);"></i>
                        Action
                    </label>
                    <select class="form-select" name="action" required>
                        <option value="mute" <%= adaptiveSpamConfig && adaptiveSpamConfig.action === 'mute' ? 'selected' : '' %>>Mute User</option>
                        <option value="kick" <%= adaptiveSpamConfig && adaptiveSpamConfig.action === 'kick' ? 'selected' : '' %>>Kick User</option>
                        <option value="ban" <%= adaptiveSpamConfig && adaptiveSpamConfig.action === 'ban' ? 'selected' : '' %>>Ban User</option>
                        <option value="alert" <%= adaptiveSpamConfig && adaptiveSpamConfig.action === 'alert' ? 'selected' : '' %>>Alert Only</option>
                    </select>
                    <div class="form-help">Action on detected spam</div>
                </div>
            </div>

            <div>
                <label class="form-label">
                    <i class="fas fa-bell" style="margin-right: var(--spacing-1); color: var(--color-success);"></i>
                    Alert Channel
                </label>
                <select class="form-select" name="alert_channel_id" style="max-width: 300px;">
                    <option value="">Select alert channel</option>
                    <% channels.filter(c => c.type === 0).forEach(channel => { %>
                        <option value="<%= channel.id %>" <%= adaptiveSpamConfig && adaptiveSpamConfig.alert_channel_id === channel.id ? 'selected' : '' %>>
                            #<%= channel.name %>
                        </option>
                    <% }) %>
                </select>
                <div class="form-help">Channel for spam detection alerts</div>
            </div>

            <div style="background: var(--color-dark-700); border-left: 4px solid var(--color-primary-400); padding: var(--spacing-4); border-radius: var(--radius-sm); margin: var(--spacing-4) 0;">
                <div style="font-weight: var(--font-weight-semibold); color: var(--color-text-primary); margin-bottom: var(--spacing-2);">
                    <i class="fas fa-brain" style="margin-right: var(--spacing-2);"></i>
                    Adaptive Features:
                </div>
                <ul style="margin: 0; padding-left: var(--spacing-6); color: var(--color-text-secondary); font-size: var(--font-size-sm);">
                    <li style="margin-bottom: var(--spacing-1);"><strong>User Baselines</strong> - Learns normal message rates per user</li>
                    <li style="margin-bottom: var(--spacing-1);"><strong>Cross-Channel Detection</strong> - Flags same message in multiple channels</li>
                    <li style="margin-bottom: var(--spacing-1);"><strong>Pattern Effectiveness</strong> - Tracks which rules catch real spam</li>
                    <li style="margin-bottom: var(--spacing-1);"><strong>New Account Weighting</strong> - Stricter detection for new accounts</li>
                </ul>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i>
                <span>Save Adaptive Spam Settings</span>
            </button>
        </form>
    </div>
</div>

<style>
.form-label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-2);
}

.form-control, .form-select {
    width: 100%;
    padding: var(--spacing-3);
    background: var(--color-dark-700);
    border: 1px solid var(--color-dark-400);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    transition: all var(--transition-base);
}

.form-control:focus, .form-select:focus {
    outline: none;
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.form-help {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--spacing-2);
}

.form-check-input {
    appearance: none;
    background-color: var(--color-dark-500);
    border: 2px solid var(--color-dark-400);
    border-radius: 12px;
    position: relative;
    transition: all 0.3s ease;
}

.form-check-input:checked {
    background-color: var(--color-success);
    border-color: var(--color-success);
}

.form-check-input::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: white;
    border-radius: 50%;
    top: 1px;
    left: 1px;
    transition: transform 0.3s ease;
}

.form-check-input:checked::before {
    transform: translateX(24px);
}

.form-check-label {
    margin: 0;
}

.data-table {
    border-collapse: collapse;
}

.data-table th, .data-table td {
    padding: var(--spacing-3);
    text-align: left;
    border-bottom: 1px solid var(--color-dark-400);
}

.data-table th {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    text-transform: uppercase;
}

.data-table td {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
}

.badge {
    display: inline-block;
    padding: var(--spacing-1) var(--spacing-2);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-sm);
    color: white;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Add interactive feedback for switches
    const switches = document.querySelectorAll('.form-check-input[type="checkbox"][role="switch"]');

    switches.forEach(switchEl => {
        switchEl.addEventListener('change', function() {
            const label = this.closest('.form-check, .form-check-switch')?.querySelector('.form-check-label > div:first-child');
            if (label) {
                if (this.checked) {
                    label.style.color = 'var(--color-success)';
                } else {
                    label.style.color = 'var(--color-text-primary)';
                }
            }
        });

        // Initialize state
        const label = switchEl.closest('.form-check, .form-check-switch')?.querySelector('.form-check-label > div:first-child');
        if (label && switchEl.checked) {
            label.style.color = 'var(--color-success)';
        }
    });
});
</script>
