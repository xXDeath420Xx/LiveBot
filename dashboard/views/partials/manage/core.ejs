<%#
  Core settings: the server timezone and prefix commands (POST update-core-settings). Built on the
  settings-row kit (cf-settings.css); field names and ids are unchanged. Controls that had no id
  keep none and are named by aria-labelledby.
%>
<style>
    #core-settings-form .core-prefix-input { font-family: var(--cf-mono); text-align: center; }
</style>
<%
    const currentTz = (settings && settings.timezone) ? settings.timezone : 'UTC';
    let currentTimeStr = '';
    try {
        // Try IANA timezone first (handles DST automatically)
        const nowUtc = new Date();
        const fmt = new Intl.DateTimeFormat('en-US', {
            timeZone: currentTz,
            weekday: 'long', month: 'short', day: 'numeric',
            hour: 'numeric', minute: '2-digit', hour12: true
        });
        currentTimeStr = fmt.format(nowUtc);
    } catch {
        // Legacy UTC±N fallback
        const tzMatch = currentTz.match(/UTC([+-])(\d+)(?::(\d+))?/);
        const offsetSign = tzMatch ? (tzMatch[1] === '-' ? -1 : 1) : 1;
        const offsetH = tzMatch ? parseInt(tzMatch[2], 10) : 0;
        const offsetM = tzMatch && tzMatch[3] ? parseInt(tzMatch[3], 10) : 0;
        const offsetMs = offsetSign * ((offsetH * 3600000) + (offsetM * 60000));
        const nowUtc = new Date();
        const localMs = nowUtc.getTime() + (nowUtc.getTimezoneOffset() * 60000) + offsetMs;
        const localDate = new Date(localMs);
        const hours = localDate.getHours();
        const minutes = localDate.getMinutes().toString().padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';
        const h12 = hours % 12 || 12;
        const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        currentTimeStr = days[localDate.getDay()] + ', ' + months[localDate.getMonth()] + ' ' + localDate.getDate() + ' — ' + h12 + ':' + minutes + ' ' + ampm;
    }
%>
<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-cog" aria-hidden="true"></i>
                <span>Core settings</span>
            </div>
        </div>
    </div>

    <form id="core-settings-form" action="/manage/<%= guild.id %>/update-core-settings" method="POST">
        <section class="cf-section" aria-labelledby="core-time-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="core-time-title">Time</h2>
                    <p class="cf-section-desc">Used for scheduled announcements, stat display clocks and other time-based features.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--wide">
                    <div class="cf-row-text">
                        <label class="cf-row-label" id="core-timezone-label" for="cfk-core-timezone">Timezone</label>
                        <p class="cf-row-desc" id="core-timezone-desc">Real timezone names, so Daylight Saving Time is handled automatically. Server time now: <span class="cf-em"><%= currentTimeStr %></span> (<%= currentTz %>).</p>
                    </div>
                    <div class="cf-row-control">
                        <select class="form-select" id="cfk-core-timezone" name="timezone" aria-describedby="core-timezone-desc">
                    <%
                    const tzGroups = {
                        'North America': [
                            { value: 'America/New_York', label: 'Eastern (New York)' },
                            { value: 'America/Chicago', label: 'Central (Chicago)' },
                            { value: 'America/Denver', label: 'Mountain (Denver)' },
                            { value: 'America/Los_Angeles', label: 'Pacific (Los Angeles)' },
                            { value: 'America/Phoenix', label: 'Arizona (no DST)' },
                            { value: 'America/Anchorage', label: 'Alaska' },
                            { value: 'Pacific/Honolulu', label: 'Hawaii (no DST)' },
                            { value: 'America/Toronto', label: 'Eastern (Toronto)' },
                            { value: 'America/Vancouver', label: 'Pacific (Vancouver)' },
                            { value: 'America/Edmonton', label: 'Mountain (Edmonton)' },
                            { value: 'America/Winnipeg', label: 'Central (Winnipeg)' },
                            { value: 'America/Halifax', label: 'Atlantic (Halifax)' },
                            { value: 'America/St_Johns', label: 'Newfoundland' },
                        ],
                        'Europe': [
                            { value: 'Europe/London', label: 'London (GMT/BST)' },
                            { value: 'Europe/Paris', label: 'Paris (CET/CEST)' },
                            { value: 'Europe/Berlin', label: 'Berlin (CET/CEST)' },
                            { value: 'Europe/Amsterdam', label: 'Amsterdam' },
                            { value: 'Europe/Madrid', label: 'Madrid' },
                            { value: 'Europe/Rome', label: 'Rome' },
                            { value: 'Europe/Stockholm', label: 'Stockholm' },
                            { value: 'Europe/Helsinki', label: 'Helsinki (EET)' },
                            { value: 'Europe/Athens', label: 'Athens (EET)' },
                            { value: 'Europe/Moscow', label: 'Moscow (no DST)' },
                            { value: 'Europe/Istanbul', label: 'Istanbul (no DST)' },
                        ],
                        'Asia & Pacific': [
                            { value: 'Asia/Dubai', label: 'Dubai (GST)' },
                            { value: 'Asia/Kolkata', label: 'India (IST)' },
                            { value: 'Asia/Bangkok', label: 'Bangkok (ICT)' },
                            { value: 'Asia/Singapore', label: 'Singapore (SGT)' },
                            { value: 'Asia/Hong_Kong', label: 'Hong Kong (HKT)' },
                            { value: 'Asia/Shanghai', label: 'China (CST)' },
                            { value: 'Asia/Tokyo', label: 'Tokyo (JST)' },
                            { value: 'Asia/Seoul', label: 'Seoul (KST)' },
                            { value: 'Asia/Manila', label: 'Manila (PHT)' },
                            { value: 'Asia/Jakarta', label: 'Jakarta (WIB)' },
                        ],
                        'Australia & NZ': [
                            { value: 'Australia/Perth', label: 'Perth (AWST)' },
                            { value: 'Australia/Adelaide', label: 'Adelaide (ACST/ACDT)' },
                            { value: 'Australia/Sydney', label: 'Sydney (AEST/AEDT)' },
                            { value: 'Australia/Melbourne', label: 'Melbourne (AEST/AEDT)' },
                            { value: 'Australia/Brisbane', label: 'Brisbane (no DST)' },
                            { value: 'Australia/Lord_Howe', label: 'Lord Howe Island' },
                            { value: 'Pacific/Auckland', label: 'Auckland (NZST/NZDT)' },
                        ],
                        'South America': [
                            { value: 'America/Sao_Paulo', label: 'São Paulo (BRT)' },
                            { value: 'America/Argentina/Buenos_Aires', label: 'Buenos Aires (ART)' },
                            { value: 'America/Bogota', label: 'Bogotá (COT)' },
                            { value: 'America/Santiago', label: 'Santiago (CLT/CLST)' },
                            { value: 'America/Lima', label: 'Lima (PET)' },
                        ],
                        'Other': [
                            { value: 'UTC', label: 'UTC (no DST)' },
                            { value: 'Pacific/Pago_Pago', label: 'Pago Pago (SST, UTC-11)' },
                            { value: 'Etc/GMT+12', label: 'Baker Island (UTC-12)' },
                            { value: 'Pacific/Fiji', label: 'Fiji' },
                        ]
                    };
                    %>
                    <option value="UTC" <%= !currentTz || currentTz === 'UTC' ? 'selected' : '' %>>UTC</option>
                    <% const tzListed = currentTz === 'UTC' || Object.values(tzGroups).some(zones => zones.some(z => z.value === currentTz)); %>
                    <% if (!tzListed) { %><option value="<%= currentTz %>" selected>Current: <%= currentTz %></option><% } %>
                    <% Object.entries(tzGroups).forEach(([group, zones]) => { %>
                    <optgroup label="<%= group %>">
                        <% zones.forEach(tz => { %>
                        <option value="<%= tz.value %>" <%= currentTz === tz.value ? 'selected' : '' %>><%= tz.label %></option>
                        <% }); %>
                    </optgroup>
                    <% }); %>
                        </select>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="core-prefix-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="core-prefix-title">Prefix commands</h2>
                    <p class="cf-section-desc">Let members run commands with a text prefix, such as <code>!play</code> or <code>!ban</code>, as well as slash commands.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" id="core-prefix_enabled-label" for="cfk-core-prefix-enabled">Prefix commands</label>
                        <p class="cf-row-desc" id="core-prefix_enabled-desc">Turn prefix commands on or off for the whole server. Commands typed with <code>/</code> as a message keep working either way, because some commands can only be used that way.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="cfk-core-prefix-enabled" name="prefix_enabled" value="1" aria-describedby="core-prefix_enabled-desc" <%= (typeof prefixConfig === 'undefined' || prefixConfig.enabled) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-core-prefix">Command prefix</label>
                        <p class="cf-row-desc" id="f-core-prefix-desc">1 to 5 symbols, with no letters, digits or spaces. Members would type <code id="core-prefix-example">!help</code>. Extra prefixes and aliases are on the <a href="/manage/<%= guild.id %>?page=command-center">Prefixes and aliases</a> page.</p>
                    </div>
                    <div class="cf-row-control">
                        <input id="f-core-prefix" type="text" class="form-control core-prefix-input" name="prefix" value='<%= (typeof prefixConfig !== "undefined" && prefixConfig.prefix) ? prefixConfig.prefix : "!" %>' maxlength="5" pattern="[^\w\s]{1,5}" required spellcheck="false" autocomplete="off" aria-describedby="f-core-prefix-desc">
                    </div>
                </div>

                <div class="cf-rows-head" id="core-cleanup-head">Clean-up</div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" id="core-delete_trigger-label" for="cfk-core-delete-trigger">Delete trigger messages</label>
                        <p class="cf-row-desc" id="core-delete_trigger-desc">Delete the member's message after one of the built-in prefix commands (for example <code>!ban @user</code>) runs. Other commands typed as text are not deleted.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="cfk-core-delete-trigger" name="delete_trigger" value="1" aria-describedby="core-delete_trigger-desc" <%= (typeof prefixConfig !== 'undefined' && prefixConfig.delete_trigger) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-core-cleanup_delay">Self-destruct delay</label>
                        <p class="cf-row-desc" id="f-core-cleanup_delay-desc">Replies in the private categories below delete themselves after this long. 0 turns it off.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-input-unit">
                            <input id="f-core-cleanup_delay" type="number" class="form-control" name="cleanup_delay" value="<%= (typeof prefixConfig !== 'undefined' && prefixConfig.cleanup_delay) ? prefixConfig.cleanup_delay : 0 %>" min="0" max="300" inputmode="numeric" aria-describedby="f-core-cleanup_delay-desc">
                            <span class="cf-unit">seconds</span>
                        </div>
                    </div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <div class="cf-row-label" id="core-private-label">Private categories</div>
                        <p class="cf-row-desc">Bot replies to the built-in prefix commands in these categories self-destruct after the delay above.</p>
                    </div>
                    <div class="cf-row-control">
                        <%# The categories of core/prefix-command-registry.js. %>
                        <% const allCategories = ['music', 'moderation', 'economy', 'leveling', 'fun', 'games', 'owo', 'cannabis', 'social', 'tools', 'info', 'utility']; %>
                        <%
                        let privateList = [];
                        try {
                            const raw = (typeof prefixConfig !== 'undefined' && prefixConfig) ? prefixConfig.private_categories : null;
                            privateList = Array.isArray(raw) ? raw : (raw ? JSON.parse(raw) : []);
                            if (!Array.isArray(privateList)) privateList = [];
                        } catch (e) { privateList = []; }
                        %>
                        <div class="cf-choices cf-check-grid" role="group" aria-labelledby="core-private-label">
                            <% allCategories.forEach(cat => { %>
                            <label class="cf-choice">
                                <input type="checkbox" name="private_categories" value="<%= cat %>" <%= privateList.includes(cat) ? 'checked' : '' %>>
                                <span><%= cat === 'owo' ? 'Critters (owo)' : cat.charAt(0).toUpperCase() + cat.slice(1) %></span>
                            </label>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="cf-form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>
<script>
(function () {
    var input = document.getElementById('f-core-prefix');
    var example = document.getElementById('core-prefix-example');
    if (!input || !example) return;
    var paint = function () { example.textContent = (input.value.trim() || '!') + 'help'; };
    input.addEventListener('input', paint);
    paint();
})();
</script>
