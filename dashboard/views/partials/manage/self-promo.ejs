<%#
  Self-promo: watches a channel for stream links and adds those streamers to stream tracking,
  with an optional gate on who may post in the announcement channel. One form saved as JSON to
  PUT /api/guilds/:id/self-promo/config. Built on the settings-row kit (cf-settings.css); field
  names and ids are unchanged.
%>
<%
const spConfig = typeof selfPromoConfig !== 'undefined' ? selfPromoConfig : {};
const spEnabled = !!spConfig.enabled;
const spChannelId = spConfig.channel_id || '';
const spAnnouncementChannelId = spConfig.announcement_channel_id || '';
const spSameChannel = spConfig.same_channel !== undefined ? !!spConfig.same_channel : true;
const spPlatforms = Array.isArray(spConfig.allowed_platforms) ? spConfig.allowed_platforms : ['twitch', 'kick', 'youtube'];
const spGateEnabled = !!spConfig.announce_gate_enabled;
const spGateMinLevel = Number.isFinite(Number(spConfig.announce_min_level)) ? Number(spConfig.announce_min_level) : 1;
let spGateRequiredRoles = spConfig.announce_required_role_ids;
if (typeof spGateRequiredRoles === 'string') {
    try { spGateRequiredRoles = JSON.parse(spGateRequiredRoles); } catch { spGateRequiredRoles = []; }
}
if (!Array.isArray(spGateRequiredRoles)) spGateRequiredRoles = [];
const spGateDeleteUnauth = spConfig.announce_delete_unauthorized !== undefined
    ? !!spConfig.announce_delete_unauthorized : true;
// Live-promotion filter (H-811, migration 469): on unless switched off.
const spLiveFilter = !(spConfig.live_promo_filter === 0 || spConfig.live_promo_filter === false);
const spRoles = typeof roles !== 'undefined' ? roles : [];
const spPlatformName = { twitch: 'Twitch', kick: 'Kick', youtube: 'YouTube' };
const spChannelName = (channels || []).find(c => c.id === spChannelId)?.name;
%>

<style>
    #sp-status { margin-right: auto; }
</style>

<div class="page-section">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-bullhorn"></i>
                <span>Self-promo</span>
            </div>
            <div class="page-section-subtitle"><%= spChannelName ? `Request channel: #${spChannelName}` : 'No request channel chosen yet' %></div>
        </div>
    </div>

    <form id="sp-form">
        <section class="cf-section" aria-labelledby="sp-channel-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sp-channel-title">Channel and platforms</h2>
                    <p class="cf-section-desc">Where members post their links, and which platforms are accepted.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-enabled">Self-promo</label>
                        <p class="cf-row-desc">Watch the request channel for stream links and track them.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="enabled" id="sp-enabled" data-feature-switch <%= spEnabled ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-self-promo-channel_id">Request channel</label>
                        <p class="cf-row-desc" id="f-self-promo-channel_id-desc">Required. Where members post their stream links.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-self-promo-channel_id" name="channel_id" class="form-select" aria-describedby="f-self-promo-channel_id-desc">
                            <option value="">Choose a channel</option>
                            <% channels.forEach(ch => { %>
                                <option value="<%= ch.id %>" <%= spChannelId === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-same-channel">Announce in the request channel</label>
                        <p class="cf-row-desc">When off, go-live announcements are posted in a separate channel.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="same_channel" id="sp-same-channel" <%= spSameChannel ? 'checked' : '' %> onchange="document.getElementById('sp-announce-channel').style.display = this.checked ? 'none' : 'block';">
                    </div>
                </div>
                <div id="sp-announce-channel" style="<%= spSameChannel ? 'display:none;' : '' %>">
                    <div class="cf-row cf-row--sub">
                        <div class="cf-row-text">
                            <label class="cf-row-label" for="f-self-promo-announcement_channel_id">Announcement channel</label>
                            <p class="cf-row-desc">Where go-live announcements for tracked streamers are posted. If empty, the request channel is used.</p>
                        </div>
                        <div class="cf-row-control">
                            <select id="f-self-promo-announcement_channel_id" name="announcement_channel_id" class="form-select">
                                    <option value="">Same as the request channel</option>
                                <% channels.forEach(ch => { %>
                                    <option value="<%= ch.id %>" <%= spAnnouncementChannelId === ch.id ? 'selected' : '' %>>#<%= ch.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <p class="cf-row-label">Allowed platforms</p>
                        <p class="cf-row-desc">Links to other platforms are not tracked, and are deleted when "Delete messages without a link" is on. With none ticked, every supported platform is accepted.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-choices">
                            <% ['twitch', 'kick', 'youtube'].forEach(p => { %>
                            <div class="cf-choice">
                                <input type="checkbox" name="platform_<%= p %>" id="sp-platform-<%= p %>" <%= spPlatforms.includes(p) ? 'checked' : '' %>>
                                <label for="sp-platform-<%= p %>"><%= spPlatformName[p] %></label>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="sp-behaviour-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sp-behaviour-title">Behaviour</h2>
                    <p class="cf-section-desc">What happens to a link once it is posted.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <p class="cf-row-label">Add to stream tracking</p>
                        <p class="cf-row-desc">Create the streamer and their subscription when a valid link is posted.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="auto_subscribe" aria-label="Add to stream tracking" <%= spConfig.auto_subscribe !== 0 ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <p class="cf-row-label">Keep members' posts</p>
                        <p class="cf-row-desc">Promo posts stay up and nothing is deleted; members are still added to tracking, confirmed with a reaction and a DM. Leave off to run the channel as a sign-up box, where each link is removed once it is read.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="keep_message" aria-label="Keep members' posts" <%= spConfig.keep_message ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <p class="cf-row-label">Delete messages without a link</p>
                        <p class="cf-row-desc">Removes messages that do not contain a valid stream link.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="delete_invalid" aria-label="Delete messages without a link" <%= spConfig.delete_invalid !== 0 ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <p class="cf-row-label">DM when tracked</p>
                        <p class="cf-row-desc">Tells the member when they are added to stream tracking.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="dm_on_track" aria-label="DM when tracked" <%= spConfig.dm_on_track !== 0 ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <p class="cf-row-label">DM if already tracked</p>
                        <p class="cf-row-desc">Tells the member when the account they posted is already tracked.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="dm_on_already_tracked" aria-label="DM if already tracked" <%= spConfig.dm_on_already_tracked !== 0 ? 'checked' : '' %>>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="sp-gate-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sp-gate-title">Announcement channel gate</h2>
                    <p class="cf-section-desc">Limits who can post messages or create threads in the announcement channel. Posts and threads from members who do not qualify are deleted and they get a DM saying why. The request channel is not affected.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-gate-enabled">Announcement gate</label>
                        <p class="cf-row-desc">Off by default. Choose an announcement channel first.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="announce_gate_enabled" id="sp-gate-enabled" <%= spGateEnabled ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-gate-min-level">Minimum level</label>
                        <p class="cf-row-desc">0 for no level requirement. Ignored on custom bots without leveling.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="number" name="announce_min_level" id="sp-gate-min-level"
                               min="0" max="200" value="<%= spGateMinLevel %>" class="form-control">
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-gate-required-roles">Required roles</label>
                        <p class="cf-row-desc">Members need at least one of these. Leave empty for no role requirement.</p>
                    </div>
                    <div class="cf-row-control">
                        <select name="announce_required_role_ids" id="sp-gate-required-roles" multiple size="6" class="form-select">
                            <% spRoles.forEach(role => { %>
                                <option value="<%= role.id %>" data-kind="role"<% if (role.hexColor && role.hexColor !== '#000000') { %> data-color="<%= role.hexColor %>"<% } %> <%= spGateRequiredRoles.includes(role.id) ? 'selected' : '' %>><%= role.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--switch cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-gate-delete-unauth">Delete posts and threads that do not qualify</label>
                        <p class="cf-row-desc">When off, the bot leaves them up (not recommended).</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="announce_delete_unauthorized" id="sp-gate-delete-unauth" <%= spGateDeleteUnauth ? 'checked' : '' %>>
                    </div>
                </div>
            </div>
        </section>

        <section class="cf-section" aria-labelledby="sp-livefilter-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="sp-livefilter-title">Live promotion elsewhere</h2>
                    <p class="cf-section-desc">Posts like "I'm live" or "going live" with a stream link, from members who are not moderators.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="sp-live-filter">Delete live promotion outside self-promo channels</label>
                        <p class="cf-row-desc">On by default. Channels whose names contain words like live, promo, stream, content or creator are always allowed, and moderators are never affected.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" name="live_promo_filter" id="sp-live-filter" <%= spLiveFilter ? 'checked' : '' %>>
                    </div>
                </div>
            </div>
        </section>

        <div class="cf-form-actions">
            <div id="sp-status" class="cf-status-line" role="status" aria-live="polite"></div>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>

<script>
document.getElementById('sp-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('sp-status');
    const platforms = [];
    ['twitch', 'kick', 'youtube'].forEach(p => {
        if (document.getElementById('sp-platform-' + p).checked) platforms.push(p);
    });
    const requiredRoleSelect = document.getElementById('sp-gate-required-roles');
    const requiredRoleIds = requiredRoleSelect
        ? Array.from(requiredRoleSelect.selectedOptions).map(o => o.value).filter(Boolean)
        : [];
    const minLevelRaw = document.getElementById('sp-gate-min-level')?.value ?? '1';
    const minLevel = Math.max(0, Math.min(200, parseInt(minLevelRaw, 10) || 0));
    const announceChannelEl = document.querySelector('[name="announcement_channel_id"]');
    const body = {
        enabled: document.getElementById('sp-enabled').checked,
        channel_id: e.target.channel_id.value || null,
        announcement_channel_id: announceChannelEl ? (announceChannelEl.value || null) : undefined,
        same_channel: document.getElementById('sp-same-channel')?.checked,
        allowed_platforms: platforms,
        auto_subscribe: e.target.auto_subscribe.checked,
        keep_message: e.target.keep_message.checked,
        delete_invalid: e.target.delete_invalid.checked,
        dm_on_track: e.target.dm_on_track.checked,
        dm_on_already_tracked: e.target.dm_on_already_tracked.checked,
        announce_gate_enabled: document.getElementById('sp-gate-enabled').checked,
        announce_min_level: minLevel,
        announce_required_role_ids: requiredRoleIds,
        announce_delete_unauthorized: document.getElementById('sp-gate-delete-unauth').checked,
        live_promo_filter: document.getElementById('sp-live-filter').checked,
    };
    try {
        const res = await fetch('/api/guilds/<%= guild.id %>/self-promo/config', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        status.textContent = data.success ? 'Saved' : (data.error || 'Could not save');
        status.className = 'cf-status-line ' + (data.success ? 'is-ok' : 'is-bad');
    } catch (err) {
        status.textContent = 'Could not reach the server';
        status.className = 'cf-status-line is-bad';
    }
});
</script>
