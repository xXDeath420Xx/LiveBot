<%#
  Birthdays: counts, registered birthdays, announcement and card settings (POST birthday/config),
  member commands, birthday cards (customise, AI cover, delete) and card imports (RecoCards link,
  PDF). Built on the settings-row kit (cf-settings.css); ids, field names, handlers and routes
  unchanged.
%>
<% const bdBotTop = (() => { try { const p = guild.members.me.roles.highest.position; return Number.isFinite(p) ? p : null; } catch (e) { return null; } })(); %>
<% const bdSample = JSON.stringify({ server: (guild && guild.name) || 'Your server' }).replace(/</g, '\\u003c'); %>
<style>
    .bd-list { max-height: 420px; overflow-y: auto; }
    .bd-who { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .bd-avatar { width: 32px; height: 32px; border-radius: 50%; flex: none; object-fit: cover; }
    .bd-avatar-none { width: 32px; height: 32px; border-radius: 50%; flex: none; display: inline-flex; align-items: center; justify-content: center;
        background: var(--cf-surface-2); color: var(--cf-text-3); font-size: 0.75rem; }
    .bd-date { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .bd-when { font-size: var(--cf-text-xs); color: var(--cf-text-3); white-space: nowrap; }
    .bd-today { background: color-mix(in srgb, var(--cf-accent) 6%, transparent); }
    .bd-cmd { font-family: var(--cf-mono); font-size: var(--cf-text-sm); color: var(--cf-text); }
    .bd-card-item { padding: var(--cf-4) var(--cf-5); }
    .bd-card-item + .bd-card-item { border-top: 1px solid var(--cf-border); }
    .bd-card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--cf-3); flex-wrap: wrap; }
    .bd-card-actions { flex-wrap: wrap; }
    .bd-card-actions form { display: inline; margin: 0; }
    .bd-more { margin-top: var(--cf-3); }
    .bd-more > summary { cursor: pointer; font-size: var(--cf-text-sm); color: var(--cf-text-2); user-select: none; }
    .bd-more[open] > summary { margin-bottom: var(--cf-3); }
    .bd-more-body { display: grid; gap: var(--cf-4); padding: var(--cf-4); border: 1px solid var(--cf-border); border-radius: var(--cf-radius); background: var(--cf-surface-2); }
    .bd-more-body + .bd-more-body { margin-top: var(--cf-3); }
    .bd-color { width: 40px; height: 34px; padding: 2px; border: 1px solid var(--cf-border-strong); border-radius: var(--cf-radius); background: transparent; cursor: pointer; }
    .bd-slug { font-family: var(--cf-mono); }
    .bd-check { display: flex; align-items: center; gap: 8px; font-size: var(--cf-text-sm); color: var(--cf-text); margin: 0; cursor: pointer; }
    .bd-check > input { width: 16px; height: 16px; margin: 0; accent-color: var(--cf-accent); }
    .bd-inline { display: flex; gap: var(--cf-2); align-items: flex-end; flex-wrap: wrap; margin: 0; }
    .bd-inline .cf-field { flex: 1 1 16rem; }
    .bd-note { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    .bd-note a { color: var(--cf-accent-fg); }
</style>

<div class="page-section birthday-page">
    <div class="page-section-header">
        <div>
            <div class="page-section-title">
                <i class="fas fa-birthday-cake"></i>
                <span>Birthdays</span>
            </div>
            <div class="page-section-subtitle">Saved birthdays, the announcement, cards and imports.</div>
        </div>
    </div>

    <% if (birthdayStats) { %>
    <%- include('../kit/_kpis', { items: [{ label: 'Saved birthdays', value: birthdayStats.total || 0 }, { label: 'This month', value: birthdayStats.thisMonth || 0 }, { label: 'Next 7 days', value: birthdayStats.upcoming || 0 }], label: 'Birthdays at a glance' }) %>
    <% } %>

    <% const bdayList = typeof birthdays !== 'undefined' ? birthdays : []; %>
    <% if (bdayList.length > 0) { %>
    <section class="cf-section" aria-labelledby="bd-list-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bd-list-title">Saved birthdays (<%= bdayList.length %>)</h2>
                <p class="cf-section-desc">Every member who has set a birthday, soonest first.</p>
            </div>
            <% if (bdayList.length > 15) { %>
            <div class="cf-section-actions">
                <label class="cf-search"><i class="fas fa-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="Search members" aria-label="Search saved birthdays" data-bd-filter></label>
            </div>
            <% } %>
        </header>
        <div class="cf-rows">
            <%
                const now = new Date();
                const todayMonth = now.getMonth() + 1;
                const todayDay = now.getDate();

                // Sort by next occurrence
                const sorted = [...bdayList].map(b => {
                    let nextDate = new Date(now.getFullYear(), b.month - 1, b.day);
                    if (nextDate < now) nextDate.setFullYear(nextDate.getFullYear() + 1);
                    const daysAway = Math.ceil((nextDate - now) / 86400000);
                    const isToday = b.month === todayMonth && b.day === todayDay;
                    return { ...b, daysAway, isToday, nextDate };
                }).sort((a, b) => a.daysAway - b.daysAway);
            %>
            <div id="bday-list" class="cf-list bd-list">
                <% sorted.forEach((b, i) => {
                    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                    const dateStr = months[b.month - 1] + ' ' + b.day;
                %>
                <div class="cf-list-item bday-row<%= b.isToday ? ' bd-today' : '' %>">
                    <div class="cf-list-main bd-who">
                        <% if (b.avatar_url) { %>
                        <img alt="" src="<%= b.avatar_url %>" class="bd-avatar">
                        <% } else { %>
                        <span class="bd-avatar-none" aria-hidden="true"><i class="fas fa-user"></i></span>
                        <% } %>
                        <div>
                            <div><%- include('_user-cell', { cfUser: null, cfUserId: b.user_id, cfUserName: b.username || null, cfUserSize: 'sm' }) %></div>
                            <div class="bd-date"><%= dateStr %></div>
                        </div>
                    </div>
                    <div>
                        <% if (b.isToday) { %>
                            <span class="cf-pill is-accent">Today</span>
                        <% } else if (b.daysAway <= 7) { %>
                            <span class="cf-pill is-ok">In <%= b.daysAway %> day<%= b.daysAway !== 1 ? 's' : '' %></span>
                        <% } else if (b.daysAway <= 30) { %>
                            <span class="bd-when">In <%= b.daysAway %> days</span>
                        <% } else { %>
                            <span class="bd-when"><%= dateStr %></span>
                        <% } %>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <form action="/manage/<%= guild.id %>/birthday/config" method="POST">
        <section class="cf-section" aria-labelledby="bd-config-title">
            <header class="cf-section-head">
                <div>
                    <h2 class="cf-section-title" id="bd-config-title">Announcements</h2>
                    <p class="cf-section-desc">How the bot marks a member's birthday.</p>
                </div>
            </header>
            <div class="cf-rows">
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="birthdayEnabled">Birthday announcements</label>
                        <p class="cf-row-desc" id="birthdayEnabled-desc">On a member's birthday the bot posts a message in the channel below, at midnight US Eastern time (New York). A 29 February birthday is celebrated on 28 February in other years.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="birthdayEnabled" name="enabled" data-feature-switch aria-describedby="birthdayEnabled-desc" <%= (birthdayConfig && birthdayConfig.enabled) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-birthday-announcement_channel_id">Announcement channel</label>
                        <p class="cf-row-desc">Where birthday messages and finished cards are posted.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-birthday-announcement_channel_id" class="form-select" name="announcement_channel_id" required>
                            <%- include('../kit/_pick-options', { items: channels || [], selected: (birthdayConfig && birthdayConfig.announcement_channel_id) || null, kind: 'channel', only: 'text', empty: 'Choose a channel' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-birthday-birthday_role_id">Birthday role</label>
                        <p class="cf-row-desc">Optional. Given on the day and taken back after 24 hours.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-birthday-birthday_role_id" class="form-select" name="birthday_role_id">
                            <%- include('../kit/_pick-options', { items: (typeof roles !== 'undefined' && roles) || [], selected: (birthdayConfig && birthdayConfig.birthday_role_id) || null, kind: 'role', botTop: bdBotTop, empty: 'No role' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-birthday-message_template">Birthday message</label>
                        <p class="cf-row-desc" id="f-birthday-message_template-desc">Optional, up to 2000 characters. {user} mentions the member, {username} is their name, {server} is the server name and {age} their new age (when they saved a birth year). Leave it empty for the default message.</p>
                    </div>
                    <div class="cf-row-control">
                        <textarea id="f-birthday-message_template" class="form-control" name="message_template" rows="3" maxlength="2000" aria-describedby="f-birthday-message_template-desc" placeholder="Happy birthday, {user}."><%= (birthdayConfig && birthdayConfig.message_template) ? birthdayConfig.message_template : '' %></textarea>
                    </div>
                </div>

                <div class="cf-row cf-row--stack">
                    <div class="cf-row-text">
                        <span class="cf-row-label" id="bd-pv-title">Preview</span>
                        <p class="cf-row-desc" id="bd-pv-desc">With a sample member, New Member, turning 21.</p>
                    </div>
                    <div class="cf-dc-frame" data-bd-preview aria-live="polite" aria-labelledby="bd-pv-title"></div>
                </div>

                <div class="cf-rows-head" id="bd-cards-head">Birthday cards</div>
                <div class="cf-row cf-row--switch">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="cfk-bd-cards">Birthday cards</label>
                        <p class="cf-row-desc" id="cfk-bd-cards-desc">Fourteen days before a birthday the bot opens a digital card for members to sign; it is revealed on the day.</p>
                    </div>
                    <div class="cf-row-control">
                        <input type="checkbox" class="cf-switch" role="switch" id="cfk-bd-cards" name="cards_enabled" aria-describedby="cfk-bd-cards-desc" <%= (birthdayConfig && birthdayConfig.cards_enabled) ? 'checked' : '' %>>
                    </div>
                </div>
                <div class="cf-row cf-row--stack cf-row--sub">
                    <div class="cf-row-text">
                        <span class="cf-row-label">Card type</span>
                        <p class="cf-row-desc">Used for cards the bot opens itself. Members can pick a type when they make a card on the website.</p>
                    </div>
                    <div class="cf-row-control">
                        <div class="cf-opts" role="radiogroup" aria-label="Card type">
                            <label class="cf-opt">
                                <input type="radio" name="default_card_type" value="board" <%= (!birthdayConfig || !['greeting_card', 'one_person'].includes(birthdayConfig.default_card_type)) ? 'checked' : '' %>>
                                <span class="cf-opt-body"><span class="cf-opt-title">Group board</span><span class="cf-opt-desc">A shared space where everyone posts messages and photos.</span></span>
                            </label>
                            <label class="cf-opt">
                                <input type="radio" name="default_card_type" value="greeting_card" <%= (birthdayConfig && birthdayConfig.default_card_type === 'greeting_card') ? 'checked' : '' %>>
                                <span class="cf-opt-body"><span class="cf-opt-title">Greeting card</span><span class="cf-opt-desc">A card that opens like a paper one, with everyone's messages inside.</span></span>
                            </label>
                            <label class="cf-opt">
                                <input type="radio" name="default_card_type" value="one_person" <%= (birthdayConfig && birthdayConfig.default_card_type === 'one_person') ? 'checked' : '' %>>
                                <span class="cf-opt-body"><span class="cf-opt-title">One-person card</span><span class="cf-opt-desc">A private card from one sender to one recipient.</span></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="cf-row cf-row--sub">
                    <div class="cf-row-text">
                        <label class="cf-row-label" for="f-birthday-card_channel_id">Card signing channel</label>
                        <p class="cf-row-desc">Where the "sign the card" link is posted. Pick a channel the birthday member cannot see to keep it a surprise.</p>
                    </div>
                    <div class="cf-row-control">
                        <select id="f-birthday-card_channel_id" class="form-select" name="card_channel_id">
                            <%- include('../kit/_pick-options', { items: channels || [], selected: (birthdayConfig && birthdayConfig.card_channel_id) || null, kind: 'channel', only: 'text', empty: 'Same as the announcement channel' }) %>
                        </select>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </section>
    </form>

    <section class="cf-section" aria-labelledby="bd-cmds-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bd-cmds-title">Member commands</h2>
                <p class="cf-section-desc">What members use to manage their own birthday. While birthdays are on, /birthday works as a shortcut for /engage birthday.</p>
            </div>
        </header>
        <div class="cf-rows">
            <div class="cf-list">
                <div class="cf-list-item"><span class="bd-cmd">/engage birthday set</span><span class="cf-list-main">Save their birthday</span></div>
                <div class="cf-list-item"><span class="bd-cmd">/engage birthday view</span><span class="cf-list-main">See the birthday they saved</span></div>
                <div class="cf-list-item"><span class="bd-cmd">/engage birthday remove</span><span class="cf-list-main">Delete their birthday</span></div>
                <div class="cf-list-item"><span class="bd-cmd">/engage birthday list</span><span class="cf-list-main">List the next birthdays in the server</span></div>
            </div>
        </div>
    </section>

    <% const cards = typeof birthdayCards !== 'undefined' ? birthdayCards : []; %>
    <section class="cf-section" aria-labelledby="bd-cardlist-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bd-cardlist-title">Cards</h2>
                <p class="cf-section-desc">Cards members can sign before a birthday. Opened 14 days before and posted on the day.</p>
            </div>
        </header>
        <div class="cf-rows">
            <% if (cards.length > 0) { %>
            <% cards.forEach(card => { %>
            <div class="bd-card-item">
                <div class="bd-card-head">
                    <div class="cf-list-main">
                        <div><%- include('_user-cell', { cfUser: null, cfUserId: card.user_id, cfUserName: null, cfUserSize: 'sm' }) %> &middot; <%= card.birthday_month %>/<%= card.birthday_day %></div>
                        <div class="cf-list-meta">
                            <%= card.signature_count || 0 %> signatures
                            &middot; <%= card.is_posted ? 'Delivered' : 'Open for signing' %>
                            &middot; Created <%= new Date(card.created_at).toLocaleDateString() %>
                        </div>
                    </div>
                    <div class="cf-list-actions bd-card-actions">
                        <a href="/card/<%= card.slug || card.share_token %>" target="_blank" class="btn btn-sm btn-secondary">View</a>
                        <a href="/card/<%= card.slug || card.share_token %>?slideshow" target="_blank" class="btn btn-sm btn-secondary">Slideshow</a>
                        <form action="/manage/<%= guild.id %>/birthday/delete-card" method="POST" onsubmit="return confirm('Delete this card and all its signatures? This cannot be undone.')">
                            <input type="hidden" name="cardId" value="<%= card.id %>">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
                <details class="bd-more">
                    <summary>Customise card</summary>
                    <form action="/manage/<%= guild.id %>/birthday/update-card" method="POST" class="bd-more-body">
                        <input type="hidden" name="cardId" value="<%= card.id %>">
                        <div class="cf-fields">
                            <div class="cf-field">
                                <label for="f-birthday-card_background_url-<%= card.id %>">Header cover image URL</label>
                                <input id="f-birthday-card_background_url-<%= card.id %>" type="text" name="card_background_url" value="<%= card.card_background_url || '' %>" class="form-control" placeholder="https://">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-header_bg_color-<%= card.id %>">Header background colour</label>
                                <input id="f-birthday-header_bg_color-<%= card.id %>" type="color" name="header_bg_color" value="<%= card.header_bg_color || '#000000' %>" class="bd-color">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-board_bg_image_url-<%= card.id %>">Board background image URL</label>
                                <input id="f-birthday-board_bg_image_url-<%= card.id %>" type="text" name="board_bg_image_url" value="<%= card.board_bg_image_url || '' %>" class="form-control" placeholder="https://">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-board_bg_color-<%= card.id %>">Board background colour</label>
                                <input id="f-birthday-board_bg_color-<%= card.id %>" type="color" name="board_bg_color" value="<%= card.board_bg_color || '#000000' %>" class="bd-color">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-title_font-<%= card.id %>">Title font</label>
                                <select id="f-birthday-title_font-<%= card.id %>" name="title_font" class="form-select">
                                    <option value="">Default</option>
                                    <option value="Source Code Pro" <%= card.title_font === 'Source Code Pro' ? 'selected' : '' %>>Source Code Pro</option>
                                    <option value="Indie Flower" <%= card.title_font === 'Indie Flower' ? 'selected' : '' %>>Indie Flower</option>
                                    <option value="Pacifico" <%= card.title_font === 'Pacifico' ? 'selected' : '' %>>Pacifico</option>
                                    <option value="Lobster" <%= card.title_font === 'Lobster' ? 'selected' : '' %>>Lobster</option>
                                    <option value="Dancing Script" <%= card.title_font === 'Dancing Script' ? 'selected' : '' %>>Dancing Script</option>
                                    <option value="Muli" <%= card.title_font === 'Muli' ? 'selected' : '' %>>Muli</option>
                                    <option value="Roboto" <%= card.title_font === 'Roboto' ? 'selected' : '' %>>Roboto</option>
                                    <option value="Quicksand" <%= card.title_font === 'Quicksand' ? 'selected' : '' %>>Quicksand</option>
                                </select>
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-title_font_color-<%= card.id %>">Title colour</label>
                                <input id="f-birthday-title_font_color-<%= card.id %>" type="color" name="title_font_color" value="<%= card.title_font_color || '#ffffff' %>" class="bd-color">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-title_font_size-<%= card.id %>">Title size (px)</label>
                                <input id="f-birthday-title_font_size-<%= card.id %>" type="number" name="title_font_size" value="<%= card.title_font_size || 36 %>" min="20" max="60" class="form-control">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-subtitle_text-<%= card.id %>">Subtitle</label>
                                <input id="f-birthday-subtitle_text-<%= card.id %>" type="text" name="subtitle_text" value="<%= card.subtitle_text || '' %>" class="form-control" placeholder="A short line under the title" maxlength="500">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-subtitle_font_color-<%= card.id %>">Subtitle colour</label>
                                <%# A colour input only takes #rrggbb (anything else reads as black), so an unset subtitle shows its look on the card (60% white) and is only saved when changed. %>
                                <% const bdSubColour = /^#[0-9a-f]{6}$/i.test(card.subtitle_font_color || '') ? card.subtitle_font_color : '#999999'; %>
                                <input id="f-birthday-subtitle_font_color-<%= card.id %>" type="color" name="subtitle_font_color" value="<%= bdSubColour %>" class="bd-color">
                                <input type="hidden" name="subtitle_font_color_shown" value="<%= bdSubColour %>">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-background_music_url-<%= card.id %>">Background music URL</label>
                                <input id="f-birthday-background_music_url-<%= card.id %>" type="text" name="background_music_url" value="<%= card.background_music_url || '' %>" class="form-control" placeholder="https://example.com/song.mp3">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-wishlist_url-<%= card.id %>">Wishlist or gift link</label>
                                <input id="f-birthday-wishlist_url-<%= card.id %>" type="text" name="wishlist_url" value="<%= card.wishlist_url || '' %>" class="form-control" placeholder="https://">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-custom_logo_url-<%= card.id %>">Logo URL</label>
                                <input id="f-birthday-custom_logo_url-<%= card.id %>" type="text" name="custom_logo_url" value="<%= card.custom_logo_url || '' %>" class="form-control" placeholder="https://example.com/logo.png">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-password-<%= card.id %>">Password</label>
                                <input id="f-birthday-password-<%= card.id %>" type="text" name="password" class="form-control" placeholder="Leave empty for no password">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-profile_link-<%= card.id %>">Profile or website link</label>
                                <input id="f-birthday-profile_link-<%= card.id %>" type="text" name="profile_link" value="<%= card.profile_link || '' %>" class="form-control" placeholder="https://twitch.tv/username">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-credits_text-<%= card.id %>">Credits</label>
                                <input id="f-birthday-credits_text-<%= card.id %>" type="text" name="credits_text" value="<%= card.credits_text || '' %>" class="form-control" placeholder="Card made by" maxlength="500">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-deliver_at-<%= card.id %>">Delivery date</label>
                                <input id="f-birthday-deliver_at-<%= card.id %>" type="date" name="deliver_at" value="<%= card.deliver_at ? new Date(card.deliver_at).toISOString().split('T')[0] : '' %>" class="form-control">
                            </div>
                            <div class="cf-field">
                                <label for="f-birthday-custom_slug-<%= card.id %>">Card address</label>
                                <input id="f-birthday-custom_slug-<%= card.id %>" type="text" name="custom_slug" value="<%= card.slug || '' %>" class="form-control bd-slug" placeholder="happy-birthday-name" maxlength="200">
                                <span class="cf-field-hint">certifriedmultitool.com/card/<strong><%= card.slug || card.share_token %></strong></span>
                            </div>
                            <div class="cf-field">
                                <label class="bd-check" for="freeze-<%= card.id %>"><input type="checkbox" name="is_frozen" id="freeze-<%= card.id %>" value="1" <%= card.is_frozen ? 'checked' : '' %>> Freeze card (no new messages)</label>
                            </div>
                        </div>
                        <div><button type="submit" class="btn btn-sm btn-primary">Save card</button></div>
                    </form>
                    <div class="bd-more-body">
                        <form action="/manage/<%= guild.id %>/birthday/generate-cover" method="POST" class="bd-inline">
                            <input type="hidden" name="cardId" value="<%= card.id %>">
                            <div class="cf-field">
                                <label for="f-birthday-prompt-<%= card.id %>">AI cover image</label>
                                <input id="f-birthday-prompt-<%= card.id %>" type="text" name="prompt" class="form-control" placeholder="Describe the picture, for example a birthday cake on a starry night" required>
                            </div>
                            <button type="submit" class="btn btn-secondary">Generate</button>
                        </form>
                        <% if (card.ai_cover_url) { %>
                        <div class="bd-note">Current AI cover: <a href="<%= card.ai_cover_url %>" target="_blank">view</a> (prompt: "<%= card.ai_cover_prompt || '' %>")</div>
                        <% } %>
                    </div>
                </details>
            </div>
            <% }); %>
            <% } else { %>
            <%- include('../kit/_state', { kind: 'empty', title: 'No birthday cards yet', text: 'Cards are opened 14 days before a saved birthday when birthday cards are on.', id: null, boxed: false, compact: false }) %>
            <% } %>
        </div>
    </section>

    <section class="cf-section" aria-labelledby="bd-import-title">
        <header class="cf-section-head">
            <div>
                <h2 class="cf-section-title" id="bd-import-title">Import a card</h2>
                <p class="cf-section-desc">Bring in a card made elsewhere, with its signers, messages and images.</p>
            </div>
        </header>
        <div class="cf-rows">
            <form action="/manage/<%= guild.id %>/birthday/import-recocard" method="POST">
                <div class="cf-rows-head" id="bd-reco-head">From a RecoCards link</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="f-birthday-user_id">Birthday member (user ID)</label>
                            <input id="f-birthday-user_id" type="text" name="user_id" class="form-control" required placeholder="Discord user ID">
                        </div>
                        <div class="cf-field">
                            <label for="f-birthday-recocard_url">RecoCards board URL</label>
                            <input id="f-birthday-recocard_url" type="text" name="recocard_url" class="form-control" required placeholder="https://recocards.com/board/">
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-foot-note">Reads the board page and copies every signer, message and image. Takes about 30 seconds.</span>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
            <form action="/manage/<%= guild.id %>/birthday/import-card" method="POST" enctype="multipart/form-data">
                <div class="cf-rows-head" id="bd-pdf-head">From a PDF file</div>
                <div class="cf-row cf-row--stack">
                    <div class="cf-fields">
                        <div class="cf-field">
                            <label for="f-birthday-user_id-2">Birthday member (user ID)</label>
                            <input id="f-birthday-user_id-2" type="text" name="user_id" class="form-control" required placeholder="Discord user ID">
                        </div>
                        <div class="cf-field">
                            <label for="f-birthday-pdf_file">PDF file</label>
                            <input id="f-birthday-pdf_file" type="file" name="pdf_file" accept=".pdf" required class="form-control">
                        </div>
                    </div>
                </div>
                <div class="cf-section-foot">
                    <span class="cf-foot-note">Each page becomes an image. The RecoCards import above gives better results.</span>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </section>
</div>

<script src="/js/cf-msgpreview.js"></script>
<script>
// Preview of the birthday announcement (core/birthday-manager.js birthdayText) and the list search.
(function () {
    const S = <%- bdSample %>;
    const box = document.querySelector('[data-bd-preview]');
    const msg = document.getElementById('f-birthday-message_template');
    const on = document.getElementById('birthdayEnabled');
    const ch = document.getElementById('f-birthday-announcement_channel_id');
    function render() {
        if (!box || !window.CFPreview) return;
        const own = msg.value.trim();
        const mention = CFPreview.mention('@New Member');
        const ageLine = '\n\uD83C\uDF82 Turning **21** today!';
        const text = own ? CFPreview.fill(own, { user: mention, username: 'New Member', server: S.server, age: '21' }) + (own.includes('{age}') ? '' : ageLine)
            : 'Join us in wishing ' + mention + ' a very happy birthday!' + ageLine;
        let note = '';
        if (!on.checked) note = 'Off: switch birthday announcements on to post this.';
        else if (!ch.value) note = 'Choose an announcement channel to post this.';
        CFPreview.render(box, { content: mention, embed: { colour: '#FF69B4', title: 'Happy Birthday New Member!', text, thumb: true, foot: S.server + ' \u2022 Birthday Celebration' }, note });
    }
    [msg, on, ch].forEach((n) => { if (n) { n.addEventListener('input', render); n.addEventListener('change', render); } });
    render();
    const filter = document.querySelector('[data-bd-filter]');
    if (filter) filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        document.querySelectorAll('#bday-list .bday-row').forEach((row) => { row.hidden = !!q && !row.textContent.toLowerCase().includes(q); });
    });
})();
</script>
