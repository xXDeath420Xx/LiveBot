<aside class="w-64 bg-dark-800 border-r border-dark-400 min-h-screen flex flex-col">
    <!-- Guild Header -->
    <div class="p-4 border-b border-dark-400">
        <a href="/dashboard" class="flex items-center gap-2 text-gray-400 hover:text-white text-sm mb-3 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Servers
        </a>

        <div class="flex items-center gap-3">
            <% if (locals.guild?.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= locals.guild.id %>/<%= locals.guild.icon %>.webp?size=64" alt="" class="w-10 h-10 rounded-full">
            <% } else { %>
            <div class="w-10 h-10 rounded-full bg-dark-600 flex items-center justify-center text-lg font-bold text-gray-400">
                <%= (locals.guild?.name || 'S').charAt(0) %>
            </div>
            <% } %>
            <div class="flex-1 min-w-0">
                <h2 class="font-semibold text-white truncate"><%= locals.guild?.name || 'Server' %></h2>
                <p class="text-xs text-gray-500"><%= locals.guild?.memberCount?.toLocaleString() || 0 %> members</p>
            </div>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto p-3">
        <% sections.forEach(section => { %>
        <div class="mb-4">
            <h3 class="px-3 mb-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                <%= section.title %>
            </h3>
            <ul class="space-y-1">
                <% section.items.forEach(item => { %>
                <li>
                    <a
                        href="<%= item.href %>"
                        class="nav-link <%= activeSection === item.id ? 'active' : '' %>"
                    >
                        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <%- icons[item.icon] || icons['cog'] %>
                        </svg>
                        <span><%= item.label %></span>
                    </a>
                </li>
                <% }); %>
            </ul>
        </div>
        <% }); %>
    </nav>

    <!-- Footer -->
    <div class="p-4 border-t border-dark-400">
        <%- include('../partials/botSwitcher') %>
    </div>
</aside>
