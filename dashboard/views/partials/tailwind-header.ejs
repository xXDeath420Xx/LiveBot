<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CertiFried MultiTool - Professional Discord bot with live streaming notifications, moderation, and more">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | CertiFried MultiTool' : 'CertiFried MultiTool' %></title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/CertiFried.png">

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS (for modals) - loaded first so Tailwind can override -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/output.css?v=<%= Date.now() %>">

    <!-- Modern Framework CSS (for legacy partials compatibility) -->
    <link rel="stylesheet" href="/css/modern-framework.css">
    <link rel="stylesheet" href="/css/unified-components.css">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Page-specific CSS -->
    <% if (typeof additionalCSS !== 'undefined' && additionalCSS.length > 0) { %>
        <% additionalCSS.forEach(css => { %>
            <link rel="stylesheet" href="<%= css %>">
        <% }); %>
    <% } %>

    <!-- Fix for Bootstrap/Tailwind dropdown conflict -->
    <style>
        .group:hover .group-hover\:visible { visibility: visible !important; }
        .group:hover .group-hover\:opacity-100 { opacity: 1 !important; }
        .invisible { visibility: hidden; }
    </style>

    <!-- Socket.io -->
    <script src="/socket.io/socket.io.js"></script>
</head>
<body class="bg-dark-700 text-white font-sans min-h-screen flex flex-col">

<!-- Navigation Bar -->
<nav class="fixed top-0 left-0 right-0 h-16 bg-dark-800/95 backdrop-blur-sm border-b border-dark-400 z-50">
    <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
            <img src="/images/CertiFried.png" alt="CertiFried" class="h-10 w-10 rounded-lg group-hover:scale-105 transition-transform">
            <span class="font-bold text-xl hidden sm:block bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">CertiFried</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-1">
            <a href="/" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Home</a>
            <a href="/commands" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Commands</a>
            <a href="/status" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Status</a>
            <a href="/docs" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Docs</a>
            <a href="/donate" class="px-4 py-2 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Donate</a>
        </div>

        <!-- Right Side -->
        <div class="flex items-center gap-3">
            <% if (typeof user !== 'undefined' && user) { %>
                <!-- User Menu -->
                <a href="/servers" class="hidden sm:flex items-center gap-2 px-4 py-2 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                    </svg>
                    Dashboard
                </a>
                <div class="relative group">
                    <button class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-dark-600 transition-colors">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.webp?size=32"
                             alt="<%= user.username %>"
                             class="w-8 h-8 rounded-full"
                             onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                        <span class="hidden sm:block text-sm font-medium"><%= user.username %></span>
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <!-- pt-2 creates invisible hover bridge, inner div has visual styling -->
                    <div class="absolute right-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                        <div class="w-48 bg-dark-600 rounded-lg border border-dark-400 shadow-xl">
                        <a href="/profile" class="flex items-center gap-2 px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-500 rounded-t-lg transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Profile
                        </a>
                        <a href="/servers" class="flex items-center gap-2 px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-500 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                            </svg>
                            My Servers
                        </a>
                        <% if (user.isSuperAdmin) { %>
                        <hr class="border-dark-400 my-1">
                        <a href="/super-admin" class="flex items-center gap-2 px-4 py-2.5 text-amber-400 hover:text-amber-300 hover:bg-dark-500 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                            </svg>
                            Super Admin
                        </a>
                        <a href="/bot-management" class="flex items-center gap-2 px-4 py-2.5 text-amber-400 hover:text-amber-300 hover:bg-dark-500 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                            Bot Management
                        </a>
                        <% } %>
                        <hr class="border-dark-400 my-1">
                        <a href="/logout" class="flex items-center gap-2 px-4 py-2.5 text-accent-red hover:bg-dark-500 rounded-b-lg transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Logout
                        </a>
                        </div><!-- close inner visual wrapper -->
                    </div><!-- close outer hover bridge wrapper -->
                </div>
            <% } else { %>
                <a href="/auth/discord" class="flex items-center gap-2 px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white font-medium rounded-lg transition-colors">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                    </svg>
                    Login
                </a>
            <% } %>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-400 hover:text-white hover:bg-dark-600 rounded-lg transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden hidden absolute top-16 left-0 right-0 bg-dark-800 border-b border-dark-400 shadow-xl">
        <div class="px-4 py-3 space-y-1">
            <a href="/" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Home</a>
            <a href="/commands" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Commands</a>
            <a href="/status" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Status</a>
            <a href="/docs" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Docs</a>
            <a href="/donate" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Donate</a>
            <% if (typeof user !== 'undefined' && user) { %>
                <hr class="border-dark-400 my-2">
                <a href="/servers" class="block px-4 py-2.5 text-gray-300 hover:text-white hover:bg-dark-600 rounded-lg transition-all">Dashboard</a>
            <% } %>
        </div>
    </div>
</nav>

<!-- Main Content Wrapper -->
<main class="flex-1 pt-16">
