<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= title %></title>
    <meta name="theme-color" content="#a78bfa">
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/tokes-bot.css?v=1769510480">
    <style>
        .tab-nav {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--ember-border);
            padding-bottom: 0.5rem;
        }
        .tab-btn {
            padding: 0.5rem 1rem;
            border: none;
            background: transparent;
            color: var(--ember-text-muted);
            cursor: pointer;
            border-radius: 6px 6px 0 0;
            font-weight: 500;
        }
        .tab-btn.active {
            background: var(--ember-primary);
            color: white;
        }
        .tab-btn:hover:not(.active) {
            background: var(--ember-bg-elevated);
        }
        .queue-item {
            background: var(--ember-bg-card);
            border: 1px solid var(--ember-border);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .queue-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.5rem;
        }
        .queue-content {
            background: var(--ember-bg-elevated);
            padding: 1rem;
            border-radius: 6px;
            margin: 0.75rem 0;
            font-style: italic;
        }
        .queue-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.75rem;
        }
        .count-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 20px;
            height: 20px;
            border-radius: 10px;
            background: var(--ember-primary);
            color: white;
            font-size: 0.75rem;
            font-weight: 600;
            margin-left: 0.5rem;
        }
        .strain-form, .trivia-form {
            display: grid;
            gap: 1rem;
        }
        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
        }
    </style>
</head>
<body class="ember-page">
    <!-- Navigation -->
    <nav class="ember-nav">
        <div class="ember-container ember-nav-inner">
            <a href="/tokes-bot" class="ember-nav-brand">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                    <path d="M12 6v6l4 2"/>
                </svg>
                CertiFriedUtility
                <span class="ember-badge ember-badge-error">Admin</span>
            </a>
            <div class="ember-nav-links">
                <a href="/tokes-bot" class="ember-nav-link">Public Site</a>
                <a href="/tokes-bot/dashboard" class="ember-nav-link">Dashboard</a>
                <a href="/tokes-bot/admin" class="ember-nav-link">Overview</a>
                <a href="/tokes-bot/admin/users" class="ember-nav-link">Users</a>
                <a href="/tokes-bot/admin/moderation" class="ember-nav-link active">Moderation</a>
                <a href="/tokes-bot/admin/analytics" class="ember-nav-link">Analytics</a>
                <a href="/tokes-bot/admin/health" class="ember-nav-link">Health</a>
                <a href="/tokes-bot/admin/commands" class="ember-nav-link">Commands</a>
                <a href="/tokes-bot/admin/sessions" class="ember-nav-link">Sessions</a>
            </div>
            <div class="ember-nav-actions">
                <div class="ember-nav-user">
                    <img src="<%= user.avatar %>" alt="<%= user.name %>" class="ember-nav-avatar">
                    <span><%= user.name %></span>
                </div>
                <a href="/tokes-bot/auth/logout" class="ember-btn ember-btn-ghost">Logout</a>
            </div>
        </div>
    </nav>

    <main class="ember-dashboard">
        <div class="ember-container">
            <!-- Header -->
            <div class="ember-dashboard-header">
                <h1 class="ember-dashboard-title">Content Moderation</h1>
                <p class="ember-dashboard-subtitle">Review submissions and manage content</p>
            </div>

            <!-- Tab Navigation -->
            <div class="tab-nav" id="tabNav">
                <button type="button" class="tab-btn active" data-tab="thoughts">
                    Thoughts <span class="count-badge" id="thoughtsCount">0</span>
                </button>
                <button type="button" class="tab-btn" data-tab="trivia">
                    Trivia <span class="count-badge" id="triviaCount">0</span>
                </button>
                <button type="button" class="tab-btn" data-tab="strains">
                    Strains
                </button>
            </div>

            <!-- Thoughts Tab -->
            <div id="thoughtsTab" class="tab-content">
                <div class="ember-card">
                    <div class="ember-card-header">
                        <h2 class="ember-card-title">Stoner Thoughts</h2>
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <span class="ember-text-muted" id="thoughtsTotal"></span>
                            <select id="thoughtsStatus" class="ember-input" style="width: auto;" onchange="loadThoughts()">
                                <option value="pending">Pending Review</option>
                                <option value="approved">Approved</option>
                            </select>
                        </div>
                    </div>
                    <div class="ember-card-body" id="thoughtsList" style="max-height: 600px; overflow-y: auto;">
                        <p class="ember-text-muted">Loading...</p>
                    </div>
                </div>
            </div>

            <!-- Trivia Tab -->
            <div id="triviaTab" class="tab-content" style="display: none;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                    <!-- Add New Trivia -->
                    <div class="ember-card">
                        <div class="ember-card-header">
                            <h2 class="ember-card-title">Add Trivia Question</h2>
                        </div>
                        <div class="ember-card-body">
                            <form id="triviaForm" class="trivia-form">
                                <div class="ember-form-group">
                                    <label class="ember-label">Question</label>
                                    <textarea name="question" class="ember-input" rows="2" required placeholder="What is the most common terpene found in cannabis?"></textarea>
                                </div>
                                <div class="ember-form-group">
                                    <label class="ember-label">Correct Answer</label>
                                    <input type="text" name="correct_answer" class="ember-input" required placeholder="Myrcene">
                                </div>
                                <div class="form-row">
                                    <div class="ember-form-group">
                                        <label class="ember-label">Wrong Answer 1</label>
                                        <input type="text" name="wrong_answer_1" class="ember-input" required>
                                    </div>
                                    <div class="ember-form-group">
                                        <label class="ember-label">Wrong Answer 2</label>
                                        <input type="text" name="wrong_answer_2" class="ember-input" required>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="ember-form-group">
                                        <label class="ember-label">Wrong Answer 3</label>
                                        <input type="text" name="wrong_answer_3" class="ember-input" required>
                                    </div>
                                    <div class="ember-form-group">
                                        <label class="ember-label">Category</label>
                                        <select name="category" class="ember-input">
                                            <option value="general">General</option>
                                            <option value="strains">Strains</option>
                                            <option value="history">History</option>
                                            <option value="science">Science</option>
                                            <option value="culture">Culture</option>
                                        </select>
                                    </div>
                                </div>
                                <button type="submit" class="ember-btn ember-btn-primary">Add Question</button>
                            </form>
                        </div>
                    </div>

                    <!-- Existing Trivia -->
                    <div class="ember-card">
                        <div class="ember-card-header">
                            <h2 class="ember-card-title">Existing Questions</h2>
                            <span class="ember-text-muted" id="triviaTotal">0 questions</span>
                        </div>
                        <div class="ember-card-body" style="max-height: 500px; overflow-y: auto;" id="triviaList">
                            <p class="ember-text-muted">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Strains Tab -->
            <div id="strainsTab" class="tab-content" style="display: none;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                    <!-- Add New Strain -->
                    <div class="ember-card">
                        <div class="ember-card-header">
                            <h2 class="ember-card-title">Add Strain</h2>
                        </div>
                        <div class="ember-card-body">
                            <form id="strainForm" class="strain-form">
                                <div class="form-row">
                                    <div class="ember-form-group">
                                        <label class="ember-label">Name</label>
                                        <input type="text" name="name" class="ember-input" required placeholder="Blue Dream">
                                    </div>
                                    <div class="ember-form-group">
                                        <label class="ember-label">Type</label>
                                        <select name="type" class="ember-input" required>
                                            <option value="hybrid">Hybrid</option>
                                            <option value="sativa">Sativa</option>
                                            <option value="indica">Indica</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="ember-form-group">
                                        <label class="ember-label">THC %</label>
                                        <input type="number" name="thc_percent" class="ember-input" step="0.1" min="0" max="40" placeholder="21.5">
                                    </div>
                                    <div class="ember-form-group">
                                        <label class="ember-label">CBD %</label>
                                        <input type="number" name="cbd_percent" class="ember-input" step="0.1" min="0" max="30" placeholder="0.5">
                                    </div>
                                </div>
                                <div class="ember-form-group">
                                    <label class="ember-label">Effects (comma-separated)</label>
                                    <input type="text" name="effects" class="ember-input" placeholder="Relaxed, Happy, Euphoric, Uplifted">
                                </div>
                                <div class="ember-form-group">
                                    <label class="ember-label">Flavors (comma-separated)</label>
                                    <input type="text" name="flavors" class="ember-input" placeholder="Sweet, Berry, Blueberry">
                                </div>
                                <div class="ember-form-group">
                                    <label class="ember-label">Description</label>
                                    <textarea name="description" class="ember-input" rows="3" placeholder="Blue Dream is a sativa-dominant hybrid originating in California..."></textarea>
                                </div>
                                <div class="ember-form-group">
                                    <label class="ember-label">Lineage</label>
                                    <input type="text" name="lineage" class="ember-input" placeholder="Blueberry x Haze">
                                </div>
                                <button type="submit" class="ember-btn ember-btn-primary">Add Strain</button>
                            </form>
                        </div>
                    </div>

                    <!-- Existing Strains -->
                    <div class="ember-card">
                        <div class="ember-card-header">
                            <h2 class="ember-card-title">Strain Database</h2>
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <span class="ember-text-muted" id="strainsTotal"></span>
                                <input type="text" id="strainSearch" class="ember-input" style="width: 200px;" placeholder="Search strains...">
                            </div>
                        </div>
                        <div class="ember-card-body" style="max-height: 600px; overflow-y: auto;" id="strainsList">
                            <p class="ember-text-muted">Loading...</p>
                        </div>
                        <div id="strainsPagination" style="display: none; padding: 1rem; border-top: 1px solid var(--ember-border);">
                            <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                <button type="button" id="strainsFirst" class="ember-btn ember-btn-ghost ember-btn-sm" title="First page">⏮</button>
                                <button type="button" id="strainsPrev" class="ember-btn ember-btn-ghost ember-btn-sm" title="Previous page">←</button>
                                <div style="display: flex; align-items: center; gap: 0.25rem;">
                                    <span class="ember-text-muted">Page</span>
                                    <input type="number" id="strainsPageInput" class="ember-input" style="width: 60px; text-align: center; padding: 0.25rem;" min="1" value="1">
                                    <span class="ember-text-muted">of <span id="strainsTotalPages">1</span></span>
                                </div>
                                <button type="button" id="strainsNext" class="ember-btn ember-btn-ghost ember-btn-sm" title="Next page">→</button>
                                <button type="button" id="strainsLast" class="ember-btn ember-btn-ghost ember-btn-sm" title="Last page">⏭</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="ember-footer">
        <div class="ember-container ember-footer-inner">
            <div class="ember-footer-links">
                <a href="/tokes-bot" class="ember-footer-link">Public Site</a>
                <a href="/tokes-bot/dashboard" class="ember-footer-link">User Dashboard</a>
            </div>
            <div class="ember-footer-copy">
                Part of <a href="/" style="color: var(--ember-primary); text-decoration: none;">CertiFried MultiTool</a>
            </div>
        </div>
    </footer>

    <script>
        var currentTab = 'thoughts';

        // Tab switching using event delegation
        document.getElementById('tabNav').addEventListener('click', function(e) {
            var btn = e.target.closest('.tab-btn');
            if (!btn) return;

            var tab = btn.getAttribute('data-tab');
            if (!tab) return;

            currentTab = tab;

            // Remove active from all tabs
            var allBtns = document.querySelectorAll('.tab-btn');
            for (var i = 0; i < allBtns.length; i++) {
                allBtns[i].classList.remove('active');
            }

            // Hide all tab content
            var allTabs = document.querySelectorAll('.tab-content');
            for (var j = 0; j < allTabs.length; j++) {
                allTabs[j].style.display = 'none';
            }

            // Add active to clicked button
            btn.classList.add('active');

            // Show the selected tab
            var tabElement = document.getElementById(tab + 'Tab');
            if (tabElement) {
                tabElement.style.display = 'block';
            }

            // Load data for the tab
            if (tab === 'thoughts') loadThoughts();
            else if (tab === 'trivia') loadTrivia();
            else if (tab === 'strains') loadStrains();
        });

        // Thoughts
        async function loadThoughts() {
            const status = document.getElementById('thoughtsStatus').value;

            try {
                const response = await fetch('/tokes-bot/api/admin/moderation/thoughts?status=' + status);
                const data = await response.json();

                const container = document.getElementById('thoughtsList');
                const totalEl = document.getElementById('thoughtsTotal');

                // Handle API errors
                if (data.error) {
                    container.innerHTML = '<p class="ember-text-muted ember-text-center" style="padding: 2rem;">Error: ' + escapeHtml(data.error) + '</p>';
                    totalEl.textContent = '';
                    return;
                }

                const thoughts = data.thoughts || [];

                // Update total display
                totalEl.textContent = thoughts.length + ' ' + status;

                if (thoughts.length === 0) {
                    if (status === 'pending') {
                        container.innerHTML = '<p class="ember-text-muted ember-text-center" style="padding: 2rem;">No pending thoughts to review. Select "Approved" to see existing thoughts.</p>';
                    } else {
                        container.innerHTML = '<p class="ember-text-muted ember-text-center" style="padding: 2rem;">No approved thoughts yet.</p>';
                    }
                    return;
                }

                container.innerHTML = data.thoughts.map(function(thought) {
                    return '<div class="queue-item" id="thought-' + thought.id + '">' +
                        '<div class="queue-item-header">' +
                            '<span class="ember-text-muted">Submitted by: ' + escapeHtml(thought.submitter_name || 'Anonymous') + '</span>' +
                            '<span class="ember-text-muted">' + new Date(thought.submitted_at).toLocaleDateString() + '</span>' +
                        '</div>' +
                        '<div class="queue-content">"' + escapeHtml(thought.content) + '"</div>' +
                        (status === 'pending' ?
                            '<div class="queue-actions">' +
                                '<button onclick="reviewThought(' + thought.id + ', true)" class="ember-btn ember-btn-sm ember-btn-success">Approve</button>' +
                                '<button onclick="reviewThought(' + thought.id + ', false)" class="ember-btn ember-btn-sm ember-btn-error">Reject</button>' +
                            '</div>'
                        :
                            '<span class="ember-badge ember-badge-success">Approved</span>'
                        ) +
                    '</div>';
                }).join('');

                // Update count
                if (status === 'pending') {
                    document.getElementById('thoughtsCount').textContent = data.thoughts.length;
                }

            } catch (error) {
                console.error('Failed to load thoughts:', error);
            }
        }

        async function reviewThought(id, approved) {
            try {
                const response = await fetch(`/tokes-bot/api/admin/moderation/thoughts/${id}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ approved })
                });

                if (response.ok) {
                    document.getElementById(`thought-${id}`).remove();
                    const countEl = document.getElementById('thoughtsCount');
                    countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
                }
            } catch (error) {
                console.error('Failed to review thought:', error);
            }
        }

        // Trivia
        async function loadTrivia() {
            try {
                const response = await fetch('/tokes-bot/api/admin/trivia');
                const data = await response.json();

                const container = document.getElementById('triviaList');
                document.getElementById('triviaTotal').textContent = `${data.questions?.length || 0} questions`;

                if (!data.questions || !data.questions.length) {
                    container.innerHTML = '<p class="ember-text-muted ember-text-center">No trivia questions</p>';
                    return;
                }

                container.innerHTML = data.questions.map(q => `
                    <div class="queue-item" id="trivia-${q.id}">
                        <div class="queue-item-header">
                            <strong>${escapeHtml(q.question)}</strong>
                            <span class="ember-badge ember-badge-primary">${q.category || 'general'}</span>
                        </div>
                        <div style="font-size: 0.85rem; margin-top: 0.5rem;">
                            <span style="color: var(--ember-success);">Correct: ${escapeHtml(q.correct_answer)}</span>
                        </div>
                        <div style="font-size: 0.8rem; color: var(--ember-text-muted); margin-top: 0.25rem;">
                            Asked ${q.times_asked || 0} times | Success rate: ${q.success_rate || 0}%
                        </div>
                        <button onclick="deleteTrivia(${q.id})" class="ember-btn ember-btn-sm ember-btn-ghost" style="margin-top: 0.5rem;">Delete</button>
                    </div>
                `).join('');

            } catch (error) {
                console.error('Failed to load trivia:', error);
            }
        }

        document.getElementById('triviaForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);

            try {
                const response = await fetch('/tokes-bot/api/admin/trivia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    e.target.reset();
                    loadTrivia();
                    alert('Question added!');
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to add question');
                }
            } catch (error) {
                console.error('Failed to add trivia:', error);
            }
        });

        async function deleteTrivia(id) {
            if (!confirm('Delete this question?')) return;

            try {
                const response = await fetch(`/tokes-bot/api/admin/trivia/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    document.getElementById(`trivia-${id}`).remove();
                }
            } catch (error) {
                console.error('Failed to delete trivia:', error);
            }
        }

        // Strains pagination state
        var strainsPage = 1;
        var strainsPerPage = 50;
        var strainsSearch = '';
        var strainsTotal = 0;
        var strainsTotalPages = 1;

        async function loadStrains(search) {
            search = search || '';

            // Reset page if search changed
            if (search !== strainsSearch) {
                strainsPage = 1;
                strainsSearch = search;
            }

            var offset = (strainsPage - 1) * strainsPerPage;

            try {
                var url = '/tokes-bot/api/admin/strains?search=' + encodeURIComponent(search) + '&offset=' + offset + '&limit=' + strainsPerPage;
                var response = await fetch(url);
                var data = await response.json();

                var container = document.getElementById('strainsList');
                var totalEl = document.getElementById('strainsTotal');
                var paginationDiv = document.getElementById('strainsPagination');

                if (!data.strains || !data.strains.length) {
                    container.innerHTML = '<p class="ember-text-muted ember-text-center">No strains found</p>';
                    if (totalEl) totalEl.textContent = '0 strains';
                    paginationDiv.style.display = 'none';
                    return;
                }

                strainsTotal = data.total || 0;
                strainsTotalPages = Math.ceil(strainsTotal / strainsPerPage);

                if (totalEl) {
                    totalEl.textContent = strainsTotal.toLocaleString() + ' strains' + (search ? ' (filtered)' : '');
                }

                var html = '';
                for (var i = 0; i < data.strains.length; i++) {
                    var s = data.strains[i];
                    var strainType = s.strain_type || 'hybrid';
                    var thcMin = s.thc_min || '';
                    var thcMax = s.thc_max || '';
                    var thcDisplay = thcMin && thcMax ? thcMin + '-' + thcMax + '%' : (thcMin || thcMax || '?') + '%';
                    var badgeClass = strainType === 'sativa' ? 'ember-badge-warning' : strainType === 'indica' ? 'ember-platform-twitch' : 'ember-badge-success';
                    var hasData = thcMin || thcMax;

                    html += '<div class="queue-item strain-item" id="strain-' + s.id + '" style="padding: 0.75rem; margin-bottom: 0.5rem;">' +
                        '<div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">' +
                            '<div style="flex: 1;">' +
                                '<strong>' + escapeHtml(s.name) + '</strong>' +
                                '<select onchange="updateStrainType(' + s.id + ', this.value)" class="ember-input" style="margin-left: 0.5rem; padding: 0.25rem 0.5rem; font-size: 0.75rem; width: auto;">' +
                                    '<option value="indica"' + (strainType === 'indica' ? ' selected' : '') + '>Indica</option>' +
                                    '<option value="sativa"' + (strainType === 'sativa' ? ' selected' : '') + '>Sativa</option>' +
                                    '<option value="hybrid"' + (strainType === 'hybrid' ? ' selected' : '') + '>Hybrid</option>' +
                                '</select>' +
                            '</div>' +
                            '<div style="display: flex; align-items: center; gap: 0.5rem;">' +
                                '<input type="number" step="0.1" min="0" max="40" value="' + thcMin + '" placeholder="Min" ' +
                                    'onchange="updateStrainTHC(' + s.id + ', this.value, null)" ' +
                                    'class="ember-input" style="width: 60px; padding: 0.25rem; font-size: 0.85rem;' + (!hasData ? ' border-color: var(--ember-warning);' : '') + '">' +
                                '<span>-</span>' +
                                '<input type="number" step="0.1" min="0" max="40" value="' + thcMax + '" placeholder="Max" ' +
                                    'onchange="updateStrainTHC(' + s.id + ', null, this.value)" ' +
                                    'class="ember-input" style="width: 60px; padding: 0.25rem; font-size: 0.85rem;' + (!hasData ? ' border-color: var(--ember-warning);' : '') + '">' +
                                '<span style="color: var(--ember-text-muted);">% THC</span>' +
                                '<button onclick="deleteStrain(' + s.id + ')" class="ember-btn ember-btn-sm ember-btn-ghost" style="padding: 0.25rem 0.5rem;">&times;</button>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
                }
                container.innerHTML = html;

                // Update pagination controls
                updateStrainsPagination();

                // Scroll to top of list
                container.scrollTop = 0;

            } catch (error) {
                console.error('Failed to load strains:', error);
                document.getElementById('strainsList').innerHTML = '<p class="ember-text-muted">Error loading strains</p>';
            }
        }

        function updateStrainsPagination() {
            var paginationDiv = document.getElementById('strainsPagination');
            var pageInput = document.getElementById('strainsPageInput');
            var totalPagesSpan = document.getElementById('strainsTotalPages');
            var firstBtn = document.getElementById('strainsFirst');
            var prevBtn = document.getElementById('strainsPrev');
            var nextBtn = document.getElementById('strainsNext');
            var lastBtn = document.getElementById('strainsLast');

            if (strainsTotalPages > 1) {
                paginationDiv.style.display = 'block';
                pageInput.value = strainsPage;
                pageInput.max = strainsTotalPages;
                totalPagesSpan.textContent = strainsTotalPages;

                // Update button states
                var atFirst = strainsPage <= 1;
                var atLast = strainsPage >= strainsTotalPages;

                firstBtn.disabled = atFirst;
                prevBtn.disabled = atFirst;
                nextBtn.disabled = atLast;
                lastBtn.disabled = atLast;

                firstBtn.style.opacity = atFirst ? '0.5' : '1';
                prevBtn.style.opacity = atFirst ? '0.5' : '1';
                nextBtn.style.opacity = atLast ? '0.5' : '1';
                lastBtn.style.opacity = atLast ? '0.5' : '1';
            } else {
                paginationDiv.style.display = 'none';
            }
        }

        function goToStrainsPage(page) {
            page = parseInt(page) || 1;
            if (page < 1) page = 1;
            if (page > strainsTotalPages) page = strainsTotalPages;
            if (page !== strainsPage) {
                strainsPage = page;
                loadStrains(strainsSearch);
            }
        }

        // Pagination buttons
        document.getElementById('strainsFirst').addEventListener('click', function() {
            goToStrainsPage(1);
        });

        document.getElementById('strainsPrev').addEventListener('click', function() {
            goToStrainsPage(strainsPage - 1);
        });

        document.getElementById('strainsNext').addEventListener('click', function() {
            goToStrainsPage(strainsPage + 1);
        });

        document.getElementById('strainsLast').addEventListener('click', function() {
            goToStrainsPage(strainsTotalPages);
        });

        // Page input - go on Enter or blur
        document.getElementById('strainsPageInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                goToStrainsPage(this.value);
                this.blur();
            }
        });

        document.getElementById('strainsPageInput').addEventListener('blur', function() {
            goToStrainsPage(this.value);
        });

        // Search strains with debounce
        var searchTimeout;
        document.getElementById('strainSearch').addEventListener('input', function() {
            var searchValue = this.value;
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(function() {
                loadStrains(searchValue);
            }, 300);
        });

        // Update strain THC values
        async function updateStrainTHC(strainId, thcMin, thcMax) {
            try {
                const body = {};
                if (thcMin !== null) body.thc_min = parseFloat(thcMin) || null;
                if (thcMax !== null) body.thc_max = parseFloat(thcMax) || null;

                const response = await fetch('/tokes-bot/api/admin/strains/' + strainId, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                if (response.ok) {
                    // Flash green border briefly to indicate success
                    const item = document.getElementById('strain-' + strainId);
                    if (item) {
                        item.style.borderColor = 'var(--ember-success)';
                        setTimeout(function() { item.style.borderColor = ''; }, 1000);
                    }
                }
            } catch (error) {
                console.error('Failed to update strain THC:', error);
            }
        }

        // Update strain type
        async function updateStrainType(strainId, strainType) {
            try {
                const response = await fetch('/tokes-bot/api/admin/strains/' + strainId, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ strain_type: strainType })
                });

                if (response.ok) {
                    const item = document.getElementById('strain-' + strainId);
                    if (item) {
                        item.style.borderColor = 'var(--ember-success)';
                        setTimeout(function() { item.style.borderColor = ''; }, 1000);
                    }
                }
            } catch (error) {
                console.error('Failed to update strain type:', error);
            }
        }

        // Delete strain
        async function deleteStrain(strainId) {
            if (!confirm('Delete this strain?')) return;

            try {
                const response = await fetch('/tokes-bot/api/admin/strains/' + strainId, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    const item = document.getElementById('strain-' + strainId);
                    if (item) item.remove();
                }
            } catch (error) {
                console.error('Failed to delete strain:', error);
            }
        }

        document.getElementById('strainForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);

            try {
                const response = await fetch('/tokes-bot/api/admin/strains', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    e.target.reset();
                    loadStrains();
                    alert('Strain added!');
                } else {
                    const err = await response.json();
                    alert(err.error || 'Failed to add strain');
                }
            } catch (error) {
                console.error('Failed to add strain:', error);
            }
        });

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        // Load counts on page load
        async function loadCounts() {
            try {
                // Get trivia count
                const triviaRes = await fetch('/tokes-bot/api/admin/trivia');
                const triviaData = await triviaRes.json();
                document.getElementById('triviaCount').textContent = triviaData.questions?.length || 0;
            } catch (e) {
                console.error('Failed to load counts:', e);
            }
        }

        // Initial load
        loadThoughts();
        loadCounts();
    </script>
    <script src="/js/csrf.js"></script>
</body>
</html>
