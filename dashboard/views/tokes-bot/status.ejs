<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="theme-color" content="#a78bfa">
    <link rel="icon" type="image/png" href="/images/CertiFried.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/tokes-bot.css">
</head>
<body class="ember-page">
    <!-- Navigation -->
    <nav class="ember-nav">
        <div class="ember-container ember-nav-inner">
            <a href="/tokes-bot" class="ember-nav-brand">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
                    <path d="M12 6v6l4 2"/>
                </svg>
                CertiFriedUtility
            </a>

            <div class="ember-nav-links">
                <a href="/tokes-bot" class="ember-nav-link">Home</a>
                <a href="/tokes-bot/commands" class="ember-nav-link">Commands</a>
                <a href="/tokes-bot/leaderboards" class="ember-nav-link">Leaderboards</a>
                <a href="/tokes-bot/status" class="ember-nav-link active">Status</a>
            </div>

            <div class="ember-nav-actions">
                <% if (user) { %>
                    <div class="ember-nav-user">
                        <img src="<%= user.avatar %>" alt="<%= user.name %>" class="ember-nav-avatar">
                        <span><%= user.name %></span>
                    </div>
                    <a href="/tokes-bot/dashboard" class="ember-btn ember-btn-primary">Dashboard</a>
                <% } else { %>
                    <a href="/tokes-bot/auth/twitch" class="ember-btn ember-btn-outline">Login with Twitch</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Status Content -->
    <main class="ember-dashboard">
        <div class="ember-container ember-container-sm">
            <!-- Header -->
            <div class="ember-dashboard-header ember-text-center">
                <h1 class="ember-dashboard-title">Bot Status</h1>
                <p class="ember-dashboard-subtitle">Current operational status of CertiFriedUtility services</p>
            </div>

            <!-- Overall Status -->
            <div class="ember-card ember-mb-3" style="text-align: center;">
                <% const allOnline = botStatus.twitch || botStatus.kick; %>
                <div style="font-size: 4rem; margin-bottom: 1rem;">
                    <% if (allOnline) { %>
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--ember-success)" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    <% } else { %>
                        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--ember-error)" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                    <% } %>
                </div>
                <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
                    <% if (allOnline) { %>
                        All Systems Operational
                    <% } else { %>
                        Service Disruption
                    <% } %>
                </h2>
                <p class="ember-text-muted">Last checked: <%= new Date().toLocaleString() %></p>
            </div>

            <!-- Platform Status -->
            <div class="ember-card ember-mb-3">
                <div class="ember-card-header">
                    <h2 class="ember-card-title">Platform Connections</h2>
                </div>
                <div class="ember-card-body">
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <!-- Twitch Status -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; background: var(--ember-bg-elevated); border-radius: 8px;">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="#9146FF">
                                    <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                                </svg>
                                <div>
                                    <strong>Twitch IRC</strong>
                                    <div class="ember-text-muted" style="font-size: 0.8rem;">Chat message processing</div>
                                </div>
                            </div>
                            <% if (botStatus.twitch) { %>
                                <span class="ember-badge ember-badge-success">Online</span>
                            <% } else { %>
                                <span class="ember-badge ember-badge-error">Offline</span>
                            <% } %>
                        </div>

                        <!-- Kick Status -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; background: var(--ember-bg-elevated); border-radius: 8px;">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="#53FC18">
                                    <rect x="2" y="2" width="20" height="20" rx="4"/>
                                    <text x="12" y="17" text-anchor="middle" font-size="12" font-weight="bold" fill="#000">K</text>
                                </svg>
                                <div>
                                    <strong>Kick API</strong>
                                    <div class="ember-text-muted" style="font-size: 0.8rem;">Chat message processing</div>
                                </div>
                            </div>
                            <% if (botStatus.kick) { %>
                                <span class="ember-badge ember-badge-success">Online</span>
                            <% } else { %>
                                <span class="ember-badge ember-badge-warning">Not Connected</span>
                            <% } %>
                        </div>

                        <!-- Database Status -->
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 1rem; background: var(--ember-bg-elevated); border-radius: 8px;">
                            <div style="display: flex; align-items: center; gap: 1rem;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--ember-primary)" stroke-width="2">
                                    <ellipse cx="12" cy="5" rx="9" ry="3"/>
                                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                                </svg>
                                <div>
                                    <strong>Database</strong>
                                    <div class="ember-text-muted" style="font-size: 0.8rem;">User data & statistics</div>
                                </div>
                            </div>
                            <span class="ember-badge ember-badge-success">Online</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Statistics -->
            <div class="ember-card">
                <div class="ember-card-header">
                    <h2 class="ember-card-title">Current Statistics</h2>
                </div>
                <div class="ember-card-body">
                    <div class="ember-dashboard-grid">
                        <div class="ember-stat-card">
                            <div class="ember-stat-value"><%= stats.active_channels || 0 %></div>
                            <div class="ember-stat-label">Active Channels</div>
                        </div>
                        <div class="ember-stat-card">
                            <div class="ember-stat-value"><%= stats.active_sessions || 0 %></div>
                            <div class="ember-stat-label">Active Sessions</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info -->
            <div class="ember-card ember-mt-3" style="background: var(--ember-info-dim); border-color: var(--ember-info);">
                <div class="ember-card-body">
                    <p style="color: var(--ember-info);">
                        <strong>Note:</strong> CertiFriedUtility uses a "Bring Your Own Bot" model.
                        Each channel owner connects their own Twitch/Kick account, so individual channel connectivity
                        depends on the user's token validity.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="ember-footer">
        <div class="ember-container ember-footer-inner">
            <div class="ember-footer-links">
                <a href="/tokes-bot/commands" class="ember-footer-link">Commands</a>
                <a href="/tokes-bot/privacy" class="ember-footer-link">Privacy Policy</a>
                <a href="/tokes-bot/terms" class="ember-footer-link">Terms of Service</a>
            </div>
            <div class="ember-footer-copy">
                Part of <a href="/" style="color: var(--ember-primary); text-decoration: none;">CertiFried MultiTool</a>
            </div>
        </div>
    </footer>
</body>
</html>
