<!DOCTYPE html>
<html data-theme="<%= locals.uiTheme || 'dark' %>" data-density="<%= locals.uiDensity || 'comfortable' %>" data-style="<%= locals.uiStyle || 'cards' %>" lang="en">
<head>
<%- include('components/cah-shell-head') %>
<style>
    .container.cah-wide { max-width: 1200px; } /* same width as the site header */

    /* Page head: title, one line, the main action, and three numbers */
    .hero { padding: 32px 0 8px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 24px; }
    .hero h1 { font-size: var(--cf-text-2xl); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
    .hero .tagline { color: var(--cf-text-2); font-size: var(--cf-text-md); max-width: 560px; margin-top: 6px; }
    .hero .guest-note { margin-top: 8px; color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 20px; max-width: 520px; }
    .hero-stat { background: var(--cf-surface); border: 1px solid var(--cf-border); border-radius: var(--cf-radius-lg); padding: 10px 14px; display: flex; flex-direction: column; gap: 2px; }
    .hero-stat .num { font-size: var(--cf-text-xl); font-weight: 600; font-variant-numeric: tabular-nums; }
    .hero-stat .lbl { font-size: var(--cf-text-xs); color: var(--cf-text-3); }
    @media (max-width: 600px) { .hero .btn-lg { width: 100%; } }

    /* SECTION HEADER */
    .section-header {
        display: flex; align-items: baseline; justify-content: space-between;
        padding: 2.5rem 0 1.25rem;
        gap: 1rem; flex-wrap: wrap;
    }
    .section-header { padding: 28px 0 12px; }
    .section-header h2 { font-size: var(--cf-text-lg); font-weight: 600; }
    .section-header h2 .count { color: var(--cf-text-3); font-weight: 500; margin-left: 4px; }
    .section-header .meta { color: var(--cf-text-3); font-size: var(--cf-text-sm); }
    .section-header code { background: var(--cf-surface-2); padding: 1px 6px; border-radius: var(--cf-radius-sm); font-size: 0.85em; }

    /* LOBBY GRID — 3 columns desktop, 2 tablet, 1 mobile */
    .lobby-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        padding-bottom: 4rem;
    }
    @media (max-width: 1100px) { .lobby-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 720px)  { .lobby-grid { grid-template-columns: 1fr; } }

    .lobby-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--cf-radius-lg);
        padding: 16px;
        display: flex; flex-direction: column; gap: 12px;
        transition: border-color 0.15s, background 0.15s;
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
    }
    .lobby-card:hover { border-color: var(--cf-border-strong); background: var(--cf-surface-2); color: inherit; }

    .lobby-card .lobby-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
    .lobby-card .lobby-id { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.75rem; color: var(--text-muted); background: var(--bg-secondary); padding: 0.2rem 0.6rem; border-radius: 5px; }
    .lobby-card .lobby-host { font-size: 0.85rem; color: var(--text-secondary); }
    .lobby-card .lobby-host strong { color: var(--text-primary); font-weight: 600; }

    .lobby-card .lobby-players {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.85rem 1rem; background: var(--bg-secondary); border-radius: 10px;
    }
    .lobby-card .lobby-players .count { font-size: var(--cf-text-xl); font-weight: 600; font-variant-numeric: tabular-nums; }
    .lobby-card .lobby-players .max { color: var(--text-muted); font-size: 0.95rem; }
    .lobby-card .lobby-players .label { color: var(--text-muted); font-size: var(--cf-text-xs); }

    .lobby-card .lobby-badges { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .lobby-card .lobby-join {
        margin-top: auto; padding: 0.75rem; text-align: center;
        background: var(--cf-surface-2); color: var(--cf-text); border: 1px solid var(--cf-border-strong);
        border-radius: var(--cf-radius); font-weight: 500; font-size: var(--cf-text-sm);
        transition: background 0.15s;
    }
    .lobby-card:hover .lobby-join { background: var(--cf-accent); border-color: var(--cf-accent); color: var(--cf-on-accent); }

    /* EMPTY STATE */
    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 40px 20px;
        background: var(--bg-card);
        border: 1px dashed var(--border-color);
        border-radius: var(--cf-radius-lg);
    }
    .empty-state h3 { font-size: var(--cf-text-lg); color: var(--text-primary); margin-bottom: 4px; font-weight: 600; }
    .empty-state p { color: var(--text-secondary); margin-bottom: 1.5rem; }

    /* MODAL — slide-in create flow */
    .modal-backdrop {
        position: fixed; inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: none; align-items: flex-start; justify-content: center;
        z-index: 1100; padding: 2rem 1rem;
        overflow-y: auto;
    }
    .modal-backdrop.open { display: flex; }
    .modal {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: var(--cf-radius-lg);
        max-width: 720px; width: 100%;
        padding: 0;
        box-shadow: var(--cf-shadow-pop, 0 16px 48px rgb(0 0 0 / .45));
        margin: auto 0;
    }
    .modal.modal-sm { max-width: 440px; }
    .modal-header { border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .modal-header h2 { font-size: var(--cf-text-lg); font-weight: 600; }
    .modal-close { background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 6px; line-height: 0; border-radius: var(--cf-radius); }
    .modal-close svg { width: 18px; height: 18px; }
    .modal-close:hover { color: var(--text-primary); background: var(--cf-surface-2); }
    .modal-footer { border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .modal-footer .form-error { margin-right: auto; }
    .form-error { color: var(--cf-danger); font-size: var(--cf-text-sm); }
    .muted { color: var(--cf-text-3); }
    .modal-lede { color: var(--cf-text-2); font-size: var(--cf-text-sm); margin-bottom: 1rem; }
    .modal-aside { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: var(--cf-text-sm); }

    /* Form styling inside modal */
    .form-grid { display: grid; gap: 1rem; }
    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; }
    @media (max-width: 540px) { .form-row-2 { grid-template-columns: 1fr; } }
    .form-field { display: flex; flex-direction: column; gap: 0.35rem; }
    .form-field label { font-size: var(--cf-text-sm); font-weight: 500; color: var(--cf-text); }
    .form-field label .opt { color: var(--cf-text-3); font-weight: 400; }
    .label-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .link-btn { background: none; border: 0; padding: 0; cursor: pointer; color: var(--cf-accent-fg); font: inherit; font-size: var(--cf-text-xs); }
    .link-btn:hover { text-decoration: underline; }
    .preset-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); }
    .preset-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
    .preset-applied { display: none; padding: 8px 12px; background: color-mix(in srgb, var(--cf-success) 10%, transparent); border: 1px solid color-mix(in srgb, var(--cf-success) 35%, transparent); border-radius: var(--cf-radius); font-size: var(--cf-text-sm); }
    .check-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; cursor: pointer; font-size: var(--cf-text-md); }
    .check-row input { accent-color: var(--cf-accent); width: 16px; height: 16px; }
    .diag-box { display: none; margin-top: 8px; padding: 10px; background: var(--cf-inset); border: 1px solid var(--border-color); border-radius: var(--cf-radius); font-size: var(--cf-text-xs); font-family: var(--cf-mono); max-height: 240px; overflow-y: auto; }
    .diag-box div { margin-bottom: 4px; }
    .deck-empty { padding: 2rem; color: var(--text-muted); text-align: center; font-size: var(--cf-text-sm); }
    .share-code-add { margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color); }
    .inline-row { display: flex; gap: 8px; }
    .inline-row input { flex: 1; min-width: 0; text-transform: uppercase; }
    .form-field input, .form-field select, .form-field textarea {
        padding: 0.7rem 0.85rem;
        background: var(--bg-primary);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        border-radius: var(--cf-radius);
        font-size: var(--cf-text-md);
        font-family: inherit;
        transition: border-color 0.15s, background 0.15s;
    }
    .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
        outline: none; border-color: var(--accent-purple);
    }
    .form-field .hint { font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem; }

    /* Tabs inside modal */
    .modal-tabs { display: flex; gap: 0.25rem; padding: 0 20px; border-bottom: 1px solid var(--border-color); }
    .modal-tab {
        padding: 10px 12px; margin-bottom: -1px;
        background: none; border: none; color: var(--text-secondary);
        font-size: var(--cf-text-sm); font-weight: 500; cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: color 0.15s, border-color 0.15s;
        font-family: inherit;
    }
    .modal-tab:hover { color: var(--text-primary); }
    .modal-tab.active { color: var(--cf-text); border-bottom-color: var(--cf-accent); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* Preset buttons — selected state */
    .preset-btn {
        background: var(--bg-primary); border: 1px solid var(--border-color);
        color: var(--text-primary); padding: 8px 12px; border-radius: var(--cf-radius);
        font-family: inherit; font-size: var(--cf-text-sm); font-weight: 500; text-align: left;
        cursor: pointer; line-height: 1.3;
        transition: border-color 0.15s, background 0.15s, transform 0.1s;
        flex: 1; min-width: 130px;
    }
    .preset-btn small { display: block; font-size: var(--cf-text-xs); font-weight: 400; color: var(--text-muted); margin-top: 2px; }
    .preset-btn:hover { border-color: var(--accent-purple); }
    .preset-btn.active { background: var(--cf-accent-soft); border-color: var(--cf-accent); }

    /* Highlight pulse on fields that just got updated by a preset */
    @keyframes presetPulse { 0% { background: var(--accent-purple-dim); } 100% { background: var(--bg-primary); } }
    .preset-pulse { animation: presetPulse 1.2s ease-out; }

    /* Advanced collapse */
    .advanced-toggle {
        background: none; border: 1px solid var(--border-color); color: var(--text-secondary);
        padding: 6px 12px; border-radius: var(--cf-radius); font-size: var(--cf-text-sm); font-weight: 500;
        cursor: pointer; font-family: inherit;
        display: flex; align-items: center; gap: 0.5rem; width: fit-content;
    }
    .advanced-toggle:hover { color: var(--text-primary); border-color: var(--border-hover); }
    .advanced-panel { display: none; padding: 1rem 0 0; }
    .advanced-panel.open { display: block; }

    /* Deck picker */
    .deck-picker-tall { max-height: 50vh; overflow-y: auto; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px; padding: 0.5rem; }
    .deck-row { display: flex; align-items: center; gap: 0.65rem; padding: 0.6rem 0.7rem; border-radius: 6px; font-size: 0.88rem; transition: background 0.1s; }
    .deck-row:hover { background: var(--bg-card-hover); }
    .deck-row label { flex: 1; cursor: pointer; display: flex; align-items: center; gap: 0.6rem; min-width: 0; margin: 0; }
    .deck-row input[type=checkbox] { accent-color: var(--cf-accent); width: 17px; height: 17px; cursor: pointer; flex-shrink: 0; }
    .deck-row .deck-name { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .deck-row .deck-code { color: var(--text-muted); font-size: var(--cf-text-xs); font-family: var(--cf-mono); flex-shrink: 0; }
    @media (max-width: 540px) { .deck-row .deck-code { display: none; } }
    .deck-row .deck-stats { color: var(--text-muted); font-size: 0.72rem; flex-shrink: 0; }
    .deck-tools { display: flex; gap: 0.4rem; margin-top: 0.6rem; }
    .deck-tools button { flex: 1; padding: 0.5rem; }
    .deck-filter { width: 100%; padding: 0.6rem 0.8rem; background: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 8px; margin-bottom: 0.5rem; font-size: 0.9rem; }

    /* Guild picker */
    #guild-picker-group { background: var(--bg-card); padding: 1rem; border-radius: var(--cf-radius-lg); border: 1px solid var(--border-color); }
</style>
    <link rel="stylesheet" href="/css/dropdowns.css">
<%- include('partials/site-head', { title: 'Cards Against Humanity · CertiFried', description: 'Cards Against Humanity on CertiFried: play in the browser or in Discord, with community card packs and your own decks.' }) %>
</head>
<body>
<%- include('components/cah-shell-nav', { user, page: 'lobbies' }) %>

<main class="container cah-wide" id="main-content">
    <section class="hero">
        <div>
            <h1>Cards Against Humanity</h1>
            <p class="tagline">Host a game in your browser or post it to a Discord server. Guests can play with just a name.</p>
            <% if (typeof user === 'undefined' || !user) { %>
                <p class="guest-note"><a href="/auth/discord?returnTo=/cah">Log in with Discord</a> to keep your decks and game history.</p>
            <% } %>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="num"><%= (decks?.length || 0).toLocaleString() %></span>
                    <span class="lbl">Card packs</span>
                </div>
                <div class="hero-stat">
                    <span class="num"><%= lobbies?.length || 0 %></span>
                    <span class="lbl">Open lobbies</span>
                </div>
                <div class="hero-stat">
                    <span class="num">3–20</span>
                    <span class="lbl">Players</span>
                </div>
            </div>
        </div>
        <button type="button" class="btn btn-primary btn-lg" onclick="hostFlow()">Host a game</button>
    </section>

    <div class="section-header">
        <h2>Public lobbies<% if (lobbies && lobbies.length) { %><span class="count"><%= lobbies.length %></span><% } %></h2>
        <span class="meta">Discord games marked <code>public</code> show up here too.</span>
    </div>

    <div class="lobby-grid">
        <% if (!lobbies || lobbies.length === 0) { %>
            <div class="empty-state">
                <h3>No public lobbies right now</h3>
                <p>Host one and it will be listed here for everyone.</p>
                <button type="button" class="btn btn-primary" onclick="hostFlow()">Host a game</button>
            </div>
        <% } else { %>
            <% lobbies.forEach(l => { %>
                <a class="lobby-card" href="/cah/<%= l.id %>" onclick="return enterLobby(event, '<%= l.id %>')">
                    <div class="lobby-head">
                        <div class="lobby-host"><strong><%= l.hostName || 'Someone' %></strong>'s game</div>
                        <span class="lobby-id"><%= l.id.slice(0, 8) %></span>
                    </div>
                    <div class="lobby-players">
                        <div>
                            <span class="count"><%= l.playerCount %></span>
                            <span class="max">/ 20</span>
                        </div>
                        <span class="label">Players</span>
                    </div>
                    <div class="lobby-badges">
                        <span class="pill pill-purple"><%= l.settings.pointsToWin %> points to win</span>
                        <span class="pill">Up to <%= l.settings.maxRounds %> rounds</span>
                        <% if (l.settings.blankCardCount > 0) { %><span class="pill pill-amber"><%= l.settings.blankCardCount %> blank cards</span><% } %>
                        <% if (l.settings.randoCount > 0) { %><span class="pill"><%= l.settings.randoCount %> AI player<%= l.settings.randoCount === 1 ? '' : 's' %></span><% } %>
                        <% if (l.settings.hasPassword) { %><span class="pill pill-amber">Password</span><% } %>
                        <% if (l.settings.nsfw) { %><span class="pill pill-red">NSFW</span><% } %>
                    </div>
                    <div class="lobby-join">Join game</div>
                </a>
            <% }); %>
        <% } %>
    </div>
</main>

<!-- GUEST USERNAME MODAL -->
<div class="modal-backdrop" id="guest-modal" onclick="if(event.target===this)closeGuestModal()">
    <div class="modal modal-sm" role="dialog" aria-modal="true" aria-labelledby="guest-modal-title">
        <div class="modal-header">
            <h2 id="guest-modal-title">Pick a name to play</h2>
            <button type="button" class="modal-close" onclick="closeGuestModal()" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <div class="modal-body">
            <p class="modal-lede">No account needed. Other players see this name in the game.</p>
            <div class="form-field">
                <label for="guest-username">Your name</label>
                <input id="guest-username" type="text" maxlength="24" minlength="2" placeholder="e.g. Bean Goblin" autocomplete="off" onkeydown="if(event.key==='Enter')submitGuestName()">
                <span class="hint">2–24 characters: letters, numbers, spaces, dashes, dots, underscores.</span>
            </div>
            <div id="guest-error" class="form-error" role="alert" style="display:none; margin-top: 0.5rem;"></div>
            <p class="modal-aside">
                Want to keep your decks and game history?
                <a href="/auth/discord?returnTo=/cah">Log in with Discord</a> instead.
            </p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-ghost" onclick="closeGuestModal()">Cancel</button>
            <button type="button" class="btn btn-primary" onclick="submitGuestName()">Continue</button>
        </div>
    </div>
</div>

<!-- CREATE GAME MODAL -->
<div class="modal-backdrop" id="create-modal" onclick="if(event.target===this)closeCreateModal()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-modal-title">
        <div class="modal-header">
            <h2 id="create-modal-title">Host a game</h2>
            <button type="button" class="modal-close" onclick="closeCreateModal()" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
        </div>
        <div class="modal-tabs">
            <button type="button" class="modal-tab active" data-tab="basics" onclick="switchTab('basics')">Game</button>
            <button type="button" class="modal-tab" data-tab="decks" onclick="switchTab('decks')">Card packs <span class="muted" id="deck-count-label"></span></button>
        </div>
        <form id="create-form" onsubmit="return submitCreate(event)">
            <div class="modal-body">
                <!-- TAB: Game basics -->
                <div class="tab-panel active" data-panel="basics">
                    <div class="preset-group">
                        <span class="form-label" style="margin:0">Quick preset</span>
                        <div class="preset-buttons">
                            <button type="button" class="preset-btn" data-preset="quick" onclick="applyPreset('quick', this)">Quick<small>5 points, 10 rounds</small></button>
                            <button type="button" class="preset-btn" data-preset="standard" onclick="applyPreset('standard', this)">Standard<small>7 points, 20 rounds</small></button>
                            <button type="button" class="preset-btn" data-preset="marathon" onclick="applyPreset('marathon', this)">Marathon<small>15 points, 30 rounds</small></button>
                            <button type="button" class="preset-btn" data-preset="spicy" onclick="applyPreset('spicy', this)">Spicy<small>NSFW packs and blanks</small></button>
                        </div>
                        <div id="preset-applied" class="preset-applied" role="status">
                            <span id="preset-applied-text"></span>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-row-2">
                            <div class="form-field">
                                <label for="f-cah-lobby-points">Points to win</label>
                                <input id="f-cah-lobby-points" name="points" type="number" min="3" max="30" value="7">
                            </div>
                            <div class="form-field">
                                <label for="f-cah-lobby-maxrounds">Max rounds</label>
                                <input id="f-cah-lobby-maxrounds" name="maxRounds" type="number" min="3" max="50" value="20">
                            </div>
                        </div>
                        <div class="form-row-2">
                            <div class="form-field">
                                <label for="f-cah-lobby-randocount">Rando players</label>
                                <input id="f-cah-lobby-randocount" name="randoCount" type="number" min="0" max="3" value="0">
                                <span class="hint">Computer players that play random cards</span>
                            </div>
                            <div class="form-field">
                                <label for="visibility-select">Visibility</label>
                                <select name="visibility" id="visibility-select" onchange="onVisibilityChange()">
                                    <option value="public">Public · listed</option>
                                    <option value="private">Private · link only</option>
                                    <% if (typeof user !== 'undefined' && user) { %><option value="guild_only">Discord server · posted to a channel</option><% } %>
                                </select>
                            </div>
                        </div>

                        <div id="guild-picker-group" style="display:none;">
                            <div class="form-field">
                                <div class="label-row">
                                    <label for="guild-select">Discord server</label>
                                    <button type="button" id="refresh-guilds" class="link-btn">Refresh list</button>
                                </div>
                                <select name="guildId" id="guild-select" onchange="onGuildChange()">
                                    <option value="">Loading…</option>
                                </select>
                                <span class="hint" id="guild-stats"></span>
                                <button type="button" id="why-missing-btn" class="link-btn" style="display:none; text-align:left; margin-top:2px;">Why don't I see all my servers?</button>
                                <div id="why-missing-detail" class="diag-box"></div>
                            </div>
                            <div class="form-field" style="margin-top:0.75rem;">
                                <label for="channel-select">Channel</label>
                                <select name="channelId" id="channel-select">
                                    <option value="">Pick a server first</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-field">
                            <label for="f-cah-lobby-joinpassword">Password <span class="opt">(optional)</span></label>
                            <input id="f-cah-lobby-joinpassword" name="joinPassword" type="text" placeholder="Leave blank for no password" maxlength="64" autocomplete="off">
                        </div>

                        <button type="button" class="advanced-toggle" aria-expanded="false" aria-controls="advanced" onclick="var o=document.getElementById('advanced').classList.toggle('open');this.setAttribute('aria-expanded',o);this.querySelector('.chev').textContent=o?'▾':'▸';">
                            <span class="chev" aria-hidden="true">▸</span> Advanced settings
                        </button>
                        <div class="advanced-panel" id="advanced">
                            <div class="form-grid">
                                <div class="form-field">
                                    <label for="f-cah-lobby-czarrotation">Card Czar rotation</label>
                                    <select id="f-cah-lobby-czarrotation" name="czarRotation">
                                        <option value="rotate">Rotate (round-robin)</option>
                                        <option value="random">Random</option>
                                        <option value="previous_winner">Previous round winner</option>
                                    </select>
                                </div>
                                <div class="form-row-2">
                                    <div class="form-field">
                                        <label for="f-cah-lobby-timeoutseconds">Turn time limit (seconds)</label>
                                        <input id="f-cah-lobby-timeoutseconds" name="timeoutSeconds" type="number" min="30" max="600" value="90">
                                    </div>
                                    <div class="form-field">
                                        <label for="f-cah-lobby-blankcardcount">Blank cards</label>
                                        <input id="f-cah-lobby-blankcardcount" name="blankCardCount" type="number" min="0" max="20" value="0">
                                        <span class="hint">Write-your-own slots</span>
                                    </div>
                                </div>
                                <label class="check-row">
                                    <input type="checkbox" name="nsfw" value="true">
                                    <span>Allow NSFW packs</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB: Card packs -->
                <div class="tab-panel" data-panel="decks">
                    <% if (typeof user !== 'undefined' && user) { %>
                    <div class="form-field share-code-add">
                        <label for="share-code-input">Add a friend's private deck</label>
                        <div class="inline-row">
                            <input id="share-code-input" maxlength="8" autocomplete="off" placeholder="Share code, e.g. K7Q2M" onkeydown="if(event.key==='Enter'){event.preventDefault();addByShareCode();}">
                            <button type="button" class="btn btn-outline btn-sm" onclick="addByShareCode()">Add</button>
                        </div>
                        <span class="hint" id="share-code-msg" role="status"></span>
                    </div>
                    <% } %>
                    <div class="form-field">
                        <label for="deck-filter">Filter packs</label>
                        <input class="deck-filter" id="deck-filter" type="search" placeholder="Filter by name or code">
                    </div>
                    <div class="deck-picker-tall" id="deck-picker">
                        <% if (decks && decks.length > 0) { %>
                            <% decks.forEach(d => { %>
                                <div class="deck-row" data-name="<%= (d.name || '').toLowerCase() %>" data-code="<%= (d.cast_id || '').toLowerCase() %>" data-nsfw="<%= d.nsfw ? 1 : 0 %>">
                                    <label>
                                        <input type="checkbox" name="deckCheck" value="<%= d.id %>" id="deck-<%= d.id %>" <%= d.source === 'builtin' ? 'checked' : '' %>>
                                        <span class="deck-name"><%= d.name %></span>
                                    </label>
                                    <% if (d.cast_id) { %><span class="deck-code"><%= d.cast_id %></span><% } %>
                                    <span class="deck-stats"><%= d.white_count %>w/<%= d.black_count %>b</span>
                                    <% if (d.nsfw) { %><span class="pill pill-red">NSFW</span><% } %>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="deck-empty">
                                No card packs loaded. <a href="/cah/my-decks">Make your own deck</a>.
                            </div>
                        <% } %>
                    </div>
                    <div class="deck-tools">
                        <button type="button" class="btn btn-outline btn-sm" onclick="selectAllDecks(true)">Select all shown</button>
                        <button type="button" class="btn btn-outline btn-sm" onclick="selectAllDecks(false)">Clear shown</button>
                        <button type="button" class="btn btn-outline btn-sm" onclick="selectAllDecks('sfw')">SFW only</button>
                    </div>
                    <input type="hidden" name="deckIds" id="deck-ids">
                </div>
            </div>
            <div class="modal-footer">
                <span class="form-error" id="create-error" role="alert"></span>
                <button type="button" class="btn btn-ghost" onclick="closeCreateModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" id="create-submit">Create lobby</button>
            </div>
        </form>
    </div>
</div>

<script>
    // ─── Presets ──────────────────────────────────────────────────────
    const PRESETS = {
        quick:    { label: 'Quick',    points: 5,  maxRounds: 10, blankCardCount: 0, nsfw: false, timeoutSeconds: 60 },
        standard: { label: 'Standard', points: 7,  maxRounds: 20, blankCardCount: 0, nsfw: false, timeoutSeconds: 90 },
        marathon: { label: 'Marathon', points: 15, maxRounds: 30, blankCardCount: 2, nsfw: false, timeoutSeconds: 120 },
        spicy:    { label: 'Spicy',    points: 7,  maxRounds: 20, blankCardCount: 5, nsfw: true,  timeoutSeconds: 90 }
    };
    function applyPreset(name, btnEl) {
        const p = PRESETS[name]; if (!p) return;
        const form = document.getElementById('create-form');

        // Make sure the user can SEE the basics tab where the changed fields live
        switchTab('basics');

        // Apply field values + pulse-highlight each one so the change is visible
        Object.entries(p).forEach(([k, v]) => {
            if (k === 'label') return;
            const fieldEl = form.querySelector(`[name="${k}"]`);
            if (!fieldEl) return;
            if (fieldEl.type === 'checkbox') fieldEl.checked = !!v;
            else fieldEl.value = String(v);
            // Brief pulse animation so the user sees which fields changed
            fieldEl.classList.remove('preset-pulse');
            void fieldEl.offsetWidth;   // force reflow to restart the animation
            fieldEl.classList.add('preset-pulse');
        });

        // Toggle the selected-state styling on the buttons
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('active', b === btnEl));

        // Show the "applied" confirmation row, including a hint about Advanced fields
        const applied = document.getElementById('preset-applied');
        const text = document.getElementById('preset-applied-text');
        const advancedFields = `${p.timeoutSeconds}s per turn${p.nsfw ? ', NSFW packs allowed' : ''}${p.blankCardCount ? `, ${p.blankCardCount} blank cards` : ''}`;
        text.textContent = `${p.label} applied: ${p.points} points to win, up to ${p.maxRounds} rounds, ${advancedFields}.`;
        applied.style.display = 'block';

        // Clear "active" state if the user manually edits any field afterward
        // — the preset is no longer accurate at that point.
        form.querySelectorAll('input, select').forEach(el => {
            el.addEventListener('input', clearPresetActive, { once: true });
        });
    }
    function clearPresetActive() {
        document.querySelectorAll('.preset-btn.active').forEach(b => b.classList.remove('active'));
        const applied = document.getElementById('preset-applied');
        if (applied) applied.style.display = 'none';
    }

    // ─── Identity (Discord OR guest) ────────────────────────────────
    let CURRENT_IDENTITY = <%- JSON.stringify(user ? { id: user.id, displayName: user.username, kind: 'discord' } : null) %>;

    async function ensureIdentity() {
        if (CURRENT_IDENTITY) return CURRENT_IDENTITY;
        // Check if we already have a guest session from a previous visit
        try {
            const r = await cfetch('/cah/guest/identity');
            const d = await r.json();
            if (d.identity) { CURRENT_IDENTITY = d.identity; return d.identity; }
        } catch (_) {}
        // Otherwise prompt for a name
        return await new Promise((resolve) => {
            pendingGuestResolve = resolve;
            openGuestModal();
        });
    }

    let pendingGuestResolve = null;
    function openGuestModal() {
        document.getElementById('guest-modal').classList.add('open');
        document.body.style.overflow = 'hidden';
        setTimeout(() => document.getElementById('guest-username').focus(), 50);
    }
    function closeGuestModal() {
        document.getElementById('guest-modal').classList.remove('open');
        document.body.style.overflow = '';
        if (pendingGuestResolve) { pendingGuestResolve(null); pendingGuestResolve = null; }
    }
    async function submitGuestName() {
        const username = document.getElementById('guest-username').value.trim();
        const err = document.getElementById('guest-error');
        err.style.display = 'none';
        if (username.length < 2 || username.length > 24) { err.textContent = 'Name must be 2–24 characters.'; err.style.display = 'block'; return; }
        try {
            const r = await cfetch('/cah/guest/identity', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username }) });
            const d = await r.json();
            if (!d.ok) { err.textContent = d.message || d.reason; err.style.display = 'block'; return; }
            CURRENT_IDENTITY = d.identity;
            document.getElementById('guest-modal').classList.remove('open');
            document.body.style.overflow = '';
            if (pendingGuestResolve) { pendingGuestResolve(d.identity); pendingGuestResolve = null; }
        } catch (_) {
            err.textContent = 'Couldn\'t save your name. Try again.';
            err.style.display = 'block';
        }
    }

    // Host flow: ensure identity (prompts if guest), then open the create modal
    async function hostFlow() {
        const id = await ensureIdentity();
        if (!id) return;   // user cancelled the guest prompt
        openCreateModal();
    }
    // Join flow: clicking a lobby card prompts for identity before navigating
    async function enterLobby(event, gameId) {
        event.preventDefault();
        const id = await ensureIdentity();
        if (!id) return false;
        location.href = '/cah/' + gameId;
        return false;
    }

    // ─── Modal control ──────────────────────────────────────────────
    function openCreateModal() {
        document.getElementById('create-modal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeCreateModal() {
        document.getElementById('create-modal').classList.remove('open');
        document.body.style.overflow = '';
    }
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { closeCreateModal(); closeGuestModal(); }
    });
    function switchTab(name) {
        document.querySelectorAll('.modal-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.dataset.panel === name));
    }

    // ─── Deck selection ──────────────────────────────────────────────
    function collectCheckedDeckIds() {
        const ids = Array.from(document.querySelectorAll('input[name="deckCheck"]:checked')).map(c => c.value);
        document.getElementById('deck-ids').value = ids.join(',');
        return ids;
    }
    function selectAllDecks(mode) {
        document.querySelectorAll('.deck-row').forEach(row => {
            if (row.style.display === 'none') return;
            const cb = row.querySelector('input[type=checkbox]');
            if (!cb) return;
            if (mode === true) cb.checked = true;
            else if (mode === false) cb.checked = false;
            else if (mode === 'sfw') cb.checked = row.dataset.nsfw === '0';
        });
        updateDeckCount();
    }
    document.getElementById('deck-filter')?.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        document.querySelectorAll('.deck-row').forEach(row => {
            const match = !q || row.dataset.name.includes(q) || row.dataset.code.includes(q);
            row.style.display = match ? '' : 'none';
        });
    });

    // ─── Submit ──────────────────────────────────────────────────────
    const CREATE_ERRORS = {
        guests_cant_host_guild_games: 'Log in with Discord to post a game to a Discord server.',
        guild_required_for_guild_only: 'Pick a Discord server.',
        not_in_guild: 'You are not a member of that server.',
        bot_not_in_guild: 'The bot is not in that server.',
        invalid_channel: 'Pick a text channel in that server.',
        not_authenticated: 'Pick a name or log in first.',
        channel_has_game: 'That channel already has a game running.',
        blanks_not_allowed_in_guild: 'That server does not allow blank cards. Set Blank cards to 0.',
        nsfw_not_allowed_in_guild: 'That server does not allow NSFW games.',
        too_many_blanks: 'That server allows fewer blank cards. Lower the number.',
        insert_failed: 'Could not save the game. Try again.'
    };
    async function submitCreate(e) {
        e.preventDefault();
        const errEl = document.getElementById('create-error');
        const submitBtn = document.getElementById('create-submit');
        errEl.textContent = '';
        collectCheckedDeckIds();
        const body = Object.fromEntries(new FormData(e.target).entries());
        if (body.visibility === 'guild_only' && !body.guildId) { errEl.textContent = CREATE_ERRORS.guild_required_for_guild_only; return false; }
        submitBtn.disabled = true;
        try {
            const res = await cfetch('/cah/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json().catch(() => ({ ok: false, reason: 'http_' + res.status }));
            if (data.ok) { location.href = '/cah/' + data.gameId; return false; }
            let msg = CREATE_ERRORS[data.reason] || ('Could not create the game (' + (data.reason || 'unknown error') + ').');
            if (data.nsfwDeckNames && data.nsfwDeckNames.length) msg = 'These packs are NSFW. Turn on "Allow NSFW packs" under Advanced settings or untick them: ' + data.nsfwDeckNames.join(', ');
            errEl.textContent = msg;
        } catch (_) {
            errEl.textContent = 'Could not reach the server. Try again.';
        } finally {
            submitBtn.disabled = false;
        }
        return false;
    }
    // Private decks are not in the list; their owner shares a code instead.
    async function addByShareCode() {
        const input = document.getElementById('share-code-input');
        const msg = document.getElementById('share-code-msg');
        const code = input.value.trim().toUpperCase();
        if (!/^[A-Z0-9]{3,8}$/.test(code)) { msg.textContent = 'Share codes are 3 to 8 letters and numbers.'; return; }
        msg.textContent = 'Looking up…';
        try {
            const res = await cfetch('/cah/decks/by-code/' + encodeURIComponent(code));
            const data = await res.json().catch(() => ({ ok: false }));
            if (!data.ok || !data.deck) { msg.textContent = 'No deck has that code.'; return; }
            const d = data.deck;
            let cb = document.getElementById('deck-' + d.id);
            if (!cb) {
                const picker = document.getElementById('deck-picker');
                picker.querySelector('.deck-empty')?.remove();
                const row = document.createElement('div');
                row.className = 'deck-row';
                row.dataset.name = String(d.name || '').toLowerCase();
                row.dataset.code = String(d.share_code || '').toLowerCase();
                row.dataset.nsfw = '0';
                const label = document.createElement('label');
                cb = document.createElement('input');
                cb.type = 'checkbox'; cb.name = 'deckCheck'; cb.value = String(d.id); cb.id = 'deck-' + d.id;
                const nm = document.createElement('span'); nm.className = 'deck-name'; nm.textContent = d.name;
                label.append(cb, nm);
                const cd = document.createElement('span'); cd.className = 'deck-code'; cd.textContent = d.share_code;
                row.append(label, cd);
                picker.prepend(row);
            }
            cb.checked = true;
            cb.closest('.deck-row').style.display = '';
            input.value = '';
            msg.textContent = 'Added "' + d.name + '".';
            updateDeckCount();
        } catch (_) {
            msg.textContent = 'Could not look up that code. Try again.';
        }
    }
    function updateDeckCount() {
        const n = document.querySelectorAll('input[name="deckCheck"]:checked').length;
        const el = document.getElementById('deck-count-label');
        if (el) el.textContent = n ? '(' + n + ')' : '';
    }
    document.getElementById('deck-picker')?.addEventListener('change', updateDeckCount);
    updateDeckCount();

    // ─── Option element helpers ──────────────────────────────────────
    function optEl(value, label) { const o = document.createElement('option'); o.value = value; o.textContent = label; return o; }
    function replaceOptions(selectEl, options) { selectEl.replaceChildren(...options.map(o => optEl(o.value, o.label))); }

    // ─── Visibility-driven UI ────────────────────────────────────────
    let myGuildsLoaded = false;
    async function onVisibilityChange() {
        const v = document.getElementById('visibility-select').value;
        document.getElementById('guild-picker-group').style.display = v === 'guild_only' ? '' : 'none';
        if (v === 'guild_only' && !myGuildsLoaded) {
            myGuildsLoaded = true;
            await loadGuilds();
        }
    }
    async function loadGuilds() {
        const sel = document.getElementById('guild-select');
        const stats = document.getElementById('guild-stats');
        replaceOptions(sel, [{ value: '', label: 'Loading…' }]);
        stats.textContent = '';
        try {
            const res = await cfetch('/cah/my-guilds');
            const data = await res.json();
            const guilds = data.guilds || [];
            if (!guilds.length) {
                replaceOptions(sel, [{ value: '', label: 'None of your servers have the bot' }]);
            } else {
                replaceOptions(sel, [{ value: '', label: 'Pick a server' }, ...guilds.map(g => ({ value: g.id, label: g.name }))]);
            }
            const parts = [`Showing ${guilds.length} of ${data.totalGuilds} servers you're in`];
            if (data.guildsWithoutBot > 0) parts.push(`${data.guildsWithoutBot} don't have our bots`);
            if (!data.wasFresh) parts.push('list may be stale');
            stats.textContent = parts.join(' · ');
            document.getElementById('why-missing-btn').style.display = 'inline-block';
        } catch (err) {
            replaceOptions(sel, [{ value: '', label: 'Could not load your servers' }]);
        }
    }
    async function onGuildChange() {
        const gid = document.getElementById('guild-select').value;
        const csel = document.getElementById('channel-select');
        if (!gid) { replaceOptions(csel, [{ value: '', label: 'Pick a server first' }]); return; }
        replaceOptions(csel, [{ value: '', label: 'Loading…' }]);
        try {
            const res = await cfetch('/cah/guild-channels/' + encodeURIComponent(gid));
            const { channels, ok, reason } = await res.json();
            if (!ok) { replaceOptions(csel, [{ value: '', label: 'Could not load channels (' + (reason || 'error') + ')' }]); return; }
            if (!channels?.length) { replaceOptions(csel, [{ value: '', label: 'No channels the bot can post in' }]); return; }
            replaceOptions(csel, [
                { value: '', label: 'Pick a channel' },
                ...channels.map(c => ({ value: c.id, label: '#' + c.name + (c.parentName ? ' (' + c.parentName + ')' : '') }))
            ]);
        } catch (err) {
            replaceOptions(csel, [{ value: '', label: 'Could not load channels' }]);
        }
    }
    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('refresh-guilds')?.addEventListener('click', () => loadGuilds());
        document.getElementById('why-missing-btn')?.addEventListener('click', loadDiagnostic);
    });
    async function loadDiagnostic() {
        const detail = document.getElementById('why-missing-detail');
        detail.style.display = 'block';
        detail.textContent = 'Loading diagnostic…';
        try {
            const res = await cfetch('/cah/my-guilds/debug');
            const d = await res.json();
            detail.replaceChildren();
            const addLine = (label, value) => {
                const row = document.createElement('div');
                const k = document.createElement('strong'); k.textContent = label + ': ';
                row.append(k, document.createTextNode(String(value))); detail.appendChild(row);
            };
            addLine('OAuth list', `${d.oauthGuildCount} servers (${d.wasFresh ? 'fresh' : 'session-cached'})`);
            addLine('Mutual with our bots', d.mutualCount);
            addLine('Bot clients ready', `${d.botHealth.filter(b => b.ready).length} / ${d.botClientCount}`);
            addLine('Admin guilds w/o bot', d.adminSurfacedButNoBot);
        } catch (err) {
            detail.textContent = 'Failed to load diagnostic.';
        }
    }
</script>
<%- include('partials/site-footer') %>
</body>
</html>
