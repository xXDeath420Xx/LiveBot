{
  "name": "certifried-utility-dashboard",
  "version": "2.0.0",
  "description": "Web dashboard for CertiFried Utility Discord bot",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "npx tailwindcss -i ./public/css/tailwind.css -o ./public/css/output.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/tailwind.css -o ./public/css/output.css --watch",
    "build": "npm run build:css"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
