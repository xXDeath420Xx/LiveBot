{
  "name": "certifried-studio",
  "productName": "CertiFried Studio",
  "version": "0.2.14",
  "description": "CertiFried Studio: carries out CertiFried stream bot actions on your PC (OBS, sounds, hotkeys, lights, Voicemeeter, Stream Deck).",
  "author": "CertiFried",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "src/main/main.js",
  "homepage": "https://certifriedmultitool.com/downloads/studio",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-force-exit --test-concurrency=1 \"test/*.test.js\"",
    "icons": "python scripts/make-icons.py",
    "build": "electron-builder --win nsis portable --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "koffi": "3.3.6",
    "multicast-dns": "7.2.5",
    "node-hid": "3.4.0",
    "obs-websocket-js": "5.0.8",
    "onnxruntime-node": "1.31.1",
    "uiohook-napi": "1.5.5",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0",
    "selfsigned": "5.5.0"
  },
  "build": {
    "appId": "com.certifried.studio",
    "productName": "CertiFried Studio",
    "copyright": "CertiFried",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/logo-source.png",
      "!src/main/dev-capture.js",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/x64/dxcompiler.dll",
      "!scripts/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/@koromix/**/*",
      "node_modules/node-hid/**/*",
      "src/voice/**/*",
      "src/ble/**/*",
      "node_modules/onnxruntime-node/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "../streamdeck-plugin/dist/com.certifried.studio.streamDeckPlugin",
        "to": "streamdeck/com.certifried.studio.streamDeckPlugin"
      }
    ],
    "protocols": [
      {
        "name": "CertiFried Studio pairing",
        "schemes": [
          "certifried-studio"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CertiFried Studio",
      "artifactName": "CertiFried-Studio-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "CertiFried-Studio-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://certifriedmultitool.com/downloads/studio/",
        "channel": "latest"
      }
    ]
  }
}
