# RTMP ingest port (1935 is taken by another tenant on this box)
RTMP_PORT=1936
# Localhost-only status API the dashboard reads
STATUS_PORT=4090
# Public host shown to users in their ingest URL
PUBLIC_HOST=certifriedmultitool.com
# Abuse caps
MAX_DESTINATIONS=8
MAX_CONCURRENT=10
# Per-destination ffmpeg retry policy
DEST_RETRY_LIMIT=5
DEST_RETRY_BASE_MS=2000
# Database (copy values from the repo-root .env that utils/db.js loads —
# NOT dashboard/.env, whose DB_* values are stale). Note the cPanel cert_ prefix.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cert_CertiFriedDB
DB_PASSWORD=
DB_NAME=cert_CertiFriedUtility
# Shared secret for the relay -> dashboard resolver call (set the SAME value in the dashboard env)
RELAY_INTERNAL_SECRET=
DASHBOARD_RESOLVER_URL=http://127.0.0.1:3001/internal/resolve-destinations
